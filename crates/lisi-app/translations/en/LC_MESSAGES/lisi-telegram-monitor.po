msgstr "Put together and start a monitoring from the «New monitoring» screen. It will appear here, with its state and its commands."

msgid "Stato: {}  ·  Avviato da: {}  ·  Durata: {}{}"
msgstr "State: {}  ·  Started by: {}  ·  Duration: {}{}"


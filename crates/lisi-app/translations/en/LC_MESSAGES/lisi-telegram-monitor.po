msgstr "the local backup folder cannot be prepared: {errore}"

msgid "la copia è arrivata senza il suo foglio"
msgstr "the backup arrived without its sheet"

msgid "la copia è stata scritta ma non si rilegge. Non è stata portata a destinazione: una copia di cui non ci si fida è peggio di nessuna"
msgstr "the backup was written but cannot be read back. It was not taken to its destination: a backup you cannot trust is worse than none"

msgid "la copia non è arrivata a destinazione: {}"
msgstr "the backup did not reach its destination: {}"

msgid "la copia appena scritta non si riapre: {errore}"
msgstr "the backup just written does not reopen: {errore}"

msgid "l'impronta della copia non si è calcolata: {errore}"
msgstr "the fingerprint of the backup was not calculated: {errore}"


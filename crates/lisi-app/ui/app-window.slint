// Di `std-widgets` resta **soltanto** `AboutSlint`, che e' un'attribuzione
// dovuta e non un controllo.
//
// I widget di libreria - `LineEdit`, `ComboBox`, `CheckBox`, `SpinBox`,
// `ScrollView` - prendevano lo stile da `fluent-dark`, fissato in `build.rs`, e
// restavano **grigi dentro un'interfaccia blu**: era il limite dichiarato di
// MP-15B. Non erano tematizzabili: in Slint 1.17 le proprieta' del `Palette` di
// `std-widgets` sono di sola lettura, quindi l'unica via era costruirli.
// Ora sono `HudInput`, `HudSelect`, `HudCheck`, `HudNumber` e `HudScroll`.
import { AboutSlint } from "std-widgets.slint";
import { ProductFonts } from "product-fonts.slint";
import { Palette, Typography, Spacing, Shell, Motion, Appearance, Activity, StationLock, FocusRule } from "tokens.slint";

// Riesportato perche' Rust possa collegarsi al segnale di attivita': in Slint un
// global e' visibile al codice generato solo se lo esporta il file di primo
// livello, non quello che lo dichiara.
export { Activity }
// Riesportato perche' Rust possa leggerne la geometria: le misure della barra
// del titolo servono a `lisi-platform` per sapere dove finisce la fascia
// trascinabile, e vanno lette da qui invece di essere riscritte la'.
export { Shell }
// Riesportato perche' Rust possa applicare la preferenza sul movimento: radar,
// transizioni ed entrate leggono `Appearance.motion-enabled` da un `global`, e
// il valore lo decide l'archivio insieme alla preferenza di accessibilita' di
// Windows (DEC-217).
export { Appearance }
// Riesportato perche' le prove possano leggere il blocco dal lato dei comandi:
// Rust lo imposta dalla proprieta' `station-locked`, che ne e' l'alias.
export { StationLock }
export { FocusRule }

// ----------------------------------------------------- profilo documentale
//
// I dati dell'ufficio che intestano ogni relazione: si chiedono **una volta**,
// al primo avvio, e da li' in poi ogni documento esce gia' intestato senza che
// nessuno li ridigiti (DEC-180).
//
// # Perche' un `global` e non delle proprieta' della finestra
//
// Lo stesso modulo compare in **due posti**: nella schermata di benvenuto al
// primo avvio e nelle Impostazioni, dove si aggiorna. Con delle proprieta'
// della finestra servirebbero dodici legami bidirezionali per ciascuno dei due
// punti di impiego, e ventiquattro legami scritti a mano sono ventiquattro
// occasioni di collegarne uno al campo sbagliato. Un `global` toglie il
// problema: il modulo legge e scrive **lo stesso stato**, ovunque sia messo.
//
// # Nessun dato istituzionale qui dentro
//
// I valori predefiniti sono stringhe vuote. Le denominazioni le scrive
// l'ufficio, e dove non le scrive il documento lascia lo spazio da compilare
// invece di inventarle (ADR-0031 Decisione 15, DEC-179).
export global DocumentProfile {
    in-out property <string> organisation;
    in-out property <string> office;
    // Sede, indirizzo e recapiti: la terza riga dell'intestazione.
    in-out property <string> premises;
    in-out property <string> recipient;
    in-out property <string> recipient-cc;
    in-out property <string> place;
    in-out property <string> signer-role;
    in-out property <string> signer-name;
    in-out property <string> footer-line;
    in-out property <string> subject-base;

    // Nome del file dello stemma, o vuoto. I byte vivono in Rust, dove sono
    // stati validati: l'immagine non attraversa mai il confine grafico.
    in property <string> emblem-name;

    // Se all'operatore la domanda e' gia' stata posta. **Falso soltanto al
    // primo avvio**: chi risponde «non li inserisco» ha risposto, e non se la
    // sente richiedere ogni volta.
    in property <bool> answered: true;
    // Versione conservata del profilo. 0 significa «mai salvato».
    in property <int> version: 0;
    in property <string> message;

    callback save();
    // Chiude la domanda senza compilare nulla: e' una risposta legittima.
    callback decline();
    callback choose-emblem();
    callback clear-emblem();
}
import { BrandMark } from "brand.slint";
import { Weight, Tone, Panel, HudButton, HudInput, HudCheck, HudSelect, HudNumber, HudScroll, StatusBadge, Counter, StatCard, ListRow, SelectableRow, StateBlock, StateKind, Banner, ErrorBanner, InfoBanner, TextField, SecretField, RadarPanel, DettagliTecnici, AvvertenzaDiSicurezza, Origine, OrigineSegno, LegendaOrigini, Spiegabile, PercheVedoQuesto, StatoCopertura, TrattoCopertura, TrattoRecuperato, BarraCopertura, LegendaCopertura } from "components.slint";

// Voce dell'elenco dei componenti di terze parti mostrato nella schermata
// "Informazioni e licenze". I dati provengono da Rust: l'attribuzione e' un
// obbligo di licenza e deve essere verificabile da un test, non scritta a mano
// nel file di interfaccia.
export struct ThirdPartyEntry {
    component: string,
    version: string,
    license: string,
    note: string,
}

// Sezione della guida: un titolo e il testo che lo spiega. Il contenuto arriva
// da Rust (lisi-core::guide), dove un test verifica che dichiari i limiti
// invece di sovrapprometterli.
// Una voce del glossario (PR-01, ADR-0117): il nome, la frase semplice e il
// dettaglio tecnico. Viene da `lisi_core::glossary`.
export struct GlossaryRow {
    term: string,
    plain: string,
    detail: string,
}

export struct GuideEntry {
    title: string,
    body: string,
}

// Riga dell'elenco della verifica: un rapporto esportato e il suo verdetto. I
// dati arrivano da Rust (ExportService::verify_directory): l'interfaccia mostra
// cio' che il motore ha constatato, senza ricalcolare nulla. `ok` distingue il
// rapporto integro da quello che non corrisponde piu' al suo manifest.
// Riga dello stato della postazione: una capacita' con il proprio esito.
//
// `blocking` e' separato da `usable` perche' dicono due cose diverse: una
// capacita' facoltativa che manca NON e' usabile e NON blocca. Confonderle
// mostrerebbe in rosso una postazione perfettamente idonea.
// Un monitoraggio nell'elenco, in breve.
//
// Con piu' monitoraggi (ADR-0065) la schermata deve poterli mostrare tutti e
// lasciarne scegliere uno. Porta il minimo: come si chiama, come sta, e se e'
// quello che la schermata sta mostrando.
export struct MonitoringRow {
    label: string,
    state: string,
    selected: bool,
}

export struct CapabilityRow {
    name: string,
    requirement: string,
    status: string,
    detail: string,
    usable: bool,
    blocking: bool,
}

export struct VerificationRow {
    report: string,
    // Dove sta il documento, rispetto alla cartella esaminata (CU01-009).
    folder: string,
    status: string,
    ok: bool,
}

// UNA VOCE DEL CENTRO DIAGNOSTICO (DIAG-01).
//
// # I tre stati NON sono due
//
// «Non misurato» ha un campo proprio, e non e' ne' `attention` ne' un verde
// silenzioso: un'area che il prodotto non ha potuto osservare non e' un'area
// che sta bene. Un centro che dipinge di verde cio' che non ha guardato
// insegna a fidarsi del verde, ed e' peggio di nessun centro.
//
// # Nessuna di queste stringhe contiene un percorso
//
// Le compone `lisi-services::diagnostics`, dove una prova negativa ispeziona
// ogni frase prodotta: un percorso reale su Windows contiene il nome
// dell'account Windows, e questa composizione e' la stessa che DIAG-02
// esportera' in un file destinato a essere spedito.
// UNA RIGA DELLA CODA DI LAVORO (WQ-01).
//
// # Che cosa NON c'e', e non per dimenticanza
//
// **Nessun assegnatario.** Non esiste «Prendi in carico» perche' non esiste
// ancora un'identita' di operatore autenticata: assegnare a un segnaposto
// direbbe che qualcuno ha preso in carico qualcosa quando nessuno lo ha fatto,
// e due operatori sulla stessa macchina lo crederebbero.
//
// **Nessun punteggio.** L'ordine e' un confronto fra fatti registrati, e
// `why-here` elenca gli stessi fatti nella stessa precedenza. Un numero si
// leggerebbe come una misura di gravita' del contenuto, che questo prodotto
// non produce.
//
// **Nessun testo del contenuto.** La coda dice che cosa aspetta e perche'; il
// testo si legge aprendo il contenuto nello Storico.
// UNA RIGA DELL'ESITO DEL RULE LAB (LAB-02).
//
// # Che cosa NON c'e'
//
// **Il testo del contenuto.** Il laboratorio confronta due configurazioni sui
// livelli e sui termini; il testo si legge nello Storico. Mostrarlo qui
// significherebbe mettere sotto gli occhi contenuti che nessuno ha deciso di
// guardare, dentro una schermata che serve a valutare un dizionario.
//
// **Un giudizio sulla modifica.** La riga dice che cosa cambia; se la modifica
// vada pubblicata lo decide una persona.
export struct LabRow {
    // "Contenuto 128".
    content: string,
    // "livello da 1 a 3 · 2 termini nuovi".
    reason: string,
    // Vero quando il livello sale, per il colore.
    raised: bool,
    // Vero quando scende.
    lowered: bool,
    // Vero quando la versione pubblicata NON riproduce il livello registrato
    // nell'archivio: quella differenza non e' attribuibile al candidato, e la
    // riga lo dichiara in ambra.
    not-reproducing: bool,
}

// UN TERMINE CHE LA BOZZA CAMBIA (OPERATOR-E2E-REMEDIATION-01, F-07).
//
// La frase la compone il servizio («Aggiunto «rogo» (parola, livello +2,
// categoria azione).»); qui c'e' il segno per la colonna, e se e' un
// termine tolto, che si legge in ambra perche' togliere fa perdere riscontri.
export struct LabTermRow {
    sign: string,
    sentence: string,
    removed: bool,
}

// CHE COSA LA REVISIONE UMANA DICE DI UNA REGOLA (FEEDBACK-01).
//
// # Che cosa NON c'e' in questa riga, e perche'
//
// **Nessun valore nuovo.** Nessun livello proposto, nessun termine da
// togliere, nessuna modifica applicabile: soltanto l'identita' della regola,
// i conteggi delle decisioni e, quando c'e', l'invito a guardarla.
//
// Un suggerimento che portasse il valore nuovo sarebbe una modifica in attesa
// di un pulsante, e accanto a un numero che sembra gia' calcolato premerlo
// costa niente. Poiche' il valore nuovo non esiste, non c'e' nulla da
// applicare: NEXUM SUGGERISCE, e non modifica mai un dizionario.
//
// **Nessun punteggio.** «Questa regola vale 0,73» sarebbe una valutazione
// appresa travestita da statistica (ADR-0048). Si contano gli esiti, e chi
// legge giudica.
export struct FeedbackRow {
    // "«molotov» (oggetto, Ordine pubblico v2)".
    rule: string,
    // "3 confermano il motore, 9 lo smentiscono, 1 non lo giudica. 20
    // contenuti, di cui 7 ancora da esaminare."
    counts: string,
    // L'invito a guardare la regola nel Rule Lab, vuoto quando non ce n'e'
    // uno. Sotto la soglia NEXUM tace, perche' un invito che compare sempre
    // smette di essere un invito.
    suggestion: string,
    // Vero quando l'invito c'e', per il colore.
    suggested: bool,
}

// UN CONTENUTO CHE SOMIGLIA A QUELLO SCELTO (SIM-01).
//
// # Perche' c'e' l'evidenza e non solo la percentuale
//
// Perche' una percentuale non e' un perche': e' il risultato di un conto che
// chi legge non ha visto. Le SEQUENZE CONDIVISE sono l'esito dell'algoritmo, e
// si mostrano.
//
// # Perche' non si chiama «duplicato»
//
// Perche' «duplicato» e' uno stato della revisione, cioe' la decisione di una
// persona presa con motivo, istante e audit. Un algoritmo che producesse la
// stessa parola confonderebbe una misura con un giudizio registrato.
export struct ResemblanceRow {
    // "Contenuto 128".
    other: string,
    // "27 sequenze di 3 parole in comune su 31 del piu' corto (87%).
    // Pubblicati a 17 minuti di distanza. In comune anche: cve «...»."
    why: string,
    // Alcune delle sequenze condivise, virgolettate: e' l'evidenza.
    evidence: string,
    // LA COPPIA, in numeri. Serve a chiedere «che genere di certezza e'?»
    // (PROV-02): una coppia si nomina con i due identificativi, e non con
    // l'etichetta «Contenuto 128», che e' una frase per chi legge e non una
    // chiave.
    pair-key: string,
}

// UN MESSAGGIO DEL CONTORNO, COME TELEGRAM LO MOSTRA ADESSO (CTX-03).
//
// # Perche' non e' una prova
//
// Perche' e' stato letto ORA, e ora e' tutto cio' che se ne sa. Puo' essere
// stato modificato dopo la pubblicazione, puo' sparire un istante dopo, e
// nessuno lo ha acquisito con la disciplina con cui il prodotto acquisisce.
//
// La prova e' il contenuto dell'archivio, che sta in cima al pannello, in un
// riquadro suo. Queste righe le stanno attorno.
// UNA FOTOGRAFIA GIA' PRESA (CTX-06).
//
// Ogni campo e' una frase gia' composta dal servizio: le parole con cui si
// dice che cosa una persona ha conservato, e perche', finiscono in un
// fascicolo, e non si ricompongono in una schermata (DEC-252).
// UN WORKSPACE OPERATIVO (WS-02).
//
// Il contenitore di lavoro, come l'elenco lo mostra. La frase la compone il
// modello (DEC-252): dice chi lo ha aperto, quando, e che NON conserva copie
// del materiale — che e' l'unica cosa che lo distingue da un archivio.
export struct WorkspaceRow {
    id: int,
    name: string,
    sentence: string,
    // Vero finche' e' in lavorazione. Uno chiuso non accetta ne' perde
    // elementi, e non si riapre: i comandi che scrivono non compaiono.
    open: bool,
}

// UN RIFERIMENTO RACCOLTO.
//
// Porta CHE COSA e QUALE, e la frase che il dominio ha composto — o
// l'etichetta con cui la cosa si riconosce ADESSO, o la dichiarazione che non
// e' piu' nell'archivio.
//
// Non porta il testo del materiale: un workspace riferisce senza copiare, e
// cio' che mostra e' cio' che l'archivio dice adesso.
export struct WorkspaceEntryRow {
    kind: string,
    target-id: int,
    sentence: string,
    // Falso quando il riferimento non arriva piu' a nulla. La riga COMPARE
    // lo stesso: nasconderla direbbe che quella cosa non e' mai stata
    // raccolta.
    present: bool,
    // "raccolto da ... il ...".
    added: string,
}

// UN CONTENUTO CHE PUO' USCIRE IN UN PACCHETTO DI EVIDENZE (PR-11, ADR-0127).
// Esce soltanto se una persona lo spunta.
export struct EvidenceChoice {
    content-id: int,
    // L'etichetta con cui il contenuto si riconosce adesso.
    sentence: string,
    // Vero quando una persona lo ha spuntato.
    chosen: bool,
}

// UN PACCHETTO DI EVIDENZE PRODOTTO: che cosa e' uscito, e quando.
// RIFERIMENTI INFORMATICI (PR-14, ADR-0130). Una fotografia importata: che cosa
// dice la fonte di sé, quando e chi l'ha importata, che cosa contiene.
export struct ReferenceSnapshotRow {
    key: int,
    source: string,
    when: string,
    who: string,
    content: string,
}

// Un'associazione fra un termine e una tecnica ATT&CK, dichiarata da una
// persona: la frase del dominio, il motivo, chi e quando.
export struct ReferenceAssociationRow {
    key: int,
    sentence: string,
    motive: string,
    who: string,
    when: string,
}

// Una voce dell'anteprima STIX: il valore osservato, il genere, quanti
// contenuti lo nominano, se entra o perché resta fuori.
export struct StixPlanRow {
    value: string,
    kind: string,
    contents: string,
    outcome: string,
}

export struct EvidencePackageRow {
    reference: string,
    when: string,
    who: string,
    count: string,
    // Il motivo scritto da chi lo ha prodotto.
    motive: string,
}

// UNA RACCOLTA DI SEGNALIBRI (BOOK-01).
//
// Un'etichetta, non un lavoro che si conclude: NON ha uno stato aperto/chiuso.
// Darglielo sarebbe copiare il workspace cambiandogli nome, e due meccanismi
// uguali con nomi diversi divergono.
export struct BookmarkCollectionRow {
    id: int,
    name: string,
    // "creata da ... il ...".
    created: string,
    // Quanti segnalibri contiene ADESSO. Serve a chi sta per cancellarla:
    // «non si puo'» senza dire quanti lascia a indovinare quanto lavoro c'e'.
    count: int,
}

// UN SEGNALIBRO (BOOK-01).
//
// Porta CHE COSA e QUALE, e la frase che il dominio ha composto — o l'etichetta
// con cui la cosa si riconosce ADESSO, o la dichiarazione che non e' piu'
// nell'archivio.
//
// NON porta il testo del materiale, e NON porta parole dell'operatore: quelle
// sono NOTE-01, e due posti in cui scriverle divergono.
// UN SOGGETTO INVESTIGATIVO (PERS-01).
//
// NON e' una persona dell'elenco derivato: quella e' un'osservazione, questo e'
// un fascicolo che qualcuno ha deciso di aprire.
//
// NON porta una valutazione. Non un punteggio, non un livello, non un rischio:
// il congelamento lo vieta tre volte, e un campo numerico su una persona
// diventa una misura il giorno in cui qualcuno lo mostra accanto a un nome.
// UNA VOCE DELLA SCHEDA DEL SOGGETTO (ADR-0153, DG-08): una nota o un
// riferimento, nella frase del servizio, ritirata o no.
export struct SubjectEntryRow {
    id: int,
    sentence: string,
    withdrawn: bool,
    // Il contenuto a cui la voce rimanda, per aprirne la conversazione
    // (ADR-0165); -1 se la voce non rimanda a un contenuto.
    content-id: int,
}

export struct PersonRow {
    id: int,
    label: string,
    // "Soggetto aperto da ... il ... . Un fascicolo aperto non e' una
    // valutazione." — composta dal modello (DEC-252).
    sentence: string,
    // La ragione scritta aprendo. Si legge e NON si modifica: se potesse
    // cambiare, chi ha aperto e quando direbbero una cosa falsa.
    reason: string,
    // Vero finche' il fascicolo e' aperto. Uno chiuso resta nell'elenco:
    // nasconderlo direbbe che nessuno lo ha mai aperto.
    open: bool,
    // LA VALUTAZIONE UMANA (PERS-05).
    //
    // Uno dei quattro stati previsti dal congelamento. NON e' un punteggio e
    // non e' un numero: e' una parola, e la porta chi l'ha scritta.
    assessment-label: string,
    // Che cosa quella valutazione dice, e che cosa NON dice — composta dal
    // modello, come la frase del soggetto. Per «PRIORITA' ALTA» dice che
    // riguarda quanto lavoro merita il fascicolo, non quanto e' pericolosa una
    // persona.
    assessment-sentence: string,
    // COME CI SI E' ARRIVATI. Vuota quando c'e' un atto solo: quello lo dice
    // gia' la frase, e ripeterlo sarebbe rumore. Due o piu' raccontano una
    // storia — chi ha alzato, chi ha ritirato, e quando.
    assessment-history: [string],
    // LE IDENTITA' OSSERVATE CHE QUALCUNO HA DECISO DI COLLEGARE (PERS-06).
    //
    // Ogni riga porta CHI ha collegato e QUANDO: un elenco di soli
    // identificativi si leggerebbe come un risultato del programma, ed e'
    // esattamente cio' che questi legami non sono.
    linked-identities: [string],
    // LA STORIA DEI LEGAMI. Vuota quando nessuno e' mai stato sciolto: un
    // legame mai toccato lo dice gia' la riga sopra.
    link-history: [string],
    // CHE COSA SI E' OSSERVATO DELLE IDENTITA' COLLEGATE (PERS-07).
    //
    // Ogni riga porta il MONITORAGGIO da cui viene: e' la condizione a cui
    // l'unione di monitoraggi diversi e' lecita. PERS-02, PERS-03 e PERS-04
    // l'avevano rifiutata tre volte, e la ragione era la tracciabilita' —
    // «chi lo consegna non potrebbe piu' dire a quale dei due si riferisce».
    //
    // E ogni blocco porta il LEGAME che ce l'ha messo: senza, un fascicolo
    // con dentro contenuti e alert si leggerebbe come se il programma avesse
    // scoperto quelle cose su quella persona.
    dossier: [string],
    // Note e riferimenti, e i nomi osservati delle identità collegate
    // (ADR-0153).
    entries: [SubjectEntryRow],
    observed-names: [string],
}

// UN MODELLO DI MONITORAGGIO (TEMPLATE-01).
//
// Una configurazione riusabile: quali fonti, con quali dizionari, e che cosa
// prevede per la soglia di notifica e per la conservazione.
//
// NON porta le versioni dei dizionari: un modello nomina un profilo, e la
// versione si risolve quando il modello si applica. Fissarle farebbe usare per
// sempre i dizionari com'erano il giorno in cui il modello fu creato.
export struct TemplateRow {
    id: int,
    name: string,
    // "Creato da ... il ... . Prevede N fonti e un profilo di dizionari."
    sentence: string,
    description: string,
}

// UNA SCELTA DEL MODULO DI UN MODELLO (F-07): una fonte o un dizionario, con la
// casella.
export struct TemplateChoice {
    id: int,
    label: string,
    detail: string,
    chosen: bool,
}

// UNA FONTE DI UN MODELLO, come si risolve ADESSO.
export struct TemplateSourceRow {
    // Il nome con cui si riconosce adesso, oppure la dichiarazione che non e'
    // piu' nell'archivio. La riga COMPARE lo stesso: nasconderla direbbe che il
    // modello non l'aveva mai nominata.
    sentence: string,
    present: bool,
}

// UNA RICERCA SALVATA (SEARCH-01).
//
// La domanda, non la risposta. NON porta i risultati: conservarli darebbe una
// fotografia che invecchia e che, riaperta, sembrerebbe attuale.
export struct SavedSearchRow {
    id: int,
    name: string,
    // "Salvata da ... il ... . Contenuti che contengono «...», di livello almeno
    // N, in tutte le sessioni." — composta dal modello (DEC-252).
    sentence: string,
}

// UNA NOTA DELL'OPERATORE (NOTE-01).
//
// Le parole di una persona su qualcosa che sta nell'archivio. Porta il CORPO —
// che e' il punto — e la frase che dice CHI e QUANDO, composta dal modello
// (DEC-252).
//
// Una nota RITIRATA compare lo stesso, e lo dichiara: qualcuno puo' averci
// lavorato sopra, e farla sparire riscriverebbe che cosa quella persona aveva
// davanti.
export struct NoteRow {
    id: int,
    // Le parole, come sono state scritte. NON si riscrivono: non esiste un
    // comando che le modifichi, ne' qui ne' in nessun altro punto del prodotto.
    body: string,
    // "Scritta da ... il ...", oppure la stessa cosa piu' chi l'ha ritirata e
    // quando.
    sentence: string,
    // Vero finche' vale. Su una ritirata i comandi che scrivono non compaiono:
    // l'archivio li rifiuterebbe.
    stands: bool,
    // Su che cosa, gia' risolto — oppure la dichiarazione che quella cosa non
    // e' piu' nell'archivio. Vuoto quando la nota si legge gia' accanto alla
    // cosa annotata, dove ripeterlo sarebbe rumore.
    target: string,
    // Falso quando il riferimento non arriva piu' a nulla.
    present: bool,
}

export struct BookmarkRow {
    id: int,
    kind: string,
    // Che cosa e' segnato, per aprirlo (ADR-0151): il numero del contenuto
    // quando il segno e' su un contenuto.
    target-id: int,
    sentence: string,
    // Falso quando il riferimento non arriva piu' a nulla. La riga COMPARE lo
    // stesso: nasconderla direbbe che quella cosa non e' mai stata segnata.
    present: bool,
    // "segnato da ... il ...".
    marked: string,
    // Il nome della raccolta, oppure "" quando e' sciolto. Nessuna raccolta e'
    // il caso ORDINARIO: obbligarla sarebbe reintrodurre la cerimonia che un
    // segnalibro esiste per non avere.
    collection-name: string,
    collection-id: int,
}

export struct SnapshotRow {
    // "Fotografia presa da ... il ..., per questa ragione: ...".
    sentence: string,
    // Falso quando l'impronta ricalcolata non coincide con quella registrata.
    // NON accusa nessuno: un'impronta riconosce una differenza, non prova una
    // responsabilita'.
    intact: bool,
}

export struct ContextRow {
    // "14 novembre 2023, 22:13 UTC".
    when: string,
    // Il testo, come si legge adesso.
    text: string,
    // Vero per il messaggio attorno a cui il contesto e' stato chiesto: e' lo
    // STATO CORRENTE di quel messaggio, e sta ACCANTO alla prova, non al posto
    // suo. Se il testo differisce, la differenza si vede — che cosa significhi
    // lo stabilira' CTX-05.
    is-anchor: bool,
    // CHI LO HA SCRITTO, in una frase gia' composta dal servizio (CTX-04).
    //
    // C'e' SEMPRE: uno spazio bianco al posto dell'autore si legge come
    // "scritto da nessuno", mentre il caso ordinario e' che nei canali il
    // mittente sia il canale stesso, e questo va detto.
    who: string,
    // A CHE COSA SI LEGA: risposta, inoltro e origine dell'inoltro,
    // discussione, stato di modifica. Vuota quando non si lega a nulla —
    // che e' diverso da una riga vuota, e infatti non si disegna.
    //
    // La frase la compone il servizio (DEC-252): qui non arriva una
    // struttura, perche' una struttura, prima o poi, viene ricomposta.
    relations: string,
    // Il numero del messaggio presso Telegram, come Telegram lo dichiara
    // (ADR-0151): con l'ora, e' cio' che permette di ritrovarlo.
    number: string,
}

// QUALCOSA CHE COMPARE PIU' DI PRIMA (TREND-01).
//
// # Perche' due conteggi e non un indice
//
// Perche' un numero solo — «emergenza 0,78» — sarebbe una valutazione appresa
// travestita da statistica, ed e' cio' che ADR-0048 esclude dal prodotto. Qui
// ci sono due conteggi di fatti registrati e la loro differenza, e quanto valga
// quella differenza lo giudica chi legge.
//
// # Perche' non c'e' una parola come «tendenza»
//
// Perche' due finestre non sono una serie. Questa riga dice che cosa e'
// cambiato fra due periodi, non che cosa stia crescendo.
export struct TrendRow {
    // "termine «assalto»".
    what: string,
    // "14 volte nel periodo recente, e nel periodo di confronto compariva 2
    // volte. Differenza: 12."
    counts: string,
}

// UNA DELLE UNDICI RISPOSTE DEL CRUSCOTTO (DASH-01).
//
// # I tre stati, e perche' «non disponibile» ne e' uno
//
// Una domanda a cui questa versione non sa rispondere lo DICHIARA. Mostrare
// zero direbbe che non c'e' nulla, quando in realta' nessuno ha ancora
// guardato: e' la stessa regola di ADR-0053 e di ADR-0054, alla terza
// superficie.
export struct DashboardRow {
    // "Salute delle fonti", "Coda di lavoro", ...
    question: string,
    // La risposta breve: un numero, o una parola. Mai una percentuale.
    value: string,
    // La frase che la qualifica, e che dice il gesto quando ce n'e' uno.
    note: string,
    // Vero quando chiede un gesto.
    attention: bool,
    // Vero quando questa versione non sa rispondere. NON e' zero.
    unavailable: bool,
}

// Un periodo non coperto prioritario (PR-06, ADR-0122). La priorita' e'
// TECNICA: ordina, e non afferma.
export struct GapRow {
    // La fonte, come l'operatore la conosce.
    source: string,
    // "Dal ... al ...".
    when: string,
    // "alta", "media".
    priority: string,
    // La frase del periodo, con il criterio applicato e che cosa non
    // significa.
    sentence: string,
    // La chiave con cui il Rust ritrova il periodo: non si mostra.
    key: string,
}

// Un periodo deciso «da valutare per un recupero» (PR-07, ADR-0123), con il
// monitoraggio in cui si recupera o il motivo per cui qui no.
export struct IntervalRow {
    // La fonte, come l'operatore la conosce.
    source: string,
    // Il periodo, chi lo ha deciso, dove si recupera, che cosa e' gia' stato
    // fatto.
    sentence: string,
    // Vero quando il periodo cade in un monitoraggio in corso.
    recoverable: bool,
    // La chiave con cui il Rust ritrova il periodo: non si mostra.
    key: string,
}

// Una ricerca puntuale registrata (PR-09, ADR-0125).
export struct ResolutionRow {
    // Quando.
    when: string,
    // Chi l'ha chiesta.
    operator: string,
    // Che cosa e' stato cercato, com'e' stato scritto, con il genere.
    input: string,
    // L'esito, fra i cinque.
    outcome: string,
    // Cio' che Telegram ha restituito: soltanto per un «Trovato», vuoto
    // altrimenti.
    found: string,
    // Il motivo, o per un «Trovato» che cosa NON e' arrivato.
    sentence: string,
    // Il numero della ricerca nel registro: non si mostra.
    id: int,
    // Vero quando la riga e' un «Trovato» di una persona o di un account, e
    // quindi si puo' collegare a un soggetto (PR-10).
    linkable: bool,
}

// Una fonte di un monitoraggio in corso, di cui si puo' chiedere lo storico
// precedente all'avvio (PR-08, ADR-0124).
export struct PriorHistoryRow {
    // La fonte, come l'operatore la conosce.
    source: string,
    // Il monitoraggio, con il nome che gli ha dato chi l'ha creato.
    session: string,
    // L'avvio, e gli storici gia' archiviati.
    sentence: string,
    // Vero quando la cronologia della fonte si puo' chiedere.
    readable: bool,
    // La chiave con cui il Rust ritrova la riga: non si mostra.
    key: string,
}

export struct QueueRow {
    // Dove sta, per andarci: la fonte e la sessione.
    source: string,
    session: string,
    // "Livello 3", scritto e non solo colorato.
    level-label: string,
    // Il livello numerico, per il colore. NON e' una priorita': e' il livello
    // che il motore ha assegnato al contenuto.
    level: int,
    // "Mai esaminato", "In esame".
    state: string,
    // Vero per cio' che nessuno ha ancora toccato.
    untouched: bool,
    // I fatti che lo hanno collocato dov'e', nella stessa precedenza in cui
    // l'ordine li guarda.
    why-here: string,
    // La motivazione dell'alert, come il motore l'ha scritta.
    reason: string,
    // L'inizio del testo, e il contenuto da aprire (OPERATOR-UX-REMEDIATION-01,
    // OS-10): la riga diceva fonte e livello, e non di che cosa si trattasse.
    excerpt: string,
    content-id: int,
}

export struct DiagnosticRow {
    // "Archivio", "Spazio su disco", ...
    area: string,
    // "In ordine", "Da guardare", "Guasto", "Non misurato".
    outcome: string,
    // La frase che lo dice.
    detail: string,
    // DOVE si compie il gesto, quando ce n'e' uno. Il centro non lo compie:
    // un secondo pannello di comandi accanto a quello vero e' due pannelli
    // che divergono.
    action: string,
    // Vero per «Da guardare».
    attention: bool,
    // Vero per «Guasto».
    problem: bool,
    // Vero per «Non misurato». Distinto dagli altri due, e neutro.
    unmeasured: bool,
}

// Riga del centro notifiche: una notifica emessa, con cio' che la spiega. I
// dati arrivano da Rust (NotificationService::history). Il centro e' una
// revisione in-app (DEC-105): mostra il contenuto per intero e con quale
// riservatezza la notifica e' apparsa sulla schermata bloccata.
export struct NotificationCard {
    emitted: string,
    source: string,
    level-label: string,
    privacy: string,
    reason: string,
    excerpt: string,
    url: string,
}

// Riga della coda di revisione condivisa (TEAM-REVIEW-01, ADR-0094).
//
// Porta METADATI: identificativo, fonte, livello, istante, stato e versione.
// Il testo del messaggio non e' qui e non deve esserci: si apre un elemento
// per volta, e aprirlo e' un atto che l'Hub registra.
export struct ReviewQueueRow {
    content-id: int,
    source: string,
    level: string,
    raised: string,
    state: string,
    version: int,
    // Perche' sta dov'e': i fatti, nella precedenza in cui contano
    // (TEAM-WQ-01, ADR-0095). Vuoto quando l'Hub non compone la coda.
    why: string,
    // A chi e' il lavoro (TEAM-ASSIGN-01, ADR-0098). Vuoto quando non e' di
    // nessuno, o quando questo Hub non sa assegnare.
    assigned: string,
}

// Una relazione dell'ufficio (TEAM-REPORT-01, ADR-0100).
//
// NOMI E IMPRONTE, MAI BYTE: il protocollo dell'Hub non trasporta documenti.
// L'impronta serve a chi riceve il file per altra via a verificare che sia
// quello.
export struct SharedReportRow {
    report-id: string,
    who: string,
    state: string,
    counts: string,
    documents: string,
}

// Un raccoglitore dell'ufficio (TEAM-WS-01, ADR-0099).
export struct SharedWorkspaceRow {
    id: int,
    name: string,
    description: string,
    state: string,
    open: bool,
    summary: string,
}

// Un riferimento raccolto. CHE COSA E QUALE, mai il testo.
export struct SharedItemRow {
    what: string,
    added: string,
    // Per togliere l'elemento (FR-050): il genere e il numero, mai il testo.
    kind: string,
    target: int,
}

// Una nota dell'ufficio (TEAM-WS-01, ADR-0099).
//
// Porta LE PAROLE DI CHI ANNOTA, mai quelle del messaggio annotato. Una nota
// ritirata resta, e lo dice: chi l'aveva letta deve poter capire che cosa e'
// successo a cio' che aveva letto.
export struct SharedNoteRow {
    id: int,
    body: string,
    author: string,
    written: string,
    withdrawn: string,
    mine: bool,
}

// Un collega dell'ufficio (TEAM-ASSIGN-01, ADR-0097).
//
// NESSUN VERIFICATORE: cio' che l'Hub conserva al posto di una frase non esce
// da li'.
export struct TeamPersonRow {
    person: string,
    label: string,
    role: string,
    active: bool,
}

// Riga del live condiviso (TEAM-LIVE-01, ADR-0093).

//
// Porta fatti dell'attivita' - che cosa e' accaduto, da quale fonte, quando -
// e MAI il testo di un messaggio: il contenuto monitorato resta sull'Hub.
export struct TeamLiveRow {
    when: string,
    kind: string,
    subject: string,
    detail: string,
    sequence: string,
}

// Riga della presenza (TEAM-PRESENCE-01, ADR-0096).
//
// Tre cose, e nessuna in piu': quale postazione, da quando, quando l'Hub
// l'ha vista l'ultima volta. NON la schermata aperta, NON il contenuto in
// lettura, NON l'indirizzo di rete: dire che cosa sta facendo un collega
// momento per momento e' guardare il collega, non il lavoro.
export struct TeamPresenceRow {
    station: string,
    since: string,
    last-seen: string,
}

// Una persona dell'ufficio, come la vede chi amministra l'Hub (FINAL-REVIEW-01,
// FR-047). Mai la frase, né il suo verificatore.
export struct HubPersonRow {
    id: string,
    name: string,
    role: string,
    state: string,
    active: bool,
}

// Riga dell'elenco delle chat accessibili all'account.
export struct AvailableSourceEntry {
    chat-id: string,
    title: string,
    kind: string,
    // Username pubblico con la chiocciola, quando la chat ne ha uno. Vuoto
    // altrimenti: molte fonti private non ne hanno, e l'assenza non e' un
    // difetto. Serve soprattutto a distinguere due chat con lo stesso titolo,
    // che e' il caso in cui si configura la fonte sbagliata.
    username: string,
    already-configured: bool,
    selectable: bool,
    reason: string,
}

// Riga dell'elenco degli account Telegram.
//
// Il numero compare solo mascherato, quando noto: il numero pieno non e' mai
// ne' persistito ne' mostrato.
export struct TelegramAccountEntry {
    id: int,
    label: string,
    status: string,
    masked-phone: string,
    selected: bool,
    // Vero quando l'account ha un collegamento aperto: il selezionato, o uno
    // tenuto collegato (MULTI-ACCOUNT-02, ADR-0173).
    linked: bool,
    // Lo stato di quel collegamento: «Collegato», «In collegamento» o
    // «Collegamento in errore». Un account tenuto collegato può cadere mentre
    // si lavora su un altro, e la riga lo dice.
    link-label: string,
    link-trouble: bool,
    linked: bool,
    // Vero quando resta collegato anche selezionandone un altro.
    kept: bool,
}

// Riga della libreria dei dizionari.
//
// Porta gia' calcolato tutto cio' che la schermata mostra, compreso il motivo
// per cui un dizionario non e' utilizzabile: la decisione sta nei servizi, che
// sono coperti da test, e l'interfaccia si limita a mostrarla.
export struct DictionaryEntry {
    dictionary-id: int,
    name: string,
    description: string,
    scope: string,
    origin: string,
    visibility: string,
    status: string,
    // Numero della versione pubblicata, 0 se non ce n'e' alcuna.
    published-version: int,
    published-terms: int,
    has-open-draft: bool,
    built-in: bool,
    usable: bool,
    // Vuoto quando il dizionario e' utilizzabile.
    unusable-reason: string,
}

// Riga dell'anteprima di un dizionario: un termine della versione pubblicata.
export struct TermEntry {
    // Identificativo, necessario per poter togliere il termine da una bozza.
    // Zero quando la voce viene da una versione pubblicata, che e' immutabile
    // e da cui non si toglie nulla.
    term-id: int,
    text: string,
    category: string,
    match-mode: string,
    // Livello suggerito, gia' reso in testo: il segno conta, e "-2" letto come
    // numero in un widget potrebbe perderlo.
    suggested-level: string,
    mitigating: bool,
    note: string,
}

// Riga selezionabile del wizard: una fonte fra quelle configurate.
export struct WizardSourceEntry {
    source-id: int,
    title: string,
    kind: string,
    selected: bool,
}

// Riga selezionabile del wizard: un dizionario fra quelli utilizzabili.
export struct WizardDictionaryEntry {
    dictionary-id: int,
    name: string,
    scope: string,
    terms: int,
    selected: bool,
    // Che cosa il dizionario cerca, con le parole di chi l'ha scritto.
    //
    // Fino al 2026-07-31 la riga mostrava solo nome, ambito e un **numero** di
    // termini: chi doveva scegliere non aveva modo di sapere che cosa un
    // dizionario cercasse ne' quali parole contenesse, e sceglieva alla cieca.
    description: string,
    // Alcune parole del dizionario, come assaggio. Non l'elenco completo: la
    // riga deve restare leggibile, e l'elenco intero vive nella schermata
    // Dizionari.
    sample: string,
    // Se le parole mostrate sono meno di quelle contenute.
    sample-truncated: bool,
}

// Parola aggiunta al solo monitoraggio in composizione.
export struct WizardTermEntry {
    index: int,
    text: string,
    match-mode: string,
    // La gravita' dichiarata al momento dell'aggiunta. Fino al 2026-08-04
    // l'operatore la sceglieva e non la rivedeva piu': ne' sulla riga, ne' nel
    // riepilogo, che contava le parole senza dirne il peso. Un clic sbagliato
    // restava invisibile fino a monitoraggio avviato, e l'unico rimedio era
    // togliere la parola e riaggiungerla. Rilevato in campo.
    level: string,
}

// Un indicatore tecnico nominato dai contenuti di un grappolo.
// Un'organizzazione che l'amministratore ha dichiarato di sorvegliare.
//
// L'elenco NON sta nel sorgente: un elenco di enti inciso nel codice sarebbe una
// lista arbitraria che nessuno ha approvato e che, su ogni postazione, direbbe a
// chiunque la legga quali enti l'ufficio considera bersagli
// (docs/dictionaries/PD6_SECTOR_TAXONOMY.md). Lo dichiara chi amministra, e vive
// nell'archivio della postazione.
export struct WatchedOrganisationEntry {
    id: int,
    name: string,
    // L'etichetta del settore NIS2, come la legge l'operatore.
    sector: string,
    // I nomi e i domini dichiarati, gia' composti in una riga leggibile: sono
    // cio' che fa scattare il riscontro, e vanno riletti da chi li ha scritti.
    anchors: string,
    // Sospesa: resta leggibile e non produce piu' riscontri. E' la ragione per
    // cui si sospende invece di cancellare — le attribuzioni gia' registrate
    // devono restare spiegabili.
    active: bool,
    // Chi l'ha dichiarata e quando. Senza, un'attribuzione non si potrebbe
    // contestare.
    declared: string,
}

// UN MESSAGGIO TROVATO DALLA RICERCA B O C (ADR-0154): non e' un'acquisizione.
export struct CyberHitRow {
    chat: string,
    when: string,
    who: string,
    excerpt: string,
}

export struct CyberRecurringRow {
    id: int,
    title: string,
    coverage: string,
    novelties: string,
    suspended: bool,
}
export struct CyberCrossRow {
    chat: string,
    when: string,
    who: string,
    excerpt: string,
    found-by: string,
}
export struct SourceSuggestionRow {
    address: string,
    title: string,
    reason: string,
}
export struct SourceReliabilityRow {
    source-id: int,
    name: string,
    sentence: string,
}
export struct CyberIndicatorEntry {
    kind: string,
    value: string,
}

// Un grappolo di segnali, come la schermata Cyber Watch lo mostra.
//
// NON e' un incidente confermato, e nessun campo di questa struttura puo'
// diventarlo: non esiste uno stato «confermato» che il programma possa
// assegnare da se'. Quella e' una conclusione, e una conclusione la trae una
// persona (ADR-0035 Decisione 6).
export struct CyberEventEntry {
    // PERCHE' questi contenuti stanno insieme. Viene prima di tutto il resto:
    // un numero senza una ragione e' un numero che non si puo' contestare.
    reason: string,
    // Che cosa il grappolo permette di dire, e che cosa no. Porta con se' la
    // frase sulle fonti distinte, che e' l'errore piu' probabile di chi legge.
    assessment: string,
    contents: int,
    distinct-sources: int,
    apparent-reposts: int,
    // Quando il primo e l'ultimo contenuto sono stati PUBBLICATI, non
    // acquisiti: il grappolo racconta quando la cosa e' stata detta.
    first-seen: string,
    last-seen: string,
    // I segnali di rilevanza per l'Italia. Riguardare l'Italia NON rende grave
    // nulla, e la frase lo dice quando il solo segnale e' la lingua.
    italy: string,
    has-italy-signal: bool,
    // I settori delle organizzazioni che l'amministratore ha dichiarato, con la
    // provenienza di ciascuna attribuzione: quale nome o quale dominio ha
    // riscontrato, e chi ha scritto la regola.
    //
    // **Ricadere in un settore dell'allegato I non rende grave nulla**, e la
    // frase lo dice per esteso: dice in quale ambito ricadrebbe il fatto, se
    // fosse vero. E' la stessa separazione della rilevanza italiana, e la
    // ragione e' la stessa (ADR-0035 Decisione 10).
    sectors: string,
    has-sector: bool,
    // Le etichette dei settori toccati, per la riga breve in testa alla voce.
    // Due organizzazioni della sanita' toccano UN settore, non due.
    sector-labels: string,
    indicators: [CyberIndicatorEntry],
    // Che cosa una PERSONA ha deciso, per contenuto. Non c'e' uno stato del
    // grappolo: riassumerlo in una parola cancellerebbe la differenza fra due
    // messaggi giudicati rilevanti e otto mai guardati.
    review: string,
    // Il valore su cui cercare per ritrovare i contenuti nello Storico.
    search-key: string,
    // Il GENERE dell'indicatore che tiene insieme il gruppo, nella forma
    // dell'archivio: serve a ricomporre la ragione quando si chiede la
    // cronologia. Da solo il valore non basta — «esempio.it» puo' essere un
    // dominio e non un URL, e chiedere la cronologia del genere sbagliato
    // restituirebbe un elenco vuoto senza dire perche'.
    reason-kind: string,
    // Il primo contenuto del grappolo, per pubblicazione, per aprirne la
    // conversazione (ADR-0165); -1 per un grappolo arrivato dall'Hub.
    first-content-id: int,
}

// Un evento candidato di tutto l'archivio (CYBER-EVENTS-02, ADR-0189): un
// episodio di un indicatore, con i monitoraggi in cui ricorre. Resta un
// candidato, da verificare: non c'e' uno stato «confermato».
export struct CyberCandidateEntry {
    sentence: string,
    // Il primo e l'ultimo istante di pubblicazione.
    first-seen: string,
    last-seen: string,
    // I monitoraggi in cui ricorre, per nome.
    sessions: string,
    review: string,
    first-content-id: int,
}

// Una riga della cronologia di un gruppo (CYT-01).
//
// OGNI RIGA DICE DI QUALE OROLOGIO E' IL PROPRIO ISTANTE, e non e' un
// dettaglio: gli istanti dei contenuti li dichiara la fonte, quelli delle
// revisioni li ha misurati questa postazione. Nessuno li ha sincronizzati, e
// due righe una sotto l'altra sembrano dire «prima questo, poi quello» anche
// quando quella successione non e' stata osservata da nessuno.
export struct CyberTimelineEntry {
    // L'istante, come si legge.
    when: string,
    // Di quale orologio e'. Sta su ogni riga e non una volta in fondo: una
    // riga copiata in una relazione viaggia da sola.
    clock: string,
    // Che cosa e' successo.
    what: string,
    // A che cosa rimanda: contenuto, contesto, messaggio originale.
    reference: string,
    // Se e' l'atto di una persona invece che un'osservazione dell'archivio.
    // Le due cose non si rendono allo stesso modo, perche' non sono la stessa
    // cosa e chi legge deve poterlo vedere senza leggere la frase.
    is-human-act: bool,
}

// Un nodo del grafo, come la schermata lo disegna (GRAPH-02).
//
// LA POSIZIONE ARRIVA GIA' CALCOLATA, in frazioni da 0 a 1. Non la decide il
// disegno: la decide `graph_layout`, dove si prova che due letture danno la
// stessa figura. Un disegno che calcolasse da se' le posizioni mostrerebbe
// domani, nel documento di GRAPH-03, una figura diversa da quella guardata
// oggi sullo schermo.
// Una scoperta pubblica registrata, nell'elenco.
export struct DiscoveryRunEntry {
    // Quando e' cominciata, gia' leggibile.
    when: string,
    // Dove si e' guardato.
    scope: string,
    // Quante domande, quante omissioni, quanti risultati, quanti candidati.
    // CIO' CHE NON E' STATO CHIESTO SI CONTA NELLA RIGA D'ELENCO: se comparisse
    // solo aprendo il dettaglio, chi scorre l'elenco leggerebbe «tre risultati»
    // senza sapere che nove termini non erano stati cercati.
    summary: string,
}

// Un termine che NON e' stato chiesto, con il motivo e la conseguenza.
export struct DiscoveryTermEntry {
    // Il termine come era stato scritto: e' cio' che l'operatore riconosce.
    term: string,
    // Perche' non e' stato chiesto.
    reason: string,
    // Che cosa ne segue per chi legge.
    consequence: string,
}

// Un candidato, con il posto che ha e il perche'.
export struct DiscoveryCandidateEntry {
    // Il nome pubblico, COSI' COME E' ARRIVATO. Arriva da fuori: la schermata lo
    // mostra e non lo interpreta - non diventa un collegamento e non si apre.
    name: string,
    // La superficie da cui viene.
    scope: string,
    // Perche' sta in quella posizione. NON C'E' UN PUNTEGGIO: la posizione non
    // compare mai da sola, e un numero attaccato a un candidato verrebbe letto
    // come un voto (ADR-0078).
    why: string,
    // I motivi, uno per riga: e' l'unico modo per cui si possano contestare uno
    // per uno.
    reasons: string,
    // L'indirizzo pubblico, vuoto quando la chat non ne ha uno. Senza, non c'e'
    // niente da aprire e niente da sorvegliare, e i comandi lo dicono invece di
    // esistere e non funzionare.
    address: string,
}

export struct GraphNodeEntry {

    // Come si chiama il nodo, per chi guarda.
    label: string,
    // Che genere di cosa e': Contenuto, Fonte, Identita' osservata, Soggetto,
    // Gruppo di segnali, Indicatore. Un pallino con un nome sopra non dice che
    // cosa sia, e un fascicolo accanto a un'identita' osservata si legge come
    // la stessa cosa se nessuno scrive quale delle due e'.
    kind: string,
    // PERCHE' E' COLLEGATO AL CENTRO: la risposta alla domanda della
    // milestone. La compone il dominio (`GraphEdge::why`), e la schermata non
    // la ricompone: due composizioni della stessa frase divergono alla prima
    // modifica.
    why: string,
    // Se l'arco che lo collega e' l'atto di una persona invece che
    // un'osservazione dell'archivio. Le due cose non si rendono allo stesso
    // modo, perche' non sono la stessa cosa.
    is-human-act: bool,
    // Dove sta, in frazioni dello spazio disponibile.
    x: float,
    y: float,
}

// Riga del riepilogo: un dizionario scelto, con LA VERSIONE che verra' usata.
//
// Il numero di versione non e' un dettaglio tecnico. Un dizionario cambia: fra
// il monitoraggio di marzo e quello di ottobre lo stesso «Incendi» puo' avere
// trenta termini in piu' e due tolti, e i due monitoraggi non sono stati
// condotti con lo stesso strumento. Chi rilegge un atto mesi dopo ha bisogno
// del numero; il nome da solo dice quale dizionario, non quale contenuto.
export struct WizardChosenDictionary {
    // «Incendi v3»: come si scrive in un atto.
    label: string,
    scope: string,
    terms: int,
    // Quanti termini ABBASSANO il peso di un riscontro. La riga lo mostra
    // perche' e' cio' che distingue un dizionario di contesto riduttivo, e
    // perche' e' la ragione dell'avviso quando manca del tutto.
    reducing-terms: int,
}

// Un avviso del riepilogo: NON e' un motivo di blocco.
//
// La distinzione ha due forme diverse sullo schermo perche' ha due conseguenze
// diverse: un blocco spegne «Avanti», un avviso no. Mescolarli fa uno dei due
// danni — o un avviso ferma un monitoraggio legittimo, o un vero blocco si
// legge come un consiglio e chi ha fretta lo salta.
export struct WizardNoticeEntry {
    text: string,
    // Il gesto che scioglie l'avviso, quando ce n'e' uno. Vuoto quando
    // l'avviso descrive una scelta legittima e non una mancanza.
    remedy: string,
}

// Passo di un percorso guidato, per la barra di avanzamento.
//
// La usano il wizard del nuovo monitoraggio e il percorso della schermata
// Report: sono due percorsi diversi con la stessa barra, e un secondo tipo
// identico avrebbe significato correggere due volte ogni difetto trovato in
// uno dei due.
export struct WizardStepEntry {
    number: int,
    title: string,
    reached: bool,
    current: bool,
}

// Riga dello storico: un contenuto acquisito e analizzato.
//
// Ogni campo arriva gia' calcolato dal servizio, compresi il livello, la
// motivazione e lo stato della revisione. L'interfaccia non ricalcola nulla:
// un valore ricalcolato qui divergerebbe da quello scritto nel registro al
// momento dell'analisi, e i due racconterebbero storie diverse.
export struct ContentEntry {
    content-id: int,
    source: string,
    // Istante di acquisizione, gia' reso leggibile e con il fuso scritto.
    acquired: string,
    // Istante di pubblicazione dichiarato dalla fonte, con la sua parola
    // («pubblicato il …»). Vuoto per cio' che e' stato acquisito dal vivo, dove
    // coincide con l'acquisizione; per un contenuto recuperato e' l'ora che conta,
    // e l'elenco mostrava soltanto quella del recupero, uguale per tutti (E2E01-06).
    published: string,
    level: int,
    // "Livello 3 — forte" oppure "Livello 0 — nessun avviso".
    level-label: string,
    // Frase che spiega il livello. Vuota per i contenuti di livello 0: la
    // motivazione vive nell'alert, che a quel livello non esiste.
    reason: string,
    // Termini riscontrati, gia' uniti: l'elenco e' informativo, non operabile.
    terms: string,
    excerpt: string,
    // Identificativo numerico di chi ha scritto, quando il mittente e' una
    // persona. Vuoto per i messaggi di canale, che non hanno un autore
    // individuale: attribuirli a qualcuno sarebbe una falsa attribuzione.
    author-identifier: string,
    // Username con la chiocciola, quando l'autore ne ha uno. Vuoto altrimenti:
    // la maggior parte degli utenti non ne ha, e l'assenza non e' un difetto.
    author-username: string,
    // IL MODO DI ACQUISIZIONE (PR-07, ADR-0123): «recuperato» oppure «modo non
    // determinabile». Vuoto soltanto per cio' che e' stato acquisito dal vivo:
    // ripetere «dal vivo» su ogni riga renderebbe invisibile l'eccezione, che e'
    // proprio cio' che va visto. Un modo non determinabile NON e' vuoto: il
    // silenzio si leggerebbe come «dal vivo».
    mode-label: string,
    url: string,
    review-state: string,
    awaiting: bool,
    duplicate: bool,
    // CHE COSA E' SUCCESSO AL MESSAGGIO DOPO L'ACQUISIZIONE.
    //
    // «modificato», «eliminato su Telegram», o entrambi. Vuoto quando non e'
    // successo nulla, che e' il caso normale: ripetere «intatto» su ogni riga
    // renderebbe invisibile l'eccezione, che e' proprio cio' che va visto.
    //
    // «eliminato SU TELEGRAM» e non «eliminato»: la seconda forma, accanto a
    // una riga di NEXUM/97, si legge come «il programma lo ha eliminato». Il
    // programma non cancella nulla.
    history-label: string,
    // Vero quando c'e' una storia da aprire. Il pulsante di dettaglio compare
    // solo allora: offrirlo su ogni riga per mostrare «nessuna modifica»
    // sarebbe un comando che non porta da nessuna parte.
    has-history: bool,
    // Vero quando il messaggio e' stato modificato dopo l'acquisizione. Serve
    // all'avvertenza sul livello, che riguarda SOLO questo caso: un messaggio
    // eliminato e mai modificato porta ancora il testo che e' stato analizzato.
    revised: bool,
    // GLI IDENTIFICATIVI ATT&CK CITATI NEL TESTO (ATTACK-03, ADR-0185): una
    // citazione di chi ha scritto, mai un'associazione dell'ufficio, e non
    // cambia il livello. Vuota quando il testo non ne cita.
    cited: string,
}

// Una versione conservata di un messaggio, come il pannello di dettaglio la
// mostra.
export struct ContentVersionEntry {
    // "Versione 1 — acquisita" oppure "Versione 3 — modifica osservata".
    heading: string,
    // Quando la versione e' stata osservata, gia' resa leggibile.
    observed: string,
    // L'istante della modifica dichiarato da Telegram, quando c'e'. Vuoto
    // altrimenti: e' un dato della fonte, e inventarlo sarebbe peggio che non
    // averlo.
    remote-edit: string,
    // Il corpo di QUESTA versione, per intero. Non un estratto: chi apre la
    // cronologia vuole leggere che cosa c'era scritto.
    body: string,
    // Che cosa e' cambiato rispetto alla versione precedente, in una frase
    // esatta. Vuoto per la prima versione, che non proviene da nulla.
    change: string,
    // "+47 caratteri" oppure "-12 caratteri". Vuoto per la prima versione.
    delta: string,
    // Vero per la versione con cui il contenuto e' stato acquisito e
    // analizzato. E' quella a cui si riferiscono livello, riscontri e alert.
    original: bool,
}

// Un termine che ha contribuito al livello, con la sua provenienza.
//
// PERCHE' LA PROVENIENZA STA SULLA RIGA. «Perche' sto vedendo questo?» non
// e' soddisfatta da «per la parola incendio»: chi legge deve poter risalire
// al dizionario che quella parola l'ha messa, e alla versione con cui la
// sessione fu condotta. Il dizionario di oggi puo' essere un altro.
export struct ProvenanceTermEntry {
    // «incendio», categoria violenza, trovato 2 volte
    text: string,
    // "Cyber core v4" oppure "provenienza non registrata".
    origin: string,
    // "dal carattere 12". Serve a ritrovare il punto nel testo.
    position: string,
    // Vero per un termine che ABBASSA il livello. Il segno non sta nella
    // tabella dei riscontri: viene dalla fotografia della sessione, e senza
    // quella non si dichiara.
    mitigating: bool,
    // Falso quando la fotografia della sessione non conosce il termine. La
    // riga resta, e dice di non sapere da dove venisse.
    known: bool,
}

// Una decisione umana nel percorso del risultato.
export struct ProvenanceDecisionEntry {
    // "Il 26/08/2026 10:12 UTC mario.rossi ha deciso «non rilevante»".
    heading: string,
    // L'annotazione lasciata, quando c'e'. Vuota altrimenti.
    note: string,
}

// Riga dell'elenco delle persone che hanno scritto.
//
// Non porta un identificativo di contenuto: rappresenta una **persona**, non un
// messaggio. Il campo `identifier` e' l'identificativo Telegram, che e' l'unico
// dei tre che regge nel tempo; nome e username sono quelli dell'ultima
// comparsa, e possono cambiare.
// Un'osservazione di foto, biografia e stato di un autore (PERSON-MEDIA-01,
// ADR-0174): chi l'ha chiesta, quando e perché, e ciò che Telegram mostrava in
// quell'istante. La foto si decodifica soltanto per mostrarla.
export struct ProfileMediaEntry {
    id: int,
    // Se è scelta per i documenti, e se si può scegliere (un'osservazione
    // riuscita): PERSON-MEDIA-01 parte 3.
    chosen: bool,
    markable: bool,
    when: string,
    motive: string,
    outcome: string,
    status: string,
    bio: string,
    has-photo: bool,
    photo: image,
    photo-note: string,
}

// Una richiesta di conservare l'allegato di un contenuto (ATTACH-01, ADR-0177):
// chi, quando, perché, l'esito e, se conservato, l'impronta. Mai i byte.
export struct AttachmentKeepingEntry {
    when: string,
    motive: string,
    outcome: string,
    fingerprint: string,
}

export struct ParticipantEntry {
    identifier: string,
    display-name: string,
    username: string,
    messages: string,
    sources: string,
    first-seen: string,
    last-seen: string,
    // LA STORIA DEGLI ALIAS (PERS-02).
    //
    // Vuota quando non c'e' niente da raccontare: chi ha portato lo stesso nome
    // per tutto il monitoraggio non ha una storia, e mostrare «si e' sempre
    // chiamato cosi'» sotto ogni riga sarebbe rumore — e il rumore fa smettere
    // di leggere anche cio' che conta.
    //
    // Le righe dicono «osservato», mai «cambiato»: l'archivio sa quando ha VISTO
    // un nome nuovo, non quando quella persona lo ha adottato.
    alias-history: [string],
    // La frase che avverte di che cosa gli istanti NON dicono. Vuota quando la
    // storia e' vuota.
    alias-caveat: string,
    // LE ASSOCIAZIONI, CON LA LORO PROVENIENZA (PERS-03).
    //
    // Vuote quando non c'e' niente che l'elenco non dicesse gia': ogni persona
    // che ha scritto ha almeno un contenuto e una fonte, e ripeterlo qui
    // sarebbe l'elenco dei partecipanti con altre parole. La sezione compare
    // per un alert, un indicatore o un workspace.
    //
    // Ogni riga porta il fatto che la stabilisce: quale contenuto, quale
    // fonte, quale istante. Un collegamento senza provenienza non esiste, e
    // non e' nemmeno costruibile.
    associations: [string],
    // La frase che dice che cosa questi collegamenti NON significano. Vuota
    // quando le associazioni sono vuote.
    associations-caveat: string,
    // LA CRONOLOGIA (PERS-04). Vuota quando c'e' una riga sola: chi ha
    // scritto una volta non ha una cronologia, ha un fatto.
    timeline: [string],
    // QUANDO SI STAVA GUARDANDO. Non e' un contorno: e' l'unica cosa che rende
    // leggibile un vuoto. Un periodo senza righe, senza queste finestre
    // accanto, si legge come «non ha fatto niente» — che e' un fatto che
    // nessuno ha misurato.
    timeline-windows: [string],
    // La frase che dice che un vuoto NON e' un silenzio della persona. Vuota
    // quando la cronologia e' vuota.
    timeline-caveat: string,
}

// Riga del risultato di una ricerca retroattiva.
//
// Non porta un identificativo di contenuto perche' **non e' un contenuto**: e'
// un messaggio che esiste su Telegram e che l'archivio non contiene. Darle un
// identificativo la farebbe somigliare a una riga dello Storico, che e'
// esattamente l'equivoco da evitare.
export struct RetroMatchEntry {
    source: string,
    published: string,
    level-label: string,
    terms: string,
    excerpt: string,
    url: string,
}

// Sessione fra cui scegliere nella schermata Report.
//
// Porta gia' calcolato tutto cio' che serve a riconoscerla senza aprirla:
// un'etichetta da sola non dice se quel monitoraggio abbia osservato tre
// contenuti o tremila, e chi consegna una relazione deve saperlo prima.
// Un monitoraggio da spuntare per il rapporto complessivo (REPORT-MULTI-01,
// ADR-0192).
export struct OverviewRow {
    session-id: int,
    label: string,
    chosen: bool,
}

export struct ReportSessionEntry {
    session-id: int,
    label: string,
    started: string,
    // "in corso" quando la sessione non e' conclusa: un termine inventato
    // sarebbe un fatto inventato.
    ended: string,
    state: string,
    operator: string,
    sources: string,
    contents: int,
    alerts: int,
    chosen: bool,
}

// Riga dei contenuti fra cui l'operatore sceglie che cosa rappresentare.
//
// `chosen` e' la **scelta umana**, e non ha nulla a che vedere con il livello:
// un livello 4 non equivale a «da inserire nella relazione» (ADR-0031
// Decisione 1). L'interfaccia non lo deduce e non lo suggerisce.
export struct ReportContentRow {
    content-id: int,
    chosen: bool,
    level: int,
    level-label: string,
    source: string,
    published: string,
    excerpt: string,
    review-state: string,
    // Se il contenuto ha prodotto un avviso. E' un dato, non un invito.
    alert: bool,
    // "collegamento disponibile" oppure "senza collegamento": scritto e non
    // dedotto da un'icona assente, perche' l'assenza non si legge.
    link: string,
}

// Formato del pacchetto, con la verita' sulla propria disponibilita'.
//
// I formati non ancora costruiti compaiono **dichiarati come tali**: toglierli
// dall'elenco farebbe credere che non siano previsti, mostrarli spuntabili
// farebbe credere che si producano.
export struct ReportFormatRow {
    label: string,
    available: bool,
    note: string,
}

// Documento realmente prodotto, come il manifest lo dichiara.
export struct ReportArtifactRow {
    name: string,
    kind: string,
    size: string,
    sha256: string,
}

// Voce del riepilogo: un'etichetta e il suo valore.
//
// Il riepilogo dell'anteprima e quello dell'esito lo compone Rust: che cosa la
// relazione conterra' e' una lettura dei dati, non una composizione di stringhe
// dentro un file di interfaccia.
export struct ReportSummaryRow {
    label: string,
    value: string,
}

// Riga dell'elenco delle fonti gia' configurate.
export struct ConfiguredSourceEntry {
    source-id: int,
    title: string,
    kind: string,
    identifier: string,
    authorized-by: string,
    // Con quali account d'ufficio la fonte è stata seguita (MULTI-ACCOUNT-02,
    // ADR-0173): «Seguita con Ufficio A e Ufficio B.», vuota se nessun
    // monitoraggio con un account l'ha inclusa.
    accounts: string,
    active: bool,
    // SALUTE DELLA FONTE (HEALTH-01).
    //
    // "Operativa", "Degradata", "In errore", "Sconosciuta", "Ferma".
    health: string,
    // Vero solo per Degradata e In errore. NON per Sconosciuta: una fonte mai
    // verificata non e' un guasto, e dipingerla di rosso insegnerebbe a
    // ignorare il rosso.
    health-attention: bool,
    // Vero per una fonte mai verificata in modo conclusivo. Si distingue da
    // «operativa» perche' l'assenza di evidenza non e' evidenza di salute.
    health-unknown: bool,
    // Vero per una fonte ferma per scelta dell'operatore.
    health-stopped: bool,
    // "Verificata il ..." oppure "Mai verificata". E' l'informazione che il
    // mandato chiede di NON confondere con l'ultimo messaggio.
    last-check: string,
    // Ultimo contenuto acquisito, detto SEPARATAMENTE dallo stato: una fonte
    // puo' tacere per settimane ed essere raggiungibile.
    last-content: string,
    // CHE COSA STAVAMO GUARDANDO negli ultimi sette giorni (PR-05): i tratti
    // della barra, e a parole quelli non coperti o non determinabili.
    coverage: [TrattoCopertura],
    coverage-summary: string,
    // I periodi RECUPERATI DOPO (PR-08): uno strato a parte, non uno stato
    // della copertura. Nessuno guardava: si e' letto dopo.
    recovered: [TrattoRecuperato],
}

// La copertura di una fonte dentro il monitoraggio scelto (PR-05, ADR-0121).
export struct CoperturaFonte {
    // Il nome della fonte, come l'operatore la conosce.
    name: string,
    tratti: [TrattoCopertura],
    // I tratti non coperti o non determinabili, a parole.
    summary: string,
    // I periodi recuperati dopo (PR-08): uno strato a parte.
    recuperati: [TrattoRecuperato],
}

// UNA VERIFICA REGISTRATA, nel pannello di dettaglio di una fonte (HEALTH-02).
//
// # Perche' ogni riga porta DUE frasi
//
// Perche' «come e' andato il tentativo» e «che cosa se ne e' appreso della
// fonte» non sono la stessa cosa, e in un elenco di venti righe uguali quattro
// «la verifica non e' riuscita» si leggerebbero come quattro guasti della
// fonte. La prima frase e' `headline`, la seconda `meaning`: la seconda dice
// per esteso che un tentativo non riuscito non ha appreso nulla.
export struct HealthCheckEntry {
    // Istante e esito: "6 giugno 2026 14:03 — la fonte risultava fra le chat
    // accessibili all'account...".
    headline: string,
    // Che cosa la riga dice DELLA FONTE. Per un tentativo non riuscito dice
    // che non si e' appreso nulla.
    meaning: string,
    // Falso per un tentativo non riuscito. Governa il colore, che resta
    // NEUTRO: un tentativo non riuscito non e' un guasto da segnalare.
    conclusive: bool,
    // Classe dell'errore o precisazione dell'esito. Mai un testo remoto.
    detail: string,
    // Chi ha osservato, detto sulla riga: se due account osservassero la
    // stessa fonte, la storia mostrerebbe entrambi.
    observer: string,
}

// La fascia di messaggio all'operatore vive ora in `components.slint` come
// `Banner`, con `InfoBanner` ed `ErrorBanner` a nominarne il tono. Qui stava
// `MessageBand`, che faceva la stessa cosa: due componenti che rendono lo
// stesso messaggio divergono alla prima correzione fatta su una sola.
//
// Il vincolo che l'aveva formata resta, ed e' scritto in `Banner`: l'altezza
// viene dal testo e non da un numero fisso. Con un'altezza fissa e un testo
// dentro un rettangolo senza layout, un messaggio lungo **esce dal riquadro** e
// si stampa sopra il resto della schermata: e' successo con la spiegazione del
// perche' una decisione fosse stata rifiutata, che e' precisamente il messaggio
// piu' lungo e piu' importante del prodotto.

// Schermata dello storico, usata sia per lo storico completo sia per gli
// avvisi. Una sola componente per due schermate perche' i due elenchi sono lo
// stesso archivio con una soglia diversa: duplicarla vorrebbe dire correggere
// due volte ogni difetto trovato in una.
// Il modulo del profilo documentale, uno solo per due punti di impiego: la
// schermata di benvenuto del primo avvio e le Impostazioni.
//
// Non ha proprieta' proprie: legge e scrive il `global DocumentProfile`, che e'
// la ragione per cui quel global esiste.
// Anteprima di come il profilo intesta la relazione.
//
// # A che cosa serve
//
// Chi compila dieci campi non sa dove finiscano. «Denominazione» e «Ufficio»
// sono due righe centrate in cima; «Luogo» e «Qualifica» stanno in fondo a
// destra, sopra la firma; «Riferimenti nel pie' di pagina» e' l'ultima riga del
// foglio. Detto a parole non si ricorda; visto, si', ed e' cio' che l'operatore
// ha chiesto il 2026-08-20.
//
// # Che cosa NON e'
//
// **Non e' il documento.** E' uno schema, e lo dichiara: le proporzioni della
// pagina sono quelle vere - A4, margini reali - ma la dimensione del testo no.
// A scala esatta un corpo di undici punti sarebbe alto due pixel, e servirebbe
// a niente. Chiamarla «anteprima» senza dirlo farebbe credere che il documento
// esca cosi'.
//
// # Perche' lo stemma e' un riquadro e non lo stemma
//
// I byte dell'immagine vivono in Rust, dove sono stati letti e validati:
// l'immagine non attraversa il confine grafico, ed e' una regola del progetto e
// non una scorciatoia. Il riquadro sta **dove** e **quanto** lo stemma stara'
// davvero - tre centimetri su ventinove e sette - e dice se e' stato scelto.
//
// # I colori sono quelli della carta, non della tavolozza
//
// Un foglio bianco dentro un'interfaccia scura e' voluto: e' cio' che lo fa
// leggere come un documento invece che come un altro pannello. Sono gli unici
// valori chiari del prodotto, e stanno qui e in nessun altro posto.
component ProfilePreview inherits VerticalLayout {
    spacing: Spacing.sm;

    // Il foglio, in millimetri veri: 210 x 297.
    private property <length> sheet-width: 300px;
    private property <length> sheet-height: 424px;
    // Margini laterali reali: 1,701 cm su 21 = 8,1%.
    private property <length> margin-side: 24px;

    private property <color> paper: #FDFDFB;
    private property <color> ink: #1A1F28;
    private property <color> ink-soft: #55606F;
    private property <color> ink-absent: #A8AEB8;
    private property <color> rule: #D6DAE2;

    Text {
        text: @tr("ANTEPRIMA DELL'INTESTAZIONE");
        color: Palette.text-muted;
        font-size: Typography.group-label;
        font-weight: Typography.medium;
        letter-spacing: 0.6px;
    }

    Text {
        text: @tr("Schema, non il documento: le proporzioni della pagina sono quelle vere, la dimensione del testo no. Serve a vedere dove finisce ogni dato. Dove un dato manca, il documento lascia lo spazio invece di inventarlo.");
        color: Palette.text-muted;
        font-size: Typography.group-label;
        wrap: word-wrap;
    }

    HorizontalLayout {
        alignment: start;
        vertical-stretch: 0;

        Rectangle {
            width: root.sheet-width;
            height: root.sheet-height;
            horizontal-stretch: 0;
            vertical-stretch: 0;
            background: root.paper;
            border-width: 1px;
            border-color: root.rule;
            border-radius: 2px;
            clip: true;

            VerticalLayout {
                padding-left: root.margin-side;
                padding-right: root.margin-side;
                padding-top: 18px;
                padding-bottom: 14px;
                spacing: 0;

                // ------------------------------------------------ stemma
                HorizontalLayout {
                    alignment: center;
                    vertical-stretch: 0;

                    Rectangle {
                        // Tre centimetri su ventinove e sette: il 10,1% del foglio.
                        width: 43px;
                        height: 43px;
                        border-width: 1px;
                        border-color: DocumentProfile.emblem-name == "" ? root.ink-absent : root.rule;
                        background: DocumentProfile.emblem-name == "" ? #F4F5F7 : #EDF3FB;
                        border-radius: 2px;

                        Text {
                            text: DocumentProfile.emblem-name == "" ? @tr("stemma") : @tr("stemma\nscelto");
                            color: DocumentProfile.emblem-name == "" ? root.ink-absent : root.ink-soft;
                            font-size: 8px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                Rectangle { height: 10px; background: transparent; }

                // ------------------------------------------ le tre righe
                Text {
                    text: DocumentProfile.organisation == "" ? @tr("denominazione dell'amministrazione") : DocumentProfile.organisation;
                    color: DocumentProfile.organisation == "" ? root.ink-absent : root.ink;
                    font-size: 11px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                Text {
                    text: DocumentProfile.office == "" ? @tr("ufficio di appartenenza") : DocumentProfile.office;
                    color: DocumentProfile.office == "" ? root.ink-absent : root.ink;
                    font-size: 10px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                Text {
                    text: DocumentProfile.premises == "" ? @tr("sede, indirizzo e recapiti") : DocumentProfile.premises;
                    color: DocumentProfile.premises == "" ? root.ink-absent : root.ink-soft;
                    font-size: 9px;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }

                Rectangle { height: 10px; background: transparent; }
                Rectangle { height: 1px; background: root.rule; }
                Rectangle { height: 12px; background: transparent; }

                // ------------------------------------ destinatario e oggetto
                Text {
                    text: DocumentProfile.recipient == "" ? @tr("destinatario abituale") : @tr("Al {}", DocumentProfile.recipient);
                    color: DocumentProfile.recipient == "" ? root.ink-absent : root.ink;
                    font-size: 9px;
                    wrap: word-wrap;
                }
                if DocumentProfile.recipient-cc != "": Text {
                    text: @tr("e, per conoscenza, {}", DocumentProfile.recipient-cc);
                    color: root.ink-soft;
                    font-size: 9px;
                    wrap: word-wrap;
                }

                Rectangle { height: 8px; background: transparent; }

                Text {
                    text: DocumentProfile.subject-base == "" ? @tr("oggetto abituale, più il monitoraggio") : @tr("Oggetto: {}", DocumentProfile.subject-base);
                    color: DocumentProfile.subject-base == "" ? root.ink-absent : root.ink;
                    font-size: 9px;
                    font-weight: 700;
                    wrap: word-wrap;
                }

                Rectangle { height: 10px; background: transparent; }

                // ----------------------------------------------- il corpo
                //
                // Righe grigie e non testo finto: un testo di esempio si
                // leggerebbe, e chi lo legge crede che il documento lo
                // conterra'. Queste dicono «qui c'e' la relazione» e nulla
                // di piu'.
                for larghezza in [1.0, 0.96, 0.99, 0.72, 1.0, 0.94, 0.61]: Rectangle {
                    height: 7px;
                    background: transparent;

                    Rectangle {
                        x: 0;
                        y: 2px;
                        width: parent.width * larghezza;
                        height: 3px;
                        background: #E6E9EF;
                        border-radius: 1px;
                    }
                }

                // Lo spazio che resta spinge la firma in fondo, dov'e' nel
                // documento vero.
                Rectangle { vertical-stretch: 1; background: transparent; }

                // ------------------------------------------------- firma
                Text {
                    text: @tr("{}, data", (DocumentProfile.place == "" ? @tr("luogo") : DocumentProfile.place));
                    color: DocumentProfile.place == "" ? root.ink-absent : root.ink-soft;
                    font-size: 9px;
                    horizontal-alignment: right;
                }

                Rectangle { height: 8px; background: transparent; }

                Text {
                    text: DocumentProfile.signer-role == "" ? @tr("qualifica") : DocumentProfile.signer-role;
                    color: DocumentProfile.signer-role == "" ? root.ink-absent : root.ink-soft;
                    font-size: 9px;
                    horizontal-alignment: right;
                }
                Text {
                    text: DocumentProfile.signer-name == "" ? @tr("nome e cognome") : DocumentProfile.signer-name;
                    color: DocumentProfile.signer-name == "" ? root.ink-absent : root.ink;
                    font-size: 10px;
                    font-weight: 700;
                    horizontal-alignment: right;
                }

                Rectangle { height: 12px; background: transparent; }
                Rectangle { height: 1px; background: root.rule; }
                Rectangle { height: 5px; background: transparent; }

                // -------------------------------------------- pie' di pagina
                Text {
                    text: DocumentProfile.footer-line == "" ? @tr("riferimenti dell'ufficio nel piè di pagina") : DocumentProfile.footer-line;
                    color: DocumentProfile.footer-line == "" ? root.ink-absent : root.ink-soft;
                    font-size: 8px;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }
        }
    }

    // Chi non vede il foglio non deve restare senza: la stessa informazione,
    // detta in una frase. Non e' una descrizione del disegno - «un rettangolo
    // bianco» non serve a nessuno - ma dell'ORDINE in cui i dati compaiono.
    Rectangle {
        height: 0px;
        accessible-role: text;
        accessible-label: @tr("Anteprima dell'intestazione");
        accessible-description: @tr("Dall'alto: stemma, denominazione, ufficio, sede. Poi destinatario e oggetto. In fondo a destra luogo e data, qualifica e nome di chi firma. Ultima riga, centrata, i riferimenti dell'ufficio.");
    }
}

component ProfileFields inherits VerticalLayout {
    spacing: Spacing.md;

    HorizontalLayout {
        spacing: Spacing.md;
        vertical-stretch: 0;
        TextField {
            horizontal-stretch: 1;
            label: @tr("Denominazione dell'amministrazione");
            placeholder: @tr("Compare nella prima riga dell'intestazione");
            value <=> DocumentProfile.organisation;
            edited => { }
        }
        TextField {
            horizontal-stretch: 1;
            label: @tr("Ufficio di appartenenza");
            placeholder: @tr("Seconda riga dell'intestazione");
            value <=> DocumentProfile.office;
            edited => { }
        }
    }

    TextField {
        label: @tr("Sede, indirizzo e recapiti");
        placeholder: @tr("Terza riga dell'intestazione");
        value <=> DocumentProfile.premises;
        edited => { }
    }

    HorizontalLayout {
        spacing: Spacing.md;
        vertical-stretch: 0;
        TextField {
            horizontal-stretch: 1;
            label: @tr("Qualifica");
            placeholder: @tr("Compare in calce e nella premessa");
            value <=> DocumentProfile.signer-role;
            edited => { }
        }
        TextField {
            horizontal-stretch: 1;
            label: @tr("Nome e cognome");
            placeholder: @tr("Chi sottoscrive la relazione");
            value <=> DocumentProfile.signer-name;
            edited => { }
        }
    }

    HorizontalLayout {
        spacing: Spacing.md;
        vertical-stretch: 0;
        TextField {
            horizontal-stretch: 1;
            label: @tr("Destinatario abituale");
            placeholder: @tr("Modificabile a ogni relazione");
            value <=> DocumentProfile.recipient;
            edited => { }
        }
        TextField {
            horizontal-stretch: 1;
            label: @tr("E, per conoscenza");
            placeholder: @tr("Facoltativo");
            value <=> DocumentProfile.recipient-cc;
            edited => { }
        }
    }

    HorizontalLayout {
        spacing: Spacing.md;
        vertical-stretch: 0;
        TextField {
            horizontal-stretch: 1;
            label: @tr("Luogo");
            placeholder: @tr("Compare accanto alla data, in calce");
            value <=> DocumentProfile.place;
            edited => { }
        }
        TextField {
            horizontal-stretch: 1;
            label: @tr("Oggetto abituale");
            placeholder: @tr("Il documento vi aggiunge il monitoraggio");
            value <=> DocumentProfile.subject-base;
            edited => { }
        }
    }

    TextField {
        label: @tr("Riferimenti dell'ufficio nel piè di pagina");
        placeholder: @tr("Facoltativo");
        value <=> DocumentProfile.footer-line;
        edited => { }
    }

    // Lo stemma: un file **locale**, mai scaricato dalla rete.
    VerticalLayout {
        spacing: Spacing.xs;
        vertical-stretch: 0;

        Text {
            text: @tr("Stemma dell'amministrazione");
            color: Palette.text-muted;
            font-size: Typography.group-label;
            font-weight: Typography.medium;
            vertical-stretch: 0;
        }
        Text {
            text: DocumentProfile.emblem-name != "" ? DocumentProfile.emblem-name : @tr("Nessuno: l'intestazione lascerà lo spazio vuoto.");
            color: DocumentProfile.emblem-name != ""
                ? Palette.text
                : Palette.text-muted;
            font-size: Typography.body-secondary;
            vertical-stretch: 0;
            wrap: word-wrap;
        }

        HorizontalLayout {
            spacing: Spacing.md;
            vertical-stretch: 0;
            alignment: start;

            HudButton {
                label: @tr("Scegli lo stemma\u{2026}");
                clicked => {
                    DocumentProfile.choose-emblem();
                }
            }
            HudButton {
                label: @tr("Togli lo stemma");
                enabled: DocumentProfile.emblem-name != "";
                reason: DocumentProfile.emblem-name == "" ? @tr("Nessuno stemma è stato scelto.") : "";
                clicked => {
                    DocumentProfile.clear-emblem();
                }
            }
        }
    }
}

// IL PANNELLO DELLE NOTE (NOTE-01).
//
// UN COMPONENTE SOLO, USATO DA PIU' SCHERMATE.
//
// Le note si scrivono DOVE IL MATERIALE E': davanti a un contenuto nello
// Storico, e dentro un workspace. Sono due posti, e scrivere due volte lo
// stesso pannello vorrebbe dire che il giorno in cui la regola cambia — il
// ritiro, il vuoto rifiutato, la nota ritirata che resta visibile — cambia in
// uno solo, e nessuno se ne accorge.
//
// Percio' e' uno.
component NotesPanel inherits VerticalLayout {
    in property <[NoteRow]> rows: [];
    in-out property <string> draft: "";
    in property <string> message: "";
    // Che cosa si sta annotando, per l'etichetta del campo: «questo contenuto»,
    // «questo workspace». Chi scrive deve vedere su che cosa sta scrivendo.
    in property <string> subject: @tr("questo");
    callback write(string);
    callback withdraw(int);

    spacing: Spacing.sm;
    alignment: start;

    Text {
        text: @tr("NOTE");
        color: Palette.text-muted;
        font-size: Typography.group-label;
        letter-spacing: Typography.track-eyebrow;
    }

    // CHE COSA UNA NOTA E', detto una volta sola e nel posto dove si scrive.
    //
    // La distinzione dalla revisione non e' ovvia, e chi non la conosce
    // scrivera' qui la motivazione di una decisione — che va altrove, dove
    // resta legata alla decisione.
    Text {
        text: @tr("Una nota è ciò che si annota, quando si vuole. Non è la motivazione di una decisione: quella si scrive insieme alla decisione, e resta legata a essa. Una nota porta chi l'ha scritta e quando, e per questo non si può riscrivere: si ritira, e se ne scrive un'altra.");
        color: Palette.text-muted;
        font-size: Typography.technical;
        wrap: word-wrap;
    }

    if root.message != "": Text {
        text: root.message;
        color: Palette.amber;
        font-size: Typography.body-secondary;
        wrap: word-wrap;
    }

    HudInput {
        placeholder: @tr("Che cosa si annota");
        label: @tr("Nota su {}", root.subject);
        value <=> root.draft;
    }

    HorizontalLayout {
        spacing: Spacing.sm;
        vertical-stretch: 0;

        HudButton {
            label: @tr("Scrivi la nota");
            clicked => {
                root.write(root.draft);
            }
        }
        Rectangle { horizontal-stretch: 1; background: transparent; }
    }

    if root.rows.length == 0: Text {
        text: @tr("Nessuna nota.");
        color: Palette.text-muted;
        font-size: Typography.body-secondary;
        wrap: word-wrap;
    }

    // OGNI NOTA COMPARE, COMPRESA QUELLA RITIRATA.
    //
    // Farla sparire riscriverebbe che cosa aveva davanti chi ci ha lavorato
    // sopra prima che venisse ritirata.
    LegendaOrigini {
        osservato: @tr("a che cosa si riferisce");
        operatore: @tr("la nota, chi l'ha scritta e quando");
    }
    for nota in root.rows: Rectangle {
        vertical-stretch: 0;
        background: transparent;

        // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
        min-height: rip-1.preferred-height;
        rip-1 := VerticalLayout {
            padding-left: Spacing.md;
            padding-top: Spacing.xs;
            padding-bottom: Spacing.xs;
            spacing: 2px;

            Text {
                text: nota.body;
                // Attenuata quando e' ritirata: non vale piu', e si vede.
                // La frase lo dice comunque, perche' un colore non e'
                // leggibile da tutti e non si stampa.
                color: nota.stands ? Palette.text : Palette.text-muted;
                font-size: Typography.body-secondary;
                wrap: word-wrap;
            }
            Text {
                text: nota.sentence;
                color: nota.stands ? Palette.text-muted : Palette.amber;
                font-family: Typography.mono;
                font-size: Typography.technical;
                wrap: word-wrap;
            }
            // SU CHE COSA, quando il pannello non sta gia' accanto alla cosa.
            if nota.target != "": Text {
                text: nota.target;
                color: nota.present ? Palette.text-muted : Palette.amber;
                font-family: Typography.mono;
                font-size: Typography.technical;
                wrap: word-wrap;
            }

            // IL COMANDO CHE RITIRA NON COMPARE SU UNA GIA' RITIRATA.
            //
            // L'archivio lo rifiuterebbe, e un comando che fallisce sempre
            // insegna che il programma non funziona.
            if nota.stands: Rectangle {
                // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                min-height: rip-2.preferred-height;
                rip-2 := HorizontalLayout {
                    spacing: Spacing.sm;
                    vertical-stretch: 0;

                    HudButton {
                        label: @tr("Ritira questa nota");
                        clicked => {
                            root.withdraw(nota.id);
                        }
                    }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                }
            }
        }
    }
}
// UN SOGGETTO A CUI UNA PERSONA HA COLLEGATO L'AUTORE (GAP-12, ADR-0153).
export struct AuthorSubjectRow {
    id: int,
    label: string,
}

// --------------------------------------------------------- AuthorSubjects
//
// DALL'AUTORE AL SOGGETTO (GAP-12, ADR-0153, decisione 9).
//
// Per ogni soggetto a cui UNA PERSONA ha collegato l'identificativo
// dell'autore, «Apri la scheda»; e «Collega a un soggetto», che porta alla
// schermata Persone con l'identificativo gia' scritto. NON collega nulla da
// solo e non apre soggetti: il soggetto e il motivo li sceglie l'operatore.
// Lo stesso componente nel pannello del messaggio e nella conversazione: due
// copie divergerebbero il giorno in cui una regola cambia.
component AuthorSubjects inherits VerticalLayout {
    in property <string> identifier;
    in property <[AuthorSubjectRow]> subjects;
    callback open-subject(int);
    callback link-subject(string);

    spacing: Spacing.xs;
    vertical-stretch: 0;

    Text {
        text: root.identifier == "" ? @tr("Nessuna persona da collegare: nei canali il messaggio è pubblicato dalla fonte.") : @tr("Autore: identificativo {}.", root.identifier);
        color: Palette.text-muted;
        font-size: Typography.technical;
        wrap: word-wrap;
    }
    LegendaOrigini {
        operatore: @tr("soggetti collegati");
    }
    for soggetto in root.subjects: HudButton {
        label: @tr("Apri la scheda di «{}»", soggetto.label);
        clicked => {
            root.open-subject(soggetto.id);
        }
    }
    if root.identifier != "": HudButton {
        label: @tr("Collega a un soggetto");
        clicked => {
            root.link-subject(root.identifier);
        }
    }
}

// ------------------------------------------------------- ConversationRow
//
// UN MESSAGGIO DELLA CONVERSAZIONE, come Telegram lo mostra adesso (ADR-0151).
//
// E' lo stesso disegno per i precedenti e per i successivi: due copie
// divergerebbero il giorno in cui una regola cambia. L'ordine dentro la riga e'
// quello di CTX-04 — che cosa e' scritto, poi chi, poi a che cosa si lega —
// perche' chi legge una conversazione sta ricostruendo un discorso, non
// schedando delle persone.
component ConversationRow inherits Rectangle {
    in property <ContextRow> riga;

    vertical-stretch: 0;
    background: Palette.panel;
    border-radius: Spacing.radius-row;
    border-width: Spacing.hairline;
    border-color: Palette.line-divider;

    // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
    min-height: rip-180.preferred-height;
    rip-180 := VerticalLayout {
        padding-left: Spacing.md;
        padding-right: Spacing.md;
        padding-top: Spacing.sm;
        padding-bottom: Spacing.sm;
        spacing: 3px;

        Text {
            text: @tr("{}  ·  n. {}", root.riga.when, root.riga.number);
            color: Palette.text-muted;
            font-family: Typography.mono;
            font-size: Typography.technical;
        }
        Text {
            text: root.riga.text;
            color: Palette.text;
            font-size: Typography.body-secondary;
            wrap: word-wrap;
        }
        // CHI LO HA SCRITTO (CTX-04): sempre, anche quando non c'e' una
        // persona, perche' «non c'e'» va detto e non lasciato a uno spazio.
        Text {
            text: root.riga.who;
            color: Palette.text-muted;
            font-size: Typography.technical;
            wrap: word-wrap;
        }
        // A CHE COSA SI LEGA, dentro la riga che descrive.
        if root.riga.relations != "": Text {
            text: root.riga.relations;
            color: Palette.cyan;
            font-size: Typography.technical;
            wrap: word-wrap;
        }
    }

    accessible-role: text;
    accessible-label: root.riga.when + ", " + root.riga.who + ": " + root.riga.text;
}

// ------------------------------------------------------- ConversationPage
//
// LA CONVERSAZIONE, APERTA DAL MESSAGGIO (ADR-0151, DG-01).
//
// # Una pagina sopra la schermata da cui si parte
//
// Copre la colonna del contenuto e lascia il menu: chiuderla riporta
// esattamente dove si era, con lo stesso filtro, la stessa riga e lo stesso
// scorrimento. Una schermata del menu cambierebbe pagina, e tornare vorrebbe
// dire ricostruire a mano cio' che si guardava.
//
// # E' di SOLA LETTURA, e non per convenzione
//
// Il connettore verso Telegram non ha alcun metodo che scriva: non esiste un
// invio, una reazione, un inoltro, un'adesione. Non c'e' un comando da
// togliere da questa pagina, perche' non c'e' nulla che possa chiamarlo
// (`lisi-telegram::prohibitions`). L'unico atto e' la fotografia di CTX-06, in
// fondo, con la ragione obbligatoria.
//
// # Il messaggio sta al centro, in un riquadro suo
//
// In ordine di tempo: i precedenti, il messaggio dell'avviso, i successivi.
// Il messaggio dell'avviso non e' una riga come le altre: e' la prova
// dell'archivio, in un riquadro con bordo e titolo, e cio' che Telegram ne
// mostra adesso sta sotto, su una riga distinta. All'apertura la pagina lo
// porta al centro.
component ConversationPage inherits Rectangle {
    // Da dove si e' arrivati, per tornarci: «Avvisi», «Storico».
    in property <string> origin;
    // LA FONTE E IL MESSAGGIO, DALL'ARCHIVIO.
    in property <string> source-name;
    in property <string> source-line;
    in property <string> author;
    in property <string> published;
    in property <string> acquired;
    in property <string> observed;
    in property <int> content-id;
    in property <string> message-number;
    // Che cosa si sta guardando, composto dal servizio (DEC-252): dice per
    // esteso che il contorno NON e' una prova.
    in property <string> context-summary;
    // Il testo ACQUISITO, che non cambia.
    in property <string> context-anchor;
    // Il testo come Telegram lo mostra adesso; vuoto se non e' tornato.
    in property <string> anchor-now;
    in property <string> anchor-now-when;
    // IL CONFRONTO FRA LA PROVA E LO STATO CORRENTE (CTX-05). Vuoto quando
    // NON e' stato fatto, che non e' "i testi coincidono".
    in property <string> context-comparison-label;
    in property <bool> context-texts-differ;
    // I MESSAGGI ATTORNO, dal piu' vecchio.
    in property <[ContextRow]> older-rows;
    in property <[ContextRow]> newer-rows;
    // Lo stato di ciascun lato, in una frase del servizio.
    in property <string> older-state;
    in property <string> newer-state;
    in property <bool> can-load-older;
    in property <bool> can-load-newer;
    // IL COLLEGAMENTO UFFICIALE (DG-02, F-110, F-111).
    in property <string> archived-url;
    in property <string> link-request-sentence;
    in property <string> link-request-url;
    // LA PAGINA PUBBLICA DELLA FONTE, quando il collegamento al messaggio non
    // c'e' (ADR-0165, decisione 4).
    in property <string> source-page-url;
    in property <string> source-page-sentence;
    // DALL'AUTORE AL SOGGETTO (GAP-12).
    in property <string> author-identifier;
    in property <[AuthorSubjectRow]> author-subjects;
    callback open-subject(int);
    callback link-subject(string);
    // LA FOTOGRAFIA DEL CONTESTO (CTX-06).
    in-out property <string> snapshot-reason;
    in property <[SnapshotRow]> snapshot-rows;
    in property <string> snapshot-message;
    // Il Rust la incrementa quando la conversazione e' disposta: allora il
    // messaggio dell'avviso si porta al centro.
    in property <int> centre-request: 0;
    changed centre-request => {
        root.centre();
    }

    callback back();
    callback load-older();
    callback load-newer();
    callback request-link(int);
    callback open-url(string);
    callback take-snapshot(string);

    // Porta il messaggio dell'avviso al centro dell'area che scorre.
    function centre() {
        filo.scroll-y = max(
            min(0px, filo.view-height - filo.content-height),
            min(0px, -(ancora.y + ancora.height / 2 - filo.view-height / 2)));
    }

    // Scorre di una misura, senza uscire dai limiti.
    function scroll-by(delta: length) {
        filo.scroll-y = max(
            min(0px, filo.view-height - filo.content-height),
            min(0px, filo.scroll-y - delta));
    }

    // Prende la tastiera appena si apre: chi arriva con un gesto deve poter
    // scorrere subito, senza cercare dove sia il fuoco.
    init => {
        pagina.focus();
    }

    background: Palette.void;

    pagina := FocusScope {
        // Il fuoco lo danno i comandi: un clic sul testo non deve spendersi
        // per prenderlo (il difetto gia' visto con `FocusScope` e `TouchArea`).
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.back();
                return accept;
            }
            if (event.text == Key.UpArrow) {
                root.scroll-by(-48px);
                return accept;
            }
            if (event.text == Key.DownArrow) {
                root.scroll-by(48px);
                return accept;
            }
            if (event.text == Key.PageUp) {
                root.scroll-by(-(filo.view-height - 48px));
                return accept;
            }
            if (event.text == Key.PageDown) {
                root.scroll-by(filo.view-height - 48px);
                return accept;
            }
            if (event.text == Key.Home) {
                filo.scroll-y = 0px;
                return accept;
            }
            if (event.text == Key.End) {
                filo.scroll-y = min(0px, filo.view-height - filo.content-height);
                return accept;
            }
            return reject;
        }

        VerticalLayout {
            padding-top: Shell.content-pad-top;
            padding-left: Shell.content-pad-side;
            padding-right: Shell.content-pad-side;
            padding-bottom: Shell.content-pad-bottom;
            spacing: Spacing.md;

            // ------------------------------------------------ testata
            HorizontalLayout {
                spacing: Spacing.sm;
                vertical-stretch: 0;

                HudButton {
                    label: @tr("Torna a «{}»", root.origin);
                    clicked => {
                        root.back();
                    }
                }
                Rectangle { horizontal-stretch: 1; background: transparent; }
                HudButton {
                    label: @tr("Torna al messaggio");
                    clicked => {
                        root.centre();
                    }
                }
            }

            VerticalLayout {
                spacing: Spacing.xs;
                vertical-stretch: 0;

                Text {
                    text: @tr("CONVERSAZIONE  ·  SOLA LETTURA");
                    color: Palette.cyan;
                    font-family: Typography.mono;
                    font-size: Typography.eyebrow;
                    letter-spacing: Typography.track-eyebrow;
                }
                Text {
                    text: root.source-name;
                    color: Palette.text;
                    font-size: Typography.screen-title;
                    font-weight: Typography.medium;
                    overflow: elide;
                }
                Text {
                    text: root.source-line;
                    color: Palette.text-muted;
                    font-family: Typography.mono;
                    font-size: Typography.technical;
                    wrap: word-wrap;
                }
            }

            // FONTE, AUTORE, DATE: dall'archivio (F-113).
            Rectangle {
                vertical-stretch: 0;
                background: Palette.panel;
                border-radius: Spacing.radius-panel;
                border-width: Spacing.hairline;
                border-color: Palette.line-divider;

                VerticalLayout {
                    padding: Spacing.md;
                    spacing: Spacing.sm;

                    HorizontalLayout {
                        spacing: Spacing.lg;

                        VerticalLayout {
                            spacing: 2px;
                            horizontal-stretch: 1;
                            Text {
                                text: @tr("AUTORE, DALL'ARCHIVIO");
                                color: Palette.text-muted;
                                font-size: Typography.label;
                                letter-spacing: Typography.track-label;
                            }
                            Text {
                                text: root.author;
                                color: Palette.text;
                                font-size: Typography.body-secondary;
                                wrap: word-wrap;
                            }
                        }
                        VerticalLayout {
                            spacing: 2px;
                            horizontal-stretch: 1;
                            Text {
                                text: @tr("PUBBLICATO");
                                color: Palette.text-muted;
                                font-size: Typography.label;
                                letter-spacing: Typography.track-label;
                            }
                            Text {
                                text: root.published;
                                color: Palette.text;
                                font-family: Typography.mono;
                                font-size: Typography.technical;
                                wrap: word-wrap;
                            }
                        }
                        VerticalLayout {
                            spacing: 2px;
                            horizontal-stretch: 1;
                            Text {
                                text: @tr("ACQUISITO");
                                color: Palette.text-muted;
                                font-size: Typography.label;
                                letter-spacing: Typography.track-label;
                            }
                            Text {
                                text: root.acquired;
                                color: Palette.text;
                                font-family: Typography.mono;
                                font-size: Typography.technical;
                                wrap: word-wrap;
                            }
                        }
                        VerticalLayout {
                            spacing: 2px;
                            horizontal-stretch: 1;
                            Text {
                                text: @tr("LETTO SU TELEGRAM");
                                color: Palette.text-muted;
                                font-size: Typography.label;
                                letter-spacing: Typography.track-label;
                            }
                            Text {
                                text: root.observed;
                                color: Palette.text;
                                font-family: Typography.mono;
                                font-size: Typography.technical;
                                wrap: word-wrap;
                            }
                        }
                    }

                    Text {
                        text: @tr("Contenuto n. {} dell'archivio  ·  messaggio n. {} presso Telegram", root.content-id, root.message-number);
                        color: Palette.text-muted;
                        font-family: Typography.mono;
                        font-size: Typography.technical;
                        wrap: word-wrap;
                    }

                    // IL COLLEGAMENTO UFFICIALE, CHIESTO AL MOMENTO (DG-02).
                    // Nessun indirizzo si compone: se Telegram non lo da', la
                    // frase dice perche'.
                    HorizontalLayout {
                        spacing: Spacing.sm;

                        HudButton {
                            label: @tr("Chiedi il collegamento a Telegram");
                            clicked => {
                                root.request-link(root.content-id);
                            }
                        }
                        if root.link-request-url != "": HudButton {
                            label: @tr("Apri collegamento");
                            clicked => {
                                root.open-url(root.link-request-url);
                            }
                        }
                        if root.archived-url != "": HudButton {
                            label: @tr("Apri il collegamento dell'acquisizione");
                            clicked => {
                                root.open-url(root.archived-url);
                            }
                        }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                    }
                    if root.link-request-sentence != "": Text {
                        text: root.link-request-sentence;
                        color: root.link-request-url != "" ? Palette.text : Palette.amber;
                        font-size: Typography.body-secondary;
                        wrap: word-wrap;
                    }
                    // COPIARE IL COLLEGAMENTO FORNITO (ADR-0165, decisione 2).
                    if root.link-request-url != "": Rectangle {
                        // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                        min-height: rip-195.preferred-height;
                        rip-195 := HorizontalLayout {
                            spacing: Spacing.sm;
                            VerticalLayout {
                                spacing: Spacing.xs;
                                Text {
                                    text: @tr("Collegamento fornito da Telegram");
                                    color: Palette.text-muted;
                                    font-size: Typography.body-secondary;
                                }
                                collegamento := HudInput {
                                    label: @tr("Collegamento fornito da Telegram");
                                    value: root.link-request-url;
                                    read-only: true;
                                }
                            }
                            VerticalLayout {
                                alignment: end;
                                HudButton {
                                    label: @tr("Copia collegamento");
                                    clicked => {
                                        collegamento.copy-all();
                                    }
                                }
                            }
                        }
                    }
                    // APRI LA FONTE, quando il collegamento al messaggio non c'e'
                    // e la fonte ha un indirizzo pubblico visto (ADR-0165).
                    if root.link-request-url == "" && root.source-page-url != "": HudButton {
                        label: @tr("Apri la fonte");
                        clicked => {
                            root.open-url(root.source-page-url);
                        }
                    }
                    if root.link-request-url == "" && root.source-page-url != "": Text {
                        text: root.source-page-sentence;
                        color: Palette.text-muted;
                        font-size: Typography.technical;
                        wrap: word-wrap;
                    }
                    if root.archived-url != "": Text {
                        // Prima di LINK-01 l'indirizzo lo componeva il programma:
                        // dirlo «fornito da Telegram» attribuiva a Telegram una
                        // deduzione (DEC-416).
                        text: @tr("Collegamento conservato all'acquisizione, composto dal programma e non fornito da Telegram: {}", root.archived-url);
                        color: Palette.text-muted;
                        font-size: Typography.technical;
                        wrap: word-wrap;
                    }

                    AuthorSubjects {
                        identifier: root.author-identifier;
                        subjects: root.author-subjects;
                        open-subject(id) => {
                            root.open-subject(id);
                        }
                        link-subject(identificativo) => {
                            root.link-subject(identificativo);
                        }
                    }
                }
            }

            // ------------------------------------------- la conversazione
            filo := HudScroll {
                vertical-stretch: 1;

                VerticalLayout {
                    spacing: Spacing.sm;
                    padding-right: Spacing.sm;

                    // CHE COSA SI STA GUARDANDO, composto dal servizio e non
                    // ricomposto qui (DEC-252).
                    Text {
                        text: root.context-summary;
                        color: Palette.text-muted;
                        font-size: Typography.body-secondary;
                        wrap: word-wrap;
                    }

                    LegendaOrigini {
                        osservato: @tr("messaggi attorno, autore e ora");
                        calcolato: @tr("relazioni");
                    }

                    // I PRECEDENTI, A PAGINE (F-112).
                    Text {
                        text: root.older-state;
                        color: Palette.text-muted;
                        font-size: Typography.technical;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        spacing: Spacing.sm;
                        HudButton {
                            label: @tr("Carica i precedenti");
                            enabled: root.can-load-older;
                            clicked => {
                                root.load-older();
                            }
                        }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                    }
                    for riga in root.older-rows: ConversationRow {
                        riga: riga;
                    }

                    // IL MESSAGGIO DELL'AVVISO: la prova, in un riquadro suo,
                    // al suo posto nella conversazione.
                    ancora := Rectangle {
                        vertical-stretch: 0;
                        background: Palette.accent-surface;
                        border-radius: Spacing.radius-row;
                        border-width: 2px;
                        border-color: Palette.cyan;

                        VerticalLayout {
                            padding: Spacing.md;
                            spacing: Spacing.xs;

                            Text {
                                text: @tr("IL MESSAGGIO DELL'AVVISO — DALL'ARCHIVIO");
                                color: Palette.cyan;
                                font-family: Typography.mono;
                                font-size: Typography.label;
                                letter-spacing: Typography.track-label;
                            }
                            Text {
                                text: @tr("Pubblicato {}  ·  acquisito {}", root.published, root.acquired);
                                color: Palette.text-muted;
                                font-family: Typography.mono;
                                font-size: Typography.technical;
                                wrap: word-wrap;
                            }
                            Text {
                                text: root.context-anchor;
                                color: Palette.text;
                                font-size: Typography.body;
                                wrap: word-wrap;
                            }
                            Text {
                                text: root.author;
                                color: Palette.text-muted;
                                font-size: Typography.technical;
                                wrap: word-wrap;
                            }

                            // IL CONFRONTO, DENTRO IL RIQUADRO DELLA PROVA
                            // (CTX-05): e' un'affermazione sulla prova.
                            if root.context-comparison-label != "": Text {
                                text: root.context-comparison-label;
                                color: root.context-texts-differ
                                    ? Palette.amber
                                    : Palette.cyan;
                                font-family: Typography.mono;
                                font-size: Typography.label;
                                wrap: word-wrap;
                            }

                            // COME SI LEGGE ADESSO: su una riga distinta, mai
                            // al posto del testo acquisito.
                            if root.anchor-now != "": Rectangle {
                                background: Palette.panel-inset;
                                border-radius: Spacing.radius-chip;

                                // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                min-height: rip-181.preferred-height;
                                rip-181 := VerticalLayout {
                                    padding: Spacing.sm;
                                    spacing: 2px;

                                    Text {
                                        text: @tr("COME SI LEGGE ADESSO SU TELEGRAM — {}", root.anchor-now-when);
                                        color: Palette.amber;
                                        font-family: Typography.mono;
                                        font-size: Typography.label;
                                        wrap: word-wrap;
                                    }
                                    Text {
                                        text: root.anchor-now;
                                        color: Palette.text-muted;
                                        font-size: Typography.body-secondary;
                                        wrap: word-wrap;
                                    }
                                }
                            }
                        }
                    }

                    // I SUCCESSIVI, A PAGINE, con la loro legenda: sono
                    // osservati adesso come i precedenti, e lo si dice anche
                    // qui, dove l'occhio arriva dopo il messaggio.
                    LegendaOrigini {
                        osservato: @tr("messaggi dopo questo, autore e ora");
                        calcolato: @tr("relazioni");
                    }
                    for riga in root.newer-rows: ConversationRow {
                        riga: riga;
                    }
                    Text {
                        text: root.newer-state;
                        color: Palette.text-muted;
                        font-size: Typography.technical;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        spacing: Spacing.sm;
                        HudButton {
                            label: @tr("Carica i successivi");
                            enabled: root.can-load-newer;
                            clicked => {
                                root.load-newer();
                            }
                        }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                    }

                    // CONSERVARE CIO' CHE SI STA GUARDANDO (CTX-06).
                    //
                    // E' un ATTO ESPLICITO, e sta in fondo: dopo aver
                    // guardato, non prima. Conserva tutti i messaggi caricati,
                    // perche' sono cio' che la persona ha visto.
                    Rectangle {
                        vertical-stretch: 0;
                        background: Palette.line-divider;
                        height: 1px;
                    }

                    Text {
                        text: @tr("CONSERVARE QUESTO CONTESTO");
                        color: Palette.text-muted;
                        font-size: Typography.group-label;
                        letter-spacing: Typography.track-eyebrow;
                    }

                    AvvertenzaDiSicurezza {
                        codice: "SIC-01";
                        testo: @tr("Una fotografia conserva ciò che Telegram mostra adesso. Registra chi la prende, quando e perché. Non diventa una prova acquisita: la prova resta il testo dell'archivio.");
                        dettaglio: @tr("La fotografia del contesto salva i messaggi attorno a un contenuto, con operatore, istante e ragione. Non sostituisce il contenuto acquisito, che resta la fonte del dato.");
                    }

                    Text {
                        text: @tr("La fotografia conserva tutti i messaggi caricati qui, precedenti e successivi, e nessun altro.");
                        color: Palette.text-muted;
                        font-size: Typography.body-secondary;
                        wrap: word-wrap;
                    }

                    HudInput {
                        placeholder: @tr("Ragione, obbligatoria: perché si conserva");
                        label: @tr("Ragione della fotografia");
                        value <=> root.snapshot-reason;
                    }

                    HorizontalLayout {
                        spacing: Spacing.sm;

                        HudButton {
                            label: @tr("Conserva questo contesto");
                            clicked => {
                                root.take-snapshot(root.snapshot-reason);
                            }
                        }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                    }

                    if root.snapshot-message != "": Text {
                        text: root.snapshot-message;
                        color: Palette.amber;
                        font-size: Typography.body-secondary;
                        wrap: word-wrap;
                    }

                    // LE FOTOGRAFIE GIA' PRESE: una non sostituisce l'altra.
                    LegendaOrigini {
                        calcolato: @tr("integrità");
                        operatore: @tr("chi ha preso la fotografia, quando e perché");
                    }
                    for fotografia in root.snapshot-rows: Rectangle {
                        vertical-stretch: 0;
                        background: transparent;

                        // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                        min-height: rip-182.preferred-height;
                        rip-182 := VerticalLayout {
                            padding-top: Spacing.xs;
                            padding-bottom: Spacing.xs;

                            Text {
                                text: fotografia.sentence;
                                // In ambra quando l'impronta non corrisponde:
                                // non e' un'accusa, e' un fatto da vedere.
                                color: fotografia.intact
                                    ? Palette.text-muted
                                    : Palette.amber;
                                font-size: Typography.technical;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }
        }
    }
}


component ContentScreen inherits Rectangle {
    in property <string> title;
    in property <string> description;
    in property <[ContentEntry]> entries;
    in property <string> message;
    in property <string> empty-title;
    in property <string> empty-detail;

    // Conteggi dell'insieme completo, non di quello filtrato: un totale che
    // cambia con la ricerca non e' piu' un totale.
    in property <int> total;
    in property <int> pending;
    in property <string> focus-caption;
    in property <int> focus-value;

    in property <int> selected;
    in property <string> selected-summary;
    in property <string> selected-state;
    // Vero quando il contenuto scelto ha una storia da aprire: modifiche,
    // cancellazione, o entrambe.
    in property <bool> selected-has-history: false;
    // Vero quando il contenuto scelto e' stato MODIFICATO. Distinto dal
    // precedente perche' l'avvertenza sul livello riguarda solo le modifiche.
    in property <bool> selected-revised: false;
    in property <string> selected-url;

    // LA CRONOLOGIA DEL MESSAGGIO SCELTO.
    //
    // Si apre su richiesta, per un contenuto solo: i corpi delle versioni non
    // entrano nell'elenco, dove sarebbero centinaia di testi caricati per
    // mostrarne uno.
    in property <[ContentVersionEntry]> versions: [];
    in property <string> story: "";
    in property <string> story-subject: "";
    in property <bool> story-open: false;
    in property <bool> story-deleted: false;
    callback open-story(int);
    callback close-story();

    // PERCHE' STO VEDENDO QUESTO.
    //
    // Il percorso che ha portato la riga davanti all'operatore, nelle tre
    // nature che questo prodotto tiene separate e in quest'ordine: fatto
    // osservato, elaborazione automatica, decisione umana.
    //
    // Si apre su richiesta, come la cronologia, e per un contenuto solo.
    in property <bool> why-open: false;
    in property <string> why-subject: "";
    // Fatto osservato: da dove viene il contenuto.
    in property <string> why-origin: "";
    // Avvertenza sulla versione, vuota quando non c'e' nulla da avvertire.
    in property <string> why-version-warning: "";
    // Elaborazione automatica: i termini trovati, con la loro provenienza.
    in property <[ProvenanceTermEntry]> why-terms: [];
    // Elaborazione automatica: come si e' arrivati al livello, oppure che cosa
    // manca per poterlo dire.
    // CHI ha prodotto il livello: il motore, con la propria versione
    // (ENGINE-01). Per i contenuti analizzati prima che il motore avesse un
    // numero dice che NON RISULTA, e non «v1»: quei livelli furono prodotti da
    // una formula di cui nessuno sa quale fosse.
    in property <string> why-engine: "";
    // IL REPLAY (REPLAY-01), su richiesta.
    //
    // Due frasi, e due verbi: «ha prodotto» e' un FATTO, «avrebbe» e'
    // un'IPOTESI. Su due righe con lo stesso verbo si leggerebbero come due
    // misure della stessa cosa, e la seconda finirebbe per essere presa per
    // buona quanto la prima.
    //
    // Si apre SU RICHIESTA e non da sola: un livello ipotetico mostrato senza
    // che nessuno lo abbia chiesto verrebbe letto come un secondo livello del
    // contenuto, e il contenuto ne ha uno solo.
    in property <bool> replay-open: false;
    in property <string> replay-historical: "";
    in property <string> replay-hypothetical: "";
    in property <string> replay-attribution: "";
    // Vero quando l'ipotesi NON coincide con il livello registrato.
    in property <bool> replay-differs: false;
    callback open-replay(int);
    callback close-replay();

    // ------------------------- Contenuti che gli somigliano (SIM-01)
    //
    // Quasi-duplicati nella stessa sessione, con il PERCHE': le sequenze di
    // tre parole che i due contenuti hanno in comune.
    //
    // # Perche' l'evidenza sta nella riga
    //
    // Perche' il piano chiede che il risultato dica perche', e una percentuale
    // non e' un perche': e' il risultato di un conto che chi legge non ha
    // visto. Le sequenze condivise SI POSSONO LEGGERE, e chi legge giudica.
    //
    // # Somigliarsi non e' essere un duplicato
    //
    // «Duplicato» e' uno stato della revisione, cioe' LA DECISIONE DI UNA
    // PERSONA, presa con motivo, istante e audit. Questa sezione dice che due
    // contenuti si somigliano e quanto; che siano la stessa cosa lo stabilisce
    // qualcuno, e la frase lo dice.
    //
    // Si apre SU RICHIESTA: il confronto legge tutti i contenuti della
    // sessione, e costa.
    in property <bool> resembling-open: false;
    in property <string> resembling-summary: "";
    in property <[ResemblanceRow]> resembling-rows: [];
    callback open-resembling(int);
    callback close-resembling();
    // «Perché vedo questo?» (PR-02, ADR-0119).
    //
    // La schermata dei contenuti non risponde da se': INOLTRA alla finestra,
    // che possiede il pannello unico. Rispondere qui creerebbe una seconda
    // voce, e la prima che qualcuno modifica direbbe una cosa diversa
    // dall'altra — proprio sulla domanda che esiste per rendere confrontabili
    // cose diverse.
    //
    // `explain` vale per cio' che si spiega dal contenuto (la riga, il
    // livello, l'avviso, il riscontro); `explain-subject` per cio' che ha una
    // chiave propria (la somiglianza, che e' una coppia).
    callback explain(Spiegabile, int, string);
    callback explain-subject(Spiegabile, string, string);
    // Che cosa e' una riga di questo elenco: un contenuto nello Storico, un
    // avviso negli Avvisi.
    in property <Spiegabile> row-kind: Spiegabile.contenuto;

    // ------------------------------- Aprire la conversazione (ADR-0151)
    //
    // Un gesto apre la pagina della conversazione su questo contenuto: da ogni
    // riga e dal pannello del messaggio scelto. La pagina sta sopra la
    // schermata e, chiusa, la lascia com'era. Il riquadro del contesto che
    // stava qui (CTX-03) e' diventato quella pagina.
    callback open-conversation(int);
    // DALL'AUTORE AL SOGGETTO (GAP-12, ADR-0153): per il messaggio scelto.
    in property <string> author-identifier: "";
    in property <[AuthorSubjectRow]> author-subjects: [];
    callback open-subject(int);
    callback link-subject(string);
    // L'ALLEGATO DEL CONTENUTO (ATTACH-01, ADR-0177): la frase dice ciò che il
    // mittente dichiara e, se è conservato, l'impronta. La scheda chiede di
    // conservarlo, con la ragione. Nessuna anteprima, nessun «Apri».
    in property <string> attachment-sentence: "";
    in property <bool> attachment-open: false;
    in property <string> attachment-caveat: "";
    in-out property <string> attachment-reason: "";
    in property <string> attachment-message: "";
    in property <[AttachmentKeepingEntry]> attachment-entries: [];
    callback open-attachment(int);
    callback attachment-ask();
    callback attachment-close();
    // IL COLLEGAMENTO UFFICIALE, CHIESTO AL MOMENTO (CA02-14, DG-02): la frase
    // dice quando e' stato chiesto e se e' pubblico; l'indirizzo, se c'e', si
    // apre con l'apertura sicura (ADR-0018). Non si conserva.
    in property <string> link-request-sentence: "";
    in property <string> link-request-url: "";
    callback request-link(int);
    // RACCOGLIERE NEL WORKSPACE, dove il materiale e' (WS-02). In quale
    // workspace lo decide la schermata Workspace, e la frase lo dice per nome.
    callback collect-in-workspace(int);
    // SEGNARE, UN GESTO SOLO (BOOK-01).
    //
    // A differenza del workspace, segnare NON chiede prima di scegliere dove:
    // un segnalibro che costa una scelta non lo mette nessuno, e un segnalibro
    // che nessuno mette non serve a nulla. La raccolta, quando serve, si sceglie
    // dopo, nella schermata Segnalibri.
    //
    // Vero quando questo contenuto e' GIA' segnato: il comando lo dice, invece
    // di offrire un gesto che l'archivio rifiuterebbe.
    in property <bool> marked: false;
    callback toggle-bookmark(int);
    // LE NOTE SU QUESTO CONTENUTO (NOTE-01).
    //
    // Si scrivono qui perche' qui c'e' il materiale: chiedere a una persona di
    // aprire un'altra schermata e trascrivere un identificativo sarebbe
    // chiederle il lavoro che il programma deve fare.
    //
    // NON toccano la prova: il contenuto qui sopra e' esattamente quello
    // acquisito, e nulla nel percorso che scrive una nota sa raggiungerlo.
    in property <[NoteRow]> notes: [];
    in-out property <string> note-draft: "";
    in property <string> note-message: "";
    callback write-note(string);
    callback withdraw-note(int);

    in property <string> why-scoring: "";
    // Falso quando la spiegazione NON e' verificata: allora la frase dichiara
    // una lacuna o una discordanza, e non va letta come la causa del livello.
    in property <bool> why-scoring-trustworthy: false;
    // Elaborazione automatica: l'avviso, quando c'e' stato.
    in property <string> why-alert: "";
    // Decisione umana: le revisioni, dalla piu' antica alla piu' recente.
    in property <[ProvenanceDecisionEntry]> why-decisions: [];
    callback open-why(int);
    // Apre il Grafo delle prove su questo contenuto (F-02, F-21): l'identificativo
    // e il monitoraggio li conosce gia' il programma, e nessuno deve ricopiarli.
    callback open-graph(int);
    callback close-why();

    // Scelta della sessione. L'indice 0 e' Â«tutteÂ»: uno storico che mostra
    // tutte le sessioni insieme risponde alla domanda Â«che cosa e' stato
    // osservatoÂ», una sessione sola alla domanda Â«che cosa ha osservato questo
    // monitoraggioÂ». Servono entrambe.
    in property <[string]> sessions;
    in property <bool> can-export: false;
    in-out property <int> session-index: 0;

    in-out property <string> filter;
    // SALVARE LA RICERCA CHE SI STA GUARDANDO (SEARCH-01).
    in-out property <string> save-search-name: "";
    callback save-search(string);
    // L'esito del salvataggio, mostrato qui dove si salva (F-09): prima
    // compariva solo nella schermata Ricerche.
    in property <string> save-search-message: "";
    // Che cosa e' cambiato da quando la ricerca fu salvata; vuoto quando non se
    // ne sta rifacendo una.
    in property <string> search-drift: "";
    // Falso quando le due esecuzioni NON sono confrontabili: allora la frase va
    // letta, e il colore la accompagna senza sostituirla.
    in property <bool> search-comparable: true;
    in-out property <bool> only-pending;
    in-out property <string> note;
    // Spenta per difetto, e deliberatamente: un rapporto che elenca persone e'
    // un documento diverso da uno che elenca contenuti, e chi lo firma deve
    // sceglierlo invece di trovarcelo.
    in-out property <bool> include-author-identifiers: false;

    // Dove finiscono i documenti. E' una preferenza **permanente** della
    // postazione, non una scelta di questo rapporto, e vale anche per la
    // verifica che li rilegge: si mostra qui perche' chi esporta deve sapere
    // dove sta scrivendo senza cambiare schermata.
    in property <string> export-destination: "";

    callback filter-changed();
    callback session-chosen(int);
    callback export-session();
    callback choose-export-destination();
    callback verify-exports();
    callback select(int);
    callback decide(string);
    callback open-url(string);

    // SALVARE ED ESPORTARE SI APRONO SU RICHIESTA (OPERATOR-UX-REMEDIATION-01,
    // OS-01). Erano tre righe fisse sopra l'elenco: a 1920×1032 lasciavano
    // all'elenco una o due righe, e a finestra ridotta nessuna. Sono gesti di
    // fine lavoro, non di lettura: restano a un clic, chiuse per difetto.
    in-out property <bool> tools-open: false;

    // CON UN MESSAGGIO APERTO, IL MESSAGGIO HA LA PRECEDENZA (OPERATOR-UX-
    // REMEDIATION-01, OS-01). La verifica a vista a 1136×759 ha mostrato il
    // pannello della decisione sotto il bordo della finestra, irraggiungibile:
    // l'elenco teneva la sua riga e il pannello aveva un'altezza fissa. Con un
    // messaggio aperto la descrizione della schermata si toglie, l'elenco può
    // cedere la sua riga (il pannello ripete fonte, ora e testo) e il pannello
    // scende fino a 120 px scorrendo. A finestra piena non cambia nulla: è
    // l'elenco che si allarga. «Chiudi» restituisce tutto.
    //
    // Non si legge l'altezza della schermata né della finestra: entrambe
    // dipendono dal layout, e il compilatore segnala il ciclo.
    property <bool> compatta: root.selected >= 0;

    // LA RIGA APERTA RESTA IN VISTA (UX-EXCELLENCE-02, SIM3-19).
    //
    // Con un messaggio aperto l'elenco cede spazio e mostra una riga sola; era
    // la prima dell'elenco, non quella aperta, e chi arrivava dalla Coda di
    // lavoro non vedeva che cosa aveva aperto. La posizione della riga la
    // conosce il Rust, che compone l'elenco; qui la si porta in vista.
    in property <int> selected-row: -1;
    changed selected-row => {
        root.reveal-selected-row();
    }
    // Anche su richiesta esplicita: arrivando dalla Coda di lavoro la schermata
    // Avvisi nasce quando la riga e' gia' scelta, e ne' `changed` ne' `init`
    // trovano l'elenco gia' disposto. Il Rust chiede di nuovo, un istante dopo,
    // incrementando questo contatore. Trovato guardando la cattura.
    in property <int> reveal-request: 0;
    changed reveal-request => {
        root.reveal-selected-row();
    }
    function reveal-selected-row() {
        if (root.selected-row < 0) {
            return;
        }
        // Con il messaggio aperto la legenda non c'e': 128 px di riga e 8 di
        // spaziatura per ogni riga che precede.
        elenco.scroll-y = max(
            min(0px, elenco.view-height - elenco.content-height),
            -(root.selected-row * 136px));
    }

    background: Palette.panel;
    border-radius: Spacing.radius-panel;

    VerticalLayout {
        padding: Spacing.xl;
        spacing: Spacing.md;

        HorizontalLayout {
            spacing: Spacing.md;
            vertical-stretch: 0;

            VerticalLayout {
                spacing: Spacing.xs;
                Text {
                    text: root.title;
                    color: Palette.text;
                    font-size: Typography.screen-title;
                    font-weight: Typography.medium;
                }
                if !root.compatta: Text {
                    text: root.description;
                    color: Palette.text-muted;
                    font-size: Typography.body-secondary;
                    wrap: word-wrap;
                }
            }

            // Unico elemento focale della schermata: quanto attende una
            // decisione umana. E' la sola cifra su cui si agisce, ed e' il solo
            // `Counter` di questa schermata con `focal` acceso.
            Counter {
                // Largo abbastanza per le due righe che dicono che cosa conta
                // (SIM3-08): a 150 pixel la didascalia andava su quattro righe
                // e usciva dal riquadro.
                min-width: 220px;
                caption: root.focus-caption;
                value: root.focus-value;
                focal: true;
            }
        }

        HorizontalLayout {
            spacing: Spacing.md;
            vertical-stretch: 0;

            HudInput {
                placeholder: @tr("Cerca nel testo, nella fonte o nei termini");
                // Il testo segnaposto sparisce appena si scrive: da solo non
                // e' un'etichetta, e chi non vede il campo resterebbe senza.
                // Lo stesso campo serve Avvisi e Storico: il nome dice dove si cerca (F-30).
                label: root.row-kind == Spiegabile.avviso ? @tr("Cerca negli avvisi") : @tr("Cerca nello storico");
                value <=> root.filter;
                edited => {
                    root.filter-changed();
                }
            }

            HudButton {
                label: root.only-pending ? @tr("Solo da esaminare \u{2713}") : @tr("Solo da esaminare");
                clicked => {
                    root.only-pending = !root.only-pending;
                    root.filter-changed();
                }
            }
        }

        // LA RICERCA CONDIVISA SI DICHIARA (INSTALLED-APP-E2E-01, E2E01-17).
        // Avvisi e Storico leggono lo stesso elenco con lo stesso filtro: la
        // ricerca scritta in una ricompariva nell'altra senza dirlo, e il
        // contatore non diceva quanti risultati.
        if root.filter != "" || root.only-pending: Rectangle {
            min-height: rip-191.preferred-height;
            rip-191 := HorizontalLayout {
                Text {
                    text: (root.entries.length == 1 ? @tr("1 contenuto corrisponde.") : @tr("{} contenuti corrispondono.", root.entries.length)) + (root.row-kind == Spiegabile.avviso ? @tr(" La stessa ricerca vale anche nello Storico.") : @tr(" La stessa ricerca vale anche negli Avvisi."));
                    color: Palette.text-muted;
                    font-size: Typography.body-secondary;
                    wrap: word-wrap;
                }
            }
        }

        // La sessione da mostrare e' un filtro della lettura: resta in vista.
        // Accanto, il comando che apre salvataggio ed esportazione.
        HorizontalLayout {
            spacing: Spacing.md;
            vertical-stretch: 0;

            HudSelect {
                model: root.sessions;
                label: @tr("Monitoraggio da mostrare");
                current-index <=> root.session-index;
                selected => {
                    root.session-chosen(self.current-index);
                }
            }

            HudButton {
                label: root.tools-open ? @tr("Chiudi salva ed esporta") : @tr("Salva la ricerca, esporta\u{2026}");
                clicked => {
                    root.tools-open = !root.tools-open;
                }
            }
        }

        // SI SALVA DOVE SI CERCA (SEARCH-01).
        //
        // Chiedere di ricostruire la domanda in un'altra schermata sarebbe
        // chiedere a una persona il lavoro che il programma deve fare — e
        // produrrebbe ricerche salvate diverse da quella che si stava
        // guardando, senza che nulla lo dica.
        if root.tools-open: Rectangle {
            // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
            min-height: rip-3.preferred-height;
            rip-3 := HorizontalLayout {
                spacing: Spacing.md;
                vertical-stretch: 0;

                HudInput {
                    placeholder: @tr("Nome con cui ritrovare questa ricerca");
                    label: @tr("Salva questa ricerca con il nome");
                    value <=> root.save-search-name;
                    // Invio salva, come il pulsante accanto (E2E01-09): un solo
                    // gesto possibile, e non distruttivo.
                    accepted => {
                        root.save-search(root.save-search-name);
                    }
                }

                HudButton {
                    label: @tr("Salva la ricerca");
                    clicked => {
                        root.save-search(root.save-search-name);
                    }
                }
            }
        }

        if root.tools-open && root.save-search-message != "": Text {
            text: root.save-search-message;
            color: Palette.text;
            font-size: Typography.body-secondary;
            wrap: word-wrap;
        }

        // CHE COSA E' CAMBIATO DA QUANDO LA RICERCA FU SALVATA.
        //
        // Compare solo dopo aver rifatto una ricerca salvata, e dice i NUMERI:
        // quante righe sono state valutate da un motore diverso, quante non
        // registrano affatto quale motore le abbia valutate. Un avviso generico
        // non si potrebbe usare, e chi lo vedesse sempre smetterebbe di
        // leggerlo (ADR-0051).
        if root.search-drift != "": Text {
            text: root.search-drift;
            color: root.search-comparable ? Palette.text-muted : Palette.amber;
            font-size: Typography.body-secondary;
            wrap: word-wrap;
        }

        if root.tools-open: Rectangle {
            // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
            min-height: rip-4.preferred-height;
            rip-4 := HorizontalLayout {
                spacing: Spacing.md;
                vertical-stretch: 0;

                // Il rapporto documenta **una** sessione: mescolarle non
                // risponderebbe a nessuna domanda in particolare. Il comando resta
                // visibile e disabilitato, e la schermata dice perche'.
                HudButton {
                    label: @tr("Esporta rapporto");
                    enabled: root.can-export;
                    clicked => {
                        root.export-session();
                    }
                }

                // La scelta sta **accanto** al comando che la usa, non in
                // Impostazioni: e' una decisione presa su questo rapporto, non una
                // preferenza permanente, e chi la prende deve vederla mentre esporta.
                HudCheck {
                    text: @tr("Includi identificativi degli autori");
                    checked <=> root.include-author-identifiers;
                    enabled: root.can-export;
                    description: @tr("Il rapporto riporterà l'identificativo Telegram di chi ha scritto ogni messaggio. Il documento dichiara la scelta in entrambi i casi.");
                }

                // La verifica non riguarda una sessione ma i documenti gia'
                // prodotti: ricalcola l'impronta di ogni rapporto esportato e la
                // confronta con il suo manifest. Sempre disponibile.
                HudButton {
                    label: @tr("Verifica esportati");
                    clicked => {
                        root.verify-exports();
                    }
                }
            }
        }

        // Il percorso si mostra e non si digita: una cartella scelta da una
        // finestra di sistema esiste per costruzione (DEC-113). Sta su una riga
        // propria perche' un percorso lungo mandato a capo dentro la riga dei
        // comandi la scomporrebbe.
        if root.tools-open: Rectangle {
            // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
            min-height: rip-5.preferred-height;
            rip-5 := HorizontalLayout {
                spacing: Spacing.md;
                vertical-stretch: 0;

                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: Spacing.xs;

                    Text {
                        text: @tr("I documenti vanno in");
                        color: Palette.text-muted;
                        font-size: Typography.group-label;
                        font-weight: Typography.medium;
                    }
                    Text {
                        text: root.export-destination;
                        color: Palette.text;
                        font-family: Typography.mono;
                        font-size: Typography.technical;
                        wrap: word-wrap;
                    }
                }

                HudButton {
                    label: @tr("Cambia cartella\u{2026}");
                    clicked => {
                        root.choose-export-destination();
                    }
                }
            }
        }

        if root.message != "": InfoBanner {
            message: root.message;
        }

        if root.entries.length == 0: StateBlock {
            // `empty` e non `planned`: qui i contenuti possono arrivare, e la
            // schermata dice che cosa fare perche' arrivino. Dichiarare
            // `planned` direbbe che la capacita' non esiste, che e' falso.
            kind: StateKind.empty;
            title: root.empty-title;
            message: root.empty-detail;
        }

        // L'ELENCO HA ALMENO UNA RIGA INTERA IN VISTA (OS-01), salvo cederla al
        // messaggio aperto (vedi `compatta`): i
        // pannelli che si aprono sotto cedono spazio scorrendo, l'elenco no.
        elenco := HudScroll {
            min-height: root.compatta ? 0px : 150px;
            vertical-stretch: 2;

            VerticalLayout {
                spacing: Spacing.sm;

                // Con un messaggio aperto la legenda si toglie (SIM3-19): il pannello
                // sotto la ripete, e l'elenco ha bisogno di ogni riga per mostrare
                // quella aperta.
                if !root.compatta: LegendaOrigini {
                    osservato: @tr("fonte, testo, autore, collegamento");
                    calcolato: @tr("livello, motivazione, termini, ora di acquisizione");
                    operatore: @tr("revisione");
                }
                for entry in root.entries: Rectangle {
                    height: 128px;
                    background: entry.content-id == root.selected
                        ? Palette.accent-surface
                        : Palette.panel-raised;
                    border-radius: Spacing.radius-row;
                    border-width: Spacing.hairline;
                    border-color: entry.content-id == root.selected
                        ? Palette.frame
                        : Palette.line-divider;

                    HorizontalLayout {
                        padding: Spacing.md;
                        // Il posto a destra per «Perché vedo questo?», che sta sopra la riga.
                        padding-right: Spacing.md + perche-riga.width + conversa-riga.width + 2 * Spacing.sm;
                        spacing: Spacing.md;

                        // Il livello si distingue anche senza leggere: la
                        // barra e' alta quanto il livello, non solo colorata,
                        // perche' il colore da solo non basta a chi non lo
                        // distingue.
                        //
                        // E' il **binario di livello**, e con la targhetta qui
                        // accanto e' l'unico posto in cui un colore della rampa
                        // compare: riempie un'area, quindi la soglia che deve
                        // reggere e' quella del non testuale (DEC-137).
                        //
                        // La mappatura veniva scritta a mano qui, e non era
                        // quella approvata: corallo, `frame-dim` e ciano invece
                        // della rampa 0-4. Ora la decide `Palette.level-color`,
                        // che e' l'unico punto in cui la rampa e' definita.
                        Rectangle {
                            width: 4px;
                            horizontal-stretch: 0;
                            border-radius: Spacing.radius-row;
                            background: Palette.line-divider;

                            Rectangle {
                                y: parent.height - self.height;
                                width: 4px;
                                height: parent.height * (entry.level / 4);
                                border-radius: Spacing.radius-row;
                                background: Palette.level-color(entry.level);
                            }
                        }

                        VerticalLayout {
                            spacing: Spacing.xs;

                            HorizontalLayout {
                                spacing: Spacing.sm;
                                vertical-stretch: 0;

                                Text {
                                    text: entry.source;
                                    color: Palette.text;
                                    font-size: Typography.body;
                                    font-weight: Typography.medium;
                                    overflow: elide;
                                }
                                // Prima la pubblicazione, per cio' che non e'
                                // arrivato dal vivo (E2E01-06).
                                if entry.published != "": Text {
                                    text: entry.published;
                                    color: Palette.text-muted;
                                    font-size: Typography.technical;
                                    horizontal-stretch: 0;
                                }
                                Text {
                                    text: entry.acquired;
                                    color: Palette.text-muted;
                                    font-size: Typography.technical;
                                    horizontal-stretch: 0;
                                }
                            }

                            HorizontalLayout {
                                spacing: Spacing.sm;
                                vertical-stretch: 0;

                                // Targhetta del livello.
                                //
                                // Il colore della rampa vive nel **bordo**, non
                                // nel testo. Non e' un dettaglio di stile: il
                                // rosso del livello 4 vale 4,43 contro il
                                // pannello, sotto la soglia di 4,5 del testo, e
                                // sopra quella di 3:1 del non testuale. Nel
                                // bordo la regge; nel testo no (DEC-137).
                                //
                                // Il nome scritto resta in colore di testo e
                                // sta accanto al colore, quindi il livello non
                                // dipende mai dal colore soltanto.
                                Rectangle {
                                    horizontal-stretch: 0;
                                    border-radius: Spacing.radius-chip;
                                    border-width: Spacing.hairline;
                                    border-color: Palette.level-color(entry.level);

                                    HorizontalLayout {
                                        padding-left: Spacing.xxs;
                                        padding-right: Spacing.xxs;

                                        Text {
                                            text: entry.level-label;
                                            color: Palette.text;
                                            font-family: Typography.mono;
                                            font-size: Typography.technical;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                                Text {
                                    text: entry.review-state;
                                    color: entry.awaiting
                                        ? Palette.text
                                        : Palette.text-muted;
                                    font-size: Typography.group-label;
                                    horizontal-stretch: 0;
                                }
                                if entry.duplicate: Text {
                                    text: @tr("già osservato in un'altra sessione");
                                    color: Palette.text-muted;
                                    font-size: Typography.group-label;
                                    horizontal-stretch: 0;
                                }
                                // Che cosa e' successo DOPO l'acquisizione.
                                //
                                // In ambra, come «recuperato dalla cronologia»:
                                // sono le due righe che dicono che cio' che si
                                // legge non e' il caso ordinario. Un messaggio
                                // modificato o non piu' esposto dalla fonte e'
                                // spesso l'informazione piu' utile della riga.
                                if entry.history-label != "": Text {
                                    text: entry.history-label;
                                    color: Palette.amber;
                                    font-size: Typography.group-label;
                                    horizontal-stretch: 0;
                                }
                                // Cio' che l'applicazione non ha visto arrivare
                                // lo dichiara. L'archivio attesta un contenuto
                                // recuperato come **pubblicato**, non come
                                // sorvegliato, e chi legge deve poterlo sapere
                                // senza dedurlo dalla distanza fra due orari.
                                if entry.mode-label != "": Text {
                                    text: entry.mode-label;
                                    color: Palette.amber;
                                    font-size: Typography.group-label;
                                    horizontal-stretch: 0;
                                }
                                // Assente per i messaggi di canale: la riga
                                // sparisce invece di mostrare un trattino, che
                                // si leggerebbe come «autore sconosciuto»
                                // anziche' «nessun autore individuale».
                                if entry.author-username != "": Text {
                                    text: entry.author-username;
                                    color: Palette.text-muted;
                                    font-size: Typography.group-label;
                                    horizontal-stretch: 0;
                                }
                                if entry.author-identifier != "": Text {
                                    text: @tr("autore {}", entry.author-identifier);
                                    color: Palette.text-muted;
                                    font-size: Typography.group-label;
                                    horizontal-stretch: 0;
                                }
                                // L'IDENTIFICATIVO DEL CONTENUTO (OPERATOR-E2E-REMEDIATION-01,
                                // F-21): il Grafo lo chiede, e diceva che si trova
                                // qui accanto al messaggio. Non c'era.
                                Text {
                                    text: @tr("n. {}", entry.content-id);
                                    color: Palette.text-muted;
                                    font-family: Typography.mono;
                                    font-size: Typography.technical;
                                    horizontal-stretch: 0;
                                    accessible-role: text;
                                    accessible-label: @tr("Identificativo del contenuto {}", entry.content-id);
                                }
                                Rectangle { }
                            }

                            Text {
                                text: entry.excerpt;
                                color: Palette.text-muted;
                                font-size: Typography.body-secondary;
                                wrap: word-wrap;
                                overflow: elide;
                                vertical-stretch: 1;
                            }

                            Text {
                                // Vuota per i contenuti di livello 0: la
                                // motivazione vive nell'alert, e a quel livello
                                // non ne esiste alcuno.
                                text: entry.reason != "" ? entry.reason : (entry.terms != "" ? @tr("Termini presenti: {}", entry.terms) : @tr("Nessun termine del dizionario riscontrato."));
                                color: Palette.text-muted;
                                font-size: Typography.group-label;
                                wrap: word-wrap;
                                overflow: elide;
                                vertical-stretch: 0;
                            }

                            if entry.cited != "": Text {
                                text: entry.cited;
                                color: Palette.text-muted;
                                font-size: Typography.group-label;
                                wrap: word-wrap;
                                overflow: elide;
                                vertical-stretch: 0;
                            }
                        }
                    }

                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            row-focus.focus();
                            root.select(entry.content-id);
                        }
                    }

                    row-focus := FocusScope {
                        // Dichiarato **dopo** il `TouchArea`, quindi davanti a
                        // esso nell'ordine di traversata: con
                        // `focus-on-click` al valore predefinito `true` il
                        // primo clic su una riga non ancora a fuoco viene
                        // speso solo per prendere il fuoco, e il `TouchArea`
                        // non lo vede mai — servono due clic. Il fuoco lo da'
                        // gia' esplicitamente il gestore `clicked`. Stesso
                        // difetto corretto il 2026-07-30 su `profile-focus` e
                        // `account-focus`; qui e nelle due righe del wizard
                        // era rimasto.
                        focus-on-click: false;
                        key-pressed(event) => {
                            if (event.text == Key.Return || event.text == " ") {
                                root.select(entry.content-id);
                                return accept;
                            }
                            // Esc chiude il messaggio aperto (OS-01): scegliere
                            // di nuovo la riga aperta la chiude.
                            if (event.text == Key.Escape && root.selected >= 0) {
                                root.select(root.selected);
                                return accept;
                            }
                            return reject;
                        }
                    }

                    Rectangle {
                        background: transparent;
                        border-width: row-focus.has-focus ? 2px : 0px;
                        border-color: Palette.focus;
                        border-radius: Spacing.radius-row;
                    }

                    // PERCHE' VEDO QUESTO, con un gesto solo dall'elenco
                    // (PR-02). Sta DOPO l'area che sceglie la riga, perche' in
                    // Slint l'ultimo elemento sta sopra: dentro la riga, il
                    // clic lo prenderebbe la scelta. La colonna del testo gli
                    // lascia il posto a destra.
                    perche-riga := PercheVedoQuesto {
                        // Fuori da un layout la misura va detta: altrimenti
                        // sarebbe quella della riga intera.
                        width: self.preferred-width;
                        height: self.preferred-height;
                        x: parent.width - self.width - Spacing.md;
                        y: parent.height - self.height - Spacing.md;
                        elemento: entry.source + ", " + entry.acquired;
                        chiesto => {
                            root.explain(root.row-kind, entry.content-id, "");
                        }
                    }

                    // LA CONVERSAZIONE, CON UN GESTO SOLO DALL'ELENCO
                    // (ADR-0151, DG-01): non si sceglie prima la riga. Sta
                    // sopra l'area che sceglie, per la stessa ragione di
                    // «Perché vedo questo?».
                    conversa-riga := HudButton {
                        width: self.preferred-width;
                        height: self.preferred-height;
                        x: perche-riga.x - self.width - Spacing.sm;
                        y: parent.height - self.height - Spacing.md;
                        label: @tr("Conversazione");
                        reason: entry.source + ", " + entry.acquired;
                        clicked => {
                            root.open-conversation(entry.content-id);
                        }
                    }

                    accessible-role: button;
                    // L'etichetta e' la riga letta ad alta voce: porta la
                    // motivazione, perche' un livello senza il perche' e'
                    // proprio cio' che il motore trasparente non deve essere.
                    // Cio' che e' successo dopo l'acquisizione va LETTO AD
                    // ALTA VOCE come il resto: chi usa una tecnologia
                    // assistiva non vede l'etichetta in ambra.
                    accessible-label: entry.source + ", " + entry.acquired + ", " + entry.level-label + ", " + entry.review-state + (entry.mode-label != "" ? ", " + entry.mode-label : "") + (entry.history-label != "" ? ", " + entry.history-label : "") + (entry.author-identifier != "" ? @tr(", autore {}", entry.author-identifier) : "") + (entry.reason != "" ? ", " + entry.reason : "");
                    accessible-description: entry.excerpt;
                    accessible-action-default => {
                        if (!StationLock.engaged) { root.select(entry.content-id); }
                    }
                }
            }
        }

        // LA CRONOLOGIA DEL MESSAGGIO.
        //
        // # Perche' un pannello e non una colonna in piu'
        //
        // Le versioni portano i corpi interi, e un corpo intero non entra in
        // una riga di elenco. Chi apre questo pannello vuole LEGGERE che cosa
        // c'era scritto prima, non vederne un estratto.
        //
        // Si apre su richiesta e si chiude: l'elenco resta quello che era, e
        // nessuna schermata principale si sovraccarica.
        if root.story-open: Rectangle {
            vertical-stretch: 0;
            background: Palette.panel-raised;
            border-radius: Spacing.radius-row;
            border-width: Spacing.hairline;
            border-color: Palette.line-divider;
            max-height: 360px;

            VerticalLayout {
                padding: Spacing.md;
                spacing: Spacing.sm;

                HorizontalLayout {
                    spacing: Spacing.sm;
                    vertical-stretch: 0;

                    Text {
                        text: @tr("CRONOLOGIA DEL MESSAGGIO");
                        color: Palette.text-muted;
                        font-size: Typography.group-label;
                        letter-spacing: Typography.track-eyebrow;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    HudButton {
                        label: @tr("Chiudi");
                        clicked => {
                            root.close-story();
                        }
                    }
                }

                Text {
                    text: root.story-subject;
                    color: Palette.text;
                    font-size: Typography.body-secondary;
                    wrap: word-wrap;
                }

                // In ambra e in testa: che la fonte non esponga piu' il
                // messaggio e' la prima cosa da sapere, non l'ultima.
                if root.story-deleted: Text {
                    text: @tr("Questo messaggio non risulta più esposto da Telegram. Ciò che segue è quanto NEXUM/97 aveva già acquisito, e resta nell'archivio.");
                    color: Palette.amber;
                    font-size: Typography.body-secondary;
                    wrap: word-wrap;
                }

                // La frase porta l'avvertenza che cambia il modo di leggere la
                // riga: livello e testo dello Storico riguardano la versione
                // acquisita, non l'ultima osservata.
                Text {
                    text: root.story;
                    color: Palette.text-muted;
                    font-size: Typography.group-label;
                    wrap: word-wrap;
                }

                Flickable {
                    // UN `Flickable` SENZA LARGHEZZA INOLTRA AL GENITORE LA LARGHEZZA MASSIMA DEL
                    // SUO CONTENUTO (OPERATOR-E2E-REMEDIATION-01, F-05). Un segno d'origine a
                    // larghezza fissa la rendeva finita; il vincolo saliva fino alla finestra, e
                    // Slint la restringeva da sola aprendo il pannello (1136×759 → 1016×798).
                    // Dichiarata qui, non si inoltra.
                    max-width: 100000px;
                    vertical-stretch: 1;
                    viewport-height: versioni.preferred-height;

                    versioni := VerticalLayout {
                        spacing: Spacing.sm;

                        LegendaOrigini {
                            osservato: @tr("testo e modifica dichiarata");
                            calcolato: @tr("quando il programma l'ha vista e che cosa è cambiato");
                        }
                        for versione in root.versions: Rectangle {
                            background: Palette.panel;
                            border-radius: Spacing.radius-row;
                            height: riga-versione.preferred-height + 2 * Spacing.sm;

                            riga-versione := VerticalLayout {
                                padding: Spacing.sm;
                                spacing: 2px;

                                HorizontalLayout {
                                    spacing: Spacing.sm;

                                    Text {
                                        text: versione.heading;
                                        // La versione analizzata si distingue:
                                        // e' quella a cui si riferiscono
                                        // livello, riscontri e alert.
                                        color: versione.original
                                            ? Palette.text
                                            : Palette.text-muted;
                                        font-size: Typography.body-secondary;
                                        font-weight: versione.original
                                            ? Typography.medium
                                            : Typography.light;
                                        horizontal-stretch: 1;
                                    }
                                    Text {
                                        text: versione.observed;
                                        color: Palette.text-muted;
                                        font-family: Typography.mono;
                                        font-size: Typography.technical;
                                        vertical-alignment: center;
                                    }
                                }

                                // L'istante dichiarato da Telegram, quando c'e'.
                                // Vuoto altrimenti: e' un dato della fonte, e
                                // un trattino si leggerebbe come «sconosciuto»
                                // invece che «non dichiarato».
                                if versione.remote-edit != "": Text {
                                    text: versione.remote-edit;
                                    color: Palette.text-disabled;
                                    font-size: Typography.group-label;
                                }

                                // Che cosa e' cambiato, in una frase ESATTA.
                                // Nessun confronto parola per parola: su un
                                // testo riscritto allineerebbe pezzi che
                                // nessuno ha messo in relazione.
                                if versione.change != "": Rectangle {
                                    // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                    min-height: rip-6.preferred-height;
                                    rip-6 := HorizontalLayout {
                                        spacing: Spacing.sm;
                                        Text {
                                            text: versione.change;
                                            color: Palette.text-muted;
                                            font-size: Typography.group-label;
                                            wrap: word-wrap;
                                            horizontal-stretch: 1;
                                        }
                                        Text {
                                            text: versione.delta;
                                            color: Palette.text-disabled;
                                            font-family: Typography.mono;
                                            font-size: Typography.technical;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                Text {
                                    text: versione.body;
                                    color: Palette.text;
                                    font-size: Typography.body-secondary;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }
                }
            }
        }


        // IL PERCORSO DEL RISULTATO.
        //
        // Le tre nature restano separate e in quest'ordine: FATTO OSSERVATO,
        // ELABORAZIONE AUTOMATICA, DECISIONE UMANA. Mescolarle produrrebbe
        // esattamente la confusione che questo prodotto rifiuta: che cio' che
        // la macchina ha calcolato si legga come cio' che qualcuno ha deciso.
        if root.why-open: Rectangle {
            vertical-stretch: 0;
            background: Palette.panel-raised;
            border-radius: Spacing.radius-row;
            border-width: Spacing.hairline;
            border-color: Palette.line-divider;
            max-height: 400px;

            VerticalLayout {
                padding: Spacing.md;
                spacing: Spacing.sm;

                HorizontalLayout {
                    spacing: Spacing.sm;
                    vertical-stretch: 0;

                    Text {
                        text: @tr("TUTTA LA PROVENIENZA");
                        color: Palette.text-muted;
                        font-size: Typography.group-label;
                        letter-spacing: Typography.track-eyebrow;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    HudButton {
                        label: @tr("Chiudi");
                        clicked => {
                            root.close-why();
                        }
                    }
                }

                Text {
                    text: root.why-subject;
                    color: Palette.text;
                    font-size: Typography.body-secondary;
                    wrap: word-wrap;
                }

                // In ambra e in testa, come nella cronologia: se il messaggio
                // e' cambiato dopo, tutto cio' che segue riguarda un testo che
                // non e' piu' quello, ed e' la prima cosa da sapere.
                if root.why-version-warning != "": Text {
                    text: root.why-version-warning;
                    color: Palette.amber;
                    font-size: Typography.body-secondary;
                    wrap: word-wrap;
                }

                Flickable {
                    // UN `Flickable` SENZA LARGHEZZA INOLTRA AL GENITORE LA LARGHEZZA MASSIMA DEL
                    // SUO CONTENUTO (OPERATOR-E2E-REMEDIATION-01, F-05). Un segno d'origine a
                    // larghezza fissa la rendeva finita; il vincolo saliva fino alla finestra, e
                    // Slint la restringeva da sola aprendo il pannello (1136×759 → 1016×798).
                    // Dichiarata qui, non si inoltra.
                    max-width: 100000px;
                    viewport-height: percorso.preferred-height;

                    percorso := VerticalLayout {
                        spacing: Spacing.sm;

                        // ---------------------------------- osservato (ADR-0118)

                        OrigineSegno { origine: Origine.osservato; }
                        Text {
                            text: root.why-origin;
                            color: Palette.text;
                            font-size: Typography.body-secondary;
                            wrap: word-wrap;
                        }

                        // ---------------------------------- calcolato (ADR-0118)

                        OrigineSegno { origine: Origine.calcolato; }

                        // I termini trovati, ciascuno con il dizionario da cui
                        // veniva. Un termine di cui non si conosce la
                        // provenienza lo dice, invece di lasciar credere
                        // completo un elenco che non lo e'.
                        for term in root.why-terms: Rectangle {
                            // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                            min-height: rip-7.preferred-height;
                            rip-7 := VerticalLayout {
                                spacing: Spacing.xs;

                                Text {
                                    text: term.text;
                                    color: term.mitigating ? Palette.text-muted : Palette.text;
                                    font-size: Typography.body-secondary;
                                    wrap: word-wrap;
                                }
                                Text {
                                    text: term.mitigating ? @tr("{} · {} · abbassa il livello", term.origin, term.position) : term.origin + " · " + term.position;
                                    color: term.known ? Palette.text-muted : Palette.amber;
                                    font-size: Typography.group-label;
                                    wrap: word-wrap;
                                }
                                // PERCHE' VEDO QUESTO, sul riscontro (PR-02). La
                                // porta verso tutta la provenienza non c'e': ci si
                                // trova gia' dentro.
                                PercheVedoQuesto {
                                    elemento: term.text;
                                    chiesto => {
                                        // La frase del termine dice gia' dizionario ed effetto (OBS-AN-1):
                                        // ripeterne la provenienza la scriveva due volte.
                                        root.explain(Spiegabile.riscontro, root.selected, term.text + ".");
                                    }
                                }
                            }
                        }

                        // CHI ha prodotto il livello, prima di COME.
                        //
                        // Un livello e' il prodotto di due cose: quali termini
                        // si cercavano e come i riscontri diventano un numero.
                        // La prima meta' e' sopra, nei termini con la loro
                        // provenienza; questa e' la seconda.
                        Text {
                            text: root.why-engine;
                            color: Palette.text-muted;
                            font-size: Typography.group-label;
                            wrap: word-wrap;
                        }

                        // IL REPLAY, su richiesta (REPLAY-01).
                        //
                        // Il comando sta accanto al motore perche' e' la
                        // domanda che nasce da li': «e con il motore di
                        // oggi?». Non si apre da solo — un livello ipotetico
                        // mostrato senza che nessuno lo abbia chiesto
                        // verrebbe letto come un secondo livello del
                        // contenuto, e il contenuto ne ha uno solo.
                        if !root.replay-open: Rectangle {
                            // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                            min-height: rip-8.preferred-height;
                            rip-8 := HorizontalLayout {
                                spacing: Spacing.sm;
                                vertical-stretch: 0;

                                HudButton {
                                    label: @tr("Che cosa direbbe il motore di oggi?");
                                    clicked => {
                                        root.open-replay(root.selected);
                                    }
                                }
                                Rectangle { horizontal-stretch: 1; background: transparent; }
                            }
                        }

                        if root.replay-open: Rectangle {
                            vertical-stretch: 0;
                            background: Palette.panel-inset;
                            border-radius: Spacing.radius-row;

                            // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                            min-height: rip-9.preferred-height;
                            rip-9 := VerticalLayout {
                                padding: Spacing.md;
                                spacing: Spacing.xs;

                                HorizontalLayout {
                                    spacing: Spacing.sm;
                                    vertical-stretch: 0;

                                    Text {
                                        text: @tr("IL FATTO, E L'IPOTESI");
                                        color: Palette.text-muted;
                                        font-size: Typography.group-label;
                                        letter-spacing: Typography.track-eyebrow;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                    }
                                    HudButton {
                                        label: @tr("Chiudi");
                                        clicked => {
                                            root.close-replay();
                                        }
                                    }
                                }

                                // IL FATTO, per primo. E' successo, e'
                                // registrato, e nulla lo cambia.
                                Text {
                                    text: root.replay-historical;
                                    color: Palette.text;
                                    font-size: Typography.body-secondary;
                                    wrap: word-wrap;
                                }

                                // L'IPOTESI, dopo, e in un colore che non e'
                                // quello del fatto: non e' successa, e non
                                // succede per il fatto di averla calcolata.
                                Text {
                                    text: root.replay-hypothetical;
                                    color: Palette.text-muted;
                                    font-size: Typography.body-secondary;
                                    wrap: word-wrap;
                                }

                                // A CHE COSA la differenza sia dovuta — e
                                // quando non sia dovuta a nulla di sapibile.
                                // In ambra solo quando c'e' una differenza.
                                Text {
                                    text: root.replay-attribution;
                                    color: root.replay-differs
                                        ? Palette.amber
                                        : Palette.text-muted;
                                    font-size: Typography.group-label;
                                    wrap: word-wrap;
                                }
                            }
                        }

                        // CONTENUTI CHE GLI SOMIGLIANO (SIM-01). Su richiesta:
                        // il confronto legge tutti i contenuti della sessione.
                        if !root.resembling-open: Rectangle {
                            // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                            min-height: rip-10.preferred-height;
                            rip-10 := HorizontalLayout {
                                spacing: Spacing.sm;
                                vertical-stretch: 0;

                                HudButton {
                                    label: @tr("A quali contenuti somiglia?");
                                    clicked => {
                                        root.open-resembling(root.selected);
                                    }
                                }
                                Rectangle { horizontal-stretch: 1; background: transparent; }
                            }
                        }

                        if root.resembling-open: Rectangle {
                            vertical-stretch: 0;
                            background: Palette.panel-inset;
                            border-radius: Spacing.radius-row;

                            // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                            min-height: rip-11.preferred-height;
                            rip-11 := VerticalLayout {
                                padding: Spacing.md;
                                spacing: Spacing.xs;

                                HorizontalLayout {
                                    spacing: Spacing.sm;
                                    vertical-stretch: 0;

                                    Text {
                                        text: @tr("CONTENUTI CHE GLI SOMIGLIANO");
                                        color: Palette.text-muted;
                                        font-size: Typography.group-label;
                                        letter-spacing: Typography.track-eyebrow;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                    }
                                    HudButton {
                                        label: @tr("Chiudi");
                                        clicked => {
                                            root.close-resembling();
                                        }
                                    }
                                }

                                // IL METODO e cio' che non si e' potuto
                                // confrontare, prima delle righe: senza,
                                // «nessun contenuto simile» si leggerebbe come
                                // un esito quando e' l'assenza di una misura.
                                Text {
                                    text: root.resembling-summary;
                                    color: Palette.text-muted;
                                    font-size: Typography.body-secondary;
                                    wrap: word-wrap;
                                }

                                LegendaOrigini {
                                    osservato: @tr("l'altro contenuto");
                                    calcolato: @tr("perché si somigliano");
                                }
                                for somiglianza in root.resembling-rows: Rectangle {
                                    // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                    min-height: rip-12.preferred-height;
                                    rip-12 := VerticalLayout {
                                        spacing: Spacing.xs;
                                        vertical-stretch: 0;

                                        Text {
                                            text: somiglianza.other;
                                            color: Palette.text;
                                            font-size: Typography.body-secondary;
                                            font-weight: 600;
                                            wrap: word-wrap;
                                        }
                                        Text {
                                            text: somiglianza.why;
                                            color: Palette.text-muted;
                                            font-size: Typography.body-secondary;
                                            wrap: word-wrap;
                                        }
                                        // L'EVIDENZA: le sequenze in comune. E'
                                        // l'esito dell'algoritmo, non un dettaglio
                                        // tecnico — una percentuale senza queste
                                        // righe sarebbe un numero che chi legge
                                        // non puo' controllare.
                                        Text {
                                            text: somiglianza.evidence;
                                            color: Palette.text-muted;
                                            font-family: Typography.mono;
                                            font-size: Typography.technical;
                                            wrap: word-wrap;
                                        }
                                        // LA STESSA DOMANDA, LA STESSA VOCE. Una
                                        // percentuale di somiglianza e' il numero
                                        // che piu' assomiglia a un punteggio, e la
                                        // risposta dice che e' un calcolo con una
                                        // regola dichiarata e una soglia scelta.
                                        PercheVedoQuesto {
                                            elemento: @tr("la somiglianza");
                                            chiesto => {
                                                root.explain-subject(Spiegabile.somiglianza, somiglianza.pair-key, somiglianza.why);
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // APRIRE LA CONVERSAZIONE (ADR-0151; era «Apri nel
                        // contesto», CTX-03). Su richiesta: il contorno si
                        // legge da Telegram al momento, e costa.
                        Rectangle {
                            // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                            min-height: rip-13.preferred-height;
                            rip-13 := HorizontalLayout {
                                spacing: Spacing.sm;
                                vertical-stretch: 0;

                                HudButton {
                                    label: @tr("Apri la conversazione");
                                    clicked => {
                                        root.open-conversation(root.selected);
                                    }
                                }
                                // «Raccogli nel workspace» e «Segna» stavano qui,
                                // dentro la provenienza, e l'operatore simulato
                                // non li ha trovati (OPERATOR-SIM-01, OS-02): ora
                                // stanno nel pannello del messaggio scelto, in
                                // prima riga.
                                Rectangle { horizontal-stretch: 1; background: transparent; }
                            }
                        }

                        AuthorSubjects {
                            identifier: root.author-identifier;
                            subjects: root.author-subjects;
                            open-subject(id) => {
                                root.open-subject(id);
                            }
                            link-subject(identificativo) => {
                                root.link-subject(identificativo);
                            }
                        }

                        // LE NOTE SU QUESTO CONTENUTO (NOTE-01).
                        //
                        // Il pannello e' lo stesso che usa il workspace: due
                        // copie divergerebbero il giorno in cui una regola
                        // cambia.
                        //
                        // Il riferimento e' implicito — e' il contenuto che si
                        // sta guardando — percio' le righe non ripetono su che
                        // cosa: qui sarebbe rumore.
                        NotesPanel {
                            rows: root.notes;
                            draft <=> root.note-draft;
                            message: root.note-message;
                            subject: @tr("questo contenuto");
                            write(testo) => {
                                root.write-note(testo);
                            }
                            withdraw(id) => {
                                root.withdraw-note(id);
                            }
                        }

                        // Come si e' arrivati al livello. In ambra quando la
                        // frase NON e' una spiegazione verificata: allora
                        // dichiara una lacuna o una discordanza, e leggerla
                        // come la causa del livello sarebbe l'errore che
                        // PROV-01 esiste per impedire.
                        Text {
                            text: root.why-scoring;
                            color: root.why-scoring-trustworthy ? Palette.text : Palette.amber;
                            font-size: Typography.body-secondary;
                            wrap: word-wrap;
                        }

                        if root.why-alert != "": Text {
                            text: root.why-alert;
                            color: Palette.text;
                            font-size: Typography.body-secondary;
                            wrap: word-wrap;
                        }
                        // PERCHE' VEDO QUESTO, sull'avviso (PR-02).
                        if root.why-alert != "": PercheVedoQuesto {
                            elemento: @tr("l'avviso");
                            chiesto => {
                                root.explain(Spiegabile.avviso, root.selected, "");
                            }
                        }

                        // ---------------------------------- operatore (ADR-0118)
                        if root.why-decisions.length > 0: OrigineSegno { origine: Origine.operatore; }
                        for decision in root.why-decisions: Rectangle {
                            // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                            min-height: rip-17.preferred-height;
                            rip-17 := VerticalLayout {
                                spacing: Spacing.xs;

                                Text {
                                    text: decision.heading;
                                    color: Palette.text;
                                    font-size: Typography.body-secondary;
                                    wrap: word-wrap;
                                }
                                if decision.note != "": Text {
                                    text: decision.note;
                                    color: Palette.text-muted;
                                    font-size: Typography.group-label;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }
                }
            }
        }

        // Pannello della decisione. Compare solo con una riga scelta: dei
        // comandi sempre visibili ma inerti direbbero che si puo' decidere
        // senza aver scelto su che cosa.
        //
        // # Si chiude, e non ruba l'elenco (OPERATOR-UX-REMEDIATION-01, OS-01)
        //
        // Era alto 184 px fissi, senza un comando che lo chiudesse: a finestra
        // piena lasciava all'elenco una riga tagliata, e le righe in fondo
        // (provenienza, collegamento) uscivano dal bordo. Ora prende l'altezza
        // che gli serve fino a poco meno di metà schermata, poi scorre; «Chiudi»
        // ed Esc lo chiudono.
        //
        // # Organizzare sta in prima riga (OS-02)
        //
        // «Segna» e «Raccogli nel workspace» stavano dentro «Tutta la
        // provenienza», e chi voleva mettere un messaggio in un caso non li
        // trovava. Sono gesti sul messaggio scelto: stanno qui, sotto il suo
        // nome, prima della decisione.
        if root.selected >= 0: Rectangle {
            // Altezza preferita, non fissa: a schermata bassa il pannello
            // scende fino a 120 px e scorre, invece di uscire dal bordo.
            preferred-height: min(dettaglio.preferred-height + 8px, 268px);
            min-height: min(dettaglio.preferred-height + 8px, 120px);
            max-height: 268px;
            vertical-stretch: 0;
            background: Palette.panel-raised;
            border-radius: Spacing.radius-row;
            border-width: Spacing.hairline;
            border-color: Palette.line-divider;

            HudScroll {
            dettaglio := VerticalLayout {
                padding: Spacing.md;
                spacing: Spacing.sm;

                HorizontalLayout {
                    spacing: Spacing.sm;
                    vertical-stretch: 0;

                    Text {
                        text: root.selected-summary;
                        color: Palette.text;
                        font-size: Typography.body-secondary;
                        wrap: word-wrap;
                        overflow: elide;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    // Chiudere e' scegliere di nuovo la riga aperta: la
                    // finestra sa gia' farlo, e chiude con essa i pannelli.
                    HudButton {
                        label: @tr("Chiudi");
                        clicked => {
                            root.select(root.selected);
                        }
                    }
                }

                // ORGANIZZARE IL MESSAGGIO SCELTO.
                HorizontalLayout {
                    spacing: Spacing.sm;
                    vertical-stretch: 0;

                    // SEGNARE E' UN GESTO SOLO (BOOK-01).
                    //
                    // Non chiede dove: la raccolta si sceglie dopo, se serve.
                    // L'etichetta dice lo STATO, non l'augurio: su una cosa
                    // gia' segnata offrire «Segna» farebbe credere di aver
                    // perso il segno.
                    HudButton {
                        // «Aggiungi ai segnalibri», non «Segna» (UX-EXCELLENCE-02,
                        // SIM3-11): accanto allo stato «Segnalato» di una revisione
                        // le due parole si confondevano.
                        label: root.marked ? @tr("Togli dai segnalibri") : @tr("Aggiungi ai segnalibri");
                        clicked => {
                            root.toggle-bookmark(root.selected);
                        }
                    }
                    // SI RACCOGLIE DOVE IL MATERIALE E' (WS-02).
                    //
                    // Chiedere di trascrivere un identificativo nella
                    // schermata Workspace sarebbe chiedere a una persona il
                    // lavoro che il programma deve fare. In quale workspace lo
                    // dice la frase dell'esito, per nome.
                    HudButton {
                        label: @tr("Aggiungi al raccoglitore");
                        clicked => {
                            root.collect-in-workspace(root.selected);
                        }
                    }
                    Text {
                        text: @tr("Segnalibri e raccoglitori si ritrovano nel menu, sotto ESAMINARE.");
                        color: Palette.text-muted;
                        font-size: Typography.group-label;
                        vertical-alignment: center;
                        wrap: word-wrap;
                        horizontal-stretch: 1;
                    }
                }

                HorizontalLayout {
                    spacing: Spacing.sm;
                    vertical-stretch: 0;

                    Text {
                        text: @tr("Stato: {}", root.selected-state);
                        color: Palette.text-muted;
                        font-size: Typography.group-label;
                        vertical-alignment: center;
                        horizontal-stretch: 0;
                    }
                    HudInput {
                        placeholder: @tr("Motivo: serve per «Segnalato», e per «Non rilevante» o «Duplicato» su un avviso");
                        label: @tr("Motivo della decisione");
                        value <=> root.note;
                    }
                }

                HorizontalLayout {
                    spacing: Spacing.sm;
                    vertical-stretch: 0;

                    HudButton {
                        label: @tr("In esame");
                        clicked => {
                            root.decide("in_review");
                        }
                    }
                    HudButton {
                        label: @tr("Rilevante");
                        clicked => {
                            root.decide("relevant");
                        }
                    }
                    HudButton {
                        label: @tr("Non rilevante");
                        clicked => {
                            root.decide("not_relevant");
                        }
                    }
                    HudButton {
                        label: @tr("Duplicato");
                        clicked => {
                            root.decide("duplicate");
                        }
                    }
                    HudButton {
                        label: @tr("Segnalato");
                        clicked => {
                            root.decide("reported");
                        }
                    }
                    HudButton {
                        label: @tr("Archiviato");
                        clicked => {
                            root.decide("archived");
                        }
                    }
                }

                // La via alla cronologia del messaggio.
                //
                // Sta qui e non sulla riga perche' la riga e' gia' un'area
                // cliccabile intera: un pulsante dentro le contenderebbe il
                // clic. E compare SOLO quando c'e' una storia da aprire —
                // offrirlo su ogni riga per mostrare «nessuna modifica»
                // sarebbe un comando che non porta da nessuna parte.
                if root.selected-has-history: Rectangle {
                    // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                    min-height: rip-18.preferred-height;
                    rip-18 := HorizontalLayout {
                        spacing: Spacing.sm;
                        vertical-stretch: 0;

                        Text {
                            // L'avvertenza che cambia il modo di leggere il livello.
                            // Riguarda le sole MODIFICHE: un messaggio eliminato e
                            // mai modificato porta ancora il testo analizzato.
                            text: root.selected-revised ? @tr("Il testo e il livello qui sopra sono quelli della versione acquisita.") : @tr("Questo messaggio non risulta più esposto da Telegram.");
                            color: Palette.amber;
                            font-size: Typography.group-label;
                            vertical-alignment: center;
                            wrap: word-wrap;
                            horizontal-stretch: 1;
                        }
                        HudButton {
                            label: @tr("Cronologia del messaggio");
                            clicked => {
                                root.open-story(root.selected);
                            }
                        }
                    }
                }

                // IL LIVELLO, E TUTTA LA PROVENIENZA.
                //
                // I comandi ci sono per OGNI riga scelta, non solo per quelle
                // con una storia o con un avviso: la domanda ha senso anche —
                // e forse soprattutto — davanti a un livello 0, dove la
                // risposta e' «nessun termine della configurazione compare qui».
                //
                // «Perché vedo questo?» risponde sul livello in tre parti
                // (PR-02); «Provenienza, note e contesto» apre il percorso intero
                // (PROV-01), che prima si apriva con il nome della domanda.
                HorizontalLayout {
                    spacing: Spacing.sm;
                    vertical-stretch: 0;
                    Text {
                        text: @tr("Il livello di questa riga, e il percorso che l'ha portata qui: origine, termini trovati, livello, avviso e decisioni.");
                        color: Palette.text-muted;
                        font-size: Typography.group-label;
                        vertical-alignment: center;
                        wrap: word-wrap;
                        horizontal-stretch: 1;
                    }
                    PercheVedoQuesto {
                        elemento: @tr("il livello");
                        chiesto => {
                            root.explain(Spiegabile.livello, root.selected, "");
                        }
                    }
                    HudButton {
                        label: @tr("Provenienza, note e contesto");
                        clicked => {
                            root.open-why(root.selected);
                        }
                    }
                    HudButton {
                        label: @tr("Apri nel Grafo");
                        reason: @tr("Mostra che cosa tocca questo contenuto, un passo alla volta.");
                        clicked => {
                            root.open-graph(root.selected);
                        }
                    }
                }

                // Il collegamento del contenuto, se c'e', con l'apertura sicura
                // nel browser (ADR-0018): l'URL e' mostrato per intero, e si apre
                // esattamente cio' che si legge.
                if root.selected-url != "": Rectangle {
                    // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                    min-height: rip-19.preferred-height;
                    rip-19 := HorizontalLayout {
                        spacing: Spacing.sm;
                        vertical-stretch: 0;
                        Text {
                            text: root.selected-url;
                            color: Palette.cyan;
                            font-size: Typography.body-secondary;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                        HudButton {
                            label: @tr("Apri collegamento");
                            clicked => {
                                root.open-url(root.selected-url);
                            }
                        }
                    }
                }

                // IL COLLEGAMENTO UFFICIALE AL MESSAGGIO, CHIESTO ADESSO
                // (CA02-14, DG-02). L'acquisizione non lo conserva, per scelta
                // (LINK-01): si chiede a Telegram quando serve, e la frase dice
                // quando, se e' pubblico, o perche' manca.
                HorizontalLayout {
                    spacing: Spacing.sm;
                    vertical-stretch: 0;
                    HudButton {
                        label: @tr("Chiedi il collegamento a Telegram");
                        reason: @tr("Telegram fornisce l'indirizzo del messaggio, se ne ha uno. Non viene conservato.");
                        clicked => {
                            root.request-link(root.selected);
                        }
                    }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                }
                if root.link-request-sentence != "": Text {
                    text: root.link-request-sentence;
                    color: Palette.text-muted;
                    font-size: Typography.body-secondary;
                    wrap: word-wrap;
                }
                if root.link-request-url != "": Rectangle {
                    // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                    min-height: rip-179.preferred-height;
                    rip-179 := HorizontalLayout {
                        spacing: Spacing.sm;
                        vertical-stretch: 0;
                        Text {
                            text: root.link-request-url;
                            color: Palette.cyan;
                            font-size: Typography.body-secondary;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                        HudButton {
                            label: @tr("Apri il collegamento fornito");
                            clicked => {
                                root.open-url(root.link-request-url);
                            }
                        }
                    }
                }

                // L'ALLEGATO (ATTACH-01, ADR-0177). Ciò che il mittente dichiara,
                // e il comando per conservarlo con una ragione. Il programma non
                // lo apre: nessuna anteprima, nessun «Apri» (decisione 7).
                if root.attachment-sentence != "": Rectangle {
                    // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                    min-height: riga-allegato.preferred-height;
                    riga-allegato := HorizontalLayout {
                        spacing: Spacing.sm;
                        vertical-stretch: 0;
                        Text {
                            text: root.attachment-sentence;
                            color: Palette.text;
                            font-size: Typography.body-secondary;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            wrap: word-wrap;
                        }
                        HudButton {
                            label: @tr("Conserva l'allegato");
                            reason: @tr("Chiede a Telegram i byte e li conserva nell'archivio con la loro impronta. Non li apre.");
                            horizontal-stretch: 0;
                            clicked => {
                                root.open-attachment(root.selected);
                            }
                        }
                    }
                }
                if root.attachment-open: Rectangle {
                    background: Palette.panel-raised;
                    border-radius: Spacing.radius-row;
                    vertical-stretch: 0;
                    min-height: scheda-allegato.preferred-height;
                    scheda-allegato := VerticalLayout {
                        padding: Spacing.lg;
                        spacing: Spacing.sm;

                        HorizontalLayout {
                            spacing: Spacing.md;
                            Text {
                                text: @tr("Conservare l'allegato");
                                color: Palette.text;
                                font-size: Typography.body;
                                font-weight: Typography.medium;
                                horizontal-stretch: 1;
                                wrap: word-wrap;
                            }
                            HudButton {
                                label: @tr("Chiudi");
                                horizontal-stretch: 0;
                                clicked => {
                                    root.attachment-close();
                                }
                            }
                        }
                        Text {
                            text: root.attachment-caveat;
                            color: Palette.amber;
                            font-size: Typography.body-secondary;
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            spacing: Spacing.md;
                            HudInput {
                                placeholder: @tr("Perché serve (almeno 20 caratteri)");
                                label: @tr("Ragione della richiesta");
                                value <=> root.attachment-reason;
                                horizontal-stretch: 1;
                            }
                            HudButton {
                                label: @tr("Chiedi a Telegram");
                                horizontal-stretch: 0;
                                clicked => {
                                    root.attachment-ask();
                                }
                            }
                        }
                        if root.attachment-message != "": Text {
                            text: root.attachment-message;
                            color: Palette.text-muted;
                            font-size: Typography.body-secondary;
                            wrap: word-wrap;
                        }
                        if root.attachment-entries.length == 0: Text {
                            text: @tr("Nessuna richiesta registrata per questo allegato.");
                            color: Palette.text-disabled;
                            font-size: Typography.body-secondary;
                            wrap: word-wrap;
                        }
                        if root.attachment-entries.length > 0: LegendaOrigini {
                            osservato: @tr("l'esito");
                            calcolato: @tr("istanti e impronte");
                            operatore: @tr("ragione");
                        }
                        for richiesta in root.attachment-entries: Rectangle {
                            vertical-stretch: 0;
                            min-height: riga-richiesta.preferred-height;
                            riga-richiesta := VerticalLayout {
                                spacing: Spacing.xs;
                                padding-top: Spacing.xs;
                                padding-bottom: Spacing.xs;
                                Text {
                                    text: richiesta.when;
                                    color: Palette.text;
                                    font-size: Typography.body-secondary;
                                    wrap: word-wrap;
                                }
                                Text {
                                    text: richiesta.motive;
                                    color: Palette.text-muted;
                                    font-size: Typography.group-label;
                                    wrap: word-wrap;
                                }
                                Text {
                                    text: richiesta.outcome;
                                    color: Palette.text-muted;
                                    font-size: Typography.body-secondary;
                                    wrap: word-wrap;
                                }
                                if richiesta.fingerprint != "": Text {
                                    text: richiesta.fingerprint;
                                    color: Palette.text;
                                    font-size: Typography.group-label;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }
                }
            }
            }
        }
    }
}

// Comando della barra del titolo.
//
// I tre segni sono **caratteri tipografici**, non icone: il sistema grafico
// approvato lo dice esplicitamente, ed e' coerente con una navigazione senza
// icone. Nessun file, nessun tracciato, nessuna dimensione da compensare.
component WindowCommand inherits Rectangle {
    in property <string> character;
    in property <string> label;
    // Il comando che chiude si distingue **al passaggio**, non a riposo: un
    // rosso permanente in alto a destra sarebbe l'elemento piu' acceso di una
    // schermata in cui l'ambra segnala una sola cosa alla volta.
    in property <bool> destructive: false;
    callback activated();

    width: Shell.titlebar-command-width;
    height: Shell.titlebar-height;
    horizontal-stretch: 0;

    background: touch.has-hover
        ? (root.destructive ? Palette.coral : Palette.panel-raised)
        : transparent;

    animate background {
        duration: Motion.quick;
        easing: cubic-bezier(0.2, 0, 0.2, 1);
    }

    Text {
        text: root.character;
        color: touch.has-hover && root.destructive ? Palette.text : Palette.text-muted;
        font-family: Typography.core;
        font-size: Typography.body;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    // Dichiarato PRIMA di `touch`, per la stessa ragione della voce di menu: in
    // Slint l'ultimo elemento riceve per primo gli eventi del puntatore, e con
    // il `FocusScope` sopra il primo clic servirebbe solo a spostare il fuoco.
    focus := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                root.activated();
                return accept;
            }
            if (event.text == Key.Tab || event.text == Key.Backtab) {
                FocusRule.navigating = true;
            }
            return reject;
        }
    }

    touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => {
            // **NIENTE `focus.focus()` QUI.**
            //
            // Prendere il fuoco al clic lasciava l'anello acceso sul tasto
            // dopo averlo premuto: ridurre la finestra e ritrovarsi il
            // riquadro evidenziato addosso. Segnalato il 2026-08-20.
            //
            // L'anello serve a chi naviga con la tastiera, e con questa
            // riga in meno continua a servirlo: il tasto resta raggiungibile
            // col tabulatore, e allora l'anello compare — perche' li' e'
            // l'unico modo di sapere dove si e'.
            //
            // Non prendere il fuoco al clic e' anche cio' che fa Windows con
            // i propri comandi di finestra: dopo aver ridotto una finestra,
            // il fuoco non resta parcheggiato sul tasto che la chiude.
            root.activated();
        }
    }

    Rectangle {
        background: transparent;
        border-width: focus.has-focus ? 2px : 0px;
        border-color: Palette.focus;
    }

    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => {
        if (!StationLock.engaged) { root.activated(); }
    }
}

// Barra del titolo disegnata dal prodotto.
//
// **Windows non sa che non e' la sua.** La finestra resta una normale finestra
// sovrapposta: `lisi-platform::title_bar` le toglie soltanto il disegno della
// didascalia e risponde «didascalia» per la fascia qui sotto. Da quel momento
// trascinamento, aggancio ai bordi, scorciatoie, doppio clic per massimizzare e
// menu di sistema **restano di Windows** (ADR-0028).
//
// Qui non c'e' quindi alcun trascinamento scritto a mano, ed e' la ragione per
// cui l'elenco di ADR-0020 non si e' trasformato in altrettanti difetti.
component TitleBar inherits Rectangle {
    in property <string> title;
    // Lo stato della postazione — account e modalità — scritto come testo
    // (UX-EXCELLENCE-02, SIM3-04 e SIM3-16). Stava in due pastiglie della
    // testata del marchio, che sembravano pulsanti e non facevano nulla, e la
    // testata occupava 64 pixel su ogni schermata. Qui è un'indicazione, non un
    // comando: la fascia è «didascalia» per Windows e non riceve clic.
    in property <string> status;
    callback minimise();
    callback toggle-maximise();
    callback close();

    height: Shell.titlebar-height;
    background: Palette.chrome;

    HorizontalLayout {
        padding-left: Spacing.md;
        spacing: Spacing.sm;

        // Nessun `y` esplicito: la posizione di un figlio la decide il layout,
        // e imporgliela accanto a un'altezza propria manda il calcolo in un
        // giro senza fine - la finestra non compare affatto, e non c'e' alcun
        // errore da leggere.
        BrandMark {
            size: 18px;
        }

        Text {
            text: root.title;
            color: Palette.text-muted;
            font-family: Typography.core;
            font-size: Typography.caption;
            letter-spacing: Typography.track-titlebar;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }

        if root.status != "": Text {
            text: root.status;
            color: Palette.text-muted;
            font-family: Typography.core;
            font-size: Typography.caption;
            vertical-alignment: center;
            horizontal-stretch: 0;
            accessible-role: text;
            accessible-label: root.status;
        }

        Rectangle {
            width: Spacing.md;
            horizontal-stretch: 0;
        }

        WindowCommand {
            character: "\u{2014}";
            label: @tr("Riduci a icona");
            activated => {
                root.minimise();
            }
        }

        WindowCommand {
            character: "\u{25A1}";
            label: @tr("Ingrandisci o ripristina");
            activated => {
                root.toggle-maximise();
            }
        }

        WindowCommand {
            // U+00D7, non U+2715.
            //
            // Il riferimento approvato indica «✕» (U+2715), che **Sora non
            // contiene**: il comando compariva vuoto, cliccabile e invisibile.
            // Non lo si e' visto da alcun test - un carattere mancante non e'
            // un errore, e' uno spazio.
            //
            // U+00D7 e' lo stesso segno e sta nel carattere approvato. La
            // deviazione e' sul punto di codice, non sulla forma (DEC-139).
            character: "\u{00d7}";
            label: @tr("Chiudi");
            destructive: true;
            activated => {
                root.close();
            }
        }
    }
}

// Intestazione di un gruppo del menu (PR-14, ADR-0130): non si clicca e non
// prende il fuoco, e ha lo stile di «NAVIGAZIONE». Dice in quale momento del
// lavoro stanno le voci che seguono.
component NavigationGroup inherits Text {
    color: Palette.text-muted;
    font-family: Typography.mono;
    font-size: Typography.eyebrow;
    font-weight: Typography.regular;
    letter-spacing: Typography.track-eyebrow;
    vertical-stretch: 0;
}

// Una voce dell'indice di una pagina lunga (UX-EXCELLENCE-02, SIM3-13): porta
// alla sezione, non esegue nulla. Testo azzurro e niente cornice, perche' e' un
// collegamento dentro la pagina e non un comando che cambia qualcosa.
component SettingsJump inherits Rectangle {
    in property <string> label;
    callback activated();

    height: 26px;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: Spacing.radius-row;
    background: touch.has-hover ? Palette.selected : transparent;

    HorizontalLayout {
        padding-left: Spacing.sm;
        padding-right: Spacing.sm;
        Text {
            text: root.label;
            color: Palette.cyan;
            font-size: Typography.body-secondary;
            vertical-alignment: center;
        }
    }

    // Prima del `TouchArea`, come nella voce di menu: l'ultimo elemento riceve
    // per primo il puntatore, e il clic non deve spendersi a spostare il fuoco.
    focus := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                Activity.touched();
                root.activated();
                return accept;
            }
            if (event.text == Key.Tab || event.text == Key.Backtab) {
                FocusRule.navigating = true;
            }
            return reject;
        }
    }

    touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => {
            Activity.touched();
            root.activated();
        }
    }

    Rectangle {
        background: transparent;
        border-width: focus.has-focus ? 2px : 0px;
        border-color: Palette.focus;
        border-radius: Spacing.radius-row;
    }

    accessible-role: button;
    accessible-label: @tr("Vai alla sezione {}", root.label);
    accessible-action-default => {
        if (!StationLock.engaged) { root.activated(); }
    }
}

// Voce del menu — **di solo testo**.
//
// Il sistema grafico approvato prescrive una navigazione senza icone, e i
// sedici segni disegnati in MP-16 sono usciti con essa (DEC-135). La ragione
// per cui erano stati messi resta vera - un'icona accanto alla parola aiuta a
// ritrovare la voce - ma il riferimento approvato la voce la fa ritrovare
// diversamente: con il binario, il riempimento e il peso.
component NavigationItem inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    in property <bool> available: true;
    callback activated();
    // Freccia su o giu': la voce precedente o la successiva del menu (F-15).
    callback step(int);

    // Il fuoco della tastiera arriva qui da chi lo chiede (la freccia di una
    // voce vicina).
    public function take-focus() {
        focus.focus();
    }

    height: Shell.nav-item-height;
    vertical-stretch: 0;

    // Arrotondata **solo a destra**: a sinistra corre il binario, e un angolo
    // tondo davanti a una barra verticale lascia una mezzaluna di fondo che si
    // legge come un difetto di resa.
    border-top-right-radius: Spacing.radius-row;
    border-bottom-right-radius: Spacing.radius-row;

    background: root.active
        ? Palette.selected
        : (touch.has-hover && root.available ? Palette.panel-raised : transparent);

    animate background {
        duration: Motion.quick;
        easing: cubic-bezier(0.2, 0, 0.2, 1);
    }

    // Binario di sinistra, a tutta altezza. Porta due informazioni diverse con
    // due colori diversi: **ciano** dice «questa e' la schermata aperta»,
    // **azzurro** dice «il puntatore e' qui». Non si sovrappongono mai, perche'
    // la voce attiva non cambia stato passandoci sopra.
    Rectangle {
        x: 0;
        y: 0;
        width: Spacing.rail-width;
        height: parent.height;
        background: root.active
            ? Palette.cyan
            : (touch.has-hover && root.available ? Palette.azure : transparent);

        animate background {
            duration: Motion.quick;
            easing: cubic-bezier(0.2, 0, 0.2, 1);
        }
    }

    HorizontalLayout {
        padding-left: Shell.nav-item-pad;
        padding-right: Shell.nav-item-pad;

        Text {
            text: root.label;
            color: root.available
                ? (root.active || touch.has-hover ? Palette.text : Palette.text-muted)
                : Palette.text-disabled;
            font-family: Typography.core;
            font-size: Typography.nav;
            // La voce attiva pesa 500, le altre 300. E' l'unico punto della
            // navigazione in cui il peso porta informazione.
            font-weight: root.active ? Typography.medium : Typography.light;
            vertical-alignment: center;

            animate color {
                duration: Motion.quick;
                easing: cubic-bezier(0.2, 0, 0.2, 1);
            }
        }
    }

    // Il menu si percorre con la tastiera. Senza, l'intera navigazione
    // dell'applicazione richiede un mouse: non e' una comodita' mancante, e'
    // un operatore che non puo' cambiare schermata.
    //
    // Dichiarato PRIMA di `touch`: in Slint l'elemento dichiarato per ultimo
    // sta sopra nell'ordine di sovrapposizione e riceve per primo gli eventi
    // del puntatore. Con il `FocusScope` sopra al `TouchArea` il primo click
    // veniva impegnato per lo spostamento del fuoco e solo un secondo click
    // arrivava al gestore `clicked`: un click su una voce di navigazione
    // restava senza effetto visibile la prima volta.
    focus := FocusScope {
        enabled: root.available;
        // UN SOLO ARRESTO DEL TAB NEL MENU (OPERATOR-E2E-REMEDIATION-01, F-15).
        // Erano trentadue voci, e il Tab le attraversava tutte prima di arrivare
        // al contenuto. Ora il Tab si ferma sulla voce attiva e passa oltre; le
        // frecce scorrono il menu, Invio o Spazio aprono la voce.
        focus-on-tab-navigation: root.active;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                root.activated();
                return accept;
            }
            if (event.text == Key.UpArrow) {
                root.step(-1);
                return accept;
            }
            if (event.text == Key.DownArrow) {
                root.step(1);
                return accept;
            }
            if (event.text == Key.Tab || event.text == Key.Backtab) {
                FocusRule.navigating = true;
            }
            return reject;
        }
    }

    touch := TouchArea {
        enabled: root.available;
        mouse-cursor: root.available ? MouseCursor.pointer : MouseCursor.default;
        clicked => {
            focus.focus();
            root.activated();
        }
    }

    // Anello di fuoco. Serve a chi usa la tastiera per sapere **dove si
    // trova**: senza, il fuoco si sposta invisibile e premere Invio diventa
    // una scommessa. E' distinto dallo stato attivo, che dice un'altra cosa.
    //
    // Segue la forma della riga: **squadrato a sinistra, tondo a destra**. Con
    // il raggio su tutti e quattro gli angoli l'anello tagliava di traverso il
    // bordo sinistro squadrato e lasciava il binario fuori da se', con una
    // fessura di fondo in mezzo - un difetto che si vedeva solo guardando una
    // voce **con il fuoco sopra**, cioe' dopo averla raggiunta con un clic o
    // con il Tab.
    Rectangle {
        background: transparent;
        border-width: focus.has-focus ? 2px : 0px;
        border-color: Palette.focus;
        border-top-right-radius: Spacing.radius-row;
        border-bottom-right-radius: Spacing.radius-row;
    }

    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.available;
    accessible-action-default => {
        if (!StationLock.engaged) { root.activated(); }
    }
}

// «SCOPRI NEXUM» (TOUR-01, ADR-0134).
//
// I dati di un passo del tour, come li prepara `crate::tour`: la schermata da
// aprire (-1 se si resta dove si è), la zona da illuminare (0 la voce del
// menu, 1 la schermata aperta, 2 la voce Scopri NEXUM, 3 la testata con lo
// stato della postazione), i testi. Nessuna
// coordinata: dove sta la zona lo dice il disegno, in `tour-target-rect`.
export struct TourStepRow {
    key: string,
    page: int,
    zone: int,
    title: string,
    body: string,
    note: string,
}

// Una novità del giro «Scopri che cosa è cambiato» (NEWS-01, ADR-0169): il
// testo lo scrive il programma, la schermata è quella del luogo.
export struct NewsRow {
    title: string,
    sentence: string,
    place: string,
    page: int,
}

// Un riquadro sullo schermo, in pixel logici della finestra.
export struct TourRect {
    x: length,
    y: length,
    width: length,
    height: length,
}

// Dove mettere il fumetto: lo calcola `crate::tour::place_callout`.
export struct TourPoint {
    x: length,
    y: length,
}

// La voce «Scopri NEXUM», in fondo alla colonna del menu.
//
// **Non e' una `NavigationItem`** e non apre una schermata: le schermate
// restano trentadue, e la guardia che le conta resta com'e' (ADR-0130). Ha un
// tono piu' quieto delle voci operative perche' non e' un'attivita', e si
// capisce senza icona: le due righe dicono che cosa e'.
component DiscoverEntry inherits Rectangle {
    // «Nuovo»: il tour e' stato proposto e nessuno ha ancora scelto. E' una
    // parola, non un colore.
    in property <bool> fresh: false;
    callback activated();

    public function take-focus() {
        focus.focus();
    }

    height: 52px;
    vertical-stretch: 0;
    border-radius: Spacing.radius-row;
    background: touch.has-hover ? Palette.panel-raised : transparent;

    animate background {
        duration: Motion.quick;
        easing: cubic-bezier(0.2, 0, 0.2, 1);
    }

    HorizontalLayout {
        padding-left: Shell.nav-item-pad;
        padding-right: Shell.nav-item-pad;
        spacing: Spacing.sm;

        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;

            Text {
                text: @tr("Scopri NEXUM");
                color: Palette.text;
                font-family: Typography.core;
                font-size: Typography.nav;
                font-weight: Typography.regular;
            }
            Text {
                text: @tr("Tour guidato");
                color: Palette.text-muted;
                font-size: Typography.group-label;
            }
        }

        if root.fresh: Rectangle {
            horizontal-stretch: 0;
            vertical-stretch: 0;
            y: (parent.height - self.height) / 2;
            height: 20px;
            width: nuovo.preferred-width + 14px;
            border-radius: Spacing.radius-row;
            border-width: Spacing.hairline;
            border-color: Palette.frame-dim;
            background: Palette.panel-raised;

            nuovo := Text {
                text: @tr("Nuovo");
                color: Palette.text;
                font-size: Typography.group-label;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }

    // Come per le voci del menu: il `FocusScope` prima del `TouchArea`, cosi'
    // che il primo clic arrivi al comando invece di spostare soltanto il fuoco.
    focus := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                Activity.touched();
                root.activated();
                return accept;
            }
            if (event.text == Key.Tab || event.text == Key.Backtab) {
                FocusRule.navigating = true;
            }
            return reject;
        }
    }

    touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => {
            Activity.touched();
            focus.focus();
            root.activated();
        }
    }

    Rectangle {
        background: transparent;
        border-width: focus.has-focus ? 2px : 0px;
        border-color: Palette.focus;
        border-radius: Spacing.radius-row;
    }

    accessible-role: button;
    accessible-label: root.fresh ? @tr("Scopri NEXUM, tour guidato delle funzioni principali. Nuovo.") : @tr("Scopri NEXUM, tour guidato delle funzioni principali.");
    accessible-action-default => {
        if (!StationLock.engaged) { root.activated(); }
    }
}

// Un comando del tour: come `HudButton`, ma con il fuoco raggiungibile da chi
// lo contiene. Il tour tiene il fuoco dentro il fumetto, e per farlo deve
// sapere quale comando lo ha e poterlo spostare (ADR-0134 §15).
component TourButton inherits Rectangle {
    in property <string> label;
    in property <bool> primary: false;
    in property <bool> enabled: true;
    out property <bool> has-focus: focus.has-focus;
    callback clicked();

    public function take-focus() {
        focus.focus();
    }

    height: 34px;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    min-width: 96px;
    border-radius: Spacing.radius-row;
    border-width: Spacing.hairline;
    border-color: root.enabled ? Palette.frame-dim : Palette.line-divider;
    background: !root.enabled
        ? Palette.panel
        : (touch.pressed
            ? Palette.selected
            : (root.primary
                ? (touch.has-hover ? Palette.frame : Palette.frame-dim)
                : (touch.has-hover ? Palette.selected : Palette.panel-raised)));

    animate background, border-color {
        duration: Motion.instant;
        easing: ease-out;
    }

    HorizontalLayout {
        padding-left: Spacing.md;
        padding-right: Spacing.md;

        Text {
            text: root.label;
            horizontal-alignment: center;
            vertical-alignment: center;
            font-size: Typography.body;
            font-weight: root.primary ? Typography.medium : Typography.regular;
            color: root.enabled ? Palette.text : Palette.text-disabled;
        }
    }

    // Invio e Spazio premono il comando; ogni altro tasto risale a chi
    // contiene il comando, che decide Tab, frecce ed Esc.
    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                Activity.touched();
                root.clicked();
                return accept;
            }
            if (event.text == Key.Tab || event.text == Key.Backtab) {
                FocusRule.navigating = true;
            }
            return reject;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
        clicked => {
            Activity.touched();
            focus.focus();
            root.clicked();
        }
    }

    Rectangle {
        background: transparent;
        border-width: focus.has-focus ? 2px : 0px;
        border-color: Palette.focus;
        border-radius: Spacing.radius-row;
    }

    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if (root.enabled && !StationLock.engaged) { root.clicked(); }
    }
}

export component AppWindow inherits Window {
    // Porta i due caratteri del prodotto dentro il binario.
    //
    // Non disegna nulla: e' un elemento vuoto, e l'unica ragione per cui esiste
    // e' che in Slint un `.ttf` si incorpora **importandolo da un file
    // `.slint`**, e un file `.slint` si importa per i simboli che esporta.
    //
    // Il modulo lo genera `build.rs`, che ci mette le due righe di `import`
    // solo quando i caratteri sono presenti: cosi' una clonazione pulita
    // compila lo stesso, e il testo cade sulla catena di ripiego dichiarata.
    ProductFonts { }

    in property <string> app-version: "0.1.0";
    in property <string> status-text: "Applicazione pronta";
    // Avviso non bloccante mostrato quando l'archivio persistente non era
    // disponibile all'avvio e i servizi hanno usato un ripiego in memoria
    // (M3B.2). Vuoto = nessun avviso: e' il caso normale. Impostato una sola
    // volta a fine avvio, non un canale per messaggi ripetuti.
    in property <string> storage-fallback-notice: "";
    // Il programma non è partito da un disco della postazione (PORTABLE-01,
    // ADR-0176). Vuoto = partito dal disco: è il caso normale. Lo stabilisce
    // il processo all'avvio, e la fascia non ha un comando per chiuderla.
    in property <string> launch-volume-notice: "";
    // Avviso non bloccante mostrato quando un azzeramento richiesto in
    // precedenza e' stato **eseguito** a questo avvio. Fino al 2026-08-04
    // l'unica traccia era una riga INFO nel registro: l'operatore ritrovava
    // l'archivio vuoto e non aveva modo di sapere perche'. Un'operazione
    // distruttiva differita che si compie in silenzio, magari a un avvio
    // provocato da qualcun altro, e' indistinguibile da una perdita di dati.
    // Rilevato in campo.
    in property <string> archive-reset-notice: "";
    // Avviso mostrato quando un azzeramento e' stato richiesto e **non e'
    // ancora avvenuto**: si compie alla prossima apertura. Fra la richiesta e
    // l'esecuzione non esisteva alcun segno visibile.
    in property <string> archive-reset-pending-notice: "";
    // Avviso mostrato quando un monitoraggio risultava IN CORSO alla
    // riapertura, e nessuno lo aveva fermato: e' stato interrotto (ADR-0064).
    //
    // Non e' rosso come l'azzeramento, perche' non e' successo nulla di
    // distruttivo: e' ambra, perche' c'e' un buco nell'archivio e qualcuno deve
    // decidere che cosa farne. La frase la compone il dominio, in un posto
    // solo: qui si mostra e basta.
    in property <string> monitoring-interruption-notice: "";
    // Che cosa c'e' da decidere, e il nome del comando (ADR-0146): un
    // monitoraggio interrotto non riceve contenuti finche' qualcuno non lo
    // riprende. Frase e nome li compone il dominio.
    in property <string> monitoring-interruption-decision: "";
    in property <string> monitoring-interruption-action: "Ho letto";
    // Presa in carico dell'avviso di interruzione. SPARISCE L'AVVISO, NON IL
    // FATTO: cio' che e' stato visto resta in archivio.
    callback acknowledge-interruption();

    // ------------------------------ Pronto per lavorare (PR-04, ADR-0120)
    //
    // UNA RIGA SOLA all'avvio: «Pronto per lavorare.» oppure «Non ancora: …»
    // con la prima cosa che manca. Le frasi le compone il servizio; qui si
    // mostrano e basta.
    in property <bool> preflight-shown: false;
    in property <bool> preflight-ready: false;
    in property <string> preflight-line: "";
    // Che cosa fare, quando manca qualcosa. Vuota quando si puo' cominciare.
    in property <string> preflight-what-to-do: "";
    // La pagina dove il gesto si compie, e il nome del pulsante. -1 quando il
    // gesto sta fuori dal prodotto: allora c'e' soltanto «Ricontrolla».
    in property <int> preflight-go-page: -1;
    in property <string> preflight-go-label: "";
    // La sezione delle Impostazioni che la frase nomina: 1 lo stato
    // dell'archivio, 2 la copia di sicurezza, 0 nessuna (`settings-jump-section`).
    in property <int> preflight-go-section: 0;
    // La sezione delle Impostazioni a cui portarsi appena la pagina e' disposta.
    // «Apri Impostazioni» apriva la pagina in cima, e la sezione indicata stava
    // una dozzina di sezioni piu' in basso (FULL-OPERATIONAL-VALIDATION-01).
    in-out property <int> settings-jump-section: 0;
    callback preflight-rerun();
    // Attribuzione del prodotto, una sola riga (DEC-120). Compare SOLO nella
    // schermata «Informazioni e licenze», non nelle schermate operative: un
    // credito permanente su ogni vista distrae da uno strumento di lavoro, e
    // il posto dell'attribuzione e' la pagina che la raccoglie insieme alle
    // licenze di terze parti.
    in property <string> attribution: "Ideazione e progettazione: Giuseppe LISI";
    in property <string> product-license: "Apache-2.0";
    in property <[ThirdPartyEntry]> third-party-components: [];
    in property <[GuideEntry]> guide-sections: [];
    in property <[GlossaryRow]> glossary-entries: [];

    // ------------------------------------------------ stato dell'accesso
    // Alimentato dal servizio applicativo: l'interfaccia non decide nulla,
    // mostra. In particolare i flag `can-*` arrivano dal servizio, perche'
    // un comando disabilitato e' una decisione di sicurezza e deve essere
    // coperta da test. Vedere docs/adr/ADR-0010-APPLICATION-SERVICES.md.
    in property <string> auth-headline: "Nessun account configurato";
    // Vero quando l'accesso usa il connettore dimostrativo (F-06): nessuna
    // sessione Telegram, nessun messaggio in arrivo.
    in property <bool> auth-demo: false;
    // L'Esercitazione aperta dalla Guida, in un processo a parte (F-06).
    callback open-exercise();
    in property <string> open-exercise-message: "";
    in property <string> auth-detail: "";
    in property <string> auth-account-label: "";
    in property <string> auth-failure: "";
    in property <bool> auth-busy: false;
    in property <bool> auth-needs-phone: false;
    in property <bool> auth-needs-code: false;
    in property <bool> auth-needs-password: false;
    in property <bool> auth-authenticated: false;
    in property <bool> can-start: true;
    in property <bool> can-submit-phone: false;
    in property <bool> can-submit-code: false;
    in property <bool> can-submit-password: false;
    in property <bool> can-cancel: false;

    // I campi sono svuotati da Rust dopo l'invio: un valore riservato non
    // deve restare nel widget dopo essere stato usato.
    in-out property <string> phone-input: "";
    in-out property <string> code-input: "";
    in-out property <string> password-input: "";

    // ------------------------------------------- gestione multi-account
    // Account, alimentati dal servizio. La GUI non conosce SQLite ne' i
    // segreti: mostra soltanto (ADR-0010, ADR-0019).
    in property <[TelegramAccountEntry]> telegram-accounts: [];
    in property <int> selected-account-id: 0;
    // Se questa installazione ha le credenziali dell'applicazione
    // (APP-CREDENTIALS-01, ADR-0204). Le credenziali non si vedono e non si
    // scrivono qui: arrivano con la distribuzione. Se mancano, una frase
    // rimanda all'amministratore.
    in property <bool> telegram-configured: true;
    // Lo stesso per l'account: il modulo per aggiungerne uno compare quando
    // lo si chiede, non accanto a un account gia' attivo.
    in-out property <bool> adding-account: false;
    // Vero quando e' selezionato un account su cui avviare l'accesso.
    in property <bool> account-selected: false;
    // PIÙ ACCOUNT COLLEGATI INSIEME (MULTI-ACCOUNT-02 parte 3, ADR-0173).
    // Se l'account selezionato ha un collegamento aperto, e se resta collegato
    // anche selezionandone un altro.
    in property <bool> selected-account-linked: false;
    in property <bool> selected-account-kept: false;
    // «Account collegati insieme: 2 su 3.», vuota con uno solo.
    in property <string> linked-accounts-line: "";
    // I monitoraggi senza account che non ricevono, vuota se non ce ne sono.
    in property <string> unbound-monitorings-note: "";
    // Modalita' del connettore: falso = dimostrativa (Mock), predefinita.
    in property <bool> account-mode-live: false;
    // **Se QUESTO binario sa parlare con Telegram.**
    //
    // Viene da Rust, dove la ricava il compilatore dalla feature che carica
    // TDLib. Un pacchetto costruito senza quel componente non puo' collegarsi,
    // e fino al 2026-08-20 l'interfaccia offriva la scelta lo stesso:
    // l'operatore lo scopriva soltanto premendo «Avvia accesso».
    //
    // Un prodotto che offre una funzione che non ha promette una cosa falsa, e
    // dirlo dopo non ripara la promessa: chi ha scelto quella modalita' ha
    // gia' preso una decisione basandosi su di essa.
    in property <bool> telegram-runtime-available: true;
    // Che cosa dire quando manca. Il testo lo compone Rust: dice il FATTO e
    // non la causa tecnica, perche' «manca una feature di compilazione» non e'
    // una frase che un operatore possa usare.
    in property <string> telegram-runtime-missing-reason: "";
    in property <string> telegram-runtime-missing-detail: "";
    // Riscontro delle operazioni di gestione (creazione, salvataggio, selezione).
    in property <string> account-management-message: "";

    // Campo di inserimento dell'etichetta di un nuovo account.
    in-out property <string> account-label-input: "";

    // -------------------------------------------------------- fonti
    in property <[AvailableSourceEntry]> available-sources: [];
    in property <[ConfiguredSourceEntry]> configured-sources: [];
    // CHE COSA STAVAMO GUARDANDO (PR-05, ADR-0121): la frase che ne fissa il
    // senso, uguale nei documenti, e la nota che in Team dice che questa e' la
    // copertura della postazione e non quella dell'ufficio. Vuota fuori dal Team.
    in property <string> coverage-meaning: "";
    in property <string> coverage-scope-note: "";
    // SALUTE DELLE FONTI (HEALTH-01).
    //
    // La frase del riepilogo, gia' composta dal dominio: nomina quante fonti
    // sono operative SU QUANTE, e quante non sono state verificate. Non
    // esiste una percentuale, e non deve esistere.
    in property <string> health-summary: "";
    in property <bool> health-needs-attention: false;
    // Falso senza un account collegato: senza, l'elenco delle chat non si puo'
    // leggere, e un comando inerte va spento invece che mentire.
    in property <bool> can-verify-sources: false;
    callback verify-sources();

    // IL PANNELLO DI DETTAGLIO DI UNA FONTE (HEALTH-02).
    //
    // Si apre su richiesta e per una fonte sola, come la cronologia dello
    // storico: la storia delle verifiche non entra nell'elenco, dove sarebbero
    // venti righe caricate per ogni fonte per mostrarne quelle di una.
    //
    // Lo stato NON viene ricomposto qui: il pannello mostra quello della riga
    // da cui e' stato aperto, perche' la riga e il pannello non devono poter
    // dire due cose diverse della stessa fonte.
    in property <bool> source-health-open: false;
    // Quale fonte il pannello sta mostrando. Serve a ridisegnarlo quando
    // l'elenco si ricompone: dopo una verifica il pannello aperto deve dire i
    // fatti nuovi, non quelli di prima.
    in property <int> source-health-id: -1;
    in property <string> source-health-subject: "";
    // Lo stato, con lo stesso colore della riga.
    in property <string> source-health-state: "";
    in property <bool> source-health-attention: false;
    in property <bool> source-health-unknown: false;
    in property <bool> source-health-stopped: false;
    // Perche' la fonte e' in quello stato: la spiegazione, ricomposta dai
    // fatti osservati.
    in property <string> source-health-why: "";
    // Il silenzio della fonte, detto SEPARATAMENTE: una fonte puo' tacere da
    // mesi ed essere operativa.
    in property <string> source-health-silence: "";
    // La condizione dell'account, DICHIARATA e non fatta valere: dice se una
    // nuova verifica sia possibile adesso, non che cosa fu osservato prima.
    in property <string> source-health-account: "";
    // Che cosa la storia mostra, e che cosa non mostra.
    in property <string> source-health-history-note: "";
    in property <[HealthCheckEntry]> source-health-checks: [];
    callback open-source-health(int);

    // GLI ISCRITTI DI UNA FONTE (MEMBERS-01, ADR-0201): su richiesta, con un
    // motivo ogni volta, se l'amministratore li ha abilitati.
    in property <bool> members-enabled: false;
    in property <bool> members-open: false;
    in property <string> members-title: "";
    in-out property <string> members-reason: "";
    in property <string> members-message: "";
    in property <string> members-summary: "";
    in property <[string]> members-rows: [];
    in property <string> members-history: "";
    callback members-open-for(int, string);
    callback members-request();
    callback members-close();
    // Nelle Impostazioni: la scelta dell'amministratore.
    in property <bool> members-administrator: false;
    in property <string> members-state: "";
    in property <string> members-choice-message: "";
    callback members-enable();
    callback members-disable();
    callback close-source-health();
    // Conteggio reale, alimentato dal servizio: un numero scritto a mano
    // direbbe la stessa cosa il giorno in cui la realta' e' cambiata.
    in property <int> configured-source-count: 0;
    in property <string> sources-message: "";
    in property <bool> sources-enabled: false;
    in-out property <string> source-filter: "";

    // ------------------------------------------------- modalita' operativa
    // Sempre visibile: un operatore deve sapere in quale modalita' sta
    // lavorando PRIMA di scoprirlo da un rifiuto.
    in property <string> operating-mode-label: "Modalità amministratore";
    in property <bool> administrator-mode: true;
    in property <string> operating-mode-description: "";
    in property <string> station-message: "";

    // La parola di sblocco e' svuotata da Rust dopo l'invio: un valore
    // riservato non deve restare nel widget dopo essere stato usato.
    in-out property <string> unlock-input: "";
    // Percorso del file di dizionario da importare, digitato dall'operatore.
    // Il tetto di dimensione si applica in Rust **prima** di leggere il
    // contenuto: leggere e poi verificare lascerebbe scegliere a un file
    // estraneo quanta memoria occupare.
    in-out property <string> dictionary-import-path: "";
    // La fonte dei dizionari e i firmatari ammessi (DICT-NET-01, ADR-0178):
    // si scrivono soltanto in modalità amministratore. Vuoti, non si va in
    // rete. I firmatari sono impronte separate da virgole.
    in-out property <string> dictionary-source: "";
    in-out property <string> dictionary-signers: "";
    in property <string> dictionary-source-note: "";
    // L'esito dell'ultimo scaricamento e il registro dei tentativi, già
    // scritti in Rust.
    in property <string> dictionary-download-message: "";
    in property <string> dictionary-downloads-text: "";

    callback switch-to-operator();
    callback switch-to-administrator();

    // ---------------------------------------------------------- dizionari
    in property <[DictionaryEntry]> dictionaries: [];
    in property <string> dictionaries-message: "";
    in property <int> dictionaries-usable-count: 0;

    // Ricerca e filtri: la selezione e' locale e non interroga nulla.
    in-out property <string> dictionary-filter: "";
    in-out property <bool> only-usable: false;
    in-out property <bool> only-editable: false;
    // Vero quando l'elenco vuoto dipende dalla ricerca e non dalla libreria.
    property <bool> filter-active: root.dictionary-filter != ""
        || root.only-usable
        || root.only-editable;

    // Anteprima del dizionario scelto.
    in property <[TermEntry]> preview-terms: [];
    in property <string> preview-title: "";
    in property <string> preview-note: "";
    // Dizionario di cui si mostra il contenuto. Deve essere leggibile da Rust
    // per sapere su quale bozza agiscono i comandi di modifica.
    in-out property <int> selected-dictionary: -1;

    // ------------------------------------------- wizard nuovo monitoraggio
    // Tutto cio' che segue e' calcolato dal servizio: l'interfaccia mostra il
    // passo corrente e i comandi ammessi, non decide quali siano.
    in property <[WizardStepEntry]> wizard-steps: [];
    in property <string> wizard-title: "";
    in property <string> wizard-prompt: "";
    in property <int> wizard-step: 1;
    in property <bool> wizard-can-advance: false;
    in property <bool> wizard-can-go-back: false;
    in property <string> wizard-blocking-reason: "";
    in property <string> wizard-message: "";
    // DA QUALE MODELLO VENGONO LE SCELTE (F-07, ADR-0142): resta in cima finché la
    // procedura non riparte, e dice che nulla si avvia senza «Avvia monitoraggio».
    in property <string> wizard-template-note: "";

    in property <[WizardSourceEntry]> wizard-sources: [];
    in property <[WizardDictionaryEntry]> wizard-dictionaries: [];
    in property <[WizardTermEntry]> wizard-terms: [];
    in-out property <string> wizard-term-input: "";
    /// Gravità scelta per la parola da aggiungere, come **indice** della voce
    /// selezionata: 0 corrisponde al livello 1. La conversione a livello vive
    /// in Rust, dove è coperta da un test.
    in-out property <int> wizard-term-level-index: 0;

    in property <string> wizard-duration-label: "";
    in property <int> wizard-duration-seconds: 3600;
    in property <bool> wizard-duration-manual: false;
    // LA DURATA PERSONALIZZATA (ADR-0150): ore e minuti, da 1 minuto a 7 giorni.
    in-out property <int> wizard-custom-hours: 2;
    in-out property <int> wizard-custom-minutes: 0;
    in property <string> wizard-duration-message: "";
    in property <bool> wizard-duration-custom: false;
    callback wizard-set-custom-duration(int, int);
    // QUANDO PARTE (SCHEDULE-01, ADR-0171): adesso, o a una data e un'ora
    // locali fra un minuto e sette giorni. Rust converte con il fuso di quel
    // giorno; in Esercitazione la scelta non c'è.
    in-out property <string> wizard-start-date: "";
    in-out property <string> wizard-start-time: "";
    in property <bool> wizard-start-scheduled: false;
    in property <string> wizard-start-label: "Adesso, alla conferma";
    in property <string> wizard-start-message: "";
    callback wizard-set-start-now();
    callback wizard-set-start-at(string, string);

    // Noti solo dal riepilogo in avanti: prima non esistono, e mostrarli come
    // zero significherebbe inventarli.
    in property <bool> wizard-has-preview: false;
    in property <int> wizard-resolved-terms: 0;
    in property <int> wizard-shared-terms: 0;
    in property <string> wizard-digest: "";
    // Le fonti SCELTE, per nome, una per riga (SIM3-14): il riepilogo le nomina.
    in property <string> wizard-chosen-source-names: "";

    // I dizionari SCELTI, con la versione che verra' usata.
    //
    // Distinti da `wizard-dictionaries`, che sono quelli DISPONIBILI: fino al
    // 2026-08-25 il riepilogo confondeva i due e scriveva «dizionari scelti: 7
    // disponibili» contando la libreria invece della scelta. Chi lo leggeva
    // vedeva un numero che non corrispondeva a nulla che avesse fatto.
    in property <[WizardChosenDictionary]> wizard-chosen-dictionaries: [];

    // Quanti ne ha scelti davvero, e quante fonti. Vengono dalla macchina a
    // stati, non dalla lunghezza degli elenchi mostrati.
    in property <int> wizard-chosen-sources: 0;
    in property <int> wizard-chosen-dictionary-count: 0;

    // Che cosa vale la pena sapere, e che NON impedisce di proseguire.
    in property <[WizardNoticeEntry]> wizard-notices: [];

    callback wizard-shown();
    callback wizard-advance();
    callback wizard-back();
    callback wizard-toggle-source(int);
    callback wizard-toggle-dictionary(int);
    callback wizard-add-term();
    callback wizard-remove-term(int);
    callback wizard-set-duration(int, bool);

    // ------------------------------------------------- storico e avvisi
    // Le due schermate mostrano lo stesso archivio: gli avvisi sono lo storico
    // con la soglia sul livello. Due elenchi separati sarebbero due verita', e
    // la seconda invecchierebbe.
    in property <[ContentEntry]> history-entries: [];
    in property <[ContentEntry]> alert-entries: [];
    // La posizione della riga aperta nei due elenchi, -1 se non c'e' (SIM3-19).
    in property <int> history-selected-row: -1;
    in property <int> alert-selected-row: -1;
    // Chiede agli elenchi di riportare in vista la riga aperta (SIM3-19).
    in property <int> history-reveal-request: 0;
    in property <string> history-message: "";
    in property <int> history-total: 0;
    in property <int> history-alerted: 0;
    in property <int> history-pending: 0;
    // Quanti fra i soli contenuti segnalati attendono una decisione. E' il
    // numero della schermata Alert: mostrarvi il totale dello storico
    // direbbe che ci sono piu' avvisi da esaminare di quanti se ne vedono.
    in property <int> alert-pending: 0;

    in-out property <string> history-filter: "";
    in-out property <bool> history-only-pending: false;

    // Sessioni condotte, con quanto ciascuna ha prodotto. La prima voce e'
    // «tutte»: l'indice 0 non e' una sessione.
    in property <[string]> history-sessions: ["Tutte le sessioni"];
    in property <bool> can-export: false;
    in-out property <int> history-session-index: 0;
    // Scelta per **questa** esportazione: non e' una preferenza salvata, e
    // torna spenta a ogni avvio. Rust la legge al momento del comando.
    in-out property <bool> include-author-identifiers: false;

    // Contenuto scelto per la decisione. -1 quando nessuno lo e'.
    in-out property <int> selected-content: -1;
    // SCEGLIERE UNA RIGA CHIEDE SE SIA GIA' SEGNATA (BOOK-01).
    //
    // Chi scrive la proprieta' e' lo Storico; chi sa rispondere e' il modulo
    // dei segnalibri. La domanda passa di qui perche' i due non si conoscono, e
    // perche' senza di essa il comando direbbe lo stato dell'ULTIMA riga
    // guardata: chi lo legge crederebbe di aver perso il segno.
    changed selected-content => {
        root.history-content-chosen(root.selected-content);
    }
    callback history-content-chosen(int);
    in property <string> selected-summary: "";
    in property <string> selected-state: "";
    in property <string> selected-url: "";
    // Vero quando il contenuto scelto ha una storia da aprire: modifiche,
    // cancellazione, o entrambe.
    in property <bool> selected-has-history: false;
    // Vero quando il contenuto scelto e' stato MODIFICATO. Distinto dal
    // precedente perche' l'avvertenza sul livello riguarda solo le modifiche.
    in property <bool> selected-revised: false;
    in-out property <string> review-note: "";

    // Dove finiscono i documenti prodotti: la scelta e' conservata e vale
    // per il rapporto in testo, per la verifica che lo rilegge e come cartella
    // di partenza del pacchetto della schermata Report.
    in-out property <string> export-destination: "";

    callback history-shown();

    // LA CRONOLOGIA DI UN MESSAGGIO.
    //
    // Si apre su richiesta, per un contenuto solo: i corpi delle versioni non
    // entrano nell'elenco, dove sarebbero centinaia di testi caricati per
    // mostrarne uno.
    in property <[ContentVersionEntry]> history-versions: [];
    // La frase che dice che cosa e' successo, e l'avvertenza sul livello.
    in property <string> history-story: "";
    // Il nome della fonte e l'istante, per sapere QUALE messaggio si sta
    // guardando quando il pannello e' aperto.
    in property <string> history-story-subject: "";
    in property <bool> history-story-open: false;
    // Vero quando la cronologia riguarda un messaggio non piu' esposto dalla
    // fonte: il pannello lo dice in testa, non in fondo.
    in property <bool> history-story-deleted: false;
    callback history-open-story(int);
    callback history-close-story();

    // IL PERCORSO DEL RISULTATO, per lo Storico e per gli Alert.
    //
    // Le proprieta' stanno qui e vengono inoltrate alle due schermate, come
    // gia' fa la cronologia: la stessa riga si guarda da due posti, e la
    // risposta alla domanda deve essere la stessa.
    in property <bool> history-why-open: false;
    in property <string> history-why-subject: "";
    in property <string> history-why-origin: "";
    in property <string> history-why-version-warning: "";
    in property <[ProvenanceTermEntry]> history-why-terms: [];
    in property <string> history-why-engine: "";
    in property <bool> history-replay-open: false;
    in property <string> history-replay-historical: "";
    in property <string> history-replay-hypothetical: "";
    in property <string> history-replay-attribution: "";
    in property <bool> history-replay-differs: false;
    callback history-open-replay(int);
    callback history-close-replay();
    // Contenuti che gli somigliano (SIM-01), rispecchiati dalla schermata.
    in property <bool> history-resembling-open: false;
    in property <string> history-resembling-summary: "";
    in property <[ResemblanceRow]> history-resembling-rows: [];
    callback history-open-resembling(int);
    callback history-close-resembling();
    // LA CONVERSAZIONE (ADR-0151, DG-01): una pagina sopra la schermata da
    // cui si parte, aperta con un gesto. Tutto cio' che mostra lo compongono
    // i servizi; qui si dispone soltanto.
    in-out property <bool> conversation-open: false;
    in property <string> conversation-origin: "";
    in property <string> conversation-source-name: "";
    in property <string> conversation-source-line: "";
    in property <string> conversation-author: "";
    in property <string> conversation-published: "";
    in property <string> conversation-acquired: "";
    in property <string> conversation-observed: "";
    in property <int> conversation-content-id: 0;
    in property <string> conversation-message-number: "";
    in property <string> conversation-summary: "";
    in property <string> conversation-anchor: "";
    in property <string> conversation-anchor-now: "";
    in property <string> conversation-anchor-now-when: "";
    in property <string> conversation-comparison-label: "";
    in property <bool> conversation-texts-differ: false;
    in property <[ContextRow]> conversation-older-rows: [];
    in property <[ContextRow]> conversation-newer-rows: [];
    in property <string> conversation-older-state: "";
    in property <string> conversation-newer-state: "";
    in property <bool> conversation-can-load-older: false;
    in property <bool> conversation-can-load-newer: false;
    in property <string> conversation-archived-url: "";
    in property <string> conversation-link-sentence: "";
    in property <string> conversation-link-url: "";
    in property <string> conversation-source-url: "";
    in property <string> conversation-source-sentence: "";
    in property <int> conversation-centre-request: 0;
    in-out property <string> conversation-snapshot-reason: "";
    in property <[SnapshotRow]> conversation-snapshot-rows: [];
    in property <string> conversation-snapshot-message: "";
    // Il contenuto, e il nome della schermata da cui si parte: «Torna a …».
    callback conversation-open-requested(int, string);
    callback conversation-close();
    callback conversation-load-older();
    callback conversation-load-newer();
    callback conversation-request-link(int);
    callback conversation-take-snapshot(string);
    // DALL'AUTORE AL SOGGETTO (GAP-12, ADR-0153): nella conversazione e nel
    // pannello del messaggio scelto. Gli elenchi li compone il Rust dai soli
    // legami fatti da una persona.
    in property <string> conversation-author-identifier: "";
    in property <[AuthorSubjectRow]> conversation-author-subjects: [];
    in property <string> selected-author-identifier: "";
    in property <[AuthorSubjectRow]> selected-author-subjects: [];
    callback author-open-subject(int);
    callback author-link-subject(string);

    // WORKSPACE OPERATIVI (WS-02).
    //
    // L'elenco dei contenitori, quello selezionato, e cio' che ha raccolto.
    // Nessuna di queste proprieta' porta il testo del materiale: un workspace
    // riferisce senza copiare, e le righe si rileggono a ogni apertura invece
    // di essere ricordate.
    in property <[WorkspaceRow]> workspace-rows: [];
    in-out property <int> workspace-selected: 0;
    // SCEGLIERE UN WORKSPACE CHIEDE CHE COSA CI SIA ANNOTATO (NOTE-01).
    //
    // Chi scrive la proprieta' e' la schermata Workspace; chi sa rispondere e'
    // il modulo delle note. La domanda passa di qui perche' i due non si
    // conoscono, e perche' un secondo gestore su `workspace-select`
    // sostituirebbe in silenzio quello che c'e' gia'.
    changed workspace-selected => {
        root.workspace-chosen(root.workspace-selected);
        // Il pacchetto di evidenze (PR-11) ricomincia da capo su un altro
        // workspace: una scelta fatta su uno non vale per l'altro.
        root.evidence-refresh();
    }
    callback workspace-chosen(int);
    // RIFERIMENTI INFORMATICI (PR-14, ADR-0130).
    in property <string> references-message: "";
    in property <int> references-message-area: 0;
    in property <[string]> references-sessions: [];
    in-out property <int> references-session: 0;
    in property <bool> references-stix-ready: false;
    in property <string> references-stix-summary: "";
    in property <[StixPlanRow]> references-stix-plan: [];
    // Lo scambio TAXII (TAXII-01, ADR-0179): si prepara, si vede dove va e
    // quanti osservabili escono, si conferma. La destinazione e la parola
    // d'ordine si scrivono soltanto in modalità amministratore; il campo
    // della parola non si rilegge mai, e Rust lo vuota dopo ogni tentativo.
    in property <bool> references-taxii-ready: false;
    in property <string> references-taxii-summary: "";
    in-out property <string> references-taxii-root: "";
    in-out property <string> references-taxii-collection: "";
    in-out property <string> references-taxii-username: "";
    in-out property <string> references-taxii-password: "";
    in property <string> references-taxii-note: "";
    in property <string> references-taxii-submissions: "";
    in property <[ReferenceSnapshotRow]> references-attack-snapshots: [];
    in property <[ReferenceAssociationRow]> references-attack-associations: [];
    in-out property <string> references-attack-folder: "";
    in-out property <string> references-attack-term: "";
    in-out property <string> references-attack-category: "";
    in-out property <string> references-attack-technique: "";
    in-out property <string> references-attack-motive: "";
    in-out property <string> references-attack-withdraw-motive: "";
    in property <[ReferenceSnapshotRow]> references-cve-snapshots: [];
    in-out property <string> references-cve-folder: "";
    in-out property <string> references-cve-years: "";
    in-out property <string> references-cve-id: "";
    in property <string> references-cve-answer: "";
    in property <[ReferenceSnapshotRow]> references-kev-snapshots: [];
    in-out property <string> references-kev-folder: "";
    in-out property <string> references-kev-id: "";
    in property <string> references-kev-answer: "";
    callback references-shown();
    callback references-stix-preview();
    callback references-stix-export();
    callback references-taxii-preview();
    callback references-taxii-send();
    callback references-taxii-save();
    callback references-attack-import();
    // Le fotografie dalla fonte ufficiale fissata nel programma (SNAP-NET-01,
    // ADR-0186): su comando, accanto all'importazione da cartella.
    callback references-attack-download();
    callback references-cve-download();
    callback references-kev-download();
    callback references-attack-lookup();
    callback references-attack-declare();
    // La scheda della tecnica, con mitigazioni e rilevazioni (ATTACK-03).
    callback references-attack-show();
    callback references-attack-withdraw(int);
    callback references-cve-import();
    callback references-cve-resolve();
    callback references-kev-import();
    callback references-kev-resolve();
    // PASSAGGIO DI CONSEGNE (PR-12, ADR-0128).
    in-out property <int> handover-span: 0;
    in property <string> handover-text: "";
    in property <string> handover-message: "";
    callback handover-compose();
    callback handover-export(int);
    // Dopo un'esportazione riuscita: «Apri la cartella» (SIM3-03, ADR-0137).
    in property <bool> handover-folder-ready: false;
    callback handover-open-folder();
    // PACCHETTO DI EVIDENZE (PR-11, ADR-0127).
    in property <[EvidenceChoice]> evidence-choices: [];
    in property <string> evidence-preview: "";
    in-out property <string> evidence-reason: "";
    // Se gli allegati conservati escono nel pacchetto (ATTACH-01): per difetto no.
    in-out property <bool> evidence-with-attachments: false;
    in property <string> evidence-message: "";
    // Se in questa sessione è stato prodotto un pacchetto di evidenze: la
    // sua copia cifrata per chi riceve (ENCRYPT-02).
    in property <bool> evidence-produced: false;
    in property <[EvidencePackageRow]> evidence-packages: [];
    callback evidence-refresh();
    callback evidence-toggle(int);
    callback evidence-produce();
    in property <string> workspace-selected-name: "";
    // Vero quando il selezionato e' ancora in lavorazione. Su uno chiuso i
    // comandi che scrivono non compaiono: l'archivio li rifiuterebbe, e un
    // comando che fallisce sempre insegna che il programma non funziona.
    in property <bool> workspace-selected-open: false;
    in property <[WorkspaceEntryRow]> workspace-entries: [];
    in property <string> workspace-message: "";
    in-out property <string> workspace-new-name: "";
    in-out property <string> workspace-new-description: "";
    callback workspaces-shown();
    callback workspace-open(string, string);
    callback workspace-close(int);
    callback workspace-select(int);
    callback workspace-remove(string, int);
    // Raccogliere avviene DOVE IL MATERIALE E', cioe' nello Storico: chiedere
    // di trascrivere un identificativo sarebbe chiedere a una persona il lavoro
    // che il programma dovrebbe fare.
    callback history-collect-in-workspace(int);

    // SEGNALIBRI E RACCOLTE (BOOK-01).
    //
    // Nessuna di queste proprieta' porta il testo del materiale: un segnalibro
    // riferisce senza copiare, e le righe si rileggono a ogni apertura invece
    // di essere ricordate. Nessuna porta parole dell'operatore: quelle sono
    // NOTE-01, e due posti in cui scriverle divergono.
    in property <[BookmarkRow]> bookmark-rows: [];
    in property <[BookmarkCollectionRow]> bookmark-collections: [];
    // Quale raccolta si sta guardando; 0 significa TUTTI i segnalibri, sciolti
    // compresi. Non e' un filtro salvato: e' che cosa si guarda adesso.
    in-out property <int> bookmark-collection-selected: 0;
    in property <string> bookmark-message: "";
    in-out property <string> bookmark-new-collection-name: "";
    // Il segnalibro su cui si sta scegliendo una raccolta; 0 quando nessuno.
    in-out property <int> bookmark-filing: 0;
    callback bookmarks-shown();
    callback bookmark-create-collection(string);
    callback bookmark-delete-collection(int);
    callback bookmark-remove(int);
    // Sposta un segnalibro in una raccolta; 0 lo lascia sciolto.
    callback bookmark-file-into(int, int);
    callback bookmark-choose-collection(int);
    // SEGNARE AVVIENE DOVE IL MATERIALE E', cioe' nello Storico. A differenza
    // del workspace non chiede prima di scegliere dove: un segnalibro che costa
    // una scelta non lo mette nessuno.
    callback history-toggle-bookmark(int);
    // Vero quando il contenuto aperto nello Storico e' gia' segnato.
    in property <bool> history-content-marked: false;

    // NOTE DELL'OPERATORE (NOTE-01).
    //
    // Si scrivono DOVE IL MATERIALE E': sul contenuto scelto nello Storico, e
    // dentro un workspace. La schermata Note serve a RILEGGERLE tutte insieme —
    // non a scriverle, perche' li' bisognerebbe trascrivere un identificativo.
    //
    // Nessuna di queste proprieta' tocca la prova: una nota vive in una tabella
    // sua, e il percorso che la scrive non sa raggiungere il contenuto.
    in property <[NoteRow]> history-content-notes: [];
    in-out property <string> history-note-draft: "";
    in property <string> history-note-message: "";
    callback history-write-note(string);

    in property <[NoteRow]> workspace-notes: [];
    in-out property <string> workspace-note-draft: "";
    in property <string> workspace-note-message: "";
    callback workspace-write-note(string);

    // MODELLI DI MONITORAGGIO (TEMPLATE-01).
    //
    // UN MODELLO PROPONE, NON APPLICA. La soglia di notifica e la conservazione
    // sono impostazioni DELLA POSTAZIONE: cambiarle tocca anche i monitoraggi
    // gia' conclusi, e la conservazione, abbassata, CANCELLA.
    //
    // Percio' applicare un modello mostra che cosa prepara e che cosa
    // differisce, e non scrive niente.
    in property <[TemplateRow]> template-rows: [];
    in property <string> template-message: "";
    // La preparazione del modello scelto: vuota finche' non se ne applica uno.
    in property <bool> template-preparation-open: false;
    in property <string> template-preparation-name: "";
    in property <[TemplateSourceRow]> template-preparation-sources: [];
    // Le due frasi di confronto, gia' composte dal dominio (DEC-252).
    in property <string> template-notification-sentence: "";
    in property <string> template-retention-sentence: "";
    // Vero quando adottare cio' che il modello prevede CANCELLEREBBE materiale.
    // E' l'unica differenza che, adottata senza leggerla, distrugge qualcosa.
    in property <bool> template-would-delete: false;
    callback templates-shown();
    callback apply-template(int);
    callback delete-template(int);
    callback close-template-preparation();

    // IL MODULO DI UN MODELLO NUOVO (OPERATOR-E2E-REMEDIATION-01, F-07).
    //
    // La schermata diceva «Nessun modello è stato creato» e non offriva un modo
    // di crearne uno. Ora «Nuovo modello» apre questo modulo; «Usa come base»
    // lo apre compilato con le scelte di un modello che c'è già, perché un
    // modello non si modifica: se ne crea un altro.
    in property <bool> template-form-open: false;
    in-out property <string> template-form-name: "";
    in-out property <string> template-form-description: "";
    in property <[TemplateChoice]> template-form-sources: [];
    in property <[TemplateChoice]> template-form-dictionaries: [];
    in-out property <int> template-form-threshold-index: 0;
    in-out property <int> template-form-retention-index: 0;
    in property <string> template-form-message: "";
    // I dizionari del modello, risolti adesso: la versione che oggi si userebbe,
    // oppure la dichiarazione che non si possono preparare.
    in property <[TemplateSourceRow]> template-preparation-dictionaries: [];
    in property <int> template-preparation-id: 0;
    // CANCELLARE CHIEDE CONFERMA: il modello di cui si chiede, zero se nessuno.
    in-out property <int> template-delete-armed: 0;
    callback template-form-new();
    callback template-form-from(int);
    callback template-form-toggle-source(int);
    callback template-form-toggle-dictionary(int);
    callback template-form-save();
    callback template-form-cancel();
    // Svuota la procedura guidata e la compila con le scelte del modello. NON
    // avvia nulla: il monitoraggio parte con «Avvia monitoraggio» all'ultimo
    // passo, dopo che chi lo prepara ha rivisto ogni scelta.
    callback template-prepare-monitoring(int);

    // RICERCHE SALVATE (SEARCH-01).
    //
    // Si salvano dove si cerca — nello Storico — e si rifanno da qui. Rifare
    // applica il filtro allo Storico e ci porta: una sola lista di risultati,
    // perche' una seconda lista sarebbe una seconda nozione di ricerca.
    in property <[SavedSearchRow]> saved-search-rows: [];
    in property <string> saved-search-message: "";
    in-out property <string> history-save-search-name: "";
    // Che cosa e' cambiato dall'ultimo salvataggio, e se le due esecuzioni sono
    // confrontabili. Vivono qui e si mostrano nello Storico, dove i risultati
    // sono.
    in property <string> history-search-drift: "";
    in property <bool> history-search-comparable: true;
    callback searches-shown();
    callback history-save-search(string);
    callback run-saved-search(int);
    callback delete-saved-search(int);

    in property <[NoteRow]> note-rows: [];
    in property <string> note-message: "";
    callback notes-shown();
    // Ritirare e' lo STESSO atto ovunque lo si faccia, e ha un solo comando:
    // una nota si ritira per identificativo, e chi la ritira non deve sapere
    // da quale schermata la sta guardando.
    callback withdraw-note(int);

    in property <string> history-link-sentence: "";
    in property <string> history-link-url: "";
    callback history-request-link(int);
    // L'ACCOUNT D'UFFICIO SECONDO TELEGRAM (ADR-0153): l'ultima lettura, in una
    // frase composta dal servizio, e il comando che ne chiede un'altra.
    in property <string> office-account-sentence: "Nessuna lettura registrata: si chiede a Telegram con il comando qui sotto.";
    callback office-account-read();
    in property <string> history-why-scoring: "";
    in property <bool> history-why-scoring-trustworthy: false;
    in property <string> history-why-alert: "";
    in property <[ProvenanceDecisionEntry]> history-why-decisions: [];
    callback history-open-why(int);
    callback history-close-why();
    callback filter-history();
    callback choose-session(int);
    callback export-session();
    callback choose-export-destination();
    callback verify-exports();
    callback select-content(int);
    // Lo stato arriva come testo perche' l'elenco degli stati vive nel dominio:
    // ripeterne le varianti qui vorrebbe dire tenerle allineate a mano.
    callback record-review(string);
    // Apertura sicura di un URL (ADR-0018): usata dallo storico e dal centro
    // notifiche. La validazione e l'audit stanno nei servizi.
    callback open-url(string);

    // ------------------------------------------------- monitoraggio
    // Tutto cio' che segue e' calcolato dal servizio: l'interfaccia mostra lo
    // stato e i comandi ammessi, non decide quali lo siano.
    in property <bool> monitoring-present: false;
    // Un monitoraggio sta **acquisendo adesso**. Non e' `monitoring-present`,
    // che dice soltanto che una sessione esiste: una sessione arrestata esiste
    // e non acquisisce nulla. E' la stessa condizione che tiene sveglia la
    // postazione, e viene dallo stesso punto (`monitoring::refresh`) perche'
    // due definizioni di «in corso» prima o poi divergono, e allora il marchio
    // pulserebbe mentre la postazione si addormenta.
    in property <bool> monitoring-active: false;
    // TUTTI I MONITORAGGI CHE RICEVONO HANNO L'ACQUISIZIONE IN PAUSA
    // (COLLAUDO-FIX-01, CU01-004, DEC-509). Nell'archivio restano «in corso»,
    // ma non acquisiscono: il marchio non pulsa, il radar si ferma e dice
    // «IN PAUSA». La scrive `wakefulness::follow_pause`, dagli stessi punti di
    // `monitoring-active`.
    in property <bool> acquisition-paused: false;
    // SE QUESTA POSTAZIONE STA DAVVERO ACQUISENDO (OPERATOR-E2E-REMEDIATION-01,
    // F-04). Un monitoraggio «in corso» nell'archivio non basta: dopo un riavvio
    // la riga resta in corso (ADR-0064), e finche' l'account d'ufficio non e'
    // collegato nessun messaggio arriva. Il radar, la didascalia e lo stato di
    // salute dicevano «in corso» e «Operativo» lo stesso. In Esercitazione nulla
    // acquisisce per costruzione (ADR-0129).
    property <bool> station-acquiring: root.auth-authenticated && !root.exercise-mode;
    // Il monitoraggio mostrato e' in corso nell'archivio, e la postazione non acquisisce.
    property <bool> monitoring-shown-acquiring-gap: (root.monitoring-state-code == 1
            || root.monitoring-state-code == 2)
        && !root.station-acquiring;
    // Perche' non acquisisce, detto a chi guarda.
    property <string> not-acquiring-reason: root.exercise-mode
        ? "Esercitazione: dati di prova, nessuna acquisizione da Telegram."
        : "Questa postazione non sta acquisendo: l'account d'ufficio non è collegato. Da Account si collega, e da quel momento il monitoraggio riceve di nuovo i messaggi nuovi.";
    // Lo stato del monitoraggio MOSTRATO (SIM3-15): 0 pianificato, 1 in corso, 2 in
    // corso con gli avvisi sospesi, 3 concluso o arrestato.
    in property <int> monitoring-state-code: 0;
    // CHE COSA HA GUARDATO il monitoraggio scelto, fonte per fonte (PR-05), e
    // in una frase il programma e il collegamento sulla sua finestra.
    in property <[CoperturaFonte]> monitoring-coverage: [];
    in property <string> monitoring-coverage-overall: "";
    // L'elenco dei monitoraggi, dal piu' recente.
    //
    // Compare SOLO quando sono piu' d'uno: con un monitoraggio solo sarebbe un
    // elenco di una riga, cioe' un ingombro che non aiuta nessuno (ADR-0065).
    in property <[MonitoringRow]> monitoring-list: [];
    // Scelta di quale monitoraggio la schermata mostri, per posizione
    // nell'elenco. La schermata non decide: chiede, e il servizio risponde.
    callback select-monitoring(int);
    in property <string> monitoring-label: "";
    in property <string> monitoring-state: "";
    in property <string> monitoring-health: "";
    in property <bool> monitoring-health-attention: false;
    in property <string> monitoring-started-by: "";
    in property <string> monitoring-created: "";
    in property <string> monitoring-started: "";
    in property <string> monitoring-ended: "";
    in property <string> monitoring-duration: "";
    // Avvio + durata, per un monitoraggio a tempo avviato (ADR-0150).
    in property <string> monitoring-planned-end: "";
    // L'inizio programmato, l'avvio mancato con la ragione, o l'annullamento
    // (SCHEDULE-01, ADR-0171): una frase composta in Rust, vuota se il
    // monitoraggio non è stato programmato.
    in property <string> monitoring-schedule: "";
    // LA PAUSA VERA DELL'ACQUISIZIONE (PAUSE-01, ADR-0172): distinta dalla
    // sospensione degli avvisi. I comandi ammessi li decide il servizio; la
    // frase dice la pausa aperta o l'ultima chiusa.
    in property <bool> monitoring-can-pause-acquisition: false;
    in property <bool> monitoring-can-resume-acquisition: false;
    in property <string> monitoring-pause: "";
    in-out property <string> monitoring-pause-reason: "";
    // IL MOTIVO SI CONTROLLA MENTRE SI SCRIVE (COLLAUDO-FIX-01, CU01-005 e
    // UX-07): con la regola del dominio, letta dal Rust e non riscritta qui. Il
    // pulsante resta spento finché il motivo non basta, e la frase accanto al
    // campo dice quanti caratteri mancano. Senza gestore la risposta è «no»:
    // un comando che non si sa controllare non si accende.
    pure callback monitoring-pause-reason-ok(string) -> bool;
    pure callback monitoring-pause-reason-hint(string) -> string;
    // L'esito dell'ultimo comando della pausa, accanto ai comandi: il riquadro
    // in cima alla schermata, a pagina scorsa, non si vede (CU01-005).
    in property <string> monitoring-pause-outcome: "";
    callback monitoring-pause-acquisition(string);
    callback monitoring-resume-acquisition();
    in property <string> monitoring-checkpoint: "";
    in property <int> monitoring-source-count: 0;
    in property <int> monitoring-contents: 0;
    in property <int> monitoring-alerts: 0;
    in property <int> monitoring-pending: 0;
    in property <int> monitoring-inbox-pending: 0;
    in property <int> monitoring-inbox-failed: 0;
    in property <string> monitoring-message: "";
    // I comandi ammessi arrivano dal servizio: un pulsante disabilitato e' una
    // decisione di sicurezza, non un dettaglio grafico.
    in property <bool> monitoring-can-start: false;
    in property <bool> monitoring-can-suspend: false;
    in property <bool> monitoring-can-resume: false;
    in property <bool> monitoring-can-stop: false;

    // ---------------------------------- recupero della cronologia
    //
    // Due atti distinti e due comandi distinti: **guardare** dice quanti
    // messaggi mancano senza scrivere nulla, **confermare** e' cio' che
    // archivia. Un solo pulsante avrebbe fatto archiviare a chi voleva solo
    // sapere.
    in property <string> recovery-message: "";
    // Vero quando una ricognizione ha trovato qualcosa e attende la conferma.
    // Finche' e' falso il comando di conferma non esiste, perche' non c'e'
    // nulla che si sappia di dover archiviare.
    in property <bool> recovery-awaiting-confirmation: false;
    in property <bool> recovery-busy: false;

    // Ricerca retroattiva: guarda piu' indietro dell'inizio del monitoraggio e
    // **non archivia**. Per questo non ha un comando di conferma: non c'e' nulla
    // da confermare, perche' nulla verra' scritto.
    in property <string> retro-message: "";
    in property <bool> retro-busy: false;
    in property <[RetroMatchEntry]> retro-matches: [];

    callback start-retro-search();
    callback stop-retro-search();

    callback survey-recovery();
    callback confirm-recovery();
    callback discard-recovery();

    // Recupero dei periodi decisi (PR-07, ADR-0123): gli stessi due atti,
    // per UNA fonte e UN intervallo che una persona ha deciso di valutare.
    in property <[IntervalRow]> interval-rows: [];
    in property <string> interval-message: "";
    in property <bool> interval-awaiting-confirmation: false;
    in property <bool> interval-busy: false;
    callback interval-survey(string);
    callback interval-confirm();
    callback interval-discard();

    // Ricerca puntuale (PR-09, ADR-0125): un ingresso per volta, una ragione
    // scritta, una richiesta; l'esito fra cinque, e il registro.
    in-out property <int> resolver-kind: 0;
    in-out property <string> resolver-input: "";
    in-out property <string> resolver-reason: "";
    in property <string> resolver-message: "";
    in property <bool> resolver-has-outcome: false;
    in property <string> resolver-outcome-label: "";
    in property <string> resolver-outcome-sentence: "";
    in property <string> resolver-outcome-todo: "";
    in property <[ResolutionRow]> resolver-rows: [];
    callback resolver-ask();
    callback resolver-shown();
    // Il collegamento di un «Trovato» a un soggetto (PR-10, ADR-0126): lo
    // decide una persona, scegliendo il soggetto e scrivendo il motivo.
    in-out property <int> resolver-linking: -1;
    in property <[string]> resolver-subjects: [];
    in-out property <int> resolver-subject-index: 0;
    in-out property <string> resolver-link-reason: "";
    in property <string> resolver-link-message: "";
    callback resolver-link-start(int);
    callback resolver-link-confirm();
    callback resolver-link-cancel();

    // Storico precedente all'avvio (PR-08, ADR-0124): una ragione scritta,
    // una durata fra tre, una pagina alla volta, poi la conferma.
    in property <[PriorHistoryRow]> prior-history-rows: [];
    in property <string> prior-history-message: "";
    in-out property <string> prior-history-reason: "";
    in-out property <int> prior-history-span: 0;
    in property <bool> prior-history-busy: false;
    in property <bool> prior-history-awaiting-confirmation: false;
    callback prior-history-start(string);
    callback prior-history-confirm();
    callback prior-history-stop();

    callback monitoring-shown();
    // L'azione arriva come testo perche' l'elenco delle azioni vive nel dominio.
    callback monitoring-action(string);
    callback start-monitoring();

    // ---------------------------------------------- impostazioni
    // Le opzioni di riservatezza arrivano da Rust (lisi-core), dove vivono le
    // etichette: ripeterle qui vorrebbe dire tenerle allineate a mano. L'indice
    // scelto corrisponde all'ordine di NotificationPrivacy::all().
    in property <[string]> settings-privacy-options: [];
    in-out property <int> settings-privacy-index: 1;
    in-out property <int> settings-min-level: 1;
    in-out property <int> settings-max: 50;
    in-out property <bool> settings-include-url: false;

    // Avvisi sui gruppi di segnali. Spenti per difetto: vedere la migrazione
    // 0020 e DEC-236.
    in-out property <bool> settings-cyber-enabled: false;
    in-out property <int> settings-cyber-contents: 3;
    in-out property <int> settings-cyber-sources: 2;
    in property <string> settings-message: "";

    // ORGANIZZAZIONI SORVEGLIATE
    //
    // La regola che permette a un settore di comparire su un contenuto: un
    // contenuto ricade in un settore perche' un amministratore ha dichiarato che
    // quella organizzazione appartiene a quel settore, e il contenuto la nomina.
    in property <[WatchedOrganisationEntry]> organisations: [];
    in property <[string]> organisation-sectors: [];
    in property <bool> organisations-writable: false;
    in property <string> organisations-message: "";
    in-out property <string> organisation-name-input: "";
    in-out property <string> organisation-aliases-input: "";
    in-out property <string> organisation-domains-input: "";
    in-out property <int> organisation-sector-index: 0;
    callback organisations-shown();
    callback organisation-declare();
    callback organisation-toggle(int, bool);
    // Togliere un'organizzazione chiede il motivo (FINAL-REVIEW-01, FR-048):
    // `organisation-removing` è l'identificativo della riga che sta chiedendo
    // il motivo, zero quando nessuna.
    in-out property <int> organisation-removing: 0;
    in-out property <string> organisation-remove-reason: "";
    callback organisation-remove(int, string);

    // Avvio automatico. Lo stato lo detiene il registro di Windows, non
    // l'archivio: queste tre proprieta' sono il riflesso di cio' che il
    // registro dice, riletto dopo ogni comando.
    //
    // `registered` ed `effective` sono separate perche' una voce che punta a
    // un'altra copia del programma e' registrata e **non** funzionante, e un
    // solo booleano direbbe «attivo» a chi non partira'.
    in property <bool> autostart-registered: false;
    in property <bool> autostart-effective: false;
    in property <string> autostart-message: "";

    // ----------------------------- che cosa Windows dice degli avvisi
    //
    // `Show` riesce anche quando Windows ha deciso di non mostrare nulla, e
    // nessun errore lo segnala. Windows pero' lo DICHIARA, e fino al
    // 2026-08-21 nessuno glielo chiedeva.
    //
    // Il colore si vede a colpo d'occhio, il messaggio dice che cosa fare.
    // ------------------------------------------ movimento e accessibilita'
    //
    // Il movimento del prodotto e' deliberato: il radar che ruota dice a colpo
    // d'occhio se il monitoraggio gira (ADR-0026). Per una parte delle persone
    // pero' il movimento non e' un'informazione, e' un sintomo.
    //
    // Tre scelte e non un interruttore: «come Windows» NON e' riducibile ne' a
    // «pieno» ne' a «ridotto». Se qualcuno sposta la preferenza di Windows
    // domani, chi ha scelto «come Windows» deve vederlo cambiare e chi ha
    // scelto «pieno» no.
    in property <[string]> motion-options: [];
    in-out property <int> motion-index: 0;
    in property <string> motion-consequence: "";
    in property <string> motion-system-message: "";
    callback motion-chosen(int);

    // ---------------------------------------- la lingua dell'interfaccia
    //
    // I18N-01, ADR-0197: la lingua si sceglie per postazione. Le scritte
    // dell'interfaccia cambiano subito; i testi già composti dal Rust alla
    // prossima apertura della schermata.
    in property <[string]> language-options: [];
    in-out property <int> language-index: 0;
    in property <string> language-consequence: "";
    callback language-chosen(int);

    // ---------------------------------------- idoneita' della postazione
    //
    // Un amministratore che installa il prodotto su una postazione nuova deve
    // poter leggere IN UNA SCHERMATA che cosa funziona e che cosa no, senza
    // aprire un registro ne' interpretare un errore (ADR-0039).
    in property <[CapabilityRow]> station-capabilities: [];
    in property <string> station-verdict: "";
    in property <bool> station-fit: true;

    // ------------------------------------------ centro diagnostico (DIAG-01)
    //
    // Le tredici aree del congelamento, in un posto solo. Le risposte c'erano
    // gia', sparse fra quattro schermate: un operatore a cui il monitoraggio
    // ha smesso di registrare non sa da quale angolo cominciare, e chi lo
    // assiste al telefono nemmeno.
    //
    // La fotografia si prende all'ingresso nella schermata e a richiesta, non
    // di continuo: e' una lettura, e ripeterla da sola darebbe l'impressione
    // di un controllo che sta accadendo mentre nessuno guarda.
    in property <[DiagnosticRow]> diagnostics: [];
    // "11/13 aree misurate, 1 da guardare, 2 non misurabili su questa
    // postazione." Non dice mai «tutto in ordine» se qualcosa non e' stato
    // guardato.
    in property <string> diagnostics-summary: "";
    // Quando la fotografia e' stata presa. Uno stato senza il proprio istante
    // e' uno stato di cui non si sa se valga ancora.
    in property <string> diagnostics-taken-at: "";
    in property <bool> diagnostics-attention: false;
    // Esito dell'esportazione, o l'avvertenza che la precede. Vuoto finche'
    // nessuno ha premuto: un riscontro che compare da solo direbbe che
    // qualcosa e' successo mentre nessuno guardava.
    in property <string> diagnostics-export-message: "";
    callback refresh-diagnostics();
    callback diagnostics-shown();
    callback export-diagnostics();

    // -------------------------------------------- coda di lavoro (WQ-01)
    //
    // Che cosa aspetta una persona, attraverso TUTTE le sessioni: il lavoro
    // non fatto in una sessione chiusa e' esattamente quello che si dimentica,
    // e l'elenco degli alert e' di una sessione sola.
    in property <[QueueRow]> work-queue: [];
    // "27 contenuti in attesa, 4 mai esaminati, 2 gia' in esame."
    in property <string> work-queue-summary: "";
    in property <string> work-queue-composed-at: "";
    callback work-queue-shown();
    callback refresh-work-queue();
    // Apre il messaggio di una voce della coda negli Avvisi, con il pannello
    // della decisione (OPERATOR-UX-REMEDIATION-01, OS-10). Lo collega `history.rs`.
    callback work-queue-open(int);

    // ------------------ Periodi non coperti prioritari (PR-06, ADR-0122)
    //
    // UNA PRIORITA' NON E' UN FATTO. Le voci ordinano i periodi in cui non si
    // guardava, in base al ritmo storico della fonte, perche' una persona
    // decida dove valutare un recupero. Non dicono che nel periodo la fonte
    // abbia pubblicato qualcosa, e ogni riga lo ripete.
    in property <[GapRow]> gap-rows: [];
    // Quanti periodi di priorita' bassa non sono elencati, e quali fonti non
    // hanno un ritmo osservabile.
    in property <string> gap-summary: "";
    in property <string> gap-message: "";
    // Il motivo della decisione, scritto da chi decide. Senza, i comandi non
    // si premono.
    in-out property <string> gap-reason: "";
    // La chiave del periodo e la decisione. Il Rust ricompone i periodi e
    // decide soltanto su quello che trova: una chiave vecchia non decide nulla.
    callback gap-decide(string, string);

    // ------------------------------------------ cruscotto operativo (DASH-01)
    //
    // Le undici domande del congelamento, gia' composte dai servizi che le
    // sanno comporre: il cruscotto le mette in fila, non le ricompone
    // (DEC-252). Due schermate che derivassero lo stesso stato direbbero cose
    // diverse nello stesso istante, sulla schermata che esiste per orientare.
    in property <[DashboardRow]> dashboard-answers: [];
    in property <string> dashboard-summary: "";
    // Quante chiedono un gesto. Non e' un punteggio: e' un conteggio di righe
    // su cui qualcuno deve alzarsi.
    in property <int> dashboard-attention: 0;
    callback dashboard-shown();

    // ------------------------------------ Segnali emergenti (TREND-01)
    //
    // Che cosa compare nel periodo recente piu' che nel periodo di confronto.
    //
    // # Non e' una tendenza, e la frase lo dice
    //
    // Due finestre non sono una serie: dicono che cosa e' cambiato fra due
    // periodi, non che cosa stia crescendo. La schermata RICEVE la frase gia'
    // composta (DEC-252, sesta superficie) e non la ricompone.
    //
    // # Nessun punteggio
    //
    // Ogni riga porta i DUE conteggi. Un numero solo si leggerebbe come una
    // misura dell'emergenza, e non esiste una misura dell'emergenza.
    in property <int> trend-count: 0;
    in property <bool> trend-open: false;
    in property <string> trend-summary: "";
    in property <[TrendRow]> trend-rows: [];
    callback open-trend();
    callback close-trend();

    // ---------------------------- Aumenti oltre la soglia (SPIKE-01)
    //
    // Sta nello stesso pannello dei segnali emergenti, in una sezione propria,
    // perche' risponde a una domanda DIVERSA sugli stessi fatti: non «che cosa
    // compare piu' di prima», ma «che cosa supera la soglia dichiarata».
    //
    // # Perche' i due numeri non si sommano nella riga del cruscotto
    //
    // Perche' vengono da due metodi diversi. Una cifra sola che li mettesse
    // insieme non sarebbe la risposta di nessuno dei due, e nessuno saprebbe
    // dire come e' stata calcolata. La riga «Segnali emergenti» resta la
    // risposta del confronto fra periodi; gli aumenti oltre soglia si leggono
    // qui, con il proprio metodo scritto accanto.
    //
    // # Nessuna parola attribuisce un'intenzione
    //
    // «Aumento delle occorrenze», mai «attacco». Il salto fra un conteggio che
    // cresce e una parola che dice «attacco» e' l'attribuzione automatica di
    // responsabilita' che il confine della decisione umana vieta.
    in property <int> spike-count: 0;
    in property <string> spike-summary: "";
    in property <[TrendRow]> spike-rows: [];

    // ------------------------------------------------ Rule Lab (LAB-02)
    //
    // Che cosa cambierebbe pubblicando la bozza di un dizionario, misurato su
    // contenuti gia' archiviati.
    //
    // # Il confronto non scrive nulla, e non per convenzione
    //
    // Il modulo che lo calcola NON CONOSCE L'ARCHIVIO: non puo' scrivere un
    // risultato operativo perche' non ha con che cosa (LAB-01, DEC-258).
    // Questa schermata gli passa contenuti gia' letti e ne mostra l'esito.
    in property <[string]> lab-dictionaries: [];
    in-out property <int> lab-dictionary-index: 0;
    in property <[string]> lab-sessions: [];
    in-out property <int> lab-session-index: 0;
    // Che cosa si sta per confrontare, detto PRIMA di premere: quale versione
    // pubblicata, quale bozza, su quanti contenuti.
    in property <string> lab-preview: "";
    // Falso quando manca una delle due versioni, o la sessione non ha
    // contenuti: il comando si spegne invece di produrre un esito vuoto che
    // sembrerebbe «nessuna differenza».
    in property <bool> lab-can-run: false;
    in property <string> lab-summary: "";
    in property <[LabRow]> lab-findings: [];
    // CHE COSA LA BOZZA CAMBIA NEL DIZIONARIO (F-07): si legge appena si
    // sceglie la bozza, senza bisogno di contenuti archiviati.
    in property <bool> lab-has-candidates: false;
    in property <string> lab-term-summary: "";
    in property <[LabTermRow]> lab-term-rows: [];
    // Il dizionario della bozza scelta, per «Torna alla bozza».
    in property <int> lab-draft-dictionary: 0;
    // Il dizionario che Dizionari chiede di aprire nel Laboratorio («Prova nel
    // Laboratorio»); zero quando nessuno lo chiede.
    in-out property <int> lab-requested-dictionary: 0;
    callback lab-shown();
    callback lab-dictionary-chosen(int);
    callback lab-session-chosen(int);
    callback run-lab();

    // ------------------------------ Riscontro sui dizionari (FEEDBACK-01)
    //
    // Che cosa la revisione umana dice delle regole con cui i contenuti della
    // sessione furono trovati.
    //
    // # NEXUM suggerisce, e non modifica mai un dizionario
    //
    // Questo blocco non offre alcun comando che tocchi un dizionario, e la
    // garanzia non e' il divieto: il modulo che aggrega NON CONOSCE
    // L'ARCHIVIO, e il suggerimento NON CONTIENE UN VALORE NUOVO. Non c'e'
    // nulla da applicare, quindi nessun pulsante puo' applicarlo.
    //
    // # Non compare se nessuno lo chiede
    //
    // Leggere tutti i riscontri e tutte le decisioni di una sessione costa;
    // e un'aggregazione che si apre da sola verrebbe letta come un giudizio
    // sui dizionari, che non e'.
    in property <bool> feedback-open: false;
    // La frase dell'esito, composta dal servizio. Dichiara anche i casi in cui
    // non dice nulla: zero decisioni non e' «nessuna smentita».
    in property <string> feedback-summary: "";
    in property <[FeedbackRow]> feedback-rules: [];
    callback open-feedback();
    callback close-feedback();

    // ------------------------------------------- sorveglianza cyber
    //
    // Quanti gruppi di segnali condividono un indicatore tecnico nella
    // sessione osservata. NON e' un allarme: e' un invito a guardare, e la
    // frase lo dice.
    //
    // Vuota quando non c'e' nulla: una riga che compare sempre e' una riga
    // che nessuno legge.
    in property <string> cyber-watch-summary: "";

    // ------------------------------------ la schermata Cyber Watch
    //
    // Fino al 2026-08-25 la sorveglianza cyber esisteva come servizio e si
    // affacciava in UNA FRASE in coda alla descrizione della schermata Alert.
    // Il dominio c'era, la composizione pure, e chi doveva guardare i grappoli
    // non aveva un posto in cui farlo.
    in property <[CyberEventEntry]> cyber-events: [];
    in property <[string]> cyber-sessions: [];
    in-out property <int> cyber-session-index: 0;
    // Errore di lettura, vuoto quando non ce n'e' stato.
    in property <string> cyber-message: "";
    // Se una sessione e' stata scelta. Senza, non si mostra un elenco vuoto —
    // che direbbe «non c'e' nulla» — ma si chiede di sceglierne una.
    in property <bool> cyber-has-session: false;
    // Gli eventi candidati di tutto l'archivio, quando nessun monitoraggio e'
    // scelto (CYBER-EVENTS-02, ADR-0189).
    in property <[CyberCandidateEntry]> cyber-candidates: [];

    // LA RICERCA NEI MESSAGGI, B E C (ADR-0154, DG-06).
    in-out property <int> cyber-search-branch: 0;
    in-out property <string> cyber-search-chat: "";
    in-out property <string> cyber-search-query: "";
    in property <string> cyber-search-scope: "";
    in property <string> cyber-search-outcome: "";
    in property <[CyberHitRow]> cyber-search-hits: [];
    in property <bool> cyber-search-can-continue: false;
    callback cyber-search-start(int, string, string);
    callback cyber-search-next();
    // La ricerca ricorrente E (CYBER-WATCH-02, ADR-0162).
    in-out property <string> cyber-recurring-hours: "6";
    in property <[CyberRecurringRow]> cyber-recurring-rows: [];
    in property <string> cyber-recurring-feedback: "";
    callback cyber-recurring-save(int, string, string, string);
    callback cyber-recurring-toggle(int, bool);
    callback cyber-recurring-withdraw(int);
    // La ricerca su più rami (CYBER-SEARCH-03, ADR-0163).
    in-out property <bool> cross-search-a: true;
    in-out property <bool> cross-search-b: true;
    in-out property <bool> cross-search-c: false;
    in-out property <bool> cross-search-d: false;
    in property <[CyberCrossRow]> cross-search-rows: [];
    in property <string> cross-search-report: "";
    callback cross-search-start(bool, bool, bool, bool, string, string);
    // I suggerimenti di fonti dall'archivio (SOURCE-SUGGEST-01, ADR-0164).
    in property <[SourceSuggestionRow]> source-suggestions: [];
    in property <string> source-suggestion-feedback: "";
    in-out property <string> source-suggestion-reason: "";
    callback source-suggestion-add(string);
    callback source-suggestion-ignore(string, string);
    callback source-suggestions-refresh();
    // L'affidabilità delle fonti, valutata a mano (SOURCE-RELIABILITY-01, ADR-0167).
    in property <[SourceReliabilityRow]> source-reliability-rows: [];
    in property <string> source-reliability-feedback: "";
    in-out property <string> source-reliability-reason: "";
    callback source-reliability-record(int, int);
    callback cyber-shown();
    callback cyber-session-chosen(int);
    // Porta allo Storico, gia' cercando il valore dell'indicatore: e' la via
    // dal grappolo ai contenuti che lo compongono.
    callback cyber-open-in-history(string);

    // ------------------------------------- la cronologia di un gruppo (CYT-01)
    //
    // Si apre su richiesta, per UN gruppo alla volta. Non compare accanto a
    // ogni voce dell'elenco: una cronologia sotto ognuno dei venti gruppi di
    // una sessione sarebbe una pagina che nessuno scorre, e la riga che conta
    // sparirebbe fra le altre.
    in property <[CyberTimelineEntry]> cyber-timeline: [];
    // Di quale gruppo e' la cronologia aperta.
    in property <string> cyber-timeline-title: "";
    // Il periodo in cui si e' osservato. NON e' un contorno: e' l'unica cosa
    // che rende leggibile un vuoto.
    in property <string> cyber-timeline-window: "";
    // Che cosa queste righe non dicono. Compare sempre, e quando la linea
    // mescola i due orologi lo dice.
    in property <string> cyber-timeline-caveat: "";
    // Perche' la cronologia non c'e', quando non c'e'. Un monitoraggio mai
    // avviato non ha osservato niente, e una linea di vuoti senza il fatto che
    // li spiega si legge come «qui non e' successo niente».
    in property <string> cyber-timeline-message: "";
    in property <bool> cyber-timeline-open: false;

    // Il genere e il valore dell'indicatore che tiene insieme il gruppo.
    callback cyber-timeline-requested(string, string);
    callback cyber-timeline-closed();
    // LA RISOLUZIONE DI UN INDICATORE DAL PC (IOC-RESOLVE-01, ADR-0202): su
    // comando, con l'avvertenza prima del pulsante.
    in property <bool> ioc-resolve-applicable: false;
    in property <bool> ioc-resolve-enabled: false;
    in property <string> ioc-resolve-message: "";
    in property <string> ioc-resolve-history: "";
    callback ioc-resolve-request();
    // La scelta dell'amministratore, in Impostazioni.
    in property <bool> ioc-resolve-administrator: false;
    in property <string> ioc-resolve-state: "";
    in property <string> ioc-resolve-choice-message: "";
    callback ioc-resolve-enable();
    callback ioc-resolve-disable();
    // IL WHOIS DAL PC (WHOIS-01, ADR-0205): su comando, con l'avvertenza
    // prima del pulsante.
    in property <bool> whois-applicable: false;
    in property <bool> whois-enabled: false;
    in property <string> whois-message: "";
    in property <string> whois-history: "";
    callback whois-request();
    // La scelta dell'amministratore, in Impostazioni.
    in property <bool> whois-administrator: false;
    in property <string> whois-state: "";
    in property <string> whois-choice-message: "";
    callback whois-enable();
    callback whois-disable();
    // IL MONITORAGGIO CON WINDOWS CHIUSO (SERVICE-01, ADR-0203): lo stato lo
    // dice Windows; i permessi e la password li chiede Windows, non questa
    // schermata.
    in property <string> background-service-state: "";
    in property <string> background-service-handovers: "";
    in property <string> background-service-message: "";
    callback background-service-install();
    callback background-service-remove();

    // ------------------------------------------- il grafo delle prove (GRAPH-02)
    //
    // LA FIGURA MOSTRA UN NODO E CIO' CHE LO TOCCA, e nient'altro. Non esiste
    // un comando che chieda «come sono collegati questi due»: due nodi
    // collegati attraverso un terzo non hanno per questo a che fare l'uno con
    // l'altro, e il programma non ha titolo per dire il contrario (DEC-288).
    //
    // Fra due vicini NON si disegna alcuna linea: nessun arco li unisce nei
    // fatti, e una linea disegnata sarebbe esattamente l'affermazione che il
    // dominio si rifiuta di calcolare.
    // ------------------------------------------------ Scoperta pubblica (PD-UI-01)
    //
    // Le scoperte registrate, la piu' recente per prima.
    in property <[DiscoveryRunEntry]> discovery-runs: [];
    // Quale scoperta si sta leggendo. -1 = nessuna.
    in-out property <int> discovery-selected: -1;
    // Che cosa si e' guardato e che cosa se ne e' ricavato, in una frase.
    in property <string> discovery-summary;
    // La misura su cui la scoperta poggiava, con la sua provenienza.
    in property <string> discovery-limits;
    // Le domande poste, nell'ordine.
    in property <[string]> discovery-asked: [];
    // CIO' CHE NON E' STATO CHIESTO. Sta accanto alle domande, non dietro un
    // pannello da aprire: conservarlo e non mostrarlo e' come non conservarlo.
    in property <[DiscoveryTermEntry]> discovery-omitted: [];
    // I candidati, nell'ordine di PD-RANK-01.
    in property <[DiscoveryCandidateEntry]> discovery-candidates: [];
    // Quanti risultati non sono candidati, e perche' non lo sono.
    in property <string> discovery-results-note;
    // ------------------------------------ Decisioni sui candidati (SRC-DISC-01)
    //
    // Quale candidato si sta guardando. -1 = nessuno. SCEGLIERE NON DECIDE
    // NIENTE: le tre decisioni sono tre comandi separati, e ciascuna vuole un
    // motivo scritto.
    in-out property <int> discovery-candidate-selected: -1;
    // Il motivo della decisione, scritto da chi decide. Finche' e' vuoto, i tre
    // comandi non si possono premere: un motivo per candidato e' la difesa piu'
    // semplice contro il gesto (ADR-0080).
    in-out property <string> discovery-decision-reason;
    // Che cosa si dichiara aggiungendo. Si legge PRIMA di firmare, non dopo.
    in property <string> discovery-add-declaration;
    // Che cosa succede ignorando.
    in property <string> discovery-ignore-note;
    // L'esito dell'ultima decisione presa.
    in property <string> discovery-decision-message;

    // Perche' da qui non si cerca. Non e' un divieto: e' un'impossibilita'.

    in property <string> discovery-closed-door;
    // Perche' non cerchera' questa postazione, quando si cerchera'. Vuota su un
    // Hub: li' la seconda ragione non c'e'.
    in property <string> discovery-follows-hub;
    // Che cosa dire quando nessuna scoperta e' mai stata eseguita.
    in property <string> discovery-never-run;

    in property <[GraphNodeEntry]> graph-neighbours: [];

    // Il nodo al centro: come si chiama e che genere di cosa e'.
    in property <string> graph-centre-label: "";
    in property <string> graph-centre-kind: "";
    // Il contenuto al centro, quando il centro e' un contenuto; 0 altrimenti.
    // Serve ad aprirne la conversazione con un gesto (ADR-0151).
    in property <int> graph-centre-content: 0;
    // Che cosa questa figura NON dice. Sta ACCANTO alla figura e non sotto:
    // sotto arriva dopo che l'impressione si e' formata.
    in property <string> graph-caveat: "";
    // Perche' la figura non c'e', quando non c'e'.
    in property <string> graph-message: "";
    // Se un nodo e' stato scelto. Senza, non si mostra una figura vuota - che
    // direbbe «non c'e' niente» - ma si chiede da dove partire.
    in property <bool> graph-has-node: false;
    // Il selettore del monitoraggio, come in Cyber Watch: gli archi si
    // ricavano dentro un monitoraggio, e mescolarne due metterebbe insieme
    // atti diversi.
    in property <[string]> graph-sessions: [];
    in-out property <int> graph-session-index: 0;
    // Da dove si parte: l'identificativo di un contenuto. Si scrive, come
    // l'identificativo di un'identita' in Persone, perche' un elenco da cui
    // scegliere sarebbe un elenco di persone prodotto senza chiederselo.
    in-out property <string> graph-start-content: "";

    // La schermata della scoperta e' stata aperta.
    callback discovery-shown();
    // E' stata scelta la scoperta in quella posizione dell'elenco.
    callback discovery-run-chosen(int);
    // E' stato scelto il candidato in quella posizione. Scegliere NON decide.
    callback discovery-candidate-chosen(int);
    // Le tre decisioni del piano, e nessun'altra. Nessuna agisce su piu' di un
    // candidato per volta: una decisione presa su dieci cose insieme non e'
    // dieci decisioni, e' un gesto (ADR-0035, ADR-0080).
    callback discovery-open-candidate();
    callback discovery-add-candidate();
    callback discovery-ignore-candidate();


    callback graph-shown();

    callback graph-session-chosen(int);
    // Parte dal contenuto scritto.
    callback graph-start-requested();
    // Ricentra sul vicino in posizione indicata: un passo alla volta, e ogni
    // passo mostra la propria ragione.
    callback graph-recentre(int);
    // Dallo Storico o dagli Avvisi al Grafo, sul contenuto scelto (F-21): il
    // programma sceglie il monitoraggio del contenuto e lo apre.
    callback graph-open-content(int);

    // ------------------------- «Perché sto vedendo questo?» esteso (PROV-02)
    //
    // UNA VOCE SOLA FA SEMBRARE UGUALI CINQUE CERTEZZE DIVERSE, ed e' il
    // difetto che questo pannello esiste per evitare. Che quel contenuto venga
    // da quella fonte e' un fatto che sta nell'archivio; che quel termine sia
    // emergente e' un calcolo che dipende da due finestre scelte da qualcuno.
    //
    // Perciò la NATURA compare per prima, prima della spiegazione: una
    // spiegazione convincente letta senza sapere che e' un calcolo si ricorda
    // come un fatto.
    in property <bool> why-subject-open: false;
    // Di che cosa si sta chiedendo il perche'.
    in property <string> why-subject-label: "";
    // Che genere di certezza e': fatto osservato, elaborazione automatica,
    // decisione di una persona.
    in property <string> why-subject-nature: "";
    // Che cosa quella natura significa, e che cosa NON significa.
    in property <string> why-subject-nature-note: "";
    // La spiegazione, presa da chi la possiede e non ricomposta qui.
    in property <string> why-subject-explanation: "";
    // Come e' stato calcolato, quando e' un calcolo. Vuoto altrimenti: un
    // metodo accanto a un fatto osservato direbbe che e' stato calcolato anche
    // quello.
    in property <string> why-subject-method: "";
    in property <string> why-subject-method-detail: "";
    // Se la risposta e' un calcolo. La resa cambia, perche' le due cose non
    // sono la stessa.
    in property <bool> why-subject-is-elaboration: false;

    // Il pannello si apre soltanto dalla porta «Provenienza, note e contesto» di
    // «Perché vedo questo?» (PR-02): lo apre il Rust, e non c'e' un comando
    // della schermata che lo apra da solo.
    callback close-why-subject();

    // ----------------------------- «Perché vedo questo?» (PR-02, ADR-0119)
    //
    // UN COMANDO SOLO, UNA RISPOSTA IN TRE PARTI, SEMPRE NELLO STESSO ORDINE:
    // che cosa lo ha fatto comparire (la regola, con nome e versione, e i
    // fatti), che genere di certezza e' (l'origine di PR-03), che cosa non
    // significa. La terza parte non ha condizioni: c'e' sempre.
    in property <bool> explain-open: false;
    // Di che cosa si chiede il perche'.
    in property <string> explain-subject: "";
    // Parte 1: la regola, con il nome e la versione, e i fatti.
    in property <string> explain-rule: "";
    in property <string> explain-facts: "";
    // Parte 2: l'origine, con il segno e con la frase.
    in property <Origine> explain-origin: Origine.non-registrata;
    in property <string> explain-origin-note: "";
    // Parte 3: che cosa non significa.
    in property <string> explain-not-meaning: "";
    // Se c'e' una provenienza piu' lunga da aprire. Dove l'Explorer non copre
    // l'elemento, la porta non compare e non promette.
    in property <bool> explain-has-door: false;
    // Non vuota quando la risposta non si puo' dare: in modalita' Team, per un
    // elemento che l'Hub non ha mostrato a questa postazione.
    in property <string> explain-unavailable: "";
    // Dove porta la porta: il contenuto del percorso (PROV-01), oppure il
    // genere e la chiave del pannello di PROV-02. -1 quando non porta li'. Li
    // legge il Rust quando la porta si apre: la schermata non li interpreta.
    in property <int> explain-door-content: -1;
    in property <int> explain-door-subject: -1;
    in property <string> explain-door-key: "";

    // Il genere dell'elemento, la sua chiave e i fatti che la schermata sta
    // gia' mostrando.
    callback explain-this(Spiegabile, string, string);
    // Cio' che si spiega da un contenuto dello Storico: la riga, il livello,
    // l'avviso, il riscontro. I fatti li legge il Rust dall'archivio; la
    // stringa serve soltanto al riscontro.
    callback history-explain(Spiegabile, int, string);
    // Una voce della coda dell'ufficio: SOLO l'identificativo.
    callback team-explain(int);
    callback explain-open-provenance();
    callback close-explain();

    in property <string> toast-state-message: "";
    in property <bool> toast-state-enabled: false;

    // --------------------------------------------------------- persone
    //
    // L'elenco **non si produce** finche' non e' registrata una ragione
    // (ADR-0024). `participants-basis-recorded` distingue i due stati, e la
    // schermata mostra il modulo della ragione oppure l'elenco: mai entrambi,
    // perche' un elenco accanto alla richiesta di motivarlo suggerirebbe che
    // la richiesta sia facoltativa.
    in property <bool> participants-basis-recorded: false;
    in-out property <string> participants-basis: "";
    in property <string> participants-message: "";
    in property <[ParticipantEntry]> participants: [];
    // Il monitoraggio scelto nella schermata Persone, per la scheda «Foto,
    // biografia e stato» (PERSON-MEDIA-01).
    in property <int> participants-session-id: 0;
    // LA SCHEDA «FOTO, BIOGRAFIA E STATO» (PERSON-MEDIA-01, ADR-0174).
    in-out property <bool> profile-media-open: false;
    in-out property <string> profile-media-author: "";
    in property <string> profile-media-title: "";
    in-out property <string> profile-media-reason: "";
    in property <string> profile-media-message: "";
    in property <string> profile-media-caveat: "";
    in property <[ProfileMediaEntry]> profile-media-entries: [];
    callback profile-media-open-for(string, string);
    callback profile-media-ask();
    callback profile-media-close();
    callback profile-media-mark(int, bool);
    // L'ALLEGATO DEL CONTENUTO SCELTO (ATTACH-01, ADR-0177): la frase della
    // descrizione e la scheda per conservarlo, nello Storico e negli Avvisi.
    in property <string> history-attachment-sentence: "";
    in-out property <bool> history-attachment-open: false;
    in-out property <int> history-attachment-content: -1;
    in property <string> history-attachment-caveat: "";
    in-out property <string> history-attachment-reason: "";
    in property <string> history-attachment-message: "";
    in property <[AttachmentKeepingEntry]> history-attachment-entries: [];
    callback history-attachment-open-for(int);
    callback history-attachment-ask();
    callback history-attachment-close();
    // Il selettore della sessione. L'elenco risponde a «chi ha scritto in
    // QUESTO monitoraggio»: senza un modo di sceglierlo, rispondeva sempre
    // sull'ultimo, e chi doveva rileggere un monitoraggio della settimana prima
    // non aveva alcuna via per arrivarci.
    //
    // Qui non c'e' una voce «tutte le sessioni», e la differenza con lo Storico
    // e' voluta: un elenco di persone che unisce monitoraggi diversi mette
    // insieme atti diversi, e chi lo consegna non potrebbe piu' dire a quale
    // dei due si riferisce.
    in property <[string]> participants-sessions: [];
    in-out property <int> participants-session-index: 0;
    callback participants-session-chosen(int);

    callback participants-shown();
    // La scheda dei soggetti si ricompone aprendo Persone (CA02-01): diceva
    // «nessun monitoraggio ha incontrato questa identità» con due contenuti in
    // archivio, finché non si agiva sulla scheda.
    callback persons-shown();
    callback record-participants-basis();

    // I SOGGETTI INVESTIGATIVI (PERS-01).
    //
    // NON sono le persone dell'elenco qui sopra. Quello e' DERIVATO — chi ha
    // scritto durante un monitoraggio — ed e' un'osservazione. Un soggetto e'
    // qualcuno su cui l'ufficio ha deciso di aprire un fascicolo, e si apre a
    // mano scrivendo perche'.
    //
    // Nessuna di queste proprieta' porta una valutazione: non un punteggio, non
    // un livello, non un rischio. La valutazione umana arriva con PERS-05, avra'
    // quattro stati con un nome, e sara' un atto di un operatore.
    in property <[PersonRow]> person-rows: [];
    in property <string> person-message: "";
    in-out property <string> person-new-label: "";
    in-out property <string> person-new-reason: "";
    // Il soggetto che si sta chiudendo; 0 quando nessuno. Chiudere vuole a sua
    // volta una ragione, e il campo compare solo quando serve.
    in-out property <int> person-closing: 0;
    in-out property <string> person-closing-reason: "";
    // Il soggetto che si sta valutando; 0 quando nessuno (PERS-05).
    //
    // Valutare vuole a sua volta un motivo, DIVERSO da quello dell'apertura:
    // chi ha scritto perche' apriva non ha ancora scritto perche' valuta.
    in-out property <int> person-assessing: 0;
    in-out property <string> person-assessment-reason: "";
    // Quale dei quattro stati si sta scegliendo.
    //
    // 0 e' NON VALUTATO, che NON e' un livello: e' il ritiro di una
    // valutazione, ed e' un atto come gli altri — con il suo motivo.
    in-out property <int> person-assessment-choice: 0;
    // Il soggetto su cui si sta lavorando a un legame; 0 quando nessuno
    // (PERS-06).
    //
    // L'identificativo SI SCRIVE: non c'e' un elenco da cui sceglierlo, e non
    // c'e' un comando «collega questa riga» accanto alle persone osservate.
    // Sarebbe lo stesso difetto che PERS-01 ha evitato non mettendo un «apri un
    // soggetto da questa riga»: trasformerebbe un'osservazione in un atto con
    // un clic.
    in-out property <int> person-linking: 0;
    in-out property <string> person-link-identifier: "";
    in-out property <string> person-link-reason: "";
    // Vero quando si sta sciogliendo invece che collegando. Sciogliere e' un
    // ATTO, non una cancellazione, e chiede il suo motivo.
    in-out property <bool> person-link-release: false;
    // NOTE E RIFERIMENTI DEL SOGGETTO (ADR-0153, DG-08).
    in-out property <int> person-annotating: 0;
    // Il soggetto aperto dall'autore di un messaggio (GAP-12): 0 se nessuno.
    in-out property <int> person-highlight: 0;
    in-out property <string> person-note-draft: "";
    in-out property <int> person-ref-kind: 0;
    in-out property <string> person-ref-target: "";
    in-out property <string> person-ref-reason: "";
    in-out property <string> person-withdraw-reason: "";
    callback person-write-note(int, string);
    callback person-add-reference(int, int, string, string);
    callback person-withdraw-entry(int, string);
    callback open-person(string, string);
    // Registra un atto su un legame: quale soggetto, quale identificativo, se
    // si scioglie, perche'.
    //
    // NON esiste un comando che colleghi senza motivo, e non esiste nulla che
    // proponga identita' da collegare: il congelamento vieta la fusione
    // automatica per somiglianza di nome, e qui non c'e' nemmeno la forma.
    callback link-identity(int, string, bool, string);
    callback close-person(int, string);
    // Registra un atto di valutazione: quale soggetto, quale scelta, perche'.
    //
    // NON esiste un comando che valuti senza motivo, e non esiste un comando
    // che modifichi o cancelli un atto gia' registrato: se il giudizio cambia,
    // se ne registra uno nuovo.
    callback assess-person(int, int, string);

    // --------------------------------------------- conservazione
    //
    // Per quanto tempo l'ufficio tiene cio' che ha acquisito. Le etichette e
    // le conseguenze arrivano da Rust (lisi-core), dove vive la politica:
    // ripeterle qui vorrebbe dire tenerle allineate a mano.
    //
    // `retention-preview` e `retention-message` sono separate di proposito.
    // L'anteprima dice **quanto sparirebbe** e si aggiorna a ogni scelta;
    // il messaggio dice che cosa e' successo dopo un comando. Una sola
    // proprieta' farebbe scambiare una previsione per un esito.
    in property <[string]> retention-options: [];
    in-out property <int> retention-index: 0;
    in property <string> retention-consequence: "";
    in property <string> retention-preview: "";
    in property <string> retention-message: "";
    // Se c'e' davvero qualcosa da togliere. Senza, il comando che cancella
    // resta spento: un pulsante che promette una cancellazione e non cancella
    // nulla insegna a non fidarsi di quel pulsante.
    in property <bool> retention-has-work: false;
    // ------------------------------------------ stato dell'archivio
    //
    // La verifica NON si esegue a ogni avvio: legge l'intero file, e un
    // controllo che rallenta ogni avvio e' un controllo che qualcuno prima o
    // poi spegne. Si esegue quando qualcuno lo chiede.
    //
    // `archive-damaged` esiste separata dal messaggio perche' il colore e il
    // messaggio dicono due cose diverse: uno si vede a colpo d'occhio, l'altro
    // si legge.
    in property <string> archive-size: "";
    in property <string> archive-message: "";
    in property <bool> archive-damaged: false;
    in property <bool> archive-checked: false;
    callback verify-archive();

    // ------------------------------------ copia di sicurezza
    //
    // La copia si fa con il motore dell'archivio, non copiando il file: in
    // modalita' WAL le scritture recenti vivono in un file accanto, e copiare
    // il solo file principale produce una copia che si apre, sembra a posto, e
    // ha perso l'ultima parte del lavoro (ADR-0043).
    //
    // L'avvertenza su cio' che la copia NON salva sta fissa in schermata e
    // non e' un messaggio di esito: chi la legge dopo un guasto la legge
    // troppo tardi.
    in property <string> backup-message: "";
    in property <bool> backup-failed: false;
    callback make-backup();
    // LE COPIE PIANIFICATE (BACKUP-SCHEDULE-01, ADR-0191): la sceglie
    // l'amministratore; tutti leggono che cosa è pianificato e com'è andata.
    in property <bool> backup-schedule-administrator: false;
    in property <bool> backup-schedule-active: false;
    in property <string> backup-schedule-state: "";
    in property <string> backup-schedule-message: "";
    in-out property <string> backup-schedule-days: "7";
    in-out property <string> backup-schedule-keep: "4";
    callback backup-schedule-choose();
    callback backup-schedule-off();
    // IL REGISTRO DELLE CONSULTAZIONI (AUDIT-VIEW-01, ADR-0193): tutti leggono
    // se è acceso; l'amministratore lo regola e ne legge le righe.
    in property <bool> consultations-administrator: false;
    in property <bool> consultations-active: false;
    in property <string> consultations-state: "";
    in property <string> consultations-entries: "";
    in property <string> consultations-message: "";
    in-out property <string> consultations-days: "90";
    callback consultations-turn-on();
    callback consultations-turn-off();

    // ------------------------------------ copia cifrata (ENCRYPT-01, ADR-0175)
    //
    // La frase si scrive due volte e non si conserva: il codice la legge al
    // momento della copia e svuota i campi, che sia riuscita, rifiutata o
    // annullata. Per aprire, un campo vuoto vuol dire «con questo utente».
    in-out property <string> sealed-phrase: "";
    in-out property <string> sealed-phrase-again: "";
    in-out property <bool> sealed-with-user: false;
    in property <string> sealed-message: "";
    in property <bool> sealed-failed: false;
    callback make-sealed-backup();
    callback open-sealed-backup();

    // --------------------------------------- origine del programma
    //
    // Se QUESTA copia e' firmata. Un amministratore che trova un programma di
    // monitoraggio su una postazione vuole sapere se e' l'originale.
    //
    // Finche' non esiste un certificato (HVQ-07) la risposta e' «non firmato»,
    // e va detta cosi' com'e': una schermata che tacesse sarebbe piu' comoda e
    // meno vera.
    in property <string> signature-message: "";
    in property <bool> signature-trusted: false;

    // ------------------------------------------ aggiornamenti
    //
    // Il prodotto NON controlla da se', NON scarica e NON installa (ADR-0037).
    // Non c'e' nemmeno l'interruttore di un controllo automatico: sarebbe una
    // connessione uscente che nessun ufficio ha approvato.
    //
    // Cio' che sa fare e' LEGGERE l'informazione su un aggiornamento ricevuto
    // dall'ufficio e dire se sarebbe accettabile per questa postazione. La
    // regola che conta e' il rifiuto di una versione piu' vecchia: e' l'unico
    // attacco che un'informazione sostituita potrebbe portare a segno.
    in property <string> update-station: "";
    in property <string> update-message: "";
    in property <bool> update-refused: false;
    callback review-update();

    // Il canale della postazione (ADR-0066).
    //
    // IL CANALE DICE QUANDO, NON QUANTO CI SI FIDA: il pilota e' lo stesso
    // programma, firmato allo stesso modo, ricevuto prima. Nessuna verifica
    // cambia con il canale, e nessuna parola qui dentro deve suggerire il
    // contrario — «beta», «prova», «sperimentale» direbbero il falso.
    //
    // La scelta e' riservata a chi amministra: vale per la postazione, non per
    // chi la fa, e decide quando OGNI operatore ricevera' il programma nuovo.
    in property <[string]> update-channel-options: ["Stabile", "Pilota"];
    in-out property <int> update-channel-index: 0;
    in property <bool> update-channel-settable: false;
    in property <string> update-channel-note: "";
    callback choose-update-channel(int);

    // L'origine da cui si scarica, e il comando che scarica (ADR-0067).
    //
    // DA OGGI IL PRODOTTO HA UNA PORTA VERSO LA RETE, e ne ha UNA. Va in un
    // posto solo: questo indirizzo. Non viene mai da un contenuto monitorato —
    // un messaggio, un profilo, un allegato o un fascicolo importato non possono
    // diventare l'indirizzo che la postazione contatta.
    //
    // E NON SI MUOVE DA SOLA: non c'e' un controllo automatico, non c'e' un
    // timer, non si guarda all'avvio. La rete si tocca quando qualcuno preme.
    in-out property <string> update-origin: "";
    in property <string> update-origin-note: "";
    callback save-update-origin(string);
    // I firmatari degli aggiornamenti (UPDATE-SIGN-01, ADR-0183).
    in property <string> update-signers: "";
    in-out property <string> update-signer-fingerprint: "";
    in-out property <string> update-signer-name: "";
    in property <string> update-signer-note: "";
    callback admit-update-signer();
    callback retire-update-signer();
    callback fetch-update();

    // Lo scaricamento del file vero (ADR-0068).
    //
    // SCARICARE NON E' INSTALLARE, E NON E' VERIFICARE. Quello che scende e' un
    // file non eseguibile che nessuno apre: la verifica della firma e
    // dell'impronta e' UPDATE-04, la consegna all'installatore e' UPDATE-07, e
    // nessuna delle due esiste ancora. La schermata lo dice invece di lasciarlo
    // intuire.
    callback download-artifact();

    // La catena di verifica (ADR-0069).
    //
    // L'IMPRONTA NON E' UNA FIRMA. L'impronta viene dal documento ricevuto, che
    // non e' fidato: se torna, dimostra che i byte sono quelli che QUEL
    // documento descriveva. La firma di Windows e' l'unica cosa che non viene
    // dal documento, ed e' quella che dice di chi ci si sta fidando.
    callback verify-artifact();

    // Il percorso, con uno stato visibile e un passo alla volta (ADR-0071).
    //
    // Prima c'erano cinque comandi in fila, senza un ordine e senza uno stato:
    // chi non conosceva la sequenza poteva premere «Verifica» per primo e
    // leggere «non c'e' nessun file da verificare» — una frase vera che, letta
    // li', SEMBRA UN GUASTO.
    //
    // «Installa ora» NON C'E', e non e' una dimenticanza: installare non esiste
    // ancora, e un comando che non fa cio' che dice e' una promessa. «Piu'
    // tardi» non c'e' per la ragione opposta: non avrebbe niente da fare, e
    // suggerirebbe un promemoria che nessuno terra'.
    in property <string> update-step-sentence: "";
    in property <string> update-step-command: "";
    in property <string> update-step-inaction: "";
    in property <string> update-why-no-install: "";
    in property <bool> update-has-staged: false;
    callback update-step-forward();
    callback discard-staged();

    // La consegna all'installatore (ADR-0072).
    //
    // E' l'unico comando di questo prodotto che porta a ESEGUIRE qualcosa
    // arrivato dalla rete, e succede solo se: la catena dice di si' adesso,
    // nessun monitoraggio sta osservando, e una persona lo chiede.
    //
    // Il programma si chiude, e NON si riapre da solo: riaprirlo aprirebbe un
    // programma diverso da quello che l'operatore ha chiuso, senza che nessuno
    // lo guardi partire.
    in property <string> update-hand-off-note: "";
    callback hand-off-update();

    // Una consegna che non ha prodotto un'installazione (ADR-0073).
    //
    // Il prodotto si e' chiuso per consegnare e riapre com'era: per lui non e'
    // successo niente. Ma nel registro c'e' scritto che una consegna e'
    // avvenuta, e la versione e' ancora quella di prima.
    //
    // Senza questa frase le due spiegazioni possibili — «l'aggiornamento non
    // c'era davvero» e «qualcosa e' andato storto» — sono indistinguibili, e la
    // prima e' quella che una persona sceglie perche' e' piu' comoda.
    in property <string> update-delivery-notice: "";







    // ------------------------------------ fascicolo condivisibile
    //
    // Si condivide la CONFIGURAZIONE, non l'archivio: fonti, dizionari e
    // profilo documentale. Nessun contenuto acquisito, nessuna credenziale.
    //
    // L'anteprima e l'esito sono due proprieta' distinte perche' dicono due
    // cose diverse: una previsione e un fatto.
    in property <string> team-path: "";
    in property <string> team-preview: "";
    in property <string> team-message: "";
    in property <bool> team-can-import: false;
    callback export-fascicolo();
    callback choose-fascicolo();
    callback import-fascicolo();

    callback retention-chosen(int);
    callback save-retention();
    callback apply-retention();

    callback settings-shown();
    callback save-settings();
    callback set-autostart(bool);

    // ------------------------------------------- blocco della postazione
    //
    // Il blocco nasconde i **dati dell'account** e non ferma il monitoraggio:
    // fermarlo trasformerebbe una pausa in un buco nell'archivio. A schermo
    // bloccato compare `lock-fact` — il fatto, non il contenuto.
    //
    // E' l'alias del segnale che ogni comando condiviso legge
    // (`StationLock.engaged`): uno solo, perche' due valori che devono dire la
    // stessa cosa prima o poi ne dicono due (OPERATOR-E2E-REMEDIATION-01, F-01).
    in-out property <bool> station-locked <=> StationLock.engaged;
    // Se l'account attivo ha una parola: senza, il comando «Blocca» non
    // compare, perche' bloccare senza poter sbloccare chiude fuori chi preme.
    in property <bool> lock-available: false;
    in property <string> lock-account-label: "";
    in property <string> lock-fact: "";
    in property <string> lock-message: "";
    in-out property <string> lock-attempt: "";

    // Impostazioni del blocco, nella schermata Impostazioni.
    in property <bool> lock-protected: false;
    // Se un account attivo c'è: senza, il Blocco lo dice (CA02-07).
    in property <bool> lock-has-account: false;
    in-out property <string> lock-new-word: "";
    in-out property <int> lock-minutes: 10;
    in property <string> lock-settings-message: "";
    in property <bool> lock-settings-failed: false;

    callback lock-station();
    callback unlock-station();
    callback protect-account();
    callback unprotect-account();
    callback save-lock-minutes();

    // ------------------------------------------- verifica esportati
    // Le righe sono la resa diretta di ExportService::verify_directory: un
    // rapporto per riga con il suo verdetto. `verification-checked` distingue
    // «non ancora verificato» da «verificato, nessun rapporto».
    in property <[VerificationRow]> verification-rows: [];
    in property <string> verification-summary: "";
    in property <bool> verification-checked: false;
    callback verification-shown();
    /// Verifica una cartella scelta sul momento, senza cambiare quale sia
    /// la destinazione dell'ufficio.
    callback verify-elsewhere();
    callback verify-now();

    // ------------------------------------------------ centro notifiche
    // Le notifiche emesse, dalla piu' recente. I dati arrivano da Rust
    // (NotificationService::history). Il centro e' di sola lettura.
    in property <[NotificationCard]> notification-cards: [];
    callback notifications-shown();

    // ------------------------------------------- revisione condivisa
    //
    // Cio' che l'Hub ha segnalato, e che l'ufficio rivede insieme
    // (TEAM-REVIEW-01, ADR-0094). L'elenco porta metadati; il contenuto aperto
    // vive in memoria per la durata della schermata e non si conserva.
    in property <[ReviewQueueRow]> review-queue-rows: [];
    in property <bool> review-has-open: false;
    /// Quale contenuto e' aperto: serve ai comandi che agiscono su di esso.
    in property <int> review-open-id: 0;
    in property <string> review-open-source: "";
    in property <string> review-open-published: "";
    in property <string> review-open-body: "";
    in property <string> review-open-level: "";
    in property <string> review-message: "";
    /// Che cosa dice la coda nel suo insieme: quanti aspettano, quanti sono in
    /// esame, e di quando e' la fotografia (TEAM-WQ-01, ADR-0095).
    in property <string> review-queue-summary: "";
    callback review-shown();
    /// Chiede all'Hub UN contenuto: l'apertura resta registrata.
    callback review-open(int);
    /// Manda la decisione presa su cio' che si e' letto.
    callback review-decide(string, string);
    /// Chi e' entrato su questo Hub, o vuoto.
    ///
    /// L'accesso vale per la sessione e non lascia niente sulla postazione
    /// (TEAM-ASSIGN-01, ADR-0097, decisione 6).
    in property <string> review-person: "";
    // I COMANDI A DISTANZA (HUB-REMOTE-01, ADR-0200): i monitoraggi
    // dell'ufficio a cui una persona entrata può dare un comando.
    in property <[string]> review-monitorings: [];
    in-out property <int> review-monitoring-index: 0;
    callback review-remote-command(int, string, string);
    /// I colleghi, quando chi e' dentro li ha chiesti.
    in property <[TeamPersonRow]> review-people: [];
    /// Si dimostra di essere una persona dell'ufficio.
    callback review-sign-in(string, string);
    /// Si esce, e la sessione si chiude.
    callback review-sign-out();
    /// Prende in carico: assegna a se' stessi.
    callback review-take(int);
    /// Restituisce il lavoro: assegna a nessuno.
    callback review-release(int);
    /// Assegna a un collega. Riservato a chi amministra.
    callback review-assign(int, string);
    /// Che cosa l'ufficio ha scritto sul contenuto aperto (TEAM-WS-01,
    /// ADR-0099). Comprende le note ritirate.
    in property <[SharedNoteRow]> review-notes: [];
    /// Perche' le note non ci sono, quando non ci sono.
    in property <string> review-notes-message: "";
    /// Annota il contenuto aperto.
    callback review-write-note(string);
    /// Ritira una nota. Non la cancella.
    callback review-withdraw-note(int);

    // ------------------------------------------------ raccoglitori condivisi

    in property <[SharedWorkspaceRow]> shared-workspaces: [];
    in property <[SharedItemRow]> shared-items: [];
    in property <string> shared-message: "";
    /// Chi e' entrato, per sapere che cosa si puo' fare.
    in property <string> shared-person: "";
    callback shared-shown();
    callback shared-refresh();
    callback shared-open(string, string);
    callback shared-close(int);
    callback shared-show-items(int);
    // METTERE E TOGLIERE (FINAL-REVIEW-01, FR-050): il raccoglitore mostrato,
    // se accetta elementi, e il riferimento da raccogliere.
    in property <int> shared-shown-workspace: 0;
    in property <bool> shared-shown-open: false;
    in-out property <int> shared-collect-kind: 0;
    in-out property <string> shared-collect-number: "";
    callback shared-collect();
    callback shared-drop(string, int);

    // ------------------------------------------------ live condiviso

    //
    // Che cosa l'Hub vede accadere, e che cosa questa postazione e' rispetto a
    // lui (TEAM-LIVE-01, ADR-0093). Le righe dicono l'ATTIVITA': quante cose
    // sono arrivate, da quale fonte, con quale livello. Il testo dei messaggi
    // non passa di qui e non deve passarci.
    in property <string> team-live-role: "";
    in property <string> team-live-position: "";
    in property <string> team-live-message: "";
    in property <string> team-live-hub-address: "";
    in property <bool> team-live-hub-running: false;
    // LE RETI DELL'UFFICIO (HUB-SITES-01, ADR-0198): dove l'Hub ascolta e da
    // dove lo si raggiunge. Mai Internet.
    in property <string> team-live-networks: "";
    in property <string> team-live-networks-note: "";
    in property <string> team-live-refused: "";
    callback team-live-declare-networks(string);
    // I COMANDI A DISTANZA (HUB-REMOTE-01, ADR-0200): li accetta l'Hub
    // soltanto se chi lo amministra lo ha deciso.
    in property <bool> team-live-remote-accepted: false;
    in property <string> team-live-remote-note: "";
    in property <string> team-live-remote-log: "";
    callback team-live-choose-remote(bool);
    in property <[TeamLiveRow]> team-live-rows: [];
    /// Chi e' collegato all'Hub adesso (TEAM-PRESENCE-01, ADR-0096).
    in property <[TeamPresenceRow]> team-live-presence: [];
    /// Che cosa dice la presenza nel suo insieme, o perche' non si sa.
    in property <string> team-live-presence-summary: "";
    // LA COPERTURA DELL'UFFICIO (HUB-COVERAGE-01, ADR-0199): calcolata
    // dall'Hub, per i monitoraggi più recenti.
    in property <string> team-live-coverage: "";
    /// L'esito dell'ultima copia dell'ufficio (TEAM-BACKUP-01, ADR-0101).
    in property <string> team-live-backup-message: "";
    /// Vero quando la copia NON e' riuscita: il colore lo dice.
    in property <bool> team-live-backup-failed: false;
    /// Scrive la copia dell'ufficio: nasce in casa, si verifica, e poi parte.
    callback team-live-backup();
    callback team-live-shown();
    /// Chiede all'Hub cio' che manca, in una sessione breve: la finestra non
    /// deve restare ferma ad aspettare la rete.
    callback team-live-refresh();
    callback team-live-save-address(string);
    callback team-live-activate();
    callback team-live-deactivate();
    // L'ARRUOLAMENTO DALLA SCHERMATA (D-19, ADR-0132). Il foglietto vive
    // soltanto qui, finche' chi amministra non lo toglie.
    in property <string> team-live-sheet: "";
    in property <bool> team-live-can-issue: false;
    in property <bool> team-live-can-connect: false;
    in-out property <string> team-live-station-name: "";
    in-out property <string> team-live-typed-code: "";
    callback team-live-issue-code();
    callback team-live-hide-sheet();
    callback team-live-connect(string, string, string, string);
    // LE PERSONE DELL'UFFICIO (FINAL-REVIEW-01, FR-047): si creano sulla
    // postazione che fa da Hub, in modalità amministratore.
    in property <[HubPersonRow]> team-live-people: [];
    in property <string> team-live-people-message: "";
    in-out property <string> team-live-person-id: "";
    in-out property <string> team-live-person-name: "";
    in-out property <int> team-live-person-role: 0;
    in-out property <string> team-live-person-passphrase: "";
    callback team-live-person-create();
    callback team-live-person-toggle(string);
    callback team-live-person-reset(string);

    // ------------------------------------------------------------- Report
    //
    // Il percorso in sette passi che porta da una sessione monitorata a un
    // pacchetto sul disco. Ogni valore qui sotto viene dai servizi: la
    // schermata mostra il passo corrente e i comandi ammessi, non decide quali
    // lo siano.
    //
    // **La distinzione che governa l'intera schermata** (ADR-0031 Decisione 1):
    // `report-total` e' cio' che NEXUM/97 ha monitorato, `report-selected` e'
    // cio' che l'operatore ha scelto di rappresentare. Sono due numeri diversi
    // e restano visibili insieme, perche' una selezione si giudica sapendo che
    // cosa resta fuori.
    in property <[WizardStepEntry]> report-steps: [];
    in property <int> report-step: 1;
    in property <string> report-title: "";
    in property <string> report-prompt: "";
    in property <bool> report-can-advance: false;
    in property <bool> report-can-go-back: false;
    // Perche' «Avanti» e' spento. Un comando spento senza motivo lascia
    // l'operatore a indovinare se sia un divieto o un guasto.
    in property <string> report-blocking-reason: "";
    in property <string> report-message: "";
    // Distingue un riscontro da un errore: la fascia cambia tono, e il tono non
    // e' l'unico segnale perche' il testo dice gia' che cosa e' successo.
    in property <bool> report-failed: false;

    // Passo 1 — la sessione.
    in property <[ReportSessionEntry]> report-sessions: [];
    // IL RAPPORTO COMPLESSIVO (REPORT-MULTI-01, ADR-0192): i monitoraggi da
    // spuntare, il responsabile del documento, l'esito.
    in property <[OverviewRow]> overview-rows: [];
    in-out property <string> overview-name: "";
    in-out property <string> overview-role: "";
    in property <string> overview-message: "";
    callback overview-toggle(int);
    callback overview-generate();
    in property <bool> report-session-chosen: false;

    // Passo 2 — i contenuti, e i numeri che restano visibili sempre.
    in property <[ReportContentRow]> report-contents: [];
    in-out property <string> report-filter: "";
    in-out property <bool> report-only-selected: false;
    in-out property <bool> report-only-alerts: false;
    // Il rovescio di «solo i selezionati»: cio' che il monitoraggio ha
    // raccolto e che la relazione **non** rappresentera'. Non ha un pulsante
    // proprio nella riga dei filtri: si accende dal contatore omonimo, che e'
    // il posto dove quella cifra si legge.
    in-out property <bool> report-only-excluded: false;
    in property <int> report-total: 0;
    in property <int> report-selected: 0;
    in property <int> report-excluded: 0;
    in property <int> report-alerts: 0;
    // Quanti per livello, dall'indice 0 al 4.
    in property <[int]> report-levels: [];
    in property <int> report-reviewed: 0;
    in property <int> report-pending: 0;
    // Quante righe il filtro sta mostrando. Il filtro non tocca la selezione, e
    // questa riga e' cio' che lo rende visibile invece che da ricordare.
    in property <string> report-visible-note: "";

    // Passo 3 — i dati della relazione. Nessuno di questi valori sta nel
    // sorgente: sono i campi del profilo documentale, compilati da chi firma.
    in-out property <string> report-organisation: "";
    in-out property <string> report-office: "";
    // La terza riga dell'intestazione, che il documento stampa: si vede e si
    // cambia qui, come le altre due (COLLAUDO-FIX-01, CU01-008).
    in-out property <string> report-premises: "";
    in-out property <string> report-recipient: "";
    in-out property <string> report-recipient-cc: "";
    in-out property <string> report-subject: "";
    in-out property <string> report-place: "";
    in-out property <string> report-role: "";
    // Nome di chi sottoscrive. Non e' l'operatore della richiesta, che e' un
    // identificativo tecnico: in calce a una relazione di servizio non ci va un
    // nome di accesso.
    in-out property <string> report-signer: "";
    in-out property <string> report-footer: "";
    // Lo stemma scelto: il nome del file, oppure vuoto. I byte vivono in Rust,
    // dove sono stati validati; qui ne arriva soltanto il nome da mostrare.
    in property <string> report-emblem: "";
    in property <string> report-profile-note: "";

    // Passo 4 — i formati, con la verita' su ciascuno.
    in property <[ReportFormatRow]> report-formats: [];

    // Passo 5 — l'anteprima: un riepilogo deterministico di cio' che verra'
    // prodotto, non una resa del documento.
    in property <[ReportSummaryRow]> report-preview: [];
    in property <string> report-outcome-label: "";

    // Passo 6 — destinazione e generazione.
    in property <string> report-destination: "";
    // L'avvertenza sulla cartella scelta, quando ce n'e' una.
    //
    // Vuota nel caso ordinario: un'avvertenza che compare sempre e'
    // un'avvertenza che nessuno legge.
    in property <string> report-destination-caution: "";
    in property <bool> report-can-generate: false;
    // Vero mentre la generazione e' in corso. Nessuna percentuale: non esiste
    // un avanzamento misurabile, e inventarne uno sarebbe una bugia che si
    // muove.
    in property <bool> report-busy: false;

    // Passo 7 — l'esito.
    in property <bool> report-completed: false;
    in property <string> report-identifier: "";
    in property <string> report-status: "";
    in property <string> report-folder: "";
    in property <[ReportArtifactRow]> report-artifacts: [];
    in property <string> report-manifest-state: "";
    in property <string> report-warning: "";
    // LA COPIA PER CHI RICEVE (ENCRYPT-02, ADR-0190): il certificato scelto,
    // in una riga da confrontare, e l'esito.
    in property <string> recipient-line: "";
    in property <bool> recipient-ready: false;
    in property <string> recipient-message: "";
    callback recipient-choose();
    // «report» o «evidenze»: quale pacchetto appena prodotto.
    callback recipient-encrypt(string);

    callback report-shown();
    /// Le relazioni dell'ufficio, quando questa postazione segue un Hub
    /// (TEAM-REPORT-01, ADR-0100).
    in property <[SharedReportRow]> report-hub-reports: [];
    /// Che cosa dice l'elenco dell'ufficio, o perche' non c'e'.
    in property <string> report-hub-message: "";
    /// Rilegge le relazioni dell'ufficio dall'Hub.
    callback report-hub-refresh();
    callback report-advance();
    callback report-back();
    callback report-choose-session(int);
    callback report-toggle-content(int);
    // Selezione di gruppo, e **solo** su azione esplicita: nessuna selezione
    // nasce da sola, tanto meno da un livello.
    callback report-select-visible();
    callback report-clear-selection();
    callback report-filter-contents();
    callback report-fields-edited();
    callback report-choose-emblem();
    callback report-clear-emblem();
    callback report-choose-destination();
    callback report-generate();
    // Chiedere a Telegram i collegamenti dei contenuti scelti (ADR-0165).
    in-out property <bool> report-ask-links: false;
    callback report-restart();
    // Apre in Esplora file la cartella dei documenti appena prodotti
    // (UX-EXCELLENCE-02, SIM3-03, ADR-0137). Solo su comando: nulla si apre da solo.
    callback report-open-folder();
    // L'esito del comando, quando non e' riuscito.
    in property <string> report-folder-message: "";

    callback dictionaries-shown();
    callback dictionaries-import();
    callback dictionaries-choose-file();
    callback save-dictionary-source();
    callback download-dictionary();
    callback filter-dictionaries();
    // Modifica di una bozza. Fino al 2026-08-01 l'interfaccia non offriva alcun
    // modo di modificare un dizionario: il percorso che la metodologia
    // prescrive all'ufficio - duplicare, adattare, pubblicare - si fermava al
    // primo passo, e duplicare un dizionario che non si puo' toccare non serve
    // a nulla.
    //
    // Vero per la sola bozza: una versione pubblicata e' immutabile, ed e' cio'
    // che permette a "Globale v3" di significare la stessa cosa su ogni
    // postazione.
    in property <bool> draft-open: false;
    in property <string> draft-title: "";
    in-out property <string> draft-term-input: "";
    in-out property <string> draft-category-input: "";
    in-out property <int> draft-level-index: 0;
    callback add-draft-term();
    callback remove-draft-term(int);
    callback publish-draft();
    // PUBBLICARE CHIEDE CONFERMA (ADR-0140): il primo clic apre la domanda con
    // la conseguenza, il secondo comando la esegue. Rust la richiude quando
    // cambia la bozza mostrata.
    in-out property <bool> publish-armed: false;
    // ELIMINARE CHIEDE CONFERMA (F-22): il dizionario di cui si sta chiedendo,
    // zero quando nessuno.
    in-out property <int> dictionary-delete-armed: 0;
    // Apre una nuova bozza da un dizionario pubblicato (F-07).
    callback start-new-version(int);
    callback preview-dictionary(int);
    callback duplicate-dictionary(int);
    // Esporta la versione pubblicata in un file scelto (GAP-19).
    callback export-dictionary(int);
    // La firma dell'ufficio (SIGN-01 parte 4, ADR-0181, DEC-465).
    callback export-dictionary-signed(int);
    in property <bool> signing-administrator: false;
    in property <bool> signing-available: false;
    in property <bool> signing-has-certificates: false;
    in property <[string]> signing-certificates: [];
    in-out property <int> signing-index: 0;
    in property <string> signing-chosen: "";
    in property <string> signing-register: "";
    in property <string> signing-message: "";
    in-out property <bool> report-sign: false;
    callback signing-choose(int);
    callback signing-remove();
    callback archive-dictionary(int);

    callback page-shown();
    callback filter-sources();
    callback add-source(string);
    callback toggle-source(int, bool);
    callback remove-source(int);

    callback start-login();
    // Comandi distruttivi. La conferma e' nell'interfaccia: il pulsante cambia
    // testo al primo clic e agisce solo al secondo, cosi' che un clic
    // accidentale non cancelli una sessione autorizzata.
    callback remove-account();
    callback reset-accounts();
    callback reset-history();
    callback submit-phone();
    callback submit-code();
    callback submit-password();
    callback cancel-login();

    // Gestione multi-account (M3B.1c).
    callback create-account();
    callback select-account(int);
    callback keep-account-linked();
    callback release-account-linked();
    callback choose-mock();
    callback choose-live();

    // 0 = Dashboard, 1 = Informazioni e licenze, 2 = Account, ..., 9 = Monitoraggio.
    // `in-out` perché Rust vi naviga dopo aver avviato un monitoraggio: la
    // schermata di destinazione dev'essere raggiungibile anche da fuori.
    in-out property <int> current-page: 0;

    // Comandi della barra del titolo. Non li esegue l'interfaccia: li inoltra a
    // `lisi-platform`, che parla con Windows. «Chiudi» in particolare **chiede**
    // la chiusura invece di distruggere la finestra, cosi' che percorra la
    // stessa strada del comando di sistema.
    callback minimise-window();
    callback toggle-maximise-window();
    callback close-window();
    // La domanda prima di chiudere con un monitoraggio in corso
    // (OPERATOR-UX-REMEDIATION-01, OS-09): la apre `closing.rs`.
    in property <bool> close-question-open: false;
    // «Arresta» chiede conferma nella schermata Monitoraggio (OS-09).
    in-out property <bool> monitoring-confirm-stop: false;
    // «Ricomincia l'esercitazione» chiede conferma (OS-09).
    in-out property <bool> exercise-confirm-restart: false;
    callback close-confirmed();
    callback close-withdrawn();

    // Nome pubblico e sottotitolo arrivano da Rust: stanno in `lisi-core`
    // accanto agli identificatori persistenti che NON cambiano con il nome, e
    // un test verifica che i due non si confondano.
    in property <string> product-name: "NEXUM/97";
    in property <string> product-subtitle: "Telegram Intelligence Monitor";
    in property <string> product-description: "Monitoraggio autorizzato di fonti Telegram";

    // L'ESERCITAZIONE (PR-13, ADR-0129). Il modo lo stabilisce il processo
    // all'avvio, e la fascia qui sotto non ha un comando per nasconderla: la
    // sua sola condizione è questa proprietà.
    in property <bool> exercise-mode: false;
    in property <string> exercise-notice: "";
    in property <string> exercise-detail: "";
    in property <string> exercise-message: "";
    callback exercise-restart();

    // ------------------------------------------------ TOUR-01 — comandi, inizio
    // «SCOPRI NEXUM», IL TOUR GUIDATO (TOUR-01, ADR-0134).
    //
    // Il tour MOSTRA E NON TOCCA: le funzioni qui sotto chiamano soltanto
    // `open-page`, che apre una schermata come la aprirebbe la sua voce del
    // menu, e i comandi propri del tour. Una guardia (`crate::tour`) legge
    // questo blocco e il velo, e rifiuta ogni altra chiamata.
    //
    // I passi li prepara Rust, gia' filtrati per modalita' e modo del
    // processo: l'interfaccia non decide chi vede che cosa.
    in property <[TourStepRow]> tour-steps;
    in-out property <bool> tour-active: false;
    in-out property <int> tour-index: 0;
    in-out property <int> tour-origin-page: 0;
    in-out property <bool> tour-panel-open: false;
    // La proposta del primo avvio: Rust dice se proporla (mai proposto, non in
    // Esercitazione); compare soltanto sulla Dashboard operativa, cioe' dopo
    // la risposta alla domanda del primo avvio.
    in-out property <bool> tour-proposal-pending: false;
    out property <bool> tour-proposal-visible: root.tour-proposal-pending
        && DocumentProfile.answered
        && root.current-page == 0
        && !root.tour-active
        && !root.tour-panel-open;
    // «Nuovo» accanto alla voce, e che cosa offre il pannello: 0 avvia,
    // 1 continua o ricomincia, 2 rifai.
    in property <bool> tour-fresh: false;
    in property <int> tour-offer: 0;
    in property <int> tour-step-count: 0;
    // IL GIRO DELLE NOVITÀ (NEWS-01, ADR-0169). Rust prepara le righe e dice se
    // aprirlo da sé; si apre sulla Dashboard operativa dopo la domanda del
    // primo avvio, mai insieme alla proposta del tour.
    in property <[NewsRow]> tour-news-rows;
    in-out property <int> tour-news-index: 0;
    in-out property <bool> tour-news-pending: false;
    in-out property <bool> tour-news-open: false;
    out property <bool> tour-news-visible: root.tour-news-rows.length > 0
        && (root.tour-news-open
            || (root.tour-news-pending
                && DocumentProfile.answered
                && root.current-page == 0
                && !root.tour-active
                && !root.tour-panel-open
                && !root.tour-proposal-visible));

    callback tour-proposal-shown();
    callback tour-proposal-skipped();
    callback tour-proposal-dismissed();
    callback tour-panel-opened();
    // Chiede a Rust di preparare i passi e di avviare: vero = dal passo
    // conservato, falso = dall'inizio.
    callback tour-requested(bool);
    callback tour-step-reached(string);
    callback tour-finished();
    // Il giro è comparso da sé: Rust registra l'edizione vista.
    callback tour-news-shown();
    // «Che cosa è cambiato»: Rust prepara le novità dell'ultima edizione.
    callback tour-news-requested();
    // La collocazione del fumetto: una funzione pura in Rust, provata ai
    // quattro bordi (ADR-0134 §8).
    pure callback tour-place(TourRect, length, length, length, length, length) -> TourPoint;

    // Avvia il tour al passo indicato. La chiama Rust dopo aver preparato i
    // passi.
    public function tour-start(from: int) {
        if (root.tour-steps.length == 0) {
            return;
        }
        if (!root.tour-active) {
            root.tour-origin-page = root.current-page;
        }
        root.tour-panel-open = false;
        root.tour-proposal-pending = false;
        root.tour-active = true;
        root.tour-go(max(0, min(from, root.tour-steps.length - 1)));
        tour-next-button.take-focus();
    }

    function tour-go(index: int) {
        root.tour-index = index;
        if (index == 0 && tour-back-button.has-focus) {
            tour-next-button.take-focus();
        }
        if (root.tour-steps[index].page >= 0) {
            root.open-page(root.tour-steps[index].page);
        }
        root.tour-reveal();
        root.tour-step-reached(root.tour-steps[index].key);
    }

    function tour-forward() {
        if (root.tour-index < root.tour-steps.length - 1) {
            root.tour-go(root.tour-index + 1);
        } else {
            root.tour-finish();
        }
    }

    function tour-backward() {
        if (root.tour-index > 0) {
            root.tour-go(root.tour-index - 1);
        }
    }

    // Esce: il passo e' gia' conservato, e il pannello offrira' di continuare.
    // Si torna alla schermata da cui il tour era partito.
    function tour-exit() {
        root.tour-active = false;
        root.open-page(root.tour-origin-page);
        scopri.take-focus();
    }

    function tour-finish() {
        root.tour-active = false;
        root.tour-finished();
        root.open-page(root.tour-origin-page);
        scopri.take-focus();
    }

    // Tab e Maiusc+Tab girano fra i comandi del fumetto, e non ne escono.
    // «Indietro» al primo passo e' spento, e si salta.
    function tour-cycle(forward: bool) {
        if (tour-next-button.has-focus) {
            if (forward) {
                tour-exit-button.take-focus();
            } else if (root.tour-index > 0) {
                tour-back-button.take-focus();
            } else {
                tour-exit-button.take-focus();
            }
        } else if (tour-exit-button.has-focus) {
            if (!forward) {
                tour-next-button.take-focus();
            } else if (root.tour-index > 0) {
                tour-back-button.take-focus();
            } else {
                tour-next-button.take-focus();
            }
        } else if (tour-back-button.has-focus) {
            if (forward) {
                tour-next-button.take-focus();
            } else {
                tour-exit-button.take-focus();
            }
        } else {
            tour-next-button.take-focus();
        }
    }

    public function tour-open-panel() {
        root.tour-panel-open = true;
        root.tour-panel-opened();
    }

    function tour-close-panel() {
        root.tour-panel-open = false;
        scopri.take-focus();
    }

    // Chiude il giro. Dopo «Apri la schermata» il fuoco resta alla schermata.
    function tour-news-close(to-entry: bool) {
        root.tour-news-open = false;
        root.tour-news-pending = false;
        root.tour-news-index = 0;
        if (to-entry) {
            scopri.take-focus();
        }
    }

    // IL REGISTRO DEI BERSAGLI, dalla parte del disegno: la zona di un passo
    // diventa un elemento vero, e la sua posizione la dice il layout. Nessuna
    // coordinata e' scritta qui ne' nel testo del tour.
    pure function tour-target-rect() -> TourRect {
        if (!root.tour-active || root.tour-steps.length == 0) {
            return { x: 0px, y: 0px, width: 0px, height: 0px };
        }
        if (root.tour-steps[root.tour-index].zone == 2) {
            return {
                x: scopri.absolute-position.x,
                y: scopri.absolute-position.y,
                width: scopri.width,
                height: scopri.height,
            };
        }
        // La testata: account, modalità, avvisi e «Pronto per lavorare», tutto
        // ciò che sta sopra il menu e la schermata.
        if (root.tour-steps[root.tour-index].zone == 3) {
            return {
                x: corpo-finestra.absolute-position.x,
                y: Shell.titlebar-height,
                width: corpo-finestra.width,
                height: max(0px, corpo-finestra.absolute-position.y - Shell.titlebar-height - Spacing.sm),
            };
        }
        if (root.tour-steps[root.tour-index].zone == 1) {
            return {
                x: contenuto.absolute-position.x,
                y: contenuto.absolute-position.y,
                width: contenuto.width,
                height: contenuto.height,
            };
        }
        return root.tour-menu-rect(root.tour-steps[root.tour-index].page);
    }

    // La voce del menu di una schermata.
    pure function tour-menu-rect(page: int) -> TourRect {
        if (page == 0) { return { x: voce-0.absolute-position.x, y: voce-0.absolute-position.y, width: voce-0.width, height: voce-0.height }; }
        if (page == 1) { return { x: voce-1.absolute-position.x, y: voce-1.absolute-position.y, width: voce-1.width, height: voce-1.height }; }
        if (page == 2) { return { x: voce-2.absolute-position.x, y: voce-2.absolute-position.y, width: voce-2.width, height: voce-2.height }; }
        if (page == 3) { return { x: voce-3.absolute-position.x, y: voce-3.absolute-position.y, width: voce-3.width, height: voce-3.height }; }
        if (page == 4) { return { x: voce-4.absolute-position.x, y: voce-4.absolute-position.y, width: voce-4.width, height: voce-4.height }; }
        if (page == 5) { return { x: voce-5.absolute-position.x, y: voce-5.absolute-position.y, width: voce-5.width, height: voce-5.height }; }
        if (page == 6) { return { x: voce-6.absolute-position.x, y: voce-6.absolute-position.y, width: voce-6.width, height: voce-6.height }; }
        if (page == 7) { return { x: voce-7.absolute-position.x, y: voce-7.absolute-position.y, width: voce-7.width, height: voce-7.height }; }
        if (page == 8) { return { x: voce-8.absolute-position.x, y: voce-8.absolute-position.y, width: voce-8.width, height: voce-8.height }; }
        if (page == 9) { return { x: voce-9.absolute-position.x, y: voce-9.absolute-position.y, width: voce-9.width, height: voce-9.height }; }
        if (page == 10) { return { x: voce-10.absolute-position.x, y: voce-10.absolute-position.y, width: voce-10.width, height: voce-10.height }; }
        if (page == 11) { return { x: voce-11.absolute-position.x, y: voce-11.absolute-position.y, width: voce-11.width, height: voce-11.height }; }
        if (page == 12) { return { x: voce-12.absolute-position.x, y: voce-12.absolute-position.y, width: voce-12.width, height: voce-12.height }; }
        if (page == 13) { return { x: voce-13.absolute-position.x, y: voce-13.absolute-position.y, width: voce-13.width, height: voce-13.height }; }
        if (page == 14) { return { x: voce-14.absolute-position.x, y: voce-14.absolute-position.y, width: voce-14.width, height: voce-14.height }; }
        if (page == 15) { return { x: voce-15.absolute-position.x, y: voce-15.absolute-position.y, width: voce-15.width, height: voce-15.height }; }
        if (page == 16) { return { x: voce-16.absolute-position.x, y: voce-16.absolute-position.y, width: voce-16.width, height: voce-16.height }; }
        if (page == 17) { return { x: voce-17.absolute-position.x, y: voce-17.absolute-position.y, width: voce-17.width, height: voce-17.height }; }
        if (page == 18) { return { x: voce-18.absolute-position.x, y: voce-18.absolute-position.y, width: voce-18.width, height: voce-18.height }; }
        if (page == 19) { return { x: voce-19.absolute-position.x, y: voce-19.absolute-position.y, width: voce-19.width, height: voce-19.height }; }
        if (page == 20) { return { x: voce-20.absolute-position.x, y: voce-20.absolute-position.y, width: voce-20.width, height: voce-20.height }; }
        if (page == 21) { return { x: voce-21.absolute-position.x, y: voce-21.absolute-position.y, width: voce-21.width, height: voce-21.height }; }
        if (page == 22) { return { x: voce-22.absolute-position.x, y: voce-22.absolute-position.y, width: voce-22.width, height: voce-22.height }; }
        if (page == 23) { return { x: voce-23.absolute-position.x, y: voce-23.absolute-position.y, width: voce-23.width, height: voce-23.height }; }
        if (page == 24) { return { x: voce-24.absolute-position.x, y: voce-24.absolute-position.y, width: voce-24.width, height: voce-24.height }; }
        if (page == 25) { return { x: voce-25.absolute-position.x, y: voce-25.absolute-position.y, width: voce-25.width, height: voce-25.height }; }
        if (page == 26) { return { x: voce-26.absolute-position.x, y: voce-26.absolute-position.y, width: voce-26.width, height: voce-26.height }; }
        if (page == 27) { return { x: voce-27.absolute-position.x, y: voce-27.absolute-position.y, width: voce-27.width, height: voce-27.height }; }
        if (page == 28) { return { x: voce-28.absolute-position.x, y: voce-28.absolute-position.y, width: voce-28.width, height: voce-28.height }; }
        if (page == 29) { return { x: voce-29.absolute-position.x, y: voce-29.absolute-position.y, width: voce-29.width, height: voce-29.height }; }
        if (page == 30) { return { x: voce-30.absolute-position.x, y: voce-30.absolute-position.y, width: voce-30.width, height: voce-30.height }; }
        if (page == 31) { return { x: voce-31.absolute-position.x, y: voce-31.absolute-position.y, width: voce-31.width, height: voce-31.height }; }
        return { x: contenuto.absolute-position.x, y: contenuto.absolute-position.y, width: contenuto.width, height: contenuto.height };
    }

    // Porta in vista la voce del menu del passo, se lo scorrimento del menu
    // l'ha lasciata fuori.
    function tour-reveal() {
        if (root.tour-steps[root.tour-index].zone != 0) {
            return;
        }
        if (root.tour-target-rect().y < menu-voci.absolute-position.y + 12px) {
            menu-voci.scroll-y = min(0px, menu-voci.scroll-y
                + (menu-voci.absolute-position.y + 12px - root.tour-target-rect().y));
        } else if (root.tour-target-rect().y + root.tour-target-rect().height
            > menu-voci.absolute-position.y + menu-voci.height - 12px) {
            menu-voci.scroll-y = max(menu-voci.view-height - menu-voci.content-height,
                menu-voci.scroll-y - (root.tour-target-rect().y + root.tour-target-rect().height
                    - menu-voci.absolute-position.y - menu-voci.height + 12px));
        }
    }
    // Porta in vista la voce del menu di una schermata, se lo scorrimento del
    // menu l'ha lasciata fuori (OPERATOR-UX-REMEDIATION-01, OS-07). Stesso
    // conto del tour, per una schermata qualunque.
    function menu-reveal(page: int) {
        if (root.tour-menu-rect(page).y < menu-voci.absolute-position.y) {
            menu-voci.scroll-y = min(0px, menu-voci.scroll-y
                + (menu-voci.absolute-position.y + 12px - root.tour-menu-rect(page).y));
        } else if (root.tour-menu-rect(page).y + root.tour-menu-rect(page).height
            > menu-voci.absolute-position.y + menu-voci.height) {
            menu-voci.scroll-y = max(menu-voci.view-height - menu-voci.content-height,
                menu-voci.scroll-y - (root.tour-menu-rect(page).y + root.tour-menu-rect(page).height
                    - menu-voci.absolute-position.y - menu-voci.height + 12px));
        }
    }
    // Dove portare lo scorrimento delle Impostazioni perche' una sezione stia in
    // cima (SIM3-13). Le due posizioni assolute si spostano insieme con lo
    // scorrimento: la loro differenza e' la distanza fissa della sezione
    // dall'inizio della pagina. Mai oltre la fine.
    pure function settings-scroll-target(sezione: length, inizio: length, vista: length, contenuto: length) -> length {
        return max(min(0px, vista - contenuto), -(sezione - inizio));
    }
    // Porta in cima alla parte visibile della schermata un riquadro che si e'
    // appena aperto sotto un elenco: la cronologia di un gruppo, la bozza di
    // un dizionario (CU01-014, DEC-507). `elemento` e' la sua posizione
    // assoluta; la distanza dalla cima della parte visibile e' quanto scorrere.
    // Mai oltre la fine, mai prima dell'inizio.
    //
    // SI CHIEDE CON `*-da-mostrare` E SI FA AL GIRO DOPO, con il `Timer` della
    // schermata: nel gestore del clic l'altezza della schermata non comprende
    // ancora il riquadro appena aperto, e lo scorrimento si fermava alla fine
    // di prima, con il riquadro appena sotto il bordo (visto con la prova, il
    // 2026-11-16). Stessa ragione del salto alle sezioni delle Impostazioni.
    property <bool> cronologia-da-mostrare: false;
    property <bool> bozza-da-mostrare: false;
    function porta-in-vista(elemento: length) {
        schermata.scroll-y = max(min(0px, schermata.view-height - schermata.content-height),
            min(0px, schermata.scroll-y - (elemento - schermata.absolute-position.y)));
    }
    // ------------------------------------------------ TOUR-01 — comandi, fine
    // L'UNICO MODO DI APRIRE UNA SCHERMATA (PR-14, ADR-0130): imposta la pagina
    // e chiede ai servizi di aggiornarla. Lo usano le voci del menu e l'avvio
    // con `--pagina=N`; una guardia verifica che ogni schermata dichiarata vi
    // abbia il suo ramo.
    // LE FRECCE NEL MENU (F-15): l'ordine e' quello in cui le voci si leggono.
    function menu-step(page: int, delta: int) {
        root.menu-focus(root.menu-neighbour(page, delta));
        root.menu-reveal(root.menu-neighbour(page, delta));
    }

    pure function menu-neighbour(page: int, delta: int) -> int {
        if (page == 0) { return delta > 0 ? 6 : 0; }
        if (page == 6) { return delta > 0 ? 9 : 0; }
        if (page == 9) { return delta > 0 ? 7 : 6; }
        if (page == 7) { return delta > 0 ? 18 : 9; }
        if (page == 18) { return delta > 0 ? 13 : 7; }
        if (page == 13) { return delta > 0 ? 16 : 18; }
        if (page == 16) { return delta > 0 ? 8 : 13; }
        if (page == 8) { return delta > 0 ? 20 : 16; }
        if (page == 20) { return delta > 0 ? 21 : 8; }
        if (page == 21) { return delta > 0 ? 22 : 20; }
        if (page == 22) { return delta > 0 ? 23 : 21; }
        if (page == 23) { return delta > 0 ? 15 : 22; }
        if (page == 15) { return delta > 0 ? 12 : 23; }
        if (page == 12) { return delta > 0 ? 14 : 15; }
        if (page == 14) { return delta > 0 ? 30 : 12; }
        if (page == 30) { return delta > 0 ? 25 : 14; }
        if (page == 25) { return delta > 0 ? 31 : 30; }
        if (page == 31) { return delta > 0 ? 3 : 25; }
        if (page == 3) { return delta > 0 ? 26 : 31; }
        if (page == 26) { return delta > 0 ? 4 : 3; }
        if (page == 4) { return delta > 0 ? 19 : 26; }
        if (page == 19) { return delta > 0 ? 24 : 4; }
        if (page == 24) { return delta > 0 ? 2 : 19; }
        if (page == 2) { return delta > 0 ? 5 : 24; }
        if (page == 5) { return delta > 0 ? 17 : 2; }
        if (page == 17) { return delta > 0 ? 11 : 5; }
        if (page == 11) { return delta > 0 ? 27 : 17; }
        if (page == 27) { return delta > 0 ? 28 : 11; }
        if (page == 28) { return delta > 0 ? 29 : 27; }
        if (page == 29) { return delta > 0 ? 10 : 28; }
        if (page == 10) { return delta > 0 ? 1 : 29; }
        if (page == 1) { return delta > 0 ? 1 : 10; }
        return page;
    }

    function menu-focus(page: int) {
        if (page == 0) { voce-0.take-focus(); }
        if (page == 6) { voce-6.take-focus(); }
        if (page == 9) { voce-9.take-focus(); }
        if (page == 7) { voce-7.take-focus(); }
        if (page == 18) { voce-18.take-focus(); }
        if (page == 13) { voce-13.take-focus(); }
        if (page == 16) { voce-16.take-focus(); }
        if (page == 8) { voce-8.take-focus(); }
        if (page == 20) { voce-20.take-focus(); }
        if (page == 21) { voce-21.take-focus(); }
        if (page == 22) { voce-22.take-focus(); }
        if (page == 23) { voce-23.take-focus(); }
        if (page == 15) { voce-15.take-focus(); }
        if (page == 12) { voce-12.take-focus(); }
        if (page == 14) { voce-14.take-focus(); }
        if (page == 30) { voce-30.take-focus(); }
        if (page == 25) { voce-25.take-focus(); }
        if (page == 31) { voce-31.take-focus(); }
        if (page == 3) { voce-3.take-focus(); }
        if (page == 26) { voce-26.take-focus(); }
        if (page == 4) { voce-4.take-focus(); }
        if (page == 19) { voce-19.take-focus(); }
        if (page == 24) { voce-24.take-focus(); }
        if (page == 2) { voce-2.take-focus(); }
        if (page == 5) { voce-5.take-focus(); }
        if (page == 17) { voce-17.take-focus(); }
        if (page == 11) { voce-11.take-focus(); }
        if (page == 27) { voce-27.take-focus(); }
        if (page == 28) { voce-28.take-focus(); }
        if (page == 29) { voce-29.take-focus(); }
        if (page == 10) { voce-10.take-focus(); }
        if (page == 1) { voce-1.take-focus(); }
    }

    // Una schermata diversa sta per aprirsi: Rust toglie gli esiti dei comandi (F-27).
    callback page-opened(int);

    public function open-page(page: int) {
        // LA CONVERSAZIONE SI CHIUDE CON UNA VOCE DEL MENU (ADR-0151): sta
        // sopra la schermata da cui si e' partiti, e una schermata nuova non
        // le sta sotto.
        if (root.conversation-open) {
            root.conversation-close();
        }
        // UN MESSAGGIO APERTO NON SEGUE L'OPERATORE IN UN'ALTRA SCHERMATA
        // (OPERATOR-UX-REMEDIATION-01, OS-01): da Avvisi a Storico il
        // dettaglio restava aperto, e l'elenco senza spazio. Scegliere di nuovo
        // la riga aperta la chiude, con i pannelli che porta.
        if (page != root.current-page && root.selected-content >= 0) {
            root.select-content(root.selected-content);
        }
        // Gli esiti dell'ultima azione restano nella loro schermata (F-27).
        if (page != root.current-page) {
            root.page-opened(page);
        }
        root.monitoring-confirm-stop = false;
        root.current-page = page;
        // La voce attiva resta in vista nel menu (OS-07): aperta da un
        // collegamento, la sua voce poteva restare sotto il bordo.
        root.menu-reveal(page);
        if (page == 0) {
            root.dashboard-shown();
        } else if (page == 3) {
            root.page-shown();
        } else if (page == 4) {
            root.dictionaries-shown();
        } else if (page == 6) {
            root.wizard-shown();
        } else if (page == 7) {
            root.history-shown();
        } else if (page == 8) {
            root.history-shown();
        } else if (page == 9) {
            root.monitoring-shown();
        } else if (page == 11) {
            root.settings-shown();
            // Le organizzazioni sorvegliate stanno nelle Impostazioni, e si
            // rileggevano solo all'avvio (FINAL-REVIEW-01, FR-052).
            root.organisations-shown();
        } else if (page == 12) {
            root.verification-shown();
        } else if (page == 13) {
            root.notifications-shown();
        } else if (page == 14) {
            root.participants-shown();
            root.persons-shown();
        } else if (page == 15) {
            root.report-shown();
        } else if (page == 16) {
            root.cyber-shown();
        } else if (page == 17) {
            root.diagnostics-shown();
        } else if (page == 18) {
            root.work-queue-shown();
        } else if (page == 19) {
            root.lab-shown();
        } else if (page == 20) {
            root.workspaces-shown();
        } else if (page == 21) {
            root.bookmarks-shown();
        } else if (page == 22) {
            root.notes-shown();
        } else if (page == 23) {
            root.searches-shown();
        } else if (page == 24) {
            root.templates-shown();
        } else if (page == 25) {
            root.graph-shown();
        } else if (page == 26) {
            root.discovery-shown();
        } else if (page == 27) {
            root.team-live-shown();
        } else if (page == 28) {
            root.review-shown();
        } else if (page == 29) {
            root.shared-shown();
        } else if (page == 30) {
            root.resolver-shown();
        } else if (page == 31) {
            root.references-shown();
        }
    }

    title: (root.exercise-mode ? @tr("ESERCITAZIONE \u{2014} ") : "") + root.product-name + " \u{2014} " + root.product-subtitle;
    preferred-width: 1120px;
    preferred-height: 720px;
    // LA MISURA MINIMA E' QUELLA IN CUI IL PRODOTTO E' STATO GUARDATO
    // (FINAL-FPR-ALL-16, FPR-16).
    //
    // Diceva 900×600, e a 900×600 non era mai stato guardato: la relazione
    // tecnica dichiarava di aver visto lì la Dashboard e il tour, e nient'altro.
    // Fra ciò che il prodotto consentiva e ciò che era stato provato c'era uno
    // scalino, e OPERATOR-SIM-02 ci è caduto dentro (F-15, R-01).
    //
    // Misurato il 2026-10-12, in Esercitazione — che è il caso peggiore,
    // perché la fascia dell'esercitazione occupa altezza che nel modo
    // operativo non c'è, e il pilot comincia in Esercitazione:
    //
    // | misura  | che cosa si vedeva                                     |
    // |---------|--------------------------------------------------------|
    // | 900×600 | «Indietro» e «Avanti» del wizard tagliati in basso     |
    // | 900×640 | i comandi interi, il bordo del pannello a filo         |
    // | 900×660 | il wizard pulito; il Monitoraggio taglia «Operativo»   |
    // | 1000×660| tutto dentro, su wizard, relazione, Monitoraggio,       |
    // |         | Impostazioni                                           |
    //
    // Quindi 1000×660, non 900×600, e non per prudenza: per misura. Su un
    // portatile da 1366×768 — la misura piccola più diffusa — una finestra di
    // 1000×660 sta dentro lo schermo con la barra delle applicazioni.
    //
    // La larghezza è scesa a 1000 e non è rimasta a 1120 grazie a una
    // correzione: la barra dei passi dei due wizard non impone più la propria
    // larghezza naturale.
    //
    // Questo è il minimo che **Windows impone** quando una persona trascina il
    // bordo. Un ridimensionamento fatto da un programma può andare sotto, ed è
    // così che le catture di questa misurazione sono state prese.
    min-width: 1000px;
    min-height: 660px;
    background: Palette.void;

    // LA REGOLA DEL FUOCO (A11Y-02, ADR-0194): vedere `FocusRule`.
    //
    // `ripresa-avanti` e `ripresa-indietro` sono il primo e l'ultimo elemento
    // della finestra: un Tab senza fuoco arriva a uno dei due. Lo segnano qui,
    // e il temporizzatore porta il fuoco all'inizio della schermata al giro
    // dopo, non dentro il passaggio del fuoco che Slint sta ancora facendo.
    property <bool> resume-pending: false;
    property <bool> screen-start-armed: false;

    function resume-at-screen-start() {
        root.resume-pending = false;
        root.screen-start-armed = true;
        inizio-schermata.focus();
        FocusRule.resumed += 1;
    }

    // Il segno del Tab lo accendono i comandi che lo ricevono (`FocusRule`);
    // si spegne qui, al giro dopo, quando il fuoco si e' gia' spostato.
    Timer {
        interval: Motion.settle;
        running: FocusRule.navigating;
        triggered => {
            FocusRule.navigating = false;
        }
    }

    Timer {
        interval: Motion.settle;
        running: root.resume-pending;
        triggered => {
            root.resume-at-screen-start();
        }
    }

    // Il primo elemento della finestra: il Tab senza fuoco parte da qui.
    ripresa-avanti := FocusScope {
        x: 0px;
        y: 0px;
        width: 0px;
        height: 0px;
        enabled: !FocusRule.navigating && !root.station-locked;
        focus-on-click: false;
        focus-gained(reason) => {
            root.resume-pending = true;
        }

        // Tiene il fuoco solo fino al giro dopo, e intanto lo mostra: un
        // anello attorno alla finestra.
        Rectangle {
            x: 0px;
            y: 0px;
            width: root.width;
            height: root.height;
            background: transparent;
            border-width: parent.has-focus ? 2px : 0px;
            border-color: Palette.focus;
        }
    }

    VerticalLayout {
        // A POSTAZIONE BLOCCATA IL LAVORO NON C'E' (OPERATOR-E2E-REMEDIATION-01,
        // F-01). Non e' coperto: e' nascosto. Un elemento nascosto non si
        // disegna, non riceve il puntatore, e il Tab non ci passa; il fuoco che
        // ci stava viene tolto. La schermata di blocco copriva soltanto, e il
        // Tab portava il fuoco sotto la copertura: da li' Invio azionava i comandi.
        // Resta tutto in memoria - campi, scelte, schermata - e allo sblocco
        // ricompare com'era.
        visible: !root.station-locked;

        // In alto si lascia posto alla barra del titolo del prodotto, che e'
        // sovrapposta e non fa parte di questo layout: l'area cliente comprende
        // ora anche lo spazio dove Windows disegnava la didascalia, e senza
        // questo riempimento il contenuto ci finirebbe sotto.
        // Margini e spaziatura stretti (UX-EXCELLENCE-02, SIM3-04): erano 24 e
        // 18 pixel fra ogni fascia, e sommati alle fasce lasciavano il lavoro
        // sotto un terzo della finestra.
        padding-top: Shell.titlebar-height + Spacing.md;
        padding-left: Spacing.lg;
        padding-right: Spacing.lg;
        padding-bottom: Spacing.md;
        spacing: Spacing.sm;

        // LA FASCIA DELL'ESERCITAZIONE: in cima a ogni schermata, fuori da ogni
        // pagina, senza comando per chiuderla (PR-13, ADR-0129). Il testo è
        // quello di SIC-17, e arriva da Rust.
        //
        // IL COMANDO STA SULLA RIGA DELLA FASCIA (FINAL-REVIEW-01, FR-030): su
        // una riga sua occupava un'altezza intera per un pulsante solo, e alla
        // misura predefinita della finestra il menu ne restava senza. Il
        // messaggio dell'esito compare sotto solo quando c'è.
        if root.exercise-mode: Rectangle {
            // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
            min-height: fascia-esercitazione.preferred-height;
            fascia-esercitazione := VerticalLayout {
                vertical-stretch: 0;
                spacing: Spacing.sm;
                HorizontalLayout {
                    spacing: Spacing.md;
                    AvvertenzaDiSicurezza {
                        horizontal-stretch: 1;
                        codice: "SIC-17";
                        testo: root.exercise-notice;
                        dettaglio: root.exercise-detail;
                        // Una riga sola (UX-EXCELLENCE-02, SIM3-04): stesso testo,
                        // sempre visibile, dettaglio a un clic.
                        compatta: true;
                    }
                    VerticalLayout {
                        horizontal-stretch: 0;
                        alignment: center;
                        // Ricominciare cancella il lavoro di prova al prossimo
                        // avvio: chiede conferma (OPERATOR-UX-REMEDIATION-01, OS-09).
                        if !root.exercise-confirm-restart: HudButton {
                            label: @tr("Ricomincia l'esercitazione");
                            clicked => {
                                root.exercise-confirm-restart = true;
                            }
                        }
                    }
                }
                if root.exercise-confirm-restart: Rectangle {
                    // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                    min-height: rip-21.preferred-height;
                    rip-21 := HorizontalLayout {
                        spacing: Spacing.md;
                        Text {
                            text: @tr("Ricominciare da capo? Al prossimo avvio decisioni, note e raccoglitori di prova si cancellano e tornano i dati iniziali.");
                            color: Palette.text;
                            font-size: Typography.body-secondary;
                            vertical-alignment: center;
                            wrap: word-wrap;
                            horizontal-stretch: 1;
                        }
                        HudButton {
                            label: @tr("Annulla");
                            clicked => {
                                root.exercise-confirm-restart = false;
                            }
                        }
                        HudButton {
                            label: @tr("Sì, ricomincia");
                            weight: Weight.danger;
                            clicked => {
                                root.exercise-confirm-restart = false;
                                root.exercise-restart();
                            }
                        }
                    }
                }
                if root.exercise-message != "": Text {
                    text: root.exercise-message;
                    color: Palette.text;
                    font-size: Typography.body-secondary;
                    wrap: word-wrap;
                }
            }
        }

        // LA FASCIA DEL PROGRAMMA PARTITO DA UNA CHIAVETTA (PORTABLE-01,
        // ADR-0176): in cima a ogni schermata come quella dell'Esercitazione,
        // fuori dalla pila che scorre, perché dice dove restano i dati.
        if root.launch-volume-notice != "": Rectangle {
            vertical-stretch: 0;
            background: Palette.accent-surface;
            border-radius: Spacing.radius-panel;

            // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
            min-height: rip-198.preferred-height;
            rip-198 := HorizontalLayout {
                padding: 10px;
                spacing: Spacing.sm;

                Rectangle {
                    width: 9px;
                    height: 9px;
                    horizontal-stretch: 0;
                    vertical-stretch: 0;
                    y: 6px;
                    background: Palette.frame-dim;
                    border-radius: Spacing.radius-row;
                }

                Text {
                    text: root.launch-volume-notice;
                    color: Palette.text;
                    font-size: Typography.body-secondary;
                    wrap: word-wrap;
                    horizontal-stretch: 1;
                }
            }

            accessible-role: text;
            accessible-label: root.launch-volume-notice;
        }

        // LA TESTATA DEL MARCHIO NON C'E' PIU' (UX-EXCELLENCE-02, SIM3-04).
        //
        // Era una fascia di 64 pixel su ogni schermata: il marchio e il nome
        // del prodotto, che la barra del titolo mostra gia', e due pastiglie -
        // «Nessun account», «Modalità amministratore» - che sembravano pulsanti
        // e non facevano nulla (SIM3-16). Con la fascia dell'Esercitazione e
        // quella di prontezza, sopra il lavoro restavano circa 300 pixel di
        // cornice: a 1000×660 l'elenco delle fonti non mostrava una riga intera.
        //
        // Account e modalità sono ora testo nella barra del titolo
        // (`TitleBar.status`); «Blocca» sta in fondo al menu, accanto a «Scopri
        // NEXUM», sempre visibile come prima.

        // GLI AVVISI HANNO UN'ALTEZZA MASSIMA, E SCORRONO (FINAL-REVIEW-01,
        // FR-030).
        //
        // Ripiego dell'archivio, azzeramento, monitoraggio interrotto e riga
        // «Pronto per lavorare» si sommavano senza limite sopra il corpo della
        // finestra. Alla misura predefinita (1120×720), in Esercitazione e con
        // due avvisi, il menu si riduceva a due voci e un avviso si leggeva a
        // metà riga; alla misura minima il menu e «Scopri NEXUM» uscivano dalla
        // finestra. Ora gli avvisi stanno in una zona che non supera un quarto
        // della finestra né ciò che resta lasciando al corpo il suo spazio, e
        // si scorrono; il corpo resta sempre raggiungibile.
        //
        // La fascia dell'Esercitazione NON sta qui: resta sempre visibile
        // (SIC-17, ADR-0129).
        if root.storage-fallback-notice != ""
            || root.archive-reset-notice != ""
            || root.archive-reset-pending-notice != ""
            || root.monitoring-interruption-notice != ""
            || root.preflight-shown: Rectangle {
            // Mai più alta di ciò che contiene, mai più bassa di una riga d'avviso;
            // fra le due decide il layout, che al corpo garantisce il suo minimo.
            vertical-stretch: 1;
            min-height: min(72px, pila-avvisi.preferred-height);
            preferred-height: min(pila-avvisi.preferred-height, 180px);
            max-height: pila-avvisi.preferred-height;

            HudScroll {
                width: 100%;
                height: 100%;

                pila-avvisi := VerticalLayout {
                    spacing: Spacing.lg;

        // Avviso di ripiego dell'archivio (M3B.2): non bloccante, visibile su
        // ogni schermata finche' resta valido, senza dettagli tecnici.
        if root.storage-fallback-notice != "": Rectangle {
            vertical-stretch: 0;
            background: Palette.accent-surface;
            border-radius: Spacing.radius-panel;

            // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
            min-height: rip-22.preferred-height;
            rip-22 := HorizontalLayout {
                padding: 14px;
                spacing: Spacing.sm;

                Rectangle {
                    width: 9px;
                    height: 9px;
                    horizontal-stretch: 0;
                    vertical-stretch: 0;
                    y: 6px;
                    background: Palette.frame-dim;
                    border-radius: Spacing.radius-row;
                }

                Text {
                    text: root.storage-fallback-notice;
                    color: Palette.text;
                    font-size: Typography.body-secondary;
                    wrap: word-wrap;
                    horizontal-stretch: 1;
                }
            }

            accessible-role: text;
            accessible-label: root.storage-fallback-notice;
        }

        // Un azzeramento eseguito a questo avvio, oppure richiesto e ancora da
        // compiere. Stessa fascia dell'avviso di ripiego, colore d'errore: non
        // e' una condizione degradata, e' una cancellazione.
        if root.archive-reset-notice != "" || root.archive-reset-pending-notice != "": Rectangle {
            vertical-stretch: 0;
            background: Palette.danger-surface;
            border-radius: Spacing.radius-panel;

            // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
            min-height: rip-23.preferred-height;
            rip-23 := HorizontalLayout {
                padding: 14px;
                spacing: Spacing.sm;

                Rectangle {
                    width: 9px;
                    height: 9px;
                    horizontal-stretch: 0;
                    vertical-stretch: 0;
                    y: 6px;
                    background: Palette.coral;
                    border-radius: Spacing.radius-row;
                }

                Text {
                    text: root.archive-reset-notice != "" ? root.archive-reset-notice : root.archive-reset-pending-notice;
                    color: Palette.text;
                    font-size: Typography.body-secondary;
                    wrap: word-wrap;
                    horizontal-stretch: 1;
                }
            }

            accessible-role: text;
            accessible-label: root.archive-reset-notice != "" ? root.archive-reset-notice : root.archive-reset-pending-notice;
        }

        // Un monitoraggio interrotto: non e' un guasto e non e' una perdita,
        // ma c'e' un buco e qualcuno deve saperlo (ADR-0064).
        if root.monitoring-interruption-notice != "": Rectangle {
            vertical-stretch: 0;
            background: Palette.warning-surface;
            border-radius: Spacing.radius-panel;

            // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
            min-height: rip-24.preferred-height;
            rip-24 := HorizontalLayout {
                padding: 14px;
                spacing: Spacing.sm;

                Rectangle {
                    width: 9px;
                    height: 9px;
                    horizontal-stretch: 0;
                    vertical-stretch: 0;
                    y: 6px;
                    background: Palette.amber;
                    border-radius: Spacing.radius-row;
                }

                Text {
                    text: root.monitoring-interruption-decision == "" ? root.monitoring-interruption-notice : root.monitoring-interruption-notice + " " + root.monitoring-interruption-decision;
                    color: Palette.text;
                    font-size: Typography.body-secondary;
                    wrap: word-wrap;
                    horizontal-stretch: 1;
                }

                HudButton {
                    horizontal-stretch: 0;
                    label: root.monitoring-interruption-action;
                    clicked => {
                        root.acknowledge-interruption();
                    }
                }
            }

            accessible-role: text;
            accessible-label: root.monitoring-interruption-notice + " " + root.monitoring-interruption-decision;
        }

        // PRONTO PER LAVORARE (PR-04, ADR-0120).
        //
        // Una riga sola: «Pronto per lavorare.» oppure «Non ancora: …», con
        // che cosa fare e dove. Non blocca nulla e non ripara nulla: il
        // pulsante cambia pagina e basta, e la pagina ha i suoi controlli.
        if root.preflight-shown: Rectangle {
            vertical-stretch: 0;
            background: root.preflight-ready ? Palette.panel-inset : Palette.warning-surface;
            border-radius: Spacing.radius-panel;

            // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
            min-height: rip-25.preferred-height;
            rip-25 := HorizontalLayout {
                // Piu' bassa quando e' pronta (SIM3-04): la riga verde non chiede nulla,
                // e non deve costare quanto un avviso.
                padding: root.preflight-ready ? Spacing.xxs : 14px;
                padding-left: 14px;
                padding-right: root.preflight-ready ? Spacing.xxs : 14px;
                spacing: Spacing.sm;

                Rectangle {
                    width: 9px;
                    height: 9px;
                    horizontal-stretch: 0;
                    vertical-stretch: 0;
                    y: 6px;
                    background: root.preflight-ready ? Palette.cyan : Palette.amber;
                    border-radius: Spacing.radius-row;
                }

                VerticalLayout {
                    spacing: Spacing.xs;
                    horizontal-stretch: 1;
                    alignment: center;

                    Text {
                        text: root.preflight-line;
                        color: Palette.text;
                        font-size: Typography.body-secondary;
                        font-weight: root.preflight-ready ? Typography.regular : Typography.medium;
                        wrap: word-wrap;
                    }
                    if root.preflight-what-to-do != "": Text {
                        text: @tr("Che cosa fare: {}", root.preflight-what-to-do);
                        color: Palette.text-muted;
                        font-size: Typography.group-label;
                        wrap: word-wrap;
                    }
                }

                // Porta alla pagina dove il gesto si compie. SOLO la pagina:
                // nessun comando della pagina si esegue da qui.
                if root.preflight-go-page >= 0: HudButton {
                    horizontal-stretch: 0;
                    label: root.preflight-go-label;
                    clicked => {
                        root.settings-jump-section = root.preflight-go-section;
                        root.open-page(root.preflight-go-page);
                    }
                }
                HudButton {
                    horizontal-stretch: 0;
                    label: @tr("Ricontrolla");
                    clicked => {
                        root.preflight-rerun();
                    }
                }
            }

            accessible-role: text;
            accessible-label: root.preflight-line;
        }
                }
            }
        }

        corpo-finestra := HorizontalLayout {
            // IL CORPO HA UN'ALTEZZA MINIMA GARANTITA (FINAL-REVIEW-01, FR-030):
            // quanto basta perché la colonna del menu mostri la sua testata, almeno
            // qualche voce che scorre e «Scopri NEXUM». Lo spazio che manca lo cedono
            // gli avvisi, che scorrono.
            min-height: 230px;
            vertical-stretch: 4;
            // Nessuna spaziatura: la navigazione e il contenuto si toccano, e
            // la distanza la fa il riempimento del contenuto. Valeva 18px, che
            // lasciavano una striscia di fondo finestra fra le due colonne -
            // nel riferimento approvato quella striscia non c'e'.
            spacing: 0px;

            Rectangle {
                // 252 px, la misura del riferimento approvato.
                //
                // Ha valso 230, poi 268: le icone accanto alle parole (20 px
                // piu' 8 di spaziatura) tagliavano «Nuovo monitoraggio» e
                // «Informazioni e licenze» contro il bordo, e la colonna era
                // stata allargata invece di accorciare le voci.
                //
                // **Le icone sono uscite** (DEC-135), e con esse la ragione dei
                // 268: senza il segno accanto, le due voci lunghe rientrano
                // nella misura approvata. Chi le rimettesse dovrebbe rifare
                // questo conto, non riallargare la colonna per riflesso.
                width: Shell.sidebar-width;
                horizontal-stretch: 0;
                // La navigazione non e' un pannello: e' la cornice fissa
                // dell'applicazione, e prende la superficie che le spetta.
                // Senza raggio, perche' una colonna a tutta altezza con gli
                // angoli tondi si stacca dalla finestra come un riquadro che
                // galleggia.
                background: Palette.chrome;

                VerticalLayout {
                    // In alto 18 pixel e non 32, e niente etichetta
                    // «NAVIGAZIONE» (UX-EXCELLENCE-02, SIM3-04): il menu e' il
                    // menu, e ogni riga guadagnata qui e' una voce in piu' che
                    // si vede senza scorrere.
                    padding-top: Spacing.lg;
                    padding-left: Shell.sidebar-pad-side;
                    padding-right: Shell.sidebar-pad-side;
                    padding-bottom: Spacing.md;
                    spacing: 6px;

                    // Le voci scorrono. Senza, la loro somma fissa supera
                    // l'altezza minima della finestra e trascina l'intera riga
                    // di contenuto oltre il bordo: a farne le spese sono i
                    // comandi in fondo alle schermate, che spariscono senza che
                    // nulla lo segnali.
                    menu-voci := HudScroll {
                        vertical-stretch: 1;

                        VerticalLayout {
                            spacing: 2px;

                    // I GRUPPI, NELL'ORDINE DEL LAVORO DI TUTTI I GIORNI
                    // (UX-EXCELLENCE-02, SIM3-04; ADR-0138, che aggiorna
                    // ADR-0130).
                    //
                    // Prima c'era PREPARARE con nove comandi - fonti, dizionari,
                    // laboratorio, postazione, impostazioni - e Monitoraggio,
                    // Avvisi, Coda di lavoro, Storico e Report stavano sotto: si
                    // scorreva il menu a ogni turno, anche a schermo intero. Ora
                    // in cima c'e' cio' che si fa ogni giorno - sorvegliare,
                    // esaminare, produrre - e sotto cio' che si approfondisce
                    // quando un caso lo chiede, si prepara una volta o si
                    // amministra. Nessuna voce e' sparita, nessuna schermata e'
                    // cambiata.
                    //
                    // Ogni voce apre la sua schermata con `open-page`, l'unico
                    // modo di aprirne una: non esiste un secondo elenco «numero
                    // → aggiornamento» che possa divergere.

                    NavigationGroup {
                        text: @tr("QUADRO");
                    }
                    voce-0 := NavigationItem {
                        step(d) => {
                            root.menu-step(0, d);
                        }
                        label: @tr("Cruscotto");
                        active: root.current-page == 0;
                        activated => {
                            root.open-page(0);
                        }
                    }

                    NavigationGroup {
                        text: @tr("SORVEGLIARE");
                    }
                    voce-6 := NavigationItem {
                        step(d) => {
                            root.menu-step(6, d);
                        }
                        label: @tr("Nuovo monitoraggio");
                        active: root.current-page == 6;
                        activated => {
                            root.open-page(6);
                        }
                    }
                    voce-9 := NavigationItem {
                        step(d) => {
                            root.menu-step(9, d);
                        }
                        label: @tr("Monitoraggio");
                        active: root.current-page == 9;
                        activated => {
                            root.open-page(9);
                        }
                    }
                    voce-7 := NavigationItem {
                        step(d) => {
                            root.menu-step(7, d);
                        }
                        // «Avvisi», non «Alert» (OPERATOR-UX-REMEDIATION-01, OS-07).
                        label: @tr("Avvisi");
                        active: root.current-page == 7;
                        activated => {
                            root.open-page(7);
                        }
                    }
                    // Subito dopo Avvisi: gli avvisi sono di UNA sessione, la coda
                    // attraversa tutte quelle che hanno lasciato lavoro.
                    voce-18 := NavigationItem {
                        step(d) => {
                            root.menu-step(18, d);
                        }
                        label: @tr("Coda di lavoro");
                        active: root.current-page == 18;
                        activated => {
                            root.open-page(18);
                        }
                    }
                    voce-13 := NavigationItem {
                        step(d) => {
                            root.menu-step(13, d);
                        }
                        label: @tr("Notifiche");
                        active: root.current-page == 13;
                        activated => {
                            root.open-page(13);
                        }
                    }
                    voce-16 := NavigationItem {
                        step(d) => {
                            root.menu-step(16, d);
                        }
                        label: @tr("Segnali cyber");
                        active: root.current-page == 16;
                        activated => {
                            root.open-page(16);
                        }
                    }

                    NavigationGroup {
                        text: @tr("ESAMINARE");
                    }
                    voce-8 := NavigationItem {
                        step(d) => {
                            root.menu-step(8, d);
                        }
                        label: @tr("Storico");
                        active: root.current-page == 8;
                        activated => {
                            root.open-page(8);
                        }
                    }
                    voce-20 := NavigationItem {
                        step(d) => {
                            root.menu-step(20, d);
                        }
                        label: @tr("Raccoglitori");
                        active: root.current-page == 20;
                        activated => {
                            root.open-page(20);
                        }
                    }
                    voce-21 := NavigationItem {
                        step(d) => {
                            root.menu-step(21, d);
                        }
                        label: @tr("Segnalibri");
                        active: root.current-page == 21;
                        activated => {
                            root.open-page(21);
                        }
                    }
                    voce-22 := NavigationItem {
                        step(d) => {
                            root.menu-step(22, d);
                        }
                        label: @tr("Note");
                        active: root.current-page == 22;
                        activated => {
                            root.open-page(22);
                        }
                    }
                    voce-23 := NavigationItem {
                        step(d) => {
                            root.menu-step(23, d);
                        }
                        label: @tr("Ricerche");
                        active: root.current-page == 23;
                        activated => {
                            root.open-page(23);
                        }
                    }

                    NavigationGroup {
                        text: @tr("PRODURRE");
                    }
                    // Riaccesa in MP-18G: l'unico punto del programma da cui il
                    // generatore `.docx` si raggiunge.
                    voce-15 := NavigationItem {
                        step(d) => {
                            root.menu-step(15, d);
                        }
                        label: @tr("Report");
                        active: root.current-page == 15;
                        activated => {
                            root.open-page(15);
                        }
                    }
                    voce-12 := NavigationItem {
                        step(d) => {
                            root.menu-step(12, d);
                        }
                        label: @tr("Verifica");
                        active: root.current-page == 12;
                        activated => {
                            root.open-page(12);
                        }
                    }

                    // APPROFONDIRE: persone e riferimenti, che si aprono quando
                    // un caso lo chiede. La ricerca puntuale sta accanto a
                    // Persone, e non dentro: trovare un profilo non e'
                    // aggiungerlo a una scheda (PR-09, PR-10).
                    NavigationGroup {
                        text: @tr("APPROFONDIRE");
                    }
                    voce-14 := NavigationItem {
                        step(d) => {
                            root.menu-step(14, d);
                        }
                        label: @tr("Persone");
                        active: root.current-page == 14;
                        activated => {
                            root.open-page(14);
                        }
                    }
                    voce-30 := NavigationItem {
                        step(d) => {
                            root.menu-step(30, d);
                        }
                        label: @tr("Ricerca puntuale");
                        active: root.current-page == 30;
                        activated => {
                            root.open-page(30);
                        }
                    }
                    voce-25 := NavigationItem {
                        step(d) => {
                            root.menu-step(25, d);
                        }
                        label: @tr("Grafo");
                        active: root.current-page == 25;
                        activated => {
                            root.open-page(25);
                        }
                    }
                    voce-31 := NavigationItem {
                        step(d) => {
                            root.menu-step(31, d);
                        }
                        label: @tr("Riferimenti informatici");
                        active: root.current-page == 31;
                        activated => {
                            root.open-page(31);
                        }
                    }

                    NavigationGroup {
                        text: @tr("PREPARARE");
                    }
                    voce-3 := NavigationItem {
                        step(d) => {
                            root.menu-step(3, d);
                        }
                        label: @tr("Fonti");
                        active: root.current-page == 3;
                        activated => {
                            root.open-page(3);
                        }
                    }
                    // Accanto alle Fonti: «che cosa e' stato cercato, e che cosa no».
                    voce-26 := NavigationItem {
                        step(d) => {
                            root.menu-step(26, d);
                        }
                        label: @tr("Scoperta pubblica");
                        active: root.current-page == 26;
                        activated => {
                            root.open-page(26);
                        }
                    }
                    voce-4 := NavigationItem {
                        step(d) => {
                            root.menu-step(4, d);
                        }
                        label: @tr("Dizionari");
                        active: root.current-page == 4;
                        activated => {
                            root.open-page(4);
                        }
                    }
                    // Subito dopo Dizionari: «che cosa cambierebbe, se pubblicassi
                    // questa bozza?».
                    voce-19 := NavigationItem {
                        step(d) => {
                            root.menu-step(19, d);
                        }
                        label: @tr("Laboratorio regole");
                        active: root.current-page == 19;
                        activated => {
                            root.open-page(19);
                        }
                    }
                    voce-24 := NavigationItem {
                        step(d) => {
                            root.menu-step(24, d);
                        }
                        label: @tr("Modelli");
                        active: root.current-page == 24;
                        activated => {
                            root.open-page(24);
                        }
                    }

                    // AMMINISTRARE: account d'ufficio, postazione, diagnostica,
                    // impostazioni. Erano dentro PREPARARE, mescolati alle fonti.
                    NavigationGroup {
                        text: @tr("AMMINISTRARE");
                    }
                    voce-2 := NavigationItem {
                        step(d) => {
                            root.menu-step(2, d);
                        }
                        label: @tr("Account");
                        active: root.current-page == 2;
                        activated => {
                            root.open-page(2);
                        }
                    }
                    // La diagnostica sta accanto alla Postazione: risponde alla
                    // stessa domanda vista da piu' lontano, «questa macchina
                    // puo' fare il lavoro, adesso?».
                    voce-5 := NavigationItem {
                        step(d) => {
                            root.menu-step(5, d);
                        }
                        label: @tr("Postazione");
                        active: root.current-page == 5;
                        activated => {
                            root.open-page(5);
                        }
                    }
                    voce-17 := NavigationItem {
                        step(d) => {
                            root.menu-step(17, d);
                        }
                        label: @tr("Diagnostica");
                        active: root.current-page == 17;
                        activated => {
                            root.open-page(17);
                        }
                    }
                    voce-11 := NavigationItem {
                        step(d) => {
                            root.menu-step(11, d);
                        }
                        label: @tr("Impostazioni");
                        active: root.current-page == 11;
                        activated => {
                            root.open-page(11);
                        }
                    }

                    NavigationGroup {
                        text: @tr("UFFICIO");
                    }
                    // Il live condiviso: cio' che l'ufficio guarda insieme mentre il lavoro
                    // accade. La revisione condivisa e' cio' che si fa di quello che il live
                    // mostra; i raccoglitori sono cio' che l'ufficio tiene insieme.
                    voce-27 := NavigationItem {
                        step(d) => {
                            root.menu-step(27, d);
                        }
                        label: @tr("Live condiviso");
                        active: root.current-page == 27;
                        activated => {
                            root.open-page(27);
                        }
                    }
                    voce-28 := NavigationItem {
                        step(d) => {
                            root.menu-step(28, d);
                        }
                        label: @tr("Revisione condivisa");
                        active: root.current-page == 28;
                        activated => {
                            root.open-page(28);
                        }
                    }
                    voce-29 := NavigationItem {
                        step(d) => {
                            root.menu-step(29, d);
                        }
                        label: @tr("Raccoglitori dell'ufficio");
                        active: root.current-page == 29;
                        activated => {
                            root.open-page(29);
                        }
                    }

                    NavigationGroup {
                        text: @tr("AIUTO");
                    }
                    voce-10 := NavigationItem {
                        step(d) => {
                            root.menu-step(10, d);
                        }
                        label: @tr("Guida");
                        active: root.current-page == 10;
                        activated => {
                            root.open-page(10);
                        }
                    }
                    // Voce di primo livello richiesta dalla licenza Slint Royalty-free 2.0:
                    // l'attribuzione deve essere raggiungibile da una schermata "Informazioni"
                    // accessibile dal menu principale. Vedere docs/adr/ADR-0005-SLINT-LICENSING.md.
                    voce-1 := NavigationItem {
                        step(d) => {
                            root.menu-step(1, d);
                        }
                        label: @tr("Informazioni e licenze");
                        active: root.current-page == 1;
                        activated => {
                            root.open-page(1);
                        }
                    }

                            Rectangle { vertical-stretch: 1; background: transparent; }
                        }
                    }

                    // «BLOCCA» (UX-EXCELLENCE-02, SIM3-04): stava nella testata
                    // del marchio, che non c'e' piu'. Resta fuori dallo
                    // scorrimento, quindi sempre visibile senza cercarlo: si
                    // preme alzandosi dalla sedia. Compare solo se l'account
                    // attivo ha una parola di sblocco: un pulsante che blocca
                    // senza poter sbloccare chiuderebbe fuori chi lo preme.
                    if root.lock-available: HudButton {
                        label: @tr("Blocca la postazione");
                        clicked => {
                            root.lock-station();
                        }
                    }

                    // «SCOPRI NEXUM» (TOUR-01, ADR-0134): fuori dallo
                    // scorrimento come la versione, perché si deve vedere senza
                    // cercarla; separata dalle voci operative da un filetto,
                    // perché non è un'attività. Non è una schermata.
                    Rectangle {
                        height: Spacing.hairline;
                        vertical-stretch: 0;
                        background: Palette.line-divider;
                    }
                    scopri := DiscoverEntry {
                        fresh: root.tour-fresh;
                        activated => {
                            root.tour-open-panel();
                        }
                    }

                    // Resta fuori dallo scorrimento: la versione va letta
                    // sempre, senza doverla cercare scorrendo il menu.
                    Text {
                        text: @tr("Versione {}", root.app-version);
                        color: Palette.text-disabled;
                        font-size: Typography.group-label;
                        vertical-stretch: 0;
                    }
                }
            }

            // ------------------------------------------------ colonna contenuto
            //
            // Il riempimento approvato: 40 in alto, 48 ai lati, 34 in basso.
            //
            // Sta **qui** e non su ognuna delle quindici schermate: un
            // riempimento ripetuto quindici volte e' un riempimento che al
            // sedicesimo inserimento qualcuno dimentica, e la schermata nuova
            // esce disallineata senza che nulla lo segnali.
            //
            // La colonna di navigazione e' **a filo**: la distanza fra le due la
            // fa questo riempimento, non uno `spacing` del layout che le
            // contiene. Nel riferimento approvato non c'e' fondo finestra fra
            // il menu e il contenuto.
            contenuto := Rectangle {
                background: transparent;
                horizontal-stretch: 1;

                // ---------------------------------------- salita della comparsa
                //
                // Il riferimento chiede che una vista entri **salendo di 6px**,
                // non solo dissolvendo. In Slint la posizione di un figlio di
                // layout la decide il layout: le quindici schermate non possono
                // spostarsi da sole. Si sposta allora **il riempimento del
                // contenitore**, che e' l'unica cosa che le muove tutte insieme.
                //
                // `posata` dice se la vista e' arrivata a destinazione. Cambia
                // pagina -> diventa falsa e il riempimento cresce di 6px; il
                // temporizzatore la rimette vera al giro dopo, e il riempimento
                // torna al suo valore **animato**: e' la salita.
                //
                // **La durata e' asimmetrica apposta.** Scendere e' istantaneo,
                // salire dura quanto la transizione: se anche la discesa fosse
                // animata si vedrebbe la pagina scendere e poi risalire, cioe'
                // un'oscillazione al posto di un'entrata. La discesa avviene
                // mentre la pagina e' ancora del tutto trasparente.
                property <int> pagina: root.current-page;
                property <bool> posata: true;
                changed pagina => {
                    contenuto.posata = false;
                }

                Timer {
                    interval: Motion.settle;
                    running: !contenuto.posata;
                    triggered => {
                        contenuto.posata = true;
                    }
                }

                // LE SCHERMATE SCORRONO, LA FINESTRA NON SI MUOVE
                // (OPERATOR-E2E-REMEDIATION-01, F-05).
                //
                // Slint porta la finestra alla misura minima del suo contenuto:
                // quando una schermata apriva un pannello e la sua altezza minima
                // superava la finestra, la finestra cresceva da sola (1136×759 →
                // 1168×837 → 1200×915). Dentro uno scorrimento la misura minima di
                // una schermata non sale più: se non entra, la schermata scorre.
                // L'INIZIO DELLA SCHERMATA (A11Y-02, ADR-0194): dove riprende il
                // fuoco perso. Si accende solo per riceverlo, cosi' il giro del
                // Tab non ha una fermata in piu'. Il Tab successivo entra nella
                // schermata, Shift+Tab torna alla voce del menu.
                inizio-schermata := FocusScope {
                    x: 0px;
                    y: 0px;
                    width: 0px;
                    height: 0px;
                    enabled: root.screen-start-armed;
                    focus-on-click: false;
                    focus-gained(reason) => {
                        FocusRule.at-screen-start = true;
                    }
                    focus-lost(reason) => {
                        FocusRule.at-screen-start = false;
                        root.screen-start-armed = false;
                    }
                    accessible-role: text;
                    accessible-label: @tr("Inizio della schermata");
                }

                // L'AREA CHE SCORRE E' QUESTA, UNA PER TUTTE LE SCHERMATE
                // (CU01-014, DEC-507). Un elenco dentro una schermata non ne
                // apre un'altra: un `HudScroll` annidato ha un'altezza minima di
                // 40px, e sotto una schermata gia' piu' alta della finestra
                // riceve quella e basta. Il collaudo della 0.2.2 ha trovato cosi'
                // i gruppi di «Segnali cyber» in una fessura di 30px.
                schermata := HudScroll {
                VerticalLayout {
                    padding-top: Shell.content-pad-top
                        + (contenuto.posata ? 0px : Motion.enter-rise);
                    animate padding-top {
                        duration: contenuto.posata ? Motion.transition-effective : 0ms;
                        easing: cubic-bezier(0.16, 1, 0.3, 1);
                    }
                    padding-left: Shell.content-pad-side;
                    padding-right: Shell.content-pad-side;
                    padding-bottom: Shell.content-pad-bottom;

                    // ------------------------------------------------------ Dashboard
                    //
                    // Ogni numero mostrato qui viene dai servizi. Un contatore scritto
                    // a mano direbbe la stessa cosa il giorno in cui la realta' e'
                    // cambiata, ed e' precisamente cio' che i criteri vietano.
                    // ------------------------------------------- primo avvio
                    //
                    // La sola schermata che compare **una volta sola**: chiede
                    // i dati dell'ufficio che intestano ogni relazione, cosi'
                    // che nessuno debba ridigitarli a ogni documento.
                    //
                    // Prende il posto della Dashboard finche' la domanda non ha
                    // una risposta — e «non li inserisco» **e'** una risposta,
                    // registrata, che non si torna a chiedere.
                    if root.current-page == 0 && !DocumentProfile.answered: Rectangle {
                        property <bool> entered: false;
                        opacity: 0.0;
                        init => {
                            self.entered = true;
                        }
                        animate opacity {
                            duration: Motion.transition-effective;
                            easing: cubic-bezier(0.16, 1, 0.3, 1);
                        }
        states [
            shown when self.entered: {
                opacity: 1.0;
            }
        ]
                        background: Palette.panel;
                        border-radius: Spacing.radius-panel;

                        VerticalLayout {
                            padding: Spacing.xl;
                            spacing: Spacing.lg;

                            VerticalLayout {
                                spacing: Spacing.xs;
                                vertical-stretch: 0;

                                Text {
                                    text: @tr("Benvenuto in NEXUM/97");
                                    color: Palette.text;
                                    font-size: Typography.screen-title;
                                    font-weight: Typography.medium;
                                }
                                Text {
                                    text: @tr("Queste informazioni intestano le relazioni di servizio che il programma produce. Si compilano una volta sola: da qui in avanti ogni documento esce già intestato, e restano modificabili dalle Impostazioni.");
                                    color: Palette.text-muted;
                                    font-size: Typography.body-secondary;
                                    wrap: word-wrap;
                                }
                                Text {
                                    text: @tr("Sono tutte facoltative. Dove un dato manca, il documento lascia lo spazio da compilare in Word invece di inventarlo.");
                                    color: Palette.text-muted;
                                    font-size: Typography.body-secondary;
                                    wrap: word-wrap;
                                }
                            }

                            if DocumentProfile.message != "": InfoBanner {
                                message: DocumentProfile.message;
                            }

                            HudScroll {
                                vertical-stretch: 1;

                                // **`HudScroll` NON E' UN LAYOUT.**
                                //
                                // I suoi figli finiscono in un `Flickable`, dove si SOVRAPPONGONO
                                // invece di incolonnarsi. Finche' il figlio era uno solo non si
                                // vedeva; aggiungendo l'anteprima, il foglio si e' disegnato sopra
                                // i campi. Rilevato guardando la schermata catturata, il
                                // 2026-08-20, prima di consegnarla.
                                //
                                // Il layout esplicito e' anche una dichiarazione: chi aggiungera'
                                // un terzo elemento qui dentro lo trovera' incolonnato, senza
                                // dover scoprire da solo perche' non lo era.
                                VerticalLayout {
                                    spacing: Spacing.xl;

                                    ProfileFields { }

                                    // L'anteprima segue i campi e non li precede: si compila
                                    // guardando i campi, e ci si volta a controllare.
                                    ProfilePreview { }
                                }
                            }

                            HorizontalLayout {
                                spacing: Spacing.md;
                                vertical-stretch: 0;

                                // Il rifiuto e' un comando ordinario, non un
                                // ripiego nascosto: chi non vuole compilarli
                                // deve poterlo dire senza cercare.
                                HudButton {
                                    label: @tr("Non inserirli");
                                    clicked => {
                                        DocumentProfile.decline();
                                    }
                                }

                                Rectangle { }

                                HudButton {
                                    label: @tr("Salva e continua");
                                    weight: Weight.primary;
                                    clicked => {
                                        DocumentProfile.save();
                                    }
                                }
                            }
                        }
                    }

                    if root.current-page == 0 && DocumentProfile.answered: VerticalLayout {
                        spacing: Spacing.lg;
                        // Comparsa graduale della pagina. Ogni pagina vive dentro un
                        // `if`: cambiando schermata l'elemento viene CREATO, e `init`
                        // scatta una volta sola alla creazione. Da qui una dissolvenza
                        // solo in ENTRATA - la pagina che esce sparisce con il proprio
                        // `if`, e non c'e' alcun intervallo in cui la finestra resti
                        // vuota aspettando che finisca un'uscita.
                        //
                        // La durata e' `Motion.transition-effective`, che e' gia'
                        // filtrata dalla preferenza dell'operatore: a movimento ridotto
                        // vale 0ms e la pagina compare senza dissolvenza. Leggere qui
                        // `Motion.transition` costringerebbe a ricordarsi la riduzione
                        // in quindici punti diversi, e al sedicesimo qualcuno la
                        // dimenticherebbe.
                        //
                        // **Manca la salita di 6px** che il riferimento approvato chiede
                        // insieme alla dissolvenza. Non e' stata dimenticata: in Slint
                        // la posizione di un figlio di layout la decide il layout, e le
                        // quindici schermate sono figlie di un `VerticalLayout`. Farla
                        // richiederebbe o togliere le pagine dal layout, o animare il
                        // riempimento del contenitore a ogni cambio di pagina. E' un
                        // debito dichiarato, non una svista.
                        property <bool> entered: false;
                        opacity: 0.0;
                        init => {
                            self.entered = true;
                        }
                        animate opacity {
                            duration: Motion.transition-effective;
                            easing: cubic-bezier(0.16, 1, 0.3, 1);
                        }
        states [
            shown when self.entered: {
                opacity: 1.0;
            }
        ]

                        // -------------------------------------- pannello firma
                        //
                        // E' la prima cosa che si vede aprendo il prodotto, e l'unico
                        // punto in cui il marchio compare a dimensione piena dentro una
                        // schermata operativa.
                        //
                        // Non e' decorazione: dice **che cosa sta facendo la postazione
                        // adesso**, in una riga sola e senza numeri da interpretare. Il
                        // marchio pulsa e il radar gira soltanto se un monitoraggio e'
                        // in corso — se girassero sempre non direbbero nulla, e un
                        // prodotto che sembra attivo mentre e' fermo e' peggio di uno
                        // che non sembra niente.
                        //
                        // Porta la cornice viva. I riquadri che contiene NON la portano
                        // - il design system vieta di annidare cornici oltre due
                        // livelli, perche' tre bordi concentrici fanno un modulo
                        // cartaceo invece di una schermata.
                        // La Dashboard e' contenuto per intero: non ha righe
                        // fissate in alto o in basso, e quindi scorre tutta.
                        //
                        // Senza questo, su una finestra non massimizzata i due
                        // pannelli in fondo restavano irraggiungibili e l'unico
                        // rimedio era ingrandire la finestra: un comando che si
                        // vede ma non si raggiunge equivale a un comando che non
                        // c'e'.
                        //
                        // `vertical-stretch: 1` non e' decorativo: senza, il
                        // contenitore chiede tutta l'altezza del proprio contenuto
                        // e il difetto resta identico. E' la stessa lezione gia'
                        // scritta sul wizard.
                        HudScroll {
                            vertical-stretch: 1;

                            VerticalLayout {
                                spacing: Spacing.lg;

                                Panel {
                                    height: 168px;
                                    vertical-stretch: 0;
                                    active: true;

                                    HorizontalLayout {
                                        spacing: Spacing.xl;

                                        BrandMark {
                                            size: 96px;
                                            // Pulsa solo mentre qualcosa si acquisisce davvero.
                                            active: root.monitoring-active && root.station-acquiring && !root.acquisition-paused;
                                        }

                                        VerticalLayout {
                                            spacing: Spacing.sm;
                                            horizontal-stretch: 1;

                                            Text {
                                                text: root.product-name;
                                                color: Palette.text;
                                                font-size: Typography.screen-title;
                                                font-weight: Typography.medium;
                                            }

                                            Text {
                                                text: root.product-subtitle;
                                                color: Palette.cyan;
                                                font-size: Typography.body;
                                                font-weight: Typography.medium;
                                            }

                                            // La riga che conta. Tre stati, e ognuno dice il
                                            // passo successivo invece di limitarsi a
                                            // constatare: una schermata che dichiara un
                                            // problema senza dire che cosa farne lascia
                                            // l'operatore fermo.
                                            // In Esercitazione l'account non serve, e dirlo
                                            // mancante contraddiceva la fascia di sopra
                                            // (OPERATOR-UX-REMEDIATION-01, OS-03).
                                            Text {
                                                text: root.exercise-mode ? @tr("Esercitazione: qui l'account non serve. I messaggi di prova sono negli Avvisi e nello Storico.") : !root.auth-authenticated && root.monitoring-active ? @tr("Un monitoraggio risulta in corso, ma questa postazione non sta acquisendo: l'account d'ufficio non è collegato. Da Account si collega, e da quel momento il monitoraggio riceve di nuovo i messaggi nuovi.") : !root.auth-authenticated && root.account-selected ? @tr("L'account d'ufficio non è collegato. Si collega dalla schermata Account; la libreria dei dizionari è già utilizzabile senza.") : !root.auth-authenticated ? @tr("Nessun account d'ufficio collegato. Si configura dalla schermata Account; la libreria dei dizionari è già utilizzabile senza.") : root.monitoring-active && root.acquisition-paused ? @tr("L'acquisizione è in pausa: i contenuti di questo periodo non vengono acquisiti, e il periodo resta non coperto. Si riprende dalla schermata Monitoraggio.") : (root.monitoring-active ? @tr("Monitoraggio in corso su {}. I contenuti compaiono nello Storico man mano che arrivano.", (root.monitoring-source-count == 1 ? @tr("1 fonte") : @tr("{} fonti", root.monitoring-source-count))) : @tr("Account attivo, fonti e dizionari disponibili. Un monitoraggio si compone da \"Nuovo monitoraggio\"."));
                                                color: Palette.text-muted;
                                                font-size: Typography.body;
                                                wrap: word-wrap;
                                            }

                                            Rectangle { vertical-stretch: 1; background: transparent; }
                                        }

                                        // Il radar sta a destra e gira solo a monitoraggio in
                                        // corso: e' il secondo segnale dello stesso stato, per
                                        // chi guarda la schermata da lontano e non legge la
                                        // riga.
                                        // Gira solo se la postazione acquisisce davvero (F-04).
                                        RadarPanel {
                                            size: 104px;
                                            // In pausa si ferma, e lo dice (CU01-004, DEC-509).
                                            running: root.monitoring-active && root.station-acquiring && !root.acquisition-paused;
                                            caption: !root.monitoring-active ? @tr("FERMO") : root.acquisition-paused ? @tr("IN PAUSA") : (root.station-acquiring ? @tr("IN CORSO") : @tr("NON ACQUISISCE"));
                                        }
                                    }
                                }

                                // LE UNDICI RISPOSTE (DASH-01).
                                //
                                // # Perche' righe e non riquadri
                                //
                                // Perche' ogni risposta porta una NOTA, e la nota e' la
                                // parte che dice il gesto. In un riquadro largo un
                                // quarto di schermo la nota si tronca, e cio' che si
                                // perde e' esattamente la parte che serve a decidere.
                                //
                                // # Perche' i quattro riquadri di prima non ci sono piu'
                                //
                                // Tre delle quattro cifre sono fra le undici risposte e
                                // comparivano due volte; la quarta — i dizionari
                                // utilizzabili — ha gia' un contatore nella schermata
                                // Dizionari. Una cifra ripetuta in due schermate e' una
                                // cifra che il giorno del primo cambiamento diverge.
                                Text {
                                    text: root.dashboard-summary;
                                    color: root.dashboard-attention > 0
                                        ? Palette.amber
                                        : Palette.text-muted;
                                    font-size: Typography.body;
                                    wrap: word-wrap;
                                }

                                LegendaOrigini {
                                    calcolato: @tr("le risposte");
                                }
                                for risposta in root.dashboard-answers: Rectangle {
                                    vertical-stretch: 0;
                                    background: Palette.panel-inset;
                                    border-radius: Spacing.radius-row;

                                    // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                    min-height: rip-26.preferred-height;
                                    rip-26 := VerticalLayout {
                                        padding: Spacing.md;
                                        spacing: Spacing.xs;

                                        HorizontalLayout {
                                            spacing: Spacing.sm;
                                            vertical-stretch: 0;

                                            Text {
                                                text: risposta.question;
                                                color: Palette.text-muted;
                                                font-size: Typography.body-secondary;
                                                horizontal-stretch: 1;
                                            }
                                            // La risposta breve. Ambra solo quando
                                            // chiede un gesto; GRIGIA quando non e'
                                            // disponibile — che non e' ne' un guasto
                                            // ne' una rassicurazione.
                                            Text {
                                                text: risposta.value;
                                                color: risposta.attention
                                                    ? Palette.amber
                                                    : risposta.unavailable
                                                        ? Palette.text-muted
                                                        : Palette.text;
                                                font-family: Typography.mono;
                                                font-size: Typography.body;
                                                font-weight: 600;
                                                horizontal-stretch: 0;
                                            }
                                        }

                                        Text {
                                            text: risposta.note;
                                            color: Palette.text-muted;
                                            font-size: Typography.body-secondary;
                                            wrap: word-wrap;
                                        }
                                    }
                                }

                                // CHE COSA COMPARE PIU' DI PRIMA (TREND-01).
                                //
                                // La riga «Segnali emergenti» dice QUANTE cose;
                                // qui si legge QUALI. Il comando compare solo
                                // quando ce n'e' almeno una: un pulsante che
                                // apre un elenco vuoto e' un pulsante che si
                                // impara a non premere.
                                //
                                // Non costa una seconda lettura: l'elenco viene
                                // dallo stesso confronto che ha prodotto il
                                // numero della riga.
                                if (root.trend-count > 0 || root.spike-count > 0) && !root.trend-open: Rectangle {
                                    // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                    min-height: rip-27.preferred-height;
                                    rip-27 := HorizontalLayout {
                                        spacing: Spacing.sm;
                                        vertical-stretch: 0;

                                        HudButton {
                                            label: @tr("Che cosa è cambiato negli ultimi giorni?");
                                            clicked => {
                                                root.open-trend();
                                            }
                                        }
                                        Rectangle { horizontal-stretch: 1; background: transparent; }
                                    }
                                }

                                if root.trend-open: Rectangle {
                                    // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                    min-height: rip-28.preferred-height;
                                    rip-28 := VerticalLayout {
                                        spacing: Spacing.sm;
                                        vertical-stretch: 0;

                                        HorizontalLayout {
                                            spacing: Spacing.sm;
                                            vertical-stretch: 0;

                                            Text {
                                                text: @tr("CHE COSA COMPARE PIÙ DI PRIMA");
                                                color: Palette.text-muted;
                                                font-family: Typography.mono;
                                                font-size: Typography.label;
                                                horizontal-stretch: 1;
                                            }
                                            HudButton {
                                                label: @tr("Chiudi");
                                                clicked => {
                                                    root.close-trend();
                                                }
                                            }
                                        }

                                        // LE DUE FINESTRE, PER ESTESO. Senza le
                                        // date «compare 14 volte» non dice nulla, e
                                        // la frase dichiara anche di essere un
                                        // confronto fra due periodi e non una
                                        // tendenza: due finestre non sono una serie.
                                        Text {
                                            text: root.trend-summary;
                                            color: Palette.text-muted;
                                            font-size: Typography.body-secondary;
                                            wrap: word-wrap;
                                        }

                                        LegendaOrigini {
                                            osservato: @tr("che cosa");
                                            calcolato: @tr("i conteggi");
                                        }
                                        for voce in root.trend-rows: Rectangle {
                                            vertical-stretch: 0;
                                            background: Palette.panel-inset;
                                            border-radius: Spacing.radius-row;

                                            // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                            min-height: rip-29.preferred-height;
                                            rip-29 := VerticalLayout {
                                                padding: Spacing.md;
                                                spacing: Spacing.xs;

                                                Text {
                                                    text: voce.what;
                                                    color: Palette.text;
                                                    font-size: Typography.body-secondary;
                                                    font-weight: 600;
                                                    wrap: word-wrap;
                                                }
                                                // I DUE CONTEGGI, sempre entrambi.
                                                // Un numero solo si leggerebbe come
                                                // una misura dell'emergenza, e non
                                                // esiste una misura dell'emergenza:
                                                // ci sono due conteggi e la loro
                                                // differenza.
                                                Text {
                                                    text: voce.counts;
                                                    color: Palette.text-muted;
                                                    font-size: Typography.body-secondary;
                                                    wrap: word-wrap;
                                                }
                                                // LA STESSA DOMANDA, LA STESSA
                                                // VOCE. Qui la risposta e' quella
                                                // che conta di piu': una tendenza
                                                // NON e' un fatto osservato, e con
                                                // finestre diverse quella voce non
                                                // sarebbe emergente.
                                                PercheVedoQuesto {
                                                    elemento: voce.what;
                                                    chiesto => {
                                                        root.explain-this(Spiegabile.tendenza, voce.what, voce.counts);
                                                    }
                                                }
                                            }
                                        }

                                        // GLI AUMENTI OLTRE LA SOGLIA (SPIKE-01).
                                        //
                                        // Sezione propria, e non righe mescolate
                                        // alle precedenti: e' un metodo diverso,
                                        // con soglie proprie, e mescolarli
                                        // renderebbe impossibile dire da dove venga
                                        // una riga.
                                        Text {
                                            text: @tr("AUMENTI OLTRE LA SOGLIA DICHIARATA");
                                            color: Palette.text-muted;
                                            font-family: Typography.mono;
                                            font-size: Typography.label;
                                        }

                                        // IL METODO, per esteso: versione, soglie e
                                        // periodo. Il congelamento chiede che siano
                                        // documentati, e una frase che dicesse solo
                                        // «metodo v1» documenterebbe il numero e non
                                        // il metodo.
                                        Text {
                                            text: root.spike-summary;
                                            color: Palette.text-muted;
                                            font-size: Typography.body-secondary;
                                            wrap: word-wrap;
                                        }

                                        LegendaOrigini {
                                            osservato: @tr("che cosa");
                                            calcolato: @tr("i conteggi");
                                        }
                                        for aumento in root.spike-rows: Rectangle {
                                            vertical-stretch: 0;
                                            background: Palette.panel-inset;
                                            border-radius: Spacing.radius-row;

                                            // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                            min-height: rip-30.preferred-height;
                                            rip-30 := VerticalLayout {
                                                padding: Spacing.md;
                                                spacing: Spacing.xs;

                                                Text {
                                                    text: aumento.what;
                                                    color: Palette.text;
                                                    font-size: Typography.body-secondary;
                                                    font-weight: 600;
                                                    wrap: word-wrap;
                                                }
                                                // TUTTI I NUMERI DEL CONTO:
                                                // osservato, mediana, scarto,
                                                // soglia. Una riga che dicesse solo
                                                // «anomalo» sarebbe un verdetto, e
                                                // un verdetto non si controlla.
                                                Text {
                                                    text: aumento.counts;
                                                    color: Palette.text-muted;
                                                    font-size: Typography.body-secondary;
                                                    wrap: word-wrap;
                                                }
                                                // PERCHE' VEDO QUESTO (PR-02): un aumento e'
                                                // un calcolo con una regola sua, e la
                                                // risposta ne dice la versione.
                                                PercheVedoQuesto {
                                                    elemento: aumento.what;
                                                    chiesto => {
                                                        root.explain-this(Spiegabile.aumento, aumento.what, aumento.counts);
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }

                                // IL PASSAGGIO DI CONSEGNE (PR-12, ADR-0128): sei
                                // parti sempre presenti, composte da fatti. Non
                                // raccomanda indagini e non nomina soggetti.
                                Panel {
                                    vertical-stretch: 0;
                                    title: @tr("Passaggio di consegne");

                                    VerticalLayout {
                                        spacing: Spacing.sm;
                                        Text {
                                            text: @tr("Che cosa è successo, che cosa resta aperto e da dove riprendere, in sei parti sempre presenti. È composto da fatti registrati.");
                                            color: Palette.text-muted;
                                            font-size: Typography.body-secondary;
                                            wrap: word-wrap;
                                        }
                                        HorizontalLayout {
                                            spacing: Spacing.md;
                                            vertical-stretch: 0;
                                            HudSelect {
                                                label: @tr("Quanto indietro");
                                                description: @tr("L'intervallo del passaggio di consegne, fino a adesso");
                                                model: [@tr("8 ore"), @tr("24 ore"), @tr("7 giorni")];
                                                current-index <=> root.handover-span;
                                                width: 140px;
                                            }
                                            HudButton {
                                                label: @tr("Componi");
                                                clicked => {
                                                    root.handover-compose();
                                                }
                                            }
                                            HudButton {
                                                label: @tr("Esporta in testo");
                                                enabled: root.handover-text != "";
                                                clicked => {
                                                    root.handover-export(0);
                                                }
                                            }
                                            HudButton {
                                                label: @tr("Esporta in Word");
                                                enabled: root.handover-text != "";
                                                clicked => {
                                                    root.handover-export(1);
                                                }
                                            }
                                            Rectangle { horizontal-stretch: 1; background: transparent; }
                                        }
                                        // IL RISCONTRO SOTTO I COMANDI, NON SOTTO IL FOGLIO
                                        // (UX-EXCELLENCE-02; DEC-385 §3). Stava dopo il foglio
                                        // composto, lungo una schermata, e la conferma
                                        // dell'esportazione finiva fuori vista: si premeva
                                        // «Esporta» e non succedeva niente di visibile.
                                        // Il comando sotto il riscontro, non accanto: accanto,
                                        // un percorso lungo andava su tre righe e il riquadro
                                        // ne misurava due, coprendo il foglio.
                                        if root.handover-message != "": InfoBanner {
                                            message: root.handover-message;
                                        }
                                        if root.handover-message != "" && root.handover-folder-ready: Rectangle {
                                            // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                            min-height: rip-31.preferred-height;
                                            rip-31 := HorizontalLayout {
                                                vertical-stretch: 0;
                                                alignment: start;
                                                HudButton {
                                                    label: @tr("Apri la cartella");
                                                    clicked => {
                                                        root.handover-open-folder();
                                                    }
                                                }
                                            }
                                        }
                                        if root.handover-text != "": Text {
                                            text: root.handover-text;
                                            color: Palette.text;
                                            font-family: Typography.mono;
                                            font-size: Typography.technical;
                                            wrap: word-wrap;
                                        }
                                    }
                                }

                                Panel {
                                    vertical-stretch: 1;
                                    title: @tr("Che cosa questa versione fa e non fa");

                                    VerticalLayout {
                                        spacing: Spacing.md;
                                        Text {
                                            text: @tr("Disponibili: accesso con l'account d'ufficio e gestione delle fonti. Dizionari con le loro versioni, preparazione guidata di un monitoraggio e analisi con livelli da 0 a 4. Acquisizione dal vivo, recupero della cronologia, revisione umana e notifiche di Windows. Relazioni in Word e in PDF, registro in Excel e in testo, ciascuno con il suo elenco delle impronte. Lavoro di più postazioni attraverso l'Hub.");
                                            color: Palette.text-muted;
                                            font-size: Typography.body;
                                            wrap: word-wrap;
                                        }
                                        // Dirlo qui e non solo nella documentazione. Un elenco
                                        // di limiti su una schermata operativa e' scomodo da
                                        // scrivere e utile da leggere: chi consegna un rapporto
                                        // deve sapere in quale formato esce, e chi aspetta un
                                        // avviso deve sapere dove comparira'.
                                        Text {
                                            // STIX, ATT&CK, CVE e KEV si raggiungono da
                                            // Riferimenti informatici: la frase che lo negava
                                            // era rimasta indietro (CA02-15).
                                            text: @tr("Il monitoraggio con l'utente di Windows disconnesso non è previsto. La postazione resta sveglia mentre acquisisce, ma l'accesso a Windows deve restare aperto.");
                                            color: Palette.text-muted;
                                            font-size: Typography.body;
                                            wrap: word-wrap;
                                        }
                                        Rectangle { vertical-stretch: 1; background: transparent; }
                                        HorizontalLayout {
                                            spacing: Spacing.md;
                                            HudButton {
                                                label: root.auth-authenticated ? @tr("Vai alle fonti") : @tr("Configura account");
                                                clicked => {
                                                    root.open-page(root.auth-authenticated ? 3 : 2);
                                                    if (root.auth-authenticated) {
                                                        root.page-shown();
                                                    }
                                                }
                                            }
                                            HudButton {
                                                label: @tr("Componi un monitoraggio");
                                                clicked => {
                                                    root.open-page(6);
                                                    root.wizard-shown();
                                                }
                                            }
                                            Rectangle { horizontal-stretch: 1; background: transparent; }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // ------------------------------------------------------ Account
                    if root.current-page == 2: Rectangle {
                        // Comparsa graduale della pagina: vedere la pagina 0 per il
                        // perche' la dissolvenza sia solo in entrata.
                        property <bool> entered: false;
                        opacity: 0.0;
                        init => {
                            self.entered = true;
                        }
                        animate opacity {
                            duration: Motion.transition-effective;
                            easing: cubic-bezier(0.16, 1, 0.3, 1);
                        }
        states [
            shown when self.entered: {
                opacity: 1.0;
            }
        ]
                        background: Palette.panel;
                        border-radius: Spacing.radius-panel;

                        VerticalLayout {
                            padding: 24px;
                            spacing: 14px;

                            Text {
                                text: @tr("Account Telegram");
                                color: Palette.text;
                                font-size: 22px;
                                font-weight: 700;
                            }

                            // Riscontro delle operazioni di gestione: fuori dall'area
                            // che scorre, cosi' resta visibile anche quando l'operatore
                            // ha raggiunto i campi piu' in basso di questa pagina lunga
                            // (difetto osservato nel collaudo M3B.1d).
                            if root.account-management-message != "": Rectangle {
                                vertical-stretch: 0;
                                background: Palette.info-surface;
                                border-radius: Spacing.radius-row;
                                // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                min-height: rip-32.preferred-height;
                                rip-32 := VerticalLayout {
                                    padding: 12px;
                                    Text {
                                        text: root.account-management-message;
                                        color: Palette.text;
                                        font-size: 13px;
                                        wrap: word-wrap;
                                    }
                                }
                            }

                            // Comandi distruttivi, in fondo e visivamente distinti dai
                            // comandi ordinari. La conferma e' un secondo clic sullo
                            // stesso pulsante, che cambia testo: un dialogo modale
                            // bloccherebbe il thread dell'interfaccia, e un clic
                            // accidentale su questi comandi cancella una sessione
                            // Telegram autorizzata.
                            // Chiuso di default dal 2026-08-04, su rilievo dell'operatore.
                            // Un blocco distruttivo permanentemente aperto in una
                            // schermata che si usa di routine e' pericoloso **per
                            // posizione**, non solo per etichetta: non si puo' cliccare
                            // per sbaglio cio' che non e' nemmeno disegnato. Resta qui e
                            // non in Impostazioni perche' «Rimuovi l'account
                            // selezionato» agisce sull'account scelto in questa
                            // schermata, e un comando distruttivo che non mostra su che
                            // cosa agira' e' peggio di uno troppo visibile.
                            Rectangle {
                                vertical-stretch: 0;
                                // L'altezza viene dal contenuto (F-03): fissata a 240 px, a
                                // 1136x759 e 1120x720 la zona usciva dal riquadro e scriveva
                                // sopra il titolo seguente.
                                height: reset-zone.preferred-height;
                                background: reset-panel.open ? Palette.danger-surface : Palette.panel;
                                border-radius: Spacing.radius-panel;
                                border-width: Spacing.hairline;
                                border-color: reset-panel.open ? Palette.coral : Palette.panel;

                                reset-zone := VerticalLayout {
                                    padding: Spacing.md;
                                    spacing: Spacing.sm;

                                    HorizontalLayout {
                                        spacing: Spacing.md;
                                        HudButton {
                                            label: reset-panel.open ? @tr("Nascondi azzeramento e rimozione") : @tr("Azzeramento e rimozione…");
                                            clicked => {
                                                reset-panel.open = !reset-panel.open;
                                                // Richiudendo si disarma tutto: una
                                                // conferma lasciata a meta' che
                                                // sopravvive nascosta scatterebbe alla
                                                // riapertura, con un solo clic e senza
                                                // che nulla l'abbia annunciata.
                                                remove-armed.armed = false;
                                                reset-armed.armed = false;
                                                history-armed.armed = false;
                                            }
                                        }
                                        Rectangle {
                                            horizontal-stretch: 1;
                                            background: transparent;
                                        }
                                    }

                                    if reset-panel.open: Rectangle {
                                        // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                        min-height: rip-33.preferred-height;
                                        rip-33 := VerticalLayout {
                                            spacing: Spacing.sm;

                                            AvvertenzaDiSicurezza {
                                                codice: "SIC-02";
                                                testo: @tr("Rimuovere un account cancella anche la sua sessione Telegram da questo computer. Per rientrare serviranno di nuovo numero e codice. L'operazione non si annulla. Il registro delle operazioni conserva la traccia della rimozione.");
                                                dettaglio: @tr("Si cancellano la sessione TDLib e le credenziali protette con DPAPI. Il registro di audit conserva l'operazione, senza alcun segreto.");
                                            }
                                            // I TRE COMANDI ARMANO SOLTANTO (F-03, ADR-0140).
                                            //
                                            // Fino a OPERATOR-E2E-REMEDIATION-01 la conferma era
                                            // un secondo clic sullo STESSO pulsante, che
                                            // cambiava testo: un doppio clic armava e
                                            // confermava insieme. Ora il pulsante armato si
                                            // spegne, e la conferma è un comando diverso, in
                                            // un'altra riga, accanto a «Annulla»: nessun gesto
                                            // ripetuto sullo stesso punto arriva in fondo.
                                            HorizontalLayout {
                                                spacing: Spacing.md;
                                                HudButton {
                                                    label: @tr("Rimuovi l'account selezionato…");
                                                    enabled: root.account-selected && !remove-armed.armed;
                                                    clicked => {
                                                        remove-armed.armed = true;
                                                        reset-armed.armed = false;
                                                        history-armed.armed = false;
                                                    }
                                                }
                                                HudButton {
                                                    label: @tr("Azzera account e profili…");
                                                    enabled: !reset-armed.armed;
                                                    clicked => {
                                                        reset-armed.armed = true;
                                                        remove-armed.armed = false;
                                                        history-armed.armed = false;
                                                    }
                                                }
                                                // Fino al 2026-08-04 questo pulsante si
                                                // chiamava "Azzera storico dei monitoraggi"
                                                // e cancellava invece **l'intero archivio**:
                                                // account, profili, fonti, dizionari e
                                                // impostazioni insieme allo storico. Un
                                                // operatore l'ha premuto credendo di
                                                // ripulire lo storico e ha perso la
                                                // configurazione. E' la seconda volta in
                                                // questo prodotto che un comando distruttivo
                                                // porta il nome di un'operazione piu' mite -
                                                // la prima fu "Archivia" che in realta'
                                                // eliminava - e stavolta la posta era
                                                // l'intero archivio.
                                                HudButton {
                                                    label: @tr("Azzera l'intero archivio…");
                                                    enabled: !history-armed.armed;
                                                    clicked => {
                                                        history-armed.armed = true;
                                                        remove-armed.armed = false;
                                                        reset-armed.armed = false;
                                                    }
                                                }
                                                Rectangle { horizontal-stretch: 1; background: transparent; }
                                            }

                                            // LA CONFERMA: che cosa succede, e due comandi.
                                            if remove-armed.armed || reset-armed.armed || history-armed.armed: Rectangle {
                                                background: Palette.panel-inset;
                                                border-radius: Spacing.radius-row;
                                                border-width: Spacing.hairline;
                                                border-color: Palette.coral;
                                                height: reset-confirm.preferred-height;

                                                reset-confirm := VerticalLayout {
                                                    padding: Spacing.md;
                                                    spacing: Spacing.sm;

                                                    Text {
                                                        text: remove-armed.armed ? @tr("Si sta per rimuovere l'account selezionato, con la sua sessione Telegram su questo computer.") : reset-armed.armed ? @tr("Si stanno per cancellare tutti gli account e tutti i profili di questa postazione, con le loro sessioni.") : @tr("Si sta per chiedere la cancellazione dell'intero archivio di questa postazione: avviene alla prossima apertura del programma.");
                                                        color: Palette.text;
                                                        font-size: Typography.body-secondary;
                                                        wrap: word-wrap;
                                                    }
                                                    HorizontalLayout {
                                                        spacing: Spacing.md;
                                                        HudButton {
                                                            label: @tr("Annulla");
                                                            clicked => {
                                                                remove-armed.armed = false;
                                                                reset-armed.armed = false;
                                                                history-armed.armed = false;
                                                            }
                                                        }
                                                        Rectangle { horizontal-stretch: 1; background: transparent; }
                                                        HudButton {
                                                            label: remove-armed.armed ? @tr("Sì, rimuovi l'account") : reset-armed.armed ? @tr("Sì, azzera account e profili") : @tr("Sì, cancella tutto l'archivio");
                                                            clicked => {
                                                                if (remove-armed.armed) {
                                                                    remove-armed.armed = false;
                                                                    root.remove-account();
                                                                } else if (reset-armed.armed) {
                                                                    reset-armed.armed = false;
                                                                    root.reset-accounts();
                                                                } else if (history-armed.armed) {
                                                                    history-armed.armed = false;
                                                                    root.reset-history();
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                            AvvertenzaDiSicurezza {
                                                codice: "SIC-03";
                                                testo: @tr("«Azzera l'intero archivio» cancella TUTTO l'archivio di questa postazione. Non solo lo storico: anche monitoraggi, account, profili, fonti, dizionari e impostazioni. Prima, il registro delle operazioni viene salvato in un file a parte, con la sua impronta. La cancellazione non avviene subito: avviene alla prossima apertura del programma. Fino ad allora un avviso in alto la ricorda.");
                                                dettaglio: @tr("All'avvio successivo il file del database SQLite viene rimosso, quando nessun servizio lo tiene aperto. Il registro di audit viene prima esportato con la sua impronta SHA-256.");
                                            }
                                        }
                                    }
                                }

                                remove-armed := Rectangle {
                                    property <bool> armed: false;
                                    width: 0px;
                                }
                                reset-armed := Rectangle {
                                    property <bool> armed: false;
                                    width: 0px;
                                }
                                history-armed := Rectangle {
                                    property <bool> armed: false;
                                    width: 0px;
                                }
                                reset-panel := Rectangle {
                                    property <bool> open: false;
                                    width: 0px;
                                }
                            }

                            HudScroll {
                                vertical-stretch: 1;
                                VerticalLayout {
                                spacing: 14px;

                                // ================ La configurazione dell'applicazione
                                //
                                // Le credenziali dell'applicazione non si vedono e non
                                // si scrivono qui (APP-CREDENTIALS-01, ADR-0204): arrivano
                                // con la distribuzione. Se mancano, la frase dice a chi
                                // rivolgersi e nient'altro.
                                if !root.telegram-configured: Rectangle {
                                    // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                    min-height: rip-211.preferred-height;
                                    rip-211 := VerticalLayout {
                                        Text {
                                            text: @tr("Questa installazione di NEXUM/97 non è configurata per collegarsi a Telegram. Rivolgersi all'amministratore. L'esercitazione funziona comunque.");
                                            color: Palette.amber;
                                            font-size: Typography.body-secondary;
                                            wrap: word-wrap;
                                        }
                                    }
                                }

                                // ============================================ Account
                                Text {
                                    text: @tr("1. Account Telegram");
                                    color: Palette.text;
                                    font-size: 15px;
                                    font-weight: 700;
                                }
                                Text {
                                    text: @tr("Un account d'ufficio. Il numero è mostrato solo in forma parziale, dopo l'accesso.");
                                    color: Palette.text-muted;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                }

                                if root.telegram-accounts.length == 0: Text {
                                    text: @tr("Nessun account: aggiungerne uno qui sotto.");
                                    color: Palette.text-disabled;
                                    font-size: 13px;
                                }
                                LegendaOrigini {
                                    calcolato: @tr("stato");
                                    operatore: @tr("nome e numero");
                                }
                                for account in root.telegram-accounts: SelectableRow {
                                    selected: account.selected;
                                    name: @tr("Account {}, {}", account.label, account.status);
                                    chosen => {
                                        root.select-account(account.id);
                                    }

                                    VerticalLayout {
                                        spacing: 1px;
                                        padding-top: 7px;
                                        padding-bottom: 7px;
                                        Text {
                                            text: account.label;
                                            color: Palette.text;
                                            font-size: Typography.body;
                                        }
                                        Text {
                                            // Il numero e' mostrato SEMPRE mascherato:
                                            // basta a riconoscere l'utenza e non basta
                                            // a nessun altro per usarla.
                                            text: account.masked-phone != "" ? @tr("Utenza {}", account.masked-phone) : @tr("numero non ancora acquisito");
                                            color: Palette.text-muted;
                                            font-size: Typography.group-label;
                                        }
                                    }
                                    Rectangle { horizontal-stretch: 1; background: transparent; }
                                    // Un account collegato che non è quello selezionato: riceve
                                    // per i suoi monitoraggi anche mentre si lavora su un altro.
                                    if account.linked && !account.selected: StatusBadge {
                                        label: account.link-label;
                                        tone: account.link-trouble ? Tone.danger : Tone.neutral;
                                    }
                                    StatusBadge {
                                        label: account.status;
                                        tone: Tone.neutral;
                                    }
                                }

                                // ------------------------- più account collegati insieme
                                //
                                // MULTI-ACCOUNT-02 parte 3 (ADR-0173). Un gesto dell'operatore,
                                // mai una scelta del programma: tenere collegato l'account
                                // selezionato anche quando se ne sceglie un altro, al più tre.
                                if root.linked-accounts-line != "": Text {
                                    text: root.linked-accounts-line;
                                    color: Palette.text-muted;
                                    font-size: Typography.body-secondary;
                                    wrap: word-wrap;
                                }
                                if root.unbound-monitorings-note != "": Text {
                                    text: root.unbound-monitorings-note;
                                    color: Palette.amber;
                                    font-size: Typography.body-secondary;
                                    wrap: word-wrap;
                                }
                                if root.selected-account-linked: Rectangle {
                                    // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                    min-height: rip-multi.preferred-height;
                                    rip-multi := HorizontalLayout {
                                        spacing: Spacing.md;
                                        vertical-stretch: 0;
                                        Text {
                                            text: root.selected-account-kept ? @tr("Questo account resta collegato anche selezionandone un altro.") : @tr("Selezionandone un altro, questo account si scollega.");
                                            color: Palette.text-muted;
                                            font-size: Typography.body-secondary;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                            wrap: word-wrap;
                                        }
                                        if !root.selected-account-kept: HudButton {
                                            label: @tr("Tienilo collegato");
                                            horizontal-stretch: 0;
                                            clicked => {
                                                root.keep-account-linked();
                                            }
                                        }
                                        if root.selected-account-kept: HudButton {
                                            label: @tr("Non tenerlo più collegato");
                                            horizontal-stretch: 0;
                                            clicked => {
                                                root.release-account-linked();
                                            }
                                        }
                                    }
                                }

                                // ------------------------------- aggiungere un account
                                //
                                // Lo stesso ragionamento delle credenziali: un modulo
                                // vuoto accanto a un account gia' attivo fa credere che
                                // manchi qualcosa. Chi ne vuole un secondo lo chiede.
                                //
                                // Il modulo resta APERTO quando non c'e' ancora nessun
                                // account: li' non c'e' niente da confondere, e
                                // nascondere l'unico gesto possibile dietro un pulsante
                                // sarebbe un passaggio in piu' senza ragione.
                                if root.telegram-accounts.length > 0 && !root.adding-account: Rectangle {
                                    // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                    min-height: rip-36.preferred-height;
                                    rip-36 := HorizontalLayout {
                                        spacing: Spacing.md;
                                        vertical-stretch: 0;

                                        Text {
                                            text: root.account-selected ? @tr("Account selezionato. Le fonti e i monitoraggi useranno questo.") : @tr("Scegliere un account dall'elenco qui sopra.");
                                            color: Palette.text-muted;
                                            font-size: Typography.body-secondary;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                            wrap: word-wrap;
                                        }
                                        HudButton {
                                            label: @tr("Aggiungi un altro account\u{2026}");
                                            horizontal-stretch: 0;
                                            clicked => {
                                                root.adding-account = true;
                                            }
                                        }
                                    }
                                }

                                if root.telegram-accounts.length == 0 || root.adding-account: Rectangle {
                                    // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                    min-height: rip-37.preferred-height;
                                    rip-37 := HorizontalLayout {
                                        spacing: 8px;
                                        vertical-stretch: 0;
                                        HudInput {
                                            placeholder: @tr("Etichetta dell'account (es. Redazione)");
                                            label: @tr("Etichetta del nuovo account");
                                            value <=> root.account-label-input;
                                        }
                                        HudButton {
                                            label: @tr("Aggiungi account");
                                            horizontal-stretch: 0;
                                            clicked => {
                                                root.adding-account = false;
                                                root.create-account();
                                            }
                                        }
                                        // Come per le credenziali: chi apre il modulo deve
                                        // poterlo richiudere senza creare nulla.
                                        if root.adding-account: HudButton {
                                            label: @tr("Annulla");
                                            horizontal-stretch: 0;
                                            clicked => {
                                                root.adding-account = false;
                                            }
                                        }
                                    }
                                }

                                Rectangle { height: Spacing.hairline; vertical-stretch: 0; background: Palette.line-divider; }

                                // =========================================== Modalita'
                                Text {
                                    text: @tr("2. Modalità di accesso");
                                    color: Palette.text;
                                    font-size: 15px;
                                    font-weight: 700;
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    vertical-stretch: 0;
                                    HudButton {
                                        label: root.account-mode-live ? @tr("Dimostrativa") : @tr("✓ Dimostrativa");
                                        clicked => {
                                            root.choose-mock();
                                        }
                                    }
                                    HudButton {
                                        label: root.account-mode-live ? @tr("✓ Telegram reale") : @tr("Telegram reale");
                                        // Non si offre cio' che questo binario non sa fare.
                                        enabled: root.telegram-runtime-available;
                                        reason: root.telegram-runtime-missing-reason;
                                        clicked => {
                                            root.choose-live();
                                        }
                                    }
                                    Rectangle { horizontal-stretch: 1; background: transparent; }
                                }
                                // **La mancanza si dichiara, non si lascia scoprire.**
                                //
                                // Un pacchetto senza il componente di Telegram e' comunque
                                // utilizzabile in modalita' dimostrativa: dirlo qui, accanto
                                // alla scelta, e' cio' che distingue un limite dichiarato da
                                // un guasto.
                                if !root.telegram-runtime-available: AvvertenzaDiSicurezza {
                                    codice: "SIC-15";
                                    testo: root.telegram-runtime-missing-reason;
                                    dettaglio: root.telegram-runtime-missing-detail;
                                }

                                // Avviso: la modalita' reale contatta Telegram con l'account
                                // d'ufficio. E' mostrato solo quando Live e' selezionata.
                                if root.account-mode-live: AvvertenzaDiSicurezza {
                                    codice: "SIC-04";
                                    testo: @tr("Attenzione: la modalità Telegram reale apre una sessione vera sull'account d'ufficio. Usa il canale ufficiale che Telegram offre ai programmi. Va usata solo con autorizzazione. La modalità dimostrativa non contatta Telegram.");
                                    dettaglio: @tr("La modalità reale usa TDLib e l'API ufficiale di Telegram con le credenziali dell'ufficio. NEXUM/97 non è un client Telegram ufficiale.");
                                }

                                Rectangle { height: Spacing.hairline; vertical-stretch: 0; background: Palette.line-divider; }

                                // ======================================= Accesso guidato
                                Text {
                                    text: @tr("3. Accesso");
                                    color: Palette.text;
                                    font-size: 15px;
                                    font-weight: 700;
                                }

                                // Lo stato dell'account e' sempre visibile, in ogni fase.
                                Rectangle {
                                    height: 62px;
                                    vertical-stretch: 0;
                                    background: root.auth-authenticated ? Palette.success-surface : Palette.panel-raised;
                                    border-radius: Spacing.radius-row;

                                    HorizontalLayout {
                                        padding-left: 16px;
                                        padding-right: 16px;
                                        spacing: 12px;

                                        Rectangle {
                                            width: 10px;
                                            height: 10px;
                                            horizontal-stretch: 0;
                                            vertical-stretch: 0;
                                            y: (parent.height - 10px) / 2;
                                            background: root.auth-authenticated ? Palette.green : Palette.text-disabled;
                                            border-radius: Spacing.radius-row;
                                        }

                                        VerticalLayout {
                                            spacing: 2px;
                                            padding-top: 12px;
                                            padding-bottom: 12px;
                                            Text {
                                                text: root.auth-headline;
                                                color: Palette.text;
                                                font-size: 15px;
                                                font-weight: 600;
                                            }
                                            Text {
                                                text: root.auth-account-label == "" ? @tr("Nessun numero configurato") : @tr("Utenza: {}", root.auth-account-label);
                                                color: Palette.text-muted;
                                                font-size: 13px;
                                            }
                                        }

                                        if root.auth-busy: Text {
                                            text: @tr("attendere...");
                                            color: Palette.text-muted;
                                            font-size: 13px;
                                            vertical-alignment: center;
                                            horizontal-stretch: 0;
                                        }
                                    }
                                }

                                Text {
                                    text: root.auth-detail;
                                    color: Palette.text-muted;
                                    font-size: 14px;
                                    wrap: word-wrap;
                                }

                                // CHI E' QUESTO ACCOUNT, SECONDO TELEGRAM (ADR-0153,
                                // DG-07, F-140). Si chiede su comando con `getMe`, e
                                // ogni lettura si registra con chi e quando. Separato
                                // dai risultati della Ricerca puntuale: una cosa e'
                                // chi siamo, un'altra chi cerchiamo.
                                Rectangle {
                                    vertical-stretch: 0;
                                    background: Palette.panel-raised;
                                    border-radius: Spacing.radius-row;
                                    // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                    min-height: rip-183.preferred-height;
                                    rip-183 := VerticalLayout {
                                        padding: 14px;
                                        spacing: 6px;
                                        Text {
                                            text: @tr("CHI È QUESTO ACCOUNT, SECONDO TELEGRAM");
                                            color: Palette.text-muted;
                                            font-size: Typography.group-label;
                                            letter-spacing: Typography.track-eyebrow;
                                        }
                                        OrigineSegno { origine: Origine.osservato; }
                                        Text {
                                            text: root.office-account-sentence;
                                            color: Palette.text;
                                            font-size: 14px;
                                            wrap: word-wrap;
                                        }
                                        HorizontalLayout {
                                            spacing: Spacing.sm;
                                            HudButton {
                                                label: @tr("Chiedi a Telegram chi è questo account");
                                                enabled: root.auth-authenticated && !root.auth-demo;
                                                clicked => {
                                                    root.office-account-read();
                                                }
                                            }
                                            Rectangle { horizontal-stretch: 1; background: transparent; }
                                        }
                                    }
                                }

                                if root.auth-failure != "": Rectangle {
                                    vertical-stretch: 0;
                                    background: Palette.danger-surface;
                                    border-radius: Spacing.radius-row;
                                    // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                    min-height: rip-38.preferred-height;
                                    rip-38 := VerticalLayout {
                                        padding: 14px;
                                        Text {
                                            text: root.auth-failure;
                                            color: Palette.coral;
                                            font-size: 14px;
                                            wrap: word-wrap;
                                        }
                                    }
                                }

                                // ------------------------------------- numero
                                if root.auth-needs-phone: Rectangle {
                                    // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                    min-height: rip-39.preferred-height;
                                    rip-39 := VerticalLayout {
                                        spacing: 6px;
                                        Text {
                                            text: @tr("Numero dell'account d'ufficio");
                                            color: Palette.text-muted;
                                            font-size: 12px;
                                            font-weight: 700;
                                        }
                                        HudInput {
                                            placeholder: "+39...";
                                            label: @tr("Numero dell'account d'ufficio");
                                            value <=> root.phone-input;
                                            enabled: root.can-submit-phone;
                                            accepted => {
                                                root.submit-phone();
                                            }
                                        }
                                    }
                                }

                                // -------------------------------------- codice
                                if root.auth-needs-code: Rectangle {
                                    // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                    min-height: rip-40.preferred-height;
                                    rip-40 := VerticalLayout {
                                        spacing: 6px;
                                        Text {
                                            text: @tr("Codice ricevuto da Telegram");
                                            color: Palette.text-muted;
                                            font-size: 12px;
                                            font-weight: 700;
                                        }
                                        HudInput {
                                            placeholder: @tr("codice a più cifre");
                                            label: @tr("Codice di verifica ricevuto");
                                            value <=> root.code-input;
                                            enabled: root.can-submit-code;
                                            accepted => {
                                                root.submit-code();
                                            }
                                        }
                                    }
                                }

                                // ---------------------------------------- 2FA
                                // `SecretField`: maschera il valore, non lo mostra mai, e
                                // la sua etichetta nomina il campo e non il contenuto -
                                // e' il nome che una tecnologia assistiva pronuncia ad
                                // alta voce.
                                if root.auth-needs-password: SecretField {
                                    label: @tr("Password della verifica in due passaggi");
                                    placeholder: @tr("non verrà mostrata");
                                    enabled: root.can-submit-password;
                                    value <=> root.password-input;
                                    accepted => {
                                        root.submit-password();
                                    }
                                }

                                // ------------------------------------- comandi
                                //
                                // **I PASSAGGI DELL'ACCESSO SI VEDONO SOLO SE L'ACCESSO
                                // E' DA FARE.**
                                //
                                // Fino al 2026-08-20 «Avvia accesso», «Invia numero»,
                                // «Invia codice», «Invia password» e «Annulla e
                                // ricomincia» restavano in vista anche sotto un account
                                // gia' attivo, soltanto spenti. Cinque comandi spenti
                                // sotto una scritta verde che dice «Account attivo»
                                // dicono due cose opposte nello stesso riquadro, e chi
                                // legge crede che manchi ancora qualcosa da fare.
                                //
                                // Riferito dall'operatore con uno screenshot: il modo
                                // piu' corto per far vedere cio' che una descrizione
                                // non trasmette.
                                if !root.auth-authenticated: Rectangle {
                                    // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                    min-height: rip-41.preferred-height;
                                    rip-41 := VerticalLayout {
                                        spacing: Spacing.sm;

                                        // **UN PASSO PER VOLTA, E SI VEDE SOLO QUELLO.**
                                        //
                                        // L'accesso e' una sequenza: a ogni istante uno solo
                                        // dei quattro comandi e' possibile, e gli altri tre
                                        // stavano li' spenti. Sono gli stessi tre pulsanti
                                        // spenti che, sotto un account attivo, facevano
                                        // credere che mancasse qualcosa da fare: il rimedio
                                        // vale anche qui, dove il difetto e' piu' antico.
                                        //
                                        // La visibilita' segue `auth-needs-*`, cioe' la
                                        // STESSA condizione che governa il campo qui sopra:
                                        // ogni comando compare accanto al proprio campo, mai
                                        // da solo e mai orfano. Sarebbe stato piu' corto
                                        // usare `can-submit-*`, ma quelli si spengono anche
                                        // mentre il campo e' vuoto, e il pulsante sarebbe
                                        // sparito sotto le dita di chi sta scrivendo.
                                        HorizontalLayout {
                                            spacing: 10px;
                                            vertical-stretch: 0;

                                            // Prima che la sequenza cominci c'e' un solo
                                            // gesto possibile. Resta VISIBILE anche mentre e'
                                            // spento - durante l'attesa di rete - perche' un
                                            // comando che sparisce nell'istante in cui lo si
                                            // preme fa dubitare di averlo premuto.
                                            if !root.auth-needs-phone
                                                && !root.auth-needs-code
                                                && !root.auth-needs-password: HudButton {
                                                label: @tr("Avvia accesso");
                                                enabled: root.can-start;
                                                reason: root.can-start ? "" : (root.auth-busy ? @tr("Operazione in corso.") : @tr("Selezionare prima un account."));
                                                clicked => {
                                                    root.start-login();
                                                }
                                            }
                                            if root.auth-needs-phone: HudButton {
                                                label: @tr("Invia numero");
                                                enabled: root.can-submit-phone;
                                                reason: !root.can-submit-phone ? @tr("Scrivere prima il numero qui sopra.") : "";
                                                clicked => {
                                                    root.submit-phone();
                                                }
                                            }
                                            if root.auth-needs-code: HudButton {
                                                label: @tr("Invia codice");
                                                enabled: root.can-submit-code;
                                                reason: !root.can-submit-code ? @tr("Scrivere prima il codice ricevuto.") : "";
                                                clicked => {
                                                    root.submit-code();
                                                }
                                            }
                                            if root.auth-needs-password: HudButton {
                                                label: @tr("Invia password");
                                                enabled: root.can-submit-password;
                                                reason: !root.can-submit-password ? @tr("Scrivere prima la parola d'ordine.") : "";
                                                clicked => {
                                                    root.submit-password();
                                                }
                                            }
                                            Rectangle { horizontal-stretch: 1; background: transparent; }
                                        }

                                        HorizontalLayout {
                                            spacing: 10px;
                                            vertical-stretch: 0;

                                            // Compare quando c'e' davvero qualcosa da
                                            // annullare: prima che la sequenza cominci non
                                            // c'e' nulla, e il comando sarebbe un invito a
                                            // premere un pulsante che non fa niente.
                                            if root.can-cancel: HudButton {
                                                label: @tr("Annulla e ricomincia");
                                                clicked => {
                                                    root.cancel-login();
                                                }
                                            }
                                            Rectangle { horizontal-stretch: 1; background: transparent; }
                                        }

                                        // La sequenza si dice a PAROLE, una volta sola.
                                        //
                                        // Mostrare i quattro pulsanti serviva anche a questo:
                                        // far capire che cosa aspettarsi. Quel compito lo
                                        // svolge una riga di testo, che non si puo' premere
                                        // per sbaglio e non finge di essere un comando.
                                        if !root.auth-needs-phone
                                            && !root.auth-needs-code
                                            && !root.auth-needs-password: Text {
                                            text: @tr("L'accesso chiede il numero dell'account, poi il codice che Telegram invia, e infine la parola d'ordine se l'account ne ha una. Un passaggio per volta.");
                                            color: Palette.text-disabled;
                                            font-size: 12px;
                                            wrap: word-wrap;
                                        }
                                    }
                                }

                                // Ad accesso compiuto restano le sole azioni che hanno
                                // un senso: prenderne un altro, o togliere questo.
                                //
                                // «Rimuovi» non rimuove: APRE il pannello che chiede
                                // conferma due volte. Un comando distruttivo con due
                                // porte d'ingresso e regole di conferma diverse e' un
                                // comando distruttivo che prima o poi scatta per
                                // sbaglio da quella meno sorvegliata.
                                if root.auth-authenticated: Rectangle {
                                    // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                    min-height: rip-42.preferred-height;
                                    rip-42 := VerticalLayout {
                                        spacing: Spacing.xs;

                                        HorizontalLayout {
                                            spacing: Spacing.md;
                                            vertical-stretch: 0;

                                            HudButton {
                                                label: @tr("Aggiungi un altro account\u{2026}");
                                                clicked => {
                                                    root.adding-account = true;
                                                }
                                            }
                                            HudButton {
                                                label: @tr("Rimuovi questo account\u{2026}");
                                                enabled: root.account-selected;
                                                reason: !root.account-selected ? @tr("Nessun account selezionato.") : "";
                                                clicked => {
                                                    reset-panel.open = true;
                                                }
                                            }
                                            Rectangle { horizontal-stretch: 1; background: transparent; }
                                        }

                                        Text {
                                            text: @tr("Tutti e due i comandi aprono una sezione in cima a questa schermata.");
                                            color: Palette.text-disabled;
                                            font-size: 12px;
                                            wrap: word-wrap;
                                        }
                                    }
                                }

                                Text {
                                    text: @tr("Per cambiare account seleziona un'altra voce dall'elenco qui sopra: l'accesso riparte da zero, senza mescolare gli stati.");
                                    color: Palette.text-disabled;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                }

                                Rectangle {
                                    height: 1px;
                                    vertical-stretch: 0;
                                    background: Palette.panel-raised;
                                }

                                Text {
                                    text: @tr("Nessun dato riservato viene mostrato a schermo, scritto nei file tecnici o conservato nell'archivio del programma. Il numero è visualizzato in forma parziale.");
                                    color: Palette.text-disabled;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                }

                                Rectangle { vertical-stretch: 1; background: transparent; }
                                }
                            }
                        }
                    }

                    // -------------------------------------------------------- Fonti
                    if root.current-page == 3: Rectangle {
                        // Comparsa graduale della pagina: vedere la pagina 0 per il
                        // perche' la dissolvenza sia solo in entrata.
                        property <bool> entered: false;
                        opacity: 0.0;
                        init => {
                            self.entered = true;
                        }
                        animate opacity {
                            duration: Motion.transition-effective;
                            easing: cubic-bezier(0.16, 1, 0.3, 1);
                        }
        states [
            shown when self.entered: {
                opacity: 1.0;
            }
        ]
                        background: Palette.panel;
                        border-radius: Spacing.radius-panel;

                        HudScroll {
                            VerticalLayout {
                                padding: 24px;
                                spacing: 14px;

                                Text {
                                    text: @tr("Fonti monitorate");
                                    color: Palette.text;
                                    font-size: 22px;
                                    font-weight: 700;
                                }

                                Text {
                                    text: @tr("Si possono monitorare soltanto fonti già accessibili all'account d'ufficio. L'applicazione non entra in gruppi privati e non cerca chat sulla piattaforma: la ricerca filtra l'elenco qui sotto.");
                                    color: Palette.text-muted;
                                    font-size: 13px;
                                    wrap: word-wrap;
                                }

                                if root.sources-message != "": Rectangle {
                                    vertical-stretch: 0;
                                    background: Palette.accent-surface;
                                    border-radius: Spacing.radius-row;
                                    // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                    min-height: rip-43.preferred-height;
                                    rip-43 := VerticalLayout {
                                        padding: 12px;
                                        Text {
                                            text: root.sources-message;
                                            color: Palette.text;
                                            font-size: 13px;
                                            wrap: word-wrap;
                                        }
                                    }
                                }

                                if !root.sources-enabled: Rectangle {
                                    vertical-stretch: 0;
                                    background: Palette.panel-raised;
                                    border-radius: Spacing.radius-row;
                                    // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                    min-height: rip-44.preferred-height;
                                    rip-44 := VerticalLayout {
                                        padding: 14px;
                                        spacing: 10px;
                                        // In Esercitazione nessun account si collega, e le fonti
                                        // inventate stanno già nella procedura: la schermata lo
                                        // dice e porta lì (OPERATOR-UX-REMEDIATION-01, OS-03).
                                        Text {
                                            text: root.exercise-mode ? @tr("In Esercitazione nessun account si collega a Telegram: le fonti di prova sono già pronte e si scelgono in «Nuovo monitoraggio».") : @tr("Accedere con l'account d'ufficio per vedere le fonti disponibili.");
                                            color: Palette.text-muted;
                                            font-size: 14px;
                                            wrap: word-wrap;
                                        }
                                        if root.exercise-mode: Rectangle {
                                            // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                            min-height: rip-45.preferred-height;
                                            rip-45 := HorizontalLayout {
                                                alignment: start;
                                                HudButton {
                                                    label: @tr("Vai a Nuovo monitoraggio");
                                                    clicked => {
                                                        root.open-page(6);
                                                    }
                                                }
                                            }
                                        }
                                        // LA FRASE PORTA DOVE DICE (E2E01-21): «Accedere con
                                        // l'account d'ufficio» senza un modo di arrivarci.
                                        if !root.exercise-mode: Rectangle {
                                            min-height: rip-190.preferred-height;
                                            rip-190 := HorizontalLayout {
                                                alignment: start;
                                                HudButton {
                                                    label: @tr("Vai ad Account");
                                                    clicked => {
                                                        root.open-page(2);
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }

                                if root.sources-enabled: VerticalLayout {
                                    spacing: 12px;

                                    HorizontalLayout {
                                        spacing: 10px;
                                        vertical-stretch: 0;
                                        HudInput {
                                            placeholder: @tr("Filtra per nome o identificativo");
                                            label: @tr("Filtra le fonti accessibili");
                                            value <=> root.source-filter;
                                            accepted => {
                                                root.filter-sources();
                                            }
                                        }
                                        HudButton {
                                            label: @tr("Filtra");
                                            clicked => {
                                                root.filter-sources();
                                            }
                                        }
                                    }

                                    Text {
                                        text: @tr("Chat accessibili all'account");
                                        color: Palette.text-muted;
                                        font-size: 12px;
                                        font-weight: 700;
                                    }

                                    LegendaOrigini {
                                        osservato: @tr("nome e tipo");
                                        calcolato: @tr("perché non si può scegliere");
                                    }
                                    for entry in root.available-sources: Rectangle {
                                        vertical-stretch: 0;
                                        background: Palette.panel-inset;
                                        border-radius: Spacing.radius-row;

                                        // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                        min-height: rip-46.preferred-height;
                                        rip-46 := HorizontalLayout {
                                            padding: 12px;
                                            spacing: 12px;

                                            VerticalLayout {
                                                spacing: 3px;
                                                Text {
                                                    text: entry.title;
                                                    color: Palette.text;
                                                    font-size: 14px;
                                                    font-weight: 600;
                                                }
                                                Text {
                                                    text: entry.kind + "  -  " + entry.chat-id + (entry.username != "" ? "  -  " + entry.username : "");
                                                    color: Palette.cyan;
                                                    font-size: 12px;
                                                }
                                                if entry.reason != "": Text {
                                                    text: entry.reason;
                                                    color: Palette.coral;
                                                    font-size: 12px;
                                                    wrap: word-wrap;
                                                }
                                                if entry.already-configured: Text {
                                                    text: @tr("Già configurata come fonte.");
                                                    color: Palette.text-muted;
                                                    font-size: 12px;
                                                }
                                            }

                                            HudButton {
                                                label: @tr("Aggiungi");
                                                enabled: entry.selectable;
                                                clicked => {
                                                    root.add-source(entry.chat-id);
                                                }
                                            }
                                        }
                                    }

                                    Rectangle {
                                        height: 1px;
                                        vertical-stretch: 0;
                                        background: Palette.panel-raised;
                                    }

                                    Text {
                                        text: @tr("Fonti configurate");
                                        color: Palette.text-muted;
                                        font-size: 12px;
                                        font-weight: 700;
                                    }

                                    // IL RIEPILOGO DELLA SALUTE, e il comando che
                                    // la verifica.
                                    //
                                    // La frase e' nella forma che il congelamento
                                    // prescrive - «14/15 fonti configurate
                                    // operative» - e nomina SEMPRE quante non
                                    // sono state verificate: «tutte operative»
                                    // detto di un insieme mai guardato e' una
                                    // frase falsa.
                                    if root.configured-sources.length > 0: Rectangle {
                                        // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                        min-height: rip-47.preferred-height;
                                        rip-47 := HorizontalLayout {
                                            spacing: Spacing.sm;
                                            vertical-stretch: 0;

                                            Text {
                                                text: root.health-summary;
                                                color: root.health-needs-attention
                                                    ? Palette.amber
                                                    : Palette.text-muted;
                                                font-size: 12px;
                                                vertical-alignment: center;
                                                wrap: word-wrap;
                                                horizontal-stretch: 1;
                                            }
                                            HudButton {
                                                label: @tr("Verifica le fonti");
                                                enabled: root.can-verify-sources;
                                                clicked => {
                                                    root.verify-sources();
                                                }
                                            }
                                        }
                                    }

                                    // Che cosa costa la verifica, detto prima di
                                    // premerla: e' UNA richiesta a Telegram per
                                    // tutte le fonti, non una per fonte.
                                    if root.configured-sources.length > 0: Text {
                                        text: root.can-verify-sources ? @tr("La verifica legge una volta sola l'elenco delle chat accessibili all'account: una richiesta per tutte le fonti. Non entra in alcun gruppo e non cerca nulla.") : @tr("Per verificare le fonti serve un account collegato.");
                                        color: Palette.text-muted;
                                        font-size: 11px;
                                        wrap: word-wrap;
                                    }

                                    // IL PANNELLO DI DETTAGLIO DELLA SALUTE.
                                    //
                                    // Le tre cose che l'elenco non puo' dire, in
                                    // quest'ordine: perche' la fonte e' in quello
                                    // stato, che cosa impedisce ADESSO, e che cosa
                                    // e' stato osservato finora.
                                    if root.source-health-open: Rectangle {
                                        vertical-stretch: 0;
                                        background: Palette.panel-raised;
                                        border-radius: Spacing.radius-row;
                                        border-width: Spacing.hairline;
                                        border-color: Palette.line-divider;
                                        max-height: 460px;

                                        VerticalLayout {
                                            padding: Spacing.md;
                                            spacing: Spacing.sm;

                                            HorizontalLayout {
                                                spacing: Spacing.sm;
                                                vertical-stretch: 0;

                                                Text {
                                                    text: @tr("PERCHÉ QUESTO STATO");
                                                    color: Palette.text-muted;
                                                    font-size: Typography.group-label;
                                                    letter-spacing: Typography.track-eyebrow;
                                                    vertical-alignment: center;
                                                    horizontal-stretch: 1;
                                                }
                                                HudButton {
                                                    label: @tr("Chiudi");
                                                    clicked => {
                                                        root.close-source-health();
                                                    }
                                                }
                                            }

                                            Text {
                                                text: root.source-health-subject;
                                                color: Palette.text;
                                                font-size: Typography.body-secondary;
                                                wrap: word-wrap;
                                            }

                                            // Lo stato, con lo STESSO colore della
                                            // riga da cui il pannello e' stato
                                            // aperto: due colori diversi per lo
                                            // stesso stato direbbero che sono due
                                            // stati.
                                            Text {
                                                text: root.source-health-state;
                                                color: root.source-health-stopped
                                                    ? Palette.text-disabled
                                                    : root.source-health-attention
                                                        ? (root.source-health-state == @tr("In errore")
                                                            ? Palette.coral
                                                            : Palette.amber)
                                                        : root.source-health-unknown
                                                            ? Palette.text-muted
                                                            : Palette.green;
                                                font-size: Typography.body-secondary;
                                                font-weight: 600;
                                            }

                                            Flickable {
                                                // UN `Flickable` SENZA LARGHEZZA INOLTRA AL GENITORE LA LARGHEZZA MASSIMA DEL
                                                // SUO CONTENUTO (OPERATOR-E2E-REMEDIATION-01, F-05). Un segno d'origine a
                                                // larghezza fissa la rendeva finita; il vincolo saliva fino alla finestra, e
                                                // Slint la restringeva da sola aprendo il pannello (1136×759 → 1016×798).
                                                // Dichiarata qui, non si inoltra.
                                                max-width: 100000px;
                                                // UN `Flickable` NON PRENDE DA SÉ L'ALTEZZA DEL SUO CONTENUTO
                                                // (NEXUM97-FULL-OPERATIONAL-VALIDATION-01, BUG-UI-2). Senza
                                                // un'altezza propria il layout gli dava zero: il pannello
                                                // mostrava nome e stato, e il perché, il silenzio, l'account
                                                // e le verifiche c'erano ma alti zero pixel. Come il pannello
                                                // della decisione: quanto serve, fino a un tetto, poi scorre.
                                                preferred-height: min(salute.preferred-height, 320px);
                                                min-height: min(salute.preferred-height, 120px);
                                                viewport-height: salute.preferred-height;

                                                salute := VerticalLayout {
                                                    spacing: Spacing.sm;

                                                    // ------------------ perche'
                                                    Text {
                                                        text: root.source-health-why;
                                                        color: Palette.text;
                                                        font-size: Typography.body-secondary;
                                                        wrap: word-wrap;
                                                    }

                                                    // Il silenzio, tenuto separato
                                                    // dallo stato: una fonte puo'
                                                    // tacere da mesi ed essere
                                                    // operativa.
                                                    Text {
                                                        text: root.source-health-silence;
                                                        color: Palette.text-muted;
                                                        font-size: Typography.body-secondary;
                                                        wrap: word-wrap;
                                                    }

                                                    // ------------- l'account, che
                                                    // e' evidenza e non stato.
                                                    Text {
                                                        text: @tr("CONDIZIONE DELL'ACCOUNT");
                                                        color: Palette.text-muted;
                                                        font-size: Typography.group-label;
                                                        letter-spacing: Typography.track-eyebrow;
                                                    }
                                                    Text {
                                                        text: root.source-health-account;
                                                        color: Palette.text-muted;
                                                        font-size: Typography.body-secondary;
                                                        wrap: word-wrap;
                                                    }

                                                    // ------------------ la storia
                                                    Text {
                                                        text: @tr("VERIFICHE REGISTRATE");
                                                        color: Palette.text-muted;
                                                        font-size: Typography.group-label;
                                                        letter-spacing: Typography.track-eyebrow;
                                                    }
                                                    Text {
                                                        text: root.source-health-history-note;
                                                        color: Palette.text-muted;
                                                        font-size: Typography.group-label;
                                                        wrap: word-wrap;
                                                    }

                                                    // OGNI RIGA PORTA DUE FRASI.
                                                    //
                                                    // La prima dice come e' andato
                                                    // il tentativo, la seconda che
                                                    // cosa se ne e' appreso della
                                                    // fonte. Un tentativo non
                                                    // riuscito resta NEUTRO: non e'
                                                    // un guasto, e colorarlo come
                                                    // tale sarebbe la falsa
                                                    // attribuzione che ADR-0053
                                                    // esiste per impedire.
                                                    LegendaOrigini {
                                                        calcolato: @tr("controlli ed esito");
                                                    }
                                                    for check in root.source-health-checks: Rectangle {
                                                        // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                                        min-height: rip-48.preferred-height;
                                                        rip-48 := VerticalLayout {
                                                            spacing: Spacing.xs;

                                                            Text {
                                                                text: check.headline;
                                                                color: check.conclusive
                                                                    ? Palette.text
                                                                    : Palette.text-muted;
                                                                font-size: Typography.body-secondary;
                                                                wrap: word-wrap;
                                                            }
                                                            Text {
                                                                text: check.meaning;
                                                                color: Palette.text-muted;
                                                                font-size: Typography.group-label;
                                                                wrap: word-wrap;
                                                            }
                                                            if check.detail != "": Text {
                                                                text: check.detail;
                                                                color: Palette.text-muted;
                                                                font-size: Typography.group-label;
                                                                wrap: word-wrap;
                                                            }
                                                            Text {
                                                                text: check.observer;
                                                                color: Palette.text-muted;
                                                                font-size: Typography.group-label;
                                                                wrap: word-wrap;
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }

                                    if root.configured-sources.length == 0: Text {
                                        text: @tr("Nessuna fonte configurata.");
                                        color: Palette.text-muted;
                                        font-size: 13px;
                                    }

                                    // CHE COSA STAVAMO GUARDANDO (PR-05, ADR-0121). La
                                    // frase che fissa il senso sta sopra le barre: e'
                                    // la cosa da sapere PRIMA di leggerle.
                                    if root.configured-sources.length > 0: Rectangle {
                                        // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                        min-height: rip-49.preferred-height;
                                        rip-49 := VerticalLayout {
                                            spacing: Spacing.xs;
                                            vertical-stretch: 0;

                                            Text {
                                                text: @tr("Che cosa abbiamo guardato negli ultimi sette giorni. {}", root.coverage-meaning);
                                                color: Palette.text-muted;
                                                font-size: Typography.group-label;
                                                wrap: word-wrap;
                                            }
                                            if root.coverage-scope-note != "": Text {
                                                text: root.coverage-scope-note;
                                                color: Palette.amber;
                                                font-size: Typography.group-label;
                                                wrap: word-wrap;
                                            }
                                            LegendaCopertura { }
                                        }
                                    }

                                    LegendaOrigini {
                                        osservato: @tr("nome e identificativo");
                                        calcolato: @tr("salute, ultimi orari e copertura");
                                        operatore: @tr("chi l'ha autorizzata e se è attiva");
                                    }
                                    for source in root.configured-sources: Rectangle {
                                        vertical-stretch: 0;
                                        background: Palette.panel-inset;
                                        border-radius: Spacing.radius-row;

                                        // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                        min-height: rip-50.preferred-height;
                                        rip-50 := HorizontalLayout {
                                            padding: 12px;
                                            spacing: 10px;

                                            VerticalLayout {
                                                spacing: 3px;
                                                Text {
                                                    text: source.title;
                                                    color: source.active ? Palette.text : Palette.text-disabled;
                                                    font-size: 14px;
                                                    font-weight: 600;
                                                }
                                                Text {
                                                    text: @tr("{}  -  {}  -  autorizzata da {}", source.kind, source.identifier, source.authorized-by);
                                                    color: Palette.text-muted;
                                                    font-size: 12px;
                                                    wrap: word-wrap;
                                                }
                                                if source.accounts != "": Text {
                                                    text: source.accounts;
                                                    color: Palette.text-muted;
                                                    font-size: 12px;
                                                    wrap: word-wrap;
                                                }
                                                Text {
                                                    text: source.active ? @tr("Attiva") : @tr("Disattivata");
                                                    color: source.active ? Palette.green : Palette.text-disabled;
                                                    font-size: 12px;
                                                }

                                                // LO STATO DI SALUTE.
                                                //
                                                // Il colore dipende dalla SALUTE TECNICA, non da
                                                // quanti contenuti la fonte abbia prodotto. Una
                                                // fonte che non pubblica da venti giorni ma
                                                // risulta verificata e raggiungibile resta verde.
                                                //
                                                // «Sconosciuta» non e' rossa: una fonte mai
                                                // verificata non e' un guasto, e dipingerla come
                                                // tale insegnerebbe a ignorare il rosso.
                                                Text {
                                                    text: source.health;
                                                    color: source.health-stopped
                                                        ? Palette.text-disabled
                                                        : source.health-attention
                                                            ? (source.health == @tr("In errore")
                                                                ? Palette.coral
                                                                : Palette.amber)
                                                            : source.health-unknown
                                                                ? Palette.text-muted
                                                                : Palette.green;
                                                    font-size: 12px;
                                                    font-weight: 600;
                                                }

                                                // ULTIMA VERIFICA e ULTIMO CONTENUTO, su due righe
                                                // distinte e in quest'ordine.
                                                //
                                                // Sono la coppia che questa milestone esiste per
                                                // non far confondere: la prima dice se la fonte e'
                                                // raggiungibile, la seconda se ha pubblicato. Su
                                                // una riga sola si leggerebbero come una cosa
                                                // sola.
                                                Text {
                                                    text: source.last-check;
                                                    color: Palette.text-muted;
                                                    font-size: 12px;
                                                    wrap: word-wrap;
                                                }
                                                Text {
                                                    text: source.last-content;
                                                    color: Palette.text-muted;
                                                    font-size: 12px;
                                                    wrap: word-wrap;
                                                }

                                                // CHE COSA STAVAMO GUARDANDO (PR-05):
                                                // la barra degli ultimi sette giorni, e
                                                // sotto, a parole, i tratti non coperti.
                                                BarraCopertura {
                                                    tratti: source.coverage;
                                                    recuperati: source.recovered;
                                                    descrizione: source.coverage-summary;
                                                }
                                                Text {
                                                    text: source.coverage-summary;
                                                    color: Palette.text-muted;
                                                    font-size: 12px;
                                                    wrap: word-wrap;
                                                }
                                            }

                                            // «PERCHÉ QUESTO STATO?»
                                            //
                                            // La domanda che l'elenco non puo'
                                            // rispondere: la riga dice lo stato,
                                            // il pannello dice i fatti da cui
                                            // deriva. Senza questo comando,
                                            // «Degradata» resta una parola che
                                            // l'operatore non puo' verificare.
                                            HudButton {
                                                label: @tr("Perché questo stato?");
                                                keep-label: true;
                                                clicked => {
                                                    root.open-source-health(source.source-id);
                                                }
                                            }
                                            if root.members-enabled && source.active: HudButton {
                                                label: @tr("Iscritti");
                                                clicked => {
                                                    root.members-open-for(source.source-id, source.title);
                                                }
                                            }
                                            HudButton {
                                                label: source.active ? @tr("Disattiva") : @tr("Attiva");
                                                clicked => {
                                                    root.toggle-source(source.source-id, !source.active);
                                                }
                                            }
                                            HudButton {
                                                label: @tr("Rimuovi");
                                                clicked => {
                                                    root.remove-source(source.source-id);
                                                }
                                            }
                                        }
                                    }

                                    // GLI ISCRITTI DI UNA FONTE (MEMBERS-01, ADR-0201).
                                    // Il motivo si scrive ogni volta, e la richiesta
                                    // resta nel registro con l'esito.
                                    if root.members-open: Rectangle {
                                        vertical-stretch: 0;
                                        background: Palette.panel-raised;
                                        border-radius: Spacing.radius-row;
                                        border-width: Spacing.hairline;
                                        border-color: Palette.line-divider;
                                        min-height: rip-205.preferred-height;
                                        rip-205 := VerticalLayout {
                                            padding: 12px;
                                            spacing: Spacing.sm;
                                            alignment: start;
                                            Text {
                                                text: root.members-title;
                                                color: Palette.text;
                                                font-size: 14px;
                                                font-weight: 600;
                                                wrap: word-wrap;
                                            }
                                            Text {
                                                text: @tr("Telegram dà l'elenco soltanto dove lo mostra all'account. In un canale lo dà a chi lo amministra; nei gruppi grandi ne dà una parte. Il telefono compare solo se Telegram lo dà, e si vedono soltanto le ultime due cifre.");
                                                color: Palette.amber;
                                                font-size: 12px;
                                                wrap: word-wrap;
                                            }
                                            Text {
                                                text: @tr("Perché si chiedono gli iscritti");
                                                color: Palette.text-muted;
                                                font-size: 12px;
                                            }
                                            HorizontalLayout {
                                                spacing: Spacing.sm;
                                                HudInput {
                                                    placeholder: @tr("Il motivo resta nel registro");
                                                    label: @tr("Perché si chiedono gli iscritti");
                                                    value <=> root.members-reason;
                                                }
                                                VerticalLayout {
                                                    alignment: end;
                                                    HudButton {
                                                        label: @tr("Chiedi gli iscritti");
                                                        clicked => {
                                                            root.members-request();
                                                        }
                                                    }
                                                }
                                                VerticalLayout {
                                                    alignment: end;
                                                    HudButton {
                                                        label: @tr("Chiudi");
                                                        clicked => {
                                                            root.members-close();
                                                        }
                                                    }
                                                }
                                            }
                                            if root.members-message != "": Text {
                                                text: root.members-message;
                                                color: Palette.text;
                                                font-size: 13px;
                                                wrap: word-wrap;
                                            }
                                            if root.members-summary != "": Text {
                                                text: root.members-summary;
                                                color: Palette.text-muted;
                                                font-size: 12px;
                                                wrap: word-wrap;
                                            }
                                            LegendaOrigini {
                                                osservato: @tr("nome, nome utente, posto nel gruppo e telefono nascosto");
                                                operatore: @tr("chi ha chiesto e perché");
                                            }
                                            for riga in root.members-rows: Text {
                                                text: riga;
                                                color: Palette.text;
                                                font-family: Typography.mono;
                                                font-size: Typography.technical;
                                                overflow: elide;
                                            }
                                            if root.members-history != "": Text {
                                                text: root.members-history;
                                                color: Palette.text-muted;
                                                font-family: Typography.mono;
                                                font-size: Typography.technical;
                                                wrap: word-wrap;
                                            }
                                        }
                                    }
                                }

                                // ------------------ i suggerimenti dall'archivio
                                //
                                // SOURCE-SUGGEST-01, ADR-0164: chat di cui una fonte
                                // sorvegliata cita un post. Nessuna richiesta a Telegram
                                // per suggerire; si aggiunge soltanto una chat già
                                // accessibile, una per volta.
                                Text {
                                    text: @tr("SUGGERIMENTI DALL'ARCHIVIO");
                                    color: Palette.text-muted;
                                    font-size: Typography.group-label;
                                    letter-spacing: Typography.track-eyebrow;
                                }
                                Text {
                                    text: @tr("Chat pubbliche di cui una fonte sorvegliata ha citato un post. Non si suggeriscono le menzioni di un nome, che possono essere persone. Per suggerire il programma non chiede nulla a Telegram; si aggiunge soltanto una chat già accessibile all'account.");
                                    color: Palette.text-muted;
                                    font-size: 13px;
                                    wrap: word-wrap;
                                }
                                HorizontalLayout {
                                    spacing: Spacing.sm;
                                    HudInput {
                                        placeholder: @tr("Almeno 5 caratteri");
                                        label: @tr("Perché si ignora un suggerimento");
                                        value <=> root.source-suggestion-reason;
                                    }
                                    VerticalLayout {
                                        alignment: end;
                                        HudButton {
                                            label: @tr("Ricalcola i suggerimenti");
                                            clicked => {
                                                root.source-suggestions-refresh();
                                            }
                                        }
                                    }
                                }
                                if root.source-suggestion-feedback != "": Text {
                                    text: root.source-suggestion-feedback;
                                    color: Palette.text;
                                    font-size: 13px;
                                    wrap: word-wrap;
                                }
                                LegendaOrigini {
                                    osservato: @tr("la chat citata nei contenuti");
                                    calcolato: @tr("quante volte, dove e quando");
                                }
                                for suggerimento in root.source-suggestions: Rectangle {
                                    vertical-stretch: 0;
                                    background: Palette.panel-raised;
                                    border-radius: Spacing.radius-row;
                                    // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                    min-height: rip-194.preferred-height;
                                    rip-194 := VerticalLayout {
                                        padding: Spacing.sm;
                                        spacing: 2px;
                                        Text {
                                            text: suggerimento.title;
                                            color: Palette.text;
                                            font-family: Typography.mono;
                                            font-size: 13px;
                                            wrap: word-wrap;
                                        }
                                        Text {
                                            text: suggerimento.reason;
                                            color: Palette.text-muted;
                                            font-size: 12px;
                                            wrap: word-wrap;
                                        }
                                        HorizontalLayout {
                                            spacing: Spacing.sm;
                                            HudButton {
                                                label: @tr("Aggiungi se accessibile");
                                                clicked => {
                                                    root.source-suggestion-add(suggerimento.address);
                                                }
                                            }
                                            HudButton {
                                                label: @tr("Ignora, con il motivo");
                                                clicked => {
                                                    root.source-suggestion-ignore(suggerimento.address, root.source-suggestion-reason);
                                                }
                                            }
                                            Rectangle { horizontal-stretch: 1; background: transparent; }
                                        }
                                    }
                                }

                                // --------------- l'affidabilita' delle fonti, a mano
                                //
                                // SOURCE-RELIABILITY-01, ADR-0167: una parola dell'ufficio,
                                // con chi, quando e perche'; mai un calcolo.
                                Text {
                                    text: @tr("AFFIDABILITÀ DELLE FONTI, SECONDO L'UFFICIO");
                                    color: Palette.text-muted;
                                    font-size: Typography.group-label;
                                    letter-spacing: Typography.track-eyebrow;
                                }
                                Text {
                                    text: @tr("Una valutazione data a mano, con il motivo: il programma non la calcola, e il numero di iscritti non la misura. Non rende vero o falso un contenuto, che si valuta comunque.");
                                    color: Palette.text-muted;
                                    font-size: 13px;
                                    wrap: word-wrap;
                                }
                                HudInput {
                                    placeholder: @tr("Almeno 20 caratteri");
                                    label: @tr("Perché si valuta, o si ritira la valutazione");
                                    value <=> root.source-reliability-reason;
                                }
                                if root.source-reliability-feedback != "": Text {
                                    text: root.source-reliability-feedback;
                                    color: Palette.text;
                                    font-size: 13px;
                                    wrap: word-wrap;
                                }
                                LegendaOrigini {
                                    operatore: @tr("la valutazione, chi l'ha data, quando e perché");
                                }
                                for fonte in root.source-reliability-rows: Rectangle {
                                    vertical-stretch: 0;
                                    background: Palette.panel-raised;
                                    border-radius: Spacing.radius-row;
                                    // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                    min-height: rip-196.preferred-height;
                                    rip-196 := VerticalLayout {
                                        padding: Spacing.sm;
                                        spacing: 2px;
                                        Text {
                                            text: fonte.name;
                                            color: Palette.text;
                                            font-size: 13px;
                                            wrap: word-wrap;
                                        }
                                        Text {
                                            text: fonte.sentence;
                                            color: Palette.text-muted;
                                            font-size: 12px;
                                            wrap: word-wrap;
                                        }
                                        HorizontalLayout {
                                            spacing: Spacing.sm;
                                            HudButton {
                                                label: @tr("Affidabile");
                                                clicked => {
                                                    root.source-reliability-record(fonte.source-id, 0);
                                                }
                                            }
                                            HudButton {
                                                label: @tr("Da verificare");
                                                clicked => {
                                                    root.source-reliability-record(fonte.source-id, 1);
                                                }
                                            }
                                            HudButton {
                                                label: @tr("Poco affidabile");
                                                clicked => {
                                                    root.source-reliability-record(fonte.source-id, 2);
                                                }
                                            }
                                            HudButton {
                                                label: @tr("Ritira");
                                                clicked => {
                                                    root.source-reliability-record(fonte.source-id, 3);
                                                }
                                            }
                                            Rectangle { horizontal-stretch: 1; background: transparent; }
                                        }
                                    }
                                }

                                Rectangle { vertical-stretch: 1; background: transparent; }
                            }
                        }
                    }

                    // ------------------------------------------------- Dizionari
                    if root.current-page == 4: Rectangle {
                        // Comparsa graduale della pagina: vedere la pagina 0 per il
                        // perche' la dissolvenza sia solo in entrata.
                        property <bool> entered: false;
                        opacity: 0.0;
                        init => {
                            self.entered = true;
                            // Una richiesta rimasta da una visita di prima non vale.
                            root.bozza-da-mostrare = false;
                        }
                        animate opacity {
                            duration: Motion.transition-effective;
                            easing: cubic-bezier(0.16, 1, 0.3, 1);
                        }
        states [
            shown when self.entered: {
                opacity: 1.0;
            }
        ]
                        background: Palette.panel;
                        border-radius: Spacing.radius-panel;
                        // La bozza e i termini chiesti da «Modifica la bozza» o
                        // «Vedi termini» si portano in vista al giro dopo, quando
                        // l'altezza della schermata li comprende (CU01-014).
                        Timer {
                            interval: Motion.settle;
                            running: root.bozza-da-mostrare;
                            triggered => {
                                root.bozza-da-mostrare = false;
                                root.porta-in-vista(dizionario-posto.absolute-position.y);
                            }
                        }

                        VerticalLayout {
                            padding: Spacing.xl;
                            spacing: Spacing.lg;

                            HorizontalLayout {
                                spacing: Spacing.md;
                                vertical-stretch: 0;

                                VerticalLayout {
                                    spacing: Spacing.xs;
                                    Text {
                                        text: @tr("Dizionari");
                                        color: Palette.text;
                                        font-size: Typography.screen-title;
                                        font-weight: Typography.medium;
                                    }
                                    Text {
                                        text: @tr("I dizionari di sistema non si modificano: si duplicano. Una versione pubblicata non cambia più, ed è ciò che rende ripetibile una sessione conclusa.");
                                        color: Palette.text-muted;
                                        font-size: Typography.body-secondary;
                                        wrap: word-wrap;
                                    }
                                }

                                // Contatore dei dizionari realmente utilizzabili. E'
                                // l'unico elemento focale della schermata: amber
                                // non compare altrove.
                                Rectangle {
                                    width: 168px;
                                    height: 52px;
                                    horizontal-stretch: 0;
                                    vertical-stretch: 0;
                                    background: Palette.panel-raised;
                                    border-radius: Spacing.radius-row;
                                    border-width: Spacing.hairline;
                                    border-color: Palette.line-divider;

                                    HorizontalLayout {
                                        padding-left: Spacing.md;
                                        padding-right: Spacing.md;
                                        spacing: Spacing.sm;

                                        Text {
                                            text: root.dictionaries-usable-count;
                                            color: root.dictionaries-usable-count > 0
                                                ? Palette.amber
                                                : Palette.text-muted;
                                            font-size: 26px;
                                            font-weight: Typography.medium;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            // Il nome segue il numero (E2E01-15).
                                            text: root.dictionaries-usable-count == 1 ? @tr("utilizzabile\nper un monitoraggio") : @tr("utilizzabili\nper un monitoraggio");
                                            color: Palette.text-muted;
                                            font-size: Typography.group-label;
                                            vertical-alignment: center;
                                            wrap: word-wrap;
                                        }
                                    }

                                    accessible-role: text;
                                    accessible-label: root.dictionaries-usable-count == 1 ? @tr("1 dizionario utilizzabile per un monitoraggio") : @tr("{} dizionari utilizzabili per un monitoraggio", root.dictionaries-usable-count);
                                }
                            }

                            // Ricerca e filtri. La ricerca usa la stessa
                            // normalizzazione dei termini: una ricerca piu' permissiva
                            // del motore troverebbe dizionari i cui termini poi non
                            // riscontrerebbero.
                            HorizontalLayout {
                                spacing: Spacing.md;
                                vertical-stretch: 0;

                                HudInput {
                                    placeholder: @tr("Cerca per nome o descrizione");
                                    label: @tr("Cerca nella libreria dei dizionari");
                                    value <=> root.dictionary-filter;
                                    edited => {
                                        root.filter-dictionaries();
                                    }
                                }

                                HudButton {
                                    label: root.only-usable ? @tr("Solo utilizzabili \u{2713}") : @tr("Solo utilizzabili");
                                    clicked => {
                                        root.only-usable = !root.only-usable;
                                        root.filter-dictionaries();
                                    }
                                }

                                HudButton {
                                    label: root.only-editable ? @tr("Solo modificabili \u{2713}") : @tr("Solo modificabili");
                                    clicked => {
                                        root.only-editable = !root.only-editable;
                                        root.filter-dictionaries();
                                    }
                                }
                            }

                            if root.dictionaries-message != "": InfoBanner {
                                message: root.dictionaries-message;
                            }

                            // Import di un dizionario da file. Il formato di scambio
                            // esisteva ed era collaudato dal 2026, ma nessun punto
                            // dell'interfaccia lo chiamava: era usato soltanto dai
                            // dizionari che il prodotto stesso spedisce. Collegato il
                            // 2026-07-31.
                            Rectangle {
                                // Altezza dal contenuto: era fissa a 108 pixel e
                                // toglieva spazio all'elenco (F-16).
                                height: importa-dizionario.preferred-height;
                                background: Palette.panel-raised;
                                border-radius: Spacing.radius-row;
                                border-width: Spacing.hairline;
                                border-color: Palette.line-divider;

                                importa-dizionario := VerticalLayout {
                                    padding: Spacing.md;
                                    spacing: Spacing.sm;

                                    Text {
                                        text: @tr("Importare un dizionario");
                                        color: Palette.text;
                                        font-size: Typography.body;
                                        font-weight: Typography.medium;
                                    }
                                    Text {
                                        // L'operatore importa e pubblica (ADR-0140): il
                                        // file entra in bozza e non si usa finché
                                        // qualcuno non lo pubblica, con la conferma.
                                        text: @tr("Scegliere un file nel formato di scambio del prodotto. Il dizionario entra personale e in bozza. Non si usa in un monitoraggio finché non lo si controlla e lo si pubblica: un file importato non è ancora passato da una persona.");
                                        color: Palette.text-muted;
                                        font-size: Typography.body-secondary;
                                        wrap: word-wrap;
                                    }
                                    HorizontalLayout {
                                        spacing: Spacing.md;
                                        // La via normale: una finestra di sistema. Far
                                        // digitare un percorso a mano produce rifiuti
                                        // che sembrano guasti, ed e' successo al primo
                                        // tentativo reale.
                                        HudButton {
                                            label: @tr("Scegli il file…");
                                            weight: Weight.primary;
                                            clicked => {
                                                root.dictionaries-choose-file();
                                            }
                                        }
                                        // Il campo resta per chi ha gia' un percorso
                                        // negli appunti o lavora senza mouse.
                                        HudInput {
                                            placeholder: @tr("oppure incollare qui un percorso");
                                            label: @tr("Percorso del file di dizionario da importare");
                                            value <=> root.dictionary-import-path;
                                            accepted => {
                                                root.dictionaries-import();
                                            }
                                        }
                                        HudButton {
                                            label: @tr("Importa");
                                            enabled: root.dictionary-import-path != "";
                                            clicked => {
                                                root.dictionaries-import();
                                            }
                                        }
                                    }
                                }
                            }

                            // Lo scaricamento dalla fonte dell'ufficio (DICT-NET-01,
                            // ADR-0178). Si va in rete soltanto quando qualcuno
                            // preme, e soltanto verso l'indirizzo scritto qui.
                            Rectangle {
                                height: scarica-dizionario.preferred-height;
                                background: Palette.panel-raised;
                                border-radius: Spacing.radius-row;
                                border-width: Spacing.hairline;
                                border-color: Palette.line-divider;

                                scarica-dizionario := VerticalLayout {
                                    padding: Spacing.md;
                                    spacing: Spacing.sm;

                                    Text {
                                        text: @tr("Scaricare un dizionario dalla fonte dell'ufficio");
                                        color: Palette.text;
                                        font-size: Typography.body;
                                        font-weight: Typography.medium;
                                    }
                                    Text {
                                        text: @tr("Il programma va in rete solo quando si preme «Scarica il dizionario», e solo verso l'indirizzo qui sotto. Il dizionario entra soltanto se è firmato da un certificato ammesso. Entra personale e in bozza, come un file importato.");
                                        color: Palette.text-muted;
                                        font-size: Typography.body-secondary;
                                        wrap: word-wrap;
                                    }
                                    HudInput {
                                        label: @tr("Indirizzo dei dizionari");
                                        placeholder: @tr("https://...");
                                        enabled: root.administrator-mode;
                                        value <=> root.dictionary-source;
                                    }
                                    HudInput {
                                        label: @tr("Impronte dei certificati ammessi a firmare, separate da virgole");
                                        placeholder: @tr("impronta del certificato");
                                        enabled: root.administrator-mode;
                                        value <=> root.dictionary-signers;
                                    }
                                    if root.dictionary-source-note != "": Text {
                                        text: root.dictionary-source-note;
                                        color: Palette.text-muted;
                                        font-size: Typography.body-secondary;
                                        wrap: word-wrap;
                                    }
                                    HorizontalLayout {
                                        spacing: Spacing.md;
                                        alignment: start;
                                        if root.administrator-mode: HudButton {
                                            label: @tr("Salva la fonte e i firmatari");
                                            clicked => {
                                                root.save-dictionary-source();
                                            }
                                        }
                                        HudButton {
                                            label: @tr("Scarica il dizionario");
                                            weight: Weight.primary;
                                            clicked => {
                                                root.download-dictionary();
                                            }
                                        }
                                    }
                                    if root.dictionary-download-message != "": Text {
                                        text: root.dictionary-download-message;
                                        color: Palette.text;
                                        font-size: Typography.body-secondary;
                                        wrap: word-wrap;
                                    }
                                    if root.dictionary-downloads-text != "": Text {
                                        text: root.dictionary-downloads-text;
                                        color: Palette.text-muted;
                                        font-size: Typography.body-secondary;
                                        wrap: word-wrap;
                                    }
                                }
                            }

                            // Stato vuoto: dice che cosa fare, non solo che non c'e'
                            // nulla. Un elenco vuoto senza istruzioni lascia
                            // l'operatore fermo.
                            if root.dictionaries.length == 0: Rectangle {
                                background: Palette.panel-raised;
                                border-radius: Spacing.radius-row;

                                // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                min-height: rip-51.preferred-height;
                                rip-51 := VerticalLayout {
                                    padding: Spacing.xl;
                                    spacing: Spacing.sm;
                                    alignment: center;

                                    // Due stati vuoti diversi, perche' la via d'uscita
                                    // e' diversa: da una ricerca senza esiti si esce
                                    // cambiando la ricerca, da una libreria vuota no.
                                    Text {
                                        text: root.filter-active ? @tr("Nessun dizionario corrisponde alla ricerca") : @tr("Nessun dizionario disponibile");
                                        color: Palette.text;
                                        font-size: Typography.section-title;
                                        font-weight: Typography.medium;
                                        horizontal-alignment: center;
                                    }
                                    Text {
                                        text: root.filter-active ? @tr("Cambiare il testo cercato, oppure togliere i filtri \"Solo utilizzabili\" e \"Solo modificabili\".") : @tr("I dizionari forniti con il prodotto vengono installati al primo avvio. Se l'elenco resta vuoto, la libreria non è raggiungibile: segnalarlo all'amministratore.");
                                        color: Palette.text-muted;
                                        font-size: Typography.body-secondary;
                                        horizontal-alignment: center;
                                        wrap: word-wrap;
                                    }
                                }
                            }

                            // Detto una volta sola, non su ogni riga: e' la stessa
                            // informazione per tutti i dizionari, e ripeterla riga per
                            // riga aveva anche un costo di spazio - il riquadro di una
                            // riga e' dimensionato per tre pulsanti, e la quarta voce
                            // usciva dal bordo (rilevato dall'operatore il 2026-08-03).
                            Text {
                                text: @tr("«Elimina» cancella davvero il dizionario, e lo archivia soltanto se è già stato usato da un monitoraggio: cancellarlo renderebbe quella sessione illeggibile. I dizionari di sistema non si modificano né si eliminano — si duplicano, e la copia è tutta vostra.");
                                color: Palette.text-muted;
                                font-size: Typography.body-secondary;
                                wrap: word-wrap;
                            }

                            // LA LIBRERIA SCORRE CON LA SCHERMATA (CU01-014,
                            // DEC-507). Aveva un'area a scorrimento sua, alta
                            // quanto restava sotto l'importazione e lo
                            // scaricamento: circa 200px, con la bozza dentro.
                            VerticalLayout {
                                vertical-stretch: 0;
                                VerticalLayout {
                                    spacing: Spacing.sm;

                                    LegendaOrigini {
                                        calcolato: @tr("stato, origine e numero di termini");
                                        operatore: @tr("nome, descrizione, ambito e versione");
                                    }
                                    for entry[index] in root.dictionaries: Rectangle {
                                        // L'ALTEZZA LA DECIDE IL CONTENUTO
                                        // (OPERATOR-E2E-REMEDIATION-01, F-03 e F-07).
                                        // Era fissa a 144 pixel per tre pulsanti
                                        // impilati: un quarto comando, o la domanda
                                        // di conferma, sarebbe uscito dal riquadro.
                                        height: max(112px, riga-dizionario.preferred-height);
                                        background: Palette.panel-raised;
                                        border-radius: Spacing.radius-row;
                                        border-width: Spacing.hairline;
                                        border-color: root.dictionary-delete-armed == entry.dictionary-id
                                            ? Palette.coral
                                            : Palette.line-divider;

                                        riga-dizionario := VerticalLayout {
                                        HorizontalLayout {
                                            padding: Spacing.md;
                                            spacing: Spacing.md;

                                            // Barra di stato: utilizzabile o no, anche
                                            // senza leggere il testo.
                                            Rectangle {
                                                width: 4px;
                                                horizontal-stretch: 0;
                                                border-radius: Spacing.radius-row;
                                                background: entry.usable
                                                    ? Palette.frame
                                                    : Palette.line-divider;
                                            }

                                            VerticalLayout {
                                                spacing: Spacing.xs;

                                                HorizontalLayout {
                                                    spacing: Spacing.sm;
                                                    Text {
                                                        text: entry.name;
                                                        color: Palette.text;
                                                        font-size: Typography.section-title;
                                                        font-weight: Typography.medium;
                                                        vertical-alignment: center;
                                                    }
                                                    Text {
                                                        text: entry.built-in ? @tr("di sistema") : entry.visibility;
                                                        color: Palette.cyan;
                                                        font-size: Typography.group-label;
                                                        font-weight: Typography.medium;
                                                        vertical-alignment: center;
                                                    }
                                                    Rectangle { horizontal-stretch: 1; background: transparent; }
                                                }

                                                Text {
                                                    text: entry.description;
                                                    color: Palette.text-muted;
                                                    font-size: Typography.body-secondary;
                                                    wrap: word-wrap;
                                                    max-height: 34px;
                                                }

                                                Text {
                                                    text: entry.published-version > 0 ? @tr("Versione {} \u{00b7} {} termini{}", entry.published-version, entry.published-terms, (entry.has-open-draft ? @tr(" \u{00b7} bozza aperta") : "")) : @tr("Nessuna versione pubblicata");
                                                    color: Palette.text-muted;
                                                    font-size: Typography.technical;
                                                }

                                                if !entry.usable: Text {
                                                    text: entry.unusable-reason;
                                                    color: Palette.coral;
                                                    font-size: Typography.body-secondary;
                                                    wrap: word-wrap;
                                                }
                                            }

                                            // Quattro comandi in due righe, tutti
                                            // della stessa larghezza (F-32): erano
                                            // impilati e larghi quanto la propria
                                            // etichetta, e le righe vicine non
                                            // erano allineate.
                                            VerticalLayout {
                                                spacing: Spacing.sm;
                                                alignment: center;
                                                horizontal-stretch: 0;

                                                HorizontalLayout {
                                                    spacing: Spacing.sm;
                                                    // Con una bozza aperta il comando
                                                    // porta alla **modifica**, non a una
                                                    // semplice lettura, e lo dice.
                                                    //
                                                    // Era condizionato alla sola versione
                                                    // pubblicata: un dizionario appena
                                                    // duplicato non ne ha, quindi il
                                                    // comando restava disabilitato e la
                                                    // bozza era irraggiungibile (rilevato
                                                    // dall'operatore il 2026-08-03).
                                                    HudButton {
                                                        width: 176px;
                                                        label: entry.has-open-draft ? @tr("Modifica la bozza") : @tr("Vedi termini");
                                                        enabled: entry.published-version > 0
                                                            || entry.has-open-draft;
                                                        clicked => {
                                                            root.selected-dictionary = entry.dictionary-id;
                                                            root.preview-dictionary(entry.dictionary-id);
                                                            // La bozza e i termini si
                                                            // aprono sotto la libreria:
                                                            // si portano in vista.
                                                            if (root.draft-open || root.preview-title != "") {
                                                                root.bozza-da-mostrare = true;
                                                            }
                                                        }
                                                    }
                                                    HudButton {
                                                        width: 176px;
                                                        label: @tr("Duplica");
                                                        enabled: entry.published-version > 0;
                                                        reason: @tr("Ne fa una copia personale, in bozza, da modificare.");
                                                        clicked => {
                                                            root.duplicate-dictionary(entry.dictionary-id);
                                                        }
                                                    }
                                                }
                                                HorizontalLayout {
                                                    spacing: Spacing.sm;
                                                    // UNA BOZZA NUOVA DA UNA VERSIONE
                                                    // PUBBLICATA (F-07): copia i termini
                                                    // della pubblicata, che non cambia. Un
                                                    // dizionario di sistema non si
                                                    // modifica: si duplica. Con una bozza
                                                    // gia' aperta il comando porta a
                                                    // provarla nel Laboratorio.
                                                    if !entry.has-open-draft: HudButton {
                                                        width: 176px;
                                                        label: @tr("Nuova versione");
                                                        enabled: entry.published-version > 0 && !entry.built-in;
                                                        reason: entry.built-in ? @tr("Un dizionario di sistema non si modifica: si duplica.") : @tr("Apre una bozza con i termini della versione pubblicata, che resta com'è.");
                                                        clicked => {
                                                            root.selected-dictionary = entry.dictionary-id;
                                                            root.start-new-version(entry.dictionary-id);
                                                        }
                                                    }
                                                    if entry.has-open-draft: HudButton {
                                                        width: 176px;
                                                        label: @tr("Prova nel Laboratorio");
                                                        reason: @tr("Mostra che cosa la bozza cambia, prima di pubblicarla.");
                                                        clicked => {
                                                            root.lab-requested-dictionary = entry.dictionary-id;
                                                            root.open-page(19);
                                                        }
                                                    }
                                                    // Il comando **cancella** quando
                                                    // puo', e archivia solo se il
                                                    // dizionario e' gia' stato usato da
                                                    // una sessione. Basta che non sia di
                                                    // sistema. CHIEDE CONFERMA (F-22): il
                                                    // primo clic apre la domanda qui sotto,
                                                    // e una bozza non si perde piu' con un
                                                    // clic solo.
                                                    HudButton {
                                                        width: 176px;
                                                        label: @tr("Elimina…");
                                                        weight: Weight.danger;
                                                        enabled: !entry.built-in
                                                            && root.dictionary-delete-armed != entry.dictionary-id;
                                                        clicked => {
                                                            root.dictionary-delete-armed = entry.dictionary-id;
                                                        }
                                                    }
                                                }
                                                // ESPORTARE DALLA SCHERMATA (GAP-19): la
                                                // versione pubblicata, nel formato di
                                                // scambio, con l'impronta dei termini che
                                                // l'altra postazione confronta.
                                                HorizontalLayout {
                                                    spacing: Spacing.sm;
                                                    HudButton {
                                                        width: 176px;
                                                        label: @tr("Esporta…");
                                                        enabled: entry.published-version > 0;
                                                        reason: @tr("Scrive la versione pubblicata in un file, con l'impronta dei termini.");
                                                        clicked => {
                                                            root.export-dictionary(entry.dictionary-id);
                                                        }
                                                    }
                                                    if root.signing-available: HudButton {
                                                        width: 176px;
                                                        label: @tr("Esporta e firma…");
                                                        enabled: entry.published-version > 0;
                                                        reason: @tr("Scrive la versione pubblicata e la firma con il certificato dell'ufficio.");
                                                        clicked => {
                                                            root.export-dictionary-signed(entry.dictionary-id);
                                                        }
                                                    }
                                                }
                                            }
                                        }

                                        // LA DOMANDA PRIMA DI ELIMINARE, dentro la
                                        // riga del dizionario di cui si chiede, con
                                        // la conferma in un posto diverso dal primo
                                        // clic: un doppio clic non elimina.
                                        if root.dictionary-delete-armed == entry.dictionary-id: Rectangle {
                                            // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                            min-height: rip-52.preferred-height;
                                            rip-52 := HorizontalLayout {
                                                padding-left: Spacing.md;
                                                padding-right: Spacing.md;
                                                padding-bottom: Spacing.md;
                                                spacing: Spacing.sm;

                                                Text {
                                                    text: entry.published-version > 0 ? @tr("Eliminare «{}»? Se un monitoraggio lo ha già usato si archivia, e non è più proposto. Altrimenti si cancella, con tutte le sue versioni.", entry.name) : @tr("Eliminare «{}»? Ha soltanto una bozza: si cancella, e i termini scritti finora vanno persi.", entry.name);
                                                    color: Palette.text;
                                                    font-size: Typography.body-secondary;
                                                    wrap: word-wrap;
                                                    horizontal-stretch: 1;
                                                    vertical-alignment: center;
                                                }
                                                HudButton {
                                                    label: @tr("Annulla");
                                                    clicked => {
                                                        root.dictionary-delete-armed = 0;
                                                    }
                                                }
                                                HudButton {
                                                    label: @tr("Sì, elimina");
                                                    weight: Weight.danger;
                                                    clicked => {
                                                        root.dictionary-delete-armed = 0;
                                                        root.archive-dictionary(entry.dictionary-id);
                                                    }
                                                }
                                            }
                                        }
                                        }

                                        accessible-role: list-item;
                                        accessible-label: entry.name + ", " + entry.status + (entry.usable ? @tr(", utilizzabile") : ", " + entry.unusable-reason);
                                    }

                                    // Il segnaposto dice dove comincia cio' che
                                    // si apre sotto la libreria (CU01-014).
                                    dizionario-posto := Rectangle {
                                        height: 0px;
                                        vertical-stretch: 0;
                                    }
                                    // Modifica della bozza. Compare solo quando il
                                    // dizionario selezionato ne ha una aperta: una
                                    // versione pubblicata non si tocca, ed e' cio' che
                                    // rende confrontabile lo stesso dizionario fra
                                    // postazioni diverse.
                                    if root.draft-open: Rectangle {
                                        // Altezza dal contenuto: con la domanda di
                                        // conferma il riquadro cresce invece di
                                        // tagliarla (F-03).
                                        height: modifica-bozza.preferred-height;
                                        background: Palette.accent-surface;
                                        border-radius: Spacing.radius-row;
                                        border-width: Spacing.hairline;
                                        border-color: Palette.frame;

                                        modifica-bozza := VerticalLayout {
                                            padding: Spacing.md;
                                            spacing: Spacing.sm;

                                            Text {
                                                text: @tr("Bozza in lavorazione — {}", root.draft-title);
                                                color: Palette.text;
                                                font-size: Typography.body;
                                                font-weight: Typography.medium;
                                            }
                                            Text {
                                                text: @tr("I termini qui sotto sono quelli della bozza. Aggiungerne e toglierne finché serve, poi pubblicare: da quel momento la versione diventa immutabile e utilizzabile in un monitoraggio.");
                                                color: Palette.text-muted;
                                                font-size: Typography.body-secondary;
                                                wrap: word-wrap;
                                            }
                                            HorizontalLayout {
                                                spacing: Spacing.md;
                                                HudInput {
                                                    placeholder: @tr("parola o frase");
                                                    label: @tr("Termine da aggiungere alla bozza");
                                                    value <=> root.draft-term-input;
                                                    accepted => {
                                                        root.add-draft-term();
                                                    }
                                                }
                                                HudInput {
                                                    placeholder: @tr("categoria, es. azione");
                                                    label: @tr("Categoria del termine");
                                                    value <=> root.draft-category-input;
                                                }
                                                HudSelect {
                                                    label: @tr("Livello suggerito del termine");
                                                    model: [@tr("Livello 1 — debole"), @tr("Livello 2 — da tenere d'occhio"), @tr("Livello 3 — forte"), @tr("Livello 4 — prioritario"), @tr("Livello -1 — attenua"), @tr("Livello -2 — attenua molto"), @tr("Livello -3 — contesto estraneo")];
                                                    current-index <=> root.draft-level-index;
                                                }
                                                HudButton {
                                                    label: @tr("Aggiungi");
                                                    enabled: root.draft-term-input != ""
                                                        && root.draft-category-input != "";
                                                    clicked => {
                                                        root.add-draft-term();
                                                    }
                                                }
                                            }
                                            HorizontalLayout {
                                                spacing: Spacing.sm;
                                                HudButton {
                                                    label: @tr("Prova nel Laboratorio");
                                                    reason: @tr("Mostra che cosa la bozza cambia, prima di pubblicarla.");
                                                    clicked => {
                                                        root.lab-requested-dictionary = root.selected-dictionary;
                                                        root.open-page(19);
                                                    }
                                                }
                                                // PUBBLICARE CHIEDE CONFERMA (ADR-0140):
                                                // il primo clic apre la domanda qui
                                                // sotto, con la conseguenza.
                                                HudButton {
                                                    label: @tr("Pubblica la bozza…");
                                                    weight: Weight.primary;
                                                    enabled: !root.publish-armed;
                                                    clicked => {
                                                        root.publish-armed = true;
                                                    }
                                                }
                                                Rectangle { horizontal-stretch: 1; background: transparent; }
                                            }
                                            if root.publish-armed: Rectangle {
                                                // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                                min-height: rip-53.preferred-height;
                                                rip-53 := HorizontalLayout {
                                                    spacing: Spacing.sm;
                                                    Text {
                                                        text: @tr("Pubblicare {}? Da quel momento la versione non si modifica più, e la useranno i monitoraggi che la sceglieranno. I monitoraggi già condotti restano con la versione che avevano.", root.draft-title);
                                                        color: Palette.text;
                                                        font-size: Typography.body-secondary;
                                                        wrap: word-wrap;
                                                        horizontal-stretch: 1;
                                                        vertical-alignment: center;
                                                    }
                                                    HudButton {
                                                        label: @tr("Annulla");
                                                        clicked => {
                                                            root.publish-armed = false;
                                                        }
                                                    }
                                                    HudButton {
                                                        label: @tr("Sì, pubblica");
                                                        weight: Weight.primary;
                                                        clicked => {
                                                            root.publish-armed = false;
                                                            root.publish-draft();
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }

                                    // Anteprima: che cosa il dizionario contiene, non
                                    // solo quanti termini ha. E' il solo modo per
                                    // scegliere con cognizione prima di un monitoraggio.
                                    if root.preview-title != "": Rectangle {
                                        background: Palette.panel;
                                        border-radius: Spacing.radius-row;
                                        border-width: Spacing.hairline;
                                        border-color: Palette.frame;

                                        // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                        min-height: rip-54.preferred-height;
                                        rip-54 := VerticalLayout {
                                            padding: Spacing.md;
                                            spacing: Spacing.sm;

                                            Text {
                                                text: root.preview-title;
                                                color: Palette.text;
                                                font-size: Typography.section-title;
                                                font-weight: Typography.medium;
                                            }
                                            if root.preview-note != "": Text {
                                                text: root.preview-note;
                                                color: Palette.text-muted;
                                                font-size: Typography.body-secondary;
                                                wrap: word-wrap;
                                            }

                                            LegendaOrigini {
                                                operatore: @tr("le parole e le loro regole");
                                            }
                                            // LE COLONNE HANNO UN NOME (F-33): «-2» o «+1» da soli non
                                            // dicevano che sono il livello suggerito.
                                            HorizontalLayout {
                                                spacing: Spacing.md;
                                                vertical-stretch: 0;
                                                if root.draft-open: Rectangle { width: 96px; }
                                                Text {
                                                    text: @tr("Livello");
                                                    color: Palette.text-muted;
                                                    font-size: Typography.group-label;
                                                    width: 28px;
                                                    horizontal-alignment: right;
                                                }
                                                Text {
                                                    text: @tr("Termine");
                                                    color: Palette.text-muted;
                                                    font-size: Typography.group-label;
                                                    width: 190px;
                                                }
                                                Text {
                                                    text: @tr("Come si cerca");
                                                    color: Palette.text-muted;
                                                    font-size: Typography.group-label;
                                                    width: 150px;
                                                }
                                                Text {
                                                    text: @tr("Nota");
                                                    color: Palette.text-muted;
                                                    font-size: Typography.group-label;
                                                    horizontal-stretch: 1;
                                                }
                                            }
                                            for term in root.preview-terms: Rectangle {
                                                // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                                min-height: rip-55.preferred-height;
                                                rip-55 := HorizontalLayout {
                                                    spacing: Spacing.md;

                                                    // Si toglie solo da una bozza: `term-id`
                                                    // vale zero per una versione pubblicata,
                                                    // che e' immutabile.
                                                    if root.draft-open && term.term-id != 0: HudButton {
                                                        label: @tr("Togli");
                                                        // Larghezza fissa (F-32): seguiva lo spazio rimasto,
                                                        // da 96 a 188 px, e le colonne si sfalsavano.
                                                        width: 96px;
                                                        clicked => {
                                                            root.remove-draft-term(term.term-id);
                                                        }
                                                    }
                                                    Text {
                                                        text: term.suggested-level;
                                                        // Il contesto riduttivo si distingue
                                                        // a colpo d'occhio: e' cio' che
                                                        // permette a un dizionario di
                                                        // riconoscere il proprio errore.
                                                        color: term.mitigating
                                                            ? Palette.cyan
                                                            : Palette.frame-dim;
                                                        font-size: Typography.technical;
                                                        font-weight: Typography.medium;
                                                        width: 28px;
                                                        horizontal-alignment: right;
                                                    }
                                                    Text {
                                                        text: term.text;
                                                        color: Palette.text;
                                                        font-size: Typography.body-secondary;
                                                        width: 190px;
                                                        overflow: elide;
                                                    }
                                                    Text {
                                                        text: term.match-mode;
                                                        color: Palette.text-muted;
                                                        font-size: Typography.group-label;
                                                        width: 150px;
                                                        vertical-alignment: center;
                                                    }
                                                    Text {
                                                        text: term.note;
                                                        color: Palette.text-muted;
                                                        font-size: Typography.group-label;
                                                        overflow: elide;
                                                        horizontal-stretch: 1;
                                                    }
                                                }
                                            }
                                        }
                                    }

                                    Rectangle { vertical-stretch: 1; background: transparent; }
                                }
                            }
                        }
                    }

                    // --------------------------------------- Nuovo monitoraggio
                    if root.current-page == 6: Rectangle {
                        // Comparsa graduale della pagina: vedere la pagina 0 per il
                        // perche' la dissolvenza sia solo in entrata.
                        property <bool> entered: false;
                        opacity: 0.0;
                        init => {
                            self.entered = true;
                        }
                        animate opacity {
                            duration: Motion.transition-effective;
                            easing: cubic-bezier(0.16, 1, 0.3, 1);
                        }
        states [
            shown when self.entered: {
                opacity: 1.0;
            }
        ]
                        background: Palette.panel;
                        border-radius: Spacing.radius-panel;

                        VerticalLayout {
                            padding: Spacing.xl;
                            spacing: Spacing.lg;

                            if root.wizard-template-note != "": InfoBanner {
                                message: root.wizard-template-note;
                            }

                            // Barra dei passi: dove si e' e quanto manca. Il passo
                            // raggiunto si distingue anche dalla forma, non dal solo
                            // colore.
                            HorizontalLayout {
                                spacing: Spacing.sm;
                                vertical-stretch: 0;

                                for entry in root.wizard-steps: Rectangle {
                                    height: 32px;
                                    background: entry.current ? Palette.panel-raised : transparent;
                                    border-radius: Spacing.radius-row;

                                    HorizontalLayout {
                                        padding-left: Spacing.sm;
                                        padding-right: Spacing.sm;
                                        spacing: 6px;

                                        Rectangle {
                                            width: 8px;
                                            height: 8px;
                                            horizontal-stretch: 0;
                                            vertical-stretch: 0;
                                            border-radius: Spacing.radius-row;
                                            border-width: 2px;
                                            border-color: entry.reached
                                                ? Palette.frame
                                                : Palette.line-divider;
                                            background: entry.current
                                                ? Palette.frame
                                                : transparent;
                                        }
                                        Text {
                                            // L'ETICHETTA PUO' STRINGERSI (FINAL-FPR-ALL-16,
                                            // FPR-16).
                                            //
                                            // Senza un minimo dichiarato, la barra dei passi
                                            // chiede la propria larghezza naturale — sei
                                            // etichette intere, circa settecento pixel — e la
                                            // alza a larghezza minima della finestra: a 900
                                            // pixel il pannello del wizard finiva oltre il
                                            // bordo destro, «Avanti» compreso. Misurato, non
                                            // supposto: cattura 600-6 del 2026-10-12.
                                            //
                                            // `min-width` dichiara che l'etichetta può
                                            // ridursi al proprio numero, e `elide` dice come:
                                            // i puntini. Il numero del passo resta sempre
                                            // leggibile, e i pallini dicono dove si è.
                                            //
                                            // Nessuna condizione sulla larghezza: una
                                            // condizione sulla larghezza della finestra, in un
                                            // layout che concorre a determinarla, è un ciclo
                                            // di binding, e il compilatore Slint la rifiuta.
                                            // È lo stesso muro di DEC-384.
                                            min-width: 22px;
                                            overflow: elide;
                                            text: entry.number + ". " + entry.title;
                                            color: entry.current
                                                ? Palette.text
                                                : (entry.reached ? Palette.text-muted : Palette.text-disabled);
                                            font-size: Typography.group-label;
                                            font-weight: entry.current
                                                ? Typography.medium
                                                : Typography.regular;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }

                            VerticalLayout {
                                spacing: Spacing.xs;
                                vertical-stretch: 0;

                                Text {
                                    text: root.wizard-title;
                                    color: Palette.text;
                                    font-size: Typography.screen-title;
                                    font-weight: Typography.medium;
                                }
                                Text {
                                    text: root.wizard-prompt;
                                    color: Palette.text-muted;
                                    font-size: Typography.body-secondary;
                                    wrap: word-wrap;
                                }
                            }

                            if root.wizard-message != "": ErrorBanner {
                                message: root.wizard-message;
                            }

                            // `vertical-stretch: 1` non e' decorativo: senza, la
                            // ScrollView chiede tutta l'altezza del proprio contenuto e
                            // spinge i comandi di navigazione fuori dalla finestra,
                            // rendendo il wizard inutilizzabile.
                            HudScroll {
                                vertical-stretch: 1;

                                VerticalLayout {
                                    spacing: Spacing.sm;

                                    // ------------------------------------ passo 1
                                    if root.wizard-step == 1: Rectangle {
                                        // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                        min-height: rip-56.preferred-height;
                                        rip-56 := VerticalLayout {
                                            spacing: Spacing.sm;

                                            if root.wizard-sources.length == 0: Text {
                                                text: @tr("Nessuna fonte configurata. Le fonti si aggiungono dalla schermata Fonti, con un account attivo.");
                                                color: Palette.text-muted;
                                                font-size: Typography.body-secondary;
                                                wrap: word-wrap;
                                            }

                                            LegendaOrigini {
                                                osservato: @tr("nome e tipo");
                                            }
                                            for entry in root.wizard-sources: Rectangle {
                                                height: 52px;
                                                background: entry.selected ? Palette.panel-raised : transparent;
                                                border-radius: Spacing.radius-row;
                                                border-width: Spacing.hairline;
                                                border-color: entry.selected
                                                    ? Palette.frame
                                                    : Palette.line-divider;

                                                HorizontalLayout {
                                                    padding: Spacing.md;
                                                    spacing: Spacing.md;

                                                    // La stessa casella delle righe del Report: un punto
                                                    // non diceva che la riga si può scegliere
                                                    // (FINAL-PRODUCT-REVIEW-02).
                                                    Rectangle {
                                                        width: 16px;
                                                        horizontal-stretch: 0;
                                                        background: transparent;

                                                        Rectangle {
                                                            y: (parent.height - self.height) / 2;
                                                            width: 14px;
                                                            height: 14px;
                                                            border-radius: Spacing.xs;
                                                            border-width: Spacing.hairline;
                                                            border-color: entry.selected
                                                                ? Palette.frame
                                                                : Palette.frame-dim;
                                                            background: entry.selected
                                                                ? Palette.frame-dim
                                                                : transparent;

                                                            Rectangle {
                                                                x: (parent.width - self.width) / 2;
                                                                y: (parent.height - self.height) / 2;
                                                                width: 6px;
                                                                height: 6px;
                                                                border-radius: 1px;
                                                                background: entry.selected
                                                                    ? Palette.cyan
                                                                    : transparent;
                                                            }
                                                        }
                                                    }
                                                    Text {
                                                        text: entry.title;
                                                        color: Palette.text;
                                                        font-size: Typography.body;
                                                        vertical-alignment: center;
                                                    }
                                                    Rectangle { horizontal-stretch: 1; background: transparent; }
                                                    Text {
                                                        text: entry.kind;
                                                        color: Palette.text-muted;
                                                        font-size: Typography.group-label;
                                                        vertical-alignment: center;
                                                    }
                                                }

                                                TouchArea {
                                                    mouse-cursor: pointer;
                                                    clicked => {
                                                        source-focus.focus();
                                                        root.wizard-toggle-source(entry.source-id);
                                                    }
                                                }

                                                source-focus := FocusScope {
                                                    // Vedere la nota su `row-focus`: senza
                                                    // questo il primo clic su una fonte non
                                                    // ancora a fuoco non la seleziona.
                                                    focus-on-click: false;
                                                    key-pressed(event) => {
                                                        if (event.text == Key.Return || event.text == " ") {
                                                            root.wizard-toggle-source(entry.source-id);
                                                            return accept;
                                                        }
                                                        return reject;
                                                    }
                                                }

                                                Rectangle {
                                                    background: transparent;
                                                    border-width: source-focus.has-focus ? 2px : 0px;
                                                    border-color: Palette.focus;
                                                    border-radius: Spacing.radius-row;
                                                }

                                                accessible-role: checkbox;
                                                accessible-label: entry.title;
                                                accessible-checked: entry.selected;
                                                accessible-action-default => {
                                                    if (!StationLock.engaged) { root.wizard-toggle-source(entry.source-id); }
                                                }
                                            }
                                        }
                                    }

                                    // ------------------------------------ passo 2
                                    if root.wizard-step == 2: Rectangle {
                                        // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                        min-height: rip-57.preferred-height;
                                        rip-57 := VerticalLayout {
                                            spacing: Spacing.sm;

                                            if root.wizard-dictionaries.length == 0: Text {
                                                text: @tr("Nessun dizionario utilizzabile. Un dizionario serve una versione pubblicata per contribuire termini.");
                                                color: Palette.text-muted;
                                                font-size: Typography.body-secondary;
                                                wrap: word-wrap;
                                            }

                                            LegendaOrigini {
                                                calcolato: @tr("numero di termini");
                                                operatore: @tr("nome, ambito, descrizione ed esempi");
                                            }
                                            for entry in root.wizard-dictionaries: Rectangle {
                                                height: 104px;
                                                background: entry.selected ? Palette.panel-raised : transparent;
                                                border-radius: Spacing.radius-row;
                                                border-width: Spacing.hairline;
                                                border-color: entry.selected
                                                    ? Palette.frame
                                                    : Palette.line-divider;

                                                HorizontalLayout {
                                                    padding: Spacing.md;
                                                    spacing: Spacing.md;

                                                    // La stessa casella delle righe del Report: un punto
                                                    // non diceva che la riga si può scegliere
                                                    // (FINAL-PRODUCT-REVIEW-02).
                                                    Rectangle {
                                                        width: 16px;
                                                        horizontal-stretch: 0;
                                                        background: transparent;

                                                        Rectangle {
                                                            y: (parent.height - self.height) / 2;
                                                            width: 14px;
                                                            height: 14px;
                                                            border-radius: Spacing.xs;
                                                            border-width: Spacing.hairline;
                                                            border-color: entry.selected
                                                                ? Palette.frame
                                                                : Palette.frame-dim;
                                                            background: entry.selected
                                                                ? Palette.frame-dim
                                                                : transparent;

                                                            Rectangle {
                                                                x: (parent.width - self.width) / 2;
                                                                y: (parent.height - self.height) / 2;
                                                                width: 6px;
                                                                height: 6px;
                                                                border-radius: 1px;
                                                                background: entry.selected
                                                                    ? Palette.cyan
                                                                    : transparent;
                                                            }
                                                        }
                                                    }
                                                    VerticalLayout {
                                                        spacing: 3px;
                                                        alignment: center;
                                                        Text {
                                                            text: entry.name;
                                                            color: Palette.text;
                                                            font-size: Typography.body;
                                                        }
                                                        // Che cosa cerca: le parole di chi
                                                        // ha scritto il dizionario.
                                                        Text {
                                                            text: entry.description;
                                                            color: Palette.text-muted;
                                                            font-size: Typography.body-secondary;
                                                            wrap: word-wrap;
                                                            overflow: elide;
                                                        }
                                                        // Un assaggio delle parole vere:
                                                        // e' l'unico modo perche' chi
                                                        // sceglie sappia che cosa sta
                                                        // scegliendo.
                                                        Text {
                                                            text: entry.terms == 0 ? @tr("Nessuna parola pubblicata: questo dizionario non cerca nulla.") : @tr("Cerca: {}{}", entry.sample, (entry.sample-truncated ? "\u{2026}" : ""));
                                                            color: entry.terms == 0
                                                                ? Palette.coral
                                                                : Palette.text;
                                                            font-size: Typography.group-label;
                                                            overflow: elide;
                                                        }
                                                        Text {
                                                            text: @tr("{} \u{00b7} {} parole in tutto", entry.scope, entry.terms);
                                                            color: Palette.text-muted;
                                                            font-size: Typography.group-label;
                                                        }
                                                    }
                                                }

                                                TouchArea {
                                                    mouse-cursor: pointer;
                                                    clicked => {
                                                        dictionary-focus.focus();
                                                        root.wizard-toggle-dictionary(entry.dictionary-id);
                                                    }
                                                }

                                                dictionary-focus := FocusScope {
                                                    // Vedere la nota su `row-focus`: senza
                                                    // questo il primo clic su un dizionario
                                                    // non ancora a fuoco non lo seleziona.
                                                    focus-on-click: false;
                                                    key-pressed(event) => {
                                                        if (event.text == Key.Return || event.text == " ") {
                                                            root.wizard-toggle-dictionary(entry.dictionary-id);
                                                            return accept;
                                                        }
                                                        return reject;
                                                    }
                                                }

                                                Rectangle {
                                                    background: transparent;
                                                    border-width: dictionary-focus.has-focus ? 2px : 0px;
                                                    border-color: Palette.focus;
                                                    border-radius: Spacing.radius-row;
                                                }

                                                accessible-role: checkbox;
                                                accessible-label: entry.name;
                                                accessible-checked: entry.selected;
                                                accessible-action-default => {
                                                    if (!StationLock.engaged) { root.wizard-toggle-dictionary(entry.dictionary-id); }
                                                }
                                            }
                                        }
                                    }

                                    // ------------------------------------ passo 3
                                    if root.wizard-step == 3: Rectangle {
                                        // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                        min-height: rip-58.preferred-height;
                                        rip-58 := VerticalLayout {
                                            spacing: Spacing.sm;

                                            Text {
                                                text: @tr("Indicare anche quanto sia grave la comparsa della parola: è ciò che decide se il contenuto diventa un avviso e se fa scattare una notifica.");
                                                color: Palette.text-muted;
                                                font-size: Typography.body-secondary;
                                                wrap: word-wrap;
                                            }

                                            HorizontalLayout {
                                                spacing: Spacing.md;
                                                HudInput {
                                                    placeholder: @tr("parola o frase da cercare");
                                                    label: @tr("Parola da aggiungere a questo monitoraggio");
                                                    value <=> root.wizard-term-input;
                                                    accepted => {
                                                        root.wizard-add-term();
                                                    }
                                                }
                                                // La gravita' la dichiara chi aggiunge la parola. Prima del
                                                // 2026-07-31 entrava un livello fisso 0, cioe' "non
                                                // rilevante": il solo livello che non produce un avviso, e
                                                // quindi nemmeno una notifica. Chi seguiva l'invito del
                                                // wizard ad aggiungere una parola invece di scegliere un
                                                // dizionario otteneva un monitoraggio incapace di segnalare,
                                                // senza che nulla lo dicesse.
                                                HudSelect {
                                                    label: @tr("Gravità della parola aggiunta");
                                                    model: [@tr("Livello 1 — debole"), @tr("Livello 2 — da tenere d'occhio"), @tr("Livello 3 — forte"), @tr("Livello 4 — prioritario")];
                                                    current-index <=> root.wizard-term-level-index;
                                                }
                                                HudButton {
                                                    label: @tr("Aggiungi");
                                                    enabled: root.wizard-term-input != "";
                                                    clicked => {
                                                        root.wizard-add-term();
                                                    }
                                                }
                                            }

                                            LegendaOrigini {
                                                operatore: @tr("le parole in più e il loro livello");
                                            }
                                            for entry in root.wizard-terms: Rectangle {
                                                height: 44px;
                                                background: Palette.panel-raised;
                                                border-radius: Spacing.radius-row;

                                                HorizontalLayout {
                                                    padding: Spacing.md;
                                                    spacing: Spacing.md;

                                                    Text {
                                                        text: entry.text;
                                                        color: Palette.text;
                                                        font-size: Typography.body-secondary;
                                                        vertical-alignment: center;
                                                    }
                                                    // La gravita' sta **a sinistra**, subito
                                                    // dopo la parola e prima dello spazio
                                                    // elastico: e' il valore che l'operatore
                                                    // ha dichiarato, e non deve essere il
                                                    // primo a cedere quando la riga si
                                                    // stringe.
                                                    Text {
                                                        text: entry.level;
                                                        color: Palette.amber;
                                                        font-size: Typography.group-label;
                                                        vertical-alignment: center;
                                                    }
                                                    Rectangle { horizontal-stretch: 1; background: transparent; }
                                                    Text {
                                                        text: entry.match-mode;
                                                        color: Palette.text-muted;
                                                        font-size: Typography.group-label;
                                                        vertical-alignment: center;
                                                    }
                                                    HudButton {
                                                        label: @tr("Togli");
                                                        clicked => {
                                                            root.wizard-remove-term(entry.index);
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }

                                    // ------------------------------------ passo 4
                                    if root.wizard-step == 4: Rectangle {
                                        // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                        min-height: rip-59.preferred-height;
                                        rip-59 := VerticalLayout {
                                            spacing: Spacing.sm;

                                            Text {
                                                text: @tr("Durata scelta: {}", root.wizard-duration-label);
                                                color: Palette.text;
                                                font-size: Typography.body;
                                            }

                                            // Le sette durate decise (ADR-0144, DG-03; ADR-0150), su
                                            // due righe perche' entrino anche a finestra stretta. La
                                            // scelta resta marcata (SIM3-15). Le etichette sono quelle
                                            // di `WizardDuration::PRESETS`, e una prova lo verifica.
                                            HorizontalLayout {
                                                spacing: Spacing.sm;
                                                HudButton {
                                                    label: @tr("30 minuti");
                                                    selected: root.wizard-duration-label == self.label;
                                                    clicked => { root.wizard-set-duration(1800, false); }
                                                }
                                                HudButton {
                                                    label: @tr("1 ora");
                                                    selected: root.wizard-duration-label == self.label;
                                                    clicked => { root.wizard-set-duration(3600, false); }
                                                }
                                                HudButton {
                                                    label: @tr("2 ore");
                                                    selected: root.wizard-duration-label == self.label;
                                                    clicked => { root.wizard-set-duration(7200, false); }
                                                }
                                                HudButton {
                                                    label: @tr("4 ore");
                                                    selected: root.wizard-duration-label == self.label;
                                                    clicked => { root.wizard-set-duration(14400, false); }
                                                }
                                                Rectangle { horizontal-stretch: 1; background: transparent; }
                                            }
                                            HorizontalLayout {
                                                spacing: Spacing.sm;
                                                HudButton {
                                                    label: @tr("8 ore");
                                                    selected: root.wizard-duration-label == self.label;
                                                    clicked => { root.wizard-set-duration(28800, false); }
                                                }
                                                HudButton {
                                                    label: @tr("12 ore");
                                                    selected: root.wizard-duration-label == self.label;
                                                    clicked => { root.wizard-set-duration(43200, false); }
                                                }
                                                HudButton {
                                                    label: @tr("24 ore");
                                                    selected: root.wizard-duration-label == self.label;
                                                    clicked => { root.wizard-set-duration(86400, false); }
                                                }
                                                HudButton {
                                                    label: @tr("Fino all'arresto manuale");
                                                    selected: root.wizard-duration-label == self.label;
                                                    clicked => { root.wizard-set-duration(0, true); }
                                                }
                                                Rectangle { horizontal-stretch: 1; background: transparent; }
                                            }

                                            // UNA DURATA SCELTA A MANO (ADR-0150): ore e minuti,
                                            // da 1 minuto a 7 giorni. La fine e' esattamente
                                            // questa durata dopo l'avvio.
                                            Text {
                                                text: @tr("Oppure una durata personalizzata, da 1 minuto a 7 giorni. Il monitoraggio si conclude esattamente questa durata dopo l'avvio, anche con gli avvisi sospesi o il programma chiuso.");
                                                color: Palette.text-muted;
                                                font-size: Typography.body-secondary;
                                                wrap: word-wrap;
                                            }
                                            HorizontalLayout {
                                                spacing: Spacing.sm;
                                                // Le due parole si vedono (OBS-MON-1): l'etichetta
                                                // di HudNumber la legge soltanto il lettore di
                                                // schermo, e «2» e «0» da soli non dicevano che
                                                // fossero ore e minuti.
                                                HudNumber {
                                                    label: @tr("Ore");
                                                    minimum: 0;
                                                    maximum: 168;
                                                    value <=> root.wizard-custom-hours;
                                                }
                                                Text {
                                                    text: @tr("ore");
                                                    color: Palette.text-muted;
                                                    font-size: Typography.body;
                                                    vertical-alignment: center;
                                                    accessible-role: none;
                                                }
                                                HudNumber {
                                                    label: @tr("Minuti");
                                                    minimum: 0;
                                                    maximum: 59;
                                                    value <=> root.wizard-custom-minutes;
                                                }
                                                Text {
                                                    text: @tr("minuti");
                                                    color: Palette.text-muted;
                                                    font-size: Typography.body;
                                                    vertical-alignment: center;
                                                    accessible-role: none;
                                                }
                                                HudButton {
                                                    label: @tr("Usa questa durata");
                                                    selected: root.wizard-duration-custom;
                                                    clicked => {
                                                        root.wizard-set-custom-duration(root.wizard-custom-hours, root.wizard-custom-minutes);
                                                    }
                                                }
                                                Rectangle { horizontal-stretch: 1; background: transparent; }
                                            }
                                            if root.wizard-duration-message != "": InfoBanner {
                                                message: root.wizard-duration-message;
                                            }

                                            // QUANDO PARTE (SCHEDULE-01, ADR-0171). In Esercitazione non c'è:
                                            // un'esercitazione si fa guardando. Un solo riquadro, con l'altezza
                                            // del suo contenuto (F-03).
                                            if !root.exercise-mode: Rectangle {
                                                min-height: inizio-blocco.preferred-height;
                                                inizio-blocco := VerticalLayout {
                                                    spacing: Spacing.sm;

                                                    Text {
                                                        text: @tr("Inizio: {}", root.wizard-start-label);
                                                        color: Palette.text;
                                                        font-size: Typography.body;
                                                        wrap: word-wrap;
                                                    }
                                                    Text {
                                                        text: @tr("Oppure un inizio più tardi, fra un minuto e sette giorni, con la data e l'ora di questo computer. Parte all'ora indicata se il programma è aperto e l'account collegato; altrimenti lo dice, e non parte più da sé.");
                                                        color: Palette.text-muted;
                                                        font-size: Typography.body-secondary;
                                                        wrap: word-wrap;
                                                    }
                                                    HorizontalLayout {
                                                        spacing: Spacing.sm;
                                                        HudButton {
                                                            label: @tr("Adesso");
                                                            selected: !root.wizard-start-scheduled;
                                                            clicked => { root.wizard-set-start-now(); }
                                                        }
                                                        HudInput {
                                                            label: @tr("Data");
                                                            placeholder: "26/10/2026";
                                                            value <=> root.wizard-start-date;
                                                        }
                                                        HudInput {
                                                            label: @tr("Ora");
                                                            placeholder: "09:30";
                                                            value <=> root.wizard-start-time;
                                                        }
                                                        HudButton {
                                                            label: @tr("Parte più tardi");
                                                            selected: root.wizard-start-scheduled;
                                                            clicked => {
                                                                root.wizard-set-start-at(root.wizard-start-date, root.wizard-start-time);
                                                            }
                                                        }
                                                        Rectangle { horizontal-stretch: 1; background: transparent; }
                                                    }
                                                    if root.wizard-start-message != "": InfoBanner {
                                                        message: root.wizard-start-message;
                                                    }
                                                }
                                            }
                                        }
                                    }

                                    // ------------------------------------ passo 5
                                    if root.wizard-step == 5: Rectangle {
                                        // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                        min-height: rip-60.preferred-height;
                                        rip-60 := VerticalLayout {
                                            spacing: Spacing.md;

                                            // PRIMA CHE COSA SI MONITORERA', POI I NUMERI
                                            // (UX-EXCELLENCE-02, SIM3-14).
                                            //
                                            // Il riepilogo apriva con tre riquadri grandi
                                            // - «118 termini distinti», «0 presenti in più
                                            // dizionari» e un'impronta esadecimale - e la
                                            // fonte scelta non era nominata. Chi rilegge
                                            // prima di avviare cerca le sue scelte: le
                                            // fonti per nome, la durata, i dizionari. I
                                            // numeri e l'impronta servono a confrontare
                                            // due configurazioni e all'audit: restano,
                                            // in fondo e in piccolo.
                                            Rectangle {
                                                vertical-stretch: 0;
                                                background: Palette.panel-raised;
                                                border-radius: Spacing.radius-row;

                                                VerticalLayout {
                                                    padding: Spacing.md;
                                                    spacing: Spacing.xs;

                                                    Text {
                                                        text: @tr("Che cosa verrà monitorato");
                                                        color: Palette.text;
                                                        font-size: Typography.body;
                                                        font-weight: Typography.medium;
                                                    }
                                                    Text {
                                                        text: root.wizard-chosen-sources == 1 ? @tr("Una fonte:") : @tr("{} fonti:", root.wizard-chosen-sources);
                                                        color: Palette.text-muted;
                                                        font-size: Typography.body-secondary;
                                                    }
                                                    Text {
                                                        text: root.wizard-chosen-source-names;
                                                        color: Palette.text;
                                                        font-size: Typography.body-secondary;
                                                        wrap: word-wrap;
                                                    }
                                                    Text {
                                                        text: @tr("Durata: {}", root.wizard-duration-label);
                                                        color: Palette.text;
                                                        font-size: Typography.body-secondary;
                                                        wrap: word-wrap;
                                                    }
                                                    Text {
                                                        text: (root.wizard-chosen-dictionary-count == 1 ? @tr("Un dizionario") : @tr("{} dizionari", root.wizard-chosen-dictionary-count)) + (root.wizard-terms.length == 0 ? @tr(", nessuna parola aggiunta a mano.") : root.wizard-terms.length == 1 ? @tr(" e una parola aggiunta a mano.") : @tr(" e {} parole aggiunte a mano.", root.wizard-terms.length));
                                                        color: Palette.text;
                                                        font-size: Typography.body-secondary;
                                                        wrap: word-wrap;
                                                    }
                                                    Text {
                                                        text: @tr("Non parte da solo: si avvia al passo successivo, con «Avvia monitoraggio».");
                                                        color: Palette.text-muted;
                                                        font-size: Typography.group-label;
                                                        wrap: word-wrap;
                                                    }
                                                }
                                            }

                                            // I dizionari scelti, CON LA VERSIONE.
                                            //
                                            // Un nome senza numero dice quale
                                            // dizionario, non quale contenuto. Chi
                                            // rilegge un atto mesi dopo ha bisogno
                                            // del numero, e l'audit lo registra:
                                            // qui si vede prima di avviare, non
                                            // dopo.
                                            if root.wizard-chosen-dictionaries.length > 0: Rectangle {
                                                // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                                min-height: rip-61.preferred-height;
                                                rip-61 := VerticalLayout {
                                                    spacing: Spacing.xs;

                                                    Text {
                                                        text: @tr("Dizionari e versioni con cui il monitoraggio verrà condotto:");
                                                        color: Palette.text;
                                                        font-size: Typography.group-label;
                                                        wrap: word-wrap;
                                                    }

                                                    LegendaOrigini {
                                                        calcolato: @tr("numero di termini");
                                                        operatore: @tr("dizionario e ambito");
                                                    }
                                                    for entry in root.wizard-chosen-dictionaries: Rectangle {
                                                        // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                                        min-height: rip-62.preferred-height;
                                                        rip-62 := HorizontalLayout {
                                                            spacing: Spacing.sm;

                                                            Text {
                                                                text: entry.label;
                                                                color: Palette.text;
                                                                font-size: Typography.body-secondary;
                                                                wrap: word-wrap;
                                                                horizontal-stretch: 1;
                                                            }
                                                            Text {
                                                                text: entry.scope;
                                                                color: Palette.text-muted;
                                                                font-size: Typography.group-label;
                                                                horizontal-stretch: 0;
                                                                // Non si taglia (F-24): stringe il nome, che va a capo.
                                                                min-width: self.preferred-width;
                                                            }
                                                            Text {
                                                                text: @tr("{} termini", entry.terms);
                                                                color: Palette.text-muted;
                                                                font-size: Typography.group-label;
                                                                horizontal-stretch: 0;
                                                                min-width: self.preferred-width;
                                                            }
                                                            // Il contesto riduttivo si
                                                            // dichiara solo quando c'e':
                                                            // una colonna «0» accanto a
                                                            // ogni riga insegnerebbe a non
                                                            // guardarla.
                                                            if entry.reducing-terms > 0: Text {
                                                                text: @tr("{} riduttivi", entry.reducing-terms);
                                                                color: Palette.cyan;
                                                                font-size: Typography.group-label;
                                                                horizontal-stretch: 0;
                                                                min-width: self.preferred-width;
                                                            }
                                                        }
                                                    }
                                                }
                                            }

                                            // Il conteggio da solo non basta. Fino al
                                            // 2026-08-04 il riepilogo diceva "parole
                                            // aggiunte: 4" e nient'altro: ne' quali, ne' con
                                            // che gravita'. Ma il riepilogo e' l'ultima
                                            // occasione di accorgersi di un clic sbagliato
                                            // **prima** di avviare un monitoraggio che poi
                                            // gira per ore, e una parola entrata a livello
                                            // sbagliato non si vede piu' fino a quando non
                                            // segnala troppo o non segnala affatto.
                                            // Rilevato in campo dall'operatore.
                                            if root.wizard-terms.length > 0: Rectangle {
                                                // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                                min-height: rip-63.preferred-height;
                                                rip-63 := VerticalLayout {
                                                    spacing: Spacing.xs;

                                                    Text {
                                                        text: @tr("Parole e frasi aggiunte a mano, con la gravità dichiarata:");
                                                        color: Palette.text;
                                                        font-size: Typography.group-label;
                                                        wrap: word-wrap;
                                                    }

                                                    LegendaOrigini {
                                                        operatore: @tr("le parole in più e il loro livello");
                                                    }
                                                    for entry in root.wizard-terms: Rectangle {
                                                        // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                                        min-height: rip-64.preferred-height;
                                                        rip-64 := HorizontalLayout {
                                                            spacing: Spacing.sm;

                                                            Text {
                                                                text: entry.text;
                                                                color: Palette.text;
                                                                font-size: Typography.body-secondary;
                                                                // Una parola lunga non deve spingere
                                                                // la gravita' fuori dalla riga.
                                                                wrap: word-wrap;
                                                                horizontal-stretch: 1;
                                                            }
                                                            Text {
                                                                text: entry.level;
                                                                color: Palette.amber;
                                                                font-size: Typography.group-label;
                                                                horizontal-stretch: 0;
                                                            }
                                                            Text {
                                                                text: entry.match-mode;
                                                                color: Palette.text-muted;
                                                                font-size: Typography.group-label;
                                                                horizontal-stretch: 0;
                                                            }
                                                        }
                                                    }
                                                }
                                            }

                                            // AVVISI — non sono motivi di blocco.
                                            //
                                            // Stanno qui, dentro il riepilogo, e
                                            // NON accanto al pulsante «Avanti»,
                                            // dove vive il motivo di blocco. Sono
                                            // due posti diversi perche' sono due
                                            // cose diverse: un blocco spegne
                                            // «Avanti», un avviso lo lascia acceso.
                                            //
                                            // Il criterio 39 di M3C chiedeva
                                            // esattamente questa distinzione, e
                                            // finche' non c'e' stata un avviso non
                                            // aveva un posto in cui comparire.
                                            if root.wizard-notices.length > 0: Rectangle {
                                                // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                                min-height: rip-65.preferred-height;
                                                rip-65 := VerticalLayout {
                                                    spacing: Spacing.xs;

                                                    Text {
                                                        text: @tr("Da sapere prima di avviare — non impedisce di proseguire:");
                                                        color: Palette.amber;
                                                        font-size: Typography.group-label;
                                                        wrap: word-wrap;
                                                    }

                                                    LegendaOrigini {
                                                        calcolato: @tr("avvisi del programma");
                                                    }
                                                    for entry in root.wizard-notices: Rectangle {
                                                        background: Palette.panel-raised;
                                                        border-radius: Spacing.radius-row;
                                                        vertical-stretch: 0;

                                                        // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                                        min-height: rip-66.preferred-height;
                                                        rip-66 := VerticalLayout {
                                                            padding: Spacing.sm;
                                                            spacing: 2px;

                                                            Text {
                                                                text: entry.text;
                                                                color: Palette.text;
                                                                font-size: Typography.body-secondary;
                                                                wrap: word-wrap;
                                                            }
                                                            // Il rimedio compare solo
                                                            // quando esiste: offrirne
                                                            // uno per una scelta
                                                            // legittima suggerirebbe
                                                            // che sia da correggere.
                                                            if entry.remedy != "": Text {
                                                                text: entry.remedy;
                                                                color: Palette.text-muted;
                                                                font-size: Typography.group-label;
                                                                wrap: word-wrap;
                                                            }
                                                        }
                                                    }
                                                }
                                            }

                                            // I NUMERI E L'IMPRONTA, IN FONDO (SIM3-14):
                                            // servono a confrontare due configurazioni e
                                            // all'audit, non a decidere se avviare.
                                            if root.wizard-has-preview: Text {
                                                text: @tr("Per il confronto fra configurazioni: {} termini distinti, {} presenti in più dizionari, impronta {}. Non serve leggerli per avviare.", root.wizard-resolved-terms, root.wizard-shared-terms, root.wizard-digest);
                                                color: Palette.text-muted;
                                                font-size: Typography.group-label;
                                                wrap: word-wrap;
                                            }

                                            AvvertenzaDiSicurezza {
                                                codice: "SIC-05";
                                                testo: @tr("L'impronta dice che due configurazioni sono la stessa. Non è una firma: non prova chi l'abbia composta.");
                                                dettaglio: @tr("Impronta SHA-256 della configurazione scritta in forma canonica. Una firma richiederebbe una chiave e un'identità: l'impronta non ha né l'una né l'altra.");
                                                tone: Tone.info;
                                                compatta: true;
                                            }
                                        }
                                    }

                                    // ------------------------------------ passo 6
                                    if root.wizard-step == 6: Rectangle {
                                        // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                        min-height: rip-67.preferred-height;
                                        rip-67 := VerticalLayout {
                                            spacing: Spacing.md;

                                            Rectangle {
                                                background: Palette.info-surface;
                                                border-radius: Spacing.radius-row;
                                                vertical-stretch: 0;
                                                VerticalLayout {
                                                    padding: Spacing.md;
                                                    Text {
                                                        text: root.wizard-blocking-reason;
                                                        color: Palette.text;
                                                        font-size: Typography.body-secondary;
                                                        wrap: word-wrap;
                                                    }
                                                }
                                            }

                                            HorizontalLayout {
                                                vertical-stretch: 0;
                                                Rectangle { horizontal-stretch: 1; background: transparent; }
                                                HudButton {
                                                    label: root.wizard-start-scheduled ? @tr("Programma monitoraggio") : @tr("Avvia monitoraggio");
                                                    weight: Weight.primary;
                                                    clicked => {
                                                        root.start-monitoring();
                                                    }
                                                }
                                            }
                                        }
                                    }

                                    Rectangle { vertical-stretch: 1; background: transparent; }
                                }
                            }

                            // Motivo per cui non si prosegue, quando non si prosegue.
                            if root.wizard-blocking-reason != "" && root.wizard-step != 6: Text {
                                text: root.wizard-blocking-reason;
                                color: Palette.text-muted;
                                font-size: Typography.body-secondary;
                                wrap: word-wrap;
                            }

                            HorizontalLayout {
                                spacing: Spacing.md;
                                vertical-stretch: 0;

                                HudButton {
                                    label: @tr("Indietro");
                                    enabled: root.wizard-can-go-back;
                                    clicked => {
                                        root.wizard-back();
                                    }
                                }
                                Rectangle { horizontal-stretch: 1; background: transparent; }
                                HudButton {
                                    label: @tr("Avanti");
                                    weight: Weight.primary;
                                    enabled: root.wizard-can-advance;
                                    clicked => {
                                        root.wizard-advance();
                                    }
                                }
                            }
                        }
                    }

                    // ------------------------------------------------- Postazione
                    if root.current-page == 5: Rectangle {
                        // Comparsa graduale della pagina: vedere la pagina 0 per il
                        // perche' la dissolvenza sia solo in entrata.
                        property <bool> entered: false;
                        opacity: 0.0;
                        init => {
                            self.entered = true;
                        }
                        animate opacity {
                            duration: Motion.transition-effective;
                            easing: cubic-bezier(0.16, 1, 0.3, 1);
                        }
        states [
            shown when self.entered: {
                opacity: 1.0;
            }
        ]
                        background: Palette.panel;
                        border-radius: Spacing.radius-panel;

                        HudScroll {
                            VerticalLayout {
                                padding: Spacing.xl;
                                spacing: Spacing.lg;
                                alignment: start;

                                Text {
                                    text: @tr("Postazione");
                                    color: Palette.text;
                                    font-size: Typography.screen-title;
                                    font-weight: Typography.medium;
                                }

                                Rectangle {
                                    height: 96px;
                                    vertical-stretch: 0;
                                    background: Palette.panel-raised;
                                    border-radius: Spacing.radius-row;
                                    border-width: Spacing.hairline;
                                    border-color: Palette.line-divider;

                                    VerticalLayout {
                                        padding: Spacing.md;
                                        spacing: Spacing.xs;

                                        Text {
                                            text: root.operating-mode-label;
                                            color: Palette.text;
                                            font-size: Typography.section-title;
                                            font-weight: Typography.medium;
                                        }
                                        Text {
                                            text: root.operating-mode-description;
                                            color: Palette.text-muted;
                                            font-size: Typography.body-secondary;
                                            wrap: word-wrap;
                                        }
                                    }
                                }

                                // Il limite va letto dove si compie l'azione, non solo
                                // nella documentazione: chi passa in modalita'
                                // operatore deve sapere che cosa sta e non sta
                                // ottenendo.
                                Rectangle {
                                    height: 76px;
                                    vertical-stretch: 0;
                                    background: Palette.info-surface;
                                    border-radius: Spacing.radius-row;

                                    VerticalLayout {
                                        padding: Spacing.md;
                                        Text {
                                            text: @tr("La modalità operatore protegge dall'errore, non da chi controlla questo computer. Chi vi ha accesso può riprendersi i privilegi cancellando la configurazione. Ciò che resta è che il gesto sia necessario e visibile, e che il registro delle operazioni ne conservi la traccia.");
                                            color: Palette.text;
                                            font-size: Typography.body-secondary;
                                            wrap: word-wrap;
                                        }
                                    }
                                }

                                if root.station-message != "": Text {
                                    text: root.station-message;
                                    color: Palette.text-muted;
                                    font-size: Typography.body-secondary;
                                    wrap: word-wrap;
                                }

                                Text {
                                    text: root.administrator-mode ? @tr("Parola di sblocco da fissare, necessaria per tornare amministratore:") : @tr("Parola di sblocco per tornare in modalità amministratore:");
                                    color: Palette.text-muted;
                                    font-size: Typography.body-secondary;
                                    wrap: word-wrap;
                                }

                                HorizontalLayout {
                                    spacing: Spacing.md;
                                    vertical-stretch: 0;

                                    HudInput {
                                        placeholder: @tr("parola di sblocco");
                                        masked: true;
                                        label: @tr("Parola di sblocco della postazione");
                                        value <=> root.unlock-input;
                                    }

                                    HudButton {
                                        label: root.administrator-mode ? @tr("Passa a modalità operatore") : @tr("Torna amministratore");
                                        enabled: root.unlock-input != "";
                                        clicked => {
                                            if (root.administrator-mode) {
                                                root.switch-to-operator();
                                            } else {
                                                root.switch-to-administrator();
                                            }
                                        }
                                    }
                                }

                                Rectangle { vertical-stretch: 1; background: transparent; }
                            }
                        }
                    }

                    // ---------------------------------------------------- Alert
                    //
                    // Gli avvisi sono lo storico con la soglia sul livello: stessa
                    // componente, stesso archivio, elenco gia' filtrato dal servizio.
                    if root.current-page == 7: ContentScreen {
                        // Comparsa graduale della pagina: vedere la pagina 0 per il
                        // perche' la dissolvenza sia solo in entrata.
                        property <bool> entered: false;
                        opacity: 0.0;
                        init => {
                            self.entered = true;
                        }
                        animate opacity {
                            duration: Motion.transition-effective;
                            easing: cubic-bezier(0.16, 1, 0.3, 1);
                        }
        states [
            shown when self.entered: {
                opacity: 1.0;
            }
        ]
                        title: @tr("Avvisi");
                        description: @tr("I contenuti che l'analisi ha portato all'attenzione, dal livello 1 in su. Ogni riga porta la motivazione scritta al momento dell'analisi: il motore propone, la decisione resta di chi legge.{}", root.cyber-watch-summary);
                        entries: root.alert-entries;
                        selected-row: root.alert-selected-row;
                        reveal-request: root.history-reveal-request;
                        // Qui una riga e' un avviso: la domanda e' perche' e' scattato.
                        row-kind: Spiegabile.avviso;
                        message: root.history-message;
                        empty-title: root.history-total > 0 ? @tr("Nessun avviso da mostrare") : @tr("Nessun contenuto acquisito");
                        // Con un monitoraggio esistente la frase «nessun monitoraggio» era
                        // falsa (F-14): la prima voce della tendina è «Tutte le sessioni»,
                        // le altre sono monitoraggi veri.
                        empty-detail: root.history-total > 0 ? @tr("Nessun contenuto ha superato il livello 0, oppure la ricerca non trova corrispondenze. Lo storico li contiene tutti.") : root.history-sessions.length > 1 ? @tr("Il monitoraggio scelto non ha ancora acquisito contenuti. Gli avvisi compaiono qui man mano che arrivano, dal livello 1 in su.") : @tr("Gli avvisi compaiono quando un monitoraggio acquisisce contenuti. Nessun monitoraggio è ancora stato condotto su questa postazione.");
                        total: root.history-total;
                        // Che cosa conta, detto accanto al numero (SIM3-08): Avvisi, Coda e
                        // Storico mostravano tre cifre diverse per «da esaminare», ed erano
                        // tre popolazioni diverse. Le cifre restano vere; le parole dicono quali.
                        focus-caption: @tr("avvisi da decidere\n(livello 1 e oltre)");
                        focus-value: root.alert-pending;
                        selected: root.selected-content;
                        selected-summary: root.selected-summary;
                        selected-state: root.selected-state;
                        selected-has-history: root.selected-has-history;
                        selected-revised: root.selected-revised;
                        selected-url: root.selected-url;
                        versions: root.history-versions;
                        story: root.history-story;
                        story-subject: root.history-story-subject;
                        story-open: root.history-story-open;
                        story-deleted: root.history-story-deleted;
                        open-story(content-id) => {
                            root.history-open-story(content-id);
                        }
                        close-story() => {
                            root.history-close-story();
                        }
                        why-open: root.history-why-open;
                        why-subject: root.history-why-subject;
                        why-origin: root.history-why-origin;
                        why-version-warning: root.history-why-version-warning;
                        why-terms: root.history-why-terms;
                        why-engine: root.history-why-engine;
                        replay-open: root.history-replay-open;
                        replay-historical: root.history-replay-historical;
                        replay-hypothetical: root.history-replay-hypothetical;
                        replay-attribution: root.history-replay-attribution;
                        replay-differs: root.history-replay-differs;
                        open-replay(content-id) => {
                            root.history-open-replay(content-id);
                        }
                        close-replay => {
                            root.history-close-replay();
                        }
                        resembling-open: root.history-resembling-open;
                        resembling-summary: root.history-resembling-summary;
                        resembling-rows: root.history-resembling-rows;
                        open-resembling(content-id) => {
                            root.history-open-resembling(content-id);
                        }
                        close-resembling => {
                            root.history-close-resembling();
                        }
                        // «Perché vedo questo?» chiede alla finestra, che
                        // possiede il pannello unico (PR-02). La chiave di una
                        // somiglianza e' la coppia di contenuti: quello aperto e
                        // quello che gli somiglia.
                        explain(genere, contenuto, fatti) => {
                            root.history-explain(genere, contenuto, fatti);
                        }
                        explain-subject(genere, chiave, fatti) => {
                            root.explain-this(genere, chiave, fatti);
                        }
                        collect-in-workspace(content-id) => {
                            root.history-collect-in-workspace(content-id);
                        }
                        marked: root.history-content-marked;
                        toggle-bookmark(content-id) => {
                            root.history-toggle-bookmark(content-id);
                        }
                        notes: root.history-content-notes;
                        note-draft <=> root.history-note-draft;
                        note-message: root.history-note-message;
                        write-note(testo) => {
                            root.history-write-note(testo);
                        }
                        withdraw-note(id) => {
                            root.withdraw-note(id);
                        }
                        open-conversation(content-id) => {
                            root.conversation-open-requested(content-id, "Avvisi");
                        }
                        author-identifier: root.selected-author-identifier;
                        author-subjects: root.selected-author-subjects;
                        open-subject(id) => {
                            root.author-open-subject(id);
                        }
                        link-subject(identificativo) => {
                            root.author-link-subject(identificativo);
                        }
                        attachment-sentence: root.history-attachment-sentence;
                        attachment-open: root.history-attachment-open;
                        attachment-caveat: root.history-attachment-caveat;
                        attachment-reason <=> root.history-attachment-reason;
                        attachment-message: root.history-attachment-message;
                        attachment-entries: root.history-attachment-entries;
                        open-attachment(content-id) => {
                            root.history-attachment-open-for(content-id);
                        }
                        attachment-ask() => {
                            root.history-attachment-ask();
                        }
                        attachment-close() => {
                            root.history-attachment-close();
                        }
                        link-request-sentence: root.history-link-sentence;
                        link-request-url: root.history-link-url;
                        request-link(content-id) => {
                            root.history-request-link(content-id);
                        }
                        why-scoring: root.history-why-scoring;
                        why-scoring-trustworthy: root.history-why-scoring-trustworthy;
                        why-alert: root.history-why-alert;
                        why-decisions: root.history-why-decisions;
                        open-why(content-id) => {
                            root.history-open-why(content-id);
                        }
                        open-graph(content-id) => {
                            root.graph-open-content(content-id);
                        }
                        close-why() => {
                            root.history-close-why();
                        }
                        filter <=> root.history-filter;
                        only-pending <=> root.history-only-pending;
                        save-search-name <=> root.history-save-search-name;
                        save-search-message: root.saved-search-message;
                        save-search(nome) => {
                            root.history-save-search(nome);
                        }
                        search-drift: root.history-search-drift;
                        search-comparable: root.history-search-comparable;
                        note <=> root.review-note;
                        sessions: root.history-sessions;
                        can-export: root.can-export;
                        session-index <=> root.history-session-index;
                        include-author-identifiers <=> root.include-author-identifiers;
                        export-destination: root.export-destination;
                        filter-changed => {
                            root.filter-history();
                        }
                        session-chosen(index) => {
                            root.choose-session(index);
                        }
                        export-session => {
                            root.export-session();
                        }
                        choose-export-destination => {
                            root.choose-export-destination();
                        }
                        verify-exports => {
                            root.verify-exports();
                        }
                        select(content-id) => {
                            root.select-content(content-id);
                        }
                        decide(state) => {
                            root.record-review(state);
                        }
                        open-url(u) => {
                            root.open-url(u);
                        }
                    }

                    // -------------------------------------------------- Storico
                    if root.current-page == 8: ContentScreen {
                        // Comparsa graduale della pagina: vedere la pagina 0 per il
                        // perche' la dissolvenza sia solo in entrata.
                        property <bool> entered: false;
                        opacity: 0.0;
                        init => {
                            self.entered = true;
                        }
                        animate opacity {
                            duration: Motion.transition-effective;
                            easing: cubic-bezier(0.16, 1, 0.3, 1);
                        }
        states [
            shown when self.entered: {
                opacity: 1.0;
            }
        ]
                        title: @tr("Storico");
                        description: @tr("Ogni contenuto acquisito e analizzato, compresi quelli risultati non rilevanti. Mostrarne solo una parte direbbe che il monitoraggio ha osservato solo quella.");
                        entries: root.history-entries;
                        selected-row: root.history-selected-row;
                        reveal-request: root.history-reveal-request;
                        message: root.history-message;
                        empty-title: root.history-total > 0 ? @tr("Nessun contenuto corrisponde alla ricerca") : @tr("Nessun contenuto acquisito");
                        empty-detail: root.history-total > 0 ? @tr("Cambiare il testo cercato, oppure togliere il filtro \"Solo da esaminare\".") : root.history-sessions.length > 1 ? @tr("Il monitoraggio scelto non ha ancora acquisito contenuti. Lo storico si popola man mano che arrivano.") : @tr("Lo storico si popola durante un monitoraggio. Nessun monitoraggio è ancora stato condotto su questa postazione.");
                        total: root.history-total;
                        focus-caption: @tr("contenuti da decidere\n(anche di livello 0)");
                        focus-value: root.history-pending;
                        selected: root.selected-content;
                        selected-summary: root.selected-summary;
                        selected-state: root.selected-state;
                        selected-has-history: root.selected-has-history;
                        selected-revised: root.selected-revised;
                        selected-url: root.selected-url;
                        versions: root.history-versions;
                        story: root.history-story;
                        story-subject: root.history-story-subject;
                        story-open: root.history-story-open;
                        story-deleted: root.history-story-deleted;
                        open-story(content-id) => {
                            root.history-open-story(content-id);
                        }
                        close-story() => {
                            root.history-close-story();
                        }
                        why-open: root.history-why-open;
                        why-subject: root.history-why-subject;
                        why-origin: root.history-why-origin;
                        why-version-warning: root.history-why-version-warning;
                        why-terms: root.history-why-terms;
                        why-engine: root.history-why-engine;
                        replay-open: root.history-replay-open;
                        replay-historical: root.history-replay-historical;
                        replay-hypothetical: root.history-replay-hypothetical;
                        replay-attribution: root.history-replay-attribution;
                        replay-differs: root.history-replay-differs;
                        open-replay(content-id) => {
                            root.history-open-replay(content-id);
                        }
                        close-replay => {
                            root.history-close-replay();
                        }
                        resembling-open: root.history-resembling-open;
                        resembling-summary: root.history-resembling-summary;
                        resembling-rows: root.history-resembling-rows;
                        open-resembling(content-id) => {
                            root.history-open-resembling(content-id);
                        }
                        close-resembling => {
                            root.history-close-resembling();
                        }
                        // «Perché vedo questo?» chiede alla finestra, che
                        // possiede il pannello unico (PR-02). La chiave di una
                        // somiglianza e' la coppia di contenuti: quello aperto e
                        // quello che gli somiglia.
                        explain(genere, contenuto, fatti) => {
                            root.history-explain(genere, contenuto, fatti);
                        }
                        explain-subject(genere, chiave, fatti) => {
                            root.explain-this(genere, chiave, fatti);
                        }
                        collect-in-workspace(content-id) => {
                            root.history-collect-in-workspace(content-id);
                        }
                        marked: root.history-content-marked;
                        toggle-bookmark(content-id) => {
                            root.history-toggle-bookmark(content-id);
                        }
                        notes: root.history-content-notes;
                        note-draft <=> root.history-note-draft;
                        note-message: root.history-note-message;
                        write-note(testo) => {
                            root.history-write-note(testo);
                        }
                        withdraw-note(id) => {
                            root.withdraw-note(id);
                        }
                        open-conversation(content-id) => {
                            root.conversation-open-requested(content-id, "Storico");
                        }
                        author-identifier: root.selected-author-identifier;
                        author-subjects: root.selected-author-subjects;
                        open-subject(id) => {
                            root.author-open-subject(id);
                        }
                        link-subject(identificativo) => {
                            root.author-link-subject(identificativo);
                        }
                        attachment-sentence: root.history-attachment-sentence;
                        attachment-open: root.history-attachment-open;
                        attachment-caveat: root.history-attachment-caveat;
                        attachment-reason <=> root.history-attachment-reason;
                        attachment-message: root.history-attachment-message;
                        attachment-entries: root.history-attachment-entries;
                        open-attachment(content-id) => {
                            root.history-attachment-open-for(content-id);
                        }
                        attachment-ask() => {
                            root.history-attachment-ask();
                        }
                        attachment-close() => {
                            root.history-attachment-close();
                        }
                        link-request-sentence: root.history-link-sentence;
                        link-request-url: root.history-link-url;
                        request-link(content-id) => {
                            root.history-request-link(content-id);
                        }
                        why-scoring: root.history-why-scoring;
                        why-scoring-trustworthy: root.history-why-scoring-trustworthy;
                        why-alert: root.history-why-alert;
                        why-decisions: root.history-why-decisions;
                        open-why(content-id) => {
                            root.history-open-why(content-id);
                        }
                        open-graph(content-id) => {
                            root.graph-open-content(content-id);
                        }
                        close-why() => {
                            root.history-close-why();
                        }
                        filter <=> root.history-filter;
                        only-pending <=> root.history-only-pending;
                        save-search-name <=> root.history-save-search-name;
                        save-search(nome) => {
                            root.history-save-search(nome);
                        }
                        search-drift: root.history-search-drift;
                        search-comparable: root.history-search-comparable;
                        note <=> root.review-note;
                        sessions: root.history-sessions;
                        can-export: root.can-export;
                        session-index <=> root.history-session-index;
                        include-author-identifiers <=> root.include-author-identifiers;
                        export-destination: root.export-destination;
                        filter-changed => {
                            root.filter-history();
                        }
                        session-chosen(index) => {
                            root.choose-session(index);
                        }
                        export-session => {
                            root.export-session();
                        }
                        choose-export-destination => {
                            root.choose-export-destination();
                        }
                        verify-exports => {
                            root.verify-exports();
                        }
                        select(content-id) => {
                            root.select-content(content-id);
                        }
                        decide(state) => {
                            root.record-review(state);
                        }
                        open-url(u) => {
                            root.open-url(u);
                        }
                    }

                    // -------------------------------------------- Monitoraggio
                    if root.current-page == 9: Rectangle {
                        // Comparsa graduale della pagina: vedere la pagina 0 per il
                        // perche' la dissolvenza sia solo in entrata.
                        property <bool> entered: false;
                        opacity: 0.0;
                        init => {
                            self.entered = true;
                        }
                        animate opacity {
                            duration: Motion.transition-effective;
                            easing: cubic-bezier(0.16, 1, 0.3, 1);
                        }
        states [
            shown when self.entered: {
                opacity: 1.0;
            }
        ]
                        background: Palette.panel;
                        border-radius: Spacing.radius-panel;

                        // IL MONITORAGGIO E' L'ULTIMA PAGINA CHE NON SCORREVA.
                        //
                        // Il 2026-08-19 l'operatore ha riferito che con la
                        // finestra ridotta un pulsante resta fuori. Un comando
                        // che si sa esistere e non si raggiunge equivale a un
                        // comando che non c'e', e l'unico rimedio era
                        // ingrandire la finestra: cioe' chiedere a chi usa il
                        // prodotto di adattarsi a un difetto.
                        //
                        // Non era stata avvolta subito perche' conteneva uno
                        // spaziatore elastico, che qui sotto e' diventato uno
                        // stacco fisso: era quello il lavoro da fare, e non si
                        // poteva farlo senza guardare la schermata.
                        HudScroll {
                            vertical-stretch: 1;

                            VerticalLayout {
                                padding: Spacing.xl;
                                spacing: Spacing.lg;

                                HorizontalLayout {
                                    spacing: Spacing.md;
                                    vertical-stretch: 0;

                                    VerticalLayout {
                                        spacing: Spacing.xs;
                                        Text {
                                            text: @tr("Monitoraggio");
                                            color: Palette.text;
                                            font-size: Typography.screen-title;
                                            font-weight: Typography.medium;
                                        }
                                        Text {
                                            text: @tr("Lo stato di un monitoraggio e i suoi comandi. Sospendere gli avvisi non ferma l'acquisizione: tacita le notifiche. Arrestare conclude la sessione in modo ordinato.");
                                            color: Palette.text-muted;
                                            font-size: Typography.body-secondary;
                                            wrap: word-wrap;
                                        }
                                    }

                                    // Indicatore di attivita'. E' una METAFORA del
                                    // monitoraggio, non uno strumento di localizzazione: il
                                    // reticolo e' un piano astratto, non un territorio, e
                                    // nessun punto rappresenta un luogo. Il prodotto non fa
                                    // geolocalizzazione, e nessun elemento dell'interfaccia
                                    // deve suggerire il contrario (DEC-126).
                                    //
                                    // `running` e' legato a uno stato REALE - il monitoraggio
                                    // in corso senza anomalie - e non a un timer che gira per
                                    // decorazione: un indicatore che gira sempre smette di
                                    // dire qualcosa.
                                    //
                                    // FINO AL 2026-08-20 QUESTA RIGA CONTRADDICEVA IL
                                    // COMMENTO QUI SOPRA: controllava le anomalie e
                                    // ignorava se il monitoraggio fosse in corso. Non si
                                    // era mai visto perche' l'animazione non partiva
                                    // affatto, per un difetto diverso; sbloccata quella,
                                    // questo radar avrebbe girato a sessione ferma -
                                    // cioe' sarebbe diventato esattamente la decorazione
                                    // che il commento vieta.
                                    //
                                    // Un commento che descrive un'intenzione non la
                                    // impone. Questa e' la riga che la impone.
                                    //
                                    // Quando la spazzata si ferma per un'anomalia, il
                                    // motivo non resta affidato al solo movimento: la
                                    // didascalia lo dice a parole, e il riquadro dello
                                    // stato di salute qui sotto cambia colore.
                                    //
                                    // LA DIDASCALIA DICE LA SPAZZATA, NON LA
                                    // SALUTE (FINAL-FPR-ALL-16, FPR-15).
                                    //
                                    // Diceva «Attività del monitoraggio:
                                    // Operativo», cioè la stessa parola che il
                                    // riquadro focale di questa schermata scrive
                                    // in grande poche righe sotto: due
                                    // indicatori dello stesso stato nella stessa
                                    // schermata. Il radar resta — è legato a uno
                                    // stato vero e non gira per decorazione — e
                                    // dice ciò che mostra: se la spazzata gira.
                                    //
                                    // La salute torna nella didascalia **solo**
                                    // quando è lei a fermare la spazzata: è il
                                    // caso in cui il motivo non deve restare
                                    // affidato al solo movimento, ed è l'unico
                                    // in cui la ripetizione serve.
                                    //
                                    // È anche la didascalia che il radar della
                                    // Dashboard ha sempre avuto: «IN CORSO» o
                                    // «FERMO», cioè l'attività.
                                    if root.monitoring-present: RadarPanel {
                                        // IL MONITORAGGIO MOSTRATO, NON UNO QUALUNQUE
                                        // (UX-EXCELLENCE-02, SIM3-15): girava se un
                                        // monitoraggio qualsiasi acquisiva, anche mostrando
                                        // uno arrestato. La veglia della postazione segue
                                        // ancora tutti (`monitoring-active`); il radar di
                                        // questa schermata segue quello scelto.
                                        running: (root.monitoring-state-code == 1
                                                || root.monitoring-state-code == 2)
                                            && !root.monitoring-health-attention
                                            && root.station-acquiring;
                                        caption: root.monitoring-shown-acquiring-gap ? root.not-acquiring-reason : root.monitoring-health-attention ? @tr("Il monitoraggio ha un'anomalia.") : (root.monitoring-state-code == 1 || root.monitoring-state-code == 2 ? @tr("Questo monitoraggio è in corso.") : @tr("Questo monitoraggio non è in corso."));
                                    }

                                    // L'elenco dei monitoraggi, quando sono piu'
                                    // d'uno. Con uno solo non compare: sarebbe un
                                    // elenco di una riga (ADR-0065).
                                    //
                                    // Mostra NOME e STATO, e nient'altro: questa e'
                                    // la schermata, non il vassoio, e qui i nomi si
                                    // possono leggere — la finestra e' aperta, e chi
                                    // la guarda ha sbloccato.
                                    if root.monitoring-list.length > 1: Rectangle {
                                        // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                        min-height: rip-68.preferred-height;
                                        rip-68 := VerticalLayout {
                                            spacing: Spacing.xs;
                                            vertical-stretch: 0;

                                            Text {
                                                text: @tr("{} monitoraggi. Quello mostrato qui sotto è quello scelto.", root.monitoring-list.length);
                                                color: Palette.text-muted;
                                                font-size: Typography.body-secondary;
                                                wrap: word-wrap;
                                            }

                                            LegendaOrigini {
                                                calcolato: @tr("stato");
                                                operatore: @tr("nome");
                                            }
                                            for row[index] in root.monitoring-list: Rectangle {
                                                height: 34px;
                                                vertical-stretch: 0;
                                                background: row.selected
                                                    ? Palette.accent-surface
                                                    : Palette.panel-raised;
                                                border-radius: Spacing.radius-row;
                                                border-width: Spacing.hairline;
                                                border-color: row.selected
                                                    ? Palette.frame
                                                    : Palette.frame-dim;

                                                HorizontalLayout {
                                                    padding-left: Spacing.sm;
                                                    padding-right: Spacing.sm;
                                                    spacing: Spacing.sm;

                                                    Text {
                                                        text: row.label;
                                                        color: Palette.text;
                                                        font-size: Typography.body-secondary;
                                                        // La scelta corrente si legge anche senza il
                                                        // colore di fondo (SIM3-15): peso e parola.
                                                        font-weight: row.selected ? Typography.medium : Typography.regular;
                                                        vertical-alignment: center;
                                                        horizontal-stretch: 1;
                                                        overflow: elide;
                                                    }

                                                    Text {
                                                        text: row.selected ? @tr("{}  \u{00b7}  mostrato qui sotto", row.state) : row.state;
                                                        color: Palette.text-muted;
                                                        font-size: Typography.body-secondary;
                                                        vertical-alignment: center;
                                                        horizontal-stretch: 0;
                                                    }
                                                }

                                                TouchArea {
                                                    mouse-cursor: pointer;
                                                    clicked => {
                                                        monitoring-row-focus.focus();
                                                        root.select-monitoring(index);
                                                    }
                                                }

                                                // Dichiarato DOPO il `TouchArea`, con
                                                // `focus-on-click: false`: altrimenti
                                                // il primo clic su una riga non ancora
                                                // a fuoco si spende per prendere il
                                                // fuoco e il clic non arriva mai. E'
                                                // lo stesso difetto gia' corretto
                                                // sulle righe dello storico.
                                                monitoring-row-focus := FocusScope {
                                                    focus-on-click: false;
                                                    key-pressed(event) => {
                                                        if (event.text == Key.Return || event.text == " ") {
                                                            root.select-monitoring(index);
                                                            return accept;
                                                        }
                                                        return reject;
                                                    }
                                                }

                                                // Un fuoco invisibile e' peggio di
                                                // nessun fuoco.
                                                Rectangle {
                                                    background: transparent;
                                                    border-width: monitoring-row-focus.has-focus ? 2px : 0px;
                                                    border-color: Palette.focus;
                                                    border-radius: Spacing.radius-row;
                                                }

                                                accessible-role: button;
                                                accessible-label: row.label + ", " + row.state + (row.selected ? @tr(", mostrato") : "");
                                            }
                                        }
                                    }

                                    // Stato di salute, unico elemento focale: attira
                                    // l'occhio, e cambia colore solo quando c'e' un'anomalia.
                                    // LARGO QUANTO SERVE, NON 210 PIXEL FISSI
                                    // (UX-EXCELLENCE-02, SIM3-21): alla misura minima
                                    // raggiunta trascinando, il riquadro usciva dal bordo
                                    // destro e «Arrestato» si leggeva a metà. Ora cede
                                    // larghezza e va a capo; non si nasconde.
                                    if root.monitoring-present: Rectangle {
                                        min-width: 120px;
                                        preferred-width: 210px;
                                        min-height: 52px;
                                        horizontal-stretch: 0;
                                        vertical-stretch: 0;
                                        background: Palette.panel-raised;
                                        border-radius: Spacing.radius-row;
                                        border-width: Spacing.frame-width;
                                        border-color: root.monitoring-health-attention
                                            ? Palette.coral
                                            : Palette.frame-dim;

                                        HorizontalLayout {
                                            padding-left: Spacing.md;
                                            padding-right: Spacing.md;
                                            padding-top: Spacing.xs;
                                            padding-bottom: Spacing.xs;
                                            spacing: Spacing.sm;
                                            Text {
                                                // «Operativo» solo se la postazione acquisisce davvero
                                                // (F-04): dopo un riavvio, con l'account scollegato,
                                                // diceva «Operativo» per un monitoraggio fermo.
                                                text: root.monitoring-shown-acquiring-gap ? @tr("Non acquisisce") : root.monitoring-health;
                                                // UN COLORE PER STATO, E LA PAROLA RESTA
                                                // (SIM3-15): «Operativo», «Arrestato» e «Avvisi
                                                // sospesi» erano tutti ambra. Ora l'ambra è
                                                // della sola sospensione, che chiede attenzione;
                                                // in corso è azzurro, fermo è grigio.
                                                color: root.monitoring-health-attention
                                                    ? Palette.coral
                                                    : root.monitoring-state-code == 1
                                                        ? Palette.cyan
                                                        : root.monitoring-state-code == 2
                                                            ? Palette.amber
                                                            : Palette.text-muted;
                                                font-size: Typography.section-title;
                                                font-weight: Typography.medium;
                                                vertical-alignment: center;
                                                wrap: word-wrap;
                                            }
                                        }
                                        accessible-role: text;
                                        accessible-label: @tr("Stato di salute: {}", (root.monitoring-shown-acquiring-gap ? @tr("non acquisisce. {}", root.not-acquiring-reason) : root.monitoring-health));
                                    }
                                }

                                if root.monitoring-message != "": InfoBanner {
                                    message: root.monitoring-message;
                                }

                                // Stato vuoto: dice che cosa fare per riempirlo.
                                if !root.monitoring-present: Rectangle {
                                    background: Palette.panel-raised;
                                    border-radius: Spacing.radius-row;
                                    // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                    min-height: rip-69.preferred-height;
                                    rip-69 := VerticalLayout {
                                        padding: Spacing.xl;
                                        spacing: Spacing.sm;
                                        alignment: center;
                                        Text {
                                            text: @tr("Nessun monitoraggio");
                                            color: Palette.text;
                                            font-size: Typography.section-title;
                                            font-weight: Typography.medium;
                                            horizontal-alignment: center;
                                        }
                                        Text {
                                            text: @tr("Comporre e avviare un monitoraggio dalla schermata «Nuovo monitoraggio». Comparirà qui, con il suo stato e i suoi comandi.");
                                            color: Palette.text-muted;
                                            font-size: Typography.body-secondary;
                                            horizontal-alignment: center;
                                            wrap: word-wrap;
                                        }
                                    }
                                }

                                if root.monitoring-present: Rectangle {
                                    background: Palette.panel-raised;
                                    border-radius: Spacing.radius-row;
                                    border-width: Spacing.hairline;
                                    border-color: Palette.line-divider;
                                    vertical-stretch: 0;

                                    // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                    min-height: rip-70.preferred-height;
                                    rip-70 := VerticalLayout {
                                        padding: Spacing.lg;
                                        spacing: Spacing.sm;

                                        Text {
                                            text: root.monitoring-label;
                                            color: Palette.text;
                                            font-size: Typography.section-title;
                                            font-weight: Typography.medium;
                                            wrap: word-wrap;
                                        }
                                        Text {
                                            text: @tr("Stato: {}  ·  Avviato da: {}  ·  Durata: {}{}", root.monitoring-state, root.monitoring-started-by, root.monitoring-duration, (root.monitoring-planned-end == "" ? "" : @tr("  ·  Fine prevista: {}", root.monitoring-planned-end)));
                                            color: Palette.text-muted;
                                            font-size: Typography.body-secondary;
                                            wrap: word-wrap;
                                        }
                                        Text {
                                            text: @tr("Creato: {}{}{}", root.monitoring-created, (root.monitoring-started != "" ? @tr("  ·  Avviato: {}", root.monitoring-started) : ""), (root.monitoring-ended != "" ? @tr("  ·  Concluso: {}", root.monitoring-ended) : ""));
                                            color: Palette.text-muted;
                                            font-size: Typography.technical;
                                            wrap: word-wrap;
                                        }
                                        if root.monitoring-schedule != "": Text {
                                            text: root.monitoring-schedule;
                                            color: Palette.text;
                                            font-size: Typography.body-secondary;
                                            wrap: word-wrap;
                                        }
                                        Text {
                                            text: root.monitoring-checkpoint != "" ? @tr("Ultimo punto di ripresa: {}", root.monitoring-checkpoint) : @tr("Nessun punto di ripresa: nessun evento è ancora stato elaborato.");
                                            color: Palette.text-muted;
                                            font-size: Typography.technical;
                                            wrap: word-wrap;
                                        }
                                    }
                                }

                                // Contatori operativi, dai servizi. Ogni numero risponde a
                                // una domanda: quanto e' stato acquisito, quanto attende.
                                if root.monitoring-present: Rectangle {
                                    // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                    min-height: rip-71.preferred-height;
                                    rip-71 := HorizontalLayout {
                                        spacing: Spacing.md;
                                        vertical-stretch: 0;

                                        // I RIQUADRI CHE PORTANO A QUALCOSA SONO COMANDI, GLI
                                        // ALTRI SONO CIFRE (UX-EXCELLENCE-02, SIM3-09).
                                        //
                                        // Erano sei riquadri uguali, in rilievo e con la
                                        // cornice: sembravano porte, e l'operatore cliccava
                                        // «16 contenuti acquisiti» per vederli senza che
                                        // succedesse nulla. Ora tre portano dove quei numeri
                                        // si leggono - contenuti allo Storico, avvisi agli
                                        // Avvisi - e lo dicono con la freccia, il puntatore e
                                        // il ruolo di comando; gli altri tre sono cifre
                                        // piatte, senza rilievo. Le parole «eventi in coda» ed
                                        // «eventi falliti» erano gergo del motore.
                                        for tile in [
                                            { n: root.monitoring-contents, l: "contenuti\nacquisiti", a: false, p: 8 },
                                            { n: root.monitoring-alerts, l: "avvisi\ngenerati", a: false, p: 7 },
                                            { n: root.monitoring-pending, l: "avvisi da\nesaminare", a: root.monitoring-pending > 0, p: 7 },
                                            { n: root.monitoring-inbox-pending, l: "messaggi da\nelaborare", a: false, p: -1 },
                                            { n: root.monitoring-inbox-failed, l: "messaggi non\nelaborati", a: root.monitoring-inbox-failed > 0, p: -1 },
                                            { n: root.monitoring-source-count, l: "fonti\nconfigurate", a: false, p: -1 },
                                        ]: Rectangle {
                                            height: 74px;
                                            background: tile.p >= 0
                                                ? (tile-touch.has-hover ? Palette.selected : Palette.panel-raised)
                                                : transparent;
                                            border-radius: Spacing.radius-row;
                                            border-width: Spacing.hairline;
                                            border-color: tile.a
                                                ? Palette.coral
                                                : (tile.p >= 0 ? Palette.frame-dim : Palette.line-divider);

                                            VerticalLayout {
                                                padding: Spacing.sm;
                                                alignment: center;
                                                Text {
                                                    text: tile.n;
                                                    color: tile.a ? Palette.coral : Palette.text;
                                                    font-size: 24px;
                                                    font-weight: Typography.medium;
                                                    horizontal-alignment: center;
                                                }
                                                Text {
                                                    text: tile.p >= 0 ? tile.l + " \u{203a}" : tile.l;
                                                    color: tile.p >= 0 ? Palette.cyan : Palette.text-muted;
                                                    font-size: Typography.group-label;
                                                    horizontal-alignment: center;
                                                    wrap: word-wrap;
                                                }
                                            }

                                            // Raggiungibile da tastiera come dal mouse: un
                                            // riquadro-comando senza fuoco non esisterebbe per
                                            // chi non usa il mouse. Prima del `TouchArea`, perche'
                                            // il clic non si spenda a spostare il fuoco.
                                            tile-focus := FocusScope {
                                                enabled: tile.p >= 0;
                                                key-pressed(event) => {
                                                    if (event.text == Key.Return || event.text == " ") {
                                                        Activity.touched();
                                                        root.open-page(tile.p);
                                                        return accept;
                                                    }
                                                    return reject;
                                                }
                                            }

                                            Rectangle {
                                                background: transparent;
                                                border-width: tile-focus.has-focus ? 2px : 0px;
                                                border-color: Palette.focus;
                                                border-radius: Spacing.radius-row;
                                            }

                                            tile-touch := TouchArea {
                                                enabled: tile.p >= 0;
                                                mouse-cursor: tile.p >= 0 ? MouseCursor.pointer : MouseCursor.default;
                                                clicked => {
                                                    Activity.touched();
                                                    root.open-page(tile.p);
                                                }
                                            }

                                            // Il ruolo per l'accessibilita' e' costante (Slint non
                                            // accetta un'espressione): due elementi, ed esiste
                                            // soltanto quello giusto, come in `Counter`.
                                            if tile.p >= 0: Rectangle {
                                                accessible-role: button;
                                                accessible-label: tile.n + " " + tile.l + (tile.p == 8 ? @tr(". Apre lo Storico") : @tr(". Apre gli Avvisi"));
                                                accessible-action-default => {
                                                    if (!StationLock.engaged) { root.open-page(tile.p); }
                                                }
                                            }
                                            if tile.p < 0: Rectangle {
                                                accessible-role: text;
                                                accessible-label: tile.n + " " + tile.l;
                                            }
                                        }
                                    }
                                }

                                // Stacco FISSO e non elastico: dentro un contenitore
                            // scorrevole un elemento elastico contribuisce zero
                            // all'altezza preferita, e collasserebbe incollando fra
                            // loro le due parti che teneva separate.
                            Rectangle { height: Spacing.xl; background: transparent; }

                                // Comandi. Ogni pulsante e' abilitato solo se il servizio
                                // dichiara ammessa quell'azione nello stato corrente.
                                if root.monitoring-present: Rectangle {
                                    // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                    min-height: rip-72.preferred-height;
                                    rip-72 := HorizontalLayout {
                                        spacing: Spacing.md;
                                        vertical-stretch: 0;

                                        HudButton {
                                            label: @tr("Avvia");
                                            enabled: root.monitoring-can-start;
                                            clicked => {
                                                root.monitoring-action("start");
                                            }
                                        }
                                        HudButton {
                                            label: @tr("Sospendi avvisi");
                                            enabled: root.monitoring-can-suspend;
                                            clicked => {
                                                root.monitoring-action("suspend");
                                            }
                                        }
                                        HudButton {
                                            label: @tr("Riprendi avvisi");
                                            enabled: root.monitoring-can-resume;
                                            clicked => {
                                                root.monitoring-action("resume");
                                            }
                                        }
                                        // E ORA? I contenuti di un monitoraggio si leggono
                                        // negli Avvisi e nello Storico, non qui
                                        // (OPERATOR-UX-REMEDIATION-01, task 05 e 07).
                                        HudButton {
                                            label: @tr("Vedi gli avvisi");
                                            clicked => {
                                                root.open-page(7);
                                            }
                                        }
                                        Rectangle { horizontal-stretch: 1; background: transparent; }
                                        // ARRESTARE CHIEDE CONFERMA (OS-09): l'arresto non
                                        // si annulla, e al primo clic non c'era ritorno.
                                        if !root.monitoring-confirm-stop: HudButton {
                                            label: @tr("Arresta");
                                            enabled: root.monitoring-can-stop;
                                            clicked => {
                                                root.monitoring-confirm-stop = true;
                                            }
                                        }
                                    }
                                }

                                if root.monitoring-present && root.monitoring-confirm-stop: Rectangle {
                                    vertical-stretch: 0;
                                    background: Palette.warning-surface;
                                    border-radius: Spacing.radius-row;

                                    // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                    min-height: rip-73.preferred-height;
                                    rip-73 := HorizontalLayout {
                                        padding: Spacing.md;
                                        spacing: Spacing.md;

                                        Text {
                                            text: @tr("Arrestare questo monitoraggio? Non si potrà riprendere: per continuare ne servirà uno nuovo. Ciò che ha già acquisito resta.");
                                            color: Palette.text;
                                            font-size: Typography.body-secondary;
                                            vertical-alignment: center;
                                            wrap: word-wrap;
                                            horizontal-stretch: 1;
                                        }
                                        HudButton {
                                            label: @tr("Annulla");
                                            clicked => {
                                                root.monitoring-confirm-stop = false;
                                            }
                                        }
                                        HudButton {
                                            label: @tr("Sì, arresta");
                                            weight: Weight.danger;
                                            enabled: root.monitoring-can-stop;
                                            clicked => {
                                                root.monitoring-confirm-stop = false;
                                                root.monitoring-action("stop");
                                            }
                                        }
                                    }
                                }

                                // LA PAUSA VERA (PAUSE-01, ADR-0172). La frase prima del
                                // comando dice il buco, come chiede ADR-0017: «Sospendi
                                // avvisi» non ferma niente, questa sì.
                                if root.monitoring-present && (root.monitoring-can-pause-acquisition || root.monitoring-can-resume-acquisition || root.monitoring-pause != ""): Rectangle {
                                    // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                    min-height: pausa-blocco.preferred-height;
                                    pausa-blocco := VerticalLayout {
                                        spacing: Spacing.sm;

                                        if root.monitoring-pause != "": Text {
                                            text: root.monitoring-pause;
                                            color: Palette.text;
                                            font-size: Typography.body-secondary;
                                            wrap: word-wrap;
                                        }
                                        Text {
                                            text: @tr("Durante la pausa i nuovi contenuti non vengono acquisiti: il periodo resta non coperto, e i documenti lo dicono. «Sospendi avvisi» invece non ferma l'acquisizione.");
                                            color: Palette.text-muted;
                                            font-size: Typography.body-secondary;
                                            wrap: word-wrap;
                                        }
                                        HorizontalLayout {
                                            spacing: Spacing.sm;
                                            HudInput {
                                                // L'etichetta è per chi ascolta: a schermo parla il
                                                // segnaposto (QUALITY-02, la prima serie di catture).
                                                placeholder: @tr("Perché la pausa, in almeno 20 caratteri");
                                                label: @tr("Perché la pausa, in almeno 20 caratteri");
                                                value <=> root.monitoring-pause-reason;
                                                enabled: root.monitoring-can-pause-acquisition;
                                            }
                                            HudButton {
                                                label: @tr("Metti in pausa l'acquisizione");
                                                enabled: root.monitoring-can-pause-acquisition && root.monitoring-pause-reason-ok(root.monitoring-pause-reason);
                                                reason: root.monitoring-can-pause-acquisition && !root.monitoring-pause-reason-ok(root.monitoring-pause-reason) ? @tr("Scrivere prima perché la pausa, in almeno 20 caratteri.") : "";
                                                clicked => {
                                                    root.monitoring-pause-acquisition(root.monitoring-pause-reason);
                                                }
                                            }
                                            HudButton {
                                                label: @tr("Riprendi l'acquisizione");
                                                enabled: root.monitoring-can-resume-acquisition;
                                                clicked => {
                                                    root.monitoring-resume-acquisition();
                                                }
                                            }
                                            Rectangle { horizontal-stretch: 1; background: transparent; }
                                        }
                                        if root.monitoring-can-pause-acquisition && root.monitoring-pause-reason-hint(root.monitoring-pause-reason) != "": Text {
                                            text: root.monitoring-pause-reason-hint(root.monitoring-pause-reason);
                                            color: Palette.text-muted;
                                            font-size: Typography.body-secondary;
                                            wrap: word-wrap;
                                        }
                                        if root.monitoring-pause-outcome != "": Text {
                                            text: root.monitoring-pause-outcome;
                                            color: Palette.text;
                                            font-size: Typography.body-secondary;
                                            wrap: word-wrap;
                                            accessible-role: text;
                                            accessible-label: root.monitoring-pause-outcome;
                                        }
                                    }
                                }

                                // CHE COSA HA GUARDATO QUESTO MONITORAGGIO (PR-05,
                                // ADR-0121): una barra per fonte, sulla sua finestra, e
                                // la frase che ne fissa il senso sopra le barre.
                                if root.monitoring-present && root.monitoring-coverage.length > 0: Rectangle {
                                    // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                    min-height: rip-74.preferred-height;
                                    rip-74 := VerticalLayout {
                                        spacing: Spacing.sm;
                                        vertical-stretch: 0;

                                        Text {
                                            text: @tr("CHE COSA HA GUARDATO");
                                            color: Palette.text-muted;
                                            font-family: Typography.mono;
                                            font-size: Typography.eyebrow;
                                            font-weight: Typography.regular;
                                            letter-spacing: Typography.track-eyebrow;
                                        }
                                        Text {
                                            text: root.monitoring-coverage-overall + " " + root.coverage-meaning;
                                            color: Palette.text-muted;
                                            font-size: Typography.group-label;
                                            wrap: word-wrap;
                                        }
                                        if root.coverage-scope-note != "": Text {
                                            text: root.coverage-scope-note;
                                            color: Palette.amber;
                                            font-size: Typography.group-label;
                                            wrap: word-wrap;
                                        }
                                        LegendaCopertura { }
                                        LegendaOrigini {
                                            osservato: @tr("nome della fonte");
                                            calcolato: @tr("copertura");
                                        }
                                        for fonte in root.monitoring-coverage: Rectangle {
                                            // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                            min-height: rip-75.preferred-height;
                                            rip-75 := VerticalLayout {
                                                spacing: Spacing.xs;

                                                Text {
                                                    text: fonte.name;
                                                    color: Palette.text;
                                                    font-size: Typography.body-secondary;
                                                }
                                                BarraCopertura {
                                                    tratti: fonte.tratti;
                                                    recuperati: fonte.recuperati;
                                                    descrizione: fonte.name + ". " + fonte.summary;
                                                }
                                                Text {
                                                    text: fonte.summary;
                                                    color: Palette.text-muted;
                                                    font-size: Typography.group-label;
                                                    wrap: word-wrap;
                                                }
                                            }
                                        }
                                    }
                                }

                                // Recupero della cronologia.
                                //
                                // Sta sotto ai comandi del ciclo di vita e non fra essi: non
                                // e' una transizione della sessione, e mescolarlo agli altri
                                // lo farebbe sembrare tale.
                                VerticalLayout {
                                    spacing: Spacing.sm;
                                    vertical-stretch: 0;

                                    Text {
                                        text: @tr("RECUPERO DELLA CRONOLOGIA");
                                        color: Palette.text-muted;
                                        font-family: Typography.mono;
                                        font-size: Typography.eyebrow;
                                        font-weight: Typography.regular;
                                        letter-spacing: Typography.track-eyebrow;
                                    }

                                    Text {
                                        text: @tr("Cerca i messaggi pubblicati dall'inizio di questo monitoraggio che l'applicazione non ha visto arrivare - perché era chiusa, sospesa o senza rete. Prima dice quanti sono; archivia solo dopo la conferma.");
                                        color: Palette.text-muted;
                                        font-size: Typography.body-secondary;
                                        wrap: word-wrap;
                                    }

                                    HorizontalLayout {
                                        spacing: Spacing.md;
                                        vertical-stretch: 0;

                                        HudButton {
                                            label: root.recovery-busy ? @tr("Lettura in corso...") : @tr("Cerca cosa manca");
                                            enabled: !root.recovery-busy;
                                            clicked => {
                                                root.survey-recovery();
                                            }
                                        }

                                        // Il comando che archivia esiste **solo** dopo che
                                        // qualcosa e' stato trovato e mostrato: prima non
                                        // c'e' nulla che si sappia di dover archiviare, e un
                                        // pulsante disabilitato inviterebbe comunque a
                                        // premerlo senza aver letto.
                                        if root.recovery-awaiting-confirmation: HudButton {
                                            label: @tr("Recupera e archivia");
                                            weight: Weight.primary;
                                            enabled: !root.recovery-busy;
                                            clicked => {
                                                root.confirm-recovery();
                                            }
                                        }
                                        // Un comando solo per due situazioni: fermare una
                                        // lettura in corso e rinunciare a un risultato gia'
                                        // pronto. Sono due modi di dire «non ora», e
                                        // distinguerli in due pulsanti avrebbe chiesto
                                        // all'operatore di sapere in quale dei due stati si
                                        // trova. Cambia solo l'etichetta.
                                        if root.recovery-awaiting-confirmation || root.recovery-busy: HudButton {
                                            label: root.recovery-busy ? @tr("Interrompi") : @tr("Non ora");
                                            clicked => {
                                                root.discard-recovery();
                                            }
                                        }

                                        Rectangle { horizontal-stretch: 1; background: transparent; }
                                    }

                                    if root.recovery-message != "": InfoBanner {
                                        message: root.recovery-message;
                                    }

                                    // Cio' che un recupero non vede, detto accanto
                                    // al comando (ADR-0123 §5): e' la stessa frase
                                    // dell'atto e dell'allegato.
                                    Text {
                                        text: @tr("Un messaggio recuperato è stato letto nella cronologia dopo la pubblicazione. Non si vedono le modifiche intermedie, le cancellazioni avvenute prima del recupero, le reazioni e gli altri dati che cambiano.");
                                        color: Palette.text-muted;
                                        font-size: Typography.group-label;
                                        wrap: word-wrap;
                                    }
                                }

                                // Recupero dei periodi decisi (PR-07, ADR-0123).
                                //
                                // Una persona ha deciso, nella Coda di lavoro, che
                                // un periodo non coperto va valutato per un
                                // recupero. Qui lo si guarda e, solo dopo la
                                // conferma, lo si archivia. Nulla parte da solo.
                                if root.interval-rows.length > 0: Rectangle {
                                    // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                    min-height: rip-76.preferred-height;
                                    rip-76 := VerticalLayout {
                                        spacing: Spacing.sm;
                                        vertical-stretch: 0;

                                        Text {
                                            text: @tr("RECUPERO DEI PERIODI DECISI");
                                            color: Palette.text-muted;
                                            font-family: Typography.mono;
                                            font-size: Typography.eyebrow;
                                            font-weight: Typography.regular;
                                            letter-spacing: Typography.track-eyebrow;
                                        }

                                        Text {
                                            text: @tr("Periodi che una persona ha deciso di valutare per un recupero. Si legge la cronologia di quella fonte per quel periodo, e si dice quanti messaggi non sono in archivio. Si archivia solo dopo la conferma.");
                                            color: Palette.text-muted;
                                            font-size: Typography.body-secondary;
                                            wrap: word-wrap;
                                        }

                                        LegendaOrigini {
                                            osservato: @tr("fonte");
                                            calcolato: @tr("periodo e monitoraggio");
                                        }
                                        for periodo in root.interval-rows: Rectangle {
                                            background: Palette.panel-raised;
                                            border-radius: Spacing.radius-row;
                                            vertical-stretch: 0;

                                            // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                            min-height: rip-77.preferred-height;
                                            rip-77 := VerticalLayout {
                                                padding: Spacing.lg;
                                                spacing: Spacing.xs;

                                                Text {
                                                    text: periodo.source;
                                                    color: Palette.text;
                                                    font-size: Typography.body;
                                                    font-weight: Typography.medium;
                                                }
                                                Text {
                                                    text: periodo.sentence;
                                                    color: Palette.text-muted;
                                                    font-size: Typography.body-secondary;
                                                    wrap: word-wrap;
                                                }
                                                if periodo.recoverable: Rectangle {
                                                    // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                                    min-height: rip-78.preferred-height;
                                                    rip-78 := HorizontalLayout {
                                                        vertical-stretch: 0;
                                                        HudButton {
                                                            label: root.interval-busy ? @tr("Lettura in corso...") : @tr("Cerca nel periodo");
                                                            enabled: !root.interval-busy && !root.interval-awaiting-confirmation;
                                                            accessible-label: @tr("Cerca nel periodo, {}", periodo.source);
                                                            clicked => {
                                                                root.interval-survey(periodo.key);
                                                            }
                                                        }
                                                        Rectangle { horizontal-stretch: 1; background: transparent; }
                                                    }
                                                }
                                            }
                                        }

                                        HorizontalLayout {
                                            spacing: Spacing.md;
                                            vertical-stretch: 0;

                                            // Come per il recupero dall'inizio: il comando
                                            // che archivia esiste solo dopo che qualcosa e'
                                            // stato trovato e mostrato.
                                            if root.interval-awaiting-confirmation: HudButton {
                                                label: @tr("Archivia come recuperati");
                                                weight: Weight.primary;
                                                enabled: !root.interval-busy;
                                                clicked => {
                                                    root.interval-confirm();
                                                }
                                            }
                                            if root.interval-awaiting-confirmation || root.interval-busy: HudButton {
                                                label: root.interval-busy ? @tr("Interrompi") : @tr("Non ora");
                                                clicked => {
                                                    root.interval-discard();
                                                }
                                            }
                                            Rectangle { horizontal-stretch: 1; background: transparent; }
                                        }

                                        if root.interval-message != "": InfoBanner {
                                            message: root.interval-message;
                                        }
                                    }
                                }

                                // Storico precedente all'avvio (PR-08, ADR-0124).
                                //
                                // Va oltre il recupero di sempre, che si ferma
                                // all'avvio: per questo chiede una ragione
                                // scritta, e dice il suo limite PRIMA del comando.
                                if root.prior-history-rows.length > 0: Rectangle {
                                    // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                    min-height: rip-79.preferred-height;
                                    rip-79 := VerticalLayout {
                                        spacing: Spacing.sm;
                                        vertical-stretch: 0;

                                        Text {
                                            text: @tr("STORICO PRECEDENTE ALL'AVVIO");
                                            color: Palette.text-muted;
                                            font-family: Typography.mono;
                                            font-size: Typography.eyebrow;
                                            font-weight: Typography.regular;
                                            letter-spacing: Typography.track-eyebrow;
                                        }

                                        Text {
                                            text: @tr("Legge ciò che una fonte aveva pubblicato prima dell'avvio del monitoraggio. Il recupero di sempre si ferma all'avvio: questo va oltre, e chiede una ragione scritta.");
                                            color: Palette.text-muted;
                                            font-size: Typography.body-secondary;
                                            wrap: word-wrap;
                                        }

                                        // IL LIMITE, PRIMA DEL COMANDO: la stessa frase
                                        // del servizio, parola per parola.
                                        Text {
                                            text: @tr("Lo storico è ciò che la fonte mostra oggi. Ciò che è stato cancellato o modificato prima di oggi non c'è, e il programma non lo ricostruisce.");
                                            color: Palette.amber;
                                            font-size: Typography.body-secondary;
                                            wrap: word-wrap;
                                        }
                                        Text {
                                            text: @tr("Si leggono al più 200 pagine da cento messaggi, una alla volta, e la lettura si può interrompere.");
                                            color: Palette.text-muted;
                                            font-size: Typography.group-label;
                                            wrap: word-wrap;
                                        }

                                        HorizontalLayout {
                                            spacing: Spacing.md;
                                            vertical-stretch: 0;

                                            HudSelect {
                                                label: @tr("Quanto indietro");
                                                description: @tr("Quanto prima dell'avvio del monitoraggio si legge");
                                                model: [@tr("7 giorni"), @tr("30 giorni"), @tr("90 giorni")];
                                                current-index <=> root.prior-history-span;
                                                enabled: !root.prior-history-busy && !root.prior-history-awaiting-confirmation;
                                                width: 160px;
                                            }
                                            HudInput {
                                                label: @tr("Ragione operativa");
                                                placeholder: @tr("Perché serve lo storico di questa fonte");
                                                value <=> root.prior-history-reason;
                                                enabled: !root.prior-history-busy && !root.prior-history-awaiting-confirmation;
                                                horizontal-stretch: 1;
                                            }
                                        }

                                        LegendaOrigini {
                                            osservato: @tr("fonte");
                                            calcolato: @tr("avvio e storici già letti");
                                            operatore: @tr("nome del monitoraggio");
                                        }
                                        for riga in root.prior-history-rows: Rectangle {
                                            background: Palette.panel-raised;
                                            border-radius: Spacing.radius-row;
                                            vertical-stretch: 0;

                                            // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                            min-height: rip-80.preferred-height;
                                            rip-80 := VerticalLayout {
                                                padding: Spacing.lg;
                                                spacing: Spacing.xs;

                                                Text {
                                                    text: riga.source + "  \u{00b7}  " + riga.session;
                                                    color: Palette.text;
                                                    font-size: Typography.body;
                                                    font-weight: Typography.medium;
                                                }
                                                Text {
                                                    text: riga.sentence;
                                                    color: Palette.text-muted;
                                                    font-size: Typography.body-secondary;
                                                    wrap: word-wrap;
                                                }
                                                if riga.readable: Rectangle {
                                                    // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                                    min-height: rip-81.preferred-height;
                                                    rip-81 := HorizontalLayout {
                                                        vertical-stretch: 0;
                                                        HudButton {
                                                            // «Leggi i messaggi precedenti», non «Leggi lo
                                                            // storico» (UX-EXCELLENCE-02, SIM3-11): «Storico»
                                                            // e' gia' il nome di una schermata, e l'operatore li
                                                            // confondeva.
                                                            label: @tr("Leggi i messaggi precedenti");
                                                            enabled: root.prior-history-reason != "" && !root.prior-history-busy && !root.prior-history-awaiting-confirmation;
                                                            accessible-label: @tr("Leggi i messaggi precedenti, {}", riga.source);
                                                            clicked => {
                                                                root.prior-history-start(riga.key);
                                                            }
                                                        }
                                                        Rectangle { horizontal-stretch: 1; background: transparent; }
                                                    }
                                                }
                                            }
                                        }

                                        HorizontalLayout {
                                            spacing: Spacing.md;
                                            vertical-stretch: 0;

                                            if root.prior-history-awaiting-confirmation: HudButton {
                                                label: @tr("Archivia lo storico come recuperato");
                                                weight: Weight.primary;
                                                enabled: !root.prior-history-busy;
                                                clicked => {
                                                    root.prior-history-confirm();
                                                }
                                            }
                                            if root.prior-history-awaiting-confirmation || root.prior-history-busy: HudButton {
                                                label: root.prior-history-busy ? @tr("Interrompi") : @tr("Non ora");
                                                clicked => {
                                                    root.prior-history-stop();
                                                }
                                            }
                                            Rectangle { horizontal-stretch: 1; background: transparent; }
                                        }

                                        if root.prior-history-message != "": InfoBanner {
                                            message: root.prior-history-message;
                                        }
                                    }
                                }

                                // Ricerca retroattiva.
                                //
                                // Sta accanto al recupero perche' entrambe leggono la
                                // cronologia, ma **non ha un comando di conferma**: non
                                // archivia nulla, quindi non c'e' nulla da confermare. La
                                // differenza e' scritta, non lasciata dedurre dai pulsanti.
                                VerticalLayout {
                                    spacing: Spacing.sm;
                                    vertical-stretch: 0;

                                    Text {
                                        text: @tr("RICERCA RETROATTIVA");
                                        color: Palette.text-muted;
                                        font-family: Typography.mono;
                                        font-size: Typography.eyebrow;
                                        font-weight: Typography.regular;
                                        letter-spacing: Typography.track-eyebrow;
                                    }

                                    Text {
                                        text: @tr("Cerca i termini del dizionario nella cronologia già pubblicata delle fonti configurate, anche prima dell'inizio del monitoraggio. Mostra cosa trova e non archivia nulla: ciò che compare qui non entra nello Storico.");
                                        color: Palette.text-muted;
                                        font-size: Typography.body-secondary;
                                        wrap: word-wrap;
                                    }

                                    HorizontalLayout {
                                        spacing: Spacing.md;
                                        vertical-stretch: 0;

                                        HudButton {
                                            label: root.retro-busy ? @tr("Ricerca in corso...") : @tr("Cerca nel passato");
                                            enabled: !root.retro-busy;
                                            clicked => {
                                                root.start-retro-search();
                                            }
                                        }
                                        if root.retro-busy: HudButton {
                                            label: @tr("Interrompi");
                                            clicked => {
                                                root.stop-retro-search();
                                            }
                                        }
                                        Rectangle { horizontal-stretch: 1; background: transparent; }
                                    }

                                    if root.retro-message != "": InfoBanner {
                                        message: root.retro-message;
                                    }

                                    LegendaOrigini {
                                        osservato: @tr("fonte, data, testo, collegamento");
                                        calcolato: @tr("livello e termini");
                                    }
                                    for found in root.retro-matches: Rectangle {
                                        background: Palette.panel-raised;
                                        border-radius: Spacing.radius-row;
                                        vertical-stretch: 0;

                                        // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                        min-height: rip-82.preferred-height;
                                        rip-82 := VerticalLayout {
                                            padding: Spacing.lg;
                                            spacing: Spacing.xs;

                                            HorizontalLayout {
                                                spacing: Spacing.md;
                                                Text {
                                                    text: found.source;
                                                    color: Palette.text;
                                                    font-size: Typography.body;
                                                    font-weight: Typography.medium;
                                                    horizontal-stretch: 1;
                                                    overflow: elide;
                                                }
                                                Text {
                                                    text: found.published;
                                                    color: Palette.text-muted;
                                                    font-size: Typography.technical;
                                                    horizontal-stretch: 0;
                                                }
                                            }

                                            Text {
                                                text: found.level-label + "  \u{00b7}  " + found.terms;
                                                color: Palette.text-muted;
                                                font-size: Typography.group-label;
                                            }

                                            Text {
                                                text: found.excerpt;
                                                color: Palette.text-muted;
                                                font-size: Typography.body-secondary;
                                                wrap: word-wrap;
                                                overflow: elide;
                                            }

                                            HorizontalLayout {
                                                spacing: Spacing.sm;
                                                vertical-stretch: 0;

                                                // PERCHE' VEDO QUESTO (PR-02): il
                                                // riscontro di una ricerca
                                                // retroattiva, fatto con il motore
                                                // di adesso.
                                                PercheVedoQuesto {
                                                    elemento: found.source + ", " + found.published;
                                                    chiesto => {
                                                        root.explain-this(Spiegabile.riscontro-retroattivo, "", found.level-label + ". Termini trovati: " + found.terms + ".");
                                                    }
                                                }
                                                if found.url != "": HudButton {
                                                    label: @tr("Apri il messaggio");
                                                    clicked => {
                                                        root.open-url(found.url);
                                                    }
                                                }
                                                Rectangle { horizontal-stretch: 1; background: transparent; }
                                            }
                                        }

                                        accessible-role: text;
                                        accessible-label: @tr("{}, {}, {}, termini: {}. Non archiviato.", found.source, found.published, found.level-label, found.terms);
                                    }
                                }
                            }
                        }
                    }

                    // -------------------------------------------------- Guida
                    //
                    // Il contenuto viene da Rust (lisi-core::guide): un test verifica
                    // che dichiari i limiti invece di sovrapprometterli.
                    if root.current-page == 10: Rectangle {
                        // Comparsa graduale della pagina: vedere la pagina 0 per il
                        // perche' la dissolvenza sia solo in entrata.
                        property <bool> entered: false;
                        opacity: 0.0;
                        init => {
                            self.entered = true;
                        }
                        animate opacity {
                            duration: Motion.transition-effective;
                            easing: cubic-bezier(0.16, 1, 0.3, 1);
                        }
        states [
            shown when self.entered: {
                opacity: 1.0;
            }
        ]
                        background: Palette.panel;
                        border-radius: Spacing.radius-panel;

                        VerticalLayout {
                            padding: Spacing.xl;
                            spacing: Spacing.lg;

                            VerticalLayout {
                                spacing: Spacing.xs;
                                vertical-stretch: 0;
                                Text {
                                    text: @tr("Guida");
                                    color: Palette.text;
                                    font-size: Typography.screen-title;
                                    font-weight: Typography.medium;
                                }
                                Text {
                                    text: @tr("Che cosa fa il prodotto, come si usa, e che cosa non fa.");
                                    color: Palette.text-muted;
                                    font-size: Typography.body-secondary;
                                    wrap: word-wrap;
                                }
                            }

                            // ESERCITARSI SI TROVA DAL PROGRAMMA (F-06).
                            //
                            // Prima esisteva solo il collegamento del menu Start, e
                            // chi non lo conosceva provava sulla modalità
                            // dimostrativa di Account, che non ha contenuti.
                            if !root.exercise-mode: Rectangle {
                                vertical-stretch: 0;
                                background: Palette.panel-raised;
                                border-radius: Spacing.radius-panel;
                                min-height: esercitarsi.preferred-height;

                                esercitarsi := VerticalLayout {
                                    padding: Spacing.lg;
                                    spacing: Spacing.sm;

                                    Text {
                                        text: @tr("Esercitarsi senza rischi");
                                        color: Palette.text;
                                        font-size: Typography.panel-title;
                                        font-weight: Typography.medium;
                                    }
                                    Text {
                                        text: @tr("L'Esercitazione ha messaggi di prova, avvisi, revisioni e documenti, in un archivio separato. Non contatta Telegram e non tocca il lavoro vero. Si apre in una finestra a parte, con «ESERCITAZIONE» nel titolo.");
                                        color: Palette.text-muted;
                                        font-size: Typography.body-secondary;
                                        wrap: word-wrap;
                                    }
                                    HorizontalLayout {
                                        spacing: Spacing.md;
                                        HudButton {
                                            label: @tr("Apri l'Esercitazione");
                                            clicked => {
                                                root.open-exercise();
                                            }
                                        }
                                        Rectangle { horizontal-stretch: 1; background: transparent; }
                                    }
                                    if root.open-exercise-message != "": Text {
                                        text: root.open-exercise-message;
                                        color: Palette.text;
                                        font-size: Typography.body-secondary;
                                        wrap: word-wrap;
                                    }
                                }
                            }

                            HudScroll {
                                VerticalLayout {
                                    // Fra una sezione e l'altra ci vuole aria: la guida si
                                    // legge di seguito, e riquadri accostati si leggono come
                                    // un muro.
                                    spacing: Spacing.lg;

                                    for section in root.guide-sections: Rectangle {
                                        background: Palette.panel-raised;
                                        border-radius: Spacing.radius-panel;
                                        border-width: Spacing.hairline;
                                        border-color: Palette.line-divider;

                                        // **UN `Rectangle` NON PRENDE L'ALTEZZA DAI FIGLI.**
                                        //
                                        // Dentro un `VerticalLayout` si spartisce lo spazio
                                        // in parti uguali con i fratelli, e un testo piu'
                                        // lungo della propria fetta viene TAGLIATO. Sullo
                                        // schermo le sezioni finivano a meta' frase - «con
                                        // il suo stato e i», «lascerebbe un buco che
                                        // nessuno» - e sembrava un problema di scrittura.
                                        //
                                        // Rilevato durante il pilot il 2026-08-20, ed e' la
                                        // stessa famiglia delle righe tagliate dello Storico:
                                        // la si chiude allo stesso modo, dichiarando che il
                                        // riquadro non puo' essere piu' basso di cio' che
                                        // contiene.
                                        vertical-stretch: 0;
                                        min-height: sezione.preferred-height;

                                        sezione := VerticalLayout {
                                            padding: Spacing.xl;
                                            spacing: Spacing.md;
                                            Text {
                                                text: section.title;
                                                color: Palette.text;
                                                font-size: Typography.section-title;
                                                font-weight: Typography.medium;
                                                wrap: word-wrap;
                                            }
                                            Text {
                                                text: section.body;
                                                color: Palette.text-muted;
                                                font-size: Typography.body-secondary;
                                                // **LA RIGA HA UNA LUNGHEZZA MASSIMA.**
                                                //
                                                // A tutta larghezza una riga supera i cento
                                                // caratteri, e l'occhio perde il capo della
                                                // successiva: e' il difetto che fa rileggere
                                                // due volte la stessa frase. Slint 1.17 non
                                                // espone l'interlinea, quindi la leva
                                                // disponibile per rendere leggibile un testo
                                                // lungo e' questa.
                                                max-width: 720px;
                                                wrap: word-wrap;
                                            }
                                        }

                                        accessible-role: text;
                                        accessible-label: section.title;
                                        accessible-description: section.body;
                                    }

                                    // LE PAROLE DEL PROGRAMMA (PR-01, ADR-0117).
                                    //
                                    // Il glossario si legge dove l'operatore cerca: qui.
                                    // Ogni voce dice il nome, che cosa vuol dire in parole
                                    // comuni e, dietro «Dettagli tecnici», il resto.
                                    Text {
                                        text: @tr("LE PAROLE DEL PROGRAMMA");
                                        color: Palette.text-muted;
                                        font-size: Typography.group-label;
                                        letter-spacing: Typography.track-eyebrow;
                                    }

                                    for voce in root.glossary-entries: Rectangle {
                                        background: Palette.panel-raised;
                                        border-radius: Spacing.radius-panel;
                                        border-width: Spacing.hairline;
                                        border-color: Palette.line-divider;
                                        vertical-stretch: 0;
                                        min-height: parola.preferred-height;

                                        parola := VerticalLayout {
                                            padding: Spacing.lg;
                                            spacing: Spacing.xs;
                                            Text {
                                                text: voce.term;
                                                color: Palette.text;
                                                font-size: Typography.body;
                                                font-weight: Typography.medium;
                                                wrap: word-wrap;
                                            }
                                            Text {
                                                text: voce.plain;
                                                color: Palette.text-muted;
                                                font-size: Typography.body-secondary;
                                                max-width: 720px;
                                                wrap: word-wrap;
                                            }
                                            DettagliTecnici {
                                                testo: voce.detail;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // -------------------------------------------- Impostazioni
                    //
                    // Le opzioni di riservatezza vengono da Rust (lisi-core), dove
                    // vivono le etichette. Dal 2026-07-31 il motore che decide se
                    // notificare e' collegato al ciclo di acquisizione
                    // (`crate::acquisition`), quindi queste impostazioni valgono sui
                    // contenuti reali. Resta deferito all'installer il solo avviso di
                    // Windows, che richiede un `AppUserModelID` registrato.
                    if root.current-page == 11: Rectangle {
                        // Comparsa graduale della pagina: vedere la pagina 0 per il
                        // perche' la dissolvenza sia solo in entrata.
                        property <bool> entered: false;
                        opacity: 0.0;
                        init => {
                            self.entered = true;
                        }
                        // La sezione chiesta da «Apri Impostazioni» si raggiunge al giro
                        // dopo l'apertura, quando le posizioni delle sezioni esistono.
                        Timer {
                            interval: Motion.settle;
                            running: root.settings-jump-section > 0;
                            triggered => {
                                if (root.settings-jump-section == 1) {
                                    impostazioni.scroll-y = root.settings-scroll-target(sez-archivio.absolute-position.y, impostazioni-corpo.absolute-position.y, impostazioni.view-height, impostazioni.content-height);
                                } else if (root.settings-jump-section == 2) {
                                    impostazioni.scroll-y = root.settings-scroll-target(sez-copia.absolute-position.y, impostazioni-corpo.absolute-position.y, impostazioni.view-height, impostazioni.content-height);
                                }
                                root.settings-jump-section = 0;
                            }
                        }
                        animate opacity {
                            duration: Motion.transition-effective;
                            easing: cubic-bezier(0.16, 1, 0.3, 1);
                        }
        states [
            shown when self.entered: {
                opacity: 1.0;
            }
        ]
                        background: Palette.panel;
                        border-radius: Spacing.radius-panel;

                        // UN INDICE IN CIMA, E L'ESITO SEMPRE IN VISTA (UX-EXCELLENCE-02,
                        // SIM3-13). La pagina e' lunga - una dozzina di sezioni, ognuna
                        // con il proprio comando - e si attraversava con la rotellina:
                        // circa sessantacinque scatti. L'indice porta alla sezione;
                        // l'esito dell'ultimo comando sta sopra lo scorrimento, e non in
                        // fondo dove nessuno lo vedeva. Le sezioni non si fondono: ogni
                        // salvataggio salva una cosa diversa, e lo dice nel nome.
                        VerticalLayout {
                            padding-top: Spacing.lg;
                            padding-left: Spacing.xl;
                            padding-right: Spacing.xl;
                            spacing: Spacing.xs;

                            Text {
                                text: @tr("Impostazioni");
                                color: Palette.text;
                                font-size: Typography.screen-title;
                                font-weight: Typography.medium;
                            }
                            HorizontalLayout {
                                spacing: Spacing.xxs;
                                vertical-stretch: 0;
                                SettingsJump {
                                    label: @tr("Profilo");
                                    activated => { impostazioni.scroll-y = root.settings-scroll-target(sez-profilo.absolute-position.y, impostazioni-corpo.absolute-position.y, impostazioni.view-height, impostazioni.content-height); }
                                }
                                SettingsJump {
                                    label: @tr("Notifiche");
                                    activated => { impostazioni.scroll-y = root.settings-scroll-target(sez-notifiche.absolute-position.y, impostazioni-corpo.absolute-position.y, impostazioni.view-height, impostazioni.content-height); }
                                }
                                SettingsJump {
                                    label: @tr("Organizzazioni");
                                    activated => { impostazioni.scroll-y = root.settings-scroll-target(sez-organizzazioni.absolute-position.y, impostazioni-corpo.absolute-position.y, impostazioni.view-height, impostazioni.content-height); }
                                }
                                SettingsJump {
                                    label: @tr("Aspetto");
                                    activated => { impostazioni.scroll-y = root.settings-scroll-target(sez-aspetto.absolute-position.y, impostazioni-corpo.absolute-position.y, impostazioni.view-height, impostazioni.content-height); }
                                }
                                SettingsJump {
                                    label: @tr("Blocco");
                                    activated => { impostazioni.scroll-y = root.settings-scroll-target(sez-blocco.absolute-position.y, impostazioni-corpo.absolute-position.y, impostazioni.view-height, impostazioni.content-height); }
                                }
                                SettingsJump {
                                    label: @tr("Avvio automatico");
                                    activated => { impostazioni.scroll-y = root.settings-scroll-target(sez-avvio.absolute-position.y, impostazioni-corpo.absolute-position.y, impostazioni.view-height, impostazioni.content-height); }
                                }
                                Rectangle { horizontal-stretch: 1; background: transparent; }
                            }
                            HorizontalLayout {
                                spacing: Spacing.xxs;
                                vertical-stretch: 0;
                                SettingsJump {
                                    label: @tr("Ufficio");
                                    activated => { impostazioni.scroll-y = root.settings-scroll-target(sez-condivisa.absolute-position.y, impostazioni-corpo.absolute-position.y, impostazioni.view-height, impostazioni.content-height); }
                                }
                                SettingsJump {
                                    label: @tr("Aggiornamenti");
                                    activated => { impostazioni.scroll-y = root.settings-scroll-target(sez-aggiornamenti.absolute-position.y, impostazioni-corpo.absolute-position.y, impostazioni.view-height, impostazioni.content-height); }
                                }
                                SettingsJump {
                                    label: @tr("Verifica dell'archivio");
                                    activated => { impostazioni.scroll-y = root.settings-scroll-target(sez-archivio.absolute-position.y, impostazioni-corpo.absolute-position.y, impostazioni.view-height, impostazioni.content-height); }
                                }
                                SettingsJump {
                                    label: @tr("Copia di sicurezza");
                                    activated => { impostazioni.scroll-y = root.settings-scroll-target(sez-copia.absolute-position.y, impostazioni-corpo.absolute-position.y, impostazioni.view-height, impostazioni.content-height); }
                                }
                                SettingsJump {
                                    label: @tr("Firma dell'ufficio");
                                    activated => { impostazioni.scroll-y = root.settings-scroll-target(sez-firma.absolute-position.y, impostazioni-corpo.absolute-position.y, impostazioni.view-height, impostazioni.content-height); }
                                }
                                SettingsJump {
                                    label: @tr("Conservazione");
                                    activated => { impostazioni.scroll-y = root.settings-scroll-target(sez-conservazione.absolute-position.y, impostazioni-corpo.absolute-position.y, impostazioni.view-height, impostazioni.content-height); }
                                }
                                Rectangle { horizontal-stretch: 1; background: transparent; }
                            }

                            if root.settings-message != "": InfoBanner {
                                message: root.settings-message;
                            }

                        impostazioni := HudScroll {
                            impostazioni-corpo := VerticalLayout {
                                padding-top: Spacing.md;
                                padding-bottom: Spacing.xl;
                                spacing: Spacing.lg;
                                alignment: start;

                                // ------------------------------- profilo documentale
                                //
                                // Gli stessi campi del primo avvio, nello
                                // stesso modulo: `ProfileFields` legge e scrive
                                // il global, quindi qui non c'e' nulla da
                                // ricollegare.
                                sez-profilo := VerticalLayout {
                                    spacing: Spacing.sm;
                                    vertical-stretch: 0;

                                    Text {
                                        text: @tr("Profilo documentale");
                                        color: Palette.text;
                                        font-size: Typography.screen-title;
                                        font-weight: Typography.medium;
                                    }
                                    Text {
                                        text: @tr("I dati dell'ufficio che intestano le relazioni di servizio. Tutti facoltativi: dove un dato manca, il documento lascia lo spazio da compilare in Word invece di inventarlo.");
                                        color: Palette.text-muted;
                                        font-size: Typography.body-secondary;
                                        wrap: word-wrap;
                                    }
                                    Text {
                                        text: DocumentProfile.version > 0 ? @tr("Profilo conservato, versione {}. Ogni relazione registra con quale versione è stata prodotta.", DocumentProfile.version) : @tr("Nessun profilo conservato: le relazioni escono con gli spazi da compilare.");
                                        color: Palette.text-muted;
                                        font-size: Typography.group-label;
                                        wrap: word-wrap;
                                    }

                                    if DocumentProfile.message != "": InfoBanner {
                                        message: DocumentProfile.message;
                                    }

                                    ProfileFields { }

                                    // L'anteprima segue i campi e non li precede: si compila
                                    // guardando i campi, e ci si volta a controllare.
                                    ProfilePreview { }

                                    HorizontalLayout {
                                        spacing: Spacing.md;
                                        vertical-stretch: 0;
                                        alignment: start;
                                        HudButton {
                                            label: @tr("Salva il profilo");
                                            weight: Weight.primary;
                                            clicked => {
                                                DocumentProfile.save();
                                            }
                                        }
                                    }
                                }

                                Rectangle {
                                    height: Spacing.hairline;
                                    background: Palette.line-divider;
                                    vertical-stretch: 0;
                                }

                                sez-notifiche := VerticalLayout {
                                    spacing: Spacing.xs;
                                    vertical-stretch: 0;
                                    Text {
                                        text: @tr("Impostazioni delle notifiche");
                                        color: Palette.text;
                                        font-size: Typography.screen-title;
                                        font-weight: Typography.medium;
                                    }
                                    Text {
                                        text: @tr("Quanto una notifica rivela, e quando scatta. Le scelte valgono per l'intera postazione e vengono applicate ai contenuti acquisiti durante un monitoraggio in corso. La notifica viene decisa e registrata anche quando Windows non mostra l'avviso: che cosa Windows dichiara è scritto qui sotto.");
                                        color: Palette.text-muted;
                                        font-size: Typography.body-secondary;
                                        wrap: word-wrap;
                                    }
                                }

                                // Riservatezza
                                VerticalLayout {
                                    spacing: Spacing.sm;
                                    vertical-stretch: 0;
                                    Text {
                                        text: @tr("Riservatezza");
                                        color: Palette.text;
                                        font-size: Typography.section-title;
                                        font-weight: Typography.medium;
                                    }
                                    Text {
                                        text: @tr("Completa: fonte, livello, estratto e motivazione. Ridotta: fonte e livello, senza il testo. Riservata: solo un avviso generico, senza fonte ne estratto. Su una schermata bloccata la scelta prudente nasconde.");
                                        color: Palette.text-muted;
                                        font-size: Typography.body-secondary;
                                        wrap: word-wrap;
                                    }
                                    HudSelect {
                                        model: root.settings-privacy-options;
                                        label: @tr("Riservatezza delle notifiche");
                                        current-index <=> root.settings-privacy-index;
                                    }
                                }

                                // Soglia
                                VerticalLayout {
                                    spacing: Spacing.sm;
                                    vertical-stretch: 0;
                                    Text {
                                        text: @tr("Livello minimo per notificare");
                                        color: Palette.text;
                                        font-size: Typography.section-title;
                                        font-weight: Typography.medium;
                                    }
                                    Text {
                                        // Senza l'aforisma (SIM3-12): «Notificare tutto equivale a non
                                        // notificare nulla» giustificava la soglia invece di dire che cosa fa.
                                        text: @tr("Sotto questo livello un contenuto resta nello Storico ma non produce una notifica.");
                                        color: Palette.text-muted;
                                        font-size: Typography.body-secondary;
                                        wrap: word-wrap;
                                    }
                                    HudNumber {
                                        minimum: 1;
                                        maximum: 4;
                                        label: @tr("Livello minimo per notificare, da 1 a 4");
                                        value <=> root.settings-min-level;
                                    }
                                }

                                // Tetto per sessione
                                VerticalLayout {
                                    spacing: Spacing.sm;
                                    vertical-stretch: 0;
                                    Text {
                                        text: @tr("Numero massimo di notifiche per sessione");
                                        color: Palette.text;
                                        font-size: Typography.section-title;
                                        font-weight: Typography.medium;
                                    }
                                    Text {
                                        text: @tr("Oltre questo numero le nuove segnalazioni restano nello storico ma non producono altre notifiche.");
                                        color: Palette.text-muted;
                                        font-size: Typography.body-secondary;
                                        wrap: word-wrap;
                                    }
                                    HudNumber {
                                        minimum: 0;
                                        maximum: 1000;
                                        label: @tr("Numero massimo di notifiche per sessione");
                                        value <=> root.settings-max;
                                    }
                                }

                                // URL
                                VerticalLayout {
                                    spacing: Spacing.sm;
                                    vertical-stretch: 0;
                                    HudCheck {
                                        text: @tr("Includi l'indirizzo web del contenuto nelle notifiche complete");
                                        checked <=> root.settings-include-url;
                                    }
                                    Text {
                                        text: @tr("Vale solo per la riservatezza completa: le altre modalità non mostrano l'indirizzo web in alcun caso.");
                                        color: Palette.text-muted;
                                        font-size: Typography.body-secondary;
                                        wrap: word-wrap;
                                    }
                                }

                                // AVVISI SUI GRUPPI DI SEGNALI
                                //
                                // Spenti per difetto: una capacita' nuova che si
                                // accende da sola cambia il comportamento di una
                                // postazione gia' in esercizio senza che nessuno lo
                                // abbia chiesto.
                                VerticalLayout {
                                    spacing: Spacing.sm;
                                    vertical-stretch: 0;

                                    Text {
                                        text: @tr("GRUPPI DI SEGNALI");
                                        color: Palette.text-muted;
                                        font-size: Typography.group-label;
                                        letter-spacing: Typography.track-eyebrow;
                                    }
                                    HudCheck {
                                        text: @tr("Avvisa quando più contenuti nominano lo stesso indicatore tecnico");
                                        checked <=> root.settings-cyber-enabled;
                                    }
                                    Text {
                                        text: @tr("Un gruppo si annuncia UNA VOLTA SOLA, per tutta la durata del monitoraggio. Se cresce, non produce altri avvisi: la crescita si vede in «Segnali cyber». Un avviso non dice che un attacco sia avvenuto.");
                                        color: Palette.text-muted;
                                        font-size: Typography.body-secondary;
                                        wrap: word-wrap;
                                    }

                                    // Il numero si legge con il suo nome accanto (F-33): prima
                                    // c'erano solo «3» e «2», e il nome lo sentiva solo un
                                    // lettore di schermo.
                                    HorizontalLayout {
                                        spacing: Spacing.md;
                                        vertical-stretch: 0;
                                        Text {
                                            text: @tr("Contenuti minimi perché un gruppo venga annunciato");
                                            color: Palette.text;
                                            font-size: Typography.body;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                            wrap: word-wrap;
                                        }
                                        HudNumber {
                                            minimum: 2;
                                            maximum: 100;
                                            label: @tr("Contenuti minimi perché un gruppo venga annunciato");
                                            value <=> root.settings-cyber-contents;
                                        }
                                    }
                                    // Il numero si legge con il suo nome accanto (F-33): prima
                                    // c'erano solo «3» e «2», e il nome lo sentiva solo un
                                    // lettore di schermo.
                                    HorizontalLayout {
                                        spacing: Spacing.md;
                                        vertical-stretch: 0;
                                        Text {
                                            text: @tr("Fonti distinte minime");
                                            color: Palette.text;
                                            font-size: Typography.body;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                            wrap: word-wrap;
                                        }
                                        HudNumber {
                                            minimum: 1;
                                            maximum: 100;
                                            label: @tr("Fonti distinte minime");
                                            value <=> root.settings-cyber-sources;
                                        }
                                    }
                                    // La frase che impedisce l'errore piu'
                                    // probabile su QUESTA impostazione: alzare la
                                    // soglia sulle fonti sembra alzare
                                    // l'attendibilita', e non lo fa.
                                    Text {
                                        text: @tr("Alzare la soglia sulle fonti rende più raro ciò che viene annunciato; non rende più attendibile ciò che passa. Fonti distinte non sono conferme indipendenti: possono riprendere la stessa origine.");
                                        color: Palette.text-muted;
                                        font-size: Typography.body-secondary;
                                        wrap: word-wrap;
                                    }
                                }

                                // IL SALVATAGGIO DELLE NOTIFICHE STA SOTTO LE NOTIFICHE
                                // (UX-EXCELLENCE-02, SIM3-13). Era in fondo alla pagina,
                                // dopo la conservazione, e si chiamava «Salva le
                                // impostazioni»: sembrava salvare tutto, e salvava
                                // soltanto le scelte di questo gruppo. Le altre sezioni
                                // hanno il proprio comando, con il proprio nome.
                                HorizontalLayout {
                                    vertical-stretch: 0;
                                    HudButton {
                                        label: @tr("Salva le notifiche");
                                        weight: Weight.primary;
                                        clicked => {
                                            root.save-settings();
                                        }
                                    }
                                    // Distanziatore: senza, il comando prenderebbe
                                    // l'intera larghezza della riga.
                                    Rectangle { horizontal-stretch: 1; background: transparent; }
                                }

                                // ORGANIZZAZIONI SORVEGLIATE
                                //
                                // E' la regola che fa comparire un settore su un
                                // contenuto, e la scrive una persona: il prodotto
                                // non deduce settori dal testo, perche' attribuirne
                                // uno a occhio sarebbe inventarlo (DEC-235).
                                //
                                // L'elenco non sta nel sorgente. Sta qui, e chi lo
                                // scrive risponde di averlo scritto: ogni atto e'
                                // auditato e riservato all'amministratore.
                                sez-organizzazioni := VerticalLayout {
                                    spacing: Spacing.sm;
                                    vertical-stretch: 0;

                                    Text {
                                        text: @tr("ORGANIZZAZIONI SORVEGLIATE");
                                        color: Palette.text-muted;
                                        font-size: Typography.group-label;
                                        letter-spacing: Typography.track-eyebrow;
                                    }
                                    Text {
                                        text: @tr("Dichiarare un'organizzazione e il settore in cui ricade. Da quel momento, un contenuto che la nomina porterà quel settore in «Segnali cyber», con il nome di chi l'ha dichiarata. Il prodotto non deduce il settore dal testo: senza questo elenco, nessun contenuto ne porta uno.");
                                        color: Palette.text-muted;
                                        font-size: Typography.body-secondary;
                                        wrap: word-wrap;
                                    }
                                    // Il settore NON alza la gravita'. E' la
                                    // confusione piu' probabile su questa
                                    // schermata, e va impedita qui invece che
                                    // spiegata dopo.
                                    Text {
                                        text: @tr("Ricadere in un settore che la norma considera critico non rende grave nulla: dice in quale ambito ricadrebbe il fatto, se fosse vero. Il livello 0-4 lo decidono i dizionari, e questo elenco non lo tocca.");
                                        color: Palette.text-muted;
                                        font-size: Typography.body-secondary;
                                        wrap: word-wrap;
                                    }

                                    if root.organisations-message != "": ErrorBanner {
                                        message: root.organisations-message;
                                    }

                                    // In modalita' operatore l'elenco si LEGGE ma
                                    // non si scrive: chi vede un settore su un
                                    // avviso deve poter sapere da dove viene, e
                                    // negargli l'elenco renderebbe l'attribuzione
                                    // incontestabile.
                                    if !root.organisations-writable: Text {
                                        text: @tr("Solo chi amministra la postazione può modificare questo elenco. In modalità operatore resta leggibile, perché un settore che compare su un avviso deve poter essere verificato.");
                                        color: Palette.text-muted;
                                        font-size: Typography.body-secondary;
                                        wrap: word-wrap;
                                    }

                                    if root.organisations-writable: Rectangle {
                                        // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                        min-height: rip-83.preferred-height;
                                        rip-83 := VerticalLayout {
                                            spacing: Spacing.sm;

                                            HorizontalLayout {
                                                spacing: Spacing.md;
                                                HudInput {
                                                    label: @tr("Nome dell'organizzazione");
                                                    placeholder: @tr("come la riconosce chi legge");
                                                    value <=> root.organisation-name-input;
                                                }
                                                HudSelect {
                                                    label: @tr("Settore");
                                                    model: root.organisation-sectors;
                                                    current-index <=> root.organisation-sector-index;
                                                }
                                            }
                                            HorizontalLayout {
                                                spacing: Spacing.md;
                                                HudInput {
                                                    label: @tr("Altri nomi con cui può comparire, separati da virgola");
                                                    placeholder: @tr("sigle, denominazioni abbreviate");
                                                    value <=> root.organisation-aliases-input;
                                                }
                                                HudInput {
                                                    label: @tr("Domini, separati da virgola");
                                                    placeholder: @tr("esempio.it");
                                                    value <=> root.organisation-domains-input;
                                                    accepted => {
                                                        root.organisation-declare();
                                                    }
                                                }
                                            }
                                            // Il dominio e' l'ancora piu' solida, e
                                            // vale la pena dirlo dove si digita: un
                                            // nome puo' essere ambiguo o omonimo,
                                            // mentre chi registra un dominio e' uno.
                                            Text {
                                                text: @tr("Un dominio riscontra anche nei nomi che lo contengono, come a.esempio.it per esempio.it. È l'ancora più solida: un nome può essere ambiguo o coincidere con una parola comune. Serve almeno un nome o un dominio.");
                                                color: Palette.text-muted;
                                                font-size: Typography.group-label;
                                                wrap: word-wrap;
                                            }
                                            HudButton {
                                                label: @tr("Dichiara organizzazione");
                                                enabled: root.organisation-name-input != "";
                                                clicked => {
                                                    root.organisation-declare();
                                                }
                                            }
                                        }
                                    }

                                    if root.organisations.length == 0: Text {
                                        text: @tr("Nessuna organizzazione dichiarata. «Segnali cyber» continua a funzionare: i gruppi di segnali e la rilevanza per l'Italia non dipendono da questo elenco. Solo il settore non comparirà.");
                                        color: Palette.text-muted;
                                        font-size: Typography.body-secondary;
                                        wrap: word-wrap;
                                    }

                                    LegendaOrigini {
                                        operatore: @tr("organizzazioni dichiarate");
                                    }
                                    for organisation in root.organisations: Rectangle {
                                        background: Palette.panel-raised;
                                        border-radius: Spacing.radius-row;
                                        height: riga.preferred-height + 2 * Spacing.sm;

                                        riga := VerticalLayout {
                                            padding: Spacing.sm;
                                            spacing: 2px;

                                            HorizontalLayout {
                                                spacing: Spacing.md;

                                                Text {
                                                    text: organisation.name;
                                                    // Una dichiarazione sospesa si
                                                    // legge come sospesa: mostrarla
                                                    // uguale alle attive farebbe
                                                    // credere che produca riscontri.
                                                    color: organisation.active
                                                        ? Palette.text
                                                        : Palette.text-disabled;
                                                    font-size: Typography.body;
                                                    font-weight: Typography.medium;
                                                    horizontal-stretch: 1;
                                                }
                                                Text {
                                                    text: organisation.sector;
                                                    color: Palette.text-muted;
                                                    font-size: Typography.body-secondary;
                                                    vertical-alignment: center;
                                                }
                                                if root.organisations-writable: HudButton {
                                                    label: organisation.active ? @tr("Sospendi") : @tr("Riattiva");
                                                    clicked => {
                                                        root.organisation-toggle(
                                                            organisation.id,
                                                            !organisation.active
                                                        );
                                                    }
                                                }
                                                // Togliere è definitivo e chiede il
                                                // motivo; sospendere no (FR-048).
                                                if root.organisations-writable
                                                    && root.organisation-removing != organisation.id: HudButton {
                                                    label: @tr("Togli");
                                                    clicked => {
                                                        root.organisation-remove-reason = "";
                                                        root.organisation-removing = organisation.id;
                                                    }
                                                }
                                            }
                                            Text {
                                                text: organisation.anchors;
                                                color: Palette.text-muted;
                                                font-size: Typography.technical;
                                                wrap: word-wrap;
                                            }
                                            Text {
                                                text: organisation.declared;
                                                color: Palette.text-disabled;
                                                font-size: Typography.group-label;
                                                wrap: word-wrap;
                                            }
                                            if root.organisations-writable
                                                && root.organisation-removing == organisation.id: Rectangle {
                                                // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                                min-height: rip-84.preferred-height;
                                                rip-84 := VerticalLayout {
                                                    spacing: Spacing.sm;
                                                    Text {
                                                        text: @tr("Togliere l'organizzazione è definitivo: non produce più riscontri e non si riattiva. Il motivo resta nel registro delle operazioni. Per fermarla soltanto, basta sospenderla.");
                                                        color: Palette.text;
                                                        font-size: Typography.body-secondary;
                                                        wrap: word-wrap;
                                                    }
                                                    HorizontalLayout {
                                                        spacing: Spacing.md;
                                                        HudInput {
                                                            label: @tr("Motivo");
                                                            placeholder: @tr("perché si toglie");
                                                            value <=> root.organisation-remove-reason;
                                                        }
                                                        HudButton {
                                                            label: @tr("Togli definitivamente");
                                                            enabled: root.organisation-remove-reason != "";
                                                            clicked => {
                                                                root.organisation-remove(
                                                                    organisation.id,
                                                                    root.organisation-remove-reason
                                                                );
                                                            }
                                                        }
                                                        HudButton {
                                                            label: @tr("Annulla");
                                                            clicked => {
                                                                root.organisation-removing = 0;
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }

                                // Aspetto della postazione.
                                //
                                // E' un UNICO interruttore per tutte le animazioni
                                // decorative - il radar e la comparsa graduale delle
                                // schermate - e non uno per ciascuna: chi le trova
                                // fastidiose le vuole spegnere tutte, e cercarle una
                                // per una in un elenco di opzioni e' il modo in cui
                                // una preferenza resta non usata.
                                //
                                // L'elenco si e' accorciato con il sistema grafico
                                // approvato: la scanline e il lampeggio del marchio
                                // sono usciti (DEC-136, DEC-132), perche' il
                                // riferimento vieta scanline e lampeggio e ammette
                                // una sola animazione in ciclo.
                                //
                                // Non passa dall'archivio come le impostazioni delle
                                // notifiche: e' una preferenza di resa della postazione,
                                // vale per la sessione in corso, e non ha effetto su
                                // nulla che venga acquisito, analizzato o registrato.
                                sez-aspetto := VerticalLayout {
                                    spacing: Spacing.sm;
                                    vertical-stretch: 0;

                                    Text {
                                        text: @tr("ASPETTO");
                                        color: Palette.text-muted;
                                        font-family: Typography.mono;
                                        font-size: Typography.eyebrow;
                                        font-weight: Typography.regular;
                                        letter-spacing: Typography.track-eyebrow;
                                    }

                                    HudSelect {
                                        label: @tr("Movimento dell'interfaccia");
                                        model: root.motion-options;
                                        current-index <=> root.motion-index;
                                        selected => {
                                            root.motion-chosen(self.current-index);
                                        }
                                    }

                                    Text {
                                        text: root.motion-consequence;
                                        color: Palette.text-muted;
                                        font-size: Typography.body-secondary;
                                        wrap: word-wrap;
                                    }

                                    // Che cosa Windows preferisce, dichiarato
                                    // accanto alla scelta: chi ha gia' chiesto
                                    // la riduzione al sistema deve vedere che il
                                    // prodotto lo sa.
                                    if root.motion-system-message != "": Text {
                                        text: root.motion-system-message;
                                        color: Palette.text-muted;
                                        font-size: Typography.body-secondary;
                                        wrap: word-wrap;
                                    }

                                    Text {
                                        text: @tr("Il movimento ridotto spegne il radar e la comparsa graduale delle schermate. Le risposte visive ai comandi restano: non sono decorazione, dicono che il comando è stato ricevuto.");
                                        color: Palette.text-muted;
                                        font-size: Typography.body-secondary;
                                        wrap: word-wrap;
                                    }

                                    // LA LINGUA DELL'INTERFACCIA (I18N-01, ADR-0197).
                                    // Per postazione, conservata in archivio. I nomi
                                    // delle lingue sono scritti nella lingua stessa:
                                    // chi non legge l'italiano riconosce la propria.
                                    HudSelect {
                                        label: @tr("Lingua dell'interfaccia");
                                        model: root.language-options;
                                        current-index <=> root.language-index;
                                        selected => {
                                            root.language-chosen(self.current-index);
                                        }
                                    }

                                    Text {
                                        text: root.language-consequence;
                                        color: Palette.text-muted;
                                        font-size: Typography.body-secondary;
                                        wrap: word-wrap;
                                    }
                                }

                                // Blocco della postazione.
                                //
                                // La parola vale per l'**account attivo**, non per la
                                // postazione: due operatori che condividono il computer
                                // non condividono la parola. Come l'avvio automatico,
                                // non passa dal pulsante di salvataggio — vive in un
                                // file protetto proprio — e ha la propria riga di esito.
                                sez-blocco := VerticalLayout {
                                    spacing: Spacing.sm;
                                    vertical-stretch: 0;

                                    Text {
                                        text: @tr("BLOCCO DELLA POSTAZIONE");
                                        color: Palette.text-muted;
                                        font-family: Typography.mono;
                                        font-size: Typography.eyebrow;
                                        font-weight: Typography.regular;
                                        letter-spacing: Typography.track-eyebrow;
                                    }

                                    Text {
                                        // Senza account attivo lo si dice (CA02-07).
                                        text: !root.lock-has-account ? @tr("Nessun account attivo: la parola di sblocco si fissa dopo l'accesso, in Account.") : root.lock-protected ? @tr("L'account attivo ha una parola di sblocco. Il comando «Blocca la postazione» è in fondo al menu.") : @tr("L'account attivo non ha una parola di sblocco: la postazione non si può bloccare.");
                                        color: Palette.text-muted;
                                        font-size: Typography.body-secondary;
                                        wrap: word-wrap;
                                    }

                                    HorizontalLayout {
                                        spacing: Spacing.md;
                                        vertical-stretch: 0;

                                        Rectangle {
                                            height: 40px;
                                            vertical-stretch: 0;
                                            horizontal-stretch: 1;
                                            HudInput {
                                                placeholder: @tr("Nuova parola di sblocco");
                                                masked: true;
                                                label: @tr("Nuova parola di sblocco per l'account attivo");
                                                value <=> root.lock-new-word;
                                            }
                                        }

                                        HudButton {
                                            label: root.lock-protected ? @tr("Sostituisci") : @tr("Imposta");
                                            clicked => {
                                                root.protect-account();
                                            }
                                        }

                                        // Togliere la protezione **non** richiede di
                                        // conoscere la parola: se la richiedesse, una
                                        // parola dimenticata renderebbe l'account
                                        // inutilizzabile per sempre. E' l'azione
                                        // dell'amministratore, e resta nell'audit.
                                        if root.lock-protected && root.administrator-mode: HudButton {
                                            label: @tr("Togli la protezione");
                                            clicked => {
                                                root.unprotect-account();
                                            }
                                        }
                                    }
                                    // L'esito sta sotto il campo, non in fondo al
                                    // gruppo: una parola rifiutata perche' corta si
                                    // leggeva dopo il testo del blocco automatico,
                                    // in grigio, e sembrava che non fosse successo
                                    // nulla (F-11).
                                    if root.lock-settings-message != "": Text {
                                        text: root.lock-settings-message;
                                        color: root.lock-settings-failed ? Palette.amber : Palette.text;
                                        font-size: Typography.body-secondary;
                                        wrap: word-wrap;
                                    }

                                    HorizontalLayout {
                                        spacing: Spacing.md;
                                        vertical-stretch: 0;

                                        Text {
                                            text: @tr("Blocco automatico dopo (minuti)");
                                            color: Palette.text;
                                            font-size: Typography.body;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                        }
                                        HudNumber {
                                            minimum: 1;
                                            maximum: 480;
                                            label: @tr("Minuti di inattività prima del blocco automatico");
                                            value <=> root.lock-minutes;
                                        }
                                        HudButton {
                                            // Che cosa applica, nel nome (SIM3-13).
                                            label: @tr("Salva i minuti");
                                            clicked => {
                                                root.save-lock-minutes();
                                            }
                                        }
                                    }

                                    Text {
                                        text: @tr("Nessuno si ricorda di bloccare uscendo: è il blocco automatico a proteggere davvero una postazione condivisa. Il monitoraggio continua mentre è bloccata.");
                                        color: Palette.text-muted;
                                        font-size: Typography.body-secondary;
                                        wrap: word-wrap;
                                    }

                                }

                                // Avvio automatico.
                                //
                                // Non passa da «Salva le impostazioni» e la schermata lo
                                // dice: il suo stato **vive nel registro di Windows**,
                                // non in archivio, e conservarne una seconda copia
                                // significherebbe due verita' che divergono appena
                                // qualcuno tocca il registro da fuori. La spunta agisce
                                // quando viene premuta, ed e' la ragione per cui sta in
                                // un gruppo suo con la propria riga di esito.
                                // ------------- che cosa Windows dice degli avvisi
                                //
                                // Sta QUI, sotto le impostazioni delle
                                // notifiche, e non in una schermata di
                                // diagnostica: chi ha appena scelto come
                                // vuole essere avvisato deve sapere subito se
                                // Windows lo permette.
                                VerticalLayout {
                                    spacing: Spacing.sm;
                                    vertical-stretch: 0;

                                    Text {
                                        text: @tr("CONSENSO DI WINDOWS");
                                        color: Palette.text-muted;
                                        font-family: Typography.mono;
                                        font-size: Typography.eyebrow;
                                        font-weight: Typography.regular;
                                        letter-spacing: Typography.track-eyebrow;
                                    }

                                    Text {
                                        text: root.toast-state-message;
                                        color: root.toast-state-enabled
                                            ? Palette.text-muted
                                            : Palette.amber;
                                        font-size: Typography.body-secondary;
                                        wrap: word-wrap;
                                    }
                                }

                                sez-avvio := VerticalLayout {
                                    spacing: Spacing.sm;
                                    vertical-stretch: 0;

                                    Text {
                                        text: @tr("AVVIO AUTOMATICO");
                                        color: Palette.text-muted;
                                        font-family: Typography.mono;
                                        font-size: Typography.eyebrow;
                                        font-weight: Typography.regular;
                                        letter-spacing: Typography.track-eyebrow;
                                    }

                                    HudCheck {
                                        text: @tr("Avvia all'accesso a Windows");
                                        checked: root.autostart-registered;
                                        toggled => {
                                            root.set-autostart(self.checked);
                                        }
                                    }

                                    Text {
                                        text: @tr("Ha effetto subito e non passa dal pulsante di salvataggio: lo stato vive nel registro di Windows, non in archivio. Vale per questo profilo Windows soltanto.");
                                        color: Palette.text-muted;
                                        font-size: Typography.body-secondary;
                                        wrap: word-wrap;
                                    }

                                    Text {
                                        text: root.autostart-message;
                                        color: root.autostart-registered && !root.autostart-effective
                                            ? Palette.amber
                                            : Palette.text-muted;
                                        font-size: Typography.body-secondary;
                                        wrap: word-wrap;
                                    }
                                }

                                // ------------ il monitoraggio con Windows chiuso
                                //
                                // SERVICE-01, ADR-0203. Facoltativo e spento:
                                // lo si attiva dalla casella del Setup o da
                                // qui. Come l'avvio automatico, lo stato vive
                                // in Windows e si rilegge a ogni apertura.
                                sez-servizio := VerticalLayout {
                                    spacing: Spacing.sm;
                                    vertical-stretch: 0;

                                    Text {
                                        text: @tr("MONITORAGGIO CON WINDOWS CHIUSO");
                                        color: Palette.text-muted;
                                        font-family: Typography.mono;
                                        font-size: Typography.eyebrow;
                                        font-weight: Typography.regular;
                                        letter-spacing: Typography.track-eyebrow;
                                    }

                                    Text {
                                        text: @tr("Facoltativo. Un servizio di Windows continua il monitoraggio quando si esce da Windows, con lo stesso utente e gli account già collegati. Quando si rientra, lo riprende il programma.");
                                        color: Palette.text-muted;
                                        font-size: Typography.body-secondary;
                                        wrap: word-wrap;
                                    }

                                    Text {
                                        text: @tr("Servono i permessi dell'amministratore e la password di Windows di questo utente: la conserva Windows, non il programma. Dopo un riavvio del PC il monitoraggio non riparte da solo.");
                                        color: Palette.text-muted;
                                        font-size: Typography.body-secondary;
                                        wrap: word-wrap;
                                    }

                                    Text {
                                        text: root.background-service-state;
                                        color: Palette.text;
                                        font-size: Typography.body-secondary;
                                        wrap: word-wrap;
                                    }

                                    HorizontalLayout {
                                        spacing: Spacing.sm;
                                        vertical-stretch: 0;
                                        alignment: start;
                                        HudButton {
                                            label: @tr("Attiva o scrivi di nuovo la password");
                                            clicked => {
                                                root.background-service-install();
                                            }
                                        }
                                        HudButton {
                                            label: @tr("Togli il servizio");
                                            clicked => {
                                                root.background-service-remove();
                                            }
                                        }
                                    }

                                    if root.background-service-message != "": Text {
                                        text: root.background-service-message;
                                        color: Palette.text-muted;
                                        font-size: Typography.body-secondary;
                                        wrap: word-wrap;
                                    }

                                    Text {
                                        text: @tr("Ultimi passaggi di mano");
                                        color: Palette.text;
                                        font-size: Typography.body;
                                    }

                                    Text {
                                        text: root.background-service-handovers;
                                        color: Palette.text-muted;
                                        font-size: Typography.body-secondary;
                                        wrap: word-wrap;
                                    }
                                }

                                // ------------------ fascicolo condivisibile
                                //
                                // Due postazioni dello stesso ufficio si
                                // allineano con un file, non con un archivio
                                // condiviso: un archivio condiviso cancella
                                // l'autore di cio' che contiene (ADR-0038).
                                sez-condivisa := VerticalLayout {
                                    spacing: Spacing.sm;
                                    vertical-stretch: 0;

                                    Text {
                                        text: @tr("CONFIGURAZIONE CONDIVISA");
                                        color: Palette.text-muted;
                                        font-family: Typography.mono;
                                        font-size: Typography.eyebrow;
                                        font-weight: Typography.regular;
                                        letter-spacing: Typography.track-eyebrow;
                                    }

                                    Text {
                                        // Il nome del computer va nella provenienza del fascicolo, e la
                                        // schermata non lo diceva (F-34).
                                        text: @tr("Viaggiano le fonti e il profilo documentale. Non viaggiano i contenuti acquisiti, i documenti prodotti, le credenziali o la sessione Telegram. Il fascicolo porta il nome di questo computer, per dire da dove viene.");
                                        color: Palette.text-muted;
                                        font-size: Typography.body-secondary;
                                        wrap: word-wrap;
                                    }

                                    // IN ESERCITAZIONE IL FASCICOLO NON VIAGGIA
                                    // (PR-13, ADR-0129): i due comandi non erano
                                    // collegati e non facevano niente
                                    // (FINAL-FPR-ALL-16, FPR-01).
                                    //
                                    // Qui si spengono invece di sparire, e la
                                    // differenza e' voluta: questa e' una
                                    // sezione di una schermata che funziona, e
                                    // togliere i comandi farebbe credere che la
                                    // funzione non esista.
                                    if root.exercise-mode: Text {
                                        text: @tr("In Esercitazione la configurazione non si esporta e non si importa. Un fascicolo fra l'esercitazione e il lavoro vero sarebbe uno scambio di dati. Si prova su una postazione reale.");
                                        color: Palette.text-muted;
                                        font-size: Typography.body-secondary;
                                        wrap: word-wrap;
                                    }

                                    HorizontalLayout {
                                        spacing: Spacing.sm;
                                        vertical-stretch: 0;

                                        HudButton {
                                            label: @tr("Esporta la configurazione");
                                            enabled: !root.exercise-mode;
                                            reason: root.exercise-mode ? @tr("In Esercitazione la configurazione non si esporta.") : "";
                                            clicked => {
                                                root.export-fascicolo();
                                            }
                                        }
                                        HudButton {
                                            label: @tr("Scegli un fascicolo...");
                                            enabled: !root.exercise-mode;
                                            reason: root.exercise-mode ? @tr("In Esercitazione la configurazione non si importa.") : "";
                                            clicked => {
                                                root.choose-fascicolo();
                                            }
                                        }
                                        Rectangle { horizontal-stretch: 1; background: transparent; }
                                    }

                                    if root.team-path != "": Text {
                                        text: root.team-path;
                                        color: Palette.text-muted;
                                        font-size: Typography.body-secondary;
                                        wrap: word-wrap;
                                    }

                                    // L'anteprima viene PRIMA del comando che
                                    // importa: una modifica che non si puo'
                                    // prevedere si scopre troppo tardi.
                                    if root.team-preview != "": Text {
                                        text: root.team-preview;
                                        color: Palette.amber;
                                        font-size: Typography.body-secondary;
                                        wrap: word-wrap;
                                    }

                                    if root.team-can-import: Rectangle {
                                        // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                        min-height: rip-85.preferred-height;
                                        rip-85 := HorizontalLayout {
                                            spacing: Spacing.sm;
                                            vertical-stretch: 0;
                                            HudButton {
                                                label: @tr("Importa questo fascicolo");
                                                weight: Weight.primary;
                                                clicked => {
                                                    root.import-fascicolo();
                                                }
                                            }
                                            Rectangle { horizontal-stretch: 1; background: transparent; }
                                        }
                                    }

                                    if root.team-message != "": InfoBanner {
                                        message: root.team-message;
                                    }
                                }

                                // ----------------------- origine del programma
                                //
                                // Un amministratore che trova un programma di
                                // monitoraggio su una postazione vuole sapere
                                // se e' la copia originale.
                                VerticalLayout {
                                    spacing: Spacing.sm;
                                    vertical-stretch: 0;

                                    Text {
                                        text: @tr("ORIGINE DEL PROGRAMMA");
                                        color: Palette.text-muted;
                                        font-family: Typography.mono;
                                        font-size: Typography.eyebrow;
                                        font-weight: Typography.regular;
                                        letter-spacing: Typography.track-eyebrow;
                                    }

                                    Text {
                                        text: root.signature-message;
                                        color: root.signature-trusted
                                            ? Palette.text-muted
                                            : Palette.amber;
                                        font-size: Typography.body-secondary;
                                        wrap: word-wrap;
                                    }
                                }

                                // ----------------------------- aggiornamenti
                                //
                                // Sta subito dopo l'origine del programma
                                // perche' rispondono a due meta' della stessa
                                // domanda: «questa copia e' l'originale?» e
                                // «questa copia e' quella giusta?».
                                //
                                // Il prodotto NON controlla da se', NON scarica
                                // e NON installa. Non e' una funzione mancante:
                                // e' ADR-0037, e la schermata lo dichiara
                                // invece di lasciarlo intuire da un pulsante
                                // che non c'e'.
                                sez-aggiornamenti := VerticalLayout {
                                    spacing: Spacing.sm;
                                    vertical-stretch: 0;

                                    Text {
                                        text: @tr("AGGIORNAMENTI");
                                        color: Palette.text-muted;
                                        font-family: Typography.mono;
                                        font-size: Typography.eyebrow;
                                        font-weight: Typography.regular;
                                        letter-spacing: Typography.track-eyebrow;
                                    }

                                    if root.update-station != "": Text {
                                        text: root.update-station;
                                        color: Palette.text-muted;
                                        font-size: Typography.body-secondary;
                                        wrap: word-wrap;
                                    }

                                    // UNA CONSEGNA CHE NON HA PRODOTTO
                                    // UN'INSTALLAZIONE. Ambra: chiede
                                    // attenzione, e non e' un guasto del
                                    // programma.
                                    if root.update-delivery-notice != "": Text {
                                        text: root.update-delivery-notice;
                                        color: Palette.amber;
                                        font-size: Typography.body-secondary;
                                        wrap: word-wrap;
                                    }

                                    // DOVE SI E', E QUAL E' IL PASSO DOPO.
                                    if root.update-step-sentence != "": Text {
                                        text: root.update-step-sentence;
                                        color: Palette.text;
                                        font-size: Typography.body-secondary;
                                        wrap: word-wrap;
                                    }

                                    if root.update-step-command != "": Rectangle {
                                        // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                        min-height: rip-86.preferred-height;
                                        rip-86 := HorizontalLayout {
                                            spacing: Spacing.sm;
                                            vertical-stretch: 0;

                                            HudButton {
                                                label: root.update-step-command;
                                                clicked => {
                                                    root.update-step-forward();
                                                }
                                            }

                                            // Cio' che e' sceso si puo' togliere, e
                                            // il comando si chiama con il suo nome:
                                            // «annulla» non direbbe che cosa sparisce.
                                            if root.update-has-staged: HudButton {
                                                label: @tr("Installa ora e chiudi");
                                                clicked => {
                                                    root.hand-off-update();
                                                }
                                            }

                                            if root.update-has-staged: HudButton {
                                                label: @tr("Togli il file scaricato");
                                                clicked => {
                                                    root.discard-staged();
                                                }
                                            }
                                            Rectangle { horizontal-stretch: 1; background: transparent; }
                                        }
                                    }

                                    // CHE COSA SUCCEDE PREMENDO, DETTO PRIMA.
                                    // Il programma si chiude: scoprirlo dopo
                                    // significa aver perso di vista che cosa si
                                    // stava facendo.
                                    if root.update-hand-off-note != "": Text {
                                        text: root.update-hand-off-note;
                                        color: Palette.text-muted;
                                        font-size: Typography.body-secondary;
                                        wrap: word-wrap;
                                    }

                                    if root.update-step-inaction != "": Text {
                                        text: root.update-step-inaction;
                                        color: Palette.text-muted;
                                        font-size: Typography.body-secondary;
                                        wrap: word-wrap;
                                    }

                                    Text {
                                        text: @tr("Il programma non cerca aggiornamenti da solo e non si sostituisce da sé. Contatta l'indirizzo qui sotto solo quando qualcuno lo chiede. Nessun contenuto dell'archivio esce verso Internet. Se l'ufficio ha ricevuto un aggiornamento, qui si può esaminare il file che lo descrive. L'esame dice se sarebbe adatto a questa postazione.");
                                        color: Palette.text-muted;
                                        font-size: Typography.body-secondary;
                                        wrap: word-wrap;
                                    }

                                    // Il canale. Non e' un livello di
                                    // fiducia: e' QUANDO questa postazione
                                    // riceve (ADR-0066).
                                    HudSelect {
                                        label: @tr("Canale di questa postazione");
                                        description: root.update-channel-settable ? @tr("Il pilota è lo stesso programma, firmato allo stesso modo, ricevuto prima.") : @tr("La scelta del canale è riservata alla modalità amministratore.");
                                        model: root.update-channel-options;
                                        current-index <=> root.update-channel-index;
                                        enabled: root.update-channel-settable;
                                        selected => {
                                            root.choose-update-channel(self.current-index);
                                        }
                                    }

                                    if root.update-channel-note != "": Text {
                                        text: root.update-channel-note;
                                        color: Palette.text-muted;
                                        font-size: Typography.body-secondary;
                                        wrap: word-wrap;
                                    }

                                    // L'origine. E' l'unica destinazione che
                                    // questo programma puo' raggiungere.
                                    TextField {
                                        label: @tr("Origine da cui scaricare l'informazione sugli aggiornamenti");
                                        placeholder: @tr("https://...");
                                        enabled: root.update-channel-settable;
                                        value <=> root.update-origin;
                                        edited => { }
                                    }

                                    if root.update-origin-note != "": Text {
                                        text: root.update-origin-note;
                                        color: Palette.text-muted;
                                        font-size: Typography.body-secondary;
                                        wrap: word-wrap;
                                    }

                                    // I FIRMATARI DEGLI AGGIORNAMENTI (UPDATE-SIGN-01,
                                    // ADR-0183): senza un firmatario ammesso nessuna
                                    // informazione sugli aggiornamenti si accetta. Li
                                    // ammette e li ritira l'amministratore; un ritirato
                                    // resta nell'elenco.
                                    Text {
                                        text: root.update-signers;
                                        color: Palette.text-muted;
                                        font-size: Typography.body-secondary;
                                        wrap: word-wrap;
                                    }

                                    HorizontalLayout {
                                        spacing: Spacing.md;
                                        vertical-stretch: 0;

                                        if root.update-channel-settable: TextField {
                                            label: @tr("Impronta del certificato di chi firma gli aggiornamenti");
                                            placeholder: @tr("64 cifre e lettere, anche con i due punti");
                                            horizontal-stretch: 2;
                                            value <=> root.update-signer-fingerprint;
                                            edited => { }
                                        }
                                        if root.update-channel-settable: TextField {
                                            label: @tr("Nome del firmatario");
                                            placeholder: @tr("per esempio: produttore, chiave 2026");
                                            horizontal-stretch: 1;
                                            value <=> root.update-signer-name;
                                            edited => { }
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: Spacing.sm;
                                        vertical-stretch: 0;

                                        if root.update-channel-settable: HudButton {
                                            label: @tr("Ammetti il firmatario");
                                            clicked => {
                                                root.admit-update-signer();
                                            }
                                        }
                                        if root.update-channel-settable: HudButton {
                                            label: @tr("Ritira il firmatario");
                                            clicked => {
                                                root.retire-update-signer();
                                            }
                                        }
                                        Rectangle { horizontal-stretch: 1; background: transparent; }
                                    }

                                    if root.update-signer-note != "": Text {
                                        text: root.update-signer-note;
                                        color: Palette.text-muted;
                                        font-size: Typography.body-secondary;
                                        wrap: word-wrap;
                                    }

                                    HorizontalLayout {
                                        spacing: Spacing.sm;
                                        vertical-stretch: 0;

                                        if root.update-channel-settable: HudButton {
                                            label: @tr("Salva l'origine");
                                            clicked => {
                                                root.save-update-origin(root.update-origin);
                                            }
                                        }

                                        HudButton {
                                            label: @tr("Scarica l'informazione");
                                            clicked => {
                                                root.fetch-update();
                                            }
                                        }

                                        HudButton {
                                            label: @tr("Esamina un aggiornamento...");
                                            clicked => {
                                                root.review-update();
                                            }
                                        }

                                        HudButton {
                                            label: @tr("Scarica il file");
                                            clicked => {
                                                root.download-artifact();
                                            }
                                        }

                                        HudButton {
                                            label: @tr("Verifica il file");
                                            clicked => {
                                                root.verify-artifact();
                                            }
                                        }
                                        Rectangle { horizontal-stretch: 1; background: transparent; }
                                    }

                                    // Che cosa lo scaricamento NON fa. Sta qui e
                                    // non in fondo perche' chi preme deve saperlo
                                    // prima, non dopo.
                                    AvvertenzaDiSicurezza {
                                        codice: "SIC-06";
                                        testo: @tr("Scaricare il file non lo verifica e non lo installa. «Verifica il file» controlla due cose. La prima: che il file sia arrivato intero. La seconda: che sia firmato da qualcuno che questa postazione riconosce. Solo la seconda dice di chi ci si sta fidando. Nemmeno un file verificato si installa da solo: il programma non si sostituisce a sé stesso.");
                                        dettaglio: @tr("La prima verifica confronta l'impronta SHA-256 con quella dichiarata dall'informazione sull'aggiornamento: dimostra il trasporto, perché quell'informazione non è fidata. La seconda è la firma Authenticode, verificata da Windows.");
                                    }

                                    if root.update-message != "": Text {
                                        text: root.update-message;
                                        color: root.update-refused ? Palette.amber : Palette.text-muted;
                                        font-size: Typography.body-secondary;
                                        wrap: word-wrap;
                                    }

                                    // L'installazione resta un gesto di chi
                                    // amministra: un programma che si
                                    // sostituisse da solo cambierebbe, senza
                                    // che nessuno lo abbia deciso, lo strumento
                                    // con cui si stanno producendo atti.
                                    // PERCHE' NON C'E' UN COMANDO CHE INSTALLA.
                                    // La frase viene dal servizio: il giorno in
                                    // cui l'installazione esistera', sparira'
                                    // insieme all'arrivo del comando — non
                                    // restera' accanto a esso.
                                    Text {
                                        text: root.update-why-no-install;
                                        color: Palette.text-muted;
                                        font-size: Typography.body-secondary;
                                        wrap: word-wrap;
                                    }
                                }

                                // ------------------ idoneita' della postazione
                                //
                                // Non e' una schermata di diagnostica per
                                // sviluppatori: le voci sono scritte per chi
                                // deve decidere se la postazione e' idonea.
                                VerticalLayout {
                                    spacing: Spacing.sm;
                                    vertical-stretch: 0;

                                    Text {
                                        text: @tr("IDONEITÀ DELLA POSTAZIONE");
                                        color: Palette.text-muted;
                                        font-family: Typography.mono;
                                        font-size: Typography.eyebrow;
                                        font-weight: Typography.regular;
                                        letter-spacing: Typography.track-eyebrow;
                                    }

                                    Text {
                                        text: root.station-verdict;
                                        color: root.station-fit ? Palette.text-muted : Palette.amber;
                                        font-size: Typography.body-secondary;
                                        wrap: word-wrap;
                                    }

                                    LegendaOrigini {
                                        calcolato: @tr("stato e dettaglio");
                                    }
                                    for capacita in root.station-capabilities: Rectangle {
                                        // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                        min-height: rip-87.preferred-height;
                                        rip-87 := VerticalLayout {
                                            spacing: 2px;
                                            vertical-stretch: 0;

                                            HorizontalLayout {
                                                spacing: Spacing.sm;
                                                vertical-stretch: 0;

                                                Text {
                                                    text: capacita.name;
                                                    color: Palette.text;
                                                    font-size: Typography.body-secondary;
                                                    horizontal-stretch: 1;
                                                }
                                                // Lo stato e' SCRITTO oltre che
                                                // colorato: il colore da solo non
                                                // basta a chi non lo distingue.
                                                Text {
                                                    text: capacita.status + " \u{00b7} " + capacita.requirement;
                                                    color: capacita.blocking
                                                        ? Palette.amber
                                                        : (capacita.usable ? Palette.text-muted : Palette.text-muted);
                                                    font-family: Typography.mono;
                                                    font-size: Typography.body-secondary;
                                                    horizontal-stretch: 0;
                                                }
                                            }

                                            Text {
                                                text: capacita.detail;
                                                color: Palette.text-muted;
                                                font-size: Typography.body-secondary;
                                                wrap: word-wrap;
                                            }
                                        }
                                    }
                                }

                                // --------------------------- stato dell'archivio
                                //
                                // Un archivio SQLite si danneggia in modi che
                                // non impediscono di aprirlo: una caduta di
                                // corrente durante una scrittura, un settore
                                // che sta morendo, un backup che copia il file
                                // mentre viene scritto.
                                //
                                // Il prodotto continua a partire e il guasto si
                                // manifesta molto piu' tardi — come un record
                                // che non c'e' piu' e nessuno se ne accorge.
                                //
                                // La verifica non si esegue a ogni avvio: legge
                                // l'intero file, e un controllo che rallenta
                                // ogni avvio e' un controllo che qualcuno prima
                                // o poi spegne.
                                sez-archivio := VerticalLayout {
                                    spacing: Spacing.sm;
                                    vertical-stretch: 0;

                                    Text {
                                        text: @tr("STATO DELL'ARCHIVIO");
                                        color: Palette.text-muted;
                                        font-family: Typography.mono;
                                        font-size: Typography.eyebrow;
                                        font-weight: Typography.regular;
                                        letter-spacing: Typography.track-eyebrow;
                                    }

                                    if root.archive-size != "": Text {
                                        text: root.archive-size;
                                        color: Palette.text-muted;
                                        font-size: Typography.body-secondary;
                                        wrap: word-wrap;
                                    }

                                    HorizontalLayout {
                                        spacing: Spacing.sm;
                                        vertical-stretch: 0;

                                        HudButton {
                                            label: @tr("Verifica l'archivio");
                                            clicked => {
                                                root.verify-archive();
                                            }
                                        }
                                        Rectangle { horizontal-stretch: 1; background: transparent; }
                                    }

                                    // Il colore si vede a colpo d'occhio, il
                                    // messaggio si legge: dicono due cose
                                    // diverse e servono entrambe.
                                    if root.archive-checked: Text {
                                        text: root.archive-message;
                                        color: root.archive-damaged ? Palette.amber : Palette.text-muted;
                                        font-size: Typography.body-secondary;
                                        wrap: word-wrap;
                                    }

                                    if !root.archive-checked: Text {
                                        text: @tr("Il controllo legge l'intero archivio e può richiedere qualche istante. Non modifica nulla.");
                                        color: Palette.text-muted;
                                        font-size: Typography.body-secondary;
                                        wrap: word-wrap;
                                    }
                                }

                                // --------------------- copia di sicurezza
                                //
                                // Sta subito dopo la verifica dell'archivio
                                // perche' e' la stessa domanda vista da due
                                // lati: «l'archivio sta bene?» e «se domani
                                // non ci fosse piu'?».
                                //
                                // L'avvertenza su cio' che la copia NON salva
                                // sta in schermata SEMPRE, non nel messaggio di
                                // esito. Chi la legge dopo un guasto la legge
                                // troppo tardi, e un ufficio che si credesse
                                // coperto lo scoprirebbe il giorno peggiore.
                                sez-copia := VerticalLayout {
                                    spacing: Spacing.sm;
                                    vertical-stretch: 0;

                                    Text {
                                        text: @tr("COPIA DI SICUREZZA");
                                        color: Palette.text-muted;
                                        font-family: Typography.mono;
                                        font-size: Typography.eyebrow;
                                        font-weight: Typography.regular;
                                        letter-spacing: Typography.track-eyebrow;
                                    }

                                    Text {
                                        text: @tr("La copia contiene tutto l'archivio: monitoraggi, contenuti, riscontri, avvisi e registro delle operazioni. NON contiene le credenziali dell'account Telegram, che restano legate a questa postazione e non si possono spostare. Su un computer nuovo l'accesso va rifatto da capo: la copia rimette l'archivio, non l'accesso.");
                                        color: Palette.text-muted;
                                        font-size: Typography.body-secondary;
                                        wrap: word-wrap;
                                    }

                                    // CHI PUO' APRIRLA (SEC-01, ADR-0157),
                                    // detto PRIMA del clic: la copia nasce del
                                    // solo utente, e dove non si puo' non si
                                    // scrive. Dopo, l'esito lo ripete.
                                    Text {
                                        text: @tr("La copia nasce leggibile dal solo utente Windows che la scrive. Dove i permessi non si possono restringere, come su alcune chiavette e alcune cartelle di rete, la copia non si scrive. I permessi non viaggiano: copiata altrove, la copia prende quelli del posto in cui arriva.");
                                        color: Palette.text-muted;
                                        font-size: Typography.body-secondary;
                                        wrap: word-wrap;
                                    }

                                    HorizontalLayout {
                                        spacing: Spacing.sm;
                                        vertical-stretch: 0;

                                        HudButton {
                                            label: @tr("Scrivi una copia...");
                                            clicked => {
                                                root.make-backup();
                                            }
                                        }
                                        Rectangle { horizontal-stretch: 1; background: transparent; }
                                    }

                                    if root.backup-message != "": Text {
                                        text: root.backup-message;
                                        color: root.backup-failed ? Palette.amber : Palette.text-muted;
                                        font-size: Typography.body-secondary;
                                        wrap: word-wrap;
                                    }

                                    // LE COPIE PIANIFICATE (BACKUP-SCHEDULE-01,
                                    // ADR-0191): con le stesse regole della copia
                                    // a mano. Un fallimento resta nella fascia di
                                    // prontezza finché una copia non riesce.
                                    Text {
                                        text: @tr("Copie pianificate");
                                        color: Palette.text;
                                        font-size: Typography.body;
                                    }
                                    Text {
                                        text: root.backup-schedule-state;
                                        color: Palette.text-muted;
                                        font-size: Typography.body-secondary;
                                        wrap: word-wrap;
                                    }
                                    if root.backup-schedule-administrator: Rectangle {
                                        // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                        min-height: rip-200.preferred-height;
                                        rip-200 := HorizontalLayout {
                                            spacing: Spacing.sm;
                                            vertical-stretch: 0;
                                            // I due campi partono con un valore: senza il nome
                                            // sopra sarebbero due numeri (INTEGRATION-01).
                                            VerticalLayout {
                                                spacing: Spacing.xs;
                                                Text {
                                                    text: @tr("Ogni quanti giorni");
                                                    color: Palette.text-muted;
                                                    font-size: Typography.body-secondary;
                                                }
                                                HudInput {
                                                    label: @tr("Ogni quanti giorni");
                                                    value <=> root.backup-schedule-days;
                                                }
                                            }
                                            VerticalLayout {
                                                spacing: Spacing.xs;
                                                Text {
                                                    text: @tr("Quante tenerne");
                                                    color: Palette.text-muted;
                                                    font-size: Typography.body-secondary;
                                                }
                                                HudInput {
                                                    label: @tr("Quante tenerne");
                                                    value <=> root.backup-schedule-keep;
                                                }
                                            }
                                            VerticalLayout {
                                                alignment: end;
                                                HudButton {
                                                    label: @tr("Pianifica in una cartella...");
                                                    clicked => {
                                                        root.backup-schedule-choose();
                                                    }
                                                }
                                            }
                                            if root.backup-schedule-active: HudButton {
                                                label: @tr("Spegni");
                                                clicked => {
                                                    root.backup-schedule-off();
                                                }
                                            }
                                        }
                                    }
                                    if root.backup-schedule-message != "": Text {
                                        text: root.backup-schedule-message;
                                        color: Palette.text-muted;
                                        font-size: Typography.body-secondary;
                                        wrap: word-wrap;
                                    }

                                    // IL REGISTRO DELLE CONSULTAZIONI (AUDIT-VIEW-01,
                                    // ADR-0193): spento di fabbrica; chi lavora sa
                                    // se le sue aperture si registrano.
                                    Text {
                                        text: @tr("Registro delle consultazioni");
                                        color: Palette.text;
                                        font-size: Typography.body;
                                    }
                                    Text {
                                        text: root.consultations-state;
                                        color: Palette.text-muted;
                                        font-size: Typography.body-secondary;
                                        wrap: word-wrap;
                                    }
                                    if root.consultations-administrator: Rectangle {
                                        // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                        min-height: rip-202.preferred-height;
                                        rip-202 := HorizontalLayout {
                                            spacing: Spacing.sm;
                                            vertical-stretch: 0;
                                            VerticalLayout {
                                                spacing: Spacing.xs;
                                                Text {
                                                    text: @tr("Per quanti giorni si conserva");
                                                    color: Palette.text-muted;
                                                    font-size: Typography.body-secondary;
                                                }
                                                HudInput {
                                                    label: @tr("Per quanti giorni si conserva");
                                                    value <=> root.consultations-days;
                                                }
                                            }
                                            VerticalLayout {
                                                alignment: end;
                                                HudButton {
                                                    label: @tr("Accendi o cambia");
                                                    clicked => {
                                                        root.consultations-turn-on();
                                                    }
                                                }
                                            }
                                            if root.consultations-active: HudButton {
                                                label: @tr("Spegni e togli le righe");
                                                clicked => {
                                                    root.consultations-turn-off();
                                                }
                                            }
                                        }
                                    }
                                    if root.consultations-message != "": Text {
                                        text: root.consultations-message;
                                        color: Palette.text-muted;
                                        font-size: Typography.body-secondary;
                                        wrap: word-wrap;
                                    }
                                    if root.consultations-administrator && root.consultations-active: Text {
                                        text: root.consultations-entries;
                                        color: Palette.text-muted;
                                        font-family: Typography.mono;
                                        font-size: Typography.technical;
                                        wrap: word-wrap;
                                    }

                                    // L'ELENCO DEGLI ISCRITTI (MEMBERS-01, ADR-0201):
                                    // spento di fabbrica; lo abilita l'amministratore.
                                    Text {
                                        text: @tr("Elenco degli iscritti delle fonti");
                                        color: Palette.text;
                                        font-size: Typography.body;
                                    }
                                    Text {
                                        text: root.members-state;
                                        color: Palette.text-muted;
                                        font-size: Typography.body-secondary;
                                        wrap: word-wrap;
                                    }
                                    if root.members-administrator: Rectangle {
                                        // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                        min-height: rip-206.preferred-height;
                                        rip-206 := HorizontalLayout {
                                            spacing: Spacing.sm;
                                            vertical-stretch: 0;
                                            alignment: start;
                                            HudButton {
                                                label: @tr("Abilita l'elenco");
                                                clicked => {
                                                    root.members-enable();
                                                }
                                            }
                                            HudButton {
                                                label: @tr("Spegni l'elenco");
                                                clicked => {
                                                    root.members-disable();
                                                }
                                            }
                                        }
                                    }
                                    if root.members-choice-message != "": Text {
                                        text: root.members-choice-message;
                                        color: Palette.text-muted;
                                        font-size: Typography.body-secondary;
                                        wrap: word-wrap;
                                    }

                                    // LA RISOLUZIONE DEGLI INDICATORI DAL PC
                                    // (IOC-RESOLVE-01, ADR-0202): spenta di
                                    // fabbrica; la abilita l'amministratore.
                                    Text {
                                        text: @tr("Risoluzione degli indicatori dal PC");
                                        color: Palette.text;
                                        font-size: Typography.body;
                                    }
                                    Text {
                                        text: root.ioc-resolve-state;
                                        color: Palette.text-muted;
                                        font-size: Typography.body-secondary;
                                        wrap: word-wrap;
                                    }
                                    if root.ioc-resolve-administrator: Rectangle {
                                        // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                        min-height: rip-208.preferred-height;
                                        rip-208 := HorizontalLayout {
                                            spacing: Spacing.sm;
                                            vertical-stretch: 0;
                                            alignment: start;
                                            HudButton {
                                                label: @tr("Abilita la risoluzione");
                                                clicked => {
                                                    root.ioc-resolve-enable();
                                                }
                                            }
                                            HudButton {
                                                label: @tr("Spegni la risoluzione");
                                                clicked => {
                                                    root.ioc-resolve-disable();
                                                }
                                            }
                                        }
                                    }
                                    if root.ioc-resolve-choice-message != "": Text {
                                        text: root.ioc-resolve-choice-message;
                                        color: Palette.text-muted;
                                        font-size: Typography.body-secondary;
                                        wrap: word-wrap;
                                    }

                                    // IL WHOIS DAL PC (WHOIS-01, ADR-0205):
                                    // spento di fabbrica; lo abilita
                                    // l'amministratore.
                                    Text {
                                        text: @tr("WHOIS dal PC: chi ha registrato un nome o un indirizzo");
                                        color: Palette.text;
                                        font-size: Typography.body;
                                    }
                                    Text {
                                        text: root.whois-state;
                                        color: Palette.text-muted;
                                        font-size: Typography.body-secondary;
                                        wrap: word-wrap;
                                    }
                                    if root.whois-administrator: Rectangle {
                                        // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                        min-height: rip-212.preferred-height;
                                        rip-212 := HorizontalLayout {
                                            spacing: Spacing.sm;
                                            vertical-stretch: 0;
                                            alignment: start;
                                            HudButton {
                                                label: @tr("Abilita il WHOIS");
                                                clicked => {
                                                    root.whois-enable();
                                                }
                                            }
                                            HudButton {
                                                label: @tr("Spegni il WHOIS");
                                                clicked => {
                                                    root.whois-disable();
                                                }
                                            }
                                        }
                                    }
                                    if root.whois-choice-message != "": Text {
                                        text: root.whois-choice-message;
                                        color: Palette.text-muted;
                                        font-size: Typography.body-secondary;
                                        wrap: word-wrap;
                                    }

                                    // Il prodotto non ripristina, ed e' voluto:
                                    // sovrascrivere l'archivio in uso con uno
                                    // piu' vecchio cancellerebbe mesi di lavoro
                                    // in un secondo, e nessuna conferma vale
                                    // quel rischio. Le istruzioni sono nel
                                    // foglio accanto alla copia.
                                    Text {
                                        text: @tr("La copia non è cifrata e va custodita come l'archivio. Il programma non ripristina da solo: accanto alla copia viene scritto un foglio con le istruzioni e con ciò che la copia non contiene.");
                                        color: Palette.text-muted;
                                        font-size: Typography.body-secondary;
                                        wrap: word-wrap;
                                    }
                                }

                                // -------------------------- copia cifrata
                                //
                                // ENCRYPT-01, ADR-0175. Accanto alla copia in
                                // chiaro, non al suo posto: quella resta per
                                // chi la vuole sulla postazione. Che cosa
                                // costa la frase — chi la perde perde la
                                // copia — si dice PRIMA del clic.
                                sez-copia-cifrata := VerticalLayout {
                                    spacing: Spacing.sm;
                                    vertical-stretch: 0;

                                    Text {
                                        text: @tr("COPIA CIFRATA");
                                        color: Palette.text-muted;
                                        font-family: Typography.mono;
                                        font-size: Typography.eyebrow;
                                        font-weight: Typography.regular;
                                        letter-spacing: Typography.track-eyebrow;
                                    }

                                    Text {
                                        text: @tr("La copia cifrata contiene lo stesso archivio, e si può portare ovunque, anche su una chiavetta: senza la frase nessuno la legge. La frase deve avere almeno sedici caratteri. Il programma non la conserva: chi perde la frase perde la copia.");
                                        color: Palette.text-muted;
                                        font-size: Typography.body-secondary;
                                        wrap: word-wrap;
                                    }

                                    HorizontalLayout {
                                        spacing: Spacing.md;
                                        vertical-stretch: 0;

                                        SecretField {
                                            label: @tr("Frase della copia");
                                            placeholder: @tr("almeno sedici caratteri; non verrà mostrata");
                                            horizontal-stretch: 1;
                                            value <=> root.sealed-phrase;
                                        }

                                        SecretField {
                                            label: @tr("La stessa frase, di nuovo");
                                            placeholder: @tr("per scrivere una copia");
                                            horizontal-stretch: 1;
                                            value <=> root.sealed-phrase-again;
                                        }
                                    }

                                    HudCheck {
                                        text: @tr("Apribile anche da questo utente Windows, senza frase");
                                        checked <=> root.sealed-with-user;
                                        description: @tr("Su questa postazione, con lo stesso utente, la copia si apre anche senza frase. Altrove serve sempre la frase.");
                                    }

                                    HorizontalLayout {
                                        spacing: Spacing.sm;
                                        vertical-stretch: 0;

                                        HudButton {
                                            label: @tr("Scrivi una copia cifrata...");
                                            clicked => {
                                                root.make-sealed-backup();
                                            }
                                        }
                                        HudButton {
                                            label: @tr("Apri una copia cifrata...");
                                            clicked => {
                                                root.open-sealed-backup();
                                            }
                                        }
                                        Rectangle { horizontal-stretch: 1; background: transparent; }
                                    }

                                    if root.sealed-message != "": Text {
                                        text: root.sealed-message;
                                        color: root.sealed-failed ? Palette.amber : Palette.text-muted;
                                        font-size: Typography.body-secondary;
                                        wrap: word-wrap;
                                    }

                                    // Aprire non rimette la copia al posto
                                    // dell'archivio in uso (ADR-0175,
                                    // decisione 10): produce un file in chiaro
                                    // del solo utente, e il resto e' la
                                    // procedura scritta nel manuale.
                                    Text {
                                        text: @tr("Per aprire una copia cifrata si scrive la frase nel primo campo. Con il primo campo vuoto, la copia si apre con questo utente Windows. Aprire produce una copia in chiaro, leggibile dal solo utente, in una cartella su un disco di questo computer. Non tocca l'archivio in uso.");
                                        color: Palette.text-muted;
                                        font-size: Typography.body-secondary;
                                        wrap: word-wrap;
                                    }
                                }

                                // ------------------------- firma dell'ufficio
                                //
                                // SIGN-01, ADR-0181. Il certificato lo sceglie
                                // l'amministratore (la quinta azione riservata);
                                // la firma la fa Windows, e il programma non vede
                                // mai la chiave. Che cosa si firma, e che la firma
                                // non è una marca temporale, si dice prima.
                                sez-firma := VerticalLayout {
                                    spacing: Spacing.sm;
                                    vertical-stretch: 0;

                                    Text {
                                        text: @tr("FIRMA DELL'UFFICIO");
                                        color: Palette.text-muted;
                                        font-family: Typography.mono;
                                        font-size: Typography.eyebrow;
                                        font-weight: Typography.regular;
                                        letter-spacing: Typography.track-eyebrow;
                                    }

                                    Text {
                                        text: @tr("La firma dell'ufficio dice da dove viene un pacchetto, una relazione PDF o un dizionario. Chi lo riceve può controllare che nessuno lo abbia cambiato. La firma la fa Windows con un certificato dell'ufficio: il programma non vede mai la chiave. Se la chiave sta su una tessera, il codice lo chiede Windows. L'ora della firma è quella di questo computer.");
                                        color: Palette.text-muted;
                                        font-size: Typography.body-secondary;
                                        wrap: word-wrap;
                                    }

                                    Text {
                                        text: root.signing-chosen;
                                        color: Palette.text;
                                        font-size: Typography.body-secondary;
                                        wrap: word-wrap;
                                    }

                                    if root.signing-administrator && root.signing-has-certificates: HudSelect {
                                        label: @tr("Certificati con una chiave, in questo utente di Windows");
                                        model: root.signing-certificates;
                                        current-index <=> root.signing-index;
                                    }

                                    if root.signing-administrator && !root.signing-has-certificates: Text {
                                        text: @tr("In questo utente di Windows non c'è un certificato con una chiave. L'ufficio lo mette con i suoi strumenti, o sta su una tessera.");
                                        color: Palette.text-muted;
                                        font-size: Typography.body-secondary;
                                        wrap: word-wrap;
                                    }

                                    HorizontalLayout {
                                        spacing: Spacing.sm;
                                        vertical-stretch: 0;

                                        if root.signing-administrator: HudButton {
                                            label: @tr("Scegli questo certificato");
                                            enabled: root.signing-has-certificates;
                                            clicked => {
                                                root.signing-choose(root.signing-index);
                                            }
                                        }
                                        if root.signing-administrator: HudButton {
                                            label: @tr("Togli il certificato");
                                            clicked => {
                                                root.signing-remove();
                                            }
                                        }
                                        Rectangle { horizontal-stretch: 1; background: transparent; }
                                    }

                                    if !root.signing-administrator: Text {
                                        text: @tr("Il certificato si sceglie in modalità amministratore.");
                                        color: Palette.text-muted;
                                        font-size: Typography.body-secondary;
                                        wrap: word-wrap;
                                    }

                                    if root.signing-message != "": Text {
                                        text: root.signing-message;
                                        color: Palette.text-muted;
                                        font-size: Typography.body-secondary;
                                        wrap: word-wrap;
                                    }

                                    Text {
                                        text: root.signing-register;
                                        color: Palette.text-muted;
                                        font-size: Typography.body-secondary;
                                        wrap: word-wrap;
                                    }
                                }

                                // ------------------------------- conservazione
                                //
                                // E' l'unica impostazione del prodotto che puo'
                                // CANCELLARE materiale gia' acquisito. Perche'
                                // sta qui e non altrove: e' una scelta
                                // d'ufficio, non un gesto operativo.
                                //
                                // Tre cose, in quest'ordine, e l'ordine non e'
                                // estetico: si sceglie, si legge che cosa
                                // comporta, si legge quanto sparirebbe. Solo
                                // dopo compare il comando che cancella.
                                sez-conservazione := VerticalLayout {
                                    spacing: Spacing.sm;
                                    vertical-stretch: 0;

                                    Text {
                                        text: @tr("CONSERVAZIONE");
                                        color: Palette.text-muted;
                                        font-family: Typography.mono;
                                        font-size: Typography.eyebrow;
                                        font-weight: Typography.regular;
                                        letter-spacing: Typography.track-eyebrow;
                                    }

                                    HudSelect {
                                        label: @tr("Per quanto tempo si conserva ciò che è stato acquisito");
                                        model: root.retention-options;
                                        current-index <=> root.retention-index;
                                        selected => {
                                            root.retention-chosen(self.current-index);
                                        }
                                    }

                                    Text {
                                        text: root.retention-consequence;
                                        color: Palette.text-muted;
                                        font-size: Typography.body-secondary;
                                        wrap: word-wrap;
                                    }

                                    // L'anteprima. Una cancellazione che non si
                                    // puo' prevedere e' una cancellazione che
                                    // si scopre quando e' troppo tardi.
                                    if root.retention-preview != "": Text {
                                        text: root.retention-preview;
                                        color: root.retention-has-work ? Palette.amber : Palette.text-muted;
                                        font-size: Typography.body-secondary;
                                        wrap: word-wrap;
                                    }

                                    HorizontalLayout {
                                        spacing: Spacing.sm;
                                        vertical-stretch: 0;

                                        HudButton {
                                            label: @tr("Salva la conservazione");
                                            clicked => {
                                                root.save-retention();
                                            }
                                        }

                                        // Salvare non cancella. Sono due gesti
                                        // distinti proprio perche' chi sceglie
                                        // «90 giorni» deve poter vedere
                                        // l'anteprima e cambiare idea prima che
                                        // qualcosa sparisca.
                                        HudButton {
                                            label: @tr("Cancella ora ciò che è scaduto");
                                            enabled: root.retention-has-work;
                                            reason: root.retention-has-work ? "" : @tr("Non c'è nulla da togliere con la politica scelta.");
                                            clicked => {
                                                root.apply-retention();
                                            }
                                        }

                                        Rectangle { horizontal-stretch: 1; background: transparent; }
                                    }

                                    Text {
                                        text: @tr("Non vengono mai tolti il registro delle operazioni e le fotografie dei rapporti. Restano anche i contenuti citati da un documento già prodotto, e la configurazione: dizionari, fonti, account.");
                                        color: Palette.text-muted;
                                        font-size: Typography.body-secondary;
                                        wrap: word-wrap;
                                    }

                                    if root.retention-message != "": InfoBanner {
                                        message: root.retention-message;
                                    }
                                }

                            }
                        }
                    }
                    }

                    // -------------------------------------------- Verifica esportati
                    //
                    // Le righe sono la resa diretta di verify_directory: un rapporto per
                    // riga con il suo verdetto. Il colore rafforza la parola, non la
                    // sostituisce: lo stato e' scritto e finisce nell'etichetta di
                    // accessibilita'.
                    if root.current-page == 12: Rectangle {
                        // Comparsa graduale della pagina: vedere la pagina 0 per il
                        // perche' la dissolvenza sia solo in entrata.
                        property <bool> entered: false;
                        opacity: 0.0;
                        init => {
                            self.entered = true;
                        }
                        animate opacity {
                            duration: Motion.transition-effective;
                            easing: cubic-bezier(0.16, 1, 0.3, 1);
                        }
        states [
            shown when self.entered: {
                opacity: 1.0;
            }
        ]
                        background: Palette.panel;
                        border-radius: Spacing.radius-panel;

                        VerticalLayout {
                            padding: Spacing.xl;
                            spacing: Spacing.lg;

                            HorizontalLayout {
                                spacing: Spacing.md;
                                vertical-stretch: 0;
                                VerticalLayout {
                                    spacing: Spacing.xs;
                                    horizontal-stretch: 1;
                                    Text {
                                        text: @tr("Verifica dei rapporti esportati");
                                        color: Palette.text;
                                        font-size: Typography.screen-title;
                                        font-weight: Typography.medium;
                                    }
                                    AvvertenzaDiSicurezza {
                                        codice: "SIC-07";
                                        testo: @tr("Ricalcola l'impronta di ogni rapporto esportato e la confronta con il suo elenco delle impronte. Prova che il rapporto è ancora identico a quello prodotto. Non prova che l'elenco delle impronte sia l'originale.");
                                        dettaglio: @tr("Confronto byte per byte tramite SHA-256 con il manifest di integrità. Il manifest non è firmato: chi può cambiare il rapporto può cambiare anche il manifest.");
                                    }
                                }
                                HudButton {
                                    label: @tr("Verifica ora");
                                    clicked => {
                                        root.verify-now();
                                    }
                                }
                                // **Un pacchetto consegnato non sta piu' dov'e' nato.**
                                //
                                // Si copia su una condivisione, si allega, si porta via
                                // su una chiavetta. Verificare la sola cartella
                                // configurata risponde alla domanda sbagliata: quella
                                // giusta e' «questo pacchetto, qui davanti a me, e'
                                // ancora quello che ho firmato?».
                                //
                                // E' anche cio' che serviva il 2026-08-20, quando un
                                // pacchetto salvato sul Desktop non veniva trovato
                                // perche' la destinazione predefinita era un'altra: la
                                // scelta della cartella al passo 6 vale per quel
                                // documento, e non cambia l'impostazione dell'ufficio.
                                HudButton {
                                    label: @tr("Verifica un'altra cartella\u{2026}");
                                    clicked => {
                                        root.verify-elsewhere();
                                    }
                                }
                            }

                            if root.verification-summary != "": InfoBanner {
                                message: root.verification-summary;
                            }

                            // Non ancora verificato: si dice che cosa fare, invece di
                            // mostrare un elenco vuoto che sembrerebbe «nessun rapporto».
                            if !root.verification-checked: Rectangle {
                                background: Palette.panel-raised;
                                border-radius: Spacing.radius-row;
                                vertical-stretch: 1;
                                VerticalLayout {
                                    alignment: center;
                                    Text {
                                        text: @tr("Premi «Verifica ora» per controllare i rapporti esportati.");
                                        color: Palette.text-muted;
                                        font-size: Typography.body;
                                        horizontal-alignment: center;
                                        wrap: word-wrap;
                                    }
                                }
                            }

                            if root.verification-checked: HudScroll {
                                VerticalLayout {
                                    spacing: Spacing.sm;

                                    LegendaOrigini {
                                        calcolato: @tr("esito della verifica");
                                    }
                                    for row in root.verification-rows: Rectangle {
                                        background: Palette.panel-raised;
                                        border-radius: Spacing.radius-row;
                                        border-width: Spacing.hairline;
                                        border-color: row.ok ? Palette.line-divider : Palette.coral;

                                        // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                        min-height: rip-88.preferred-height;
                                        rip-88 := HorizontalLayout {
                                            padding: Spacing.lg;
                                            spacing: Spacing.md;
                                            VerticalLayout {
                                                horizontal-stretch: 1;
                                                spacing: Spacing.xs;
                                                Text {
                                                    text: row.report;
                                                    color: Palette.text;
                                                    font-size: Typography.body;
                                                    wrap: word-wrap;
                                                }
                                                Text {
                                                    text: row.folder;
                                                    color: Palette.text-muted;
                                                    font-size: Typography.body-secondary;
                                                    wrap: word-wrap;
                                                }
                                            }
                                            Text {
                                                text: row.status;
                                                color: row.ok ? Palette.text-muted : Palette.coral;
                                                font-size: Typography.body;
                                                font-weight: Typography.medium;
                                                vertical-alignment: center;
                                            }
                                        }

                                        accessible-role: text;
                                        accessible-label: row.report + ". " + row.folder + " " + row.status;
                                    }
                                }
                            }
                        }
                    }

                    // ------------------------------------------------ Persone
                    //
                    // Chi ha scritto durante il monitoraggio, ricavato dall'archivio e
                    // non chiesto a Telegram (ADR-0024). La schermata mostra **o** la
                    // richiesta della ragione **o** l'elenco: mai entrambi, perche' un
                    // elenco accanto alla richiesta di motivarlo suggerirebbe che la
                    // richiesta sia facoltativa.
                    if root.current-page == 14: Rectangle {
                        property <bool> entered: false;
                        opacity: 0.0;
                        init => {
                            self.entered = true;
                        }
                        animate opacity {
                            duration: Motion.transition-effective;
                            easing: cubic-bezier(0.16, 1, 0.3, 1);
                        }
        states [
            shown when self.entered: {
                opacity: 1.0;
            }
        ]
                        background: Palette.panel;
                        border-radius: Spacing.radius-panel;

                        VerticalLayout {
                            padding: Spacing.xl;
                            spacing: Spacing.lg;

                            VerticalLayout {
                                spacing: Spacing.xs;
                                vertical-stretch: 0;
                                Text {
                                    text: @tr("Persone che hanno scritto");
                                    color: Palette.text;
                                    font-size: Typography.screen-title;
                                    font-weight: Typography.medium;
                                }
                                AvvertenzaDiSicurezza {
                                    codice: "SIC-08";
                                    testo: @tr("Questo elenco viene dai messaggi già acquisiti: chi compare come autore, quante volte, in quali fonti. Non è una lista chiesta a Telegram. Non comprende chi non ha mai scritto.");
                                    dettaglio: @tr("Aggregazione dei mittenti dei contenuti in archivio. A Telegram non viene chiesto l'elenco dei membri di alcuna fonte.");
                                }
                            }

                            // UN SOLO SCORRIMENTO PER TUTTA LA SCHERMATA (FINAL-REVIEW-01, FR-031).
                            //
                            // L'elenco dei soggetti stava fuori da ogni scorrimento: con
                            // più soggetti aperti la schermata usciva dalla finestra, e i
                            // comandi dei soggetti in basso non si raggiungevano. Era l'unica
                            // delle trentadue. Il titolo e l'avvertenza restano fermi.
                            HudScroll {
                                vertical-stretch: 1;
                                VerticalLayout {
                                    spacing: Spacing.lg;
                            // La ragione: si scrive una volta e resta nell'audit.
                            if !root.participants-basis-recorded: Rectangle {
                                // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                min-height: rip-89.preferred-height;
                                rip-89 := VerticalLayout {
                                    spacing: Spacing.md;
                                    vertical-stretch: 0;

                                    Text {
                                        text: @tr("Prima di comporre l'elenco serve la ragione per cui l'ufficio lo fa. Si scrive una volta, resta nel registro delle operazioni e non si riscrive. Non è una formalità: chi custodisce un elenco di persone risponde di averlo, e «il programma lo permetteva» non è una risposta.");
                                        color: Palette.text;
                                        font-size: Typography.body;
                                        wrap: word-wrap;
                                    }

                                    // Il campo ha etichetta e cornice sue: il
                                    // riquadro scuro alto 96 px che lo avvolgeva
                                    // si vedeva come un vuoto nero sopra il campo
                                    // (INSTALLED-APP-E2E-01, E2E01-18).
                                    TextField {
                                        vertical-stretch: 0;
                                        label: @tr("Ragione per cui l'ufficio compone elenchi di persone");
                                        placeholder: @tr("Per esempio: accertamenti delegati, con gli estremi dell'atto.");
                                        value <=> root.participants-basis;
                                    }

                                    HorizontalLayout {
                                        vertical-stretch: 0;
                                        HudButton {
                                            label: @tr("Registra la ragione");
                                            weight: Weight.primary;
                                            clicked => {
                                                root.record-participants-basis();
                                            }
                                        }
                                        Rectangle { horizontal-stretch: 1; background: transparent; }
                                    }
                                }
                            }

                            // Il monitoraggio di cui si parla. Compare solo a ragione
                            // registrata e solo se c'e' piu' di una sessione: un
                            // selettore con una voce sola e' un comando che non
                            // comanda niente.
                            if root.participants-basis-recorded
                                && root.participants-sessions.length > 1: Rectangle {
                                // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                min-height: rip-90.preferred-height;
                                rip-90 := HorizontalLayout {
                                    spacing: Spacing.md;
                                    vertical-stretch: 0;

                                    HudSelect {
                                        model: root.participants-sessions;
                                        label: @tr("Monitoraggio di cui elencare le persone");
                                        description: @tr("L'elenco riguarda un solo monitoraggio: unirne due metterebbe insieme atti diversi.");
                                        current-index <=> root.participants-session-index;
                                        selected => {
                                            root.participants-session-chosen(self.current-index);
                                        }
                                    }
                                }
                            }

                            if root.participants-message != "": InfoBanner {
                                message: root.participants-message;
                            }

                            if root.participants-basis-recorded: Rectangle {
                                // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                min-height: rip-91.preferred-height;
                                rip-91 := VerticalLayout {
                                    VerticalLayout {
                                        spacing: Spacing.sm;

                                        // LA SCHEDA «FOTO, BIOGRAFIA E STATO» (PERSON-MEDIA-01,
                                        // ADR-0174). Sopra l'elenco, per l'autore scelto: la
                                        // frase in ambra, la ragione, il comando, e le
                                        // osservazioni già registrate, dalla più recente.
                                        if root.profile-media-open: Rectangle {
                                            background: Palette.panel-raised;
                                            border-radius: Spacing.radius-row;
                                            vertical-stretch: 0;
                                            min-height: scheda-profilo.preferred-height;
                                            scheda-profilo := VerticalLayout {
                                                padding: Spacing.lg;
                                                spacing: Spacing.sm;

                                                HorizontalLayout {
                                                    spacing: Spacing.md;
                                                    Text {
                                                        text: root.profile-media-title;
                                                        color: Palette.text;
                                                        font-size: Typography.body;
                                                        font-weight: Typography.medium;
                                                        horizontal-stretch: 1;
                                                        wrap: word-wrap;
                                                    }
                                                    HudButton {
                                                        label: @tr("Chiudi");
                                                        horizontal-stretch: 0;
                                                        clicked => {
                                                            root.profile-media-close();
                                                        }
                                                    }
                                                }
                                                Text {
                                                    text: root.profile-media-caveat;
                                                    color: Palette.amber;
                                                    font-size: Typography.body-secondary;
                                                    wrap: word-wrap;
                                                }
                                                HorizontalLayout {
                                                    spacing: Spacing.md;
                                                    HudInput {
                                                        placeholder: @tr("Perché serve (almeno 20 caratteri)");
                                                        label: @tr("Ragione della richiesta");
                                                        value <=> root.profile-media-reason;
                                                        horizontal-stretch: 1;
                                                    }
                                                    HudButton {
                                                        label: @tr("Chiedi a Telegram");
                                                        horizontal-stretch: 0;
                                                        clicked => {
                                                            root.profile-media-ask();
                                                        }
                                                    }
                                                }
                                                if root.profile-media-message != "": Text {
                                                    text: root.profile-media-message;
                                                    color: Palette.text-muted;
                                                    font-size: Typography.body-secondary;
                                                    wrap: word-wrap;
                                                }
                                                if root.profile-media-entries.length == 0: Text {
                                                    text: @tr("Nessuna richiesta registrata per questo autore in questo monitoraggio.");
                                                    color: Palette.text-disabled;
                                                    font-size: Typography.body-secondary;
                                                    wrap: word-wrap;
                                                }
                                                if root.profile-media-entries.length > 0: LegendaOrigini {
                                                    osservato: @tr("stato, biografia e foto");
                                                    calcolato: @tr("istanti ed esiti");
                                                    operatore: @tr("ragione");
                                                }
                                                for osservazione in root.profile-media-entries: Rectangle {
                                                    vertical-stretch: 0;
                                                    min-height: riga-profilo.preferred-height;
                                                    riga-profilo := HorizontalLayout {
                                                        spacing: Spacing.md;
                                                        padding-top: Spacing.xs;
                                                        padding-bottom: Spacing.xs;
                                                        if osservazione.has-photo: Image {
                                                            source: osservazione.photo;
                                                            width: 96px;
                                                            height: 96px;
                                                            image-fit: contain;
                                                        }
                                                        VerticalLayout {
                                                            spacing: Spacing.xs;
                                                            horizontal-stretch: 1;
                                                            Text {
                                                                text: osservazione.when;
                                                                color: Palette.text;
                                                                font-size: Typography.body-secondary;
                                                                wrap: word-wrap;
                                                            }
                                                            Text {
                                                                text: osservazione.motive;
                                                                color: Palette.text-muted;
                                                                font-size: Typography.group-label;
                                                                wrap: word-wrap;
                                                            }
                                                            Text {
                                                                text: osservazione.outcome;
                                                                color: Palette.text-muted;
                                                                font-size: Typography.body-secondary;
                                                                wrap: word-wrap;
                                                            }
                                                            if osservazione.status != "": Text {
                                                                text: osservazione.status;
                                                                color: Palette.text;
                                                                font-size: Typography.body-secondary;
                                                                wrap: word-wrap;
                                                            }
                                                            if osservazione.bio != "": Text {
                                                                text: osservazione.bio;
                                                                color: Palette.text;
                                                                font-size: Typography.body-secondary;
                                                                wrap: word-wrap;
                                                            }
                                                            if osservazione.photo-note != "": Text {
                                                                text: osservazione.photo-note;
                                                                color: Palette.text-muted;
                                                                font-size: Typography.group-label;
                                                                wrap: word-wrap;
                                                            }
                                                            // NEI DOCUMENTI SOLTANTO SE SCELTA (PERSON-MEDIA-01
                                                            // parte 3): per difetto non entra; la foto mai.
                                                            if osservazione.markable: Rectangle {
                                                                // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                                                min-height: rip-197.preferred-height;
                                                                rip-197 := HorizontalLayout {
                                                                    alignment: start;
                                                                    if !osservazione.chosen: HudButton {
                                                                        label: @tr("Riporta nei documenti");
                                                                        horizontal-stretch: 0;
                                                                        clicked => {
                                                                            root.profile-media-mark(osservazione.id, true);
                                                                        }
                                                                    }
                                                                    if osservazione.chosen: HudButton {
                                                                        label: @tr("Togli dai documenti");
                                                                        horizontal-stretch: 0;
                                                                        clicked => {
                                                                            root.profile-media-mark(osservazione.id, false);
                                                                        }
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }

                                        LegendaOrigini {
                                            osservato: @tr("nomi e identificativi");
                                            calcolato: @tr("conteggi, periodi e collegamenti");
                                        }
                                        for person in root.participants: Rectangle {
                                            background: Palette.panel-raised;
                                            border-radius: Spacing.radius-row;
                                            vertical-stretch: 0;

                                            // Un `Rectangle` non prende l'altezza dai figli (F-03).
                                            min-height: persona-fit-1.preferred-height;
                                            persona-fit-1 := VerticalLayout {
                                                padding: Spacing.lg;
                                                spacing: Spacing.xs;

                                                HorizontalLayout {
                                                    spacing: Spacing.md;
                                                    Text {
                                                        // Il nome puo' mancare, e in quel
                                                        // caso l'identificativo e' cio' che
                                                        // la persona **e'**: mostrarlo al
                                                        // posto di un trattino evita di
                                                        // suggerire che manchi un dato.
                                                        text: person.display-name != "" ? person.display-name : person.identifier;
                                                        color: Palette.text;
                                                        font-size: Typography.body;
                                                        font-weight: Typography.medium;
                                                        horizontal-stretch: 1;
                                                        overflow: elide;
                                                    }
                                                    Text {
                                                        text: person.messages;
                                                        color: Palette.text-muted;
                                                        font-size: Typography.technical;
                                                        horizontal-stretch: 0;
                                                    }
                                                }

                                                HorizontalLayout {
                                                    spacing: Spacing.md;
                                                    Text {
                                                        text: @tr("identificativo {}", person.identifier);
                                                        color: Palette.text-muted;
                                                        font-size: Typography.group-label;
                                                        horizontal-stretch: 0;
                                                    }
                                                    if person.username != "": Text {
                                                        text: person.username;
                                                        color: Palette.text-muted;
                                                        font-size: Typography.group-label;
                                                        horizontal-stretch: 0;
                                                    }
                                                    Text {
                                                        text: person.sources;
                                                        color: Palette.text-muted;
                                                        font-size: Typography.group-label;
                                                        horizontal-stretch: 1;
                                                    }
                                                }

                                                Text {
                                                    text: @tr("dal {} al {}", person.first-seen, person.last-seen);
                                                    color: Palette.text-muted;
                                                    font-size: Typography.body-secondary;
                                                }

                                                // FOTO, BIOGRAFIA E STATO (PERSON-MEDIA-01): una
                                                // scheda per l'autore, con la richiesta motivata.
                                                HorizontalLayout {
                                                    alignment: start;
                                                    HudButton {
                                                        label: @tr("Foto, biografia e stato\u{2026}");
                                                        horizontal-stretch: 0;
                                                        clicked => {
                                                            root.profile-media-open-for(person.identifier, person.display-name);
                                                        }
                                                    }
                                                }

                                                // LA STORIA DEGLI ALIAS (PERS-02).
                                                //
                                                // Compare SOLO quando qualcosa e'
                                                // cambiato. Chi ha portato lo
                                                // stesso nome non ha una storia, e
                                                // dirlo sotto ogni riga sarebbe
                                                // rumore.
                                                if person.alias-caveat != "": Text {
                                                    text: @tr("NOMI OSSERVATI");
                                                    color: Palette.text-muted;
                                                    font-size: Typography.group-label;
                                                    letter-spacing: Typography.track-eyebrow;
                                                }

                                                for alias in person.alias-history: Text {
                                                    text: alias;
                                                    color: Palette.text-muted;
                                                    font-size: Typography.technical;
                                                    wrap: word-wrap;
                                                }

                                                // L'AVVERTENZA CHE NESSUNO VEDREBBE
                                                // DA SE': gli istanti dicono quando
                                                // il nome e' stato VISTO la prima
                                                // volta, non quando e' stato
                                                // cambiato.
                                                if person.alias-caveat != "": Text {
                                                    text: person.alias-caveat;
                                                    color: Palette.amber;
                                                    font-size: Typography.technical;
                                                    wrap: word-wrap;
                                                }

                                                // LE ASSOCIAZIONI (PERS-03).
                                                //
                                                // Compaiono SOLO quando c'e'
                                                // qualcosa che l'elenco non
                                                // diceva gia': un alert, un
                                                // indicatore, un workspace.
                                                // Contenuti e fonti stanno
                                                // gia' nella riga sopra.
                                                if person.associations-caveat != "": Text {
                                                    text: @tr("RISULTA COLLEGATO A");
                                                    color: Palette.text-muted;
                                                    font-size: Typography.group-label;
                                                    letter-spacing: Typography.track-eyebrow;
                                                }

                                                for collegamento in person.associations: Rectangle {
                                                    // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                                    min-height: rip-92.preferred-height;
                                                    rip-92 := VerticalLayout {
                                                        spacing: Spacing.xs;

                                                        Text {
                                                            text: collegamento;
                                                            color: Palette.text-muted;
                                                            font-size: Typography.technical;
                                                            wrap: word-wrap;
                                                        }
                                                        // LA STESSA DOMANDA, LA STESSA
                                                        // VOCE: un'associazione e' un
                                                        // fatto che sta nell'archivio,
                                                        // e il pannello lo dice con le
                                                        // stesse parole con cui altrove
                                                        // dice che un altro numero e'
                                                        // un calcolo.
                                                        PercheVedoQuesto {
                                                            elemento: collegamento;
                                                            chiesto => {
                                                                root.explain-this(Spiegabile.associazione, person.identifier, collegamento);
                                                            }
                                                        }
                                                    }
                                                }

                                                // CHE COSA QUESTI COLLEGAMENTI
                                                // NON SIGNIFICANO. In ambra e
                                                // una volta sola: in coda
                                                // all'elenco sarebbe una riga
                                                // come le altre.
                                                if person.associations-caveat != "": Text {
                                                    text: person.associations-caveat;
                                                    color: Palette.amber;
                                                    font-size: Typography.technical;
                                                    wrap: word-wrap;
                                                }

                                                // LA CRONOLOGIA (PERS-04).
                                                if person.timeline-caveat != "": Text {
                                                    text: @tr("CRONOLOGIA OSSERVATA");
                                                    color: Palette.text-muted;
                                                    font-size: Typography.group-label;
                                                    letter-spacing: Typography.track-eyebrow;
                                                }

                                                for momento in person.timeline: Text {
                                                    text: momento;
                                                    color: Palette.text-muted;
                                                    font-size: Typography.technical;
                                                    wrap: word-wrap;
                                                }

                                                // QUANDO SI STAVA GUARDANDO.
                                                //
                                                // Sta SOTTO le righe e PRIMA
                                                // dell'avvertenza, perche' e'
                                                // cio' che la rende concreta:
                                                // l'avvertenza dice «puo'
                                                // significare che nessuno stava
                                                // guardando», e queste righe
                                                // dicono quando si guardava
                                                // davvero.
                                                if person.timeline-caveat != "": Text {
                                                    text: @tr("QUANDO SI STAVA GUARDANDO");
                                                    color: Palette.text-muted;
                                                    font-size: Typography.group-label;
                                                    letter-spacing: Typography.track-eyebrow;
                                                }

                                                for finestra in person.timeline-windows: Text {
                                                    text: finestra;
                                                    color: Palette.text-muted;
                                                    font-size: Typography.technical;
                                                    wrap: word-wrap;
                                                }

                                                // UN VUOTO NON E' UN SILENZIO.
                                                // In ambra e una volta sola.
                                                if person.timeline-caveat != "": Text {
                                                    text: person.timeline-caveat;
                                                    color: Palette.amber;
                                                    font-size: Typography.technical;
                                                    wrap: word-wrap;
                                                }
                                            }

                                            accessible-role: text;
                                            accessible-label: @tr("{}, identificativo {}, {}", (person.display-name != "" ? person.display-name : @tr("senza nome")), person.identifier, person.messages);
                                        }
                                    }
                                }
                            }

                            // Riempitivo, e non e' un dettaglio di stile.
                            //
                            // Finche' l'elenco non c'e', **tutti** i figli di
                            // questo layout hanno `vertical-stretch: 0`, e Slint
                            // in quel caso distribuisce lo spazio avanzato **in
                            // parti uguali fra loro**: il titolo, il paragrafo e
                            // il campo finivano lontanissimi l'uno dall'altro,
                            // sparsi su tutta l'altezza della schermata.
                            //
                            // Serve qualcosa che quello spazio se lo prenda.
                            // Esiste solo quando l'elenco non c'e', perche'
                            // quando c'e' e' l'elenco a doverlo prendere.
                            if !root.participants-basis-recorded: Rectangle {
                                vertical-stretch: 1;
                                background: transparent;
                            }

                            // ------------------------------- I SOGGETTI (PERS-01)
                            //
                            // STANNO QUI, E NON IN UNA SCHERMATA LORO.
                            //
                            // L'elenco qui sopra e' DERIVATO: chi ha scritto
                            // durante un monitoraggio, ricavato dai messaggi
                            // acquisiti. E' un'osservazione, e non afferma
                            // niente su nessuno.
                            //
                            // Un soggetto e' un'altra cosa: qualcuno su cui
                            // l'ufficio ha deciso di aprire un fascicolo.
                            //
                            // La confusione fra le due cose nascerebbe
                            // ESATTAMENTE qui, davanti a un elenco di nomi con
                            // un comando accanto. Metterle nella stessa
                            // schermata, separate e con la differenza scritta,
                            // e' il posto dove quella frase serve.
                            Rectangle {
                                height: 1px;
                                background: Palette.text-muted;
                                opacity: 0.3;
                                vertical-stretch: 0;
                            }

                            VerticalLayout {
                                spacing: Spacing.sm;
                                vertical-stretch: 0;

                                Text {
                                    text: @tr("SOGGETTI APERTI");
                                    color: Palette.text-muted;
                                    font-size: Typography.group-label;
                                    letter-spacing: Typography.track-eyebrow;
                                }

                                AvvertenzaDiSicurezza {
                                    codice: "SIC-09";
                                    testo: @tr("Un soggetto non è una persona dell'elenco qui sopra. Quell'elenco dice chi ha scritto durante un monitoraggio. È un'osservazione, e non afferma niente su nessuno. Un soggetto si apre a mano, scrivendo perché. Nessuno diventa un soggetto per aver scritto in un gruppo.");
                                    dettaglio: @tr("Il fascicolo di un soggetto richiede operatore, motivo e istante, e resta nel registro di audit. L'elenco dei partecipanti è derivato dai mittenti dei contenuti.");
                                }

                                if root.person-message != "": Text {
                                    text: root.person-message;
                                    color: Palette.amber;
                                    font-size: Typography.body-secondary;
                                    wrap: word-wrap;
                                }

                                HudInput {
                                    placeholder: @tr("Come l'ufficio chiama questo soggetto");
                                    label: @tr("Nome del soggetto");
                                    value <=> root.person-new-label;
                                }

                                HudInput {
                                    placeholder: @tr("Perché si apre un fascicolo su questo soggetto, per esteso");
                                    label: @tr("Ragione operativa, obbligatoria");
                                    value <=> root.person-new-reason;
                                }

                                HorizontalLayout {
                                    spacing: Spacing.sm;
                                    vertical-stretch: 0;

                                    HudButton {
                                        label: @tr("Apri un soggetto");
                                        clicked => {
                                            root.open-person(root.person-new-label, root.person-new-reason);
                                        }
                                    }
                                    Rectangle { horizontal-stretch: 1; background: transparent; }
                                }

                                if root.person-rows.length == 0: Text {
                                    text: @tr("Nessun soggetto è stato aperto su questa postazione.");
                                    color: Palette.text-muted;
                                    font-size: Typography.body-secondary;
                                    wrap: word-wrap;
                                }

                                // I SOGGETTI CHIUSI RESTANO NELL'ELENCO.
                                //
                                // Nasconderli direbbe che nessuno ha mai aperto
                                // un fascicolo su quella persona.
                                LegendaOrigini {
                                    osservato: @tr("che cosa si è osservato");
                                    operatore: @tr("fascicolo, motivo, valutazione e identità collegate");
                                }
                                for soggetto in root.person-rows: Rectangle {
                                    vertical-stretch: 0;
                                    background: transparent;
                                    // LA SCHEDA APERTA DA UN MESSAGGIO (GAP-12) si riconosce: un bordo, e la
                                    // frase in cima alla schermata che dice da dove si arriva.
                                    border-width: root.person-highlight == soggetto.id ? 2px : 0px;
                                    border-color: Palette.cyan;
                                    border-radius: Spacing.radius-row;

                                    // Un `Rectangle` non prende l'altezza dai figli (F-03).
                                    min-height: persona-fit-2.preferred-height;
                                    persona-fit-2 := VerticalLayout {
                                        padding-left: Spacing.md;
                                        padding-top: Spacing.xs;
                                        padding-bottom: Spacing.xs;
                                        spacing: 2px;

                                        HorizontalLayout {
                                            spacing: Spacing.sm;

                                            Text {
                                                text: soggetto.label;
                                                color: Palette.text;
                                                font-size: Typography.body;
                                                horizontal-stretch: 1;
                                            }
                                            // Lo stato si legge a parole, non
                                            // solo con un colore: un colore non
                                            // e' leggibile da tutti e non si
                                            // stampa.
                                            Text {
                                                text: soggetto.open ? @tr("aperto") : @tr("chiuso");
                                                color: soggetto.open ? Palette.cyan : Palette.text-muted;
                                                font-family: Typography.mono;
                                                font-size: Typography.technical;
                                            }
                                        }
                                        // LA FRASE LA COMPONE IL MODELLO, e
                                        // dice che un fascicolo aperto non e'
                                        // una valutazione.
                                        Text {
                                            text: soggetto.sentence;
                                            color: Palette.text-muted;
                                            font-size: Typography.technical;
                                            wrap: word-wrap;
                                        }
                                        // LA RAGIONE SI LEGGE, e non si
                                        // modifica: e' quella scritta aprendo.
                                        Text {
                                            text: @tr("Aperto perché: {}", soggetto.reason);
                                            color: Palette.text-muted;
                                            font-size: Typography.technical;
                                            wrap: word-wrap;
                                        }

                                        // LA VALUTAZIONE UMANA (PERS-05).
                                        //
                                        // Sta SOTTO la ragione di apertura e
                                        // sopra i comandi, perche' e' cio' che
                                        // qualcuno ha deciso DOPO aver aperto.
                                        // E' una parola, mai un numero.
                                        Text {
                                            text: @tr("Valutazione: {}", soggetto.assessment-label);
                                            color: Palette.text;
                                            font-family: Typography.mono;
                                            font-size: Typography.technical;
                                        }
                                        // CHE COSA QUELLA PAROLA NON DICE.
                                        //
                                        // In ambra, perche' e' la riga che
                                        // impedisce di leggere «PRIORITA'
                                        // ALTA» come una misura di
                                        // pericolosita'.
                                        Text {
                                            text: soggetto.assessment-sentence;
                                            color: Palette.amber;
                                            font-size: Typography.technical;
                                            wrap: word-wrap;
                                        }
                                        // COME CI SI E' ARRIVATI.
                                        //
                                        // Compare solo con piu' di un atto: un
                                        // atto solo lo dice gia' la frase
                                        // sopra.
                                        if soggetto.assessment-history.length > 0: Text {
                                            text: @tr("COME CI SI È ARRIVATI");
                                            color: Palette.text-muted;
                                            font-size: Typography.group-label;
                                            letter-spacing: Typography.track-eyebrow;
                                        }
                                        for atto in soggetto.assessment-history: Text {
                                            text: atto;
                                            color: Palette.text-muted;
                                            font-size: Typography.technical;
                                            wrap: word-wrap;
                                        }

                                        // LE IDENTITÀ COLLEGATE (PERS-06).
                                        if soggetto.linked-identities.length > 0: Text {
                                            text: @tr("IDENTITÀ COLLEGATE");
                                            color: Palette.text-muted;
                                            font-size: Typography.group-label;
                                            letter-spacing: Typography.track-eyebrow;
                                        }
                                        for legame in soggetto.linked-identities: Text {
                                            text: legame;
                                            color: Palette.text-muted;
                                            font-size: Typography.technical;
                                            wrap: word-wrap;
                                        }
                                        // LA STORIA DEI LEGAMI, se qualcosa e'
                                        // stato sciolto.
                                        if soggetto.link-history.length > 0: Text {
                                            text: @tr("STORIA DEI LEGAMI");
                                            color: Palette.text-muted;
                                            font-size: Typography.group-label;
                                            letter-spacing: Typography.track-eyebrow;
                                        }
                                        for atto in soggetto.link-history: Text {
                                            text: atto;
                                            color: Palette.text-muted;
                                            font-size: Typography.technical;
                                            wrap: word-wrap;
                                        }

                                        // CHE COSA SI È OSSERVATO (PERS-07).
                                        //
                                        // Compare solo se qualcosa e' stato
                                        // collegato: un fascicolo senza legami
                                        // non ha osservazioni da mostrare, e
                                        // una sezione vuota sarebbe rumore.
                                        if soggetto.dossier.length > 0: Text {
                                            text: @tr("CHE COSA SI È OSSERVATO");
                                            color: Palette.text-muted;
                                            font-size: Typography.group-label;
                                            letter-spacing: Typography.track-eyebrow;
                                        }
                                        for riga in soggetto.dossier: Text {
                                            text: riga;
                                            color: Palette.text-muted;
                                            font-size: Typography.technical;
                                            wrap: word-wrap;
                                        }
                                        // DOVE SI GUARDA IL GRAFO.
                                        //
                                        // Fino a PR-01 qui c'era scritto che il
                                        // grafo non aveva una schermata e che
                                        // sarebbe arrivata con GRAPH-02. GRAPH-02
                                        // l'ha costruita, e la frase era diventata
                                        // falsa senza che nulla lo segnalasse.
                                        // Ora rimanda alla schermata per nome.
                                        if soggetto.dossier.length > 0: Text {
                                            text: @tr("Il grafo delle prove ha una sua schermata, «Grafo». Per leggere un messaggio originale si passa dallo Storico.");
                                            color: Palette.amber;
                                            font-size: Typography.technical;
                                            wrap: word-wrap;
                                        }

                                        // COLLEGARE PARTE DAL FASCICOLO, e
                                        // l'identificativo SI SCRIVE: non c'e'
                                        // un elenco da cui sceglierlo, ne' un
                                        // comando accanto alle persone
                                        // osservate.
                                        if soggetto.open: Rectangle {
                                            // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                            min-height: rip-93.preferred-height;
                                            rip-93 := HorizontalLayout {
                                                spacing: Spacing.sm;
                                                vertical-stretch: 0;

                                                HudButton {
                                                    label: root.person-linking == soggetto.id ? @tr("Lascia stare") : @tr("Collega un'identità osservata");
                                                    clicked => {
                                                        root.person-linking =
                                                            root.person-linking == soggetto.id ? 0 : soggetto.id;
                                                    }
                                                }
                                            }
                                        }

                                        if root.person-linking == soggetto.id: Rectangle {
                                            // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                            min-height: rip-94.preferred-height;
                                            rip-94 := VerticalLayout {
                                                spacing: Spacing.xs;

                                                Text {
                                                    text: @tr("Scrivi l'identificativo Telegram, non il nome: due persone possono chiamarsi allo stesso modo, e una può cambiare nome. Collegare è un'affermazione di fatto — che quell'identità è questa persona — e se è sbagliata tutto ciò che il fascicolo raccoglie riguarda qualcun altro.");
                                                    color: Palette.amber;
                                                    font-size: Typography.technical;
                                                    wrap: word-wrap;
                                                }

                                                HudInput {
                                                    placeholder: @tr("Identificativo osservato");
                                                    label: @tr("Identificativo Telegram da collegare, obbligatorio");
                                                    value <=> root.person-link-identifier;
                                                }

                                                HudCheck {
                                                    text: @tr("Sciogli invece di collegare");
                                                    checked <=> root.person-link-release;
                                                }

                                                HudInput {
                                                    placeholder: @tr("Perché questa identità è questa persona");
                                                    label: @tr("Motivo del collegamento, obbligatorio");
                                                    value <=> root.person-link-reason;
                                                }

                                                HudButton {
                                                    label: @tr("Registra");
                                                    clicked => {
                                                        root.link-identity(
                                                            soggetto.id,
                                                            root.person-link-identifier,
                                                            root.person-link-release,
                                                            root.person-link-reason,
                                                        );
                                                    }
                                                }
                                            }
                                        }

                                        // NOTE, RIFERIMENTI E NOMI OSSERVATI (ADR-0153, DG-08).
                                        //
                                        // Le note e i riferimenti sono atti di
                                        // una persona: chi, quando, perché. I
                                        // nomi osservati vengono dai contenuti e
                                        // NON sono identità: non cambiano il nome
                                        // del soggetto e non collegano nulla.
                                        Rectangle {
                                            vertical-stretch: 0;
                                            // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                            min-height: rip-184.preferred-height;
                                            rip-184 := VerticalLayout {
                                                spacing: Spacing.xs;

                                                Text {
                                                    text: @tr("NOTE E RIFERIMENTI");
                                                    color: Palette.text-muted;
                                                    font-size: Typography.group-label;
                                                    letter-spacing: Typography.track-eyebrow;
                                                }
                                                LegendaOrigini {
                                                    operatore: @tr("note e riferimenti: chi, quando, perché");
                                                }
                                                for voce in soggetto.entries: Rectangle {
                                                    vertical-stretch: 0;
                                                    // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                                    min-height: rip-185.preferred-height;
                                                    rip-185 := VerticalLayout {
                                                        spacing: 2px;
                                                        Text {
                                                            text: voce.sentence;
                                                            // Una voce ritirata resta, e si legge come tale.
                                                            color: voce.withdrawn ? Palette.text-muted : Palette.text;
                                                            font-size: Typography.body-secondary;
                                                            wrap: word-wrap;
                                                        }
                                                        // LA CONVERSAZIONE DEL CONTENUTO
                                                        // A CUI LA VOCE RIMANDA (ADR-0165,
                                                        // DG-01).
                                                        if voce.content-id > 0: HudButton {
                                                            label: @tr("Apri la conversazione");
                                                            clicked => {
                                                                root.conversation-open-requested(voce.content-id, "Persone");
                                                            }
                                                        }
                                                        if !voce.withdrawn && soggetto.open && voce.id > 0: HudButton {
                                                            label: @tr("Ritira questa voce");
                                                            clicked => {
                                                                root.person-withdraw-entry(voce.id, root.person-withdraw-reason);
                                                            }
                                                        }
                                                    }
                                                }
                                                if soggetto.entries.length == 0: Text {
                                                    text: @tr("Nessuna nota e nessun riferimento su questo soggetto.");
                                                    color: Palette.text-muted;
                                                    font-size: Typography.body-secondary;
                                                }
                                                if soggetto.open && soggetto.entries.length > 0: HudInput {
                                                    placeholder: @tr("Perché si ritira, almeno venti caratteri");
                                                    label: @tr("Motivo del ritiro di una voce");
                                                    value <=> root.person-withdraw-reason;
                                                }

                                                Text {
                                                    text: @tr("NOMI OSSERVATI DELLE IDENTITÀ COLLEGATE");
                                                    color: Palette.text-muted;
                                                    font-size: Typography.group-label;
                                                    letter-spacing: Typography.track-eyebrow;
                                                }
                                                OrigineSegno { origine: Origine.osservato; }
                                                for nome in soggetto.observed-names: Text {
                                                    text: nome;
                                                    color: Palette.text-muted;
                                                    font-size: Typography.technical;
                                                    wrap: word-wrap;
                                                }
                                                if soggetto.observed-names.length == 0: Text {
                                                    text: @tr("Nessuna identità collegata: non ci sono nomi osservati da mostrare.");
                                                    color: Palette.text-muted;
                                                    font-size: Typography.technical;
                                                    wrap: word-wrap;
                                                }
                                            }
                                        }

                                        if soggetto.open: Rectangle {
                                            // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                            min-height: rip-186.preferred-height;
                                            rip-186 := HorizontalLayout {
                                                spacing: Spacing.sm;
                                                vertical-stretch: 0;

                                                HudButton {
                                                    label: root.person-annotating == soggetto.id ? @tr("Lascia stare") : @tr("Aggiungi una nota o un riferimento");
                                                    clicked => {
                                                        root.person-annotating =
                                                            root.person-annotating == soggetto.id ? 0 : soggetto.id;
                                                    }
                                                }
                                            }
                                        }

                                        if root.person-annotating == soggetto.id: Rectangle {
                                            // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                            min-height: rip-187.preferred-height;
                                            rip-187 := VerticalLayout {
                                                spacing: Spacing.xs;

                                                HudInput {
                                                    placeholder: @tr("Che cosa si annota");
                                                    label: @tr("Nota sul soggetto");
                                                    value <=> root.person-note-draft;
                                                }
                                                HudButton {
                                                    label: @tr("Scrivi la nota");
                                                    clicked => {
                                                        root.person-write-note(soggetto.id, root.person-note-draft);
                                                    }
                                                }

                                                Text {
                                                    text: @tr("Oppure un riferimento: a che cosa, e perché riguarda questo soggetto.");
                                                    color: Palette.text-muted;
                                                    font-size: Typography.body-secondary;
                                                    wrap: word-wrap;
                                                }
                                                HorizontalLayout {
                                                    spacing: Spacing.sm;
                                                    HudButton {
                                                        label: @tr("Contenuto");
                                                        selected: root.person-ref-kind == 0;
                                                        clicked => { root.person-ref-kind = 0; }
                                                    }
                                                    HudButton {
                                                        label: @tr("Fonte");
                                                        selected: root.person-ref-kind == 1;
                                                        clicked => { root.person-ref-kind = 1; }
                                                    }
                                                    HudButton {
                                                        label: @tr("Rapporto");
                                                        selected: root.person-ref-kind == 2;
                                                        clicked => { root.person-ref-kind = 2; }
                                                    }
                                                    HudButton {
                                                        label: @tr("Documento esterno");
                                                        selected: root.person-ref-kind == 3;
                                                        clicked => { root.person-ref-kind = 3; }
                                                    }
                                                    Rectangle { horizontal-stretch: 1; background: transparent; }
                                                }
                                                HudInput {
                                                    placeholder: root.person-ref-kind == 3 ? @tr("Protocollo, atto, data") : @tr("Numero nell'archivio");
                                                    label: @tr("A che cosa si riferisce");
                                                    value <=> root.person-ref-target;
                                                }
                                                HudInput {
                                                    placeholder: @tr("Perché riguarda questo soggetto, almeno venti caratteri");
                                                    label: @tr("Motivo del riferimento, obbligatorio");
                                                    value <=> root.person-ref-reason;
                                                }
                                                HudButton {
                                                    label: @tr("Aggiungi il riferimento");
                                                    clicked => {
                                                        root.person-add-reference(
                                                            soggetto.id,
                                                            root.person-ref-kind,
                                                            root.person-ref-target,
                                                            root.person-ref-reason,
                                                        );
                                                    }
                                                }
                                            }
                                        }

                                        // VALUTARE VUOLE UN MOTIVO PROPRIO, e
                                        // il comando compare solo su un
                                        // fascicolo aperto: un soggetto chiuso
                                        // non si valuta, e l'archivio lo
                                        // rifiuterebbe.
                                        if soggetto.open: Rectangle {
                                            // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                            min-height: rip-95.preferred-height;
                                            rip-95 := HorizontalLayout {
                                                spacing: Spacing.sm;
                                                vertical-stretch: 0;

                                                HudButton {
                                                    label: root.person-assessing == soggetto.id ? @tr("Lascia stare") : @tr("Valuta questo soggetto");
                                                    clicked => {
                                                        root.person-assessing =
                                                            root.person-assessing == soggetto.id ? 0 : soggetto.id;
                                                    }
                                                }
                                            }
                                        }

                                        if root.person-assessing == soggetto.id: Rectangle {
                                            // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                            min-height: rip-96.preferred-height;
                                            rip-96 := VerticalLayout {
                                                spacing: Spacing.xs;

                                                Text {
                                                    text: @tr("Quale stato, e perché. Il motivo serve anche per ritirare: una valutazione ritirata in silenzio non dice se sia stata ritirata perché sbagliata o perché scomoda.");
                                                    color: Palette.amber;
                                                    font-size: Typography.technical;
                                                    wrap: word-wrap;
                                                }

                                                // I QUATTRO STATI, IN UN ELENCO
                                                // CHIUSO. Non c'e' un campo libero:
                                                // il congelamento ne prevede
                                                // quattro, e l'unico modo di non
                                                // averne cinque e' non poterli
                                                // scrivere.
                                                HudSelect {
                                                    model: [@tr("NON VALUTATO (ritira la valutazione)"), @tr("DA APPROFONDIRE"), @tr("DI INTERESSE"), @tr("PRIORITÀ ALTA")];
                                                    label: @tr("Stato da registrare per questo soggetto");
                                                    current-index <=> root.person-assessment-choice;
                                                }

                                                HudInput {
                                                    placeholder: @tr("Perché questo stato, per questo soggetto");
                                                    label: @tr("Motivo della valutazione, obbligatorio");
                                                    value <=> root.person-assessment-reason;
                                                }

                                                HudButton {
                                                    label: @tr("Registra la valutazione");
                                                    clicked => {
                                                        root.assess-person(
                                                            soggetto.id,
                                                            root.person-assessment-choice,
                                                            root.person-assessment-reason,
                                                        );
                                                    }
                                                }
                                            }
                                        }

                                        // CHIUDERE VUOLE A SUA VOLTA UNA
                                        // RAGIONE, e il comando compare solo su
                                        // un fascicolo aperto: l'archivio
                                        // rifiuterebbe l'altro caso, e un
                                        // comando che fallisce sempre insegna
                                        // che il programma non funziona.
                                        if soggetto.open: Rectangle {
                                            // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                            min-height: rip-97.preferred-height;
                                            rip-97 := HorizontalLayout {
                                                spacing: Spacing.sm;
                                                vertical-stretch: 0;

                                                HudButton {
                                                    label: root.person-closing == soggetto.id ? @tr("Lascia stare") : @tr("Chiudi questo soggetto");
                                                    clicked => {
                                                        root.person-closing =
                                                            root.person-closing == soggetto.id ? 0 : soggetto.id;
                                                    }
                                                }
                                                Rectangle { horizontal-stretch: 1; background: transparent; }
                                            }
                                        }

                                        if root.person-closing == soggetto.id: Rectangle {
                                            // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                            min-height: rip-98.preferred-height;
                                            rip-98 := VerticalLayout {
                                                spacing: Spacing.xs;
                                                vertical-stretch: 0;

                                                HudInput {
                                                    placeholder: @tr("Perché si chiude, per esteso");
                                                    label: @tr("Ragione della chiusura, obbligatoria");
                                                    value <=> root.person-closing-reason;
                                                }
                                                HudButton {
                                                    label: @tr("Chiudi il fascicolo");
                                                    clicked => {
                                                        root.close-person(soggetto.id, root.person-closing-reason);
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                                }
                            }
                        }
                    }

                    // ---------------------------------------------- Notifiche
                    //
                    // Le notifiche emesse, dalla piu' recente. Il centro le rivede
                    // in-app: mostra il contenuto per intero (DEC-105), e con quale
                    // riservatezza la notifica era apparsa sulla schermata bloccata.
                    if root.current-page == 13: Rectangle {
                        // Comparsa graduale della pagina: vedere la pagina 0 per il
                        // perche' la dissolvenza sia solo in entrata.
                        property <bool> entered: false;
                        opacity: 0.0;
                        init => {
                            self.entered = true;
                        }
                        animate opacity {
                            duration: Motion.transition-effective;
                            easing: cubic-bezier(0.16, 1, 0.3, 1);
                        }
        states [
            shown when self.entered: {
                opacity: 1.0;
            }
        ]
                        background: Palette.panel;
                        border-radius: Spacing.radius-panel;

                        VerticalLayout {
                            padding: Spacing.xl;
                            spacing: Spacing.lg;

                            VerticalLayout {
                                spacing: Spacing.xs;
                                vertical-stretch: 0;
                                Text {
                                    text: @tr("Notifiche emesse");
                                    color: Palette.text;
                                    font-size: Typography.screen-title;
                                    font-weight: Typography.medium;
                                }
                                Text {
                                    text: @tr("Le segnalazioni per cui è stata emessa una notifica, dalla più recente. Il centro le rivede: mostra il contenuto per intero, e con quale riservatezza la notifica è apparsa.");
                                    color: Palette.text-muted;
                                    font-size: Typography.body-secondary;
                                    wrap: word-wrap;
                                }
                            }

                            if root.notification-cards.length == 0: Rectangle {
                                background: Palette.panel-raised;
                                border-radius: Spacing.radius-row;
                                vertical-stretch: 1;
                                VerticalLayout {
                                    alignment: center;
                                    padding: Spacing.xl;
                                    spacing: Spacing.sm;
                                    Text {
                                        text: @tr("Nessuna notifica è ancora stata emessa.");
                                        color: Palette.text;
                                        font-size: Typography.section-title;
                                        font-weight: Typography.medium;
                                        horizontal-alignment: center;
                                    }
                                    Text {
                                        text: @tr("Le notifiche compaiono qui quando un monitoraggio in corso segnala un contenuto sopra la soglia impostata. L'elenco qui sotto si popola anche quando Windows non mostra l'avviso.");
                                        color: Palette.text-muted;
                                        font-size: Typography.body;
                                        horizontal-alignment: center;
                                        wrap: word-wrap;
                                    }
                                }
                            }

                            if root.notification-cards.length > 0: HudScroll {
                                VerticalLayout {
                                    spacing: Spacing.md;

                                    LegendaOrigini {
                                        osservato: @tr("fonte, estratto, collegamento");
                                        calcolato: @tr("livello, motivazione e ora");
                                        operatore: @tr("riservatezza scelta");
                                    }
                                    for card in root.notification-cards: Rectangle {
                                        background: Palette.panel-raised;
                                        border-radius: Spacing.radius-row;
                                        border-width: Spacing.hairline;
                                        border-color: Palette.line-divider;

                                        // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                        min-height: rip-99.preferred-height;
                                        rip-99 := VerticalLayout {
                                            padding: Spacing.lg;
                                            spacing: Spacing.sm;

                                            HorizontalLayout {
                                                spacing: Spacing.md;
                                                Text {
                                                    text: card.source;
                                                    color: Palette.text;
                                                    font-size: Typography.section-title;
                                                    font-weight: Typography.medium;
                                                    horizontal-stretch: 1;
                                                    wrap: word-wrap;
                                                }
                                                Text {
                                                    text: card.emitted;
                                                    color: Palette.text-muted;
                                                    font-size: Typography.body-secondary;
                                                    vertical-alignment: center;
                                                }
                                            }

                                            HorizontalLayout {
                                                spacing: Spacing.md;
                                                Text {
                                                    text: card.level-label;
                                                    color: Palette.amber;
                                                    font-size: Typography.body-secondary;
                                                    font-weight: Typography.medium;
                                                }
                                                Text {
                                                    text: @tr("Riservatezza: {}", card.privacy);
                                                    color: Palette.text-muted;
                                                    font-size: Typography.body-secondary;
                                                }
                                            }

                                            Text {
                                                text: card.reason;
                                                color: Palette.text;
                                                font-size: Typography.body;
                                                wrap: word-wrap;
                                            }
                                            // PERCHE' VEDO QUESTO (PR-02): una notifica e'
                                            // un avviso, e la risposta dice quale
                                            // regola lo ha fatto scattare.
                                            PercheVedoQuesto {
                                                elemento: card.source + ", " + card.emitted;
                                                chiesto => {
                                                    root.explain-this(Spiegabile.avviso, "", card.level-label + ", emesso " + card.emitted + ". Motivazione scritta allora: " + card.reason);
                                                }
                                            }
                                            Text {
                                                text: card.excerpt;
                                                color: Palette.text-muted;
                                                font-size: Typography.body;
                                                wrap: word-wrap;
                                            }
                                            if card.url != "": Rectangle {
                                                // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                                min-height: rip-100.preferred-height;
                                                rip-100 := HorizontalLayout {
                                                    spacing: Spacing.sm;
                                                    Text {
                                                        text: card.url;
                                                        color: Palette.cyan;
                                                        font-size: Typography.body-secondary;
                                                        vertical-alignment: center;
                                                        horizontal-stretch: 1;
                                                        wrap: word-wrap;
                                                    }
                                                    // Apertura sicura nel browser (ADR-0018).
                                                    HudButton {
                                                        label: @tr("Apri");
                                                        clicked => {
                                                            root.open-url(card.url);
                                                        }
                                                    }
                                                }
                                            }
                                        }

                                        accessible-role: text;
                                        accessible-label: card.source + ", " + card.level-label + ", " + card.emitted + ". " + card.reason;
                                    }
                                }
                            }
                        }
                    }

                    // ---------------------------------------------------- Report
                    //
                    // Il percorso che porta da una sessione monitorata a un
                    // pacchetto consegnabile, in sette passi.
                    //
                    // # La distinzione che questa schermata esiste per rendere
                    // # impossibile da perdere
                    //
                    // In alto restano sempre due numeri: quanto NEXUM/97 ha
                    // **monitorato** e quanto l'operatore ha **scelto di
                    // rappresentare**. Sono due cose diverse (ADR-0031
                    // Decisione 1), e una schermata che mostrasse solo la
                    // seconda farebbe credere che il programma abbia visto
                    // soltanto quello.
                    //
                    // Nessuna selezione nasce da sola. Il livello 4 non
                    // seleziona nulla, il filtro non seleziona nulla, e
                    // «Seleziona i contenuti visibili» seleziona solo perche'
                    // qualcuno lo ha premuto.
                    //
                    // # Perche' un percorso e non una pagina sola
                    //
                    // Sette gruppi di scelte in una schermata sola sarebbero
                    // un modulo. I passi si percorrono avanti e indietro e la
                    // selezione non si perde tornando: **nulla viene scritto
                    // finche' non si preme «Genera»**.

                    // ------------------------------------------------- Rule Lab
                    //
                    // # Che cosa questa schermata NON fa
                    //
                    // **Non pubblica niente e non scrive niente.** Il confronto
                    // e' a vuoto per costruzione: il modulo che lo calcola non
                    // conosce l'archivio (LAB-01, DEC-258). Se la modifica va
                    // pubblicata lo decide una persona, dalla schermata
                    // Dizionari.
                    //
                    // **Non dice se la modifica sia buona.** Dice che cosa
                    // I WORKSPACE OPERATIVI (WS-02).
                    //
                    // Contenitori di lavoro che RIFERISCONO SENZA COPIARE.
                    // Cio' che questa schermata mostra e' cio' che l'archivio
                    // dice adesso: le righe si rileggono a ogni apertura, e
                    // nulla di quel materiale e' conservato qui.
                    if root.current-page == 20: Rectangle {
                        // Comparsa graduale della pagina: vedere la pagina 0 per il
                        // perche' la dissolvenza sia solo in entrata.
                        property <bool> entered: false;
                        opacity: 0.0;
                        init => {
                            self.entered = true;
                        }
                        animate opacity {
                            duration: Motion.transition-effective;
                            easing: cubic-bezier(0.16, 1, 0.3, 1);
                        }
        states [
            shown when self.entered: {
                opacity: 1.0;
            }
        ]
                        background: Palette.panel;
                        border-radius: Spacing.radius-panel;

                        HudScroll {
                            VerticalLayout {
                                padding: Spacing.xl;
                                spacing: Spacing.lg;
                                alignment: start;

                                Text {
                                    text: @tr("Raccoglitori");
                                    color: Palette.text;
                                    font-size: Typography.screen-title;
                                    font-weight: Typography.medium;
                                }

                                Text {
                                    text: @tr("Un raccoglitore è un contenitore di lavoro: raccoglie riferimenti a fonti, contenuti e rapporti dell'archivio. Non ne conserva copie, e ciò che mostra è ciò che l'archivio dice adesso. Questi sono i raccoglitori di questa postazione; quelli che l'ufficio tiene insieme stanno in «Raccoglitori dell'ufficio».");
                                    color: Palette.text-muted;
                                    font-size: Typography.body-secondary;
                                    wrap: word-wrap;
                                }

                                if root.workspace-message != "": Text {
                                    text: root.workspace-message;
                                    color: Palette.amber;
                                    font-size: Typography.body-secondary;
                                    wrap: word-wrap;
                                }

                                // ------------------------------- aprirne uno
                                Text {
                                    // «Nuovo» e «Crea», non «Aprire» (SIM3-11): «Apri raccoglitore»
                                    // si leggeva come «apri uno esistente», e invece lo crea.
                                    text: @tr("NUOVO RACCOGLITORE");
                                    color: Palette.text-muted;
                                    font-size: Typography.group-label;
                                    letter-spacing: Typography.track-eyebrow;
                                }

                                HudInput {
                                    placeholder: @tr("Nome, obbligatorio: è come lo si chiamerà");
                                    label: @tr("Nome del raccoglitore");
                                    value <=> root.workspace-new-name;
                                }

                                HudInput {
                                    placeholder: @tr("A che cosa serve, facoltativa");
                                    label: @tr("Descrizione del raccoglitore");
                                    value <=> root.workspace-new-description;
                                }

                                HorizontalLayout {
                                    spacing: Spacing.sm;
                                    vertical-stretch: 0;

                                    HudButton {
                                        label: @tr("Crea il raccoglitore");
                                        clicked => {
                                            root.workspace-open(root.workspace-new-name, root.workspace-new-description);
                                        }
                                    }
                                    Rectangle { horizontal-stretch: 1; background: transparent; }
                                }

                                // ------------------------------- l'elenco
                                Text {
                                    text: @tr("I RACCOGLITORI");
                                    color: Palette.text-muted;
                                    font-size: Typography.group-label;
                                    letter-spacing: Typography.track-eyebrow;
                                }

                                if root.workspace-rows.length == 0: Text {
                                    text: @tr("Nessun raccoglitore è stato aperto su questa postazione.");
                                    color: Palette.text-muted;
                                    font-size: Typography.body-secondary;
                                    wrap: word-wrap;
                                }

                                LegendaOrigini {
                                    operatore: @tr("nome e stato");
                                }
                                for riga in root.workspace-rows: SelectableRow {
                                    selected: riga.id == root.workspace-selected;
                                    // L'etichetta accessibile dice il nome e lo
                                    // stato: chi non vede il colore deve sapere
                                    // se il contenitore sia ancora in
                                    // lavorazione.
                                    name: riga.name + ", " + (riga.open ? @tr("in lavorazione") : @tr("chiuso"));
                                    chosen => {
                                        root.workspace-select(riga.id);
                                    }

                                    VerticalLayout {
                                        padding: Spacing.md;
                                        spacing: 2px;

                                        HorizontalLayout {
                                            spacing: Spacing.sm;

                                            Text {
                                                text: riga.name;
                                                color: Palette.text;
                                                font-size: Typography.body;
                                                horizontal-stretch: 1;
                                            }
                                            // Lo stato si legge a parole, non
                                            // solo con un colore: un colore non
                                            // e' leggibile da tutti e non si
                                            // stampa.
                                            Text {
                                                text: riga.open ? @tr("in lavorazione") : @tr("chiuso");
                                                color: riga.open ? Palette.cyan : Palette.text-muted;
                                                font-family: Typography.mono;
                                                font-size: Typography.technical;
                                            }
                                        }
                                        // LA FRASE LA COMPONE IL MODELLO.
                                        Text {
                                            text: riga.sentence;
                                            color: Palette.text-muted;
                                            font-size: Typography.technical;
                                            wrap: word-wrap;
                                        }
                                    }
                                }

                                // ------------------------------- il contenuto del selezionato
                                if root.workspace-selected > 0: Text {
                                    text: @tr("CHE COSA HA RACCOLTO «{}»", root.workspace-selected-name);
                                    color: Palette.text-muted;
                                    font-size: Typography.group-label;
                                    letter-spacing: Typography.track-eyebrow;
                                }

                                if root.workspace-selected > 0 && root.workspace-entries.length == 0: Text {
                                    text: @tr("Non ha ancora raccolto nulla. Si raccoglie dove il materiale è: dallo Storico, davanti al contenuto.");
                                    color: Palette.text-muted;
                                    font-size: Typography.body-secondary;
                                    wrap: word-wrap;
                                }

                                // OGNI RIGA COMPARE, COMPRESA QUELLA CHE NON
                                // ARRIVA PIU' A NULLA: nasconderla direbbe che
                                // quella cosa non e' mai stata raccolta.
                                LegendaOrigini {
                                    osservato: @tr("l'elemento raccolto");
                                    operatore: @tr("chi l'ha aggiunto e quando");
                                }
                                for voce in root.workspace-entries: Rectangle {
                                    vertical-stretch: 0;
                                    background: transparent;

                                    // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                    min-height: rip-101.preferred-height;
                                    rip-101 := VerticalLayout {
                                        padding-left: Spacing.md;
                                        padding-top: Spacing.xs;
                                        padding-bottom: Spacing.xs;
                                        spacing: 2px;

                                        Text {
                                            text: voce.sentence;
                                            // In ambra quando il riferimento
                                            // non arriva piu' a nulla: e' un
                                            // fatto che chi legge deve vedere,
                                            // e la frase lo dice comunque.
                                            color: voce.present ? Palette.text : Palette.amber;
                                            font-size: Typography.body-secondary;
                                            wrap: word-wrap;
                                        }
                                        Text {
                                            text: voce.added;
                                            color: Palette.text-muted;
                                            font-family: Typography.mono;
                                            font-size: Typography.technical;
                                        }

                                        // LA CONVERSAZIONE DI UN CONTENUTO RACCOLTO
                                        // (ADR-0151): soltanto per un contenuto che
                                        // c'e' ancora. Raccogliere riferisce senza
                                        // copiare, e la pagina legge l'archivio.
                                        if voce.kind == "contenuto" && voce.present: HudButton {
                                            label: @tr("Conversazione");
                                            clicked => {
                                                root.conversation-open-requested(voce.target-id, "Raccoglitori");
                                            }
                                        }

                                        // I COMANDI CHE SCRIVONO COMPAIONO
                                        // SOLO SU UN WORKSPACE IN LAVORAZIONE.
                                        //
                                        // Su uno chiuso l'archivio li
                                        // rifiuterebbe, e un comando che
                                        // fallisce sempre insegna che il
                                        // programma non funziona.
                                        if root.workspace-selected-open: Rectangle {
                                            // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                            min-height: rip-102.preferred-height;
                                            rip-102 := HorizontalLayout {
                                                spacing: Spacing.sm;
                                                vertical-stretch: 0;

                                                HudButton {
                                                    label: @tr("Togli il riferimento");
                                                    clicked => {
                                                        root.workspace-remove(voce.kind, voce.target-id);
                                                    }
                                                }
                                                Rectangle { horizontal-stretch: 1; background: transparent; }
                                            }
                                        }
                                    }
                                }

                                // ------------------------------- pacchetto di evidenze
                                //
                                // PR-11, ADR-0127. Esce soltanto cio' che una
                                // persona spunta, e l'anteprima lo dice PRIMA di
                                // produrre. Il nome non promette cio' che il
                                // pacchetto non e'.
                                if root.workspace-selected > 0 && root.evidence-choices.length > 0: Rectangle {
                                    // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                    min-height: rip-103.preferred-height;
                                    rip-103 := VerticalLayout {
                                        spacing: Spacing.sm;
                                        vertical-stretch: 0;

                                        Text {
                                            text: @tr("PACCHETTO DI EVIDENZE");
                                            color: Palette.text-muted;
                                            font-size: Typography.group-label;
                                            letter-spacing: Typography.track-eyebrow;
                                        }
                                        Text {
                                            text: @tr("Un pacchetto unico e verificabile con i contenuti scelti qui, la loro provenienza, quando le fonti erano seguite e l'elenco delle impronte. Esce soltanto ciò che si spunta.");
                                            color: Palette.text-muted;
                                            font-size: Typography.body-secondary;
                                            wrap: word-wrap;
                                        }
                                        AvvertenzaDiSicurezza {
                                            codice: "SIC-16";
                                            testo: @tr("Questo pacchetto non è una prova forense e non è una perizia. Il programma non fa acquisizione forense, e non ne ha la catena di custodia.");
                                            dettaglio: @tr("Il pacchetto riunisce i contenuti scelti, la loro provenienza e un manifest di impronte. Il manifest dice che i file sono quelli prodotti, non chi li ha prodotti.");
                                        }
                                        // IN ESERCITAZIONE LO DICE PRIMA, NON DOPO (UX-EXCELLENCE-02,
                                        // SIM3-10). Il modulo era attivo, e «non si prova in
                                        // Esercitazione» arrivava solo dopo aver spuntato e scritto
                                        // la ragione. Ora la frase sta in cima, la ragione e il
                                        // comando sono spenti; le spunte restano, per vedere che
                                        // cosa il pacchetto conterrebbe. Nulla di reale si abilita
                                        // in Esercitazione.
                                        if root.exercise-mode: InfoBanner {
                                            message: @tr("In Esercitazione il pacchetto di evidenze non si produce: si può spuntare per vedere che cosa conterrebbe, ma non esce nulla. Si produce sulla postazione operativa.");
                                        }
                                        LegendaOrigini {
                                            osservato: @tr("il contenuto");
                                            operatore: @tr("la scelta");
                                        }
                                        for scelta in root.evidence-choices: HudCheck {
                                            text: scelta.sentence;
                                            description: @tr("Spuntato, esce nel pacchetto");
                                            checked: scelta.chosen;
                                            toggled => {
                                                root.evidence-toggle(scelta.content-id);
                                            }
                                        }
                                        // Sempre una riga, anche senza spunte (SIM3-10): la
                                        // frase che compariva e spariva cambiava l'altezza
                                        // della pagina, e con la pagina in fondo le righe si
                                        // spostavano sotto il puntatore.
                                        Text {
                                            text: root.evidence-preview != "" ? root.evidence-preview : @tr("Nessun contenuto spuntato: il pacchetto sarebbe vuoto.");
                                            color: root.evidence-preview != "" ? Palette.text : Palette.text-muted;
                                            font-size: Typography.body-secondary;
                                            wrap: word-wrap;
                                        }
                                        // GLI ALLEGATI CONSERVATI (ATTACH-01, ADR-0177): escono
                                        // soltanto se si spunta, ciascuno con il nome della sua
                                        // impronta; il manifest dice nome e tipo dichiarati.
                                        HudCheck {
                                            text: @tr("Includi gli allegati conservati dei contenuti spuntati");
                                            description: @tr("Escono come file con il nome dell'impronta, mai con quello dichiarato. Il programma non li ha aperti.");
                                            checked <=> root.evidence-with-attachments;
                                            enabled: !root.exercise-mode;
                                        }
                                        HudInput {
                                            label: @tr("Perché esce");
                                            placeholder: @tr("La ragione per cui questo materiale lascia l'ufficio");
                                            value <=> root.evidence-reason;
                                            enabled: !root.exercise-mode;
                                        }
                                        HorizontalLayout {
                                            vertical-stretch: 0;
                                            HudButton {
                                                label: @tr("Produci il pacchetto di evidenze");
                                                weight: Weight.primary;
                                                enabled: !root.exercise-mode && root.evidence-reason != "" && root.evidence-preview != "";
                                                reason: root.exercise-mode ? @tr("In Esercitazione il pacchetto non si produce.") : "";
                                                clicked => {
                                                    root.evidence-produce();
                                                }
                                            }
                                            Rectangle { horizontal-stretch: 1; background: transparent; }
                                        }
                                        if root.evidence-message != "": InfoBanner {
                                            message: root.evidence-message;
                                        }
                                        // LA COPIA CIFRATA PER CHI RICEVE (ENCRYPT-02,
                                        // ADR-0190): dell'ultimo pacchetto prodotto qui.
                                        if root.evidence-produced: Rectangle {
                                            // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                            min-height: rip-199.preferred-height;
                                            rip-199 := HorizontalLayout {
                                                spacing: Spacing.md;
                                                vertical-stretch: 0;
                                                alignment: start;
                                                HudButton {
                                                    label: @tr("Copia cifrata per chi riceve…");
                                                    clicked => {
                                                        root.recipient-choose();
                                                    }
                                                }
                                                if root.recipient-ready: HudButton {
                                                    label: @tr("Cifra per questo certificato");
                                                    weight: Weight.primary;
                                                    clicked => {
                                                        root.recipient-encrypt("evidenze");
                                                    }
                                                }
                                            }
                                        }
                                        if root.evidence-produced && root.recipient-line != "": Text {
                                            text: root.recipient-line;
                                            color: Palette.text;
                                            font-size: Typography.body-secondary;
                                            vertical-stretch: 0;
                                            wrap: word-wrap;
                                        }
                                        if root.evidence-produced && root.recipient-message != "": Text {
                                            text: root.recipient-message;
                                            color: Palette.text;
                                            font-size: Typography.body-secondary;
                                            vertical-stretch: 0;
                                            wrap: word-wrap;
                                        }
                                        LegendaOrigini {
                                            calcolato: @tr("identificativo, istante, quanti");
                                            operatore: @tr("chi e perché");
                                        }
                                        for pacchetto in root.evidence-packages: Text {
                                            text: @tr("{} — {}, {}, {}. Motivo: {}", pacchetto.reference, pacchetto.when, pacchetto.who, pacchetto.count, pacchetto.motive);
                                            color: Palette.text-muted;
                                            font-size: Typography.technical;
                                            wrap: word-wrap;
                                        }
                                    }
                                }

                                // ------------------------------- chiudere
                                if root.workspace-selected > 0 && root.workspace-selected-open: Text {
                                    text: @tr("Chiudere un raccoglitore lo conclude: non accetterà né perderà elementi, e non si riapre. Se il lavoro continua, crearne un altro.");
                                    color: Palette.text-muted;
                                    font-size: Typography.body-secondary;
                                    wrap: word-wrap;
                                }

                                if root.workspace-selected > 0 && root.workspace-selected-open: Rectangle {
                                    // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                    min-height: rip-104.preferred-height;
                                    rip-104 := HorizontalLayout {
                                        spacing: Spacing.sm;
                                        vertical-stretch: 0;

                                        HudButton {
                                            label: @tr("Chiudi questo raccoglitore");
                                            clicked => {
                                                root.workspace-close(root.workspace-selected);
                                            }
                                        }
                                        Rectangle { horizontal-stretch: 1; background: transparent; }
                                    }
                                }

                                // LE NOTE SU QUESTO WORKSPACE (NOTE-01).
                                //
                                // Lo stesso pannello del contenuto: due copie
                                // divergerebbero il giorno in cui una regola
                                // cambia.
                                //
                                // COMPARE ANCHE SU UN WORKSPACE CHIUSO, e si
                                // puo' scrivere. Chiudere un workspace conclude
                                // il LAVORO — non accetta ne' perde elementi —
                                // ma una nota non e' un elemento raccolto: e'
                                // cio' che qualcuno ha da dire su quel lavoro,
                                // e spesso lo si ha da dire proprio dopo averlo
                                // concluso.
                                if root.workspace-selected > 0: NotesPanel {
                                    rows: root.workspace-notes;
                                    draft <=> root.workspace-note-draft;
                                    message: root.workspace-note-message;
                                    subject: @tr("questo raccoglitore");
                                    write(testo) => {
                                        root.workspace-write-note(testo);
                                    }
                                    withdraw(id) => {
                                        root.withdraw-note(id);
                                    }
                                }
                            }
                        }
                    }

                    // SEGNALIBRI E RACCOLTE (BOOK-01).
                    //
                    // Qui non si segna: si segna DOVE IL MATERIALE E', dallo
                    // Storico, con un gesto solo. Questa schermata serve a
                    // RITROVARE cio' che si e' segnato e a riordinarlo.
                    if root.current-page == 21: Rectangle {
                        // Comparsa graduale della pagina: vedere la pagina 0 per il
                        // perche' la dissolvenza sia solo in entrata.
                        property <bool> entered: false;
                        opacity: 0.0;
                        init => {
                            self.entered = true;
                        }
                        animate opacity {
                            duration: Motion.transition-effective;
                            easing: cubic-bezier(0.16, 1, 0.3, 1);
                        }
        states [
            shown when self.entered: {
                opacity: 1.0;
            }
        ]
                        background: Palette.panel;
                        border-radius: Spacing.radius-panel;

                        HudScroll {
                            VerticalLayout {
                                padding: Spacing.xl;
                                spacing: Spacing.lg;
                                alignment: start;

                                Text {
                                    text: @tr("Segnalibri");
                                    color: Palette.text;
                                    font-size: Typography.screen-title;
                                    font-weight: Typography.medium;
                                }

                                Text {
                                    text: @tr("Un segnalibro è un segno: «questo lo ritrovo». Si mette dallo Storico, con un gesto solo, davanti al materiale. Riferisce ciò che c'è nell'archivio e non ne conserva copie: quello che si legge qui è ciò che l'archivio dice adesso.");
                                    color: Palette.text-muted;
                                    font-size: Typography.body-secondary;
                                    wrap: word-wrap;
                                }

                                if root.bookmark-message != "": Text {
                                    text: root.bookmark-message;
                                    color: Palette.amber;
                                    font-size: Typography.body-secondary;
                                    wrap: word-wrap;
                                }

                                // ------------------------------- le raccolte
                                Text {
                                    text: @tr("LE RACCOLTE");
                                    color: Palette.text-muted;
                                    font-size: Typography.group-label;
                                    letter-spacing: Typography.track-eyebrow;
                                }

                                Text {
                                    text: @tr("Una raccolta è un'etichetta, non un lavoro che si conclude: non si apre e non si chiude. Un segnalibro può starne fuori, ed è il caso ordinario.");
                                    color: Palette.text-muted;
                                    font-size: Typography.technical;
                                    wrap: word-wrap;
                                }

                                // TUTTI, compresi gli sciolti: e' cio' che si
                                // guarda entrando, perche' chi cerca qualcosa
                                // che ha segnato non ricorda in quale raccolta
                                // l'aveva messo — o non l'aveva messo affatto.
                                SelectableRow {
                                    selected: root.bookmark-collection-selected == 0;
                                    name: @tr("Tutti i segnalibri");
                                    chosen => {
                                        root.bookmark-choose-collection(0);
                                    }

                                    VerticalLayout {
                                        padding: Spacing.md;

                                        Text {
                                            text: @tr("Tutti i segnalibri");
                                            color: Palette.text;
                                            font-size: Typography.body;
                                        }
                                    }
                                }

                                LegendaOrigini {
                                    calcolato: @tr("numero di segni");
                                    operatore: @tr("nome e data");
                                }
                                for raccolta in root.bookmark-collections: SelectableRow {
                                    selected: raccolta.id == root.bookmark-collection-selected;
                                    // L'etichetta accessibile dice il nome e
                                    // quanti: chi non vede la riga a destra
                                    // deve sapere che cosa sta scegliendo.
                                    name: @tr("{}, {} segnalibri", raccolta.name, raccolta.count);
                                    chosen => {
                                        root.bookmark-choose-collection(raccolta.id);
                                    }

                                    VerticalLayout {
                                        padding: Spacing.md;
                                        spacing: 2px;

                                        HorizontalLayout {
                                            spacing: Spacing.sm;

                                            Text {
                                                text: raccolta.name;
                                                color: Palette.text;
                                                font-size: Typography.body;
                                                horizontal-stretch: 1;
                                            }
                                            // QUANTI, sempre: chi sta per
                                            // cancellarla deve sapere quanto
                                            // lavoro ha davanti prima di
                                            // provarci.
                                            Text {
                                                text: @tr("{} segnalibri", raccolta.count);
                                                color: Palette.text-muted;
                                                font-family: Typography.mono;
                                                font-size: Typography.technical;
                                            }
                                        }
                                        Text {
                                            text: raccolta.created;
                                            color: Palette.text-muted;
                                            font-family: Typography.mono;
                                            font-size: Typography.technical;
                                        }

                                        // CANCELLARE SOLO SE E' VUOTA.
                                        //
                                        // L'archivio rifiuta comunque, con un
                                        // trigger. Il comando non compare
                                        // quando fallirebbe sempre: un comando
                                        // cosi' insegna che il programma non
                                        // funziona.
                                        if raccolta.count == 0: Rectangle {
                                            // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                            min-height: rip-105.preferred-height;
                                            rip-105 := HorizontalLayout {
                                                spacing: Spacing.sm;
                                                vertical-stretch: 0;

                                                HudButton {
                                                    label: @tr("Cancella questa raccolta");
                                                    clicked => {
                                                        root.bookmark-delete-collection(raccolta.id);
                                                    }
                                                }
                                                Rectangle { horizontal-stretch: 1; background: transparent; }
                                            }
                                        }
                                    }
                                }

                                HudInput {
                                    placeholder: @tr("Nome di una nuova raccolta");
                                    label: @tr("Nome della raccolta");
                                    value <=> root.bookmark-new-collection-name;
                                }

                                HorizontalLayout {
                                    spacing: Spacing.sm;
                                    vertical-stretch: 0;

                                    HudButton {
                                        label: @tr("Crea la raccolta");
                                        clicked => {
                                            root.bookmark-create-collection(root.bookmark-new-collection-name);
                                        }
                                    }
                                    Rectangle { horizontal-stretch: 1; background: transparent; }
                                }

                                // ------------------------------- i segnalibri
                                Text {
                                    text: @tr("CHE COSA È SEGNATO");
                                    color: Palette.text-muted;
                                    font-size: Typography.group-label;
                                    letter-spacing: Typography.track-eyebrow;
                                }

                                if root.bookmark-rows.length == 0: Text {
                                    text: @tr("Non c'è nulla di segnato qui. Si segna dove il materiale è: dallo Storico, davanti al contenuto, con un gesto solo.");
                                    color: Palette.text-muted;
                                    font-size: Typography.body-secondary;
                                    wrap: word-wrap;
                                }

                                // OGNI RIGA COMPARE, COMPRESA QUELLA CHE NON
                                // ARRIVA PIU' A NULLA: nasconderla direbbe che
                                // quella cosa non e' mai stata segnata.
                                LegendaOrigini {
                                    osservato: @tr("la cosa segnata");
                                    operatore: @tr("raccolta");
                                }
                                for segno in root.bookmark-rows: Rectangle {
                                    vertical-stretch: 0;
                                    background: transparent;

                                    // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                    min-height: rip-106.preferred-height;
                                    rip-106 := VerticalLayout {
                                        padding-left: Spacing.md;
                                        padding-top: Spacing.xs;
                                        padding-bottom: Spacing.xs;
                                        spacing: 2px;

                                        Text {
                                            text: segno.sentence;
                                            // In ambra quando il riferimento
                                            // non arriva piu' a nulla: e' un
                                            // fatto che chi legge deve vedere,
                                            // e la frase lo dice comunque.
                                            color: segno.present ? Palette.text : Palette.amber;
                                            font-size: Typography.body-secondary;
                                            wrap: word-wrap;
                                        }
                                        Text {
                                            text: segno.collection-name == "" ? @tr("{}, in nessuna raccolta", segno.marked) : @tr("{}, in «{}»", segno.marked, segno.collection-name);
                                            color: Palette.text-muted;
                                            font-family: Typography.mono;
                                            font-size: Typography.technical;
                                            wrap: word-wrap;
                                        }

                                        HorizontalLayout {
                                            spacing: Spacing.sm;
                                            vertical-stretch: 0;

                                            // RIORDINARE E' UN SECONDO ATTO.
                                            //
                                            // Chi segna non sceglie dove: se
                                            // l'appartenenza si decidesse
                                            // soltanto al momento del segno, le
                                            // raccolte sarebbero una capacita'
                                            // che nulla raggiunge.
                                            if root.bookmark-collections.length > 0: HudButton {
                                                label: root.bookmark-filing == segno.id ? @tr("Lascia stare") : @tr("Metti in una raccolta");
                                                clicked => {
                                                    root.bookmark-filing =
                                                        root.bookmark-filing == segno.id ? 0 : segno.id;
                                                }
                                            }
                                            // LA CONVERSAZIONE DI UN CONTENUTO SEGNATO
                                            // (ADR-0151), se c'e' ancora.
                                            if segno.kind == "contenuto" && segno.present: HudButton {
                                                label: @tr("Conversazione");
                                                clicked => {
                                                    root.conversation-open-requested(segno.target-id, "Segnalibri");
                                                }
                                            }
                                            HudButton {
                                                label: @tr("Togli il segno");
                                                clicked => {
                                                    root.bookmark-remove(segno.id);
                                                }
                                            }
                                            Rectangle { horizontal-stretch: 1; background: transparent; }
                                        }

                                        // DOVE METTERLO: le raccolte che ci
                                        // sono, piu' «nessuna». Le scelte sono
                                        // quelle che esistono adesso, non un
                                        // campo in cui scrivere un nome che
                                        // potrebbe non corrispondere a nulla.
                                        if root.bookmark-filing == segno.id: Rectangle {
                                            // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                            min-height: rip-107.preferred-height;
                                            rip-107 := VerticalLayout {
                                                padding-left: Spacing.md;
                                                spacing: Spacing.xs;
                                                vertical-stretch: 0;

                                                if segno.collection-id != 0: HudButton {
                                                    label: @tr("Toglilo dalla raccolta");
                                                    clicked => {
                                                        root.bookmark-file-into(segno.id, 0);
                                                    }
                                                }

                                                LegendaOrigini {
                                                    calcolato: @tr("numero di segni");
                                                    operatore: @tr("nome e data");
                                                }
                                                for raccolta in root.bookmark-collections: HudButton {
                                                    label: @tr("Mettilo in «{}»", raccolta.name);
                                                    clicked => {
                                                        root.bookmark-file-into(segno.id, raccolta.id);
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }


                    // LE NOTE, TUTTE INSIEME (NOTE-01).
                    //
                    // Qui NON si scrive: si scrive dove il materiale e' —
                    // davanti a un contenuto, dentro un workspace. Chiedere qui
                    // di indicare su che cosa vorrebbe dire chiedere di
                    // trascrivere un identificativo, cioe' il lavoro che il
                    // programma deve fare.
                    //
                    // Questa schermata serve a RILEGGERE: «che cosa ho
                    // annotato», che nessuna schermata di materiale puo'
                    // rispondere.
                    if root.current-page == 22: Rectangle {
                        // Comparsa graduale della pagina: vedere la pagina 0 per il
                        // perche' la dissolvenza sia solo in entrata.
                        property <bool> entered: false;
                        opacity: 0.0;
                        init => {
                            self.entered = true;
                        }
                        animate opacity {
                            duration: Motion.transition-effective;
                            easing: cubic-bezier(0.16, 1, 0.3, 1);
                        }
        states [
            shown when self.entered: {
                opacity: 1.0;
            }
        ]
                        background: Palette.panel;
                        border-radius: Spacing.radius-panel;

                        HudScroll {
                            VerticalLayout {
                                padding: Spacing.xl;
                                spacing: Spacing.lg;
                                alignment: start;

                                Text {
                                    text: @tr("Note");
                                    color: Palette.text;
                                    font-size: Typography.screen-title;
                                    font-weight: Typography.medium;
                                }

                                Text {
                                    text: @tr("Le note sono ciò che una persona ha annotato a proposito di qualcosa che sta nell'archivio. Non modificano mai il materiale originale: stanno accanto, e dicono chi le ha scritte e quando. Si scrivono dove il materiale è — davanti a un contenuto nello Storico, dentro un raccoglitore — e si rileggono qui.");
                                    color: Palette.text-muted;
                                    font-size: Typography.body-secondary;
                                    wrap: word-wrap;
                                }

                                Text {
                                    text: @tr("Una nota non si riscrive: porta chi l'ha scritta e quando, e cambiarne il testo farebbe dire a quei due valori una cosa falsa. Si ritira, e se ne scrive un'altra. La nota ritirata resta visibile, perché qualcuno può averci lavorato sopra.");
                                    color: Palette.text-muted;
                                    font-size: Typography.technical;
                                    wrap: word-wrap;
                                }

                                if root.note-message != "": Text {
                                    text: root.note-message;
                                    color: Palette.amber;
                                    font-size: Typography.body-secondary;
                                    wrap: word-wrap;
                                }

                                Text {
                                    text: @tr("CHE COSA È ANNOTATO");
                                    color: Palette.text-muted;
                                    font-size: Typography.group-label;
                                    letter-spacing: Typography.track-eyebrow;
                                }

                                if root.note-rows.length == 0: Text {
                                    text: @tr("Nessuna nota è stata scritta su questa postazione. Si scrive dove il materiale è: davanti a un contenuto, o dentro un raccoglitore.");
                                    color: Palette.text-muted;
                                    font-size: Typography.body-secondary;
                                    wrap: word-wrap;
                                }

                                // OGNI NOTA COMPARE, COMPRESE LE RITIRATE E
                                // QUELLE IL CUI RIFERIMENTO NON ARRIVA PIU' A
                                // NULLA: nasconderle direbbe che quella cosa
                                // non e' mai stata annotata.
                                LegendaOrigini {
                                    osservato: @tr("a che cosa si riferisce");
                                    operatore: @tr("la nota, chi l'ha scritta e quando");
                                }
                                for nota in root.note-rows: Rectangle {
                                    vertical-stretch: 0;
                                    background: transparent;

                                    // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                    min-height: rip-108.preferred-height;
                                    rip-108 := VerticalLayout {
                                        padding-left: Spacing.md;
                                        padding-top: Spacing.xs;
                                        padding-bottom: Spacing.xs;
                                        spacing: 2px;

                                        // SU CHE COSA, PRIMA DELLE PAROLE.
                                        //
                                        // Qui le note vengono da posti diversi,
                                        // e leggerne una senza sapere di che
                                        // cosa parla non serve a niente.
                                        Text {
                                            text: nota.target;
                                            color: nota.present ? Palette.cyan : Palette.amber;
                                            font-family: Typography.mono;
                                            font-size: Typography.technical;
                                            wrap: word-wrap;
                                        }
                                        Text {
                                            text: nota.body;
                                            color: nota.stands ? Palette.text : Palette.text-muted;
                                            font-size: Typography.body-secondary;
                                            wrap: word-wrap;
                                        }
                                        Text {
                                            text: nota.sentence;
                                            color: nota.stands ? Palette.text-muted : Palette.amber;
                                            font-family: Typography.mono;
                                            font-size: Typography.technical;
                                            wrap: word-wrap;
                                        }

                                        if nota.stands: Rectangle {
                                            // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                            min-height: rip-109.preferred-height;
                                            rip-109 := HorizontalLayout {
                                                spacing: Spacing.sm;
                                                vertical-stretch: 0;

                                                HudButton {
                                                    label: @tr("Ritira questa nota");
                                                    clicked => {
                                                        root.withdraw-note(nota.id);
                                                    }
                                                }
                                                Rectangle { horizontal-stretch: 1; background: transparent; }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // LE RICERCHE SALVATE (SEARCH-01).
                    //
                    // Qui NON si cerca e NON si salva: si salva dove si cerca,
                    // cioe' nello Storico, davanti al risultato che si sta
                    // guardando. Chiedere qui di ricostruire la domanda
                    // produrrebbe ricerche diverse da quella che si aveva
                    // davanti, senza che nulla lo dica.
                    //
                    // E NON C'E' UNA LISTA DI RISULTATI: rifare applica il
                    // filtro allo Storico e ci porta. Una seconda lista sarebbe
                    // una seconda nozione di ricerca.
                    if root.current-page == 23: Rectangle {
                        // Comparsa graduale della pagina: vedere la pagina 0 per il
                        // perche' la dissolvenza sia solo in entrata.
                        property <bool> entered: false;
                        opacity: 0.0;
                        init => {
                            self.entered = true;
                        }
                        animate opacity {
                            duration: Motion.transition-effective;
                            easing: cubic-bezier(0.16, 1, 0.3, 1);
                        }
        states [
            shown when self.entered: {
                opacity: 1.0;
            }
        ]
                        background: Palette.panel;
                        border-radius: Spacing.radius-panel;

                        HudScroll {
                            VerticalLayout {
                                padding: Spacing.xl;
                                spacing: Spacing.lg;
                                alignment: start;

                                Text {
                                    text: @tr("Ricerche salvate");
                                    color: Palette.text;
                                    font-size: Typography.screen-title;
                                    font-weight: Typography.medium;
                                }

                                Text {
                                    text: @tr("Una ricerca salvata è una domanda che qualcuno ha già posto e vuole riporre. Si salva nello Storico, davanti al risultato che si sta guardando, e si rifà da qui.");
                                    color: Palette.text-muted;
                                    font-size: Typography.body-secondary;
                                    wrap: word-wrap;
                                }

                                // IL FATTO CHE QUESTA SCHERMATA DEVE DIRE.
                                //
                                // Chi rifà una ricerca si aspetta lo stesso
                                // risultato. Non lo otterra' mai, e la ragione
                                // meno visibile e' che i livelli sono stati
                                // prodotti da UNA VERSIONE DEL MOTORE: se
                                // quella cambia, due esecuzioni della stessa
                                // domanda misurano con metri diversi.
                                Text {
                                    text: @tr("Rifare una ricerca non riproduce il risultato di allora: è arrivato materiale nuovo, altro è stato modificato, e le decisioni delle persone sono cambiate. C'è una ragione in più, meno visibile: i livelli non si ricalcolano, li ha prodotti una versione del motore di analisi. Rifacendo una ricerca il programma dice quante righe furono valutate da una versione diversa, e quante non registrano affatto quale motore le abbia valutate.");
                                    color: Palette.text-muted;
                                    font-size: Typography.technical;
                                    wrap: word-wrap;
                                }

                                if root.saved-search-message != "": Text {
                                    text: root.saved-search-message;
                                    color: Palette.amber;
                                    font-size: Typography.body-secondary;
                                    wrap: word-wrap;
                                }

                                Text {
                                    text: @tr("LE RICERCHE SALVATE");
                                    color: Palette.text-muted;
                                    font-size: Typography.group-label;
                                    letter-spacing: Typography.track-eyebrow;
                                }

                                if root.saved-search-rows.length == 0: Text {
                                    text: @tr("Nessuna ricerca è stata salvata su questa postazione. Si salva nello Storico: si imposta la ricerca, le si dà un nome, e la si salva.");
                                    color: Palette.text-muted;
                                    font-size: Typography.body-secondary;
                                    wrap: word-wrap;
                                }

                                LegendaOrigini {
                                    operatore: @tr("nome e ricerca");
                                }
                                for ricerca in root.saved-search-rows: Rectangle {
                                    vertical-stretch: 0;
                                    background: transparent;

                                    // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                    min-height: rip-110.preferred-height;
                                    rip-110 := VerticalLayout {
                                        padding-left: Spacing.md;
                                        padding-top: Spacing.xs;
                                        padding-bottom: Spacing.xs;
                                        spacing: 2px;

                                        Text {
                                            text: ricerca.name;
                                            color: Palette.text;
                                            font-size: Typography.body;
                                            wrap: word-wrap;
                                        }
                                        // LA FRASE LA COMPONE IL MODELLO: dice
                                        // chi l'ha salvata, quando, e che cosa
                                        // chiede — per esteso, non a sigle.
                                        Text {
                                            text: ricerca.sentence;
                                            color: Palette.text-muted;
                                            font-size: Typography.technical;
                                            wrap: word-wrap;
                                        }

                                        HorizontalLayout {
                                            spacing: Spacing.sm;
                                            vertical-stretch: 0;

                                            HudButton {
                                                label: @tr("Rifai questa ricerca");
                                                clicked => {
                                                    root.run-saved-search(ricerca.id);
                                                }
                                            }
                                            // CANCELLARE E' AMMESSO, MODIFICARE
                                            // NO.
                                            //
                                            // Una ricerca salvata e' uno
                                            // STRUMENTO: nessuna decisione
                                            // poggia sulla sua esistenza.
                                            // Modificarla invece farebbe
                                            // mentire chi l'ha salvata e
                                            // quando.
                                            HudButton {
                                                label: @tr("Cancella");
                                                clicked => {
                                                    root.delete-saved-search(ricerca.id);
                                                }
                                            }
                                            Rectangle { horizontal-stretch: 1; background: transparent; }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // I MODELLI DI MONITORAGGIO (TEMPLATE-01).
                    //
                    // UN MODELLO PROPONE, NON APPLICA. La soglia di notifica e
                    // la conservazione sono impostazioni DELLA POSTAZIONE:
                    // cambiarle tocca anche i monitoraggi gia' conclusi, e la
                    // conservazione, abbassata, CANCELLA.
                    //
                    // Percio' «Applica» mostra che cosa il modello prepara e
                    // che cosa differisce, e non scrive niente.
                    // ------------------------------------------- il grafo (GRAPH-02)
                    //
                    // CHE COSA QUESTA SCHERMATA NON FA, e non deve fare:
                    // rispondere a «A e B sono collegati?». Non c'e' un comando
                    // che lo chieda, e non ci sono linee fra due vicini. Due
                    // nodi collegati attraverso un terzo non hanno per questo a
                    // che fare l'uno con l'altro, e in una figura quella frase
                    // non la scrive nessuno: la fa la figura (DEC-288).
                    if root.current-page == 25: Rectangle {
                        // Comparsa graduale della pagina: vedere la pagina 0 per il
                        // perche' la dissolvenza sia solo in entrata.
                        property <bool> entered: false;
                        opacity: 0.0;
                        init => {
                            self.entered = true;
                        }
                        animate opacity {
                            duration: Motion.transition-effective;
                            easing: cubic-bezier(0.16, 1, 0.3, 1);
                        }
                        states [
                            shown when self.entered: {
                                opacity: 1.0;
                            }
                        ]
                        background: Palette.panel;
                        border-radius: Spacing.radius-panel;

                        VerticalLayout {
                            padding: Spacing.xl;
                            spacing: Spacing.lg;

                            Text {
                                text: @tr("Grafo delle prove");
                                color: Palette.text;
                                font-size: Typography.screen-title;
                                font-weight: Typography.medium;
                            }

                            // CHE COSA E', PRIMA DI MOSTRARLO. Chi legge deve
                            // sapere che cosa ha davanti prima di guardarlo:
                            // una dichiarazione in fondo arriva dopo che
                            // l'impressione si e' formata.
                            AvvertenzaDiSicurezza {
                                codice: "SIC-10";
                                testo: @tr("Questa figura mostra un elemento e ciò che lo tocca, un passo alla volta. Ogni collegamento dice per quale fatto esiste e da dove viene. Non è una rete di relazioni. Due elementi collegati attraverso un terzo non hanno per questo a che fare l'uno con l'altro.");
                                dettaglio: @tr("Il grafo delle prove mostra i nodi a distanza uno. Ogni arco porta il fatto che lo giustifica e la sua provenienza. Nessuna relazione transitiva viene dedotta.");
                            }

                            HorizontalLayout {
                                spacing: Spacing.md;

                                HudSelect {
                                    label: @tr("Monitoraggio");
                                    model: root.graph-sessions;
                                    current-index <=> root.graph-session-index;
                                    selected => {
                                        root.graph-session-chosen(self.current-index);
                                    }
                                }
                                // SI SCRIVE L'IDENTIFICATIVO, non si sceglie da
                                // un elenco: un elenco di elementi da cui
                                // partire sarebbe un elenco prodotto senza che
                                // nessuno se lo sia chiesto, ed e' la stessa
                                // ragione per cui in Persone si scrive
                                // l'identificativo (PERS-06).
                                HudInput {
                                    label: @tr("Contenuto da cui partire");
                                    value <=> root.graph-start-content;
                                    // Invio apre, come «Apri» (E2E01-09).
                                    accepted => {
                                        root.graph-start-requested();
                                    }
                                    placeholder: @tr("numero del contenuto (n. nello Storico)");
                                    min-width: 240px;
                                }
                                HudButton {
                                    label: @tr("Apri");
                                    clicked => {
                                        root.graph-start-requested();
                                    }
                                }
                            }

                            if root.graph-message != "": Text {
                                text: root.graph-message;
                                color: Palette.amber;
                                font-size: Typography.body-secondary;
                                wrap: word-wrap;
                            }

                            if !root.graph-has-node && root.graph-message == "": Text {
                                text: @tr("Scrivere l'identificativo di un contenuto e premere Apri. La figura parte da lì.");
                                color: Palette.text-muted;
                                font-size: Typography.body-secondary;
                                wrap: word-wrap;
                            }

                            // Senza figura aperta, l'avanzo lo prende questo
                            // spaziatore: altrimenti le quattro righe di questa
                            // pagina si distribuiscono su tutta l'altezza
                            // (FINAL-FPR-ALL-16, FPR-08).
                            if !root.graph-has-node: Rectangle {
                                vertical-stretch: 1;
                                background: transparent;
                            }

                            if root.graph-has-node: HorizontalLayout {
                                spacing: Spacing.lg;
                                // L'avanzo di altezza va alla figura, che e' la
                                // cosa che serve guardare. Senza, Slint lo
                                // divideva in parti uguali fra tutti i figli e
                                // gonfiava il riquadro d'avvertenza
                                // (FINAL-FPR-ALL-16, FPR-08).
                                vertical-stretch: 1;

                                // LA FIGURA.
                                //
                                // UNA LARGHEZZA MINIMA, E NIENTE FUORI DAL RIQUADRO
                                // (OPERATOR-E2E-REMEDIATION-01, F-02). Non ne aveva una:
                                // i nodi sono posizionati a mano e non chiedono
                                // spazio, la colonna delle ragioni accanto prendeva
                                // tutto, e la figura scendeva a larghezza zero. Il
                                // centro finiva disegnato sopra il menu e i vicini
                                // sparivano. Ora la figura ha un minimo, la colonna
                                // accanto un massimo, e ogni nodo resta dentro.
                                Rectangle {
                                    background: Palette.panel-inset;
                                    border-radius: Spacing.radius-row;
                                    border-width: Spacing.hairline;
                                    border-color: Palette.line-divider;
                                    horizontal-stretch: 2;
                                    min-width: 460px;
                                    min-height: 420px;
                                    clip: true;

                                    // LE LINEE, dal centro a ogni vicino e da
                                    // nessun'altra parte. Non c'e' una linea
                                    // fra due vicini, e non e' una dimenticanza.
                                    for vicino in root.graph-neighbours: Path {
                                        x: 0; y: 0;
                                        width: parent.width;
                                        height: parent.height;
                                        viewbox-x: 0;
                                        viewbox-y: 0;
                                        viewbox-width: 1;
                                        viewbox-height: 1;
                                        stroke: vicino.is-human-act ? Palette.amber : Palette.line-strong;
                                        stroke-width: 1px;

                                        MoveTo { x: 0.5; y: 0.5; }
                                        LineTo { x: vicino.x; y: vicino.y; }
                                    }

                                    // I VICINI.
                                    for vicino[indice] in root.graph-neighbours: Rectangle {
                                        x: max(0px, min(parent.width - self.width, parent.width * vicino.x - self.width / 2));
                                        y: max(0px, min(parent.height - self.height, parent.height * vicino.y - self.height / 2));
                                        width: 132px;
                                        height: 44px;
                                        background: Palette.panel-raised;
                                        border-radius: Spacing.radius-row;
                                        border-width: Spacing.hairline;
                                        // L'ATTO DI UNA PERSONA e l'osservazione
                                        // dell'archivio non si rendono allo
                                        // stesso modo: non sono la stessa cosa,
                                        // e chi guarda deve poterlo vedere senza
                                        // leggere la frase.
                                        border-color: vicino.is-human-act ? Palette.amber : Palette.line-divider;

                                        VerticalLayout {
                                            padding: Spacing.xs;

                                            Text {
                                                text: vicino.kind;
                                                color: Palette.text-muted;
                                                font-size: Typography.group-label;
                                                overflow: elide;
                                            }
                                            Text {
                                                text: vicino.label;
                                                color: Palette.text;
                                                font-size: Typography.group-label;
                                                overflow: elide;
                                            }
                                        }

                                        // UN NODO SI RAGGIUNGE ANCHE SENZA
                                        // MOUSE. Un elemento cliccabile senza
                                        // fuoco non esiste per chi usa la
                                        // tastiera, e il grafo si percorre un
                                        // passo alla volta: senza questo, quei
                                        // passi non si potrebbero fare.
                                        fuoco := FocusScope {
                                            key-pressed(event) => {
                                                if (event.text == Key.Return || event.text == " ") {
                                                    root.graph-recentre(indice);
                                                    return accept;
                                                }
                                                return reject;
                                            }
                                        }

                                        // Il fuoco si vede: un fuoco invisibile
                                        // e' peggio di nessun fuoco.
                                        if fuoco.has-focus: Rectangle {
                                            border-width: 2px;
                                            border-color: Palette.focus;
                                            border-radius: parent.border-radius;
                                            background: transparent;
                                        }
                                        TouchArea {
                                            clicked => {
                                                fuoco.focus();
                                                root.graph-recentre(indice);
                                            }
                                        }
                                    }


                                    // IL CENTRO, disegnato per ultimo perche'
                                    // sta sopra le linee.
                                    Rectangle {
                                        x: parent.width / 2 - self.width / 2;
                                        y: parent.height / 2 - self.height / 2;
                                        width: 168px;
                                        height: 52px;
                                        background: Palette.selected;
                                        border-radius: Spacing.radius-row;
                                        border-width: Spacing.hairline;
                                        border-color: Palette.frame;

                                        VerticalLayout {
                                            padding: Spacing.xs;

                                            Text {
                                                text: root.graph-centre-kind;
                                                color: Palette.text-muted;
                                                font-size: Typography.group-label;
                                                overflow: elide;
                                            }
                                            Text {
                                                text: root.graph-centre-label;
                                                color: Palette.text;
                                                font-size: Typography.body-secondary;
                                                overflow: elide;
                                            }
                                        }
                                    }
                                }

                                // ACCANTO ALLA FIGURA, non sotto: l'avvertenza
                                // e le ragioni devono stare dove chi guarda
                                // sposta gli occhi, non dove arriva dopo essersi
                                // fatto un'idea.
                                VerticalLayout {
                                    spacing: Spacing.md;
                                    horizontal-stretch: 1;
                                    min-width: 240px;
                                    max-width: 380px;

                                    Text {
                                        text: root.graph-caveat;
                                        color: Palette.text-muted;
                                        font-size: Typography.group-label;
                                        wrap: word-wrap;
                                    }
                                    // LA CONVERSAZIONE DEL CONTENUTO AL CENTRO
                                    // (ADR-0151): lo stesso bersaglio degli Avvisi.
                                    if root.graph-centre-content > 0: HudButton {
                                        label: @tr("Apri la conversazione");
                                        clicked => {
                                            root.conversation-open-requested(root.graph-centre-content, "Grafo");
                                        }
                                    }

                                    Text {
                                        text: @tr("Perché sono collegati?");
                                        color: Palette.text;
                                        font-size: Typography.body;
                                        font-weight: Typography.medium;
                                    }

                                    // LA RISPOSTA, per ogni collegamento. La
                                    // compone il dominio: la schermata la
                                    // mostra e non la riscrive.
                                    HudScroll {
                                        vertical-stretch: 1;

                                        VerticalLayout {
                                            spacing: Spacing.sm;

                                            for vicino in root.graph-neighbours: Rectangle {
                                                // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                                min-height: rip-111.preferred-height;
                                                rip-111 := VerticalLayout {
                                                    spacing: Spacing.xs;

                                                    OrigineSegno {
                                                        origine: vicino.is-human-act ? Origine.operatore : Origine.osservato;
                                                    }
                                                    Text {
                                                        text: vicino.why;
                                                        color: Palette.text;
                                                        font-size: Typography.group-label;
                                                        wrap: word-wrap;
                                                    }
                                                    // LA STESSA DOMANDA, LA STESSA
                                                    // VOCE. La frase qui sopra dice
                                                    // il fatto; il pannello aggiunge
                                                    // di che genere di certezza si
                                                    // tratta, che e' la cosa che
                                                    // cambia come si scrive in una
                                                    // relazione.
                                                    PercheVedoQuesto {
                                                        elemento: vicino.label;
                                                        chiesto => {
                                                            root.explain-this(
                                                                vicino.is-human-act ? Spiegabile.vicino-deciso : Spiegabile.vicino-osservato,
                                                                vicino.label,
                                                                vicino.why);
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // ------------------------------------------ Scoperta pubblica
                    //
                    // CONSERVARE E NON MOSTRARE E' COME NON CONSERVARE.
                    //
                    // L'archivio conserva cio' che non e' stato chiesto, con il
                    // motivo. Se questa pagina non lo mostrasse, il silenzio
                    // tornerebbe al suo posto: l'archivio le ha, nessuno le
                    // vede, e chi rilegge conclude «non trovato» di termini che
                    // nessuno ha cercato (ADR-0079).
                    //
                    // E NON C'E' UN PULSANTE «CERCA». Non per prudenza: perche'
                    // non ci sarebbe niente da eseguire finche' nessuna
                    // politica validata puo' esistere. Un comando che non fa
                    // cio' che dice e' una promessa (ADR-0071, ADR-0074).
                    if root.current-page == 26: Rectangle {
                        // Comparsa graduale della pagina: vedere la pagina 0 per il
                        // perche' la dissolvenza sia solo in entrata.
                        property <bool> entered: false;
                        opacity: 0.0;
                        init => {
                            self.entered = true;
                        }
                        animate opacity {
                            duration: Motion.transition-effective;
                            easing: cubic-bezier(0.16, 1, 0.3, 1);
                        }
                        states [
                            shown when self.entered: {
                                opacity: 1.0;
                            }
                        ]
                        background: Palette.panel;
                        border-radius: Spacing.radius-panel;

                        HudScroll {
                            VerticalLayout {
                                padding: Spacing.xl;
                                spacing: Spacing.lg;

                                Text {
                                    text: @tr("Scoperta pubblica");
                                    color: Palette.text;
                                    font-size: Typography.screen-title;
                                    font-weight: Typography.medium;
                                }

                                // CHE COSA E', PRIMA DI MOSTRARLO.
                                Text {
                                    text: @tr("Questa pagina rilegge le ricerche pubbliche già fatte. Mostra che cosa è stato chiesto, che cosa no e perché. Mostra su quale misura dei limiti di Telegram si basava la ricerca, e che cosa ne è tornato. Un termine che non è stato cercato non è un termine trovato assente.");
                                    color: Palette.text-muted;
                                    font-size: Typography.body-secondary;
                                    wrap: word-wrap;
                                }

                                // LA PORTA CHIUSA SI DICHIARA, e dice che cosa
                                // manca. Non si traveste da «ancora nessun
                                // dato»: sono due affermazioni diverse.
                                StateBlock {
                                    kind: StateKind.planned;
                                    subsystem: @tr("ricerca pubblica");
                                    title: @tr("Da qui non si avvia una ricerca");
                                    message: root.discovery-closed-door;
                                }

                                // E LA SECONDA RAGIONE, su una postazione che
                                // segue: quando si cerchera', non cerchera'
                                // questa. Un'assenza non spiegata si legge come
                                // una mancanza.
                                if root.discovery-follows-hub != "": StateBlock {
                                    kind: StateKind.planned;
                                    subsystem: @tr("ricerca pubblica");
                                    title: @tr("E non cercherebbe questa postazione");
                                    message: root.discovery-follows-hub;
                                }

                                if root.discovery-runs.length == 0: StateBlock {
                                    kind: StateKind.empty;
                                    title: @tr("Nessuna ricerca eseguita");
                                    message: root.discovery-never-run;
                                }

                                if root.discovery-runs.length > 0: Rectangle {
                                    // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                    min-height: rip-112.preferred-height;
                                    rip-112 := HorizontalLayout {
                                        spacing: Spacing.lg;

                                        // L'elenco delle esecuzioni.
                                        VerticalLayout {
                                            width: 320px;
                                            spacing: Spacing.sm;

                                            Text {
                                                text: @tr("Ricerche registrate");
                                                color: Palette.text-muted;
                                                font-size: Typography.group-label;
                                            }

                                            LegendaOrigini {
                                                calcolato: @tr("quando e che cosa è tornato");
                                                operatore: @tr("ambito scelto");
                                            }
                                            // PERCHE' VEDO QUESTO (PR-02) sotto la riga e non
                                            // dentro: la riga intera e' l'area che la sceglie, e
                                            // un comando dentro non riceverebbe il clic.
                                            for scoperta[indice] in root.discovery-runs: Rectangle {
                                                // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                                min-height: rip-113.preferred-height;
                                                rip-113 := VerticalLayout {
                                                    spacing: Spacing.xs;

                                                    SelectableRow {
                                                        selected: root.discovery-selected == indice;
                                                        name: scoperta.when + ", " + scoperta.scope;
                                                        chosen => {
                                                            root.discovery-selected = indice;
                                                            root.discovery-run-chosen(indice);
                                                        }

                                                        VerticalLayout {
                                                            spacing: Spacing.xs;

                                                            Text {
                                                                text: scoperta.when;
                                                                color: Palette.text;
                                                                font-size: Typography.body-secondary;
                                                            }
                                                            Text {
                                                                text: scoperta.scope;
                                                                color: Palette.text-muted;
                                                                font-size: Typography.group-label;
                                                            }
                                                            Text {
                                                                text: scoperta.summary;
                                                                color: Palette.text-muted;
                                                                font-size: Typography.group-label;
                                                                wrap: word-wrap;
                                                            }
                                                        }
                                                    }
                                                    PercheVedoQuesto {
                                                        elemento: scoperta.when;
                                                        chiesto => {
                                                            root.explain-this(Spiegabile.ricerca-pubblica, "", scoperta.when + ", " + scoperta.scope + ". " + scoperta.summary);
                                                        }
                                                    }
                                                }
                                            }
                                        }

                                        // Il dettaglio della scoperta scelta.
                                        VerticalLayout {
                                            spacing: Spacing.md;

                                            if root.discovery-selected < 0: Text {
                                                text: @tr("Scegli una ricerca dall'elenco per vedere che cosa ha chiesto.");
                                                color: Palette.text-muted;
                                                font-size: Typography.body-secondary;
                                                wrap: word-wrap;
                                            }

                                            if root.discovery-selected >= 0: Text {
                                                text: root.discovery-summary;
                                                color: Palette.text;
                                                font-size: Typography.body-secondary;
                                                wrap: word-wrap;
                                            }

                                            // LA MISURA CON LA SUA PROVENIENZA: un
                                            // numero senza provenienza non si
                                            // distingue da uno inventato.
                                            if root.discovery-selected >= 0: Text {
                                                text: root.discovery-limits;
                                                color: Palette.text-muted;
                                                font-size: Typography.group-label;
                                                wrap: word-wrap;
                                            }

                                            if root.discovery-selected >= 0: Text {
                                                text: @tr("Domande poste");
                                                color: Palette.text-muted;
                                                font-size: Typography.group-label;
                                            }

                                            for domanda in root.discovery-asked: ListRow {
                                                Text {
                                                    text: domanda;
                                                    color: Palette.text;
                                                    font-size: Typography.body-secondary;
                                                    wrap: word-wrap;
                                                }
                                            }

                                            // ACCANTO, NON DIETRO.
                                            if root.discovery-selected >= 0: Text {
                                                text: @tr("Termini non chiesti");
                                                color: Palette.text-muted;
                                                font-size: Typography.group-label;
                                            }

                                            LegendaOrigini {
                                                calcolato: @tr("perché non è stato cercato");
                                                operatore: @tr("termine");
                                            }
                                            for omesso in root.discovery-omitted: ListRow {
                                                VerticalLayout {
                                                    spacing: Spacing.xs;

                                                    Text {
                                                        text: omesso.term + " — " + omesso.reason;
                                                        color: Palette.text;
                                                        font-size: Typography.body-secondary;
                                                        wrap: word-wrap;
                                                    }
                                                    Text {
                                                        text: omesso.consequence;
                                                        color: Palette.text-muted;
                                                        font-size: Typography.group-label;
                                                        wrap: word-wrap;
                                                    }
                                                }
                                            }

                                            if root.discovery-selected >= 0: Text {
                                                text: @tr("Candidati");
                                                color: Palette.text-muted;
                                                font-size: Typography.group-label;
                                            }

                                            // SCEGLIERE UN CANDIDATO NON DECIDE
                                            // NIENTE. La riga si sceglie per poter
                                            // leggere che cosa comporta ciascuna
                                            // delle tre decisioni e per scrivere il
                                            // motivo; nessuna decisione parte da
                                            // qui, e il nome pubblico non e' un
                                            // collegamento (ADR-0079, ADR-0080).
                                            LegendaOrigini {
                                                osservato: @tr("nome e indirizzo");
                                                calcolato: @tr("ambito e ragioni");
                                            }
                                            // PERCHE' VEDO QUESTO (PR-02) sotto il candidato, per la
                                            // stessa ragione delle ricerche: la riga intera lo sceglie.
                                            for candidato[indice] in root.discovery-candidates: Rectangle {
                                                // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                                min-height: rip-114.preferred-height;
                                                rip-114 := VerticalLayout {
                                                    spacing: Spacing.xs;

                                                    SelectableRow {
                                                        selected: root.discovery-candidate-selected == indice;
                                                        name: candidato.name;
                                                        chosen => {
                                                            root.discovery-candidate-selected = indice;
                                                            root.discovery-candidate-chosen(indice);
                                                        }

                                                        VerticalLayout {
                                                            spacing: Spacing.xs;

                                                            Text {
                                                                text: candidato.name;
                                                                color: Palette.text;
                                                                font-size: Typography.body-secondary;
                                                                wrap: word-wrap;
                                                            }
                                                            Text {
                                                                text: candidato.scope + " · " + candidato.why;
                                                                color: Palette.text-muted;
                                                                font-size: Typography.group-label;
                                                                wrap: word-wrap;
                                                            }
                                                            Text {
                                                                text: candidato.reasons;
                                                                color: Palette.text-muted;
                                                                font-size: Typography.group-label;
                                                                wrap: word-wrap;
                                                            }
                                                            Text {
                                                                text: candidato.address != "" ? @tr("Indirizzo pubblico: {}", candidato.address) : @tr("Senza indirizzo pubblico: non c'è niente da aprire e niente da sorvegliare.");
                                                                color: Palette.text-disabled;
                                                                font-size: Typography.group-label;
                                                                wrap: word-wrap;
                                                            }
                                                        }
                                                    }
                                                    PercheVedoQuesto {
                                                        elemento: candidato.name;
                                                        chiesto => {
                                                            root.explain-this(Spiegabile.suggerimento-di-fonte, "", candidato.scope + ". " + candidato.why + " " + candidato.reasons);
                                                        }
                                                    }
                                                }
                                            }

                                            // ----------------------------- le tre decisioni
                                            //
                                            // «Legittimamente accessibile» LO DICE UNA
                                            // PERSONA: il programma non puo' verificarlo,
                                            // perche' per saperlo dovrebbe provare ad
                                            // accedervi, e non lo fa mai.
                                            //
                                            // Il motivo e' obbligatorio, e i comandi
                                            // restano spenti finche' non c'e': non si
                                            // scrive un motivo dieci volte per
                                            // distrazione, ed e' cosi' che «mai adesione
                                            // automatica» resta vero anche quando a
                                            // premere e' una persona (ADR-0080).
                                            if root.discovery-candidate-selected >= 0: Rectangle {
                                                // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                                min-height: rip-115.preferred-height;
                                                rip-115 := VerticalLayout {
                                                    spacing: Spacing.sm;

                                                    Text {
                                                        text: @tr("Che cosa vuoi farne");
                                                        color: Palette.text-muted;
                                                        font-size: Typography.group-label;
                                                    }

                                                    Text {
                                                        text: root.discovery-add-declaration;
                                                        color: Palette.text-muted;
                                                        font-size: Typography.group-label;
                                                        wrap: word-wrap;
                                                    }

                                                    Text {
                                                        text: root.discovery-ignore-note;
                                                        color: Palette.text-muted;
                                                        font-size: Typography.group-label;
                                                        wrap: word-wrap;
                                                    }

                                                    TextField {
                                                        label: @tr("Motivo della decisione");
                                                        value <=> root.discovery-decision-reason;
                                                    }

                                                    HorizontalLayout {
                                                        spacing: Spacing.sm;

                                                        HudButton {
                                                            label: @tr("Apri per guardarla");
                                                            enabled: root.discovery-decision-reason != "";
                                                            clicked => {
                                                                root.discovery-open-candidate();
                                                            }
                                                        }
                                                        HudButton {
                                                            label: @tr("Aggiungi come fonte");
                                                            enabled: root.discovery-decision-reason != "";
                                                            clicked => {
                                                                root.discovery-add-candidate();
                                                            }
                                                        }
                                                        HudButton {
                                                            label: @tr("Ignora");
                                                            enabled: root.discovery-decision-reason != "";
                                                            clicked => {
                                                                root.discovery-ignore-candidate();
                                                            }
                                                        }
                                                    }

                                                    if root.discovery-decision-message != "": Text {
                                                        text: root.discovery-decision-message;
                                                        color: Palette.text;
                                                        font-size: Typography.group-label;
                                                        wrap: word-wrap;
                                                    }
                                                }
                                            }

                                            if root.discovery-selected >= 0: Text {
                                                text: root.discovery-results-note;
                                                color: Palette.text-muted;
                                                font-size: Typography.group-label;
                                                wrap: word-wrap;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // ---------------------------------------- Live condiviso
                    //
                    // Che cosa l'Hub vede accadere, e che cosa questa postazione
                    // e' rispetto a lui (TEAM-LIVE-01, ADR-0093).
                    //
                    // LE RIGHE DICONO L'ATTIVITA', NON IL CONTENUTO: quante cose
                    // sono arrivate, da quale fonte, con quale livello. Il testo
                    // dei messaggi resta sull'Hub, e un flusso che lo portasse
                    // sarebbe la copia dell'archivio dell'Hub costruita un pezzo
                    // alla volta.
                    //
                    // NESSUN COMANDO SUL LAVORO ALTRUI: prendere in carico,
                    // assegnare e rivedere richiedono un'identita' di operatore
                    // autenticata che non esiste ancora, e un pulsante che ci
                    // fosse adesso attribuirebbe un atto a un segnaposto.
                    if root.current-page == 27: Rectangle {
                        // Comparsa graduale della pagina: vedere la pagina 0 per il
                        // perche' la dissolvenza sia solo in entrata.
                        property <bool> entered: false;
                        opacity: 0.0;
                        init => {
                            self.entered = true;
                        }
                        animate opacity {
                            duration: Motion.transition-effective;
                            easing: cubic-bezier(0.16, 1, 0.3, 1);
                        }
                        states [
                            shown when self.entered: {
                                opacity: 1.0;
                            }
                        ]
                        background: Palette.panel;
                        border-radius: Spacing.radius-panel;

                        HudScroll {
                            VerticalLayout {
                                padding: Spacing.xl;
                                spacing: Spacing.lg;

                                Text {
                                    text: @tr("Live condiviso");
                                    color: Palette.text;
                                    font-size: Typography.screen-title;
                                    font-weight: Typography.medium;
                                }

                                // CHE COSA E', PRIMA DI MOSTRARLO.
                                Text {
                                    text: @tr("Questa pagina mostra che cosa l'Hub dell'ufficio vede accadere: quali monitoraggi sono partiti, quanti contenuti sono arrivati da ciascuna fonte, quali avvisi sono scattati. Dice che cosa accade, non che cosa è scritto: i messaggi restano sull'Hub.");
                                    color: Palette.text-muted;
                                    font-size: Typography.body-secondary;
                                    wrap: word-wrap;
                                }

                                // IN ESERCITAZIONE QUI NON C'E' NESSUN SERVIZIO
                                // (PR-13, ADR-0129), e per progetto: nessun dato
                                // passa fra l'esercitazione e il lavoro vero.
                                //
                                // La fascia dice che cosa non si prova, dove si
                                // prova, e che cosa si prova invece. I comandi
                                // sotto non si mostrano: restavano premibili e
                                // non facevano niente, e il pilot comincia qui
                                // (FINAL-FPR-ALL-16, FPR-01).
                                if root.exercise-mode: InfoBanner {
                                    message: @tr("In Esercitazione il live condiviso non si prova: l'esercitazione non si collega all'Hub dell'ufficio. Si prova su una postazione collegata a un Hub, o sulla postazione che fa da Hub. Qui si provano il monitoraggio, gli avvisi, la revisione, i raccoglitori e il Report.");
                                }

                                // CHE COSA E' QUESTA POSTAZIONE.
                                //
                                // Il riquadro compare quando ha qualcosa da dire:
                                // in Esercitazione, e prima del primo
                                // aggiornamento, le due proprieta' sono vuote e
                                // restava una scatola grigia con dentro niente —
                                // l'unico vuoto senza parole del prodotto
                                // (FINAL-FPR-ALL-16, FPR-07).
                                if root.team-live-role != "" || root.team-live-position != "": Rectangle {
                                    background: Palette.panel-raised;
                                    border-radius: Spacing.radius-panel;
                                    vertical-stretch: 0;

                                    // Un `Rectangle` non prende l'altezza dai figli (F-03).
                                    min-height: live-fit-1.preferred-height;
                                    live-fit-1 := VerticalLayout {
                                        padding: Spacing.lg;
                                        spacing: Spacing.xs;

                                        Text {
                                            text: root.team-live-role;
                                            color: Palette.text;
                                            font-size: Typography.body;
                                            wrap: word-wrap;
                                        }
                                        Text {
                                            text: root.team-live-position;
                                            color: Palette.text-muted;
                                            font-size: Typography.body-secondary;
                                            wrap: word-wrap;
                                        }
                                    }
                                }

                                // L'ESITO DELL'ULTIMA AZIONE, quando c'e'.
                                if root.team-live-message != "": Rectangle {
                                    background: Palette.panel-raised;
                                    border-radius: Spacing.radius-panel;
                                    vertical-stretch: 0;

                                    // Un `Rectangle` non prende l'altezza dai figli (F-03).
                                    min-height: live-fit-2.preferred-height;
                                    live-fit-2 := VerticalLayout {
                                        padding: Spacing.lg;

                                        Text {
                                            text: root.team-live-message;
                                            color: Palette.text;
                                            font-size: Typography.body-secondary;
                                            wrap: word-wrap;
                                        }
                                    }
                                }

                                // IL COLLEGAMENTO ALL'HUB, chiesto da una persona.
                                if !root.exercise-mode: Rectangle {
                                    // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                    min-height: rip-116.preferred-height;
                                    rip-116 := HorizontalLayout {
                                        spacing: Spacing.md;
                                        vertical-stretch: 0;

                                        HudButton {
                                            label: @tr("Aggiorna dall'Hub");
                                            clicked => {
                                                root.team-live-refresh();
                                            }
                                        }

                                        Rectangle { horizontal-stretch: 1; background: transparent; }
                                    }
                                }

                                // COLLEGARE QUESTA POSTAZIONE A UN HUB (D-19,
                                // ADR-0132). Solo per una postazione da sola,
                                // solo in modalita' amministratore: da qui in
                                // poi la postazione smette di acquisire.
                                if root.team-live-can-connect: Rectangle {
                                    background: Palette.panel-raised;
                                    border-radius: Spacing.radius-panel;
                                    vertical-stretch: 0;

                                    // Un `Rectangle` non prende l'altezza dai figli (F-03).
                                    min-height: live-fit-3.preferred-height;
                                    live-fit-3 := VerticalLayout {
                                        padding: Spacing.lg;
                                        spacing: Spacing.sm;

                                        Text {
                                            text: @tr("Collega questa postazione a un Hub");
                                            color: Palette.text;
                                            font-size: Typography.panel-title;
                                            font-weight: Typography.medium;
                                        }
                                        Text {
                                            text: @tr("Serve il foglietto preparato sull'Hub: indirizzo, impronta e codice. Il codice vale quindici minuti e una volta sola. Dopo il collegamento questa postazione segue l'Hub e non acquisisce più da sola.");
                                            color: Palette.text-muted;
                                            font-size: Typography.body-secondary;
                                            wrap: word-wrap;
                                        }
                                        if !root.administrator-mode: Text {
                                            text: @tr("Collegare la postazione è riservato alla modalità amministratore.");
                                            color: Palette.text-muted;
                                            font-size: Typography.body-secondary;
                                            wrap: word-wrap;
                                        }
                                        if root.administrator-mode: Rectangle {
                                            // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                            min-height: rip-117.preferred-height;
                                            rip-117 := VerticalLayout {
                                                spacing: Spacing.sm;

                                                // L'etichetta si vede: il segnaposto sparisce
                                                // appena si scrive.
                                                Text {
                                                    text: @tr("Indirizzo dell'Hub");
                                                    color: Palette.text-muted;
                                                    font-size: Typography.body-secondary;
                                                }
                                                collega-indirizzo := HudInput {
                                                    label: @tr("Indirizzo dell'Hub");
                                                    placeholder: "192.168.1.10:8443";
                                                }
                                                // L'etichetta si vede: il segnaposto sparisce
                                                // appena si scrive.
                                                Text {
                                                    text: @tr("Impronta dell'Hub, 24 cifre");
                                                    color: Palette.text-muted;
                                                    font-size: Typography.body-secondary;
                                                }
                                                collega-impronta := HudInput {
                                                    label: @tr("Impronta dell'Hub, 24 cifre");
                                                    placeholder: "0000-0000-0000-0000-0000-0000";
                                                }
                                                // L'etichetta si vede: il segnaposto sparisce
                                                // appena si scrive.
                                                Text {
                                                    text: @tr("Codice di arruolamento, 16 cifre");
                                                    color: Palette.text-muted;
                                                    font-size: Typography.body-secondary;
                                                }
                                                collega-codice := HudInput {
                                                    label: @tr("Codice di arruolamento, 16 cifre");
                                                    placeholder: "0000-0000-0000-0000";
                                                    value <=> root.team-live-typed-code;
                                                }
                                                // L'etichetta si vede: il segnaposto sparisce
                                                // appena si scrive.
                                                Text {
                                                    text: @tr("Nome di questa postazione");
                                                    color: Palette.text-muted;
                                                    font-size: Typography.body-secondary;
                                                }
                                                collega-nome := HudInput {
                                                    label: @tr("Nome di questa postazione");
                                                    value <=> root.team-live-station-name;
                                                }

                                                HorizontalLayout {
                                                    spacing: Spacing.md;

                                                    HudButton {
                                                        label: @tr("Collega a questo Hub");
                                                        clicked => {
                                                            root.team-live-connect(
                                                                collega-indirizzo.value,
                                                                collega-impronta.value,
                                                                collega-codice.value,
                                                                collega-nome.value);
                                                        }
                                                    }

                                                    Rectangle { horizontal-stretch: 1; background: transparent; }
                                                }
                                            }
                                        }
                                    }
                                }

                                // LE RETI DELL'UFFICIO (HUB-SITES-01, ADR-0198):
                                // valgono per l'Hub e per chi lo segue. Le
                                // dichiara chi amministra la postazione.
                                if !root.exercise-mode: Rectangle {
                                    background: Palette.panel-raised;
                                    border-radius: Spacing.radius-panel;
                                    vertical-stretch: 0;

                                    // Un `Rectangle` non prende l'altezza dai figli (F-03).
                                    min-height: live-fit-reti.preferred-height;
                                    live-fit-reti := VerticalLayout {
                                        padding: Spacing.lg;
                                        spacing: Spacing.sm;

                                        Text {
                                            text: @tr("Reti dell'ufficio");
                                            color: Palette.text;
                                            font-size: Typography.panel-title;
                                            font-weight: Typography.medium;
                                        }
                                        Text {
                                            text: @tr("L'Hub si raggiunge soltanto dalle reti dell'ufficio, anche dalle altre sedi attraverso la rete che le collega. Mai da Internet.");
                                            color: Palette.text-muted;
                                            font-size: Typography.body-secondary;
                                            wrap: word-wrap;
                                        }
                                        Text {
                                            text: root.team-live-networks-note;
                                            color: Palette.text-muted;
                                            font-size: Typography.body-secondary;
                                            wrap: word-wrap;
                                        }

                                        HorizontalLayout {
                                            spacing: Spacing.md;

                                            reti-ufficio := HudInput {
                                                label: @tr("Altre reti dell'ufficio, separate da virgole");
                                                placeholder: "10.20.0.0/16";
                                                value: root.team-live-networks;
                                                horizontal-stretch: 1;
                                            }

                                            HudButton {
                                                label: @tr("Dichiara le reti");
                                                clicked => {
                                                    root.team-live-declare-networks(reti-ufficio.value);
                                                }
                                            }
                                        }

                                        Text {
                                            text: @tr("Dichiarare le reti è riservato alla modalità amministratore, e resta nel registro delle operazioni.");
                                            color: Palette.text-muted;
                                            font-size: Typography.body-secondary;
                                            wrap: word-wrap;
                                        }

                                        if root.team-live-refused != "": Text {
                                            text: root.team-live-refused;
                                            color: Palette.text;
                                            font-size: Typography.body-secondary;
                                            wrap: word-wrap;
                                        }
                                    }
                                }

                                // I COMANDI A DISTANZA (HUB-REMOTE-01, ADR-0200):
                                // soltanto su un Hub, e li accende chi lo amministra.
                                if !root.exercise-mode && root.team-live-remote-note != "": Rectangle {
                                    background: Palette.panel-raised;
                                    border-radius: Spacing.radius-panel;
                                    vertical-stretch: 0;

                                    // Un `Rectangle` non prende l'altezza dai figli (F-03).
                                    min-height: rip-204.preferred-height;
                                    rip-204 := VerticalLayout {
                                        padding: Spacing.lg;
                                        spacing: Spacing.sm;

                                        Text {
                                            text: @tr("Comandi a distanza");
                                            color: Palette.text;
                                            font-size: Typography.panel-title;
                                            font-weight: Typography.medium;
                                        }
                                        Text {
                                            text: root.team-live-remote-note;
                                            color: Palette.text-muted;
                                            font-size: Typography.body-secondary;
                                            wrap: word-wrap;
                                        }

                                        HorizontalLayout {
                                            spacing: Spacing.md;

                                            if !root.team-live-remote-accepted: HudButton {
                                                label: @tr("Accetta i comandi a distanza");
                                                clicked => {
                                                    root.team-live-choose-remote(true);
                                                }
                                            }
                                            if root.team-live-remote-accepted: HudButton {
                                                label: @tr("Non accettare più i comandi a distanza");
                                                clicked => {
                                                    root.team-live-choose-remote(false);
                                                }
                                            }

                                            Rectangle { horizontal-stretch: 1; background: transparent; }
                                        }

                                        Text {
                                            text: @tr("Sceglierlo è riservato alla modalità amministratore, e resta nel registro delle operazioni.");
                                            color: Palette.text-muted;
                                            font-size: Typography.body-secondary;
                                            wrap: word-wrap;
                                        }
                                        LegendaOrigini {
                                            calcolato: @tr("orari");
                                            operatore: @tr("persone e motivi");
                                        }
                                        Text {
                                            text: root.team-live-remote-log;
                                            color: Palette.text;
                                            font-size: Typography.body-secondary;
                                            wrap: word-wrap;
                                        }
                                    }
                                }

                                // LA MODALITA' HUB: la porta la apre una persona.
                                if !root.exercise-mode: Rectangle {
                                    background: Palette.panel-raised;
                                    border-radius: Spacing.radius-panel;
                                    vertical-stretch: 0;

                                    // Un `Rectangle` non prende l'altezza dai figli (F-03).
                                    min-height: live-fit-4.preferred-height;
                                    live-fit-4 := VerticalLayout {
                                        padding: Spacing.lg;
                                        spacing: Spacing.sm;

                                        Text {
                                            text: @tr("Modalità Hub");
                                            color: Palette.text;
                                            font-size: Typography.panel-title;
                                            font-weight: Typography.medium;
                                        }
                                        Text {
                                            text: @tr("Una postazione sola dell'ufficio fa da Hub: acquisisce da Telegram e serve le altre. La porta non si apre da sola — si sceglie l'indirizzo e la si attiva qui. La prima volta Windows chiederà se consentire l'accesso di rete.");
                                            color: Palette.text-muted;
                                            font-size: Typography.body-secondary;
                                            wrap: word-wrap;
                                        }

                                        HorizontalLayout {
                                            spacing: Spacing.md;

                                            indirizzo-hub := HudInput {
                                                label: @tr("Indirizzo di ascolto dell'Hub");
                                                placeholder: "192.168.1.10:8443";
                                                value: root.team-live-hub-address;
                                                horizontal-stretch: 1;
                                            }

                                            HudButton {
                                                label: @tr("Salva indirizzo");
                                                clicked => {
                                                    root.team-live-save-address(indirizzo-hub.value);
                                                }
                                            }
                                        }

                                        HorizontalLayout {
                                            spacing: Spacing.md;

                                            if !root.team-live-hub-running: HudButton {
                                                label: @tr("Attiva modalità Hub");
                                                clicked => {
                                                    root.team-live-activate();
                                                }
                                            }
                                            if root.team-live-hub-running: HudButton {
                                                label: @tr("Disattiva modalità Hub");
                                                clicked => {
                                                    root.team-live-deactivate();
                                                }
                                            }

                                            Rectangle { horizontal-stretch: 1; background: transparent; }
                                        }

                                        // IL FOGLIETTO DELL'ARRUOLAMENTO (D-19,
                                        // ADR-0132). Sullo schermo e basta: niente
                                        // stampa, niente appunti di Windows.
                                        if root.team-live-can-issue: Text {
                                            text: @tr("Arruolare una postazione");
                                            color: Palette.text;
                                            font-size: Typography.panel-title;
                                            font-weight: Typography.medium;
                                        }
                                        if root.team-live-can-issue: Text {
                                            text: @tr("Il foglietto porta indirizzo, impronta e un codice che vale quindici minuti e una volta sola. Non contiene segreti che durano. Ricopiarlo a mano, o dettarlo di persona: il programma non lo stampa e non lo mostra una seconda volta.");
                                            color: Palette.text-muted;
                                            font-size: Typography.body-secondary;
                                            wrap: word-wrap;
                                        }
                                        if root.team-live-can-issue && !root.administrator-mode: Text {
                                            text: @tr("Emettere un codice è riservato alla modalità amministratore.");
                                            color: Palette.text-muted;
                                            font-size: Typography.body-secondary;
                                            wrap: word-wrap;
                                        }
                                        if root.team-live-can-issue && root.administrator-mode: Rectangle {
                                            // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                            min-height: rip-118.preferred-height;
                                            rip-118 := HorizontalLayout {
                                                spacing: Spacing.md;

                                                HudButton {
                                                    label: @tr("Emetti codice di arruolamento");
                                                    clicked => {
                                                        root.team-live-issue-code();
                                                    }
                                                }
                                                if root.team-live-sheet != "": HudButton {
                                                    label: @tr("Togli il foglietto dallo schermo");
                                                    clicked => {
                                                        root.team-live-hide-sheet();
                                                    }
                                                }

                                                Rectangle { horizontal-stretch: 1; background: transparent; }
                                            }
                                        }
                                        if root.team-live-sheet != "": Rectangle {
                                            background: Palette.panel-inset;
                                            border-radius: Spacing.radius-row;

                                            // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                            min-height: rip-119.preferred-height;
                                            rip-119 := VerticalLayout {
                                                padding: Spacing.md;

                                                Text {
                                                    text: root.team-live-sheet;
                                                    color: Palette.text;
                                                    font-size: Typography.body;
                                                    wrap: word-wrap;
                                                }
                                            }
                                        }

                                        // LE PERSONE DELL'UFFICIO (FINAL-REVIEW-01,
                                        // FR-047; ADR-0097: «le crea chi
                                        // amministra»). Senza di loro «Entra» non
                                        // riesce, e con «Entra» le note, le prese in carico
                                        // e i raccoglitori. La frase non si mostra
                                        // e non si conserva: si conserva un
                                        // verificatore lento.
                                        if root.team-live-can-issue: Text {
                                            text: @tr("Persone dell'ufficio");
                                            color: Palette.text;
                                            font-size: Typography.panel-title;
                                            font-weight: Typography.medium;
                                        }
                                        if root.team-live-can-issue: Text {
                                            text: @tr("Chi lavora sulle postazioni entra con il proprio identificativo e la propria frase, dalla Revisione condivisa. Le persone si creano qui, sull'Hub. La frase si consegna di persona; chi la dimentica se la fa rimettere qui.");
                                            color: Palette.text-muted;
                                            font-size: Typography.body-secondary;
                                            wrap: word-wrap;
                                        }
                                        if root.team-live-can-issue && !root.administrator-mode: Text {
                                            text: @tr("Creare, sospendere e rimettere la frase è riservato alla modalità amministratore.");
                                            color: Palette.text-muted;
                                            font-size: Typography.body-secondary;
                                            wrap: word-wrap;
                                        }
                                        if root.team-live-can-issue && root.administrator-mode: Rectangle {
                                            // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                            min-height: rip-120.preferred-height;
                                            rip-120 := HorizontalLayout {
                                                spacing: Spacing.md;
                                                HudInput {
                                                    label: @tr("Identificativo");
                                                    placeholder: @tr("minuscole, cifre e trattini");
                                                    value <=> root.team-live-person-id;
                                                }
                                                HudInput {
                                                    label: @tr("Nome");
                                                    placeholder: @tr("come la chiama l'ufficio");
                                                    value <=> root.team-live-person-name;
                                                }
                                                HudSelect {
                                                    label: @tr("Ruolo");
                                                    model: [@tr("Operatore"), @tr("Amministratore")];
                                                    current-index <=> root.team-live-person-role;
                                                }
                                            }
                                        }
                                        if root.team-live-can-issue && root.administrator-mode: Rectangle {
                                            // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                            min-height: rip-121.preferred-height;
                                            rip-121 := HorizontalLayout {
                                                spacing: Spacing.md;
                                                SecretField {
                                                    label: @tr("Frase di accesso");
                                                    placeholder: @tr("almeno dodici caratteri; non verrà mostrata");
                                                    value <=> root.team-live-person-passphrase;
                                                }
                                                HudButton {
                                                    label: @tr("Crea persona");
                                                    enabled: root.team-live-person-id != ""
                                                        && root.team-live-person-name != ""
                                                        && root.team-live-person-passphrase != "";
                                                    clicked => {
                                                        root.team-live-person-create();
                                                    }
                                                }
                                            }
                                        }
                                        if root.team-live-people-message != "": InfoBanner {
                                            message: root.team-live-people-message;
                                        }
                                        if root.team-live-can-issue: Rectangle {
                                            // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                            min-height: rip-122.preferred-height;
                                            rip-122 := VerticalLayout {
                                                spacing: Spacing.xs;
                                                LegendaOrigini {
                                                    operatore: @tr("nome, ruolo e stato, decisi da chi amministra");
                                                }
                                                for persona in root.team-live-people: Rectangle {
                                                    background: Palette.panel-raised;
                                                    border-radius: Spacing.radius-row;
                                                    height: riga-persona.preferred-height;

                                                    riga-persona := HorizontalLayout {
                                                        padding: Spacing.sm;
                                                        spacing: Spacing.md;
                                                        Text {
                                                            text: persona.name + " (" + persona.id + ")";
                                                            color: persona.active ? Palette.text : Palette.text-disabled;
                                                            font-size: Typography.body;
                                                            horizontal-stretch: 1;
                                                            vertical-alignment: center;
                                                        }
                                                        Text {
                                                            text: persona.role + " · " + persona.state;
                                                            color: Palette.text-muted;
                                                            font-size: Typography.body-secondary;
                                                            vertical-alignment: center;
                                                        }
                                                        if root.administrator-mode: HudButton {
                                                            label: persona.active ? @tr("Sospendi") : @tr("Riattiva");
                                                            clicked => {
                                                                root.team-live-person-toggle(persona.id);
                                                            }
                                                        }
                                                        if root.administrator-mode: HudButton {
                                                            label: @tr("Rimetti la frase");
                                                            clicked => {
                                                                root.team-live-person-reset(persona.id);
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }

                                        // LA COPIA DELL'UFFICIO (TEAM-BACKUP-01,
                                        // ADR-0101). L'avvertenza sta FISSA in
                                        // schermata, non nel messaggio di esito:
                                        // chi la legge dopo un guasto la legge
                                        // troppo tardi.
                                        Text {
                                            text: @tr("Copia dell'ufficio");
                                            color: Palette.text;
                                            font-size: Typography.panel-title;
                                            font-weight: Typography.medium;
                                        }
                                        Text {
                                            text: @tr("La copia nasce su questo computer e si verifica qui. Solo dopo parte verso la cartella scelta. Una scrittura interrotta su una cartella condivisa lascerebbe un file che sembra una copia. Non contiene le chiavi dell'Hub, e ripristinare l'archivio non rimette l'identità dell'Hub. Un Hub ricostruito ha un'impronta nuova, da riportare alle postazioni. Il programma non ripristina da solo.");
                                            color: Palette.text-muted;
                                            font-size: Typography.body-secondary;
                                            wrap: word-wrap;
                                        }

                                        HorizontalLayout {
                                            spacing: Spacing.md;

                                            HudButton {
                                                label: @tr("Scrivi la copia dell'ufficio");
                                                clicked => {
                                                    root.team-live-backup();
                                                }
                                            }

                                            Rectangle { horizontal-stretch: 1; background: transparent; }
                                        }

                                        if root.team-live-backup-message != "" && root.team-live-backup-failed: ErrorBanner {
                                            message: root.team-live-backup-message;
                                        }
                                        if root.team-live-backup-message != "" && !root.team-live-backup-failed: InfoBanner {
                                            message: root.team-live-backup-message;
                                        }
                                    }
                                }

                                // CHI C'E' ADESSO.
                                if !root.exercise-mode: Text {
                                    text: @tr("Chi è collegato");
                                    color: Palette.text;
                                    font-size: Typography.panel-title;
                                    font-weight: Typography.medium;
                                }

                                if root.team-live-presence-summary != "": Text {
                                    text: root.team-live-presence-summary;
                                    color: Palette.text-muted;
                                    font-size: Typography.body-secondary;
                                    wrap: word-wrap;
                                }

                                if !root.exercise-mode: LegendaOrigini {
                                    calcolato: @tr("orari");
                                    operatore: @tr("postazione");
                                }
                                for postazione in root.team-live-presence: Rectangle {
                                    background: Palette.panel-raised;
                                    border-radius: Spacing.radius-panel;
                                    vertical-stretch: 0;

                                    // Un `Rectangle` non prende l'altezza dai figli (F-03).
                                    min-height: live-fit-5.preferred-height;
                                    live-fit-5 := VerticalLayout {
                                        padding: Spacing.lg;
                                        spacing: Spacing.xs;

                                        Text {
                                            text: postazione.station;
                                            color: Palette.text;
                                            font-size: Typography.body;
                                        }
                                        Text {
                                            text: postazione.since;
                                            color: Palette.text-muted;
                                            font-size: Typography.caption;
                                        }
                                        Text {
                                            text: postazione.last-seen;
                                            color: Palette.text-muted;
                                            font-size: Typography.caption;
                                        }
                                    }
                                }

                                // LA COPERTURA DELL'UFFICIO (HUB-COVERAGE-01,
                                // ADR-0199): che cosa l'ufficio stava guardando,
                                // detto dall'Hub. La propria resta in Monitoraggio.
                                if !root.exercise-mode && root.team-live-coverage != "": Rectangle {
                                    background: Palette.panel-raised;
                                    border-radius: Spacing.radius-panel;
                                    vertical-stretch: 0;

                                    // Un `Rectangle` non prende l'altezza dai figli (F-03).
                                    min-height: live-fit-copertura.preferred-height;
                                    live-fit-copertura := VerticalLayout {
                                        padding: Spacing.lg;
                                        spacing: Spacing.sm;

                                        Text {
                                            text: @tr("Che cosa stava guardando l'ufficio");
                                            color: Palette.text;
                                            font-size: Typography.panel-title;
                                            font-weight: Typography.medium;
                                        }
                                        Text {
                                            text: @tr("Calcolato dall'Hub. Ciò che guardava questa postazione resta nella schermata Monitoraggio.");
                                            color: Palette.text-muted;
                                            font-size: Typography.body-secondary;
                                            wrap: word-wrap;
                                        }
                                        Text {
                                            text: root.team-live-coverage;
                                            color: Palette.text;
                                            font-size: Typography.body-secondary;
                                            wrap: word-wrap;
                                        }
                                    }
                                }

                                // LE RIGHE DEL LIVE.
                                if !root.exercise-mode: Text {
                                    text: @tr("Che cosa è accaduto");
                                    color: Palette.text;
                                    font-size: Typography.panel-title;
                                    font-weight: Typography.medium;
                                }

                                // La frase mandava a premere «Aggiorna dall'Hub»,
                                // che in Esercitazione non e' collegato: era il
                                // giro che non si chiude (FINAL-FPR-ALL-16, FPR-01).
                                if !root.exercise-mode && root.team-live-rows.length == 0: Text {
                                    text: @tr("Nessun evento ricevuto finora. Se questa postazione segue un Hub, usare «Aggiorna dall'Hub»; se è l'Hub, il live si riempie quando un monitoraggio acquisisce.");
                                    color: Palette.text-muted;
                                    font-size: Typography.body-secondary;
                                    wrap: word-wrap;
                                }

                                if !root.exercise-mode: LegendaOrigini {
                                    osservato: @tr("di che cosa");
                                    calcolato: @tr("quando, che cosa e dettaglio");
                                }

                                // Prende l'avanzo di altezza (FPR-08).
                                Rectangle { vertical-stretch: 1; background: transparent; }
                                for riga in root.team-live-rows: Rectangle {
                                    background: Palette.panel-raised;
                                    border-radius: Spacing.radius-panel;
                                    vertical-stretch: 0;

                                    // Un `Rectangle` non prende l'altezza dai figli (F-03).
                                    min-height: live-fit-6.preferred-height;
                                    live-fit-6 := VerticalLayout {
                                        padding: Spacing.lg;
                                        spacing: Spacing.xs;

                                        HorizontalLayout {
                                            spacing: Spacing.sm;

                                            Text {
                                                text: riga.kind;
                                                color: Palette.text;
                                                font-size: Typography.body;
                                                font-weight: Typography.medium;
                                            }
                                            Text {
                                                text: riga.subject;
                                                color: Palette.text;
                                                font-size: Typography.body;
                                                horizontal-stretch: 1;
                                                wrap: word-wrap;
                                            }
                                            Text {
                                                text: riga.sequence;
                                                color: Palette.text-muted;
                                                font-size: Typography.body-secondary;
                                            }
                                        }
                                        if riga.detail != "": Text {
                                            text: riga.detail;
                                            color: Palette.text-muted;
                                            font-size: Typography.body-secondary;
                                            wrap: word-wrap;
                                        }
                                        Text {
                                            text: riga.when;
                                            color: Palette.text-muted;
                                            font-size: Typography.caption;
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // RIFERIMENTI INFORMATICI (PR-14, ADR-0130, DEC-357).
                    //
                    // Rende raggiungibili SOLTANTO le funzioni della Fase 8:
                    // il pacchetto STIX, le fotografie ATT&CK con le
                    // associazioni dichiarate da una persona, la risoluzione
                    // CVE e la presenza nel catalogo KEV. Ogni risposta dice da
                    // quale fotografia viene; nessun punteggio, nessuna
                    // deduzione di compromissione.
                    if root.current-page == 31: Rectangle {
                        property <bool> entered: false;
                        opacity: 0.0;
                        init => {
                            self.entered = true;
                        }
                        animate opacity {
                            duration: Motion.transition-effective;
                            easing: cubic-bezier(0.16, 1, 0.3, 1);
                        }
                        states [
                            shown when self.entered: {
                                opacity: 1.0;
                            }
                        ]
                        background: Palette.panel;
                        border-radius: Spacing.radius-panel;

                        HudScroll {
                            VerticalLayout {
                                padding: Spacing.xl;
                                spacing: Spacing.lg;

                                Text {
                                    text: @tr("Riferimenti informatici");
                                    color: Palette.text;
                                    font-size: Typography.screen-title;
                                    font-weight: Typography.medium;
                                }

                                Text {
                                    text: @tr("Le fotografie dei cataloghi pubblici importate in questo archivio, e ciò che se ne ricava. Il programma non scarica nulla: importa da una cartella ciò che le procedure di acquisizione hanno già preso.");
                                    color: Palette.text-muted;
                                    font-size: Typography.body-secondary;
                                    wrap: word-wrap;
                                }

                                AvvertenzaDiSicurezza {
                                    codice: "SIC-18";
                                    testo: @tr("Un identificativo CVE nominato in un messaggio non è una conclusione di compromissione né di pericolosità. Essere nel catalogo KEV dice che qualcuno ha sfruttato la vulnerabilità, non che sia accaduto qui.");
                                    dettaglio: @tr("Le risposte vengono dalle fotografie importate, con la loro data. Ciò che una fotografia non contiene si dice assente, non inesistente.");
                                }

                                if root.references-message != "" && root.references-message-area == 0: InfoBanner {
                                    message: root.references-message;
                                }

                                // ------------------------------- STIX
                                Panel {
                                    vertical-stretch: 0;
                                    title: @tr("Pacchetto STIX di un monitoraggio");

                                    VerticalLayout {
                                        spacing: Spacing.sm;
                                        Text {
                                            text: @tr("Gli indicatori dei contenuti di un monitoraggio, in un pacchetto da consegnare. L'anteprima dice che cosa entra e che cosa resta fuori, e perché.");
                                            color: Palette.text-muted;
                                            font-size: Typography.body-secondary;
                                            wrap: word-wrap;
                                        }
                                        HorizontalLayout {
                                            spacing: Spacing.md;
                                            vertical-stretch: 0;
                                            HudSelect {
                                                label: @tr("Monitoraggio");
                                                description: @tr("Il monitoraggio di cui esportare gli indicatori");
                                                model: root.references-sessions;
                                                current-index <=> root.references-session;
                                                width: 280px;
                                            }
                                            HudButton {
                                                label: @tr("Anteprima");
                                                enabled: root.references-sessions.length > 0;
                                                clicked => {
                                                    root.references-stix-preview();
                                                }
                                            }
                                            HudButton {
                                                label: @tr("Produci il pacchetto");
                                                weight: Weight.primary;
                                                enabled: root.references-stix-ready;
                                                clicked => {
                                                    root.references-stix-export();
                                                }
                                            }
                                            Rectangle { horizontal-stretch: 1; background: transparent; }
                                        }
                                        if root.references-stix-summary != "": Text {
                                            text: root.references-stix-summary;
                                            color: Palette.text;
                                            font-size: Typography.body-secondary;
                                            wrap: word-wrap;
                                        }
                                        LegendaOrigini {
                                            osservato: @tr("valore");
                                            calcolato: @tr("genere, quanti contenuti, esito");
                                        }
                                        for voce in root.references-stix-plan: Text {
                                            text: voce.value + " — " + voce.kind + ", " + voce.contents + ": " + voce.outcome;
                                            color: Palette.text-muted;
                                            font-size: Typography.technical;
                                            wrap: word-wrap;
                                        }
                                        // L'esito sta nel riquadro del comando (F-09).
                                        if root.references-message != "" && root.references-message-area == 1: InfoBanner {
                                            message: root.references-message;
                                        }
                                    }
                                }

                                // ------------------------------- TAXII
                                // Accanto al pacchetto STIX, lo stesso pacchetto mandato
                                // a una collezione TAXII. Si va in rete soltanto dopo
                                // «Conferma e manda», e soltanto verso la destinazione
                                // scritta qui (TAXII-01, ADR-0179).
                                Panel {
                                    vertical-stretch: 0;
                                    title: @tr("Mandare a TAXII");

                                    VerticalLayout {
                                        spacing: Spacing.sm;
                                        Text {
                                            text: @tr("Gli osservabili del monitoraggio scelto sopra, da mandare alla collezione TAXII dell'ufficio. Escono gli stessi oggetti del pacchetto STIX, nessun messaggio. Prima si prepara: si vede dove vanno e quanti sono.");
                                            color: Palette.text-muted;
                                            font-size: Typography.body-secondary;
                                            wrap: word-wrap;
                                        }
                                        HorizontalLayout {
                                            spacing: Spacing.md;
                                            vertical-stretch: 0;
                                            HudButton {
                                                label: @tr("Prepara l'invio");
                                                enabled: root.references-sessions.length > 0;
                                                clicked => {
                                                    root.references-taxii-preview();
                                                }
                                            }
                                            HudButton {
                                                label: @tr("Conferma e manda");
                                                weight: Weight.primary;
                                                enabled: root.references-taxii-ready;
                                                clicked => {
                                                    root.references-taxii-send();
                                                }
                                            }
                                            Rectangle { horizontal-stretch: 1; background: transparent; }
                                        }
                                        if root.references-taxii-summary != "": Text {
                                            text: root.references-taxii-summary;
                                            color: Palette.text;
                                            font-size: Typography.body-secondary;
                                            wrap: word-wrap;
                                        }
                                        // L'esito sta nel riquadro del comando (F-09).
                                        if root.references-message != "" && root.references-message-area == 5: InfoBanner {
                                            message: root.references-message;
                                        }
                                        if root.references-taxii-submissions != "": Text {
                                            text: root.references-taxii-submissions;
                                            color: Palette.text-muted;
                                            font-size: Typography.body-secondary;
                                            wrap: word-wrap;
                                        }
                                        // Quattro campi uno sotto l'altro: il segnaposto dice
                                        // come si scrive, non che cosa, e sparisce appena il
                                        // campo è compilato. Il nome sta sopra (INTEGRATION-01).
                                        Text {
                                            text: @tr("Indirizzo della destinazione TAXII");
                                            color: Palette.text-muted;
                                            font-size: Typography.body-secondary;
                                        }
                                        HudInput {
                                            label: @tr("Indirizzo della destinazione TAXII");
                                            placeholder: @tr("https://...");
                                            enabled: root.administrator-mode;
                                            value <=> root.references-taxii-root;
                                        }
                                        Text {
                                            text: @tr("Identificativo della collezione");
                                            color: Palette.text-muted;
                                            font-size: Typography.body-secondary;
                                        }
                                        HudInput {
                                            label: @tr("Identificativo della collezione");
                                            placeholder: @tr("lettere, cifre e trattini");
                                            enabled: root.administrator-mode;
                                            value <=> root.references-taxii-collection;
                                        }
                                        Text {
                                            text: @tr("Nome");
                                            color: Palette.text-muted;
                                            font-size: Typography.body-secondary;
                                        }
                                        HudInput {
                                            label: @tr("Nome");
                                            enabled: root.administrator-mode;
                                            value <=> root.references-taxii-username;
                                        }
                                        Text {
                                            text: @tr("Parola d'ordine");
                                            color: Palette.text-muted;
                                            font-size: Typography.body-secondary;
                                        }
                                        HudInput {
                                            label: @tr("Parola d'ordine");
                                            placeholder: @tr("vuota, resta quella di prima");
                                            masked: true;
                                            enabled: root.administrator-mode;
                                            value <=> root.references-taxii-password;
                                        }
                                        if root.references-taxii-note != "": Text {
                                            text: root.references-taxii-note;
                                            color: Palette.text-muted;
                                            font-size: Typography.body-secondary;
                                            wrap: word-wrap;
                                        }
                                        HorizontalLayout {
                                            alignment: start;
                                            if root.administrator-mode: HudButton {
                                                label: @tr("Salva la destinazione");
                                                clicked => {
                                                    root.references-taxii-save();
                                                }
                                            }
                                        }
                                    }
                                }

                                // ------------------------------- ATT&CK
                                Panel {
                                    vertical-stretch: 0;
                                    title: @tr("MITRE ATT&CK");

                                    VerticalLayout {
                                        spacing: Spacing.sm;
                                        Text {
                                            text: @tr("Le fotografie importate, e le associazioni fra un termine del dizionario e una tecnica, dichiarate da una persona con il motivo. Un'associazione dice che il termine ricorre nei materiali di quella tecnica, non che qualcuno l'abbia usata.");
                                            color: Palette.text-muted;
                                            font-size: Typography.body-secondary;
                                            wrap: word-wrap;
                                        }
                                        LegendaOrigini {
                                            osservato: @tr("fonte");
                                            calcolato: @tr("istante, contenuto");
                                            operatore: @tr("chi");
                                        }
                                        for fotografia in root.references-attack-snapshots: Text {
                                            text: @tr("{} — importata il {} da {}. {}", fotografia.source, fotografia.when, fotografia.who, fotografia.content);
                                            color: Palette.text-muted;
                                            font-size: Typography.technical;
                                            wrap: word-wrap;
                                        }
                                        if root.references-attack-snapshots.length == 0: Text {
                                            text: @tr("Nessuna fotografia importata.");
                                            color: Palette.text-muted;
                                            font-size: Typography.body-secondary;
                                        }
                                        HorizontalLayout {
                                            spacing: Spacing.md;
                                            vertical-stretch: 0;
                                            HudInput {
                                                label: @tr("Cartella della fotografia");
                                                placeholder: @tr("La cartella preparata dalla procedura di acquisizione di ATT&CK");
                                                value <=> root.references-attack-folder;
                                                horizontal-stretch: 1;
                                            }
                                            HudButton {
                                                label: @tr("Importa");
                                                enabled: root.references-attack-folder != "";
                                                clicked => {
                                                    root.references-attack-import();
                                                }
                                            }
                                            HudButton {
                                                label: @tr("Scarica dalla fonte ufficiale");
                                                clicked => {
                                                    root.references-attack-download();
                                                }
                                            }
                                        }
                                        // Il nome dei campi resta scritto anche quando il
                                        // segnaposto sparisce (F-33).
                                        Text {
                                            text: @tr("Termine e categoria, come sono scritti nel dizionario:");
                                            color: Palette.text-muted;
                                            font-size: Typography.body-secondary;
                                            wrap: word-wrap;
                                        }
                                        HorizontalLayout {
                                            spacing: Spacing.md;
                                            vertical-stretch: 0;
                                            HudInput {
                                                label: @tr("Termine");
                                                placeholder: @tr("Il termine del dizionario");
                                                value <=> root.references-attack-term;
                                                horizontal-stretch: 1;
                                            }
                                            HudInput {
                                                label: @tr("Categoria");
                                                placeholder: @tr("La sua categoria");
                                                value <=> root.references-attack-category;
                                                horizontal-stretch: 1;
                                            }
                                            HudButton {
                                                label: @tr("Mostra le associazioni");
                                                enabled: root.references-attack-term != "" && root.references-attack-category != "";
                                                clicked => {
                                                    root.references-attack-lookup();
                                                }
                                            }
                                        }
                                        LegendaOrigini {
                                            calcolato: @tr("frase, istante");
                                            operatore: @tr("motivo, chi");
                                        }
                                        for associazione in root.references-attack-associations: Rectangle {
                                            // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                            min-height: rip-123.preferred-height;
                                            rip-123 := HorizontalLayout {
                                                spacing: Spacing.md;
                                                Text {
                                                    text: @tr("{} Motivo: {} ({}, {})", associazione.sentence, associazione.motive, associazione.who, associazione.when);
                                                    color: Palette.text-muted;
                                                    font-size: Typography.technical;
                                                    wrap: word-wrap;
                                                    horizontal-stretch: 1;
                                                }
                                                HudButton {
                                                    label: @tr("Ritira");
                                                    enabled: root.references-attack-withdraw-motive != "";
                                                    clicked => {
                                                        root.references-attack-withdraw(associazione.key);
                                                    }
                                                }
                                            }
                                        }
                                        HudInput {
                                            label: @tr("Motivo del ritiro");
                                            placeholder: @tr("Perché l'associazione non vale più");
                                            value <=> root.references-attack-withdraw-motive;
                                        }
                                        Text {
                                            text: @tr("Tecnica ATT&CK e motivo dell'associazione:");
                                            color: Palette.text-muted;
                                            font-size: Typography.body-secondary;
                                            wrap: word-wrap;
                                        }
                                        HorizontalLayout {
                                            spacing: Spacing.md;
                                            vertical-stretch: 0;
                                            HudInput {
                                                label: @tr("Tecnica");
                                                placeholder: @tr("Per esempio T1566");
                                                value <=> root.references-attack-technique;
                                                width: 180px;
                                            }
                                            HudInput {
                                                label: @tr("Motivo dell'associazione");
                                                placeholder: @tr("Perché questo termine si associa a questa tecnica");
                                                value <=> root.references-attack-motive;
                                                horizontal-stretch: 1;
                                            }
                                            HudButton {
                                                label: @tr("Dichiara");
                                                enabled: root.references-attack-term != "" && root.references-attack-category != "" && root.references-attack-technique != "" && root.references-attack-motive != "";
                                                clicked => {
                                                    root.references-attack-declare();
                                                }
                                            }
                                        }
                                        // LA SCHEDA DELLA TECNICA (ATTACK-03, ADR-0185): il nome,
                                        // e ciò che ATT&CK suggerisce. Non dichiara niente.
                                        HorizontalLayout {
                                            spacing: Spacing.sm;
                                            vertical-stretch: 0;
                                            HudButton {
                                                label: @tr("Mostra la tecnica");
                                                enabled: root.references-attack-technique != "";
                                                clicked => {
                                                    root.references-attack-show();
                                                }
                                            }
                                            Rectangle { horizontal-stretch: 1; background: transparent; }
                                        }
                                        // L'esito sta nel riquadro del comando (F-09).
                                        if root.references-message != "" && root.references-message-area == 2: InfoBanner {
                                            message: root.references-message;
                                        }
                                    }
                                }

                                // ------------------------------- CVE
                                Panel {
                                    vertical-stretch: 0;
                                    title: @tr("CVE");

                                    VerticalLayout {
                                        spacing: Spacing.sm;
                                        Text {
                                            text: @tr("Le fotografie del catalogo NVD importate, e la risposta per un identificativo. Un anno che la fotografia non comprende non rende inesistente un identificativo.");
                                            color: Palette.text-muted;
                                            font-size: Typography.body-secondary;
                                            wrap: word-wrap;
                                        }
                                        LegendaOrigini {
                                            osservato: @tr("fonte");
                                            calcolato: @tr("istante, contenuto");
                                            operatore: @tr("chi");
                                        }
                                        for fotografia in root.references-cve-snapshots: Text {
                                            text: @tr("{} — importata il {} da {}. {}", fotografia.source, fotografia.when, fotografia.who, fotografia.content);
                                            color: Palette.text-muted;
                                            font-size: Typography.technical;
                                            wrap: word-wrap;
                                        }
                                        if root.references-cve-snapshots.length == 0: Text {
                                            text: @tr("Nessuna fotografia importata.");
                                            color: Palette.text-muted;
                                            font-size: Typography.body-secondary;
                                        }
                                        HorizontalLayout {
                                            spacing: Spacing.md;
                                            vertical-stretch: 0;
                                            HudInput {
                                                label: @tr("Cartella della fotografia");
                                                placeholder: @tr("La cartella preparata dalla procedura di acquisizione delle CVE");
                                                value <=> root.references-cve-folder;
                                                horizontal-stretch: 1;
                                            }
                                            HudInput {
                                                label: @tr("Anni");
                                                placeholder: @tr("Per esempio 2024, 2025, 2026");
                                                value <=> root.references-cve-years;
                                                width: 200px;
                                            }
                                            HudButton {
                                                label: @tr("Importa");
                                                enabled: root.references-cve-folder != "" && root.references-cve-years != "";
                                                clicked => {
                                                    root.references-cve-import();
                                                }
                                            }
                                            HudButton {
                                                label: @tr("Scarica dalla fonte ufficiale");
                                                clicked => {
                                                    root.references-cve-download();
                                                }
                                            }
                                        }
                                        HorizontalLayout {
                                            spacing: Spacing.md;
                                            vertical-stretch: 0;
                                            HudInput {
                                                label: @tr("Identificativo CVE");
                                                placeholder: @tr("Per esempio CVE-2024-3094");
                                                value <=> root.references-cve-id;
                                                horizontal-stretch: 1;
                                            }
                                            HudButton {
                                                label: @tr("Cerca nella fotografia");
                                                enabled: root.references-cve-id != "" && root.references-cve-snapshots.length > 0;
                                                clicked => {
                                                    root.references-cve-resolve();
                                                }
                                            }
                                        }
                                        if root.references-cve-answer != "": Text {
                                            text: root.references-cve-answer;
                                            color: Palette.text;
                                            font-size: Typography.body-secondary;
                                            wrap: word-wrap;
                                        }
                                        // L'esito sta nel riquadro del comando (F-09).
                                        if root.references-message != "" && root.references-message-area == 3: InfoBanner {
                                            message: root.references-message;
                                        }
                                    }
                                }

                                // ------------------------------- KEV
                                Panel {
                                    vertical-stretch: 0;
                                    title: @tr("Catalogo KEV");

                                    VerticalLayout {
                                        spacing: Spacing.sm;
                                        Text {
                                            text: @tr("Le fotografie del catalogo CISA delle vulnerabilità sfruttate, e la presenza di un identificativo. L'assenza dal catalogo non dice che nessuno l'abbia sfruttata.");
                                            color: Palette.text-muted;
                                            font-size: Typography.body-secondary;
                                            wrap: word-wrap;
                                        }
                                        LegendaOrigini {
                                            osservato: @tr("fonte");
                                            calcolato: @tr("istante, contenuto");
                                            operatore: @tr("chi");
                                        }
                                        for fotografia in root.references-kev-snapshots: Text {
                                            text: @tr("{} — importata il {} da {}. {}", fotografia.source, fotografia.when, fotografia.who, fotografia.content);
                                            color: Palette.text-muted;
                                            font-size: Typography.technical;
                                            wrap: word-wrap;
                                        }
                                        if root.references-kev-snapshots.length == 0: Text {
                                            text: @tr("Nessuna fotografia importata.");
                                            color: Palette.text-muted;
                                            font-size: Typography.body-secondary;
                                        }
                                        HorizontalLayout {
                                            spacing: Spacing.md;
                                            vertical-stretch: 0;
                                            HudInput {
                                                label: @tr("Cartella della fotografia");
                                                placeholder: @tr("La cartella preparata dalla procedura di acquisizione del catalogo KEV");
                                                value <=> root.references-kev-folder;
                                                horizontal-stretch: 1;
                                            }
                                            HudButton {
                                                label: @tr("Importa");
                                                enabled: root.references-kev-folder != "";
                                                clicked => {
                                                    root.references-kev-import();
                                                }
                                            }
                                            HudButton {
                                                label: @tr("Scarica dalla fonte ufficiale");
                                                clicked => {
                                                    root.references-kev-download();
                                                }
                                            }
                                        }
                                        HorizontalLayout {
                                            spacing: Spacing.md;
                                            vertical-stretch: 0;
                                            HudInput {
                                                label: @tr("Identificativo CVE");
                                                placeholder: @tr("Per esempio CVE-2024-3094");
                                                value <=> root.references-kev-id;
                                                horizontal-stretch: 1;
                                            }
                                            HudButton {
                                                label: @tr("Cerca nel catalogo");
                                                enabled: root.references-kev-id != "" && root.references-kev-snapshots.length > 0;
                                                clicked => {
                                                    root.references-kev-resolve();
                                                }
                                            }
                                        }
                                        if root.references-kev-answer != "": Text {
                                            text: root.references-kev-answer;
                                            color: Palette.text;
                                            font-size: Typography.body-secondary;
                                            wrap: word-wrap;
                                        }
                                        // L'esito sta nel riquadro del comando (F-09).
                                        if root.references-message != "" && root.references-message-area == 4: InfoBanner {
                                            message: root.references-message;
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // ------------------------------------ Revisione condivisa
                    //
                    // Cio' che l'Hub ha segnalato, e che l'ufficio rivede
                    // insieme (TEAM-REVIEW-01, ADR-0094).
                    //
                    // L'ELENCO NON PORTA IL TESTO: si guarda, e il contenuto si
                    // apre uno per volta. Aprirlo e' un atto, e l'Hub registra
                    // quale postazione lo ha chiesto.
                    //
                    // CHI DECIDE E' UNA POSTAZIONE, non una persona: l'identita'
                    // di operatore autenticata non esiste ancora, e attribuire
                    // a un segnaposto scriverebbe nel registro un nome che
                    // nessuno ha verificato.
                    // ------------------------------------------------ 29. RACCOGLITORI DELL'UFFICIO
                    //
                    // Cio' che l'ufficio tiene insieme (TEAM-WS-01, ADR-0099).
                    // Un raccoglitore porta RIFERIMENTI, mai i testi: il
                    // contenuto si chiede uno per volta (ADR-0094).
                    // RICERCA PUNTUALE (PR-09, ADR-0125).
                    //
                    // Che cosa Telegram rende visibile all'account d'ufficio a
                    // partire da UN dato. Cinque esiti, e soltanto due sono
                    // risultati: gli altri tre dicono che la richiesta non e'
                    // arrivata a una risposta, e non vanno letti come assenze.
                    if root.current-page == 30: Rectangle {
                        property <bool> entered: false;
                        opacity: 0.0;
                        init => {
                            self.entered = true;
                        }
                        animate opacity {
                            duration: Motion.transition-effective;
                            easing: cubic-bezier(0.16, 1, 0.3, 1);
                        }
                        states [
                            shown when self.entered: {
                                opacity: 1.0;
                            }
                        ]
                        background: Palette.panel;
                        border-radius: Spacing.radius-panel;

                        HudScroll {
                            VerticalLayout {
                                padding: Spacing.xl;
                                spacing: Spacing.lg;

                                Text {
                                    text: @tr("Ricerca puntuale");
                                    color: Palette.text;
                                    font-size: Typography.screen-title;
                                    font-weight: Typography.medium;
                                }

                                Text {
                                    text: @tr("Chiede a Telegram che cosa rende visibile all'account d'ufficio a partire da un solo dato: un nome utente, un numero, un identificativo o un collegamento. Usa soltanto le richieste ufficiali, e non cerca altrove.");
                                    color: Palette.text-muted;
                                    font-size: Typography.body-secondary;
                                    wrap: word-wrap;
                                }
                                Text {
                                    text: @tr("Da un numero non si ricava sempre una persona. Da un nome utente non si ricava mai un numero: Telegram li dà soltanto quando la persona lo consente. Trovare un profilo non è un giudizio su una persona.");
                                    color: Palette.amber;
                                    font-size: Typography.body-secondary;
                                    wrap: word-wrap;
                                }
                                Text {
                                    text: @tr("Al più 20 ricerche per ora, e 15 secondi fra una ricerca e l'altra. Una ricerca puntuale fatta a raffica non è una ricerca puntuale.");
                                    color: Palette.text-muted;
                                    font-size: Typography.group-label;
                                    wrap: word-wrap;
                                }

                                HorizontalLayout {
                                    spacing: Spacing.md;
                                    vertical-stretch: 0;

                                    HudSelect {
                                        label: @tr("Che cosa");
                                        description: @tr("Il genere del dato da cercare");
                                        model: [@tr("Nome utente"), @tr("Numero di telefono"), @tr("Identificativo Telegram"), @tr("Collegamento")];
                                        current-index <=> root.resolver-kind;
                                        width: 220px;
                                    }
                                    HudInput {
                                        label: @tr("Il dato");
                                        placeholder: @tr("Un solo dato");
                                        value <=> root.resolver-input;
                                        horizontal-stretch: 1;
                                    }
                                }
                                HudInput {
                                    label: @tr("Ragione operativa");
                                    placeholder: @tr("Perché serve questa ricerca");
                                    value <=> root.resolver-reason;
                                }
                                HorizontalLayout {
                                    vertical-stretch: 0;
                                    HudButton {
                                        label: @tr("Chiedi a Telegram");
                                        weight: Weight.primary;
                                        enabled: root.resolver-input != "" && root.resolver-reason != "";
                                        clicked => {
                                            root.resolver-ask();
                                        }
                                    }
                                    Rectangle { horizontal-stretch: 1; background: transparent; }
                                }

                                if root.resolver-message != "": InfoBanner {
                                    message: root.resolver-message;
                                }

                                // L'ESITO: la parola, il motivo, che cosa fare.
                                if root.resolver-has-outcome: Rectangle {
                                    background: Palette.panel-raised;
                                    border-radius: Spacing.radius-panel;
                                    vertical-stretch: 0;

                                    // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                    min-height: rip-124.preferred-height;
                                    rip-124 := VerticalLayout {
                                        padding: Spacing.lg;
                                        spacing: Spacing.xs;

                                        Text {
                                            text: root.resolver-outcome-label;
                                            color: Palette.text;
                                            font-size: Typography.body;
                                            font-weight: Typography.medium;
                                        }
                                        Text {
                                            text: root.resolver-outcome-sentence;
                                            color: Palette.text;
                                            font-size: Typography.body-secondary;
                                            wrap: word-wrap;
                                        }
                                        Text {
                                            text: root.resolver-outcome-todo;
                                            color: Palette.text-muted;
                                            font-size: Typography.body-secondary;
                                            wrap: word-wrap;
                                        }
                                    }
                                }

                                Text {
                                    text: @tr("RICERCHE REGISTRATE");
                                    color: Palette.text-muted;
                                    font-family: Typography.mono;
                                    font-size: Typography.eyebrow;
                                    font-weight: Typography.regular;
                                    letter-spacing: Typography.track-eyebrow;
                                }
                                LegendaOrigini {
                                    osservato: @tr("ciò che Telegram ha restituito");
                                    calcolato: @tr("esito");
                                    operatore: @tr("chi, il dato cercato");
                                }
                                for ricerca in root.resolver-rows: Rectangle {
                                    background: Palette.panel-raised;
                                    border-radius: Spacing.radius-row;
                                    vertical-stretch: 0;

                                    // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                    min-height: rip-125.preferred-height;
                                    rip-125 := VerticalLayout {
                                        padding: Spacing.lg;
                                        spacing: Spacing.xs;

                                        Text {
                                            text: ricerca.outcome + "  \u{00b7}  " + ricerca.input;
                                            color: Palette.text;
                                            font-size: Typography.body;
                                            font-weight: Typography.medium;
                                            wrap: word-wrap;
                                        }
                                        Text {
                                            text: ricerca.when + ", " + ricerca.operator;
                                            color: Palette.text-muted;
                                            font-size: Typography.group-label;
                                        }
                                        if ricerca.found != "": Text {
                                            text: ricerca.found;
                                            color: Palette.text;
                                            font-size: Typography.body-secondary;
                                            wrap: word-wrap;
                                        }
                                        Text {
                                            text: ricerca.sentence;
                                            color: Palette.text-muted;
                                            font-size: Typography.body-secondary;
                                            wrap: word-wrap;
                                        }
                                        // Collegare e' un gesto di una persona:
                                        // il comando esiste soltanto su un
                                        // «Trovato» di una persona o di un account.
                                        if ricerca.linkable: Rectangle {
                                            // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                            min-height: rip-126.preferred-height;
                                            rip-126 := HorizontalLayout {
                                                vertical-stretch: 0;
                                                HudButton {
                                                    label: @tr("Collega a un soggetto");
                                                    enabled: root.resolver-linking < 0;
                                                    accessible-label: @tr("Collega a un soggetto, {}", ricerca.input);
                                                    clicked => {
                                                        root.resolver-link-start(ricerca.id);
                                                    }
                                                }
                                                Rectangle { horizontal-stretch: 1; background: transparent; }
                                            }
                                        }
                                    }
                                }

                                // IL COLLEGAMENTO (PR-10): quale soggetto e
                                // perche'. Nessun soggetto e' proposto: si
                                // sceglie fra quelli aperti, in ordine di nome.
                                if root.resolver-linking >= 0: Rectangle {
                                    background: Palette.panel-raised;
                                    border-radius: Spacing.radius-panel;
                                    vertical-stretch: 0;

                                    // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                    min-height: rip-127.preferred-height;
                                    rip-127 := VerticalLayout {
                                        padding: Spacing.lg;
                                        spacing: Spacing.sm;

                                        Text {
                                            text: @tr("COLLEGARE A UN SOGGETTO");
                                            color: Palette.text-muted;
                                            font-family: Typography.mono;
                                            font-size: Typography.eyebrow;
                                            font-weight: Typography.regular;
                                            letter-spacing: Typography.track-eyebrow;
                                        }
                                        Text {
                                            text: @tr("Collegare un'identità a un fascicolo è una decisione di una persona. Non è un giudizio sulla persona, e non dice nulla su condotte, appartenenze o opinioni.");
                                            color: Palette.amber;
                                            font-size: Typography.body-secondary;
                                            wrap: word-wrap;
                                        }
                                        HudSelect {
                                            label: @tr("Soggetto");
                                            description: @tr("Il fascicolo aperto a cui collegare questa identità");
                                            model: root.resolver-subjects;
                                            current-index <=> root.resolver-subject-index;
                                        }
                                        HudInput {
                                            label: @tr("Perché è la stessa persona");
                                            placeholder: @tr("Su che cosa si decide, in almeno venti caratteri");
                                            value <=> root.resolver-link-reason;
                                        }
                                        HorizontalLayout {
                                            spacing: Spacing.md;
                                            vertical-stretch: 0;
                                            HudButton {
                                                label: @tr("Collega");
                                                weight: Weight.primary;
                                                enabled: root.resolver-link-reason != "" && root.resolver-subjects.length > 0;
                                                clicked => {
                                                    root.resolver-link-confirm();
                                                }
                                            }
                                            HudButton {
                                                label: @tr("Annulla");
                                                clicked => {
                                                    root.resolver-link-cancel();
                                                }
                                            }
                                            Rectangle { horizontal-stretch: 1; background: transparent; }
                                        }
                                    }
                                }
                                if root.resolver-link-message != "": InfoBanner {
                                    message: root.resolver-link-message;
                                }
                            }
                        }
                    }

                    if root.current-page == 29: Rectangle {
                        property <bool> entered: false;
                        opacity: 0.0;
                        init => {
                            self.entered = true;
                        }
                        animate opacity {
                            duration: Motion.transition-effective;
                            easing: cubic-bezier(0.16, 1, 0.3, 1);
                        }
                        states [
                            shown when self.entered: {
                                opacity: 1.0;
                            }
                        ]
                        background: Palette.panel;
                        border-radius: Spacing.radius-panel;

                        HudScroll {
                            VerticalLayout {
                                padding: Spacing.xl;
                                spacing: Spacing.lg;

                                Text {
                                    vertical-stretch: 0;
                                    text: @tr("Raccoglitori dell'ufficio");
                                    color: Palette.text;
                                    font-size: Typography.screen-title;
                                    font-weight: Typography.medium;
                                }

                                // CHE COSA E', PRIMA DI MOSTRARLO.
                                Text {
                                    vertical-stretch: 0;
                                    text: @tr("Qui l'ufficio tiene insieme ciò su cui sta lavorando. Un raccoglitore porta riferimenti — che cosa e quale — e mai i testi: il contenuto si chiede uno per volta. Chiudere un raccoglitore non cancella niente: smette di accettare elementi, e ciò che ha raccolto resta.");
                                    color: Palette.text-muted;
                                    font-size: Typography.body-secondary;
                                    wrap: word-wrap;
                                }

                                if root.shared-message != "": Rectangle {
                                    background: Palette.panel-raised;
                                    border-radius: Spacing.radius-panel;
                                    vertical-stretch: 0;

                                    // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                    min-height: rip-128.preferred-height;
                                    rip-128 := VerticalLayout {
                                        padding: Spacing.lg;

                                        Text {
                                            text: root.shared-message;
                                            color: Palette.text;
                                            font-size: Typography.body-secondary;
                                            wrap: word-wrap;
                                        }
                                    }
                                }

                                // IN ESERCITAZIONE I RACCOGLITORI DELL'UFFICIO
                                // STANNO SULL'HUB, e l'Esercitazione non si
                                // collega all'Hub: la pagina mandava a entrare
                                // dalla Revisione condivisa, cioe' da una porta
                                // che qui non si apre (FINAL-FPR-ALL-16, FPR-01).
                                if root.exercise-mode: InfoBanner {
                                    // Alto quanto il suo testo (CAPABILITY-AUDIT-02,
                                    // CA02-08): senza, la pagina quasi vuota divideva
                                    // l'altezza fra i suoi elementi, e il riquadro
                                    // diventava sproporzionato.
                                    vertical-stretch: 0;
                                    message: @tr("In Esercitazione i raccoglitori dell'ufficio non si provano: stanno sull'Hub. Si provano su una postazione collegata a un Hub, dopo l'ingresso dalla Revisione condivisa. Qui si provano i raccoglitori di questa postazione, dalla voce «Raccoglitori» del menu.");
                                }
                                // L'avanzo lo prende questo spaziatore, in fondo.
                                if root.exercise-mode: Rectangle {
                                    vertical-stretch: 1;
                                    background: transparent;
                                }

                                if !root.exercise-mode: Rectangle {
                                    // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                    min-height: rip-129.preferred-height;
                                    rip-129 := HorizontalLayout {
                                        spacing: Spacing.md;
                                        vertical-stretch: 0;

                                        HudButton {
                                            label: @tr("Aggiorna");
                                            clicked => {
                                                root.shared-refresh();
                                            }
                                        }

                                        Rectangle { horizontal-stretch: 1; background: transparent; }
                                    }
                                }

                                // APRIRNE UNO E' DI CHI E' ENTRATO.
                                if root.shared-person != "": Rectangle {
                                    // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                    min-height: rip-130.preferred-height;
                                    rip-130 := HorizontalLayout {
                                        spacing: Spacing.md;

                                        nome := HudInput {
                                            label: @tr("Nome del raccoglitore");
                                            placeholder: @tr("Come lo chiama l'ufficio");
                                        }
                                        scopo := HudInput {
                                            label: @tr("A che cosa serve");
                                            placeholder: @tr("Facoltativo");
                                        }
                                        HudButton {
                                            label: @tr("Crea il raccoglitore");
                                            clicked => {
                                                root.shared-open(nome.value, scopo.value);
                                            }
                                        }
                                    }
                                }

                                if !root.exercise-mode && root.shared-person == "": Text {
                                    text: @tr("Nessuno è entrato: i raccoglitori si leggono, ma per aprirne uno o metterci dentro qualcosa occorre entrare come persona dalla Revisione condivisa.");
                                    color: Palette.text-muted;
                                    font-size: Typography.body-secondary;
                                    wrap: word-wrap;
                                }

                                if !root.exercise-mode && root.shared-workspaces.length == 0: Text {
                                    text: @tr("L'ufficio non tiene ancora nessun raccoglitore.");
                                    color: Palette.text-muted;
                                    font-size: Typography.body-secondary;
                                    wrap: word-wrap;
                                }

                                if !root.exercise-mode: LegendaOrigini {
                                    calcolato: @tr("riepilogo");
                                    operatore: @tr("nome, descrizione e stato");
                                }

                                for raccoglitore in root.shared-workspaces: Rectangle {
                                    background: Palette.panel-raised;
                                    border-radius: Spacing.radius-panel;
                                    vertical-stretch: 0;

                                    // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                    min-height: rip-131.preferred-height;
                                    rip-131 := VerticalLayout {
                                        padding: Spacing.lg;
                                        spacing: Spacing.xs;

                                        HorizontalLayout {
                                            spacing: Spacing.sm;

                                            Text {
                                                text: raccoglitore.name;
                                                color: Palette.text;
                                                font-size: Typography.body;
                                                font-weight: Typography.medium;
                                                horizontal-stretch: 1;
                                            }
                                            Text {
                                                text: raccoglitore.state;
                                                color: Palette.text-muted;
                                                font-size: Typography.caption;
                                            }
                                            if raccoglitore.open && root.shared-person != "": HudButton {
                                                label: @tr("Chiudi");
                                                clicked => {
                                                    root.shared-close(raccoglitore.id);
                                                }
                                            }
                                        }

                                        if raccoglitore.description != "": Text {
                                            text: raccoglitore.description;
                                            color: Palette.text-muted;
                                            font-size: Typography.body-secondary;
                                            wrap: word-wrap;
                                        }
                                        Text {
                                            text: raccoglitore.summary;
                                            color: Palette.text-muted;
                                            font-size: Typography.caption;
                                            wrap: word-wrap;
                                        }
                                        HudButton {
                                            label: @tr("Mostra che cosa ha raccolto");
                                            clicked => {
                                                root.shared-show-items(raccoglitore.id);
                                            }
                                        }
                                    }
                                }

                                if root.shared-items.length > 0: Text {
                                    text: @tr("Che cosa ha raccolto");
                                    color: Palette.text;
                                    font-size: Typography.panel-title;
                                    font-weight: Typography.medium;
                                }

                                // METTERE NEL RACCOGLITORE (FINAL-REVIEW-01,
                                // FR-050): il riferimento si indica con il suo
                                // genere e il suo numero, come compare nella
                                // Revisione condivisa. Mai il testo.
                                if root.shared-shown-workspace != 0 && root.shared-shown-open
                                    && root.shared-person != "": Rectangle {
                                    // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                    min-height: rip-132.preferred-height;
                                    rip-132 := HorizontalLayout {
                                        spacing: Spacing.md;
                                        HudSelect {
                                            label: @tr("Che cosa");
                                            model: [@tr("Contenuto"), @tr("Fonte"), @tr("Rapporto")];
                                            current-index <=> root.shared-collect-kind;
                                        }
                                        HudInput {
                                            label: @tr("Numero");
                                            placeholder: @tr("il numero dell'elemento");
                                            value <=> root.shared-collect-number;
                                        }
                                        HudButton {
                                            label: @tr("Metti nel raccoglitore");
                                            enabled: root.shared-collect-number != "";
                                            clicked => {
                                                root.shared-collect();
                                            }
                                        }
                                    }
                                }

                                if !root.exercise-mode: LegendaOrigini {
                                    osservato: @tr("l'elemento");
                                    operatore: @tr("chi l'ha aggiunto");
                                }
                                for elemento in root.shared-items: Rectangle {
                                    background: Palette.panel-raised;
                                    border-radius: Spacing.radius-panel;
                                    vertical-stretch: 0;

                                    // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                    min-height: rip-133.preferred-height;
                                    rip-133 := HorizontalLayout {
                                        padding: Spacing.lg;
                                        spacing: Spacing.md;

                                        VerticalLayout {
                                            spacing: Spacing.xs;
                                            horizontal-stretch: 1;

                                            Text {
                                                text: elemento.what;
                                                color: Palette.text;
                                                font-size: Typography.body-secondary;
                                            }
                                            Text {
                                                text: elemento.added;
                                                color: Palette.text-muted;
                                                font-size: Typography.caption;
                                            }
                                        }
                                        if root.shared-shown-open && root.shared-person != "": HudButton {
                                            label: @tr("Togli");
                                            clicked => {
                                                root.shared-drop(elemento.kind, elemento.target);
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    if root.current-page == 28: Rectangle {
                        // Comparsa graduale della pagina: vedere la pagina 0 per il
                        // perche' la dissolvenza sia solo in entrata.
                        property <bool> entered: false;
                        opacity: 0.0;
                        init => {
                            self.entered = true;
                        }
                        animate opacity {
                            duration: Motion.transition-effective;
                            easing: cubic-bezier(0.16, 1, 0.3, 1);
                        }
                        states [
                            shown when self.entered: {
                                opacity: 1.0;
                            }
                        ]
                        background: Palette.panel;
                        border-radius: Spacing.radius-panel;

                        HudScroll {
                            VerticalLayout {
                                padding: Spacing.xl;
                                spacing: Spacing.lg;

                                Text {
                                    text: @tr("Revisione condivisa");
                                    color: Palette.text;
                                    font-size: Typography.screen-title;
                                    font-weight: Typography.medium;
                                }

                                // CHE COSA E', PRIMA DI MOSTRARLO.
                                Text {
                                    text: @tr("Qui si rivede insieme ciò che l'Hub ha segnalato. L'elenco dice da quale fonte, con quale livello e in quale stato. Il testo del messaggio si apre un elemento per volta. Ogni apertura resta registrata sull'Hub. Le decisioni portano il nome di chi è entrato; quando non è entrato nessuno, quello della postazione.");
                                    color: Palette.text-muted;
                                    font-size: Typography.body-secondary;
                                    wrap: word-wrap;
                                }

                                // IN ESERCITAZIONE NON C'E' NESSUN HUB, e le
                                // persone dell'ufficio stanno sull'Hub: «Entra»
                                // non era collegato a niente
                                // (FINAL-FPR-ALL-16, FPR-01).
                                if root.exercise-mode: InfoBanner {
                                    message: @tr("In Esercitazione la revisione condivisa non si prova: le persone dell'ufficio e le prese in carico stanno sull'Hub. Si prova su una postazione collegata a un Hub, con la propria frase di accesso. Qui la revisione si fa negli Avvisi e nello Storico.");
                                }

                                if !root.exercise-mode: Rectangle {
                                    // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                    min-height: rip-134.preferred-height;
                                    rip-134 := HorizontalLayout {
                                        spacing: Spacing.md;
                                        vertical-stretch: 0;

                                        HudButton {
                                            label: @tr("Aggiorna l'elenco");
                                            clicked => {
                                                root.review-shown();
                                            }
                                        }

                                        Rectangle { horizontal-stretch: 1; background: transparent; }
                                    }
                                }

                                if root.review-message != "": Rectangle {
                                    background: Palette.panel-raised;
                                    border-radius: Spacing.radius-panel;
                                    vertical-stretch: 0;

                                    // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                    min-height: rip-135.preferred-height;
                                    rip-135 := VerticalLayout {
                                        padding: Spacing.lg;

                                        Text {
                                            text: root.review-message;
                                            color: Palette.text;
                                            font-size: Typography.body-secondary;
                                            wrap: word-wrap;
                                        }
                                    }
                                }

                                // CHI E' ENTRATO.
                                if !root.exercise-mode: Rectangle {
                                    background: Palette.panel-raised;
                                    border-radius: Spacing.radius-panel;
                                    vertical-stretch: 0;

                                    // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                    min-height: rip-136.preferred-height;
                                    rip-136 := VerticalLayout {
                                        padding: Spacing.lg;
                                        spacing: Spacing.sm;

                                        if root.review-person == "": Text {
                                            text: @tr("Nessuno è entrato. Finché non entra una persona, gli atti restano della postazione e il lavoro non si può assegnare.");
                                            color: Palette.text-muted;
                                            font-size: Typography.body-secondary;
                                            wrap: word-wrap;
                                        }

                                        if root.review-person == "": Rectangle {
                                            // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                            min-height: rip-137.preferred-height;
                                            rip-137 := HorizontalLayout {
                                                spacing: Spacing.md;

                                                chi := HudInput {
                                                    label: @tr("Identificativo");
                                                    placeholder: @tr("Come si chiama negli atti");
                                                }
                                                frase := HudInput {
                                                    label: @tr("Frase di accesso");
                                                    placeholder: @tr("Almeno dodici caratteri");
                                                }
                                                HudButton {
                                                    label: @tr("Entra");
                                                    clicked => {
                                                        root.review-sign-in(chi.value, frase.value);
                                                    }
                                                }

                                                Rectangle { horizontal-stretch: 1; background: transparent; }
                                            }
                                        }

                                        if root.review-person != "": Rectangle {
                                            // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                            min-height: rip-138.preferred-height;
                                            rip-138 := HorizontalLayout {
                                                spacing: Spacing.md;

                                                Text {
                                                    text: @tr("Dentro come {}", root.review-person);
                                                    color: Palette.text;
                                                    font-size: Typography.body;
                                                    vertical-alignment: center;
                                                }
                                                HudButton {
                                                    label: @tr("Esci");
                                                    clicked => {
                                                        root.review-sign-out();
                                                    }
                                                }

                                                Rectangle { horizontal-stretch: 1; background: transparent; }
                                            }
                                        }
                                    }
                                }

                                // I COMANDI A DISTANZA (HUB-REMOTE-01, ADR-0200):
                                // soltanto per chi è entrato, con un motivo.
                                if root.review-person != "": Rectangle {
                                    background: Palette.panel-raised;
                                    border-radius: Spacing.radius-panel;
                                    vertical-stretch: 0;

                                    // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                    min-height: rip-203.preferred-height;
                                    rip-203 := VerticalLayout {
                                        padding: Spacing.lg;
                                        spacing: Spacing.sm;

                                        Text {
                                            text: @tr("Comandi a distanza");
                                            color: Palette.text;
                                            font-size: Typography.panel-title;
                                            font-weight: Typography.medium;
                                        }
                                        Text {
                                            text: @tr("Mettere in pausa, riprendere o arrestare un monitoraggio dell'ufficio da qui. Il comando porta il proprio nome e un motivo, e resta nel registro dell'Hub e di questa postazione. L'Hub lo esegue soltanto se chi lo amministra lo ha deciso.");
                                            color: Palette.text-muted;
                                            font-size: Typography.body-secondary;
                                            wrap: word-wrap;
                                        }

                                        HudSelect {
                                            label: @tr("Monitoraggio dell'ufficio");
                                            model: root.review-monitorings;
                                            current-index <=> root.review-monitoring-index;
                                        }

                                        motivo-comando := HudInput {
                                            placeholder: @tr("Motivo, almeno venti caratteri");
                                            label: @tr("Motivo, almeno venti caratteri");
                                        }

                                        HorizontalLayout {
                                            spacing: Spacing.md;

                                            HudButton {
                                                label: @tr("Metti in pausa");
                                                clicked => {
                                                    root.review-remote-command(root.review-monitoring-index, "pausa", motivo-comando.value);
                                                }
                                            }
                                            HudButton {
                                                label: @tr("Riprendi");
                                                clicked => {
                                                    root.review-remote-command(root.review-monitoring-index, "ripresa", motivo-comando.value);
                                                }
                                            }
                                            HudButton {
                                                label: @tr("Arresta");
                                                clicked => {
                                                    root.review-remote-command(root.review-monitoring-index, "arresto", motivo-comando.value);
                                                }
                                            }

                                            Rectangle { horizontal-stretch: 1; background: transparent; }
                                        }

                                        Text {
                                            text: @tr("Arrestare un monitoraggio a distanza è riservato a chi amministra l'Hub.");
                                            color: Palette.text-muted;
                                            font-size: Typography.body-secondary;
                                            wrap: word-wrap;
                                        }
                                    }
                                }

                                // IL CONTENUTO APERTO, quando c'e'.
                                if root.review-has-open: Rectangle {
                                    background: Palette.panel-raised;
                                    border-radius: Spacing.radius-panel;
                                    vertical-stretch: 0;

                                    // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                    min-height: rip-139.preferred-height;
                                    rip-139 := VerticalLayout {
                                        padding: Spacing.lg;
                                        spacing: Spacing.sm;

                                        Text {
                                            text: root.review-open-source;
                                            color: Palette.text;
                                            font-size: Typography.panel-title;
                                            font-weight: Typography.medium;
                                            wrap: word-wrap;
                                        }
                                        Text {
                                            text: root.review-open-level + " · " + root.review-open-published;
                                            color: Palette.text-muted;
                                            font-size: Typography.caption;
                                        }
                                        Text {
                                            text: root.review-open-body;
                                            color: Palette.text;
                                            font-size: Typography.body;
                                            wrap: word-wrap;
                                        }

                                        // CIO' CHE L'UFFICIO HA SCRITTO SU QUESTO.
                                        Text {
                                            text: @tr("Note dell'ufficio");
                                            color: Palette.text;
                                            font-size: Typography.panel-title;
                                            font-weight: Typography.medium;
                                        }

                                        if root.review-notes-message != "": Text {
                                            text: root.review-notes-message;
                                            color: Palette.text-muted;
                                            font-size: Typography.body-secondary;
                                            wrap: word-wrap;
                                        }

                                        LegendaOrigini {
                                            operatore: @tr("nota, autore e date");
                                        }
                                        for nota in root.review-notes: Rectangle {
                                            // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                            min-height: rip-140.preferred-height;
                                            rip-140 := HorizontalLayout {
                                                spacing: Spacing.md;

                                                VerticalLayout {
                                                    spacing: Spacing.xs;
                                                    horizontal-stretch: 1;

                                                    Text {
                                                        text: nota.body;
                                                        color: nota.withdrawn != "" ? Palette.text-muted : Palette.text;
                                                        font-size: Typography.body-secondary;
                                                        wrap: word-wrap;
                                                    }
                                                    Text {
                                                        text: nota.author + " · " + nota.written + nota.withdrawn;
                                                        color: Palette.text-muted;
                                                        font-size: Typography.caption;
                                                        wrap: word-wrap;
                                                    }
                                                }
                                                if nota.mine && nota.withdrawn == "": HudButton {
                                                    label: @tr("Ritira");
                                                    clicked => {
                                                        root.review-withdraw-note(nota.id);
                                                    }
                                                }
                                            }
                                        }

                                        if root.review-person != "": Rectangle {
                                            // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                            min-height: rip-141.preferred-height;
                                            rip-141 := HorizontalLayout {
                                                spacing: Spacing.md;

                                                nota := HudInput {
                                                    label: @tr("Nota per l'ufficio");
                                                    placeholder: @tr("Che cosa hai capito guardando questo");
                                                }
                                                HudButton {
                                                    label: @tr("Annota");
                                                    clicked => {
                                                        root.review-write-note(nota.value);
                                                    }
                                                }
                                            }
                                        }

                                        Text {
                                            text: @tr("Motivo della decisione — obbligatorio quando si smentisce il motore:");
                                            color: Palette.text-muted;
                                            font-size: Typography.body-secondary;
                                            wrap: word-wrap;
                                        }
                                        motivo := HudInput {
                                            label: @tr("Motivo della decisione");
                                            placeholder: @tr("Perché questa decisione");
                                        }

                                        if root.review-person != "": Rectangle {
                                            // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                            min-height: rip-142.preferred-height;
                                            rip-142 := HorizontalLayout {
                                                spacing: Spacing.md;

                                                HudButton {
                                                    label: @tr("Prendi in carico");
                                                    clicked => {
                                                        root.review-take(root.review-open-id);
                                                    }
                                                }
                                                HudButton {
                                                    label: @tr("Lascia");
                                                    clicked => {
                                                        root.review-release(root.review-open-id);
                                                    }
                                                }

                                                Rectangle { horizontal-stretch: 1; background: transparent; }
                                            }
                                        }

                                        // ASSEGNARE A UN COLLEGA E' DI CHI AMMINISTRA: il
                                        // pulsante c'e' per tutti, e il rifiuto lo dice, perche'
                                        // nascondere un comando non spiega perche' non si puo'.
                                        LegendaOrigini {
                                            operatore: @tr("persona, ruolo e stato");
                                        }
                                        for collega in root.review-people: Rectangle {
                                            // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                            min-height: rip-143.preferred-height;
                                            rip-143 := HorizontalLayout {
                                                spacing: Spacing.md;

                                                Text {
                                                    text: collega.label + " (" + collega.person + ", " + collega.role + ")";
                                                    color: collega.active ? Palette.text : Palette.text-muted;
                                                    font-size: Typography.body-secondary;
                                                    vertical-alignment: center;
                                                    horizontal-stretch: 1;
                                                }
                                                if collega.active: HudButton {
                                                    label: @tr("Assegna");
                                                    clicked => {
                                                        root.review-assign(root.review-open-id, collega.person);
                                                    }
                                                }
                                            }
                                        }

                                        HorizontalLayout {
                                            spacing: Spacing.md;

                                            HudButton {
                                                label: @tr("Rilevante");
                                                clicked => {
                                                    root.review-decide("relevant", motivo.value);
                                                }
                                            }
                                            HudButton {
                                                label: @tr("Non rilevante");
                                                clicked => {
                                                    root.review-decide("not_relevant", motivo.value);
                                                }
                                            }
                                            HudButton {
                                                label: @tr("Duplicato");
                                                clicked => {
                                                    root.review-decide("duplicate", motivo.value);
                                                }
                                            }

                                            Rectangle { horizontal-stretch: 1; background: transparent; }
                                        }
                                    }
                                }

                                // L'ELENCO.
                                if !root.exercise-mode: Text {
                                    text: @tr("Da rivedere");
                                    color: Palette.text;
                                    font-size: Typography.panel-title;
                                    font-weight: Typography.medium;
                                }

                                if root.review-queue-summary != "": Text {
                                    text: root.review-queue-summary;
                                    color: Palette.text-muted;
                                    font-size: Typography.body-secondary;
                                    wrap: word-wrap;
                                }

                                // La frase mandava a «Aggiorna l'elenco», che in
                                // Esercitazione non e' collegato
                                // (FINAL-FPR-ALL-16, FPR-01).
                                if !root.exercise-mode && root.review-queue-rows.length == 0: Text {
                                    text: @tr("Nessun elemento in attesa di revisione, oppure l'elenco non è stato ancora chiesto all'Hub. Usare «Aggiorna l'elenco».");
                                    color: Palette.text-muted;
                                    font-size: Typography.body-secondary;
                                    wrap: word-wrap;
                                }

                                if !root.exercise-mode: LegendaOrigini {
                                    osservato: @tr("fonte");
                                    calcolato: @tr("livello, versione e perché è qui");
                                    operatore: @tr("stato e assegnazione");
                                }

                                // Prende l'avanzo di altezza (FPR-08).
                                Rectangle { vertical-stretch: 1; background: transparent; }
                                for riga in root.review-queue-rows: Rectangle {
                                    background: Palette.panel-raised;
                                    border-radius: Spacing.radius-panel;
                                    vertical-stretch: 0;

                                    // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                    min-height: rip-144.preferred-height;
                                    rip-144 := VerticalLayout {
                                        padding: Spacing.lg;
                                        spacing: Spacing.xs;

                                        HorizontalLayout {
                                            spacing: Spacing.sm;

                                            Text {
                                                text: riga.source;
                                                color: Palette.text;
                                                font-size: Typography.body;
                                                font-weight: Typography.medium;
                                                horizontal-stretch: 1;
                                                wrap: word-wrap;
                                            }
                                            Text {
                                                text: riga.level;
                                                color: Palette.text-muted;
                                                font-size: Typography.body-secondary;
                                            }
                                            Text {
                                                text: riga.state;
                                                color: Palette.text-muted;
                                                font-size: Typography.body-secondary;
                                            }
                                            HudButton {
                                                label: @tr("Apri");
                                                clicked => {
                                                    root.review-open(riga.content-id);
                                                }
                                            }
                                            // PERCHE' VEDO QUESTO (PR-02). Si chiede con
                                            // l'identificativo soltanto: la risposta la
                                            // compone il Rust dalla riga che l'Hub ha
                                            // consegnato, e non da cio' che la schermata
                                            // gli passa. Una riga che l'Hub non ha
                                            // mostrato non si spiega.
                                            PercheVedoQuesto {
                                                elemento: riga.source;
                                                chiesto => {
                                                    root.team-explain(riga.content-id);
                                                }
                                            }
                                        }
                                        if riga.assigned != "": Text {
                                            text: @tr("In carico a {}", riga.assigned);
                                            color: Palette.text;
                                            font-size: Typography.body-secondary;
                                            wrap: word-wrap;
                                        }
                                        if riga.why != "": Text {
                                            text: riga.why;
                                            color: Palette.text-muted;
                                            font-size: Typography.body-secondary;
                                            wrap: word-wrap;
                                        }
                                        Text {
                                            text: riga.raised;
                                            color: Palette.text-muted;
                                            font-size: Typography.caption;
                                        }
                                    }
                                }
                            }
                        }
                    }

                    if root.current-page == 24: Rectangle {

                        // Comparsa graduale della pagina: vedere la pagina 0 per il
                        // perche' la dissolvenza sia solo in entrata.
                        property <bool> entered: false;
                        opacity: 0.0;
                        init => {
                            self.entered = true;
                        }
                        animate opacity {
                            duration: Motion.transition-effective;
                            easing: cubic-bezier(0.16, 1, 0.3, 1);
                        }
        states [
            shown when self.entered: {
                opacity: 1.0;
            }
        ]
                        background: Palette.panel;
                        border-radius: Spacing.radius-panel;

                        HudScroll {
                            VerticalLayout {
                                padding: Spacing.xl;
                                spacing: Spacing.lg;
                                alignment: start;

                                HorizontalLayout {
                                    spacing: Spacing.md;
                                    vertical-stretch: 0;
                                    Text {
                                        text: @tr("Modelli di monitoraggio");
                                        color: Palette.text;
                                        font-size: Typography.screen-title;
                                        font-weight: Typography.medium;
                                        horizontal-stretch: 1;
                                        vertical-alignment: center;
                                    }
                                    // IL MODELLO SI CREA DA QUI (F-07).
                                    if !root.template-form-open: HudButton {
                                        label: @tr("Nuovo modello");
                                        weight: Weight.primary;
                                        clicked => {
                                            root.template-form-new();
                                        }
                                    }
                                }

                                Text {
                                    text: @tr("Un modello è una configurazione già pronta. Dice quali fonti guardare e con quali dizionari. Dice anche la soglia delle notifiche e per quanto tempo conservare i dati.");
                                    color: Palette.text-muted;
                                    font-size: Typography.body-secondary;
                                    wrap: word-wrap;
                                }

                                // IL FATTO CHE QUESTA SCHERMATA DEVE DIRE.
                                Text {
                                    text: @tr("Applicare un modello prepara le fonti e i dizionari, che appartengono al monitoraggio. Non cambia la soglia di notifica né la conservazione: quelle sono impostazioni della postazione, valgono anche per i monitoraggi già conclusi, e la conservazione cancella. Se il modello ne prevede di diverse, il programma lo dice e lascia decidere.");
                                    color: Palette.text-muted;
                                    font-size: Typography.technical;
                                    wrap: word-wrap;
                                }

                                Text {
                                    text: @tr("Il modello non fissa la versione dei dizionari. Quando lo si applica, prende l'ultima versione pubblicata. È voluto: un modello che la fissasse userebbe per sempre i dizionari com'erano il giorno in cui è nato. Smetterebbe di raccogliere le correzioni.");
                                    color: Palette.text-muted;
                                    font-size: Typography.technical;
                                    wrap: word-wrap;
                                }

                                if root.template-message != "": Text {
                                    text: root.template-message;
                                    color: Palette.amber;
                                    font-size: Typography.body-secondary;
                                    wrap: word-wrap;
                                }

                                // ------------------------------- il modulo (F-07)
                                if root.template-form-open: Rectangle {
                                    vertical-stretch: 0;
                                    height: modulo-modello.preferred-height;
                                    background: Palette.accent-surface;
                                    border-radius: Spacing.radius-row;
                                    border-width: Spacing.hairline;
                                    border-color: Palette.frame;

                                    modulo-modello := VerticalLayout {
                                        padding: Spacing.lg;
                                        spacing: Spacing.sm;

                                        Text {
                                            text: @tr("NUOVO MODELLO");
                                            color: Palette.text-muted;
                                            font-size: Typography.group-label;
                                            letter-spacing: Typography.track-eyebrow;
                                        }
                                        TextField {
                                            label: @tr("Nome del modello");
                                            placeholder: @tr("per esempio: Controllo del turno di giorno");
                                            value <=> root.template-form-name;
                                        }
                                        TextField {
                                            label: @tr("A che cosa serve (facoltativo)");
                                            placeholder: @tr("una riga per chi lo userà");
                                            value <=> root.template-form-description;
                                        }

                                        LegendaOrigini {
                                            operatore: @tr("fonti e dizionari, come configurati qui");
                                        }
                                        Text {
                                            text: @tr("Le fonti da guardare (almeno una)");
                                            color: Palette.text;
                                            font-size: Typography.body-secondary;
                                            font-weight: Typography.medium;
                                        }
                                        if root.template-form-sources.length == 0: Text {
                                            text: @tr("Nessuna fonte attiva su questa postazione: un modello senza fonti non preparerebbe nulla. Le fonti si aggiungono da PREPARARE › Fonti.");
                                            color: Palette.amber;
                                            font-size: Typography.body-secondary;
                                            wrap: word-wrap;
                                        }
                                        for fonte in root.template-form-sources: HudCheck {
                                            text: fonte.label;
                                            description: fonte.detail;
                                            checked: fonte.chosen;
                                            toggled => {
                                                root.template-form-toggle-source(fonte.id);
                                            }
                                        }

                                        Text {
                                            text: @tr("I dizionari (si può anche non sceglierne)");
                                            color: Palette.text;
                                            font-size: Typography.body-secondary;
                                            font-weight: Typography.medium;
                                        }
                                        for dizionario in root.template-form-dictionaries: HudCheck {
                                            text: dizionario.label;
                                            description: dizionario.detail;
                                            checked: dizionario.chosen;
                                            toggled => {
                                                root.template-form-toggle-dictionary(dizionario.id);
                                            }
                                        }

                                        HorizontalLayout {
                                            spacing: Spacing.md;
                                            VerticalLayout {
                                                spacing: Spacing.xs;
                                                Text {
                                                    text: @tr("Soglia delle notifiche prevista");
                                                    color: Palette.text-muted;
                                                    font-size: Typography.group-label;
                                                }
                                                HudSelect {
                                                    label: @tr("Soglia delle notifiche prevista dal modello");
                                                    model: [@tr("Il modello non si esprime"), @tr("Livello 1 — debole"), @tr("Livello 2 — da tenere d'occhio"), @tr("Livello 3 — forte"), @tr("Livello 4 — prioritario")];
                                                    current-index <=> root.template-form-threshold-index;
                                                }
                                            }
                                            VerticalLayout {
                                                spacing: Spacing.xs;
                                                Text {
                                                    text: @tr("Conservazione prevista");
                                                    color: Palette.text-muted;
                                                    font-size: Typography.group-label;
                                                }
                                                HudSelect {
                                                    label: @tr("Conservazione prevista dal modello");
                                                    model: [@tr("Il modello non si esprime"), @tr("Conserva tutto"), @tr("30 giorni"), @tr("90 giorni"), @tr("180 giorni"), @tr("365 giorni")];
                                                    current-index <=> root.template-form-retention-index;
                                                }
                                            }
                                        }
                                        Text {
                                            text: @tr("Soglia e conservazione sono ciò che il modello prevede: applicarlo non le cambia, perché valgono per tutta la postazione. Il programma dirà se differiscono da quelle in vigore.");
                                            color: Palette.text-muted;
                                            font-size: Typography.technical;
                                            wrap: word-wrap;
                                        }

                                        if root.template-form-message != "": Text {
                                            text: root.template-form-message;
                                            color: Palette.coral;
                                            font-size: Typography.body-secondary;
                                            wrap: word-wrap;
                                        }

                                        HorizontalLayout {
                                            spacing: Spacing.sm;
                                            HudButton {
                                                label: @tr("Salva il modello");
                                                weight: Weight.primary;
                                                clicked => {
                                                    root.template-form-save();
                                                }
                                            }
                                            HudButton {
                                                label: @tr("Annulla");
                                                clicked => {
                                                    root.template-form-cancel();
                                                }
                                            }
                                            Rectangle { horizontal-stretch: 1; background: transparent; }
                                        }
                                    }
                                }

                                // ------------------------------- la preparazione
                                if root.template-preparation-open: Text {
                                    text: @tr("CHE COSA PREPARA «{}»", root.template-preparation-name);
                                    color: Palette.text-muted;
                                    font-size: Typography.group-label;
                                    letter-spacing: Typography.track-eyebrow;
                                }

                                if root.template-preparation-open: Text {
                                    text: @tr("LE FONTI");
                                    color: Palette.text-muted;
                                    font-size: Typography.technical;
                                    letter-spacing: Typography.track-eyebrow;
                                }

                                // OGNI FONTE COMPARE, COMPRESA QUELLA CHE NON
                                // C'E' PIU': nasconderla direbbe che il modello
                                // non l'aveva mai nominata, e chi lo usa
                                // crederebbe di guardare cio' che guardava.
                                // Senza un `if` davanti, che Slint non ammette
                                // prima di un `for`: l'elenco viene svuotato
                                // alla chiusura, quindi qui non resta nulla.
                                LegendaOrigini {
                                    osservato: @tr("fonte");
                                }
                                for fonte in root.template-preparation-sources: Text {
                                    text: fonte.sentence;
                                    color: fonte.present ? Palette.text : Palette.amber;
                                    font-size: Typography.body-secondary;
                                    wrap: word-wrap;
                                }

                                // I DIZIONARI, con la versione che oggi si
                                // userebbe (F-07). Anche quello che non si può
                                // preparare resta nell'elenco, e lo dice.
                                if root.template-preparation-open: Text {
                                    text: @tr("I DIZIONARI");
                                    color: Palette.text-muted;
                                    font-size: Typography.technical;
                                    letter-spacing: Typography.track-eyebrow;
                                }
                                if root.template-preparation-open
                                    && root.template-preparation-dictionaries.length == 0: Text {
                                    text: @tr("Il modello non prevede dizionari: si scelgono al secondo passo del monitoraggio.");
                                    color: Palette.text-muted;
                                    font-size: Typography.body-secondary;
                                    wrap: word-wrap;
                                }
                                for dizionario in root.template-preparation-dictionaries: Text {
                                    text: dizionario.sentence;
                                    color: dizionario.present ? Palette.text : Palette.amber;
                                    font-size: Typography.body-secondary;
                                    wrap: word-wrap;
                                }

                                if root.template-preparation-open: Text {
                                    text: @tr("LE IMPOSTAZIONI DELLA POSTAZIONE");
                                    color: Palette.text-muted;
                                    font-size: Typography.technical;
                                    letter-spacing: Typography.track-eyebrow;
                                }

                                // LE DUE FRASI LE COMPONE IL DOMINIO (DEC-252),
                                // e dicono i valori, mai «attenzione».
                                if root.template-preparation-open
                                    && root.template-notification-sentence != "": Text {
                                    text: root.template-notification-sentence;
                                    color: Palette.text-muted;
                                    font-size: Typography.body-secondary;
                                    wrap: word-wrap;
                                }

                                if root.template-preparation-open
                                    && root.template-retention-sentence != "": Text {
                                    text: root.template-retention-sentence;
                                    // In ambra quando adottare cio' che il
                                    // modello prevede CANCELLEREBBE: e' l'unica
                                    // differenza che distrugge qualcosa, e la
                                    // frase lo dice comunque.
                                    color: root.template-would-delete
                                        ? Palette.amber
                                        : Palette.text-muted;
                                    font-size: Typography.body-secondary;
                                    wrap: word-wrap;
                                }

                                if root.template-preparation-open: Rectangle {
                                    // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                    min-height: rip-145.preferred-height;
                                    rip-145 := HorizontalLayout {
                                        spacing: Spacing.sm;
                                        vertical-stretch: 0;

                                        // PREPARA, NON AVVIA (ADR-0142): compila la
                                        // procedura guidata con le scelte del modello e
                                        // la apre al primo passo. Il monitoraggio parte
                                        // solo da «Avvia monitoraggio», all'ultimo.
                                        HudButton {
                                            label: @tr("Prepara un nuovo monitoraggio con queste scelte");
                                            weight: Weight.primary;
                                            reason: @tr("Apre la procedura guidata già compilata: ogni scelta si rivede e si cambia, e nulla parte da qui.");
                                            clicked => {
                                                root.template-prepare-monitoring(root.template-preparation-id);
                                            }
                                        }
                                        HudButton {
                                            label: @tr("Chiudi");
                                            clicked => {
                                                root.close-template-preparation();
                                            }
                                        }
                                        Rectangle { horizontal-stretch: 1; background: transparent; }
                                    }
                                }

                                // ------------------------------- l'elenco
                                Text {
                                    text: @tr("I MODELLI");
                                    color: Palette.text-muted;
                                    font-size: Typography.group-label;
                                    letter-spacing: Typography.track-eyebrow;
                                }

                                if root.template-rows.length == 0: Text {
                                    text: @tr("Nessun modello è stato creato su questa postazione. «Nuovo modello», qui in alto, ne crea uno: si scelgono le fonti e i dizionari, e lo si ritrova qui.");
                                    color: Palette.text-muted;
                                    font-size: Typography.body-secondary;
                                    wrap: word-wrap;
                                }

                                LegendaOrigini {
                                    operatore: @tr("nome e descrizione");
                                }
                                for modello in root.template-rows: Rectangle {
                                    vertical-stretch: 0;
                                    background: transparent;

                                    // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                    min-height: rip-146.preferred-height;
                                    rip-146 := VerticalLayout {
                                        padding-left: Spacing.md;
                                        padding-top: Spacing.xs;
                                        padding-bottom: Spacing.xs;
                                        spacing: 2px;

                                        Text {
                                            text: modello.name;
                                            color: Palette.text;
                                            font-size: Typography.body;
                                            wrap: word-wrap;
                                        }
                                        if modello.description != "": Text {
                                            text: modello.description;
                                            color: Palette.text-muted;
                                            font-size: Typography.body-secondary;
                                            wrap: word-wrap;
                                        }
                                        // LA FRASE LA COMPONE IL MODELLO: dice
                                        // chi lo ha creato, quando, e quanto
                                        // prevede.
                                        Text {
                                            text: modello.sentence;
                                            color: Palette.text-muted;
                                            font-family: Typography.mono;
                                            font-size: Typography.technical;
                                            wrap: word-wrap;
                                        }

                                        HorizontalLayout {
                                            spacing: Spacing.sm;
                                            vertical-stretch: 0;

                                            // «APPLICA» NON APPLICA NIENTE ALLE
                                            // IMPOSTAZIONI: mostra che cosa il
                                            // modello prepara e che cosa
                                            // differisce. L'etichetta lo dice.
                                            HudButton {
                                                label: @tr("Mostra che cosa prepara");
                                                clicked => {
                                                    root.apply-template(modello.id);
                                                }
                                            }
                                            // MODIFICARE NO, RIPARTIRE SI' (ADR-0142):
                                            // un modello e' uno strumento, e
                                            // modificarlo farebbe mentire chi lo ha
                                            // creato e quando. Questo apre il modulo
                                            // con le sue scelte, e ne nasce un altro.
                                            HudButton {
                                                label: @tr("Usa come base per un nuovo modello");
                                                clicked => {
                                                    root.template-form-from(modello.id);
                                                }
                                            }
                                            // CANCELLARE CHIEDE CONFERMA.
                                            HudButton {
                                                label: @tr("Cancella…");
                                                weight: Weight.danger;
                                                enabled: root.template-delete-armed != modello.id;
                                                clicked => {
                                                    root.template-delete-armed = modello.id;
                                                }
                                            }
                                            Rectangle { horizontal-stretch: 1; background: transparent; }
                                        }
                                        if root.template-delete-armed == modello.id: Rectangle {
                                            // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                            min-height: rip-147.preferred-height;
                                            rip-147 := HorizontalLayout {
                                                spacing: Spacing.sm;
                                                vertical-stretch: 0;
                                                Text {
                                                    text: @tr("Cancellare «{}»? Il modello si cancella; i monitoraggi che ha preparato restano come sono.", modello.name);
                                                    color: Palette.text;
                                                    font-size: Typography.body-secondary;
                                                    wrap: word-wrap;
                                                    horizontal-stretch: 1;
                                                    vertical-alignment: center;
                                                }
                                                HudButton {
                                                    label: @tr("Annulla");
                                                    clicked => {
                                                        root.template-delete-armed = 0;
                                                    }
                                                }
                                                HudButton {
                                                    label: @tr("Sì, cancella");
                                                    weight: Weight.danger;
                                                    clicked => {
                                                        root.template-delete-armed = 0;
                                                        root.delete-template(modello.id);
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    // cambia, e su quanti contenuti: il denominatore c'e'
                    // sempre, perche' «tre contenuti salgono» significa una
                    // cosa su dieci e un'altra su diecimila.
                    if root.current-page == 19: Rectangle {
                        // Comparsa graduale della pagina: vedere la pagina 0 per il
                        // perche' la dissolvenza sia solo in entrata.
                        property <bool> entered: false;
                        opacity: 0.0;
                        init => {
                            self.entered = true;
                        }
                        animate opacity {
                            duration: Motion.transition-effective;
                            easing: cubic-bezier(0.16, 1, 0.3, 1);
                        }
        states [
            shown when self.entered: {
                opacity: 1.0;
            }
        ]
                        background: Palette.panel;
                        border-radius: Spacing.radius-panel;

                        HudScroll {
                            VerticalLayout {
                                padding: Spacing.xl;
                                spacing: Spacing.lg;
                                alignment: start;

                                Text {
                                    text: @tr("Laboratorio regole");
                                    color: Palette.text;
                                    font-size: Typography.screen-title;
                                    font-weight: Typography.medium;
                                }

                                AvvertenzaDiSicurezza {
                                    codice: "SIC-11";
                                    testo: @tr("Qui si vede che cosa cambierebbe pubblicando la bozza di un dizionario. Il calcolo usa i contenuti già archiviati. Il confronto non scrive nulla e non pubblica nulla. La decisione resta di una persona.");
                                    dettaglio: @tr("L'analisi viene rieseguita, con la bozza, sui contenuti archiviati. Il risultato non viene salvato e la bozza non viene pubblicata.");
                                }

                                // SENZA UNA BOZZA NON C'E' NULLA DA CONFRONTARE,
                                // e la schermata dice come aprirne una invece
                                // di mostrare un comando spento (F-07).
                                if !root.lab-has-candidates: Rectangle {
                                    vertical-stretch: 0;
                                    background: Palette.panel-raised;
                                    border-radius: Spacing.radius-row;

                                    // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                    min-height: rip-148.preferred-height;
                                    rip-148 := VerticalLayout {
                                        padding: Spacing.lg;
                                        spacing: Spacing.sm;

                                        Text {
                                            text: @tr("Nessuna bozza da confrontare");
                                            color: Palette.text;
                                            font-size: Typography.section-title;
                                            font-weight: Typography.medium;
                                        }
                                        Text {
                                            text: root.lab-preview;
                                            color: Palette.text-muted;
                                            font-size: Typography.body-secondary;
                                            wrap: word-wrap;
                                        }
                                        HorizontalLayout {
                                            spacing: Spacing.sm;
                                            HudButton {
                                                label: @tr("Vai ai Dizionari");
                                                weight: Weight.primary;
                                                clicked => {
                                                    root.open-page(4);
                                                }
                                            }
                                            Rectangle { horizontal-stretch: 1; background: transparent; }
                                        }
                                    }
                                }

                                if root.lab-has-candidates: Rectangle {
                                    // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                    min-height: rip-149.preferred-height;
                                    rip-149 := HorizontalLayout {
                                        spacing: Spacing.md;
                                        vertical-stretch: 0;

                                        HudSelect {
                                            label: @tr("Bozza da confrontare");
                                            model: root.lab-dictionaries;
                                            current-index <=> root.lab-dictionary-index;
                                            selected(index) => {
                                                root.lab-dictionary-chosen(index);
                                            }
                                        }

                                        HudButton {
                                            label: @tr("Torna alla bozza");
                                            enabled: root.lab-draft-dictionary > 0;
                                            reason: @tr("Riapre la bozza in Dizionari, dove si modifica e si pubblica.");
                                            clicked => {
                                                root.selected-dictionary = root.lab-draft-dictionary;
                                                root.open-page(4);
                                                root.preview-dictionary(root.lab-draft-dictionary);
                                            }
                                        }
                                    }
                                }

                                // ------------- che cosa la bozza cambia nel dizionario
                                if root.lab-has-candidates: LegendaOrigini {
                                    calcolato: @tr("che cosa cambia nei termini");
                                }
                                if root.lab-has-candidates: Text {
                                    text: @tr("CHE COSA CAMBIA NEL DIZIONARIO");
                                    color: Palette.text-muted;
                                    font-family: Typography.mono;
                                    font-size: Typography.label;
                                }
                                if root.lab-has-candidates: Text {
                                    text: root.lab-term-summary;
                                    color: Palette.text;
                                    font-size: Typography.body-secondary;
                                    wrap: word-wrap;
                                }
                                for termine in root.lab-term-rows: Rectangle {
                                    // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                    min-height: rip-150.preferred-height;
                                    rip-150 := HorizontalLayout {
                                        spacing: Spacing.sm;
                                        vertical-stretch: 0;
                                        Text {
                                            text: termine.sign;
                                            width: 20px;
                                            color: termine.removed ? Palette.amber : Palette.cyan;
                                            font-family: Typography.mono;
                                            font-size: Typography.body-secondary;
                                            font-weight: Typography.medium;
                                            horizontal-alignment: center;
                                            accessible-role: none;
                                        }
                                        Text {
                                            text: termine.sentence;
                                            color: termine.removed ? Palette.amber : Palette.text;
                                            font-size: Typography.body-secondary;
                                            wrap: word-wrap;
                                            horizontal-stretch: 1;
                                        }
                                    }
                                }

                                // ------------- l'effetto sui contenuti archiviati
                                if root.lab-has-candidates: Text {
                                    text: @tr("CHE EFFETTO AVREBBE SUI CONTENUTI GIÀ ARCHIVIATI");
                                    color: Palette.text-muted;
                                    font-family: Typography.mono;
                                    font-size: Typography.label;
                                }

                                if root.lab-has-candidates: Rectangle {
                                    // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                    min-height: rip-151.preferred-height;
                                    rip-151 := HorizontalLayout {
                                        spacing: Spacing.md;
                                        vertical-stretch: 0;

                                        HudSelect {
                                            label: @tr("Contenuti del monitoraggio");
                                            model: root.lab-sessions;
                                            current-index <=> root.lab-session-index;
                                            selected(index) => {
                                                root.lab-session-chosen(index);
                                            }
                                        }
                                        Rectangle { horizontal-stretch: 1; background: transparent; }
                                    }
                                }

                                // IL RISCONTRO SUI DIZIONARI (FEEDBACK-01).
                                //
                                // Che cosa le persone hanno deciso dei
                                // contenuti che queste regole avevano trovato.
                                // Non compare se nessuno lo chiede: costa una
                                // lettura di tutta la sessione, e
                                // un'aggregazione che si aprisse da sola
                                // verrebbe letta come un giudizio sui
                                // dizionari, che non e'.
                                if !root.feedback-open: Rectangle {
                                    // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                    min-height: rip-152.preferred-height;
                                    rip-152 := HorizontalLayout {
                                        spacing: Spacing.sm;
                                        vertical-stretch: 0;

                                        HudButton {
                                            label: @tr("Che cosa dice la revisione di queste regole?");
                                            clicked => {
                                                root.open-feedback();
                                            }
                                        }
                                        Rectangle { horizontal-stretch: 1; background: transparent; }
                                    }
                                }

                                if root.feedback-open: Rectangle {
                                    // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                    min-height: rip-153.preferred-height;
                                    rip-153 := VerticalLayout {
                                        spacing: Spacing.sm;
                                        vertical-stretch: 0;

                                        HorizontalLayout {
                                            spacing: Spacing.sm;
                                            vertical-stretch: 0;

                                            Text {
                                                text: @tr("IL RISCONTRO SUI DIZIONARI");
                                                color: Palette.text-muted;
                                                font-family: Typography.mono;
                                                font-size: Typography.label;
                                                horizontal-stretch: 1;
                                            }
                                            HudButton {
                                                label: @tr("Chiudi");
                                                clicked => {
                                                    root.close-feedback();
                                                }
                                            }
                                        }

                                        // La frase dell'esito, composta dal
                                        // servizio: la schermata la RICEVE e non la
                                        // ricompone (DEC-252, quinta superficie).
                                        // Dichiara anche quando non dice nulla.
                                        Text {
                                            text: root.feedback-summary;
                                            color: Palette.text;
                                            font-size: Typography.body-secondary;
                                            wrap: word-wrap;
                                        }

                                        LegendaOrigini {
                                            calcolato: @tr("conteggi e suggerimento");
                                            operatore: @tr("regola");
                                        }
                                        for regola in root.feedback-rules: Rectangle {
                                            vertical-stretch: 0;
                                            background: Palette.panel-inset;
                                            border-radius: Spacing.radius-row;

                                            // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                            min-height: rip-154.preferred-height;
                                            rip-154 := VerticalLayout {
                                                padding: Spacing.md;
                                                spacing: Spacing.xs;

                                                Text {
                                                    text: regola.rule;
                                                    color: Palette.text;
                                                    font-size: Typography.body-secondary;
                                                    font-weight: 600;
                                                    wrap: word-wrap;
                                                }
                                                Text {
                                                    text: regola.counts;
                                                    color: Palette.text-muted;
                                                    font-size: Typography.body-secondary;
                                                    wrap: word-wrap;
                                                }
                                                // L'INVITO, quando c'e'. In ambra
                                                // perche' chiede di guardare, non
                                                // perche' allarmi: la frase stessa
                                                // dice che NEXUM non modifica alcun
                                                // dizionario.
                                                if regola.suggested: Text {
                                                    text: regola.suggestion;
                                                    color: Palette.amber;
                                                    font-size: Typography.body-secondary;
                                                    wrap: word-wrap;
                                                }
                                            }
                                        }
                                    }
                                }

                                // CHE COSA SI STA PER CONFRONTARE, detto prima
                                // di premere: quale versione pubblicata, quale
                                // bozza, su quanti contenuti — e quanto puo'
                                // impiegare. Chi lo scopre dopo lo scopre
                                // aspettando.
                                if root.lab-has-candidates: Text {
                                    text: root.lab-preview;
                                    color: Palette.text-muted;
                                    font-size: Typography.body-secondary;
                                    wrap: word-wrap;
                                }

                                if root.lab-has-candidates: Rectangle {
                                    // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                    min-height: rip-155.preferred-height;
                                    rip-155 := HorizontalLayout {
                                        spacing: Spacing.sm;
                                        vertical-stretch: 0;

                                        HudButton {
                                            label: @tr("Confronta sui contenuti");
                                            enabled: root.lab-can-run;
                                            clicked => {
                                                root.run-lab();
                                            }
                                        }
                                        Rectangle { horizontal-stretch: 1; background: transparent; }
                                    }
                                }

                                if root.lab-summary != "": Text {
                                    text: root.lab-summary;
                                    color: Palette.text;
                                    font-size: Typography.body-secondary;
                                    wrap: word-wrap;
                                }

                                LegendaOrigini {
                                    osservato: @tr("contenuto");
                                    calcolato: @tr("confronto dei livelli");
                                }
                                for riga in root.lab-findings: Rectangle {
                                    vertical-stretch: 0;
                                    background: Palette.panel-inset;
                                    border-radius: Spacing.radius-row;

                                    // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                    min-height: rip-156.preferred-height;
                                    rip-156 := VerticalLayout {
                                        padding: Spacing.md;
                                        spacing: Spacing.xs;

                                        HorizontalLayout {
                                            spacing: Spacing.sm;
                                            vertical-stretch: 0;

                                            Text {
                                                text: riga.content;
                                                color: Palette.text;
                                                font-size: Typography.body-secondary;
                                                font-weight: 600;
                                                horizontal-stretch: 1;
                                            }
                                            // Salito e sceso hanno colori
                                            // diversi perche' sono due fatti
                                            // diversi, e nessuno dei due e' un
                                            // allarme: e' un confronto, non una
                                            // valutazione.
                                            Text {
                                                text: riga.raised ? @tr("sale") : riga.lowered ? @tr("scende") : @tr("termini");
                                                color: riga.raised
                                                    ? Palette.cyan
                                                    : Palette.text-muted;
                                                font-family: Typography.mono;
                                                font-size: Typography.group-label;
                                                horizontal-stretch: 0;
                                            }
                                        }

                                        // IN AMBRA quando la versione
                                        // pubblicata non riproduce il livello
                                        // registrato: quella differenza NON e'
                                        // attribuibile al candidato, e leggerla
                                        // come tale farebbe bocciare o
                                        // approvare una modifica per la ragione
                                        // sbagliata.
                                        Text {
                                            text: riga.reason;
                                            color: riga.not-reproducing
                                                ? Palette.amber
                                                : Palette.text-muted;
                                            font-size: Typography.body-secondary;
                                            wrap: word-wrap;
                                        }
                                    }
                                }

                                Text {
                                    text: @tr("Il confronto non modifica alcun dizionario e non registra alcun risultato: si esegue su contenuti già archiviati e produce solo ciò che si legge qui. Per pubblicare la bozza si va in Dizionari.");
                                    color: Palette.text-muted;
                                    font-size: Typography.group-label;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }

                    // --------------------------------------------- Coda di lavoro
                    //
                    // # Che cosa questa schermata NON ha, e non per dimenticanza
                    //
                    // **Nessun «Prendi in carico».** Non esiste ancora
                    // un'identita' di operatore autenticata, e assegnare a un
                    // segnaposto direbbe che qualcuno ha preso in carico
                    // qualcosa quando nessuno lo ha fatto. Due operatori sulla
                    // stessa macchina lo crederebbero, e il lavoro che ciascuno
                    // pensa dell'altro non lo farebbe nessuno. Arrivera' con
                    // TEAM-ASSIGN-01, dopo l'identita'.
                    //
                    // **Nessun numero di priorita'.** L'ordine e' un confronto
                    // fra fatti, e ogni riga elenca i fatti che l'hanno messa
                    // dov'e'.
                    if root.current-page == 18: Rectangle {
                        // Comparsa graduale della pagina: vedere la pagina 0 per il
                        // perche' la dissolvenza sia solo in entrata.
                        property <bool> entered: false;
                        opacity: 0.0;
                        init => {
                            self.entered = true;
                        }
                        animate opacity {
                            duration: Motion.transition-effective;
                            easing: cubic-bezier(0.16, 1, 0.3, 1);
                        }
        states [
            shown when self.entered: {
                opacity: 1.0;
            }
        ]
                        background: Palette.panel;
                        border-radius: Spacing.radius-panel;

                        HudScroll {
                            VerticalLayout {
                                padding: Spacing.xl;
                                spacing: Spacing.lg;
                                alignment: start;

                                Text {
                                    text: @tr("Coda di lavoro");
                                    color: Palette.text;
                                    font-size: Typography.screen-title;
                                    font-weight: Typography.medium;
                                }

                                Text {
                                    // Detto che cosa conta, e perche' il numero puo' differire
                                    // (SIM3-08). La frase di prima - «Gli avvisi sono di una
                                    // sessione sola» - era falsa: la pagina Avvisi mostra anche
                                    // tutte le sessioni.
                                    text: @tr("Che cosa aspetta una persona, da tutti i monitoraggi, anche quelli già conclusi: gli avvisi ancora da decidere e i periodi non coperti da valutare. Lo Storico conta di più perché include anche i contenuti di livello 0.");
                                    color: Palette.text-muted;
                                    font-size: Typography.body-secondary;
                                    wrap: word-wrap;
                                }

                                HorizontalLayout {
                                    spacing: Spacing.sm;
                                    vertical-stretch: 0;

                                    VerticalLayout {
                                        spacing: Spacing.xs;
                                        horizontal-stretch: 1;

                                        Text {
                                            text: root.work-queue-summary;
                                            color: Palette.text;
                                            font-size: Typography.body-secondary;
                                            wrap: word-wrap;
                                        }
                                        Text {
                                            text: root.work-queue-composed-at;
                                            color: Palette.text-muted;
                                            font-size: Typography.group-label;
                                            wrap: word-wrap;
                                        }
                                    }

                                    HudButton {
                                        label: @tr("Aggiorna");
                                        clicked => {
                                            root.refresh-work-queue();
                                        }
                                    }
                                }

                                LegendaOrigini {
                                    osservato: @tr("fonte e testo");
                                    calcolato: @tr("livello e motivo");
                                    operatore: @tr("monitoraggio e stato");
                                }
                                for riga in root.work-queue: Rectangle {
                                    vertical-stretch: 0;
                                    background: Palette.panel-inset;
                                    border-radius: Spacing.radius-row;

                                    // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                    min-height: rip-157.preferred-height;
                                    rip-157 := VerticalLayout {
                                        padding: Spacing.md;
                                        spacing: Spacing.xs;

                                        HorizontalLayout {
                                            spacing: Spacing.sm;
                                            vertical-stretch: 0;

                                            Text {
                                                text: riga.source;
                                                color: Palette.text;
                                                font-size: Typography.body-secondary;
                                                font-weight: 600;
                                                horizontal-stretch: 1;
                                            }
                                            // Il livello e' SCRITTO oltre che
                                            // colorato, ed e' il livello del
                                            // motore: non una priorita'.
                                            Text {
                                                text: riga.level-label;
                                                color: riga.level >= 4
                                                    ? Palette.coral
                                                    : riga.level >= 3
                                                        ? Palette.amber
                                                        : Palette.text-muted;
                                                font-family: Typography.mono;
                                                font-size: Typography.body-secondary;
                                                horizontal-stretch: 0;
                                            }
                                        }

                                        Text {
                                            text: riga.session;
                                            color: Palette.text-muted;
                                            font-size: Typography.group-label;
                                            wrap: word-wrap;
                                        }

                                        // CHE COSA DICE, E DOVE SI DECIDE (OS-10).
                                        if riga.excerpt != "": Text {
                                            text: riga.excerpt;
                                            color: Palette.text;
                                            font-size: Typography.body-secondary;
                                            wrap: word-wrap;
                                        }

                                        Text {
                                            text: riga.reason;
                                            color: Palette.text-muted;
                                            font-size: Typography.body-secondary;
                                            wrap: word-wrap;
                                        }

                                        // PERCHE' STA DOV'E'. Sono gli stessi
                                        // fatti su cui l'ordine lavora, nella
                                        // stessa precedenza: chi legge puo'
                                        // verificarli uno per uno.
                                        Text {
                                            text: riga.why-here;
                                            color: riga.untouched
                                                ? Palette.text
                                                : Palette.text-muted;
                                            font-size: Typography.group-label;
                                            wrap: word-wrap;
                                        }
                                        // PERCHE' VEDO QUESTO (PR-02): la posizione in
                                        // coda e' un calcolo, e la risposta dice con
                                        // quale regola e che cosa non significa.
                                        HorizontalLayout {
                                            spacing: Spacing.sm;
                                            vertical-stretch: 0;

                                            HudButton {
                                                label: @tr("Apri il messaggio");
                                                clicked => {
                                                    root.work-queue-open(riga.content-id);
                                                }
                                            }
                                            // LA CONVERSAZIONE, CON UN GESTO (ADR-0151):
                                            // lo stesso bersaglio degli Avvisi.
                                            HudButton {
                                                label: @tr("Conversazione");
                                                clicked => {
                                                    root.conversation-open-requested(riga.content-id, "Coda di lavoro");
                                                }
                                            }
                                            PercheVedoQuesto {
                                                elemento: riga.source + ", " + riga.level-label;
                                                chiesto => {
                                                    root.explain-this(Spiegabile.voce-della-coda, "", riga.level-label + ", " + riga.state + ". " + riga.why-here);
                                                }
                                            }
                                            Rectangle { horizontal-stretch: 1; background: transparent; }
                                        }
                                    }
                                }

                                if root.work-queue.length == 0: Text {
                                    text: @tr("Nessun contenuto in attesa di revisione.");
                                    color: Palette.text-muted;
                                    font-size: Typography.body-secondary;
                                }

                                // PERIODI NON COPERTI PRIORITARI (PR-06, ADR-0122). Voci
                                // proprie, sotto i contenuti: non sono contenuti, e una
                                // priorita' tecnica non si mescola a un livello.
                                Text {
                                    text: @tr("PERIODI NON COPERTI PRIORITARI");
                                    color: Palette.text-muted;
                                    font-family: Typography.mono;
                                    font-size: Typography.eyebrow;
                                    letter-spacing: Typography.track-eyebrow;
                                }
                                Text {
                                    text: @tr("La priorità è tecnica: dice dove guardare per primo quando si valuta un recupero. Non dice che nel periodo la fonte abbia pubblicato qualcosa.");
                                    color: Palette.amber;
                                    font-size: Typography.group-label;
                                    wrap: word-wrap;
                                }
                                if root.gap-summary != "": Text {
                                    text: root.gap-summary;
                                    color: Palette.text-muted;
                                    font-size: Typography.group-label;
                                    wrap: word-wrap;
                                }
                                if root.gap-rows.length > 0: HudInput {
                                    label: @tr("Motivo della decisione");
                                    placeholder: @tr("Perché si valuta un recupero, o perché il periodo resta non coperto");
                                    value <=> root.gap-reason;
                                }
                                if root.gap-message != "": Text {
                                    text: root.gap-message;
                                    color: Palette.text;
                                    font-size: Typography.group-label;
                                    wrap: word-wrap;
                                }
                                LegendaOrigini {
                                    osservato: @tr("fonte");
                                    calcolato: @tr("periodo, priorità e criterio");
                                }
                                for periodo in root.gap-rows: Rectangle {
                                    vertical-stretch: 0;
                                    background: Palette.panel-inset;
                                    border-radius: Spacing.radius-row;

                                    // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                    min-height: rip-158.preferred-height;
                                    rip-158 := VerticalLayout {
                                        padding: Spacing.md;
                                        spacing: Spacing.xs;

                                        HorizontalLayout {
                                            spacing: Spacing.sm;
                                            Text {
                                                text: periodo.source;
                                                color: Palette.text;
                                                font-size: Typography.body-secondary;
                                                font-weight: 600;
                                                horizontal-stretch: 1;
                                            }
                                            Text {
                                                text: @tr("Priorità {}", periodo.priority);
                                                color: Palette.text-muted;
                                                font-size: Typography.body-secondary;
                                                horizontal-stretch: 0;
                                            }
                                        }
                                        Text {
                                            text: periodo.when;
                                            color: Palette.text-muted;
                                            font-size: Typography.group-label;
                                        }
                                        Text {
                                            text: periodo.sentence;
                                            color: Palette.text-muted;
                                            font-size: Typography.group-label;
                                            wrap: word-wrap;
                                        }
                                        HorizontalLayout {
                                            spacing: Spacing.sm;
                                            vertical-stretch: 0;

                                            PercheVedoQuesto {
                                                elemento: periodo.source + ", " + periodo.when;
                                                chiesto => {
                                                    root.explain-this(Spiegabile.periodo-prioritario, "", periodo.sentence);
                                                }
                                            }
                                            HudButton {
                                                label: @tr("Da valutare per un recupero");
                                                enabled: root.gap-reason != "";
                                                clicked => {
                                                    root.gap-decide(periodo.key, "da_valutare_per_recupero");
                                                }
                                            }
                                            HudButton {
                                                label: @tr("Dichiarato non coperto");
                                                enabled: root.gap-reason != "";
                                                clicked => {
                                                    root.gap-decide(periodo.key, "dichiarato_non_coperto");
                                                }
                                            }
                                            Rectangle { horizontal-stretch: 1; background: transparent; }
                                        }
                                    }
                                }

                                // Il limite dichiarato dove chi ha letto tutto
                                // lo trova.
                                Text {
                                    text: @tr("Questa coda non assegna nulla a nessuno. Su una postazione sola nessun operatore entra con un proprio accesso: non si sa chi stia lavorando. Dire «preso in carico» senza sapere da chi sarebbe peggio che non dirlo. Il lavoro si assegna dove una persona si dimostra, cioè nella Revisione condivisa di un ufficio con un Hub. Per lavorare su un contenuto si apre lo Storico: la riga qui sopra dice in quale monitoraggio cercare.");
                                    color: Palette.text-muted;
                                    font-size: Typography.group-label;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }

                    // ------------------------------------------------ Diagnostica
                    //
                    // Le tredici aree del congelamento in un posto solo.
                    //
                    // # Che cosa questa schermata NON fa
                    //
                    // **Non compie alcun gesto.** Dove esiste un rimedio,
                    // dice DOVE si compie: un secondo pannello di comandi
                    // accanto a quello vero e' due pannelli che divergono, e
                    // il giorno in cui uno dei due cambia l'altro mente.
                    //
                    // # I tre stati non sono due
                    //
                    // «Non misurato» ha un colore proprio, ed e' NEUTRO. Non
                    // e' verde, perche' il prodotto non ha guardato; non e'
                    // rosso, perche' non ha visto niente di rotto. Su questa
                    // postazione almeno due aree lo sono sempre — la cifratura
                    // del disco e l'aggiornamento — e dipingerle di rosso
                    // insegnerebbe a ignorare il rosso.
                    if root.current-page == 17: Rectangle {
                        // Comparsa graduale della pagina: vedere la pagina 0 per il
                        // perche' la dissolvenza sia solo in entrata.
                        property <bool> entered: false;
                        opacity: 0.0;
                        init => {
                            self.entered = true;
                        }
                        animate opacity {
                            duration: Motion.transition-effective;
                            easing: cubic-bezier(0.16, 1, 0.3, 1);
                        }
        states [
            shown when self.entered: {
                opacity: 1.0;
            }
        ]
                        background: Palette.panel;
                        border-radius: Spacing.radius-panel;

                        HudScroll {
                            VerticalLayout {
                                padding: Spacing.xl;
                                spacing: Spacing.lg;
                                alignment: start;

                                Text {
                                    text: @tr("Diagnostica");
                                    color: Palette.text;
                                    font-size: Typography.screen-title;
                                    font-weight: Typography.medium;
                                }

                                Text {
                                    text: @tr("Che cosa questa postazione può fare adesso, in un posto solo. La fotografia si prende quando si apre questa schermata e quando la si chiede: leggere non cambia nulla.");
                                    color: Palette.text-muted;
                                    font-size: Typography.body-secondary;
                                    wrap: word-wrap;
                                }

                                HorizontalLayout {
                                    spacing: Spacing.sm;
                                    vertical-stretch: 0;

                                    VerticalLayout {
                                        spacing: Spacing.xs;
                                        horizontal-stretch: 1;

                                        Text {
                                            text: root.diagnostics-summary;
                                            color: root.diagnostics-attention
                                                ? Palette.amber
                                                : Palette.text;
                                            font-size: Typography.body-secondary;
                                            wrap: word-wrap;
                                        }
                                        // L'istante viaggia accanto allo stato: uno
                                        // stato senza il proprio istante e' uno stato
                                        // di cui non si sa se valga ancora.
                                        Text {
                                            text: root.diagnostics-taken-at;
                                            color: Palette.text-muted;
                                            font-size: Typography.group-label;
                                            wrap: word-wrap;
                                        }
                                    }

                                    HudButton {
                                        label: @tr("Aggiorna");
                                        clicked => {
                                            root.refresh-diagnostics();
                                        }
                                    }
                                    // L'ESPORTAZIONE (DIAG-02).
                                    //
                                    // E' l'unica cosa che questa schermata
                                    // SCRIVE, ed e' la sua, non il rimedio di
                                    // un'altra: produce il file che si manda a
                                    // chi assiste.
                                    HudButton {
                                        label: @tr("Esporta per l'assistenza");
                                        clicked => {
                                            root.export-diagnostics();
                                        }
                                    }
                                }

                                // Che cosa il file conterra', detto PRIMA di
                                // produrlo. Chi lo legge dopo averlo spedito lo
                                // legge troppo tardi.
                                Text {
                                    text: @tr("Il file esportato contiene queste stesse righe e nulla d'altro: nessun testo di messaggio, nessun nome di fonte, nessuna credenziale, nessun percorso di cartella. Si può inviare a chi assiste.");
                                    color: Palette.text-muted;
                                    font-size: Typography.group-label;
                                    wrap: word-wrap;
                                }

                                if root.diagnostics-export-message != "": Text {
                                    text: root.diagnostics-export-message;
                                    color: Palette.text;
                                    font-size: Typography.body-secondary;
                                    wrap: word-wrap;
                                }

                                LegendaOrigini {
                                    calcolato: @tr("esito, dettaglio e azione");
                                }
                                for voce in root.diagnostics: Rectangle {
                                    vertical-stretch: 0;
                                    background: Palette.panel-inset;
                                    border-radius: Spacing.radius-row;

                                    // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                    min-height: rip-159.preferred-height;
                                    rip-159 := VerticalLayout {
                                        padding: Spacing.md;
                                        spacing: Spacing.xs;

                                        HorizontalLayout {
                                            spacing: Spacing.sm;
                                            vertical-stretch: 0;

                                            Text {
                                                text: voce.area;
                                                color: Palette.text;
                                                font-size: Typography.body-secondary;
                                                font-weight: 600;
                                                horizontal-stretch: 1;
                                            }
                                            // Lo stato e' SCRITTO oltre che colorato:
                                            // il colore da solo non basta a chi non lo
                                            // distingue.
                                            //
                                            // «Non misurato» e' grigio, non rosso e non
                                            // verde: il prodotto non ha guardato, e
                                            // non deve sembrare che abbia guardato.
                                            Text {
                                                text: voce.outcome;
                                                color: voce.problem
                                                    ? Palette.coral
                                                    : voce.attention
                                                        ? Palette.amber
                                                        : voce.unmeasured
                                                            ? Palette.text-muted
                                                            : Palette.green;
                                                font-family: Typography.mono;
                                                font-size: Typography.body-secondary;
                                                horizontal-stretch: 0;
                                            }
                                        }

                                        Text {
                                            text: voce.detail;
                                            color: Palette.text-muted;
                                            font-size: Typography.body-secondary;
                                            wrap: word-wrap;
                                        }

                                        // Il gesto, quando c'e'. Dice dove si compie:
                                        // questa schermata guarda e non tocca.
                                        if voce.action != "": Text {
                                            text: voce.action;
                                            color: Palette.text;
                                            font-size: Typography.group-label;
                                            wrap: word-wrap;
                                        }
                                    }
                                }

                                // Il limite dichiarato in fondo, dove chi ha letto
                                // tutto lo trova: una fotografia buona non e' una
                                // garanzia, ed e' la frase che impedisce di leggerla
                                // come tale.
                                AvvertenzaDiSicurezza {
                                    codice: "SIC-12";
                                    testo: @tr("Queste voci dicono che cosa è stato controllato. Non dicono che tutto funzionerà. Un'area «non misurata» non è un'area a posto. È un'area che il programma non ha potuto controllare, e la riga dice perché.");
                                    dettaglio: @tr("Ogni controllo di diagnostica ha tre esiti: superato, non superato, non misurato. «Non misurato» vuol dire che la misura non è stata possibile.");
                                }
                            }
                        }
                    }

                    // ------------------------------------------------ Cyber Watch
                    //
                    // Un grappolo di segnali NON e' un incidente confermato, e
                    // questa schermata non ha alcun modo di dirlo: non esiste
                    // uno stato «confermato» che il programma possa assegnare
                    // da se' (ADR-0035 Decisione 6). Ogni riquadro comincia
                    // dalla RAGIONE per cui i contenuti stanno insieme, che chi
                    // legge puo' verificare e, se serve, smentire.
                    if root.current-page == 16: Rectangle {
                        // Comparsa graduale della pagina: vedere la pagina 0 per il
                        // perche' la dissolvenza sia solo in entrata.
                        property <bool> entered: false;
                        opacity: 0.0;
                        init => {
                            self.entered = true;
                            // Una richiesta rimasta da una visita di prima non vale.
                            root.cronologia-da-mostrare = false;
                        }
                        animate opacity {
                            duration: Motion.transition-effective;
                            easing: cubic-bezier(0.16, 1, 0.3, 1);
                        }
        states [
            shown when self.entered: {
                opacity: 1.0;
            }
        ]
                        background: Palette.panel;
                        border-radius: Spacing.radius-panel;
                        // La cronologia chiesta da «Cronologia» si porta in
                        // vista al giro dopo, quando l'altezza della schermata
                        // la comprende (CU01-014, DEC-507).
                        Timer {
                            interval: Motion.settle;
                            running: root.cyber-timeline-open && root.cronologia-da-mostrare;
                            triggered => {
                                root.cronologia-da-mostrare = false;
                                root.porta-in-vista(cronologia-posto.absolute-position.y);
                            }
                        }

                        VerticalLayout {
                            padding: Spacing.xl;
                            spacing: Spacing.lg;

                            VerticalLayout {
                                spacing: Spacing.xs;
                                vertical-stretch: 0;

                                Text {
                                    text: @tr("Segnali cyber");
                                    color: Palette.text;
                                    font-size: Typography.screen-title;
                                    font-weight: Typography.medium;
                                }
                                Text {
                                    text: @tr("Contenuti che nominano lo stesso indicatore tecnico, raccolti perché qualcuno li guardi insieme.");
                                    color: Palette.text-muted;
                                    font-size: Typography.body-secondary;
                                    wrap: word-wrap;
                                }
                                // La frase che questa schermata esiste per non
                                // lasciare implicita. Sta in alto, prima
                                // dell'elenco, perche' chi legge deve sapere
                                // che cosa ha davanti PRIMA di leggerlo.
                                AvvertenzaDiSicurezza {
                                    codice: "SIC-13";
                                    testo: @tr("Un gruppo non è un attacco, e nemmeno una notizia verificata. È un invito a guardare. La conclusione la trae una persona. Il programma non ha un modo per registrarla al posto suo.");
                                    dettaglio: @tr("Un grappolo raccoglie contenuti che condividono indicatori, come domini, indirizzi o codici CVE. La correlazione è deterministica e non assegna alcuno stato di minaccia.");
                                }
                            }
                            // ------------------------- la ricerca nei messaggi
                            //
                            // NEXUM97-CYBER-SEARCH-01, ADR-0154, DG-06. Prima si
                            // dice quale ricerca fa che cosa, e su quale perimetro
                            // (F-079, GAP-16); poi le tre costruite, B, C e D
                            // (CYBER-SEARCH-02, ADR-0161: la D soltanto dentro la
                            // quota gratuita). I risultati NON sono acquisizioni: si
                            // leggono qui e non entrano nello Storico.
                            Rectangle {
                                vertical-stretch: 0;
                                background: Palette.panel-raised;
                                border-radius: Spacing.radius-row;
                                // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                min-height: rip-188.preferred-height;
                                rip-188 := VerticalLayout {
                                    padding: Spacing.md;
                                    spacing: Spacing.sm;

                                    Text {
                                        text: @tr("RICERCA NEI MESSAGGI");
                                        color: Palette.text-muted;
                                        font-size: Typography.group-label;
                                        letter-spacing: Typography.track-eyebrow;
                                    }
                                    Text {
                                        text: @tr("Quale ricerca fa che cosa:");
                                        color: Palette.text;
                                        font-size: Typography.body-secondary;
                                    }
                                    Text {
                                        text: @tr("A — nell'archivio, su ciò che è già acquisito: attiva, nello Storico e qui sotto.");
                                        color: Palette.text-muted;
                                        font-size: Typography.technical;
                                        wrap: word-wrap;
                                    }
                                    Text {
                                        text: @tr("B — nelle chat di questo account, tranne le segrete: attiva qui, da provare con Telegram vero.");
                                        color: Palette.text-muted;
                                        font-size: Typography.technical;
                                        wrap: word-wrap;
                                    }
                                    Text {
                                        text: @tr("C — dentro una chat indicata per numero: attiva qui; se l'account non ne fa parte, non è verificato che Telegram risponda.");
                                        color: Palette.text-muted;
                                        font-size: Typography.technical;
                                        wrap: word-wrap;
                                    }
                                    Text {
                                        text: @tr("D — nei post dei canali pubblici, anche di canali non seguiti: attiva qui, soltanto dentro la quota gratuita di oggi; il prodotto non spende Stelle. Da provare con Telegram vero.");
                                        color: Palette.text-muted;
                                        font-size: Typography.technical;
                                        wrap: word-wrap;
                                    }
                                    Text {
                                        text: @tr("E — ricerche ripetute nel tempo: attiva qui, a programma aperto. Una ricerca salvata si ripete e mostra soltanto i messaggi nuovi, dentro un tetto dichiarato.");
                                        color: Palette.text-muted;
                                        font-size: Typography.technical;
                                        wrap: word-wrap;
                                    }

                                    HorizontalLayout {
                                        spacing: Spacing.sm;
                                        HudButton {
                                            label: @tr("B — nelle chat dell'account");
                                            selected: root.cyber-search-branch == 0;
                                            clicked => { root.cyber-search-branch = 0; }
                                        }
                                        HudButton {
                                            label: @tr("C — dentro una chat");
                                            selected: root.cyber-search-branch == 1;
                                            clicked => { root.cyber-search-branch = 1; }
                                        }
                                        HudButton {
                                            label: @tr("D — nei post pubblici");
                                            selected: root.cyber-search-branch == 2;
                                            clicked => { root.cyber-search-branch = 2; }
                                        }
                                        Rectangle { horizontal-stretch: 1; background: transparent; }
                                    }
                                    if root.cyber-search-branch == 1 || root.cross-search-c: HudInput {
                                        placeholder: @tr("Numero della chat, per esempio dalla Ricerca puntuale");
                                        label: @tr("Chat in cui cercare");
                                        value <=> root.cyber-search-chat;
                                    }
                                    HudInput {
                                        placeholder: @tr("Da 2 a 64 caratteri");
                                        label: @tr("Parole da cercare");
                                        value <=> root.cyber-search-query;
                                        accepted => {
                                            root.cyber-search-start(root.cyber-search-branch, root.cyber-search-chat, root.cyber-search-query);
                                        }
                                    }
                                    HorizontalLayout {
                                        spacing: Spacing.sm;
                                        HudButton {
                                            label: @tr("Cerca");
                                            weight: Weight.primary;
                                            clicked => {
                                                root.cyber-search-start(root.cyber-search-branch, root.cyber-search-chat, root.cyber-search-query);
                                            }
                                        }
                                        HudButton {
                                            label: @tr("Pagina successiva");
                                            enabled: root.cyber-search-can-continue;
                                            clicked => {
                                                root.cyber-search-next();
                                            }
                                        }
                                        Rectangle { horizontal-stretch: 1; background: transparent; }
                                    }
                                    if root.cyber-search-scope != "": Text {
                                        text: root.cyber-search-scope;
                                        color: Palette.text-muted;
                                        font-size: Typography.technical;
                                        wrap: word-wrap;
                                    }
                                    if root.cyber-search-outcome != "": Text {
                                        text: root.cyber-search-outcome;
                                        color: Palette.text;
                                        font-size: Typography.body-secondary;
                                        wrap: word-wrap;
                                    }
                                    LegendaOrigini {
                                        osservato: @tr("messaggi trovati: chat, istante, autore, testo");
                                    }
                                    for risultato in root.cyber-search-hits: Rectangle {
                                        vertical-stretch: 0;
                                        background: Palette.panel;
                                        border-radius: Spacing.radius-row;
                                        // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                        min-height: rip-189.preferred-height;
                                        rip-189 := VerticalLayout {
                                            padding: Spacing.sm;
                                            spacing: 2px;
                                            Text {
                                                text: risultato.chat + "  ·  " + risultato.when;
                                                color: Palette.text-muted;
                                                font-family: Typography.mono;
                                                font-size: Typography.technical;
                                                wrap: word-wrap;
                                            }
                                            Text {
                                                text: risultato.excerpt;
                                                color: Palette.text;
                                                font-size: Typography.body-secondary;
                                                wrap: word-wrap;
                                            }
                                            Text {
                                                text: risultato.who;
                                                color: Palette.text-muted;
                                                font-size: Typography.technical;
                                                wrap: word-wrap;
                                            }
                                        }
                                    }

                                    // ------------------------ le ricerche ricorrenti
                                    //
                                    // CYBER-WATCH-02, ADR-0162: la ricerca scritta qui sopra,
                                    // salvata, si ripete a programma aperto dentro un budget
                                    // dichiarato. Le novità si leggono qui e non entrano nello
                                    // Storico.
                                    Text {
                                        text: @tr("RICERCHE RICORRENTI");
                                        color: Palette.text-muted;
                                        font-size: Typography.group-label;
                                        letter-spacing: Typography.track-eyebrow;
                                    }
                                    Text {
                                        text: @tr("La ricerca scritta qui sopra si può salvare e ripetere da ogni ora a ogni giorno, soltanto a programma aperto. Al più 10 ricerche ricorrenti e 10 pagine all'ora; per la D resta a chi cerca a mano metà della quota gratuita.");
                                        color: Palette.text-muted;
                                        font-size: Typography.technical;
                                        wrap: word-wrap;
                                    }
                                    // Il campo parte con un valore, e il segnaposto non si
                                    // vede: il suo nome va scritto accanto (QUALITY-02).
                                    Text {
                                        text: @tr("Ogni quante ore");
                                        color: Palette.text-muted;
                                        font-size: Typography.body-secondary;
                                    }
                                    HorizontalLayout {
                                        spacing: Spacing.sm;
                                        HudInput {
                                            placeholder: @tr("Da 1 a 24");
                                            label: @tr("Ogni quante ore");
                                            value <=> root.cyber-recurring-hours;
                                        }
                                        VerticalLayout {
                                            alignment: end;
                                            HudButton {
                                                label: @tr("Salva come ricorrente");
                                                clicked => {
                                                    root.cyber-recurring-save(root.cyber-search-branch, root.cyber-search-chat, root.cyber-search-query, root.cyber-recurring-hours);
                                                }
                                            }
                                        }
                                        Rectangle { horizontal-stretch: 1; background: transparent; }
                                    }
                                    if root.cyber-recurring-feedback != "": Text {
                                        text: root.cyber-recurring-feedback;
                                        color: Palette.text;
                                        font-size: Typography.body-secondary;
                                        wrap: word-wrap;
                                    }
                                    LegendaOrigini {
                                        operatore: @tr("le parole, il ramo, l'intervallo, se è sospesa");
                                        calcolato: @tr("l'ultima esecuzione e la copertura");
                                        osservato: @tr("i messaggi nuovi");
                                    }
                                    for ricorrente in root.cyber-recurring-rows: Rectangle {
                                        vertical-stretch: 0;
                                        background: Palette.panel;
                                        border-radius: Spacing.radius-row;
                                        // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                        min-height: rip-192.preferred-height;
                                        rip-192 := VerticalLayout {
                                            padding: Spacing.sm;
                                            spacing: 2px;
                                            Text {
                                                text: ricorrente.title;
                                                color: Palette.text;
                                                font-size: Typography.body-secondary;
                                                wrap: word-wrap;
                                            }
                                            Text {
                                                text: ricorrente.coverage;
                                                color: Palette.text-muted;
                                                font-size: Typography.technical;
                                                wrap: word-wrap;
                                            }
                                            if ricorrente.novelties != "": Text {
                                                text: ricorrente.novelties;
                                                color: Palette.text;
                                                font-size: Typography.technical;
                                                wrap: word-wrap;
                                            }
                                            HorizontalLayout {
                                                spacing: Spacing.sm;
                                                HudButton {
                                                    label: ricorrente.suspended ? @tr("Riprendi") : @tr("Sospendi");
                                                    clicked => {
                                                        root.cyber-recurring-toggle(ricorrente.id, !ricorrente.suspended);
                                                    }
                                                }
                                                HudButton {
                                                    label: @tr("Ritira");
                                                    clicked => {
                                                        root.cyber-recurring-withdraw(ricorrente.id);
                                                    }
                                                }
                                                Rectangle { horizontal-stretch: 1; background: transparent; }
                                            }
                                        }
                                    }

                                    // -------------------------- la ricerca su più rami
                                    //
                                    // CYBER-SEARCH-03, ADR-0163: le parole scritte qui sopra
                                    // nei rami scelti, un elenco solo con le provenienze, e il
                                    // perimetro di ciascun ramo.
                                    Text {
                                        text: @tr("RICERCA SU PIÙ RAMI");
                                        color: Palette.text-muted;
                                        font-size: Typography.group-label;
                                        letter-spacing: Typography.track-eyebrow;
                                    }
                                    Text {
                                        text: @tr("Le parole scritte qui sopra si cercano insieme nei rami scelti: lo stesso messaggio compare una volta, con i rami che l'hanno trovato. Una pagina per ramo; la D soltanto se scelta, perché consuma la quota gratuita.");
                                        color: Palette.text-muted;
                                        font-size: Typography.technical;
                                        wrap: word-wrap;
                                    }
                                    // Una griglia e non due righe: due `HorizontalLayout` dividono
                                    // ciascuno lo spazio a modo suo, e B e D non stavano in colonna.
                                    GridLayout {
                                        spacing: Spacing.sm;
                                        Row {
                                            HudCheck {
                                                text: @tr("A — nell'archivio");
                                                checked <=> root.cross-search-a;
                                            }
                                            HudCheck {
                                                text: @tr("B — nelle chat dell'account");
                                                checked <=> root.cross-search-b;
                                            }
                                        }
                                        Row {
                                            HudCheck {
                                                text: @tr("C — nella chat scritta qui sopra");
                                                checked <=> root.cross-search-c;
                                            }
                                            HudCheck {
                                                text: @tr("D — nei post pubblici");
                                                checked <=> root.cross-search-d;
                                            }
                                        }
                                    }
                                    HorizontalLayout {
                                        spacing: Spacing.sm;
                                        HudButton {
                                            label: @tr("Cerca su più rami");
                                            clicked => {
                                                root.cross-search-start(root.cross-search-a, root.cross-search-b, root.cross-search-c, root.cross-search-d, root.cyber-search-chat, root.cyber-search-query);
                                            }
                                        }
                                        Rectangle { horizontal-stretch: 1; background: transparent; }
                                    }
                                    if root.cross-search-report != "": Text {
                                        text: root.cross-search-report;
                                        color: Palette.text;
                                        font-size: Typography.body-secondary;
                                        wrap: word-wrap;
                                    }
                                    LegendaOrigini {
                                        osservato: @tr("messaggi trovati: chat, istante, autore, testo");
                                        calcolato: @tr("i rami che li hanno trovati");
                                    }
                                    for riga in root.cross-search-rows: Rectangle {
                                        vertical-stretch: 0;
                                        background: Palette.panel;
                                        border-radius: Spacing.radius-row;
                                        // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                        min-height: rip-193.preferred-height;
                                        rip-193 := VerticalLayout {
                                            padding: Spacing.sm;
                                            spacing: 2px;
                                            Text {
                                                text: riga.chat + "  ·  " + riga.when;
                                                color: Palette.text-muted;
                                                font-family: Typography.mono;
                                                font-size: Typography.technical;
                                                wrap: word-wrap;
                                            }
                                            Text {
                                                text: riga.found-by;
                                                color: Palette.text-muted;
                                                font-size: Typography.technical;
                                                wrap: word-wrap;
                                            }
                                            Text {
                                                text: riga.excerpt;
                                                color: Palette.text;
                                                font-size: Typography.body-secondary;
                                                wrap: word-wrap;
                                            }
                                            Text {
                                                text: riga.who;
                                                color: Palette.text-muted;
                                                font-size: Typography.technical;
                                                wrap: word-wrap;
                                            }
                                        }
                                    }
                                }
                            }


                            HorizontalLayout {
                                spacing: Spacing.md;
                                vertical-stretch: 0;

                                HudSelect {
                                    model: root.cyber-sessions;
                                    label: @tr("Monitoraggio da esaminare");
                                    current-index <=> root.cyber-session-index;
                                    selected => {
                                        root.cyber-session-chosen(self.current-index);
                                    }
                                }
                            }

                            // Un errore di lettura si dice, e non si confonde
                            // con «non c'e' nulla»: sono due cose diverse, e
                            // solo una delle due significa che l'archivio va
                            // guardato.
                            if root.cyber-message != "": ErrorBanner {
                                message: root.cyber-message;
                            }

                            // Nessuna sessione scelta: si chiede di sceglierne
                            // una invece di mostrare un elenco vuoto, che
                            // direbbe «non c'e' nulla da guardare» a chi non ha
                            // ancora guardato niente.
                            //
                            // I grappoli si costruiscono DENTRO una sessione:
                            // mettere insieme contenuti di due monitoraggi
                            // diversi produrrebbe un gruppo che non appartiene a
                            // nessuno dei due (DEC-221).
                            if !root.cyber-has-session && root.cyber-candidates.length == 0: Rectangle {
                                background: Palette.panel-raised;
                                border-radius: Spacing.radius-row;
                                vertical-stretch: 1;
                                VerticalLayout {
                                    alignment: center;
                                    spacing: Spacing.xs;
                                    Text {
                                        text: @tr("Scegliere un monitoraggio");
                                        color: Palette.text;
                                        font-size: Typography.section-title;
                                        horizontal-alignment: center;
                                    }
                                    Text {
                                        text: @tr("I gruppi si formano dentro un monitoraggio. Metterne insieme due produrrebbe un gruppo che non appartiene a nessuno dei due.");
                                        color: Palette.text-muted;
                                        font-size: Typography.body-secondary;
                                        horizontal-alignment: center;
                                        wrap: word-wrap;
                                    }
                                }
                            }

                            // NESSUN MONITORAGGIO SCELTO, E L'ARCHIVIO HA EVENTI
                            // CANDIDATI (CYBER-EVENTS-02, ADR-0189): lo stesso
                            // indicatore da fonti distinte, anche in monitoraggi
                            // diversi. Ogni voce dice in quali: il gruppo non
                            // finge di appartenere a uno solo (DEC-221).
                            if !root.cyber-has-session && root.cyber-candidates.length > 0: Rectangle {
                                vertical-stretch: 0;
                                // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                min-height: candidati-elenco.preferred-height;

                                candidati-elenco := VerticalLayout {
                                    spacing: Spacing.md;

                                    Text {
                                        text: @tr("Eventi candidati in tutto l'archivio");
                                        color: Palette.text;
                                        font-size: Typography.section-title;
                                    }
                                    Text {
                                        text: @tr("Gli ultimi 30 giorni: lo stesso indicatore nominato da fonti distinte, a distanza di non più di 72 ore. Sono da verificare: non dicono che un attacco sia avvenuto. Per i gruppi di un monitoraggio, sceglierlo.");
                                        color: Palette.text-muted;
                                        font-size: Typography.body-secondary;
                                        wrap: word-wrap;
                                    }
                                    LegendaOrigini {
                                        calcolato: @tr("conteggi, monitoraggi e orari");
                                        operatore: @tr("revisione");
                                    }
                                    for candidato in root.cyber-candidates: Rectangle {
                                        background: Palette.panel-raised;
                                        border-radius: Spacing.radius-row;

                                        VerticalLayout {
                                            padding: Spacing.md;
                                            spacing: Spacing.xs;

                                            Text {
                                                text: candidato.sentence;
                                                color: Palette.text;
                                                font-size: Typography.body;
                                                wrap: word-wrap;
                                            }
                                            Text {
                                                text: @tr("Pubblicati fra {} e {}. Monitoraggi: {}.", candidato.first-seen, candidato.last-seen, candidato.sessions);
                                                color: Palette.text-muted;
                                                font-size: Typography.technical;
                                                wrap: word-wrap;
                                            }
                                            Text {
                                                text: candidato.review;
                                                color: Palette.text-muted;
                                                font-size: Typography.technical;
                                                wrap: word-wrap;
                                            }
                                            if candidato.first-content-id > 0: HudButton {
                                                label: @tr("Apri la conversazione");
                                                clicked => {
                                                    root.conversation-open-requested(candidato.first-content-id, "Segnali cyber");
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            // Sessione scelta e nessun gruppo: e' la condizione
                            // ORDINARIA, e un elenco che mostrasse qualcosa
                            // comunque insegnerebbe a ignorarlo.
                            if root.cyber-has-session
                                && root.cyber-events.length == 0
                                && root.cyber-message == "": Rectangle {
                                background: Palette.panel-raised;
                                border-radius: Spacing.radius-row;
                                vertical-stretch: 1;
                                VerticalLayout {
                                    alignment: center;
                                    spacing: Spacing.xs;
                                    Text {
                                        text: @tr("Nessun gruppo di segnali");
                                        color: Palette.text;
                                        font-size: Typography.section-title;
                                        horizontal-alignment: center;
                                    }
                                    Text {
                                        text: @tr("Nessun indicatore tecnico compare in più di un contenuto di questo monitoraggio. È la condizione normale: un gruppo nasce dal ripetersi, non dalla presenza.");
                                        color: Palette.text-muted;
                                        font-size: Typography.body-secondary;
                                        horizontal-alignment: center;
                                        wrap: word-wrap;
                                    }
                                }
                            }

                            // I GRUPPI SCORRONO CON LA SCHERMATA (CU01-014,
                            // DEC-507). Avevano un'area a scorrimento loro, e
                            // sotto la ricerca ricevevano 40px: il collaudo
                            // della 0.2.2 ne vedeva soltanto l'intestazione.
                            // Lo stesso per gli eventi candidati, qui sopra.
                            if root.cyber-events.length > 0: Rectangle {
                                vertical-stretch: 0;
                                // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                min-height: gruppi-elenco.preferred-height;

                                gruppi-elenco := VerticalLayout {
                                    spacing: Spacing.md;

                                    LegendaOrigini {
                                        calcolato: @tr("conteggi, indicatori, settori e orari");
                                        operatore: @tr("revisione");
                                    }
                                    for entry in root.cyber-events: Rectangle {
                                        background: Palette.panel-raised;
                                        border-radius: Spacing.radius-row;
                                        border-width: Spacing.hairline;
                                        border-color: Palette.line-divider;

                                        // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                        min-height: rip-160.preferred-height;
                                        rip-160 := VerticalLayout {
                                            padding: Spacing.md;
                                            spacing: Spacing.sm;

                                            // LA RAGIONE, per prima e in
                                            // evidenza. Un numero senza una
                                            // ragione e' un numero che non si
                                            // puo' contestare.
                                            Text {
                                                text: entry.reason;
                                                color: Palette.text;
                                                font-size: Typography.body;
                                                font-weight: Typography.medium;
                                                wrap: word-wrap;
                                            }

                                            Text {
                                                text: entry.assessment;
                                                color: Palette.text-muted;
                                                font-size: Typography.body-secondary;
                                                wrap: word-wrap;
                                            }

                                            HorizontalLayout {
                                                spacing: Spacing.lg;

                                                VerticalLayout {
                                                    spacing: 1px;
                                                    Text {
                                                        text: entry.contents;
                                                        color: Palette.amber;
                                                        font-size: Typography.body;
                                                        font-weight: Typography.medium;
                                                    }
                                                    Text {
                                                        text: @tr("contenuti");
                                                        color: Palette.text-muted;
                                                        font-size: Typography.group-label;
                                                    }
                                                }
                                                VerticalLayout {
                                                    spacing: 1px;
                                                    Text {
                                                        text: entry.distinct-sources;
                                                        color: Palette.cyan;
                                                        font-size: Typography.body;
                                                        font-weight: Typography.medium;
                                                    }
                                                    // «distinte», mai
                                                    // «indipendenti»: stabilire
                                                    // l'indipendenza richiede
                                                    // sapere chi ha scritto per
                                                    // primo, e il prodotto non
                                                    // lo sa.
                                                    Text {
                                                        text: @tr("fonti distinte");
                                                        color: Palette.text-muted;
                                                        font-size: Typography.group-label;
                                                    }
                                                }
                                                if entry.apparent-reposts > 0: Rectangle {
                                                    // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                                    min-height: rip-161.preferred-height;
                                                    rip-161 := VerticalLayout {
                                                        spacing: 1px;
                                                        Text {
                                                            text: entry.apparent-reposts;
                                                            color: Palette.text;
                                                            font-size: Typography.body;
                                                            font-weight: Typography.medium;
                                                        }
                                                        Text {
                                                            text: @tr("testi identici");
                                                            color: Palette.text-muted;
                                                            font-size: Typography.group-label;
                                                        }
                                                    }
                                                }
                                                Rectangle { horizontal-stretch: 1; background: transparent; }
                                                VerticalLayout {
                                                    spacing: 1px;
                                                    alignment: end;
                                                    Text {
                                                        text: @tr("visto fra {} e {}", entry.first-seen, entry.last-seen);
                                                        color: Palette.text-muted;
                                                        font-size: Typography.group-label;
                                                        horizontal-alignment: right;
                                                    }
                                                    Text {
                                                        text: @tr("date di pubblicazione, non di acquisizione");
                                                        color: Palette.text-muted;
                                                        font-size: Typography.group-label;
                                                        horizontal-alignment: right;
                                                    }
                                                }
                                            }

                                            // La rilevanza per l'Italia e' una
                                            // DIMENSIONE A SE', separata dalla
                                            // gravita': riguardare l'Italia non
                                            // rende grave nulla (ADR-0035
                                            // Decisione 10). Il colore e' neutro
                                            // per questo.
                                            if entry.has-italy-signal: Text {
                                                text: entry.italy;
                                                color: Palette.text;
                                                font-size: Typography.body-secondary;
                                                wrap: word-wrap;
                                            }

                                            // Il settore e' la QUARTA dimensione,
                                            // separata dalle altre tre per la
                                            // stessa ragione: ricadere in un
                                            // ambito che la norma considera
                                            // critico non rende grave nulla.
                                            //
                                            // Colore neutro come la rilevanza
                                            // italiana. L'ambra e' riservata a
                                            // cio' che chiede un'azione, e un
                                            // settore non ne chiede.
                                            if entry.has-sector: Rectangle {
                                                // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                                min-height: rip-162.preferred-height;
                                                rip-162 := VerticalLayout {
                                                    spacing: 2px;

                                                    Text {
                                                        text: @tr("Settore: {}", entry.sector-labels);
                                                        color: Palette.text;
                                                        font-size: Typography.body-secondary;
                                                        wrap: word-wrap;
                                                    }
                                                    // La provenienza per esteso:
                                                    // quale organizzazione, che cosa
                                                    // ha riscontrato, e CHI ha
                                                    // dichiarato il settore. Senza,
                                                    // l'attribuzione non si potrebbe
                                                    // contestare.
                                                    Text {
                                                        text: entry.sectors;
                                                        color: Palette.text-muted;
                                                        font-size: Typography.group-label;
                                                        wrap: word-wrap;
                                                    }
                                                }
                                            }

                                            if entry.indicators.length > 0: Rectangle {
                                                // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                                min-height: rip-163.preferred-height;
                                                rip-163 := VerticalLayout {
                                                    spacing: 2px;

                                                    Text {
                                                        text: @tr("Indicatori nominati dai contenuti del gruppo:");
                                                        color: Palette.text-muted;
                                                        font-size: Typography.group-label;
                                                    }
                                                    for indicator in entry.indicators: Rectangle {
                                                        // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                                        min-height: rip-164.preferred-height;
                                                        rip-164 := HorizontalLayout {
                                                            spacing: Spacing.sm;
                                                            Text {
                                                                text: indicator.kind;
                                                                color: Palette.text-muted;
                                                                font-size: Typography.group-label;
                                                                width: 120px;
                                                            }
                                                            Text {
                                                                text: indicator.value;
                                                                color: Palette.text;
                                                                font-size: Typography.technical;
                                                                wrap: word-wrap;
                                                                horizontal-stretch: 1;
                                                            }
                                                        }
                                                    }
                                                }
                                            }

                                            HorizontalLayout {
                                                spacing: Spacing.md;

                                                // Che cosa una PERSONA ha
                                                // deciso. Non c'e' uno stato del
                                                // gruppo, e non deve esserci.
                                                Text {
                                                    text: entry.review;
                                                    color: Palette.text-muted;
                                                    font-size: Typography.group-label;
                                                    vertical-alignment: center;
                                                    wrap: word-wrap;
                                                    horizontal-stretch: 1;
                                                }
                                                // LA STESSA DOMANDA, LA STESSA
                                                // VOCE: che genere di certezza
                                                // e' un gruppo di segnali. La
                                                // risposta dice che e' un
                                                // calcolo, e con quale tetto e
                                                // quale regola.
                                                PercheVedoQuesto {
                                                    elemento: entry.reason;
                                                    chiesto => {
                                                        root.explain-this(Spiegabile.gruppo-di-segnali, entry.search-key, entry.reason + " " + entry.assessment);
                                                    }
                                                }
                                                // In che ordine e' arrivato:
                                                // la cronologia del gruppo.
                                                // Si apre per uno alla volta,
                                                // perche' venti cronologie
                                                // aperte sono una pagina che
                                                // nessuno scorre.
                                                HudButton {
                                                    label: @tr("Cronologia");
                                                    clicked => {
                                                        root.cyber-timeline-requested(entry.reason-kind, entry.search-key);
                                                        // Si apre sotto l'elenco:
                                                        // senza portarla in vista
                                                        // il clic sembra a vuoto.
                                                        if (root.cyber-timeline-open) {
                                                            root.cronologia-da-mostrare = true;
                                                        }
                                                    }
                                                }
                                                // La via dal gruppo ai contenuti
                                                // che lo compongono: senza,
                                                // l'elenco direbbe che qualcosa
                                                // esiste senza permettere di
                                                // guardarlo.
                                                // LA CONVERSAZIONE DEL PRIMO
                                                // MESSAGGIO (ADR-0165, DG-01):
                                                // soltanto per un grappolo di
                                                // questa postazione.
                                                if entry.first-content-id > 0: HudButton {
                                                    label: @tr("Apri la conversazione");
                                                    clicked => {
                                                        root.conversation-open-requested(entry.first-content-id, "Segnali cyber");
                                                    }
                                                }
                                                HudButton {
                                                    label: @tr("Apri nello Storico");
                                                    clicked => {
                                                        root.cyber-open-in-history(entry.search-key);
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            // ------------------------------- la cronologia di
                            // un gruppo (CYT-01)
                            //
                            // Sta SOTTO l'elenco e non dentro la scheda: una
                            // cronologia aperta dentro una voce spingerebbe le
                            // altre fuori dallo schermo, e chi la sta leggendo
                            // perderebbe il gruppo da cui e' partito.
                            //
                            // Il segnaposto dice dov'e', per portarla in vista
                            // quando si apre (CU01-014).
                            cronologia-posto := Rectangle {
                                height: 0px;
                                vertical-stretch: 0;
                            }
                            if root.cyber-timeline-open: Rectangle {
                                background: Palette.panel-raised;
                                border-radius: Spacing.radius-row;
                                border-width: Spacing.hairline;
                                border-color: Palette.line-divider;
                                vertical-stretch: 0;

                                // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                min-height: rip-165.preferred-height;
                                rip-165 := VerticalLayout {
                                    padding: Spacing.md;
                                    spacing: Spacing.sm;

                                    HorizontalLayout {
                                        spacing: Spacing.md;

                                        Text {
                                            text: root.cyber-timeline-title;
                                            color: Palette.text;
                                            font-size: Typography.body;
                                            font-weight: Typography.medium;
                                            wrap: word-wrap;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                        }
                                        HudButton {
                                            label: @tr("Chiudi");
                                            clicked => {
                                                root.cyber-timeline-closed();
                                            }
                                        }
                                    }

                                    // LA RISOLUZIONE DAL PC (IOC-RESOLVE-01,
                                    // ADR-0202): l'avvertenza viene prima del
                                    // pulsante, sempre, anche a risoluzione spenta.
                                    if root.ioc-resolve-applicable: Rectangle {
                                        vertical-stretch: 0;
                                        min-height: rip-207.preferred-height;
                                        rip-207 := VerticalLayout {
                                            spacing: Spacing.sm;
                                            alignment: start;
                                            Text {
                                                text: @tr("La richiesta parte da questo PC e passa per il servizio che traduce i nomi di rete, che la registra. Chi gestisce il dominio chiesto la può vedere arrivare, e capire che qualcuno lo sta guardando.");
                                                color: Palette.amber;
                                                font-size: Typography.body-secondary;
                                                wrap: word-wrap;
                                            }
                                            if root.ioc-resolve-enabled: Rectangle {
                                                // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                                min-height: rip-209.preferred-height;
                                                rip-209 := HorizontalLayout {
                                                    alignment: start;
                                                    HudButton {
                                                        label: @tr("Risolvi dal PC");
                                                        clicked => {
                                                            root.ioc-resolve-request();
                                                        }
                                                    }
                                                }
                                            }
                                            if !root.ioc-resolve-enabled: Text {
                                                text: @tr("La risoluzione dal PC è spenta: la abilita l'amministratore, nelle Impostazioni.");
                                                color: Palette.text-muted;
                                                font-size: Typography.body-secondary;
                                                wrap: word-wrap;
                                            }
                                            if root.ioc-resolve-message != "": Text {
                                                text: root.ioc-resolve-message;
                                                color: Palette.text;
                                                font-size: Typography.body-secondary;
                                                wrap: word-wrap;
                                            }
                                            if root.ioc-resolve-history != "": Rectangle {
                                                // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                                min-height: rip-210.preferred-height;
                                                rip-210 := VerticalLayout {
                                                    spacing: Spacing.xs;
                                                    LegendaOrigini {
                                                        osservato: @tr("le risposte del servizio dei nomi di rete");
                                                        operatore: @tr("chi ha chiesto e quando");
                                                    }
                                                    Text {
                                                        text: root.ioc-resolve-history;
                                                        color: Palette.text-muted;
                                                        font-family: Typography.mono;
                                                        font-size: Typography.technical;
                                                        wrap: word-wrap;
                                                    }
                                                }
                                            }
                                        }
                                    }

                                    // IL WHOIS DAL PC (WHOIS-01, ADR-0205):
                                    // l'avvertenza viene prima del pulsante,
                                    // sempre, anche a WHOIS spento.
                                    if root.whois-applicable: Rectangle {
                                        vertical-stretch: 0;
                                        min-height: rip-213.preferred-height;
                                        rip-213 := VerticalLayout {
                                            spacing: Spacing.sm;
                                            alignment: start;
                                            Text {
                                                text: @tr("Il WHOIS chiede al registro che tiene il nome o l'indirizzo chi l'ha registrato. La richiesta parte da questo PC. Il registro vede da dove arriva la richiesta, e la può conservare. Per molti nomi nazionali la richiesta viaggia in chiaro.");
                                                color: Palette.amber;
                                                font-size: Typography.body-secondary;
                                                wrap: word-wrap;
                                            }
                                            if root.whois-enabled: Rectangle {
                                                // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                                min-height: rip-214.preferred-height;
                                                rip-214 := HorizontalLayout {
                                                    alignment: start;
                                                    HudButton {
                                                        label: @tr("Chi ha registrato il nome");
                                                        clicked => {
                                                            root.whois-request();
                                                        }
                                                    }
                                                }
                                            }
                                            if !root.whois-enabled: Text {
                                                text: @tr("Il WHOIS dal PC è spento: lo abilita l'amministratore, nelle Impostazioni.");
                                                color: Palette.text-muted;
                                                font-size: Typography.body-secondary;
                                                wrap: word-wrap;
                                            }
                                            if root.whois-message != "": Text {
                                                text: root.whois-message;
                                                color: Palette.text;
                                                font-size: Typography.body-secondary;
                                                wrap: word-wrap;
                                            }
                                            if root.whois-history != "": Rectangle {
                                                // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                                min-height: rip-215.preferred-height;
                                                rip-215 := VerticalLayout {
                                                    spacing: Spacing.xs;
                                                    LegendaOrigini {
                                                        osservato: @tr("le risposte del registro");
                                                        operatore: @tr("chi ha chiesto e quando");
                                                    }
                                                    Text {
                                                        text: root.whois-history;
                                                        color: Palette.text-muted;
                                                        font-family: Typography.mono;
                                                        font-size: Typography.technical;
                                                        wrap: word-wrap;
                                                    }
                                                }
                                            }
                                        }
                                    }

                                    // IL PERIODO IN CUI SI E' OSSERVATO, prima
                                    // delle righe e non dopo: senza, un vuoto
                                    // fra due righe si legge come «qui non e'
                                    // successo niente», che e' un fatto che
                                    // nessuno ha misurato.
                                    if root.cyber-timeline-window != "": Text {
                                        text: root.cyber-timeline-window;
                                        color: Palette.text-muted;
                                        font-size: Typography.body-secondary;
                                        wrap: word-wrap;
                                    }

                                    // Perche' la cronologia non c'e'. Un elenco
                                    // vuoto direbbe «non e' successo niente»;
                                    // questa riga dice che non si e' guardato.
                                    if root.cyber-timeline-message != "": Text {
                                        text: root.cyber-timeline-message;
                                        color: Palette.amber;
                                        font-size: Typography.body-secondary;
                                        wrap: word-wrap;
                                    }

                                    for row in root.cyber-timeline: Rectangle {
                                        // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                        min-height: rip-166.preferred-height;
                                        rip-166 := VerticalLayout {
                                            spacing: Spacing.xs;

                                            HorizontalLayout {
                                                spacing: Spacing.md;

                                                Text {
                                                    text: row.when;
                                                    color: Palette.text;
                                                    font-size: Typography.technical;
                                                    width: 200px;
                                                }
                                                // L'OROLOGIO, su ogni riga. Una riga
                                                // copiata in una relazione viaggia
                                                // da sola, e senza questa parola
                                                // sembrerebbe un istante come un
                                                // altro.
                                                Text {
                                                    text: row.clock;
                                                    color: Palette.text-muted;
                                                    font-size: Typography.group-label;
                                                    width: 260px;
                                                    wrap: word-wrap;
                                                }
                                                // L'atto di una persona e
                                                // l'osservazione dell'archivio non
                                                // si rendono allo stesso modo,
                                                // perche' non sono la stessa cosa.
                                                OrigineSegno {
                                                    origine: row.is-human-act ? Origine.operatore : Origine.osservato;
                                                }
                                            }

                                            Text {
                                                text: row.what;
                                                color: Palette.text;
                                                font-size: Typography.body-secondary;
                                                wrap: word-wrap;
                                            }
                                            // I rimandi: contenuto, contesto,
                                            // messaggio originale.
                                            Text {
                                                text: row.reference;
                                                color: Palette.text-muted;
                                                font-size: Typography.group-label;
                                                wrap: word-wrap;
                                            }
                                            // PERCHE' VEDO QUESTO (PR-02): la riga e'
                                            // qui per la regola della cronologia, e
                                            // la sua origine e' quella del segno.
                                            PercheVedoQuesto {
                                                elemento: row.when;
                                                chiesto => {
                                                    root.explain-this(
                                                        row.is-human-act ? Spiegabile.riga-cronologia-di-una-persona : Spiegabile.riga-cronologia-osservata,
                                                        "",
                                                        row.when + ". " + row.what + " " + row.reference);
                                                }
                                            }
                                        }
                                    }

                                    // CHE COSA QUESTE RIGHE NON DICONO, in
                                    // fondo: chi ha finito di leggerle e' il
                                    // momento in cui sta per trarne una
                                    // conclusione.
                                    Text {
                                        text: root.cyber-timeline-caveat;
                                        color: Palette.text-muted;
                                        font-size: Typography.group-label;
                                        wrap: word-wrap;
                                    }
                                }
                            }

                            // Il limite dichiarato, in fondo e non in cima: chi
                            // guarda l'elenco ha gia' letto che cosa e' un
                            // gruppo, e qui trova che cosa il prodotto NON sa
                            // dire.
                            //
                            // Fino a CYBER-SECTOR qui c'era scritto che il
                            // settore non compariva affatto. Ora compare, ma
                            // **solo per le organizzazioni che qualcuno ha
                            // dichiarato**: il limite si e' spostato, e va detto
                            // dove si e' spostato invece di tacerlo.
                            AvvertenzaDiSicurezza {
                                codice: "SIC-14";
                                testo: @tr("Il settore compare solo per le organizzazioni dichiarate in Impostazioni. Il programma non lo deduce dal testo: attribuirne uno a occhio sarebbe inventarlo. Un contenuto senza settore non nomina alcuna organizzazione dichiarata. Non vuol dire che non riguardi un settore. Anche un settore che la norma non elenca conta.");
                                dettaglio: @tr("Il settore viene dall'elenco delle organizzazioni dichiarate, confrontato per nome. Il testo non viene classificato.");
                            }
                        }
                    }
                    if root.current-page == 15: Rectangle {
                        // Comparsa graduale della pagina: vedere la pagina 0
                        // per il perche' la dissolvenza sia solo in entrata.
                        property <bool> entered: false;
                        opacity: 0.0;
                        init => {
                            self.entered = true;
                        }
                        animate opacity {
                            duration: Motion.transition-effective;
                            easing: cubic-bezier(0.16, 1, 0.3, 1);
                        }
        states [
            shown when self.entered: {
                opacity: 1.0;
            }
        ]
                        background: Palette.panel;
                        border-radius: Spacing.radius-panel;

                        VerticalLayout {
                            padding: Spacing.xl;
                            spacing: Spacing.lg;

                            // Barra dei passi. Il passo raggiunto si distingue
                            // anche dalla forma, non dal solo colore.
                            HorizontalLayout {
                                spacing: Spacing.sm;
                                vertical-stretch: 0;

                                for entry in root.report-steps: Rectangle {
                                    height: 32px;
                                    background: entry.current ? Palette.panel-raised : transparent;
                                    border-radius: Spacing.radius-row;

                                    HorizontalLayout {
                                        padding-left: Spacing.sm;
                                        padding-right: Spacing.sm;
                                        spacing: 6px;

                                        Rectangle {
                                            width: 8px;
                                            height: 8px;
                                            horizontal-stretch: 0;
                                            vertical-stretch: 0;
                                            border-radius: Spacing.radius-row;
                                            border-width: 2px;
                                            border-color: entry.reached
                                                ? Palette.frame
                                                : Palette.line-divider;
                                            background: entry.current
                                                ? Palette.frame
                                                : transparent;
                                        }
                                        Text {
                                            // L'ETICHETTA PUO' STRINGERSI (FINAL-FPR-ALL-16,
                                            // FPR-16).
                                            //
                                            // Senza un minimo dichiarato, la barra dei passi
                                            // chiede la propria larghezza naturale — sei
                                            // etichette intere, circa settecento pixel — e la
                                            // alza a larghezza minima della finestra: a 900
                                            // pixel il pannello del wizard finiva oltre il
                                            // bordo destro, «Avanti» compreso. Misurato, non
                                            // supposto: cattura 600-6 del 2026-10-12.
                                            //
                                            // `min-width` dichiara che l'etichetta può
                                            // ridursi al proprio numero, e `elide` dice come:
                                            // i puntini. Il numero del passo resta sempre
                                            // leggibile, e i pallini dicono dove si è.
                                            //
                                            // Nessuna condizione sulla larghezza: una
                                            // condizione sulla larghezza della finestra, in un
                                            // layout che concorre a determinarla, è un ciclo
                                            // di binding, e il compilatore Slint la rifiuta.
                                            // È lo stesso muro di DEC-384.
                                            min-width: 22px;
                                            overflow: elide;
                                            text: entry.number + ". " + entry.title;
                                            color: entry.current
                                                ? Palette.text
                                                : (entry.reached ? Palette.text-muted : Palette.text-disabled);
                                            font-size: Typography.group-label;
                                            font-weight: entry.current
                                                ? Typography.medium
                                                : Typography.regular;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }

                            VerticalLayout {
                                spacing: Spacing.xs;
                                vertical-stretch: 0;

                                Text {
                                    text: root.report-title;
                                    color: Palette.text;
                                    font-size: Typography.screen-title;
                                    font-weight: Typography.medium;
                                }
                                Text {
                                    text: root.report-prompt;
                                    color: Palette.text-muted;
                                    font-size: Typography.body-secondary;
                                    wrap: word-wrap;
                                }
                            }

                            // I numeri della sessione scelta, visibili a ogni
                            // passo: chi compila l'oggetto della relazione deve
                            // continuare a vedere quanto ha selezionato.
                            if root.report-session-chosen: Rectangle {
                                // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                min-height: rip-167.preferred-height;
                                rip-167 := VerticalLayout {
                                    spacing: Spacing.sm;
                                    vertical-stretch: 0;

                                    HorizontalLayout {
                                        spacing: Spacing.md;
                                        vertical-stretch: 0;

                                        // I contatori sono anche i filtri: la cifra che si legge e' il modo
                                        // piu' corto per chiedere «fammi vedere proprio quelli». Premono
                                        // soltanto al passo dei contenuti, dove l'elenco che filtrano si
                                        // vede cambiare: altrove sarebbero un comando che agisce su una
                                        // schermata che non si sta guardando.
                                        Counter {
                                            caption: @tr("monitorati");
                                            value: root.report-total;
                                            actionable: root.report-step == 2;
                                            // Nessun filtro acceso: e' questo che «monitorati» vuol dire.
                                            active: root.report-step == 2
                                                && !root.report-only-selected
                                                && !root.report-only-excluded
                                                && !root.report-only-alerts
                                                && root.report-filter == "";
                                            clicked => {
                                                root.report-only-selected = false;
                                                root.report-only-excluded = false;
                                                root.report-only-alerts = false;
                                                root.report-filter = "";
                                                root.report-filter-contents();
                                            }
                                        }
                                        // L'unico contatore focale della
                                        // schermata: e' la cifra su cui si agisce.
                                        Counter {
                                            caption: @tr("selezionati");
                                            value: root.report-selected;
                                            focal: true;
                                            actionable: root.report-step == 2;
                                            active: root.report-only-selected;
                                            clicked => {
                                                root.report-only-selected = !root.report-only-selected;
                                                root.report-only-excluded = false;
                                                root.report-filter-contents();
                                            }
                                        }
                                        Counter {
                                            caption: @tr("non rappresentati");
                                            value: root.report-excluded;
                                            actionable: root.report-step == 2;
                                            active: root.report-only-excluded;
                                            clicked => {
                                                root.report-only-excluded = !root.report-only-excluded;
                                                root.report-only-selected = false;
                                                root.report-filter-contents();
                                            }
                                        }
                                        Counter {
                                            caption: @tr("con avviso");
                                            value: root.report-alerts;
                                            actionable: root.report-step == 2;
                                            active: root.report-only-alerts;
                                            clicked => {
                                                root.report-only-alerts = !root.report-only-alerts;
                                                root.report-filter-contents();
                                            }
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: Spacing.sm;
                                        vertical-stretch: 0;
                                        alignment: start;

                                        Text {
                                            text: @tr("LIVELLI");
                                            color: Palette.text-muted;
                                            font-family: Typography.mono;
                                            font-size: Typography.eyebrow;
                                            letter-spacing: Typography.track-eyebrow;
                                            vertical-alignment: center;
                                            horizontal-stretch: 0;
                                        }

                                        // La rampa colora il **bordo**, mai la
                                        // parola: il rosso del livello 4 sta sotto
                                        // la soglia di contrasto del testo
                                        // (DEC-137). Il numero del livello e'
                                        // scritto accanto, quindi il dato non
                                        // dipende mai dal colore soltanto.
                                        for value[index] in root.report-levels: Rectangle {
                                            height: 22px;
                                            horizontal-stretch: 0;
                                            border-radius: Spacing.radius-chip;
                                            border-width: Spacing.hairline;
                                            border-color: Palette.level-color(index);

                                            HorizontalLayout {
                                                padding-left: Spacing.xs;
                                                padding-right: Spacing.xs;
                                                Text {
                                                    text: @tr("L{} \u{00b7} {}", index, value);
                                                    color: Palette.text;
                                                    font-family: Typography.mono;
                                                    font-size: Typography.technical;
                                                    vertical-alignment: center;
                                                }
                                            }

                                            accessible-role: text;
                                            accessible-label: @tr("Livello {}: {}", index, (value == 1 ? @tr("1 contenuto") : @tr("{} contenuti", value)));
                                        }

                                        Text {
                                            text: @tr("\u{00b7}  esaminati {}  \u{00b7}  in attesa di una decisione {}", root.report-reviewed, root.report-pending);
                                            color: Palette.text-muted;
                                            font-size: Typography.group-label;
                                            vertical-alignment: center;
                                            horizontal-stretch: 0;
                                        }
                                    }
                                }
                            }

                            // LE RELAZIONI DELL'UFFICIO, quando questa postazione
                            // segue un Hub: cio' che si conserva altrove si
                            // mostra, altrimenti non si sa che esista.
                            if root.report-hub-message != "": Rectangle {
                                // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                min-height: rip-168.preferred-height;
                                rip-168 := VerticalLayout {
                                    spacing: Spacing.sm;

                                    Text {
                                        text: @tr("Le relazioni dell'ufficio");
                                        color: Palette.text;
                                        font-size: Typography.panel-title;
                                        font-weight: Typography.medium;
                                    }
                                    Text {
                                        text: root.report-hub-message;
                                        color: Palette.text-muted;
                                        font-size: Typography.body-secondary;
                                        wrap: word-wrap;
                                    }
                                    HorizontalLayout {
                                        spacing: Spacing.md;

                                        HudButton {
                                            label: @tr("Aggiorna dall'Hub");
                                            clicked => {
                                                root.report-hub-refresh();
                                            }
                                        }
                                        Rectangle { horizontal-stretch: 1; background: transparent; }
                                    }

                                    LegendaOrigini {
                                        calcolato: @tr("stato, conteggi e documenti");
                                        operatore: @tr("chi l'ha chiesta");
                                    }
                                    for relazione in root.report-hub-reports: Rectangle {
                                        background: Palette.panel-raised;
                                        border-radius: Spacing.radius-panel;
                                        vertical-stretch: 0;

                                        // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                        min-height: rip-169.preferred-height;
                                        rip-169 := VerticalLayout {
                                            padding: Spacing.lg;
                                            spacing: Spacing.xs;

                                            Text {
                                                text: relazione.report-id + " · " + relazione.state;
                                                color: Palette.text;
                                                font-size: Typography.body;
                                                font-weight: Typography.medium;
                                            }
                                            Text {
                                                text: relazione.who;
                                                color: Palette.text-muted;
                                                font-size: Typography.caption;
                                                wrap: word-wrap;
                                            }
                                            Text {
                                                text: relazione.counts;
                                                color: Palette.text-muted;
                                                font-size: Typography.caption;
                                                wrap: word-wrap;
                                            }
                                            if relazione.documents != "": Text {
                                                text: relazione.documents;
                                                color: Palette.text-muted;
                                                font-size: Typography.caption;
                                                wrap: word-wrap;
                                            }
                                        }
                                    }
                                }
                            }

                            if root.report-message != "" && root.report-failed: ErrorBanner {
                                message: root.report-message;
                            }
                            if root.report-message != "" && !root.report-failed: InfoBanner {
                                message: root.report-message;
                            }

                            // `vertical-stretch: 1` non e' decorativo: senza,
                            // l'area scorrevole chiede tutta l'altezza del
                            // proprio contenuto e spinge i comandi fuori dalla
                            // finestra, rendendo il percorso inutilizzabile.
                            HudScroll {
                                vertical-stretch: 1;

                                VerticalLayout {
                                    spacing: Spacing.sm;

                                    // ---------------------------- passo 1
                                    if root.report-step == 1: Rectangle {
                                        // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                        min-height: rip-170.preferred-height;
                                        rip-170 := VerticalLayout {
                                            spacing: Spacing.sm;
                                            // Senza, lo spazio in più dell'area scorrevole si
                                            // divide fra la legenda e il primo monitoraggio
                                            // (FINAL-PRODUCT-REVIEW-02).
                                            alignment: start;

                                            if root.report-sessions.length == 0: StateBlock {
                                                // `empty` e non `planned`: le
                                                // sessioni possono esistere, e la
                                                // schermata dice che cosa fare
                                                // perche' esistano.
                                                kind: StateKind.empty;
                                                subsystem: @tr("archivio dei monitoraggi");
                                                title: @tr("Nessun monitoraggio da documentare");
                                                message: @tr("Una relazione descrive un monitoraggio condotto. Avviarne uno dalla schermata «Nuovo monitoraggio»: al termine comparirà qui.");
                                            }

                                            LegendaOrigini {
                                                calcolato: @tr("orari, stato e conteggi");
                                                operatore: @tr("nome e operatore");
                                            }
                                            for entry in root.report-sessions: SelectableRow {
                                                selected: entry.chosen;
                                                name: @tr("{}, {}, operatore {}, {}{}{}", entry.label, entry.state, entry.operator, (entry.contents == 1 ? @tr("1 contenuto, ") : @tr("{} contenuti, ", entry.contents)), (entry.alerts == 1 ? @tr("1 avviso") : @tr("{} avvisi", entry.alerts)), (entry.chosen ? @tr(". Scelta") : ""));
                                                chosen => {
                                                    root.report-choose-session(entry.session-id);
                                                }

                                                VerticalLayout {
                                                    spacing: Spacing.xxs;
                                                    // Le righe stanno insieme in cima anche quando
                                                    // il monitoraggio è uno solo e la riga riceve
                                                    // tutto lo spazio dell'elenco.
                                                    alignment: start;

                                                    HorizontalLayout {
                                                        spacing: Spacing.sm;
                                                        vertical-stretch: 0;

                                                        // La scelta si legge da una
                                                        // FORMA e da una parola, mai
                                                        // da un carattere: quale
                                                        // segno di spunta esista
                                                        // dipende dal carattere
                                                        // installato, e questo
                                                        // prodotto ha gia' pagato
                                                        // quella lezione due volte —
                                                        // il comando di chiusura
                                                        // invisibile (DEC-140) e la
                                                        // freccia di `HudSelect`, che
                                                        // ora e' un tracciato.
                                                        Rectangle {
                                                            width: 14px;
                                                            horizontal-stretch: 0;
                                                            background: transparent;

                                                            Rectangle {
                                                                y: (parent.height - self.height) / 2;
                                                                width: 14px;
                                                                height: 14px;
                                                                border-radius: Spacing.xs;
                                                                border-width: Spacing.hairline;
                                                                border-color: entry.chosen
                                                                    ? Palette.frame
                                                                    : Palette.frame-dim;
                                                                background: entry.chosen
                                                                    ? Palette.frame-dim
                                                                    : transparent;

                                                                Rectangle {
                                                                    x: (parent.width - self.width) / 2;
                                                                    y: (parent.height - self.height) / 2;
                                                                    width: 6px;
                                                                    height: 6px;
                                                                    border-radius: 1px;
                                                                    background: entry.chosen
                                                                        ? Palette.cyan
                                                                        : transparent;
                                                                }
                                                            }
                                                        }
                                                        // Assorbe lo spazio in piu'.
                                                        // Senza, un `HorizontalLayout`
                                                        // in cui nessuno lo chiede lo
                                                        // divide in parti uguali, e la
                                                        // targhetta dello stato si
                                                        // allarga per mezza riga.
                                                        Text {
                                                            text: entry.label;
                                                            color: Palette.text;
                                                            font-size: Typography.body;
                                                            font-weight: Typography.medium;
                                                            horizontal-stretch: 1;
                                                            overflow: elide;
                                                        }
                                                        StatusBadge {
                                                            label: entry.state;
                                                            tone: Tone.neutral;
                                                        }
                                                    }

                                                    // Va a capo (UX-EXCELLENCE-02): con l'ora locale e
                                                    // l'UTC accanto la riga e' piu' lunga, e senza a capo
                                                    // spingeva lo stato fuori dal bordo destro.
                                                    Text {
                                                        text: entry.started + "  \u{00b7}  " + entry.ended;
                                                        color: Palette.text-muted;
                                                        font-family: Typography.mono;
                                                        font-size: Typography.technical;
                                                        wrap: word-wrap;
                                                    }
                                                    Text {
                                                        text: @tr("Operatore {}  \u{00b7}  fonti: {}", entry.operator, entry.sources);
                                                        color: Palette.text-muted;
                                                        font-size: Typography.group-label;
                                                        wrap: word-wrap;
                                                        overflow: elide;
                                                    }
                                                    Text {
                                                        // Concordato col numero (SIM3-17: «1 contenuti acquisiti»).
                                                        text: @tr("{} \u{00b7} {} con avviso", (entry.contents == 1 ? @tr("1 contenuto acquisito") : @tr("{} contenuti acquisiti", entry.contents)), entry.alerts);
                                                        color: Palette.text-muted;
                                                        font-size: Typography.group-label;
                                                    }
                                                }
                                            }

                                            // IL RAPPORTO COMPLESSIVO (REPORT-MULTI-01, ADR-0192):
                                            // un documento a sé, del responsabile che si nomina qui.
                                            if root.report-sessions.length >= 2: Rectangle {
                                                // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                                min-height: rip-201.preferred-height;
                                                rip-201 := VerticalLayout {
                                                    spacing: Spacing.sm;
                                                    Text {
                                                        text: @tr("Rapporto complessivo su più monitoraggi");
                                                        color: Palette.text;
                                                        font-size: Typography.body;
                                                    }
                                                    Text {
                                                        text: @tr("Un documento a sé: per ogni monitoraggio scelto dice chi lo ha avviato, il periodo, che cosa si è guardato e le relazioni prodotte. Non contiene i testi dei messaggi e tiene separati i numeri. Ne risponde la persona scritta qui sotto.");
                                                        color: Palette.text-muted;
                                                        font-size: Typography.body-secondary;
                                                        wrap: word-wrap;
                                                    }
                                                    LegendaOrigini {
                                                        operatore: @tr("nome del monitoraggio");
                                                    }
                                                    for riga in root.overview-rows: HudCheck {
                                                        text: riga.label;
                                                        checked: riga.chosen;
                                                        toggled => {
                                                            root.overview-toggle(riga.session-id);
                                                        }
                                                    }
                                                    // A schermo il campo non ha nome se non è scritto
                                                    // sopra: l'etichetta è per chi ascolta (INTEGRATION-01).
                                                    Text {
                                                        text: @tr("Responsabile del documento");
                                                        color: Palette.text-muted;
                                                        font-size: Typography.body-secondary;
                                                    }
                                                    HudInput {
                                                        label: @tr("Responsabile del documento");
                                                        value <=> root.overview-name;
                                                    }
                                                    Text {
                                                        text: @tr("Qualifica del responsabile");
                                                        color: Palette.text-muted;
                                                        font-size: Typography.body-secondary;
                                                    }
                                                    HudInput {
                                                        label: @tr("Qualifica del responsabile");
                                                        value <=> root.overview-role;
                                                    }
                                                    HudButton {
                                                        label: @tr("Produci il rapporto complessivo");
                                                        clicked => {
                                                            root.overview-generate();
                                                        }
                                                    }
                                                    if root.overview-message != "": Text {
                                                        text: root.overview-message;
                                                        color: Palette.text-muted;
                                                        font-size: Typography.body-secondary;
                                                        wrap: word-wrap;
                                                    }
                                                }
                                            }
                                        }
                                    }

                                    // ---------------------------- passo 2
                                    if root.report-step == 2: VerticalLayout {
                                        spacing: Spacing.sm;

                                        HorizontalLayout {
                                            spacing: Spacing.md;
                                            vertical-stretch: 0;

                                            HudInput {
                                                label: @tr("Cerca fra i contenuti del monitoraggio");
                                                placeholder: @tr("Cerca nel testo, nella fonte o nei termini");
                                                value <=> root.report-filter;
                                                edited => {
                                                    root.report-filter-contents();
                                                }
                                            }
                                            HudButton {
                                                label: root.report-only-selected ? @tr("Solo i selezionati \u{2713}") : @tr("Solo i selezionati");
                                                clicked => {
                                                    root.report-only-selected = !root.report-only-selected;
                                                    // I due si escludono: accesi
                                                    // insieme darebbero sempre un
                                                    // elenco vuoto.
                                                    root.report-only-excluded = false;
                                                    root.report-filter-contents();
                                                }
                                            }
                                            HudButton {
                                                label: root.report-only-alerts ? @tr("Solo con avviso \u{2713}") : @tr("Solo con avviso");
                                                clicked => {
                                                    root.report-only-alerts = !root.report-only-alerts;
                                                    root.report-filter-contents();
                                                }
                                            }
                                        }

                                        HorizontalLayout {
                                            spacing: Spacing.md;
                                            vertical-stretch: 0;

                                            Text {
                                                text: root.report-visible-note;
                                                color: Palette.text-muted;
                                                font-size: Typography.group-label;
                                                vertical-alignment: center;
                                                wrap: word-wrap;
                                            }
                                            // Selezione di gruppo, e **solo**
                                            // premendo: agisce sulle righe che
                                            // si vedono, e il conteggio qui
                                            // accanto dice quante sono.
                                            HudButton {
                                                label: @tr("Seleziona i visibili");
                                                enabled: root.report-contents.length > 0;
                                                reason: root.report-contents.length == 0 ? @tr("Nessun contenuto da selezionare con il filtro corrente.") : "";
                                                clicked => {
                                                    root.report-select-visible();
                                                }
                                            }
                                            HudButton {
                                                label: @tr("Azzera la selezione");
                                                enabled: root.report-selected > 0;
                                                reason: root.report-selected == 0 ? @tr("Nessun contenuto è selezionato.") : "";
                                                clicked => {
                                                    root.report-clear-selection();
                                                }
                                            }
                                        }

                                        if root.report-total == 0: StateBlock {
                                            kind: StateKind.empty;
                                            subsystem: @tr("contenuti del monitoraggio");
                                            title: @tr("Questo monitoraggio non ha acquisito contenuti");
                                            message: @tr("La relazione si produce ugualmente e descriverà l'attività svolta.");
                                        }

                                        if root.report-total > 0 && root.report-contents.length == 0: StateBlock {
                                            kind: StateKind.empty;
                                            subsystem: @tr("filtro");
                                            title: @tr("Nessun contenuto corrisponde alla ricerca");
                                            message: @tr("Il filtro non tocca la selezione: ciò che è stato scelto resta scelto anche mentre non si vede.");
                                        }

                                        LegendaOrigini {
                                            osservato: @tr("fonte, data, testo, collegamento");
                                            calcolato: @tr("livello e avviso");
                                            operatore: @tr("revisione");
                                        }
                                        for row in root.report-contents: SelectableRow {
                                            selected: row.chosen;
                                            // Letta in una volta sola, con la
                                            // scelta detta a parole: chi
                                            // ascolta la schermata non vede il
                                            // tono di fondo.
                                            name: (row.chosen ? @tr("Selezionato per la relazione. ") : @tr("Non selezionato. ")) + row.source + ", " + row.published + ", " + row.level-label + ", " + row.review-state + (row.alert ? @tr(", con avviso") : @tr(", senza avviso")) + ", " + row.link;
                                            chosen => {
                                                root.report-toggle-content(row.content-id);
                                            }

                                            // Binario di livello: alto quanto
                                            // il livello, non solo colorato.
                                            Rectangle {
                                                width: 4px;
                                                horizontal-stretch: 0;
                                                border-radius: Spacing.radius-row;
                                                background: Palette.line-divider;

                                                Rectangle {
                                                    y: parent.height - self.height;
                                                    width: 4px;
                                                    height: parent.height * (row.level / 4);
                                                    border-radius: Spacing.radius-row;
                                                    background: Palette.level-color(row.level);
                                                }
                                            }

                                            VerticalLayout {
                                                spacing: Spacing.xxs;

                                                HorizontalLayout {
                                                    spacing: Spacing.sm;
                                                    vertical-stretch: 0;

                                                    // Il segno della scelta, e
                                                    // vale ciò che è scritto
                                                    // sulla riga della sessione:
                                                    // è una forma disegnata, non
                                                    // un carattere che il font
                                                    // potrebbe non avere.
                                                    Rectangle {
                                                        width: 14px;
                                                        horizontal-stretch: 0;
                                                        background: transparent;

                                                        Rectangle {
                                                            y: (parent.height - self.height) / 2;
                                                            width: 14px;
                                                            height: 14px;
                                                            border-radius: Spacing.xs;
                                                            border-width: Spacing.hairline;
                                                            border-color: row.chosen
                                                                ? Palette.frame
                                                                : Palette.frame-dim;
                                                            background: row.chosen
                                                                ? Palette.frame-dim
                                                                : transparent;

                                                            Rectangle {
                                                                x: (parent.width - self.width) / 2;
                                                                y: (parent.height - self.height) / 2;
                                                                width: 6px;
                                                                height: 6px;
                                                                border-radius: 1px;
                                                                background: row.chosen
                                                                    ? Palette.cyan
                                                                    : transparent;
                                                            }
                                                        }
                                                    }
                                                    Text {
                                                        text: row.chosen ? @tr("nella relazione") : @tr("non rappresentato");
                                                        color: row.chosen
                                                            ? Palette.text
                                                            : Palette.text-muted;
                                                        font-size: Typography.group-label;
                                                        font-weight: row.chosen
                                                            ? Typography.medium
                                                            : Typography.regular;
                                                        horizontal-stretch: 0;
                                                        vertical-alignment: center;
                                                    }
                                                    // Assorbe lo spazio in piu':
                                                    // vedere la riga della
                                                    // sessione qui sopra.
                                                    Text {
                                                        text: row.source;
                                                        color: Palette.text;
                                                        font-size: Typography.body;
                                                        horizontal-stretch: 1;
                                                        overflow: elide;
                                                    }
                                                    Text {
                                                        text: row.published;
                                                        color: Palette.text-muted;
                                                        font-family: Typography.mono;
                                                        font-size: Typography.technical;
                                                        horizontal-stretch: 0;
                                                    }
                                                }

                                                HorizontalLayout {
                                                    spacing: Spacing.sm;
                                                    vertical-stretch: 0;

                                                    // Targhetta del livello: il
                                                    // colore vive nel bordo, il
                                                    // nome resta scritto.
                                                    Rectangle {
                                                        horizontal-stretch: 0;
                                                        border-radius: Spacing.radius-chip;
                                                        border-width: Spacing.hairline;
                                                        border-color: Palette.level-color(row.level);

                                                        HorizontalLayout {
                                                            padding-left: Spacing.xxs;
                                                            padding-right: Spacing.xxs;
                                                            Text {
                                                                text: row.level-label;
                                                                color: Palette.text;
                                                                font-family: Typography.mono;
                                                                font-size: Typography.technical;
                                                                vertical-alignment: center;
                                                            }
                                                        }
                                                    }
                                                    Text {
                                                        text: row.review-state;
                                                        color: Palette.text-muted;
                                                        font-size: Typography.group-label;
                                                        horizontal-stretch: 0;
                                                    }
                                                    if row.alert: Text {
                                                        text: @tr("con avviso");
                                                        color: Palette.text-muted;
                                                        font-size: Typography.group-label;
                                                        horizontal-stretch: 0;
                                                    }
                                                    Text {
                                                        text: row.link;
                                                        color: Palette.text-muted;
                                                        font-size: Typography.group-label;
                                                        horizontal-stretch: 0;
                                                    }
                                                    Rectangle { }
                                                }

                                                Text {
                                                    text: row.excerpt;
                                                    color: Palette.text-muted;
                                                    font-size: Typography.body-secondary;
                                                    wrap: word-wrap;
                                                    overflow: elide;
                                                    vertical-stretch: 1;
                                                }
                                            }
                                        }
                                    }

                                    // ---------------------------- passo 3
                                    if root.report-step == 3: Rectangle {
                                        // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                        min-height: rip-171.preferred-height;
                                        rip-171 := VerticalLayout {
                                            spacing: Spacing.md;

                                            Text {
                                                text: root.report-profile-note;
                                                color: Palette.text-muted;
                                                font-size: Typography.body-secondary;
                                                wrap: word-wrap;
                                            }

                                            HorizontalLayout {
                                                spacing: Spacing.md;
                                                vertical-stretch: 0;
                                                // Stessa larghezza per i due campi
                                                // affiancati: senza, la divisione
                                                // in parti uguali dello spazio in
                                                // piu' li lascia disallineati,
                                                // perche' le due etichette hanno
                                                // larghezze diverse.
                                                TextField {
                                                    horizontal-stretch: 1;
                                                    label: @tr("Denominazione dell'organizzazione");
                                                    placeholder: @tr("Lasciare vuoto se non va stampata");
                                                    value <=> root.report-organisation;
                                                    edited => {
                                                        root.report-fields-edited();
                                                    }
                                                }
                                                TextField {
                                                    horizontal-stretch: 1;
                                                    label: @tr("Ufficio o articolazione");
                                                    placeholder: @tr("Lasciare vuoto se non va stampato");
                                                    value <=> root.report-office;
                                                    edited => {
                                                        root.report-fields-edited();
                                                    }
                                                }
                                            }

                                            // LA TERZA RIGA DELL'INTESTAZIONE (CU01-008): veniva
                                            // dal profilo e si stampava senza comparire qui.
                                            TextField {
                                                label: @tr("Sede, indirizzo e recapiti");
                                                placeholder: @tr("Terza riga dell'intestazione");
                                                value <=> root.report-premises;
                                                edited => {
                                                    root.report-fields-edited();
                                                }
                                            }

                                            HorizontalLayout {
                                                spacing: Spacing.md;
                                                vertical-stretch: 0;
                                                TextField {
                                                    horizontal-stretch: 1;
                                                    label: @tr("Destinatario");
                                                    placeholder: @tr("A chi la relazione è indirizzata");
                                                    value <=> root.report-recipient;
                                                    edited => {
                                                        root.report-fields-edited();
                                                    }
                                                }
                                                TextField {
                                                    horizontal-stretch: 1;
                                                    label: @tr("E, per conoscenza");
                                                    placeholder: @tr("Facoltativo");
                                                    value <=> root.report-recipient-cc;
                                                    edited => {
                                                        root.report-fields-edited();
                                                    }
                                                }
                                            }

                                            TextField {
                                                label: @tr("Oggetto");
                                                placeholder: @tr("Il documento vi aggiunge il nome del monitoraggio");
                                                value <=> root.report-subject;
                                                edited => {
                                                    root.report-fields-edited();
                                                }
                                            }

                                            HorizontalLayout {
                                                spacing: Spacing.md;
                                                vertical-stretch: 0;
                                                TextField {
                                                    horizontal-stretch: 1;
                                                    label: @tr("Luogo");
                                                    placeholder: @tr("Compare accanto alla data");
                                                    value <=> root.report-place;
                                                    edited => {
                                                        root.report-fields-edited();
                                                    }
                                                }
                                                TextField {
                                                    horizontal-stretch: 1;
                                                    label: @tr("Qualifica di chi sottoscrive");
                                                    placeholder: @tr("Facoltativa");
                                                    value <=> root.report-role;
                                                    edited => {
                                                        root.report-fields-edited();
                                                    }
                                                }
                                            }

                                            TextField {
                                                label: @tr("Nome di chi sottoscrive");
                                                placeholder: @tr("Compare in calce, sotto la qualifica");
                                                value <=> root.report-signer;
                                                edited => {
                                                    root.report-fields-edited();
                                                }
                                            }

                                            // Lo stemma dell'ufficio: un file
                                            // **locale**, mai scaricato dalla rete.
                                            VerticalLayout {
                                                spacing: Spacing.xs;
                                                vertical-stretch: 0;

                                                Text {
                                                    text: @tr("Stemma dell'ufficio");
                                                    color: Palette.text-muted;
                                                    font-size: Typography.group-label;
                                                    font-weight: Typography.medium;
                                                    vertical-stretch: 0;
                                                }
                                                Text {
                                                    text: root.report-emblem != "" ? root.report-emblem : @tr("Nessuno scelto: l'intestazione lascerà lo spazio vuoto.");
                                                    color: root.report-emblem != ""
                                                        ? Palette.text
                                                        : Palette.text-muted;
                                                    font-size: Typography.body-secondary;
                                                    vertical-stretch: 0;
                                                    wrap: word-wrap;
                                                }

                                                HorizontalLayout {
                                                    spacing: Spacing.md;
                                                    vertical-stretch: 0;
                                                    alignment: start;

                                                    HudButton {
                                                        label: @tr("Scegli lo stemma\u{2026}");
                                                        clicked => {
                                                            root.report-choose-emblem();
                                                        }
                                                    }
                                                    HudButton {
                                                        label: @tr("Togli lo stemma");
                                                        enabled: root.report-emblem != "";
                                                        reason: root.report-emblem == "" ? @tr("Nessuno stemma è stato scelto.") : "";
                                                        clicked => {
                                                            root.report-clear-emblem();
                                                        }
                                                    }
                                                }
                                            }

                                            TextField {
                                                label: @tr("Riga di piè di pagina");
                                                placeholder: @tr("Facoltativa");
                                                value <=> root.report-footer;
                                                edited => {
                                                    root.report-fields-edited();
                                                }
                                            }
                                        }
                                    }

                                    // ---------------------------- passo 4
                                    if root.report-step == 4: Rectangle {
                                        // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                        min-height: rip-172.preferred-height;
                                        rip-172 := VerticalLayout {
                                            spacing: Spacing.sm;

                                            // QUESTA RIGA NON E' UN ABBELLIMENTO.
                                            //
                                            // Il 2026-08-19, durante il pilot,
                                            // l'operatore si e' fermato qui: una
                                            // schermata intitolata «Formati», fatta di
                                            // righe con un contrassegno accanto, si
                                            // legge come un elenco da spuntare. Non lo
                                            // e': i formati producibili si producono
                                            // tutti, e la schermata dichiara che cosa
                                            // uscira'.
                                            //
                                            // Una schermata che sembra chiedere una
                                            // scelta e non la accetta ferma chi la usa
                                            // esattamente come un comando guasto.
                                            Text {
                                                text: @tr("Questi sono i documenti che il pacchetto conterrà. Non c'è nulla da scegliere: si producono tutti quelli disponibili. Le righe spente dichiarano ciò che non è ancora costruito, invece di nasconderlo.");
                                                color: Palette.text-muted;
                                                font-size: Typography.body-secondary;
                                                wrap: word-wrap;
                                            }

                                            for format in root.report-formats: Rectangle {
                                                height: 78px;
                                                background: Palette.panel-raised;
                                                border-radius: Spacing.radius-row;
                                                border-width: Spacing.hairline;
                                                border-color: Palette.line-divider;

                                                HorizontalLayout {
                                                    padding: Spacing.lg;
                                                    spacing: Spacing.md;

                                                    VerticalLayout {
                                                        spacing: Spacing.xxs;
                                                        horizontal-stretch: 1;
                                                        Text {
                                                            text: format.label;
                                                            color: format.available
                                                                ? Palette.text
                                                                : Palette.text-disabled;
                                                            font-size: Typography.body;
                                                            font-weight: Typography.medium;
                                                        }
                                                        Text {
                                                            text: format.note;
                                                            color: Palette.text-muted;
                                                            font-size: Typography.group-label;
                                                            wrap: word-wrap;
                                                        }
                                                    }

                                                    StatusBadge {
                                                        label: format.available ? @tr("IN QUESTO PACCHETTO") : @tr("NON DISPONIBILE");
                                                        tone: format.available
                                                            ? Tone.success
                                                            : Tone.neutral;
                                                    }
                                                }

                                                accessible-role: text;
                                                accessible-label: format.label + ": " + (format.available ? @tr("prodotto in questo pacchetto") : @tr("non disponibile")) + ". " + format.note;
                                            }
                                        }
                                    }

                                    // ---------------------------- passo 5
                                    if root.report-step == 5: Rectangle {
                                        // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                        min-height: rip-173.preferred-height;
                                        rip-173 := VerticalLayout {
                                            spacing: Spacing.sm;

                                            Text {
                                                text: root.report-outcome-label;
                                                color: Palette.text;
                                                font-size: Typography.body;
                                                wrap: word-wrap;
                                            }

                                            LegendaOrigini {
                                                calcolato: @tr("valori");
                                            }
                                            for row in root.report-preview: ListRow {
                                                Text {
                                                    text: row.label;
                                                    color: Palette.text-muted;
                                                    font-size: Typography.group-label;
                                                    width: 260px;
                                                    horizontal-stretch: 0;
                                                    wrap: word-wrap;
                                                }
                                                Text {
                                                    text: row.value;
                                                    color: Palette.text;
                                                    font-size: Typography.body-secondary;
                                                    horizontal-stretch: 1;
                                                    wrap: word-wrap;
                                                }

                                                accessible-role: text;
                                                accessible-label: row.label + ": " + row.value;
                                            }
                                        }
                                    }

                                    // ---------------------------- passo 6
                                    if root.report-step == 6: Rectangle {
                                        // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                        min-height: rip-174.preferred-height;
                                        rip-174 := VerticalLayout {
                                            spacing: Spacing.md;

                                            VerticalLayout {
                                                spacing: Spacing.xs;
                                                vertical-stretch: 0;
                                                // `vertical-stretch: 0` su ognuna,
                                                // e non solo sul contenitore: un
                                                // layout in cui nessun figlio
                                                // chiede spazio lo divide fra tutti
                                                // in parti uguali, e l'etichetta si
                                                // ritrova a duecento pixel dal
                                                // proprio valore.
                                                Text {
                                                    text: @tr("Cartella di destinazione");
                                                    color: Palette.text-muted;
                                                    font-size: Typography.group-label;
                                                    font-weight: Typography.medium;
                                                    vertical-stretch: 0;
                                                }
                                                // Il percorso si mostra e non si
                                                // digita: una cartella scelta da
                                                // una finestra di sistema esiste
                                                // per costruzione (DEC-113).
                                                Text {
                                                    text: root.report-destination != "" ? root.report-destination : @tr("Nessuna cartella scelta.");
                                                    color: root.report-destination != ""
                                                        ? Palette.text
                                                        : Palette.text-muted;
                                                    font-family: Typography.mono;
                                                    font-size: Typography.technical;
                                                    vertical-stretch: 0;
                                                    wrap: word-wrap;
                                                }

                                                // Su una condivisione di rete il
                                                // prodotto non sa chi potra'
                                                // leggere i documenti (ADR-0041).
                                                // Non impedisce la scelta: e' il
                                                // modo normale di consegnare un
                                                // atto. Lo dice e basta.
                                                if root.report-destination-caution != "": Text {
                                                    text: root.report-destination-caution;
                                                    color: Palette.amber;
                                                    font-size: Typography.body-secondary;
                                                    vertical-stretch: 0;
                                                    wrap: word-wrap;
                                                }
                                            }

                                            // I COLLEGAMENTI DEI CONTENUTI SCELTI, se
                                            // l'operatore li vuole (ADR-0165): si
                                            // chiedono a Telegram al momento, e non
                                            // entrano nell'archivio.
                                            HudCheck {
                                                text: @tr("Chiedi a Telegram il collegamento dei contenuti scelti, al più 20");
                                                description: @tr("Ciascun collegamento dice nel documento che l'ha fornito Telegram e quando. Serve l'account collegato.");
                                                checked <=> root.report-ask-links;
                                                enabled: !root.report-busy;
                                            }
                                            // LA FIRMA DELL'UFFICIO (ADR-0181, decisione 7),
                                            // soltanto con un certificato scelto.
                                            if root.signing-available: HudCheck {
                                                text: @tr("Firma con il certificato dell'ufficio");
                                                description: @tr("Firma l'elenco delle impronte del pacchetto e fa una copia firmata di ogni PDF. La firma la fa Windows.");
                                                checked <=> root.report-sign;
                                                enabled: !root.report-busy;
                                            }
                                            HorizontalLayout {
                                                spacing: Spacing.md;
                                                vertical-stretch: 0;
                                                alignment: start;

                                                HudButton {
                                                    label: @tr("Scegli la cartella\u{2026}");
                                                    enabled: !root.report-busy;
                                                    reason: root.report-busy ? @tr("Generazione in corso.") : "";
                                                    clicked => {
                                                        root.report-choose-destination();
                                                    }
                                                }
                                                HudButton {
                                                    label: @tr("Genera la relazione");
                                                    weight: Weight.primary;
                                                    // Spento durante la
                                                    // generazione: il backend non
                                                    // sostiene due generazioni
                                                    // insieme, e due clic
                                                    // produrrebbero due pacchetti
                                                    // di cui uno mai chiesto.
                                                    enabled: root.report-can-generate && !root.report-busy;
                                                    reason: root.report-busy ? @tr("Generazione già in corso.") : root.report-blocking-reason;
                                                    clicked => {
                                                        root.report-generate();
                                                    }
                                                }
                                            }

                                            if root.report-busy: StateBlock {
                                                kind: StateKind.loading;
                                                subsystem: @tr("generazione della relazione");
                                                title: @tr("Composizione del documento in corso");
                                                // Nessuna barra: non esiste un
                                                // avanzamento misurabile, e
                                                // inventarne uno sarebbe una bugia
                                                // che si muove.
                                                message: @tr("L'elenco delle impronte viene scritto per ultimo: finché non c'è, il pacchetto non è completo.");
                                            }

                                            // Assorbe l'altezza che avanza, cosi'
                                            // che il resto del passo resti in alto.
                                            Rectangle { }
                                        }
                                    }

                                    // ---------------------------- passo 7
                                    if root.report-step == 7: Rectangle {
                                        // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                        min-height: rip-175.preferred-height;
                                        rip-175 := VerticalLayout {
                                            spacing: Spacing.md;

                                            if !root.report-completed: StateBlock {
                                                kind: StateKind.error;
                                                subsystem: @tr("generazione della relazione");
                                                title: @tr("Il pacchetto non è stato prodotto");
                                                message: root.report-message;
                                            }

                                            if root.report-completed: Rectangle {
                                                // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                                                min-height: rip-176.preferred-height;
                                                rip-176 := VerticalLayout {
                                                    spacing: Spacing.sm;
                                                    vertical-stretch: 0;

                                                    HorizontalLayout {
                                                        spacing: Spacing.md;
                                                        vertical-stretch: 0;
                                                        alignment: start;
                                                        Text {
                                                            text: root.report-identifier;
                                                            color: Palette.text;
                                                            font-family: Typography.mono;
                                                            font-size: Typography.panel-title;
                                                            vertical-alignment: center;
                                                            horizontal-stretch: 0;
                                                        }
                                                        StatusBadge {
                                                            label: root.report-status;
                                                            tone: Tone.success;
                                                        }
                                                    }

                                                    // `vertical-stretch: 0` su ognuna:
                                                    // un layout in cui nessun figlio
                                                    // chiede spazio lo divide fra tutti
                                                    // in parti uguali, e le tre righe
                                                    // dell'esito si allontanano l'una
                                                    // dall'altra invece di stare
                                                    // insieme.
                                                    // DOVE SI TROVA, DETTO IN CHIARO
                                                    // (OPERATOR-UX-REMEDIATION-01, OS-11):
                                                    // il percorso era scritto in piccolo,
                                                    // senza dire che cosa fosse.
                                                    Text {
                                                        text: @tr("Salvata nella cartella:");
                                                        color: Palette.text;
                                                        font-size: Typography.body-secondary;
                                                        vertical-stretch: 0;
                                                    }
                                                    Text {
                                                        text: root.report-folder;
                                                        color: Palette.text;
                                                        font-size: Typography.body-secondary;
                                                        vertical-stretch: 0;
                                                        wrap: word-wrap;
                                                    }
                                                    // «APRI LA CARTELLA» (UX-EXCELLENCE-02, SIM3-03,
                                                    // ADR-0137). Prima c'era «Per aprirla: Esplora
                                                    // file, poi la cartella scritta qui sopra»: la
                                                    // cartella predefinita sta sotto AppData, che
                                                    // Esplora file nasconde, e tre simulazioni su
                                                    // tre non ci sono arrivate. Il percorso resta
                                                    // scritto, per chi lo deve dettare a qualcuno.
                                                    HorizontalLayout {
                                                        spacing: Spacing.md;
                                                        vertical-stretch: 0;
                                                        alignment: start;
                                                        HudButton {
                                                            label: @tr("Apri la cartella");
                                                            weight: Weight.primary;
                                                            clicked => {
                                                                root.report-open-folder();
                                                            }
                                                        }
                                                    }
                                                    if root.report-folder-message != "": Text {
                                                        text: root.report-folder-message;
                                                        color: Palette.amber;
                                                        font-size: Typography.body-secondary;
                                                        vertical-stretch: 0;
                                                        wrap: word-wrap;
                                                    }
                                                    Text {
                                                        text: root.report-manifest-state;
                                                        color: Palette.text;
                                                        font-size: Typography.body-secondary;
                                                        vertical-stretch: 0;
                                                        wrap: word-wrap;
                                                    }
                                                    if root.report-warning != "": Text {
                                                        text: root.report-warning;
                                                        color: Palette.amber;
                                                        font-size: Typography.body-secondary;
                                                        vertical-stretch: 0;
                                                        wrap: word-wrap;
                                                    }
                                                    // LA COPIA CIFRATA PER CHI RICEVE (ENCRYPT-02,
                                                    // ADR-0190): prima il certificato, mostrato per
                                                    // il confronto; poi, soltanto allora, la cifratura.
                                                    HorizontalLayout {
                                                        spacing: Spacing.md;
                                                        vertical-stretch: 0;
                                                        alignment: start;
                                                        HudButton {
                                                            label: @tr("Copia cifrata per chi riceve…");
                                                            clicked => {
                                                                root.recipient-choose();
                                                            }
                                                        }
                                                        if root.recipient-ready: HudButton {
                                                            label: @tr("Cifra per questo certificato");
                                                            weight: Weight.primary;
                                                            clicked => {
                                                                root.recipient-encrypt("report");
                                                            }
                                                        }
                                                    }
                                                    if root.recipient-line != "": Text {
                                                        text: root.recipient-line;
                                                        color: Palette.text;
                                                        font-size: Typography.body-secondary;
                                                        vertical-stretch: 0;
                                                        wrap: word-wrap;
                                                    }
                                                    if root.recipient-message != "": Text {
                                                        text: root.recipient-message;
                                                        color: Palette.text;
                                                        font-size: Typography.body-secondary;
                                                        vertical-stretch: 0;
                                                        wrap: word-wrap;
                                                    }
                                                }
                                            }

                                            LegendaOrigini {
                                                calcolato: @tr("file prodotti, dimensione e impronta");
                                            }
                                            for artifact in root.report-artifacts: Rectangle {
                                                height: 92px;
                                                background: Palette.panel-raised;
                                                border-radius: Spacing.radius-row;
                                                border-width: Spacing.hairline;
                                                border-color: Palette.line-divider;

                                                VerticalLayout {
                                                    padding: Spacing.lg;
                                                    spacing: Spacing.xxs;

                                                    HorizontalLayout {
                                                        spacing: Spacing.sm;
                                                        vertical-stretch: 0;
                                                        Text {
                                                            text: artifact.name;
                                                            color: Palette.text;
                                                            font-size: Typography.body;
                                                            horizontal-stretch: 1;
                                                            overflow: elide;
                                                        }
                                                        Text {
                                                            text: artifact.size;
                                                            color: Palette.text-muted;
                                                            font-family: Typography.mono;
                                                            font-size: Typography.technical;
                                                            horizontal-stretch: 0;
                                                        }
                                                    }
                                                    Text {
                                                        text: artifact.kind;
                                                        color: Palette.text-muted;
                                                        font-size: Typography.group-label;
                                                    }
                                                    Text {
                                                        text: @tr("Impronta {}", artifact.sha256);
                                                        color: Palette.text-muted;
                                                        font-family: Typography.mono;
                                                        font-size: Typography.technical;
                                                        overflow: elide;
                                                    }
                                                }

                                                accessible-role: text;
                                                accessible-label: artifact.name + ", " + artifact.kind + ", " + artifact.size;
                                            }

                                            // Assorbe l'altezza che avanza, cosi'
                                            // che l'esito resti in alto.
                                            Rectangle { }
                                        }
                                    }
                                }
                            }

                            // Comandi del percorso. Restano in fondo e sempre
                            // negli stessi punti: un comando che si sposta di
                            // passo in passo si cerca ogni volta.
                            HorizontalLayout {
                                spacing: Spacing.md;
                                vertical-stretch: 0;

                                HudButton {
                                    label: @tr("Indietro");
                                    enabled: root.report-can-go-back && !root.report-busy;
                                    reason: root.report-busy ? @tr("Generazione in corso.") : (root.report-can-go-back ? "" : @tr("Questo è il primo passo."));
                                    clicked => {
                                        root.report-back();
                                    }
                                }

                                Rectangle { }

                                HudButton {
                                    label: @tr("Ricomincia");
                                    enabled: !root.report-busy;
                                    reason: root.report-busy ? @tr("Generazione in corso.") : "";
                                    clicked => {
                                        root.report-restart();
                                    }
                                }

                                HudButton {
                                    label: root.report-step == 7 ? @tr("Nuova relazione") : @tr("Avanti");
                                    weight: root.report-step == 7
                                        ? Weight.secondary
                                        : Weight.primary;
                                    enabled: root.report-can-advance && !root.report-busy;
                                    reason: root.report-busy ? @tr("Generazione in corso.") : (root.report-can-advance ? "" : root.report-blocking-reason);
                                    clicked => {
                                        root.report-advance();
                                    }
                                }
                            }
                        }
                    }

                    // ------------------------------------ Informazioni e licenze
                    if root.current-page == 1: Rectangle {
                        // Comparsa graduale della pagina: vedere la pagina 0 per il
                        // perche' la dissolvenza sia solo in entrata.
                        property <bool> entered: false;
                        opacity: 0.0;
                        init => {
                            self.entered = true;
                        }
                        animate opacity {
                            duration: Motion.transition-effective;
                            easing: cubic-bezier(0.16, 1, 0.3, 1);
                        }
        states [
            shown when self.entered: {
                opacity: 1.0;
            }
        ]
                        background: Palette.panel;
                        border-radius: Spacing.radius-panel;

                        HudScroll {
                            VerticalLayout {
                                padding: 24px;
                                spacing: 16px;

                                Text {
                                    text: @tr("Informazioni e licenze");
                                    color: Palette.text;
                                    font-size: 22px;
                                    font-weight: 700;
                                }

                                Text {
                                    text: @tr("{}, versione {}", root.product-name, root.app-version);
                                    color: Palette.text;
                                    font-size: 15px;
                                    font-weight: 600;
                                }

                                Text {
                                    text: root.attribution;
                                    color: Palette.text-muted;
                                    font-size: 14px;
                                    wrap: word-wrap;
                                }

                                Text {
                                    text: @tr("Licenza del prodotto: {}. Il testo integrale è nel file LICENSE distribuito con l'applicazione. Software libero: si può usare, modificare e ridistribuire alle condizioni della licenza. È pensato per il monitoraggio autorizzato.", root.product-license);
                                    color: Palette.text-muted;
                                    font-size: 14px;
                                    wrap: word-wrap;
                                }

                                Rectangle {
                                    height: 1px;
                                    vertical-stretch: 0;
                                    background: Palette.panel-raised;
                                }

                                Text {
                                    text: @tr("Componenti di terze parti");
                                    color: Palette.text;
                                    font-size: 17px;
                                    font-weight: 700;
                                }

                                Text {
                                    text: @tr("Questa applicazione incorpora componenti di terze parti, ciascuno distribuito secondo la propria licenza. L'elenco che segue è generato dal codice dell'applicazione.");
                                    color: Palette.text-muted;
                                    font-size: 13px;
                                    wrap: word-wrap;
                                }

                                // `ListRow`: riga non interattiva. L'elenco dei
                                // componenti di terze parti si legge, non si sceglie -
                                // renderlo selezionabile prometterebbe un'azione che non
                                // esiste.
                                for entry in root.third-party-components: ListRow {
                                    VerticalLayout {
                                        spacing: 4px;

                                        Text {
                                            text: entry.component + " " + entry.version;
                                            color: Palette.text;
                                            font-size: 14px;
                                            font-weight: 600;
                                        }
                                        Text {
                                            text: entry.license;
                                            color: Palette.cyan;
                                            font-size: 13px;
                                        }
                                        Text {
                                            text: entry.note;
                                            color: Palette.text-muted;
                                            font-size: 13px;
                                            wrap: word-wrap;
                                        }
                                    }
                                }

                                Rectangle {
                                    height: 1px;
                                    vertical-stretch: 0;
                                    background: Palette.panel-raised;
                                }

                                // Attribuzione richiesta dalla sezione 2 della licenza
                                // Slint Royalty-free 2.0. Questa e' la collocazione
                                // definitiva prevista dalla licenza: una schermata
                                // "Informazioni" raggiungibile dal menu di primo
                                // livello. Non spostare senza rileggere ADR-0005.
                                Text {
                                    text: @tr("Interfaccia grafica realizzata con Slint");
                                    color: Palette.text;
                                    font-size: 15px;
                                    font-weight: 600;
                                }

                                Rectangle {
                                    height: 110px;
                                    vertical-stretch: 0;
                                    AboutSlint { }
                                }

                                Rectangle { vertical-stretch: 1; background: transparent; }
                            }
                        }
                    }

                }
                }

                // ------------------------------------------- la conversazione
                //
                // ADR-0151, DG-01. Sopra le schermate, nella sola colonna del
                // contenuto: il menu resta, e la schermata sotto resta com'era.
                if root.conversation-open: ConversationPage {
                    x: 0;
                    y: 0;
                    width: parent.width;
                    height: parent.height;
                    // Nascosta a postazione bloccata, come il lavoro (F-01).
                    visible: !root.station-locked;
                    origin: root.conversation-origin;
                    source-name: root.conversation-source-name;
                    source-line: root.conversation-source-line;
                    author: root.conversation-author;
                    published: root.conversation-published;
                    acquired: root.conversation-acquired;
                    observed: root.conversation-observed;
                    content-id: root.conversation-content-id;
                    message-number: root.conversation-message-number;
                    context-summary: root.conversation-summary;
                    context-anchor: root.conversation-anchor;
                    anchor-now: root.conversation-anchor-now;
                    anchor-now-when: root.conversation-anchor-now-when;
                    context-comparison-label: root.conversation-comparison-label;
                    context-texts-differ: root.conversation-texts-differ;
                    older-rows: root.conversation-older-rows;
                    newer-rows: root.conversation-newer-rows;
                    older-state: root.conversation-older-state;
                    newer-state: root.conversation-newer-state;
                    can-load-older: root.conversation-can-load-older;
                    can-load-newer: root.conversation-can-load-newer;
                    archived-url: root.conversation-archived-url;
                    link-request-sentence: root.conversation-link-sentence;
                    link-request-url: root.conversation-link-url;
                    source-page-url: root.conversation-source-url;
                    source-page-sentence: root.conversation-source-sentence;
                    author-identifier: root.conversation-author-identifier;
                    author-subjects: root.conversation-author-subjects;
                    open-subject(id) => {
                        root.author-open-subject(id);
                    }
                    link-subject(identificativo) => {
                        root.author-link-subject(identificativo);
                    }
                    centre-request: root.conversation-centre-request;
                    snapshot-reason <=> root.conversation-snapshot-reason;
                    snapshot-rows: root.conversation-snapshot-rows;
                    snapshot-message: root.conversation-snapshot-message;
                    back => {
                        root.conversation-close();
                    }
                    load-older => {
                        root.conversation-load-older();
                    }
                    load-newer => {
                        root.conversation-load-newer();
                    }
                    request-link(content-id) => {
                        root.conversation-request-link(content-id);
                    }
                    open-url(url) => {
                        root.open-url(url);
                    }
                    take-snapshot(reason) => {
                        root.conversation-take-snapshot(reason);
                    }
                }

                // L'anello dell'inizio della schermata: sopra le schermate,
                // perche' il fuoco si vede sempre (A11Y-02, ADR-0194).
                Rectangle {
                    background: transparent;
                    border-radius: Spacing.radius-panel;
                    border-width: inizio-schermata.has-focus ? 2px : 0px;
                    border-color: Palette.focus;
                }
            }
        }

        // Nessun credito personale permanente qui: le attribuzioni vivono nella
        // schermata «Informazioni e licenze», raggiungibile dal menu. Le voci
        // di Slint (obbligo di licenza, ADR-0005) sono in quella stessa pagina.
    }

    // Barra del titolo, dichiarata DOPO il contenuto perche' in Slint l'ultimo
    // elemento sta sopra: e' sovrapposta, e il layout qui sopra le lascia posto
    // con il proprio riempimento superiore.
    TitleBar {
        y: 0;
        width: 100%;
        // Nascosta a postazione bloccata, come il lavoro (F-01): i suoi comandi
        // - riduci, ingrandisci, chiudi - non si premono da sotto il blocco.
        visible: !root.station-locked;
        title: root.title;
        // In Esercitazione l'account non serve, e «Nessun account» faceva
        // pensare che mancasse qualcosa (SIM3-20).
        status: (root.exercise-mode
                ? "Account non necessario"
                : (root.auth-authenticated
                    ? (root.auth-demo ? "Account dimostrativo, non Telegram" : "Account attivo")
                    // Un account c'e' e non e' collegato: «Nessun account» era
                    // falso accanto a «1 account autorizzato su 1» (BUG-UX-1).
                    : (root.account-selected ? "Account non collegato" : "Nessun account")))
            + "  \u{00b7}  " + root.operating-mode-label;
        minimise => {
            root.minimise-window();
        }
        toggle-maximise => {
            root.toggle-maximise-window();
        }
        close => {
            root.close-window();
        }
    }

    // «PERCHÉ VEDO QUESTO?» (PR-02, ADR-0119).
    //
    // UN PANNELLO SOLO per tutti gli elementi, sopra le pagine: la risposta
    // deve avere una voce sola. Le tre parti sono sempre queste e sempre in
    // quest'ordine, e la terza non ha condizioni.
    //
    // Sta PRIMA del pannello di PROV-02, a cui porta la porta «Vedi tutta la
    // provenienza», e prima del blocco postazione, che deve restare l'ultimo.
    if root.explain-open: Rectangle {
        // Nascosto a postazione bloccata, come il lavoro sotto (F-01).
        visible: !root.station-locked;
        width: 100%;
        height: 100%;
        background: Palette.void.with-alpha(0.82);

        // Assorbe mouse e tastiera, come il pannello di PROV-02.
        TouchArea { }

        FocusScope {
            key-pressed(event) => {
                if (event.text == Key.Escape) {
                    root.close-explain();
                    return accept;
                }
                return reject;
            }
        }

        Rectangle {
            width: min(parent.width - 96px, 720px);
            height: min(parent.height - 96px, 600px);
            background: Palette.panel-raised;
            border-radius: Spacing.radius-panel;
            border-width: Spacing.hairline;
            border-color: Palette.line-strong;

            VerticalLayout {
                padding: Spacing.lg;
                spacing: Spacing.md;

                HorizontalLayout {
                    spacing: Spacing.sm;

                    Text {
                        text: @tr("PERCHÉ VEDO QUESTO");
                        color: Palette.text-muted;
                        font-size: Typography.group-label;
                        letter-spacing: Typography.track-eyebrow;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    HudButton {
                        label: @tr("Chiudi");
                        clicked => {
                            root.close-explain();
                        }
                    }
                }

                // DI CHE COSA.
                Text {
                    text: root.explain-subject;
                    color: Palette.text;
                    font-size: Typography.body;
                    font-weight: Typography.medium;
                    wrap: word-wrap;
                }

                // In modalita' Team, per un elemento che l'Hub non ha mostrato:
                // la frase, e nient'altro.
                if root.explain-unavailable != "": Text {
                    text: root.explain-unavailable;
                    color: Palette.amber;
                    font-size: Typography.body-secondary;
                    wrap: word-wrap;
                }

                if root.explain-unavailable == "": HudScroll {
                    vertical-stretch: 1;

                    VerticalLayout {
                        spacing: Spacing.sm;

                        // 1. CHE COSA LO HA FATTO COMPARIRE.
                        Text {
                            text: @tr("Che cosa lo ha fatto comparire");
                            color: Palette.text-muted;
                            font-size: Typography.group-label;
                            letter-spacing: Typography.track-eyebrow;
                        }
                        Text {
                            text: root.explain-rule;
                            color: Palette.text;
                            font-size: Typography.body-secondary;
                            font-weight: Typography.medium;
                            wrap: word-wrap;
                        }
                        Text {
                            text: root.explain-facts;
                            color: Palette.text;
                            font-size: Typography.body-secondary;
                            wrap: word-wrap;
                        }

                        // 2. CHE GENERE DI CERTEZZA E'. Il segno porta la
                        // parola: si legge senza colore.
                        Text {
                            text: @tr("Che genere di certezza è");
                            color: Palette.text-muted;
                            font-size: Typography.group-label;
                            letter-spacing: Typography.track-eyebrow;
                        }
                        HorizontalLayout {
                            spacing: Spacing.sm;
                            vertical-stretch: 0;

                            OrigineSegno { origine: root.explain-origin; }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                        }
                        Text {
                            text: root.explain-origin-note;
                            color: Palette.text-muted;
                            font-size: Typography.body-secondary;
                            wrap: word-wrap;
                        }

                        // 3. CHE COSA NON SIGNIFICA. SENZA CONDIZIONI: e' la
                        // salvaguardia interpretativa messa dove una persona la
                        // incontra, e non si sopprime.
                        Text {
                            text: @tr("Che cosa non significa");
                            color: Palette.text-muted;
                            font-size: Typography.group-label;
                            letter-spacing: Typography.track-eyebrow;
                        }
                        Text {
                            text: root.explain-not-meaning;
                            color: Palette.amber;
                            font-size: Typography.body-secondary;
                            wrap: word-wrap;
                        }
                    }
                }

                // LA PORTA al Provenance Explorer che esiste gia'. Dove non lo
                // copre, non compare.
                if root.explain-has-door && root.explain-unavailable == "": Rectangle {
                    // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                    min-height: rip-177.preferred-height;
                    rip-177 := HorizontalLayout {
                        spacing: Spacing.sm;
                        vertical-stretch: 0;

                        HudButton {
                            label: @tr("Provenienza, note e contesto");
                            clicked => {
                                root.explain-open-provenance();
                            }
                        }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                    }
                }
            }
        }
    }

    // TUTTA LA PROVENIENZA sui soggetti che non sono un contenuto (PROV-02).
    // Si apre dalla porta di «Perché vedo questo?».
    //
    // Dichiarato qui, sopra le pagine, perche' la stessa domanda si pone da
    // cinque schermate diverse e la risposta deve avere UNA VOCE SOLA. Cinque
    // pannelli separati diventerebbero cinque voci, e la prima che qualcuno
    // modifica direbbe una cosa diversa dalle altre quattro.
    //
    // Sta PRIMA del blocco postazione, che deve restare l'ultimo: coprire tutto
    // e' il suo mestiere.
    //
    // LA NATURA VIENE PRIMA DELLA SPIEGAZIONE. Una spiegazione convincente
    // letta senza sapere che e' un calcolo si ricorda come un fatto, e chi
    // legge cinque risposte nella stessa voce ne ricava cinque fatti dello
    // stesso peso.
    if root.why-subject-open: Rectangle {
        // Nascosto a postazione bloccata, come il lavoro sotto (F-01).
        visible: !root.station-locked;
        width: 100%;
        height: 100%;
        background: Palette.void.with-alpha(0.82);

        // Assorbe mouse e tastiera: un pannello che ferma il mouse e lascia
        // libera la tastiera non ferma niente, ed e' anche cio' che
        // l'invariante di accessibilita' richiede.
        TouchArea { }

        FocusScope {
            key-pressed(event) => {
                if (event.text == Key.Escape) {
                    root.close-why-subject();
                    return accept;
                }
                return reject;
            }
        }

        Rectangle {
            width: min(parent.width - 96px, 720px);
            height: min(parent.height - 96px, 560px);
            background: Palette.panel-raised;
            border-radius: Spacing.radius-panel;
            border-width: Spacing.hairline;
            border-color: Palette.line-strong;

            VerticalLayout {
                padding: Spacing.lg;
                spacing: Spacing.md;

                HorizontalLayout {
                    spacing: Spacing.sm;

                    Text {
                        text: @tr("TUTTA LA PROVENIENZA");
                        color: Palette.text-muted;
                        font-size: Typography.group-label;
                        letter-spacing: Typography.track-eyebrow;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    HudButton {
                        label: @tr("Chiudi");
                        clicked => {
                            root.close-why-subject();
                        }
                    }
                }

                // DI CHE COSA.
                Text {
                    text: root.why-subject-label;
                    color: Palette.text;
                    font-size: Typography.body;
                    font-weight: Typography.medium;
                    wrap: word-wrap;
                }

                // LA NATURA, PRIMA DELLA SPIEGAZIONE.
                //
                // L'ambra distingue un calcolo da un fatto: non e' un allarme,
                // e' la stessa distinzione che il colore fa altrove fra cio'
                // che il programma ha registrato e cio' che ha prodotto.
                Text {
                    text: root.why-subject-nature;
                    color: root.why-subject-is-elaboration ? Palette.amber : Palette.text;
                    font-size: Typography.body-secondary;
                    font-weight: Typography.medium;
                }
                Text {
                    text: root.why-subject-nature-note;
                    color: Palette.text-muted;
                    font-size: Typography.group-label;
                    wrap: word-wrap;
                }

                HudScroll {
                    vertical-stretch: 1;

                    VerticalLayout {
                        spacing: Spacing.md;

                        Text {
                            text: root.why-subject-explanation;
                            color: Palette.text;
                            font-size: Typography.body-secondary;
                            wrap: word-wrap;
                        }

                        // COME E' STATO CALCOLATO, quando e' un calcolo. Un
                        // numero senza il proprio metodo sembra oggettivo.
                        if root.why-subject-method != "": Rectangle {
                            // Un elemento ripetuto misura il testo a capo su una riga sola (F-03).
                            min-height: rip-178.preferred-height;
                            rip-178 := VerticalLayout {
                                spacing: Spacing.xs;

                                Text {
                                    text: @tr("Come è stato calcolato");
                                    color: Palette.text-muted;
                                    font-size: Typography.group-label;
                                    letter-spacing: Typography.track-eyebrow;
                                }
                                Text {
                                    text: root.why-subject-method;
                                    color: Palette.text-muted;
                                    font-size: Typography.group-label;
                                    wrap: word-wrap;
                                }

                                if root.why-subject-method-detail != "": DettagliTecnici {
                                    testo: root.why-subject-method-detail;
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // ------------------------------------------------ TOUR-01 — strati, inizio
    //
    // «SCOPRI NEXUM» sopra le pagine (ADR-0134). Tre strati: la proposta del
    // primo avvio, il pannello, il velo con il fumetto. Stanno PRIMA del blocco
    // postazione, che deve restare l'ultimo: se la postazione si blocca, il
    // blocco copre anche il tour.
    //
    // QUI SI CHIAMANO SOLTANTO `open-page` E I COMANDI DEL TOUR. Una guardia
    // legge questo tratto e rifiuta ogni altra chiamata: il tour mostra, e non
    // tocca.

    // LA PROPOSTA DEL PRIMO AVVIO. Si registra come proposta nell'istante in cui
    // compare: da allora non ricompare da sé, comunque finisca.
    if root.tour-proposal-visible: Rectangle {
        // Nascosto a postazione bloccata, come il lavoro sotto (F-01).
        visible: !root.station-locked;
        width: 100%;
        height: 100%;
        background: Palette.void.with-alpha(0.82);

        init => {
            root.tour-proposal-shown();
            proposta-inizia.take-focus();
        }

        TouchArea { }

        proposta-tasti := FocusScope {
            width: 100%;
            height: 100%;
            key-pressed(event) => {
                // Esc chiude senza scegliere: niente si apre più da sé, e
                // «Nuovo» resta accanto alla voce.
                if (event.text == Key.Escape) {
                    root.tour-proposal-dismissed();
                    return accept;
                }
                if (event.text == Key.Tab || event.text == Key.Backtab) {
                    if (proposta-inizia.has-focus) {
                        proposta-salta.take-focus();
                    } else {
                        proposta-inizia.take-focus();
                    }
                    return accept;
                }
                return accept;
            }

            Rectangle {
                width: min(parent.width - 96px, 480px);
                height: proposta.preferred-height;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                background: Palette.panel-raised;
                border-radius: Spacing.radius-panel;
                border-width: Spacing.hairline;
                // Se il fuoco resta al riquadro e non a un comando, lo si vede.
                border-color: proposta-tasti.has-focus ? Palette.focus : Palette.line-strong;

                accessible-role: groupbox;
                accessible-label: @tr("Scopri NEXUM. Il tour mostra le funzioni principali.");

                proposta := VerticalLayout {
                    padding: Spacing.lg;
                    spacing: Spacing.md;

                    Text {
                        text: @tr("Scopri NEXUM");
                        color: Palette.text;
                        font-size: Typography.screen-title;
                        font-weight: Typography.medium;
                        wrap: word-wrap;
                    }
                    Text {
                        text: @tr("Il tour mostra le funzioni principali, e si interrompe quando si vuole.");
                        color: Palette.text;
                        font-size: Typography.body;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        spacing: Spacing.sm;
                        vertical-stretch: 0;

                        proposta-inizia := TourButton {
                            label: @tr("Avvia il tour");
                            primary: true;
                            clicked => {
                                root.tour-requested(false);
                            }
                        }
                        proposta-salta := TourButton {
                            label: @tr("Salta per ora");
                            clicked => {
                                root.tour-proposal-skipped();
                            }
                        }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                    }
                    Text {
                        text: @tr("Il tour resta sempre in fondo al menu, alla voce Scopri NEXUM.");
                        color: Palette.text-muted;
                        font-size: Typography.body-secondary;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }

    // IL PANNELLO DI SCOPRI NEXUM. Piccolo: dice che cosa è il tour e offre di
    // avviarlo, continuarlo o rifarlo. Non è un manuale.
    if root.tour-panel-open: Rectangle {
        // Nascosto a postazione bloccata, come il lavoro sotto (F-01).
        visible: !root.station-locked;
        width: 100%;
        height: 100%;
        background: Palette.void.with-alpha(0.82);

        init => {
            pannello-primo.take-focus();
        }

        TouchArea { }

        pannello-tasti := FocusScope {
            width: 100%;
            height: 100%;
            key-pressed(event) => {
                if (event.text == Key.Escape) {
                    root.tour-close-panel();
                    return accept;
                }
                if (event.text == Key.Tab || event.text == Key.Backtab) {
                    // L'ordine: il primo comando, «Ricomincia da capo» se il
                    // tour era interrotto, «Chiudi», «Che cosa è cambiato».
                    if (pannello-primo.has-focus) {
                        if (event.text == Key.Backtab) {
                            pannello-novita.take-focus();
                        } else if (root.tour-offer == 1) {
                            pannello-ricomincia.take-focus();
                        } else {
                            pannello-chiudi.take-focus();
                        }
                    } else if (pannello-ricomincia.has-focus) {
                        if (event.text == Key.Tab) {
                            pannello-chiudi.take-focus();
                        } else {
                            pannello-primo.take-focus();
                        }
                    } else if (pannello-chiudi.has-focus) {
                        if (event.text == Key.Tab) {
                            pannello-novita.take-focus();
                        } else if (root.tour-offer == 1) {
                            pannello-ricomincia.take-focus();
                        } else {
                            pannello-primo.take-focus();
                        }
                    } else {
                        if (event.text == Key.Tab) {
                            pannello-primo.take-focus();
                        } else {
                            pannello-chiudi.take-focus();
                        }
                    }
                    return accept;
                }
                return accept;
            }

            Rectangle {
                width: min(parent.width - 96px, 520px);
                height: pannello.preferred-height;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                background: Palette.panel-raised;
                border-radius: Spacing.radius-panel;
                border-width: Spacing.hairline;
                border-color: pannello-tasti.has-focus ? Palette.focus : Palette.line-strong;

                accessible-role: groupbox;
                accessible-label: @tr("Scopri le funzioni di NEXUM");

                pannello := VerticalLayout {
                    padding: Spacing.lg;
                    spacing: Spacing.md;

                    Text {
                        text: @tr("Scopri le funzioni di NEXUM");
                        color: Palette.text;
                        font-size: Typography.screen-title;
                        font-weight: Typography.medium;
                        wrap: word-wrap;
                    }
                    Text {
                        text: @tr("Fai un tour guidato dell'applicazione. Ti mostreremo dove si trovano le funzioni principali e a cosa servono.");
                        color: Palette.text;
                        font-size: Typography.body;
                        wrap: word-wrap;
                    }
                    Text {
                        text: @tr("{} passaggi, qualche minuto. Il tour mostra e non fa niente al tuo posto.", root.tour-step-count);
                        color: Palette.text-muted;
                        font-size: Typography.body-secondary;
                        wrap: word-wrap;
                    }
                    if root.tour-offer == 1: Text {
                        text: @tr("Il tour era stato interrotto: puoi continuare da dove eri.");
                        color: Palette.text-muted;
                        font-size: Typography.body-secondary;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        spacing: Spacing.sm;
                        vertical-stretch: 0;

                        pannello-primo := TourButton {
                            label: root.tour-offer == 1 ? @tr("Continua il tour") : (root.tour-offer == 2 ? @tr("Rifai il tour") : @tr("Avvia il tour"));
                            primary: true;
                            clicked => {
                                root.tour-requested(root.tour-offer == 1);
                            }
                        }
                        // Solo per un tour interrotto. Resta nel layout anche
                        // quando non si vede, ed è spento: nessuno lo raggiunge.
                        pannello-ricomincia := TourButton {
                            label: @tr("Ricomincia da capo");
                            visible: root.tour-offer == 1;
                            enabled: root.tour-offer == 1;
                            clicked => {
                                root.tour-requested(false);
                            }
                        }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                        pannello-chiudi := TourButton {
                            label: @tr("Chiudi");
                            clicked => {
                                root.tour-close-panel();
                            }
                        }
                    }
                    // Le novità dell'ultima edizione, quando si vogliono
                    // (NEWS-01, ADR-0169 §5).
                    HorizontalLayout {
                        spacing: Spacing.sm;
                        vertical-stretch: 0;

                        pannello-novita := TourButton {
                            label: @tr("Che cosa è cambiato");
                            clicked => {
                                root.tour-close-panel();
                                root.tour-news-requested();
                                root.tour-news-index = 0;
                                root.tour-news-open = true;
                            }
                        }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                    }
                }
            }
        }
    }

    // IL GIRO DELLE NOVITÀ (NEWS-01, ADR-0169). Una novità alla volta; il solo
    // gesto che compie è aprire una schermata. Quando si apre da sé si
    // registra come visto nell'istante in cui compare, e non ricompare.
    if root.tour-news-visible: Rectangle {
        // Nascosto a postazione bloccata, come il lavoro sotto (F-01).
        visible: !root.station-locked;
        width: 100%;
        height: 100%;
        background: Palette.void.with-alpha(0.82);

        init => {
            if (!root.tour-news-open) {
                root.tour-news-open = true;
                root.tour-news-pending = false;
                root.tour-news-shown();
            }
            novita-avanti.take-focus();
        }

        TouchArea { }

        novita-tasti := FocusScope {
            width: 100%;
            height: 100%;
            key-pressed(event) => {
                if (event.text == Key.Escape) {
                    root.tour-news-close(true);
                    return accept;
                }
                if (event.text == Key.Tab || event.text == Key.Backtab) {
                    // L'ordine: «Indietro» (spento sulla prima novità, e si
                    // salta), «Avanti», «Apri la schermata», «Chiudi».
                    if (novita-indietro.has-focus) {
                        if (event.text == Key.Tab) {
                            novita-avanti.take-focus();
                        } else {
                            novita-chiudi.take-focus();
                        }
                    } else if (novita-avanti.has-focus) {
                        if (event.text == Key.Tab) {
                            novita-apri.take-focus();
                        } else if (root.tour-news-index > 0) {
                            novita-indietro.take-focus();
                        } else {
                            novita-chiudi.take-focus();
                        }
                    } else if (novita-apri.has-focus) {
                        if (event.text == Key.Tab) {
                            novita-chiudi.take-focus();
                        } else {
                            novita-avanti.take-focus();
                        }
                    } else {
                        if (event.text == Key.Backtab) {
                            novita-apri.take-focus();
                        } else if (root.tour-news-index > 0) {
                            novita-indietro.take-focus();
                        } else {
                            novita-avanti.take-focus();
                        }
                    }
                    return accept;
                }
                return accept;
            }

            Rectangle {
                width: min(parent.width - 96px, 560px);
                height: novita.preferred-height;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                background: Palette.panel-raised;
                border-radius: Spacing.radius-panel;
                border-width: Spacing.hairline;
                border-color: novita-tasti.has-focus ? Palette.focus : Palette.line-strong;

                accessible-role: groupbox;
                accessible-label: @tr("Scopri che cosa è cambiato");

                novita := VerticalLayout {
                    padding: Spacing.lg;
                    spacing: Spacing.md;

                    Text {
                        text: @tr("Scopri che cosa è cambiato");
                        color: Palette.text;
                        font-size: Typography.screen-title;
                        font-weight: Typography.medium;
                        wrap: word-wrap;
                    }
                    Text {
                        text: @tr("Novità {} di {}. Il giro mostra, e non fa nulla da sé.", (root.tour-news-index + 1), root.tour-news-rows.length);
                        color: Palette.text-muted;
                        font-size: Typography.body-secondary;
                        wrap: word-wrap;
                    }
                    Text {
                        text: root.tour-news-rows[root.tour-news-index].title;
                        color: Palette.text;
                        font-size: Typography.body;
                        font-weight: Typography.medium;
                        wrap: word-wrap;
                    }
                    Text {
                        text: root.tour-news-rows[root.tour-news-index].sentence;
                        color: Palette.text;
                        font-size: Typography.body;
                        wrap: word-wrap;
                    }
                    Text {
                        text: @tr("Dove: {}.", root.tour-news-rows[root.tour-news-index].place);
                        color: Palette.text-muted;
                        font-size: Typography.body-secondary;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        spacing: Spacing.sm;
                        vertical-stretch: 0;

                        // Resta nel layout anche sulla prima novità, ed è spento.
                        novita-indietro := TourButton {
                            label: @tr("Indietro");
                            enabled: root.tour-news-index > 0;
                            clicked => {
                                if (root.tour-news-index > 0) {
                                    root.tour-news-index -= 1;
                                }
                                if (root.tour-news-index == 0) {
                                    novita-avanti.take-focus();
                                }
                            }
                        }
                        novita-avanti := TourButton {
                            label: root.tour-news-index + 1 < root.tour-news-rows.length ? @tr("Avanti") : @tr("Fine");
                            primary: true;
                            clicked => {
                                if (root.tour-news-index + 1 < root.tour-news-rows.length) {
                                    root.tour-news-index += 1;
                                } else {
                                    root.tour-news-close(true);
                                }
                            }
                        }
                        novita-apri := TourButton {
                            label: @tr("Apri la schermata");
                            clicked => {
                                root.open-page(root.tour-news-rows[root.tour-news-index].page);
                                root.tour-news-close(false);
                            }
                        }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                        novita-chiudi := TourButton {
                            label: @tr("Chiudi");
                            clicked => {
                                root.tour-news-close(true);
                            }
                        }
                    }
                    Text {
                        text: @tr("Le novità restano nel pannello di Scopri NEXUM, alla voce «Che cosa è cambiato».");
                        color: Palette.text-muted;
                        font-size: Typography.body-secondary;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }
    // IL VELO, LA ZONA ILLUMINATA, IL FUMETTO.
    //
    // Non è condizionale come gli altri due strati ma nascosto: le funzioni del
    // tour, in cima alla finestra, devono poter spostare il fuoco fra i suoi
    // comandi. Nascosto, non riceve né mouse né tastiera.
    tour-layer := Rectangle {
        visible: root.tour-active && !root.station-locked;
        width: 100%;
        height: 100%;

        // La zona del passo, con quattro pixel d'aria, tenuta dentro la
        // finestra.
        property <TourRect> bersaglio: root.tour-target-rect();
        property <length> zona-x: max(0px, self.bersaglio.x - 4px);
        property <length> zona-y: max(0px, self.bersaglio.y - 4px);
        property <length> zona-w: min(self.width - self.zona-x, self.bersaglio.width + 8px);
        property <length> zona-h: min(self.height - self.zona-y, self.bersaglio.height + 8px);

        // Il riquadro si sposta da un passo all'altro, e solo se il movimento
        // non è ridotto. Il fumetto no: compare dove deve stare.
        property <length> sx: self.zona-x;
        property <length> sy: self.zona-y;
        property <length> sw: self.zona-w;
        property <length> sh: self.zona-h;
        animate sx, sy, sw, sh {
            duration: Appearance.motion-enabled ? Motion.quick : 0ms;
            easing: cubic-bezier(0.2, 0, 0.2, 1);
        }

        tour-keys := FocusScope {
            width: 100%;
            height: 100%;
            // Tutti i tasti si fermano qui: niente arriva alla schermata
            // sotto il velo.
            key-pressed(event) => {
                if (event.text == Key.Escape) {
                    root.tour-exit();
                    return accept;
                }
                if (event.text == Key.RightArrow) {
                    root.tour-forward();
                    return accept;
                }
                if (event.text == Key.LeftArrow) {
                    root.tour-backward();
                    return accept;
                }
                if (event.text == Key.Tab) {
                    root.tour-cycle(true);
                    return accept;
                }
                if (event.text == Key.Backtab) {
                    root.tour-cycle(false);
                    return accept;
                }
                return accept;
            }

            // Il velo: quattro rettangoli attorno alla zona, che resta alla
            // luce normale.
            Rectangle {
                x: 0;
                y: 0;
                width: parent.width;
                height: max(0px, tour-layer.sy);
                background: Palette.void.with-alpha(0.72);
            }
            Rectangle {
                x: 0;
                y: tour-layer.sy + tour-layer.sh;
                width: parent.width;
                height: max(0px, parent.height - tour-layer.sy - tour-layer.sh);
                background: Palette.void.with-alpha(0.72);
            }
            Rectangle {
                x: 0;
                y: tour-layer.sy;
                width: max(0px, tour-layer.sx);
                height: tour-layer.sh;
                background: Palette.void.with-alpha(0.72);
            }
            Rectangle {
                x: tour-layer.sx + tour-layer.sw;
                y: tour-layer.sy;
                width: max(0px, parent.width - tour-layer.sx - tour-layer.sw);
                height: tour-layer.sh;
                background: Palette.void.with-alpha(0.72);
            }

            // Nessun clic arriva alla schermata: nemmeno dentro la zona
            // illuminata, che si guarda e non si usa.
            TouchArea { }

            // L'anello: tre pixel, il colore del fuoco. La zona si distingue
            // anche senza percepire il colore, perché resta chiara su un fondo
            // scuro.
            Rectangle {
                x: tour-layer.sx;
                y: tour-layer.sy;
                width: tour-layer.sw;
                height: tour-layer.sh;
                background: transparent;
                border-width: 3px;
                border-color: Palette.focus;
                border-radius: Spacing.radius-row;
            }

            tour-callout := Rectangle {
                width: min(380px, tour-layer.width - 24px);
                height: fumetto.preferred-height;
                property <TourPoint> posto: root.tour-place(
                    {
                        x: tour-layer.zona-x,
                        y: tour-layer.zona-y,
                        width: tour-layer.zona-w,
                        height: tour-layer.zona-h,
                    },
                    self.width,
                    self.height,
                    tour-layer.width,
                    tour-layer.height,
                    Shell.titlebar-height);
                x: self.posto.x;
                y: self.posto.y;
                background: Palette.panel-raised;
                border-radius: Spacing.radius-panel;
                border-width: Spacing.hairline;
                border-color: tour-keys.has-focus ? Palette.focus : Palette.line-strong;

                accessible-role: groupbox;
                accessible-label: @tr("{} di {}. {}. {}", (root.tour-index + 1), root.tour-steps.length, root.tour-steps[root.tour-index].title, root.tour-steps[root.tour-index].body);

                fumetto := VerticalLayout {
                    padding: Spacing.lg;
                    spacing: Spacing.sm;

                    // A che punto si è: il numero, scritto, e non soltanto una
                    // barra.
                    tour-progress := Text {
                        text: @tr("{} di {}", (root.tour-index + 1), root.tour-steps.length);
                        color: Palette.text-muted;
                        font-family: Typography.mono;
                        font-size: Typography.eyebrow;
                        letter-spacing: Typography.track-eyebrow;
                    }
                    Text {
                        text: root.tour-steps[root.tour-index].title;
                        color: Palette.text;
                        font-size: Typography.panel-title;
                        font-weight: Typography.medium;
                        wrap: word-wrap;
                    }
                    Text {
                        text: root.tour-steps[root.tour-index].body;
                        color: Palette.text;
                        font-size: Typography.body;
                        wrap: word-wrap;
                    }
                    if root.tour-steps[root.tour-index].note != "": Text {
                        text: root.tour-steps[root.tour-index].note;
                        color: Palette.amber;
                        font-size: Typography.body-secondary;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        spacing: Spacing.sm;
                        vertical-stretch: 0;
                        padding-top: Spacing.xs;

                        tour-back-button := TourButton {
                            label: @tr("Indietro");
                            enabled: root.tour-index > 0;
                            clicked => {
                                root.tour-backward();
                            }
                        }
                        tour-next-button := TourButton {
                            label: root.tour-index >= root.tour-steps.length - 1 ? @tr("Fine") : @tr("Avanti");
                            primary: true;
                            clicked => {
                                root.tour-forward();
                            }
                        }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                        tour-exit-button := TourButton {
                            label: @tr("Esci dal tour");
                            clicked => {
                                root.tour-exit();
                            }
                        }
                    }
                    // IL TOUR ARRIVA ALL'ALBERO DI ACCESSIBILITÀ (COLLAUDO-FIX-01,
                    // CU01-012). Lo strato del tour non è condizionale, è
                    // nascosto e mostrato; il ponte verso Windows rifà l'albero
                    // intero quando nasce un elemento, e il collaudo non vi ha
                    // trovato il fumetto, mentre «Scopri che cosa è cambiato»,
                    // che è condizionale, c'era. Questa riga nasce con il tour,
                    // e l'albero si rifà con il fumetto dentro.
                    if root.tour-active: Text {
                        text: @tr("Frecce per andare avanti e indietro, Esc per uscire.");
                        color: Palette.text-muted;
                        font-size: Typography.group-label;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }
    // ------------------------------------------------ TOUR-01 — strati, fine

    // Schermata di blocco, dichiarata **per ultima** perche' in Slint l'ultimo
    // elemento sta sopra: deve coprire tutto, compresa la scanline.
    //
    // Il rettangolo e' opaco e occupa l'intera finestra: non e' un velo. Un
    // velo semitrasparente lascerebbe leggere, sfocato, cio' che il blocco
    // esiste per nascondere.
    //
    // Il `TouchArea` sotto tutto assorbe i click: senza, si potrebbe premere
    // un comando della schermata coperta senza vederlo.
    if root.station-locked: Rectangle {
        width: 100%;
        height: 100%;
        background: Palette.void;

        // Il `TouchArea` assorbe i click: senza, si potrebbe premere un comando
        // della schermata coperta senza vederlo.
        //
        // LA TASTIERA NON LA FERMAVA NESSUNO (OPERATOR-E2E-REMEDIATION-01,
        // F-01). Qui c'era un `FocusScope` accanto al contenuto, con il
        // commento che diceva di fermare la tastiera: ma un `FocusScope` riceve
        // i tasti solo quando ha il fuoco, e il Tab portava il fuoco lungo la
        // catena di tutta la finestra, comandi coperti compresi. Da li' Invio
        // e Spazio li azionavano. Ora il lavoro sotto e' **nascosto**, non
        // coperto, e il Tab non ha dove andare; in piu' questo `FocusScope`
        // racchiude il contenuto del blocco e ne cattura i tasti **prima** che
        // arrivino al campo: il Tab gira fra il campo e «Sblocca», e basta.
        TouchArea { }

        lock-keys := FocusScope {
            // Racchiude e non e' una fermata del Tab: il fuoco sta sul campo o
            // sul pulsante, mai qui.
            enabled: false;

            capture-key-pressed(event) => {
                if (event.text == Key.Tab || event.text == Key.Backtab) {
                    if (lock-word.has-focus) {
                        lock-unlock.focus();
                    } else {
                        lock-word.focus();
                    }
                    return accept;
                }
                // Esc non chiude niente: non c'e' nulla da chiudere, e il
                // blocco non e' un dialogo.
                if (event.text == Key.Escape) {
                    return accept;
                }
                return reject;
            }

        VerticalLayout {
            alignment: center;
            padding: Spacing.xl;
            spacing: Spacing.lg;

            HorizontalLayout {
                alignment: center;
                BrandMark {
                    size: 72px;
                    active: false;
                }
            }

            Text {
                text: @tr("Postazione bloccata");
                color: Palette.text;
                font-size: Typography.screen-title;
                font-weight: Typography.medium;
                horizontal-alignment: center;
            }

            Text {
                text: root.lock-account-label != "" ? @tr("Account: {}", root.lock-account-label) : "";
                color: Palette.text-muted;
                font-size: Typography.body;
                horizontal-alignment: center;
            }

            // Il fatto, non il contenuto. Su un PC condiviso mostrare fonte e
            // motivazione esporrebbe materiale acquisito a chi passa; non
            // mostrare nulla toglierebbe a chi rientra il modo di capire a
            // colpo d'occhio se e' successo qualcosa.
            if root.lock-fact != "": Rectangle {
                height: 44px;
                vertical-stretch: 0;
                background: Palette.panel-raised;
                border-radius: Spacing.radius-row;

                HorizontalLayout {
                    alignment: center;
                    padding-left: Spacing.lg;
                    padding-right: Spacing.lg;
                    Text {
                        text: root.lock-fact;
                        color: Palette.text;
                        font-size: Typography.body;
                        font-weight: Typography.medium;
                        vertical-alignment: center;
                    }
                }

                accessible-role: text;
                accessible-label: root.lock-fact;
            }

            Text {
                text: @tr("Il monitoraggio non si è fermato: continua ad acquisire mentre la postazione è bloccata.");
                color: Palette.text-muted;
                font-size: Typography.body-secondary;
                horizontal-alignment: center;
                wrap: word-wrap;
            }

            HorizontalLayout {
                alignment: center;
                spacing: Spacing.md;
                vertical-stretch: 0;

                Rectangle {
                    width: 320px;
                    height: 40px;
                    horizontal-stretch: 0;
                    vertical-stretch: 0;
                    // Dove sta il fuoco si deve vedere: su una schermata che
                    // non ha altro, chi arriva con la tastiera deve sapere che
                    // sta scrivendo nel campo e non altrove.
                    border-radius: Spacing.radius-row;
                    border-width: lock-word.has-focus ? 2px : 0px;
                    border-color: Palette.focus;
                    lock-word := HudInput {
                        placeholder: @tr("Parola di sblocco");
                        masked: true;
                        lock-surface: true;
                        // L'etichetta nomina il campo e **mai** il valore: se
                        // contenesse il valore, un segreto verrebbe letto ad
                        // alta voce da una tecnologia assistiva.
                        label: @tr("Parola di sblocco della postazione");
                        value <=> root.lock-attempt;
                        accepted => {
                            root.unlock-station();
                        }
                    }
                }

                lock-unlock := HudButton {
                    label: @tr("Sblocca");
                    weight: Weight.primary;
                    lock-surface: true;
                    clicked => {
                        root.unlock-station();
                    }
                }
            }

            if root.lock-message != "": Text {
                text: root.lock-message;
                color: Palette.coral;
                font-size: Typography.body-secondary;
                horizontal-alignment: center;
                wrap: word-wrap;
            }

            init => {
                lock-word.focus();
            }
        }
        }
    }

    // LA DOMANDA PRIMA DI CHIUDERE (OPERATOR-UX-REMEDIATION-01, OS-09).
    //
    // Compare solo se un monitoraggio acquisisce e qualcuno ha chiesto di
    // chiudere la finestra (`closing.rs`). Dice la conseguenza e ha due
    // uscite: chiudere comunque, o restare. Esc resta.
    //
    // IL TAB GIRA FRA LE DUE USCITE (A11Y-02, ADR-0194). Il fuoco stava su un
    // `FocusScope` accanto al riquadro che accettava ogni tasto, Tab compreso:
    // con la sola tastiera si usciva soltanto con Esc, e «Chiudi comunque» non
    // si raggiungeva. Ora il fuoco parte da «Resta aperto», l'uscita che non
    // perde niente, e il riquadro tiene Tab ed Esc come la proposta del tour.
    if root.close-question-open: Rectangle {
        // Nascosto a postazione bloccata, come il lavoro sotto (F-01).
        visible: !root.station-locked;
        width: 100%;
        height: 100%;
        background: Palette.void.with-alpha(0.82);

        TouchArea { }

        tasti-chiusura := FocusScope {
            width: 100%;
            height: 100%;
            key-pressed(event) => {
                if (event.text == Key.Escape) {
                    root.close-withdrawn();
                    return accept;
                }
                if (event.text == Key.Tab || event.text == Key.Backtab) {
                    if (chiusura-resta.has-focus) {
                        chiusura-chiudi.focus();
                    } else {
                        chiusura-resta.focus();
                    }
                    return accept;
                }
                return accept;
            }

            Rectangle {
                width: min(560px, parent.width - 2 * Spacing.xl);
                height: domanda-chiusura.preferred-height;
                background: Palette.panel;
                border-radius: Spacing.radius-panel;
                border-width: Spacing.hairline;
                border-color: Palette.amber;

                accessible-role: groupbox;
                accessible-label: @tr("Un monitoraggio è in corso");

                domanda-chiusura := VerticalLayout {
                    padding: Spacing.xl;
                    spacing: Spacing.lg;

                    Text {
                        text: @tr("Un monitoraggio è in corso");
                        color: Palette.text;
                        font-size: Typography.screen-title;
                        font-weight: Typography.medium;
                        wrap: word-wrap;
                    }
                    Text {
                        text: @tr("Chiudendo il programma l'acquisizione si interrompe. Al prossimo avvio un avviso dirà che il monitoraggio è stato interrotto, e il tempo in cui il programma è rimasto chiuso risulterà non coperto.");
                        color: Palette.text;
                        font-size: Typography.body;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        spacing: Spacing.md;
                        alignment: end;
                        chiusura-resta := HudButton {
                            label: @tr("Resta aperto");
                            weight: Weight.primary;
                            clicked => {
                                root.close-withdrawn();
                            }
                        }
                        chiusura-chiudi := HudButton {
                            label: @tr("Chiudi comunque");
                            weight: Weight.danger;
                            clicked => {
                                root.close-confirmed();
                            }
                        }
                    }
                }
            }
        }

        init => {
            chiusura-resta.focus();
        }
    }
    // ---- fine della domanda di chiusura

    // L'ULTIMO ELEMENTO DELLA FINESTRA (A11Y-02, ADR-0194). Shift+Tab senza
    // fuoco parte da qui, e non da «Chiudi»: il fuoco riprende dall'inizio
    // della schermata. Con un Tab dato da un elemento vivo non si ferma.
    ripresa-indietro := FocusScope {
        x: 0px;
        y: 0px;
        width: 0px;
        height: 0px;
        enabled: !FocusRule.navigating && !root.station-locked;
        focus-on-click: false;
        focus-gained(reason) => {
            root.resume-pending = true;
        }

        // Tiene il fuoco solo fino al giro dopo, e intanto lo mostra: un
        // anello attorno alla finestra.
        Rectangle {
            x: 0px;
            y: 0px;
            width: root.width;
            height: root.height;
            background: transparent;
            border-width: parent.has-focus ? 2px : 0px;
            border-color: Palette.focus;
        }
    }
}
